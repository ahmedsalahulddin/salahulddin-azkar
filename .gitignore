/android/app/release

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Built APKs staged for the download page — regenerated by the release build
/web/apk/*.apk

# The compiled Flutter web app, deployed straight from disk via wrangler.
# Regenerated by `flutter build web` on every release; committing it would
# mean a ~9MB binary diff every time with no reviewable content. Leaving a
# stale copy sitting here previously caused a real bug: flutter build web
# treats /web as its template source, so a leftover main.dart.js from an old
# build gets copied forward over the freshly compiled one unless it's wiped
# first — always rebuild the web app fresh, never edit these by hand.
/web/main.dart.js
/web/main.dart.js.map
/web/flutter.js
/web/flutter_bootstrap.js
/web/flutter_service_worker.js
/web/version.json
/web/canvaskit/
/web/assets/
/web/.last_build_id

# Release signing — never commit these.
# Losing the keystore means the app can never be updated on Play again;
# leaking it lets anyone publish under your name.
/android/key.properties
*.jks
*.keystore
