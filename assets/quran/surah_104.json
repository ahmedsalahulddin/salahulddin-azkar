{"n":104,"name":"الهُمَزَةِ","ayahs":[{"n":1,"t":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ"},{"n":2,"t":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ"},{"n":3,"t":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ"},{"n":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ"},{"n":5,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ"},{"n":6,"t":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ"},{"n":7,"t":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ"},{"n":8,"t":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏"},{"n":9,"t":"فِي عَمَدࣲ مُّمَدَّدَةِۭ"}]}