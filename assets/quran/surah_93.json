{"n":93,"name":"الضُّحَىٰ","ayahs":[{"n":1,"t":"وَٱلضُّحَىٰ"},{"n":2,"t":"وَٱلَّيۡلِ إِذَا سَجَىٰ"},{"n":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"n":4,"t":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ"},{"n":5,"t":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ"},{"n":6,"t":"أَلَمۡ يَجِدۡكَ يَتِيمࣰ ا فَـَٔاوَىٰ"},{"n":7,"t":"وَوَجَدَكَ ضَآلࣰّ ا فَهَدَىٰ"},{"n":8,"t":"وَوَجَدَكَ عَآئِلࣰ ا فَأَغۡنَىٰ"},{"n":9,"t":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ"},{"n":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ"},{"n":11,"t":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"}]}