{"n":79,"name":"النَّازِعَاتِ","ayahs":[{"n":1,"t":"وَٱلنَّٰزِعَٰتِ غَرۡقࣰ ا"},{"n":2,"t":"وَٱلنَّٰشِطَٰتِ نَشۡطࣰ ا"},{"n":3,"t":"وَٱلسَّٰبِحَٰتِ سَبۡحࣰ ا"},{"n":4,"t":"فَٱلسَّٰبِقَٰتِ سَبۡقࣰ ا"},{"n":5,"t":"فَٱلۡمُدَبِّرَٰتِ أَمۡرࣰ ا"},{"n":6,"t":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ"},{"n":7,"t":"تَتۡبَعُهَا ٱلرَّادِفَةُ"},{"n":8,"t":"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ"},{"n":9,"t":"أَبۡصَٰرُهَا خَٰشِعَةࣱ‏"},{"n":10,"t":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ"},{"n":11,"t":"أَءِذَا كُنَّا عِظَٰمࣰ ا نَّخِرَةࣰ‏"},{"n":12,"t":"قَالُواْ تِلۡكَ إِذࣰ ا كَرَّةٌ خَاسِرَةࣱ‏"},{"n":13,"t":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ‏"},{"n":14,"t":"فَإِذَا هُم بِٱلسَّاهِرَةِ"},{"n":15,"t":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"},{"n":16,"t":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى"},{"n":17,"t":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ"},{"n":18,"t":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"},{"n":19,"t":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ"},{"n":20,"t":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ"},{"n":21,"t":"فَكَذَّبَ وَعَصَىٰ"},{"n":22,"t":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ"},{"n":23,"t":"فَحَشَرَ فَنَادَىٰ"},{"n":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ"},{"n":25,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ"},{"n":26,"t":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشَىٰٓ"},{"n":27,"t":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا"},{"n":28,"t":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا"},{"n":29,"t":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا"},{"n":30,"t":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ"},{"n":31,"t":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا"},{"n":32,"t":"وَٱلۡجِبَالَ أَرۡسَىٰهَا"},{"n":33,"t":"مَتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"},{"n":34,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ"},{"n":35,"t":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ"},{"n":36,"t":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ"},{"n":37,"t":"فَأَمَّا مَن طَغَىٰ"},{"n":38,"t":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"n":39,"t":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ"},{"n":40,"t":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ"},{"n":41,"t":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ"},{"n":42,"t":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا"},{"n":43,"t":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ"},{"n":44,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"},{"n":45,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا"},{"n":46,"t":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا"}]}