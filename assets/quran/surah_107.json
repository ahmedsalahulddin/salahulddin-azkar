{"n":107,"name":"المَاعُونِ","ayahs":[{"n":1,"t":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ"},{"n":2,"t":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ"},{"n":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"n":4,"t":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ"},{"n":5,"t":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ"},{"n":6,"t":"ٱلَّذِينَ هُمۡ يُرَآءُونَ"},{"n":7,"t":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ"}]}