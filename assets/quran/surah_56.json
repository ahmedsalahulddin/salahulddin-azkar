{"n":56,"name":"الوَاقِعَةِ","ayahs":[{"n":1,"t":"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ"},{"n":2,"t":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ"},{"n":3,"t":"خَافِضَةࣱ رَّافِعَةٌ"},{"n":4,"t":"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجࣰّ ا"},{"n":5,"t":"وَبُسَّتِ ٱلۡجِبَالُ بَسࣰّ ا"},{"n":6,"t":"فَكَانَتۡ هَبَآءࣰ مُّنۢبَثࣰّ ا"},{"n":7,"t":"وَكُنتُمۡ أَزۡوَٰجࣰ ا ثَلَٰثَةࣰ‏"},{"n":8,"t":"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"n":9,"t":"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"n":10,"t":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ"},{"n":11,"t":"أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ"},{"n":12,"t":"فِي جَنَّٰتِ ٱلنَّعِيمِ"},{"n":13,"t":"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ"},{"n":14,"t":"وَقَلِيلࣱ مِّنَ ٱلۡأٓخِرِينَ"},{"n":15,"t":"عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ‏"},{"n":16,"t":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ"},{"n":17,"t":"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنࣱ مُّخَلَّدُونَ"},{"n":18,"t":"بِأَكۡوَابࣲ وَأَبَارِيقَ وَكَأۡسࣲ مِّن مَّعِينࣲ‏"},{"n":19,"t":"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ"},{"n":20,"t":"وَفَٰكِهَةࣲ مِّمَّا يَتَخَيَّرُونَ"},{"n":21,"t":"وَلَحۡمِ طَيۡرࣲ مِّمَّا يَشۡتَهُونَ"},{"n":22,"t":"وَحُورٌ عِينࣱ‏"},{"n":23,"t":"كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ"},{"n":24,"t":"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ"},{"n":25,"t":"لَا يَسۡمَعُونَ فِيهَا لَغۡوࣰ ا وَلَا تَأۡثِيمًا"},{"n":26,"t":"إِلَّا قِيلࣰ ا سَلَٰمࣰ ا سَلَٰمࣰ ا"},{"n":27,"t":"وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ"},{"n":28,"t":"فِي سِدۡرࣲ مَّخۡضُودࣲ‏"},{"n":29,"t":"وَطَلۡحࣲ مَّنضُودࣲ‏"},{"n":30,"t":"وَظِلࣲّ مَّمۡدُودࣲ‏"},{"n":31,"t":"وَمَآءࣲ مَّسۡكُوبࣲ‏"},{"n":32,"t":"وَفَٰكِهَةࣲ كَثِيرَةࣲ‏"},{"n":33,"t":"لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ‏"},{"n":34,"t":"وَفُرُشࣲ مَّرۡفُوعَةٍ"},{"n":35,"t":"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءࣰ‏"},{"n":36,"t":"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا"},{"n":37,"t":"عُرُبًا أَتۡرَابࣰ ا"},{"n":38,"t":"لِّأَصۡحَٰبِ ٱلۡيَمِينِ"},{"n":39,"t":"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ"},{"n":40,"t":"وَثُلَّةࣱ مِّنَ ٱلۡأٓخِرِينَ"},{"n":41,"t":"وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِ