{"n":37,"name":"الصَّافَّاتِ","ayahs":[{"n":1,"t":"وَٱلصَّٰٓفَّٰتِ صَفࣰّ ا"},{"n":2,"t":"فَٱلزَّٰجِرَٰتِ زَجۡرࣰ ا"},{"n":3,"t":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا"},{"n":4,"t":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدࣱ‏"},{"n":5,"t":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ"},{"n":6,"t":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ"},{"n":7,"t":"وَحِفۡظࣰ ا مِّن كُلِّ شَيۡطَٰنࣲ مَّارِدࣲ‏"},{"n":8,"t":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبࣲ‏"},{"n":9,"t":"دُحُورࣰ اۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ"},{"n":10,"t":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ‏"},{"n":11,"t":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينࣲ لَّازِبِۭ"},{"n":12,"t":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ"},{"n":13,"t":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ"},{"n":14,"t":"وَإِذَا رَأَوۡاْ ءَايَةࣰ يَسۡتَسۡخِرُونَ"},{"n":15,"t":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ مُّبِينٌ"},{"n":16,"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ"},{"n":17,"t":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ"},{"n":18,"t":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ"},{"n":19,"t":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمۡ يَنظُرُونَ"},{"n":20,"t":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ"},{"n":21,"t":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ"},{"n":22,"t":"۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ"},{"n":23,"t":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ"},{"n":24,"t":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ"},{"n":25,"t":"مَا لَكُمۡ لَا تَنَاصَرُونَ"},{"n":26,"t":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ"},{"n":27,"t":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ"},{"n":28,"t":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ"},{"n":29,"t":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ"},{"n":30,"t":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰ ا طَٰغِينَ"},{"n":31,"t":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ"},{"n":32,"t":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ"},{"n":33,"t":"فَإِنَّهُمۡ يَوۡمَئِذࣲ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ"},{"n":34,"t":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"},{"n":35,"t":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ"},{"n":36,"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ"},{"n":37,"t":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ"},{"n":38,"t":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ"},{"n":39,"t":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ"},{"n":40,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"},{"n":41,"t":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ‏"},{"n":42,"t":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ"},{"n":43,"t":"فِي جَنَّٰتِ ٱلنَّعِيمِ"},{"n":44,"t":"عَلَىٰ سُرُرࣲ مُّتَقَٰبِلِينَ"},{"n":45,"t":"يُطَافُ عَلَيۡهِم بِكَأۡسࣲ مِّن مَّعِينِۭ"},{"n":46,"t":"بَيۡضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ"},{"n":47,"t":"لَا فِيهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ"},{"n":48,"t":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينࣱ‏"},{"n":49,"t":"كَأَنَّهُنَّ بَيۡضࣱ مَّكۡنُونࣱ‏"},{"n":50,"t":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ"},{"n":51,"t":"قَالَ قَآئِلࣱ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينࣱ‏"},{"n":52,"t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ"},{"n":53,"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ"},{"n":54,"t":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ"},{"n":55,"t":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ"},{"n":56,"t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ"},{"n":57,"t":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ"},{"n":58,"t":"أَفَمَا نَحۡنُ بِمَيِّتِينَ"},{"n":59,"t":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ"},{"n":60,"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ"},{"n":61,"t":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ"},{"n":62,"t":"أَذَٰلِكَ خَيۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ"},{"n":63,"t":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةࣰ لِّلظَّٰلِمِينَ"},{"n":64,"t":"إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ"},{"n":65,"t":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ"},{"n":66,"t":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ"},{"n":67,"t":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبࣰ ا مِّنۡ حَمِيمࣲ‏"},{"n":68,"t":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ"},{"n":69,"t":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ"},{"n":70,"t":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ"},{"n":71,"t":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ"},{"n":72,"t":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ"},{"n":73,"t":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ"},{"n":74,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"},{"n":75,"t":"وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ ٱلۡمُجِيبُونَ"},{"n":76,"t":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ"},{"n":77,"t":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ"},{"n":78,"t":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"},{"n":79,"t":"سَلَٰمٌ عَلَىٰ نُوحࣲ فِي ٱلۡعَٰلَمِينَ"},{"n":80,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"n":81,"t":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"},{"n":82,"t":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ"},{"n":83,"t":"۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ"},{"n":84,"t":"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبࣲ سَلِيمٍ"},{"n":85,"t":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ"},{"n":86,"t":"أَئِفۡكًا ءَالِهَةࣰ دُونَ ٱللَّهِ تُرِيدُونَ"},{"n":87,"t":"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ"},{"n":88,"t":"فَنَظَرَ نَظۡرَةࣰ فِي ٱلنُّجُومِ"},{"n":89,"t":"فَقَالَ إِنِّي سَقِيمࣱ‏"},{"n":90,"t":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ"},{"n":91,"t":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ"},{"n":92,"t":"مَا لَكُمۡ لَا تَنطِقُونَ"},{"n":93,"t":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ"},{"n":94,"t":"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ"},{"n":95,"t":"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ"},{"n":96,"t":"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ"},{"n":97,"t":"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنࣰ ا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ"},{"n":98,"t":"فَأَرَادُواْ بِهِۦ كَيۡدࣰ ا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ"},{"n":99,"t":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ"},{"n":100,"t":"رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ"},{"n":101,"t":"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمࣲ‏"},{"n":102,"t":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ"},{"n":103,"t":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ"},{"n":104,"t":"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ"},{"n":105,"t":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"n":106,"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ"},{"n":107,"t":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمࣲ‏"},{"n":108,"t":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"},{"n":109,"t":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ"},{"n":110,"t":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"n":111,"t":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"},{"n":112,"t":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيࣰّ ا مِّنَ ٱلصَّٰلِحِينَ"},{"n":113,"t":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنࣱ وَظَالِمࣱ لِّنَفۡسِهِۦ مُبِينࣱ‏"},{"n":114,"t":"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ"},{"n":115,"t":"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ"},{"n":116,"t":"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ"},{"n":117,"t":"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ"},{"n":118,"t":"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ"},{"n":119,"t":"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ"},{"n":120,"t":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ"},{"n":121,"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"n":122,"t":"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"},{"n":123,"t":"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ"},{"n":124,"t":"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ"},{"n":125,"t":"أَتَدۡعُونَ بَعۡلࣰ ا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ"},{"n":126,"t":"ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ"},{