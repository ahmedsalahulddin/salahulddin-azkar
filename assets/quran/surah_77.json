{"n":77,"name":"المُرۡسَلَاتِ","ayahs":[{"n":1,"t":"وَٱلۡمُرۡسَلَٰتِ عُرۡفࣰ ا"},{"n":2,"t":"فَٱلۡعَٰصِفَٰتِ عَصۡفࣰ ا"},{"n":3,"t":"وَٱلنَّٰشِرَٰتِ نَشۡرࣰ ا"},{"n":4,"t":"فَٱلۡفَٰرِقَٰتِ فَرۡقࣰ ا"},{"n":5,"t":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا"},{"n":6,"t":"عُذۡرًا أَوۡ نُذۡرًا"},{"n":7,"t":"إِنَّمَا تُوعَدُونَ لَوَٰقِعࣱ‏"},{"n":8,"t":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ"},{"n":9,"t":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ"},{"n":10,"t":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ"},{"n":11,"t":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ"},{"n":12,"t":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ"},{"n":13,"t":"لِيَوۡمِ ٱلۡفَصۡلِ"},{"n":14,"t":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ"},{"n":15,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"n":16,"t":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ"},{"n":17,"t":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ"},{"n":18,"t":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"},{"n":19,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"n":20,"t":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءࣲ مَّهِينࣲ‏"},{"n":21,"t":"فَجَعَلۡنَٰهُ فِي قَرَارࣲ مَّكِينٍ"},{"n":22,"t":"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ‏"},{"n":23,"t":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ"},{"n":24,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"n":25,"t":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا"},{"n":26,"t":"أَحۡيَآءࣰ وَأَمۡوَٰتࣰ ا"},{"n":27,"t":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسۡقَيۡنَٰكُم مَّآءࣰ فُرَاتࣰ ا"},{"n":28,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"n":29,"t":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"n":30,"t":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلࣲّ ذِي ثَلَٰثِ شُعَبࣲ‏"},{"n":31,"t":"لَّا ظَلِيلࣲ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ"},{"n":32,"t":"إِنَّهَا تَرۡمِي بِشَرَرࣲ كَٱلۡقَصۡرِ"},{"n":33,"t":"كَأَنَّهُۥ جِمَٰلَتࣱ صُفۡرࣱ‏"},{"n":34,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"n":35,"t":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ"},{"n":36,"t":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ"},{"n":37,"t":"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ"},{"n":38,"t":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ"},{"n":39,"t":"فَإِن كَانَ لَكُمۡ كَيۡدࣱ فَكِيدُونِ"},{"n":40,"t":"وَيۡلࣱ يَوۡمَ