{"n":101,"name":"القَارِعَةِ","ayahs":[{"n":1,"t":"ٱلۡقَارِعَةُ"},{"n":2,"t":"مَا ٱلۡقَارِعَةُ"},{"n":3,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"},{"n":4,"t":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"},{"n":5,"t":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"},{"n":6,"t":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"},{"n":7,"t":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏"},{"n":8,"t":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"},{"n":9,"t":"فَأُمُّهُۥ هَاوِيَةࣱ‏"},{"n":10,"t":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ"},{"n":11,"t":"نَارٌ حَامِيَةُۢ"}]}