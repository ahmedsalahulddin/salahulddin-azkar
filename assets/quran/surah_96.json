{"n":96,"name":"العَلَقِ","ayahs":[{"n":1,"t":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ"},{"n":2,"t":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ"},{"n":3,"t":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ"},{"n":4,"t":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ"},{"n":5,"t":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ"},{"n":6,"t":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ"},{"n":7,"t":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ"},{"n":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ"},{"n":9,"t":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ"},{"n":10,"t":"عَبۡدًا إِذَا صَلَّىٰٓ"},{"n":11,"t":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ"},{"n":12,"t":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ"},{"n":13,"t":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"n":14,"t":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"n":15,"t":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ"},{"n":16,"t":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏"},{"n":17,"t":"فَلۡيَدۡعُ نَادِيَهُۥ"},{"n":18,"t":"سَنَدۡعُ ٱلزَّبَانِيَةَ"},{"n":19,"t":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","s":1}]}