{"n":91,"name":"الشَّمۡسِ","ayahs":[{"n":1,"t":"وَٱلشَّمۡسِ وَضُحَىٰهَا"},{"n":2,"t":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا"},{"n":3,"t":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"n":4,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا"},{"n":5,"t":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"n":6,"t":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا"},{"n":7,"t":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا"},{"n":8,"t":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا"},{"n":9,"t":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا"},{"n":10,"t":"وَقَدۡ خَابَ مَن دَسَّىٰهَا"},{"n":11,"t":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ"},{"n":12,"t":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا"},{"n":13,"t":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا"},{"n":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا"},{"n":15,"t":"وَلَا يَخَافُ عُقۡبَٰهَا"}]}