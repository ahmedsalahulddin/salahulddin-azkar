{"n":84,"name":"الانشِقَاقِ","ayahs":[{"n":1,"t":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ"},{"n":2,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"n":3,"t":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ"},{"n":4,"t":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"},{"n":5,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"n":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰ ا فَمُلَٰقِيهِ"},{"n":7,"t":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"n":8,"t":"فَسَوۡفَ يُحَاسَبُ حِسَابࣰ ا يَسِيرࣰ ا"},{"n":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰ ا"},{"n":10,"t":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ"},{"n":11,"t":"فَسَوۡفَ يَدۡعُواْ ثُبُورࣰ ا"},{"n":12,"t":"وَيَصۡلَىٰ سَعِيرًا"},{"n":13,"t":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"},{"n":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"n":15,"t":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرࣰ ا"},{"n":16,"t":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ"},{"n":17,"t":"وَٱلَّيۡلِ وَمَا وَسَقَ"},{"n":18,"t":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ"},{"n":19,"t":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ‏"},{"n":20,"t":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"},{"n":21,"t":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","s":1},{"n":22,"t":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"n":23,"t":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"},{"n":24,"t":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"},{"n":25,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ"}]}