{"n":90,"name":"البَلَدِ","ayahs":[{"n":1,"t":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ"},{"n":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ"},{"n":3,"t":"وَوَالِدࣲ وَمَا وَلَدَ"},{"n":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ"},{"n":5,"t":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏"},{"n":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا"},{"n":7,"t":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ"},{"n":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"},{"n":9,"t":"وَلِسَانࣰ ا وَشَفَتَيۡنِ"},{"n":10,"t":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ"},{"n":11,"t":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ"},{"n":12,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ"},{"n":13,"t":"فَكُّ رَقَبَةٍ"},{"n":14,"t":"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏"},{"n":15,"t":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ"},{"n":16,"t":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏"},{"n":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ"},{"n":18,"t":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"n":19,"t":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"n":20,"t":"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ"}]}