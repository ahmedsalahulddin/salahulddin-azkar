{"n":100,"name":"العَادِيَاتِ","ayahs":[{"n":1,"t":"وَٱلۡعَٰدِيَٰتِ ضَبۡحࣰ ا"},{"n":2,"t":"فَٱلۡمُورِيَٰتِ قَدۡحࣰ ا"},{"n":3,"t":"فَٱلۡمُغِيرَٰتِ صُبۡحࣰ ا"},{"n":4,"t":"فَأَثَرۡنَ بِهِۦ نَقۡعࣰ ا"},{"n":5,"t":"فَوَسَطۡنَ بِهِۦ جَمۡعًا"},{"n":6,"t":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ‏"},{"n":7,"t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ‏"},{"n":8,"t":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ"},{"n":9,"t":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ"},{"n":10,"t":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ"},{"n":11,"t":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ"}]}