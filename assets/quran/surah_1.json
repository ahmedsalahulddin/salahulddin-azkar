{"n":1,"name":"ٱلْفَاتِحَةِ","ayahs":[{"n":1,"t":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"},{"n":2,"t":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ"},{"n":3,"t":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"},{"n":4,"t":"مَٰلِكِ يَوۡمِ ٱلدِّينِ"},{"n":5,"t":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ"},{"n":6,"t":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ"},{"n":7,"t":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ"}]}