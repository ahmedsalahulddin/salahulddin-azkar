{"n":87,"name":"الأَعۡلَىٰ","ayahs":[{"n":1,"t":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى"},{"n":2,"t":"ٱلَّذِي خَلَقَ فَسَوَّىٰ"},{"n":3,"t":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ"},{"n":4,"t":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ"},{"n":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ"},{"n":6,"t":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ"},{"n":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ"},{"n":8,"t":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ"},{"n":9,"t":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ"},{"n":10,"t":"سَيَذَّكَّرُ مَن يَخۡشَىٰ"},{"n":11,"t":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى"},{"n":12,"t":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ"},{"n":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ"},{"n":14,"t":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ"},{"n":15,"t":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ"},{"n":16,"t":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"n":17,"t":"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ"},{"n":18,"t":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ"},{"n":19,"t":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ"}]}