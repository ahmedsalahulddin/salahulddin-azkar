{"n":80,"name":"عَبَسَ","ayahs":[{"n":1,"t":"عَبَسَ وَتَوَلَّىٰٓ"},{"n":2,"t":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ"},{"n":3,"t":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"},{"n":4,"t":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ"},{"n":5,"t":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ"},{"n":6,"t":"فَأَنتَ لَهُۥ تَصَدَّىٰ"},{"n":7,"t":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ"},{"n":8,"t":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ"},{"n":9,"t":"وَهُوَ يَخۡشَىٰ"},{"n":10,"t":"فَأَنتَ عَنۡهُ تَلَهَّىٰ"},{"n":11,"t":"كَلَّآ إِنَّهَا تَذۡكِرَةࣱ‏"},{"n":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"n":13,"t":"فِي صُحُفࣲ مُّكَرَّمَةࣲ‏"},{"n":14,"t":"مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ"},{"n":15,"t":"بِأَيۡدِي سَفَرَةࣲ‏"},{"n":16,"t":"كِرَامِۭ بَرَرَةࣲ‏"},{"n":17,"t":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ"},{"n":18,"t":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ"},{"n":19,"t":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"n":20,"t":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"},{"n":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ"},{"n":22,"t":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"},{"n":23,"t":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ"},{"n":24,"t":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"},{"n":25,"t":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبࣰّ ا"},{"n":26,"t":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّ ا"},{"n":27,"t":"فَأَنۢبَتۡنَا فِيهَا حَبࣰّ ا"},{"n":28,"t":"وَعِنَبࣰ ا وَقَضۡبࣰ ا"},{"n":29,"t":"وَزَيۡتُونࣰ ا وَنَخۡلࣰ ا"},{"n":30,"t":"وَحَدَآئِقَ غُلۡبࣰ ا"},{"n":31,"t":"وَفَٰكِهَةࣰ وَأَبࣰّ ا"},{"n":32,"t":"مَّتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"},{"n":33,"t":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"},{"n":34,"t":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ"},{"n":35,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"n":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِ"},{"n":37,"t":"لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمۡ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِ"},{"n":38,"t":"وُجُوهࣱ يَوۡمَئِذࣲ مُّسۡفِرَةࣱ‏"},{"n":39,"t":"ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ‏"},{"n":40,"t":"وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ‏"},{"n":41,"t":"تَرۡهَقُهَا قَتَرَةٌ"},{"n":42,"t":"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ"}]}