{"n":88,"name":"الغَاشِيَةِ","ayahs":[{"n":1,"t":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ"},{"n":2,"t":"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ"},{"n":3,"t":"عَامِلَةࣱ نَّاصِبَةࣱ‏"},{"n":4,"t":"تَصۡلَىٰ نَارًا حَامِيَةࣰ‏"},{"n":5,"t":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏"},{"n":6,"t":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏"},{"n":7,"t":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏"},{"n":8,"t":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏"},{"n":9,"t":"لِّسَعۡيِهَا رَاضِيَةࣱ‏"},{"n":10,"t":"فِي جَنَّةٍ عَالِيَةࣲ‏"},{"n":11,"t":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةࣰ‏"},{"n":12,"t":"فِيهَا عَيۡنࣱ جَارِيَةࣱ‏"},{"n":13,"t":"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏"},{"n":14,"t":"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏"},{"n":15,"t":"وَنَمَارِقُ مَصۡفُوفَةࣱ‏"},{"n":16,"t":"وَزَرَابِيُّ مَبۡثُوثَةٌ"},{"n":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ"},{"n":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ"},{"n":19,"t":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ"},{"n":20,"t":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ"},{"n":21,"t":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ‏"},{"n":22,"t":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ"},{"n":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"n":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ"},{"n":25,"t":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ"},{"n":26,"t":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم"}]}