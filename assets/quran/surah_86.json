{"n":86,"name":"الطَّارِقِ","ayahs":[{"n":1,"t":"وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"n":2,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ"},{"n":3,"t":"ٱلنَّجۡمُ ٱلثَّاقِبُ"},{"n":4,"t":"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ‏"},{"n":5,"t":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ"},{"n":6,"t":"خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏"},{"n":7,"t":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ"},{"n":8,"t":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ‏"},{"n":9,"t":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ"},{"n":10,"t":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ‏"},{"n":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ"},{"n":12,"t":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ"},{"n":13,"t":"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ‏"},{"n":14,"t":"وَمَا هُوَ بِٱلۡهَزۡلِ"},{"n":15,"t":"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰ ا"},{"n":16,"t":"وَأَكِيدُ كَيۡدࣰ ا"},{"n":17,"t":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا"}]}