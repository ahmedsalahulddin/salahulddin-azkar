{"n":82,"name":"الانفِطَارِ","ayahs":[{"n":1,"t":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ"},{"n":2,"t":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ"},{"n":3,"t":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ"},{"n":4,"t":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ"},{"n":5,"t":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ"},{"n":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ"},{"n":7,"t":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},{"n":8,"t":"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ"},{"n":9,"t":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ"},{"n":10,"t":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ"},{"n":11,"t":"كِرَامࣰ ا كَٰتِبِينَ"},{"n":12,"t":"يَعۡلَمُونَ مَا تَفۡعَلُونَ"},{"n":13,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ‏"},{"n":14,"t":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ‏"},{"n":15,"t":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ"},{"n":16,"t":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ"},{"n":17,"t":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"n":18,"t":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"n":19,"t":"يَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔ اۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ"}]}