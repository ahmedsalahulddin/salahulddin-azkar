{"n":92,"name":"اللَّيۡلِ","ayahs":[{"n":1,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ"},{"n":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"n":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"n":4,"t":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ"},{"n":5,"t":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ"},{"n":6,"t":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ"},{"n":7,"t":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"},{"n":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"},{"n":9,"t":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ"},{"n":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"},{"n":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"n":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ"},{"n":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ"},{"n":14,"t":"فَأَنذَرۡتُكُمۡ نَارࣰ ا تَلَظَّىٰ"},{"n":15,"t":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى"},{"n":16,"t":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"n":17,"t":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"},{"n":18,"t":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ"},{"n":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ"},{"n":20,"t":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ"},{"n":21,"t":"وَلَسَوۡفَ يَرۡضَىٰ"}]}