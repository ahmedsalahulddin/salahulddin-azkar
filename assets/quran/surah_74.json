{"n":74,"name":"المُدَّثِّرِ","ayahs":[{"n":1,"t":"يَٰٓأَيُّهَا ٱلۡمُدَّثِّرُ"},{"n":2,"t":"قُمۡ فَأَنذِرۡ"},{"n":3,"t":"وَرَبَّكَ فَكَبِّرۡ"},{"n":4,"t":"وَثِيَابَكَ فَطَهِّرۡ"},{"n":5,"t":"وَٱلرُّجۡزَ فَٱهۡجُرۡ"},{"n":6,"t":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ"},{"n":7,"t":"وَلِرَبِّكَ فَٱصۡبِرۡ"},{"n":8,"t":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ"},{"n":9,"t":"فَذَٰلِكَ يَوۡمَئِذࣲ يَوۡمٌ عَسِيرٌ"},{"n":10,"t":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرࣲ‏"},{"n":11,"t":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدࣰ ا"},{"n":12,"t":"وَجَعَلۡتُ لَهُۥ مَالࣰ ا مَّمۡدُودࣰ ا"},{"n":13,"t":"وَبَنِينَ شُهُودࣰ ا"},{"n":14,"t":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدࣰ ا"},{"n":15,"t":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ"},{"n":16,"t":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدࣰ ا"},{"n":17,"t":"سَأُرۡهِقُهُۥ صَعُودًا"},{"n":18,"t":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ"},{"n":19,"t":"فَقُتِلَ كَيۡفَ قَدَّرَ"},{"n":20,"t":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ"},{"n":21,"t":"ثُمَّ نَظَرَ"},{"n":22,"t":"ثُمَّ عَبَسَ وَبَسَرَ"},{"n":23,"t":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ"},{"n":24,"t":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ يُؤۡثَرُ"},{"n":25,"t":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ"},{"n":26,"t":"سَأُصۡلِيهِ سَقَرَ"},{"n":27,"t":"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ"},{"n":28,"t":"لَا تُبۡقِي وَلَا تَذَرُ"},{"n":29,"t":"لَوَّاحَةࣱ لِّلۡبَشَرِ"},{"n":30,"t":"عَلَيۡهَا تِسۡعَةَ عَشَرَ"},{"n":31,"t":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنࣰ ا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلࣰ اۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ"},{"n":32,"t":"كَلَّا وَٱلۡقَمَرِ"},{"n":33,"t":"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ"},{"n":34,"t":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ"},{"n":35,"t":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ"},{"n":36,"t":"نَذِيرࣰ ا لِّلۡبَشَرِ"},{"n":37,"t":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ"},{"n":38,"t":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ"},{"n":39,"t":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ"},{"n":40,"t":"فِي جَنَّٰتࣲ يَتَسَآءَلُونَ"},{"n":41,"t":"عَنِ ٱلۡمُجۡرِمِينَ"},{"n":42,"t":"مَا سَلَكَكُمۡ فِي سَقَرَ"},{"n":43,"t":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ"},{"n":44,"t":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ"},{"n":45,"t":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ"},{"n":46,"t":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ"},{"n":47,"t":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ"},{"n":48,"t":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ"},{"n":49,"t":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ"},{"n":50,"t":"كَأَنَّهُمۡ حُمُرࣱ مُّسۡتَنفِرَةࣱ‏"},{"n":51,"t":"فَرَّتۡ مِن قَسۡوَرَةِۭ"},{"n":52,"t":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفࣰ ا مُّنَشَّرَةࣰ‏"},{"n":53,"t":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ"},{"n":54,"t":"كَلَّآ إِنَّهُۥ تَذۡكِرَةࣱ‏"},{"n":55,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"n":56,"t":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ"}]}