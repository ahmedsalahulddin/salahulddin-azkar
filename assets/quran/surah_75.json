{"n":75,"name":"القِيَامَةِ","ayahs":[{"n":1,"t":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ"},{"n":2,"t":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ"},{"n":3,"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ"},{"n":4,"t":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ"},{"n":5,"t":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ"},{"n":6,"t":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ"},{"n":7,"t":"فَإِذَا بَرِقَ ٱلۡبَصَرُ"},{"n":8,"t":"وَخَسَفَ ٱلۡقَمَرُ"},{"n":9,"t":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ"},{"n":10,"t":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ"},{"n":11,"t":"كَلَّا لَا وَزَرَ"},{"n":12,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ"},{"n":13,"t":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"n":14,"t":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ‏"},{"n":15,"t":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ"},{"n":16,"t":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ"},{"n":17,"t":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ"},{"n":18,"t":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ"},{"n":19,"t":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ"},{"n":20,"t":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ"},{"n":21,"t":"وَتَذَرُونَ ٱلۡأٓخِرَةَ"},{"n":22,"t":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاضِرَةٌ"},{"n":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةࣱ‏"},{"n":24,"t":"وَوُجُوهࣱ يَوۡمَئِذِۭ بَاسِرَةࣱ‏"},{"n":25,"t":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةࣱ‏"},{"n":26,"t":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ"},{"n":27,"t":"وَقِيلَ مَنۡۜ رَاقࣲ‏"},{"n":28,"t":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ"},{"n":29,"t":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"n":30,"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ"},{"n":31,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"n":32,"t":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"n":33,"t":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ"},{"n":34,"t":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ"},{"n":35,"t":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ"},{"n":36,"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى"},{"n":37,"t":"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ يُمۡنَىٰ"},{"n":38,"t":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ"},{"n":39,"t":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"n":40,"t":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ"}]}