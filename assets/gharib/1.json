{"1":[{"w":"بِسۡمِ ٱللَّهِ","m":"أبتدِئُ القراءةَ مُسْتعيناً باللهِ."},{"w":"ٱلرَّحۡمَٰنِ","m":"ذي الرَّحمةِ العامَّةِ لجميع الخَلْقِ."},{"w":"ٱلرَّحِيمِ","m":"ذي الرَّحمةِ الخاصَّةِ بِالمؤمنين."}],"2":[{"w":"ٱلۡحَمۡدُ","m":"الثَّناءُ على اللهِ بصفاتِه، وبنِعَمِه كلِّها."},{"w":"ٱلۡعَٰلَمِينَ","m":"جميعِ الخلْقِ."}],"4":[{"w":"يَوۡمِ ٱلدِّينِ","m":"يومِ القيامةِ الذي يكونُ فيه الجزاءُ."}],"5":[{"w":"إِيَّاكَ نَعۡبُدُ","m":"نَخُصُّك بالعبادةِ."}],"6":[{"w":"ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","m":"الطَّريقَ الواضحَ، المُوصِلَ إلى رِضوانِ اللهِ، وهو الإسلامُ."}],"7":[{"w":"أَنۡعَمۡتَ عَلَيۡهِمۡ","m":"مَنَنْتَ عليهم بالهدايةِ والتَّوفيقِ."},{"w":"ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ","m":"الذين عَرَفُوا الحقَّ ولم يَعْمَلُوا به."},{"w":"ٱلضَّآلِّينَ","m":"الذين يَعْمَلُون ويَعْبُدون بِلَا عِلْمٍ."}]}