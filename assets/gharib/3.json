{"1":[{"w":"الٓمٓ","m":"سَبَقَ الكَلَامُ على الحُرُوفِ المقَطَّعَةِ في أَوَّل سورة البقرة."}],"2":[{"w":"ٱلۡقَيُّومُ","m":"القائمُ بنفسِه، والمُقيمُ لأحوالِ خَلْقِه."}],"3":[{"w":"ٱلۡكِتَٰبَ","m":"القرآنَ."},{"w":"مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ","m":"يَشْهَدُ على صِدْقِ ما قبلَه من كُتُبٍ."}],"4":[{"w":"ٱلۡفُرۡقَانَ","m":"ما يُفَرِّقُ بينَ الحقِّ والباطلِ، وهو القرآنُ."}],"6":[{"w":"كَيۡفَ يَشَآءُ","m":"مِنْ ذَكَرٍ وأنثى، وشَقِيٍّ وسعيدٍ، وغيرِ ذلك."}],"7":[{"w":"مُحۡكَمَٰتٌ","m":"واضحاتُ المعنى، ظاهراتُ الدَّلالةِ."},{"w":"أُمُّ ٱلۡكِتَٰبِ","m":"أصلُه الذي يُرْجَعُ إليه عندَ الاشتِباهِ."},{"w":"مُتَشَٰبِهَٰتٞ","m":"لا يتعَيَّنُ معناها، ولا تَظْهَرُ دَلالتُها إلَّا بِضَمِّهَا إلى المُحْكَمِ."},{"w":"زَيۡغٞ","m":"مَيْلٌ."},{"w":"فَيَتَّبِعُونَ مَا تَشَٰبَهَ مِنۡهُ","m":"يَتَّبعون الآياتِ المتشابهاتِ، فيُشَكِّكُون بها على المؤمنين."},{"w":"ٱبۡتِغَآءَ ٱلۡفِتۡنَةِ","m":"طَلَباً منهم للتَّلبيسِ عليهم في دينِهم."},{"w":"وَٱبۡتِغَآءَ تَأۡوِيلِهِۦ","m":"ولتأويلِهم لها على الوجه الذي يوافِقُ مذهبَهم."},{"w":"وَٱلرَّٰسِخُونَ","m":"والمتمَكِّنُونَ."},{"w":"كُلّٞ","m":"كلُّ القرآنِ."},{"w":"وَمَا يَذَّكَّرُ","m":"وما يتدبَّرُ المعانيَ على وَجْهِها الصحيحِ."},{"w":"أُوْلُواْ ٱلۡأَلۡبَٰبِ","m":"أصحابُ العقولِ السليمةِ."}],"8":[{"w":"لَا تُزِغۡ قُلُوبَنَا","m":"لاتَصْرِفْ قلوبَنا عن الإيمانِ بك."}],"10":[{"w":"لَن تُغۡنِيَ عَنۡهُمۡ","m":"لن تنفعَهم، ولن تُنْجِيَهم."},{"w":"مِنَ ٱللَّهِ","m":"من عقوبتهِ، إن أحَلَّها بهم عاجلاً في الدنيا."},{"w":"وَقُودُ ٱلنَّارِ","m":"حَطَبُ النارِ."}],"11":[{"w":"كَدَأۡبِ ءَالِ فِرۡعَوۡنَ","m":"شَأْنُ الكافرين في تكذيبهِم وما يَنْزِلُ بهم من العقوبةِ مِثْلُ شأنِ آلِ فرعونَ."},{"w":"فَأَخَذَهُمُ ٱللَّهُ","m":"فعاجَلَهم بالعُقوبةِ."}],"12":[{"w":"لِلَّذِينَ كَفَرُواْ","m":"لليهودِ."},{"w":"وَتُحۡشَرُونَ","m":"وتُجْمَعون، وتُساقُون."},{"w":"ٱلۡمِهَادُ","m":"الفِراشُ."}],"13":[{"w":"ءَايَةٞ","m":"دَلالَةٌ عظيمةٌ."},{"w":"ٱلۡتَقَتَا","m":"أي: في معركةِ بدرٍ."},{"w":"يَرَوۡنَهُم مِّثۡلَيۡهِمۡ","m":"يرى المشركون المسلمين في العددِ مثلَيْهم."},{"w":"لَعِبۡرَةٗ","m":"لعِظَةً."},{"w":"لِأُوْلِي ٱلۡأَبۡصَٰرِ","m":"لأصحابِ البصائرِ."}],"14":[{"w":"زُيِّنَ","m":"حُسِّنَ."},{"w":"وَٱلۡقَنَٰطِيرِ ٱلۡمُقَنطَرَةِ","m":"والأموالِ الكثيرةِ."},{"w":"ٱلۡمُسَوَّمَةِ","m":"المُعَلَّمَةِ الحِسانِ."},{"w":"وَٱلۡأَنۡعَٰمِ","m":"من الإبِلِ، والبقرِ، والغَنَمِ."},{"w":"وَٱلۡحَرۡثِ","m":"الأرضِ المتخَذَةِ للزِّراعةِ."},{"w":"ٱلۡمَـَٔابِ","m":"المَرْجِعِ."}],"15":[{"w":"مِن ذَٰلِكُمۡ","m":"ممَّا حُسِّنَ للناسِ في الحياةِ الدُّنيا."},{"w":"مُطَهَّرَةٞ","m":"من الحَيْضِ والنِّفاسِ، وسوءِ الخُلُقِ."},{"w":"وَرِضۡوَٰنٞ","m":"ورِضا."}],"16":[{"w":"وَقِنَا","m":"ونَجِّنا."}],"17":[{"w":"وَٱلصَّٰدِقِينَ","m":"الذين صَدَقُوا اللهَ، فعَمِلُوا بماجاء عنه."},{"w":"وَٱلۡقَٰنِتِينَ","m":"والمطيعين له."},{"w":"بِٱلۡأَسۡحَارِ","m":"بآخِرِ الليلِ."}],"18":[{"w":"وَٱلۡمَلَٰٓئِكَةُ","m":"أي: يَشْهَدُون كذلك."},{"w":"بِٱلۡقِسۡطِ","m":"بالعَدْلِ."}],"19":[{"w":"مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡعِلۡمُ","m":"أي: المقتضي لعَدَمِ الاختلافِ، بما تَضَمَّنَتْه كُتُبُهم المنزَّلةُ."},{"w":"بَغۡيَۢا بَيۡنَهُمۡ","m":"حَسَداً وطَلَباً للدُّنيا، فصَدَّهم عن اتِّباعِ الحَقِّ."},{"w":"سَرِيعُ ٱلۡحِسَابِ","m":"يحفَظُ ذلك عليهم بغيرِ كُلْفَةٍ."}],"20":[{"w":"حَآجُّوكَ","m":"جادَلُوك أيُّها الرسولُ."},{"w":"أَسۡلَمۡتُ","m":"أخلَصْتُ."},{"w":"وَمَنِ ٱتَّبَعَنِ","m":"وكذلك أَسْلَمَ وجهَه مَنِ اتَّبعَني."},{"w":"وَٱلۡأُمِّيِّـۧنَ","m":"مُشْركي العربِ الذين لايكتبُون."},{"w":"تَوَلَّوۡاْ","m":"أَعْرَضُوا."}],"21":[{"w":"بِٱلۡقِسۡطِ","m":"بالعَدْلِ."}],"22":[{"w":"حَبِطَتۡ","m":"بَطَلَتْ."}],"23":[{"w":"إِلَى ٱلَّذِينَ","m":"إلى اليهودِ الذين كانوا في زمن النبيِّ ﷺ مِمَّن أُوتي عِلْماً."},{"w":"نَصِيبٗا مِّنَ ٱلۡكِتَٰبِ","m":"حَظّاً من التوراةِ."},{"w":"كِتَٰبِ ٱللَّهِ","m":"التوراةِ."},{"w":"يَتَوَلَّىٰ","m":"يأبَى."}],"24":[{"w":"ذَٰلِكَ","m":"الانصرافُ عن الحقِّ."},{"w":"وَغَرَّهُمۡ","m":"وخَدَعَهم."},{"w":"يَفۡتَرُونَ","m":"يختلِقُون من الأكاذيبِ في ادِّعائِهم أنهم أبناءُ اللهِ وأحِبَّاؤُه."}],"25":[{"w":"فَكَيۡفَ","m":"أي: فكيف يكونُ حالهُم؟"},{"w":"وَوُفِّيَتۡ","m":"وجُوزِيَتْ."},{"w":"مَا كَسَبَتۡ","m":"ما عَمِلَتْ من خيرٍ أو شَرٍّ."}],"26":[{"w":"تَنزِعُ","m":"تَسْلُبُ."}],"27":[{"w":"تُولِجُ","m":"تُدْخِلُ."},{"w":"وَتُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ","m":"تُخْرِجُ الإنسانَ الحَيَّ من النُّطْفةِ الميتةِ."},{"w":"وَتُخۡرِجُ ٱلۡمَيِّتَ مِنَ ٱلۡحَيِّ","m":"تُخْرِجُ النُّطْفَةَ الميتة من الإنسانِ الحيِّ."},{"w":"بِغَيۡرِ حِسَابٖ","m":"بغير مُحاسَبةٍ."}],"28":[{"w":"لَا يَتَّخِذِ ٱلۡمُؤۡمِنُونَ ٱلۡكَٰفِرِينَ أَوۡلِيَآءَ","m":"لا تَتَّخِذُوا أيها المؤمنون الكافرين أنصاراً."},{"w":"إِلَّآ أَن تَتَّقُواْ مِنۡهُمۡ تُقَىٰةٗ","m":"إلاأن تكونوا ضِعافاً، فرَخَّص لكم في مُهادنتِهم؛ اتقاءً لشَرِّهم."},{"w":"ٱلۡمَصِيرُ","m":"رجوعُ الخلائقِ للحِسابِ."}],"29":[{"w":"تُبۡدُوهُ","m":"تُظْهِرُوه."}],"30":[{"w":"مُحۡضَرٗا","m":"مُوَفَّراً."},{"w":"أَمَدَۢا","m":"زَمَناً وأجَلاً."}],"32":[{"w":"تَوَلَّوۡاْ","m":"أَعْرَضُوا."}],"33":[{"w":"ٱصۡطَفَىٰٓ","m":"اختار."},{"w":"عَلَى ٱلۡعَٰلَمِينَ","m":"جَعَلَهم أفضلَ أهلِ زمانِهم."}],"34":[{"w":"ذُرِّيَّةَۢ بَعۡضُهَا مِنۢ بَعۡضٖ","m":"تَسَلْسَلَ الفَضْلُ في ذَراريهم."}],"35":[{"w":"ٱمۡرَأَتُ عِمۡرَٰنَ","m":"أمُّ مريمَ."},{"w":"نَذَرۡتُ","m":"جَعَلْتُه لخِدْمَةِ بيتِ المقدسِ."},{"w":"مُحَرَّرٗا","m":"خالصاً لعبادتِك."}],"36":[{"w":"وَضَعۡتُهَآ أُنثَىٰ","m":"أي: لاتَصْلُحُ للخِدْمةِ."},{"w":"وَلَيۡسَ ٱلذَّكَرُ كَٱلۡأُنثَىٰ","m":"ليس الذَّكَرُ الذي أرَدْتُ للخدمةِ كالأنثى التي لا تَصْلُحُ لذلك."},{"w":"أُعِيذُهَا","m":"أُحَصِّنُها."},{"w":"ٱلرَّجِيمِ","m":"المَطْرودِ من رحمتك."}],"37":[{"w":"وَأَنۢبَتَهَا نَبَاتًا حَسَنٗا","m":"تَوَلَّى ابْنَتَها، فكَمُلَتْ بذلك أحوالُها."},{"w":"ٱلۡمِحۡرَابَ","m":"مَحَلَّ عبادتهِ."}],"38":[{"w":"هُنَالِكَ","m":"عند رؤيةِ زكريَّا ما عندَ مريمَ من رزقِ اللهِ وفَضْلهِ."},{"w":"ذُرِّيَّةٗ طَيِّبَةً","m":"وَلَداً مباركاً. وتُطْلَقُ الذُّرِّيَّةُ على الجمعِ والواحدِ."}],"39":[{"w":"ٱلۡمِحۡرَابِ","m":"مُقَدَّم المسجدِ، وهو مكانُ عبادتِه."},{"w":"مُصَدِّقَۢا بِكَلِمَةٖ مِّنَ ٱللَّهِ","m":"يُصَدِّقُ بعيسى عليه السلامُ."},{"w":"وَسَيِّدٗا","m":"شريفاً في العِلْمِ والعبادةِ."},{"w":"وَحَصُورٗا","m":"يَكُفُّ عن النساءِ، فيمتنعُ عنهنَّ مع القُدرةِ."}],"40":[{"w":"أَنَّىٰ","m":"من أيِّ وجهٍ؟"},{"w":"ٱلۡكِبَرُ","m":"الشيخوخةُ."},{"w":"عَاقِرٞ","m":"عَقيمٌ."},{"w":"كَذَٰلِكَ ٱللَّهُ","m":"هَيِّنٌ عليه أن يخلقَ ولداً من الكبيرِ والعقيمِ."}],"41":[{"w":"ءَايَةٗ","m":"علامةً أسْتَدِلُّ بها على وجودِ الوَلَدِ."},{"w":"رَمۡزٗا","m":"إشارةً وإيماءً."},{"w":"بِٱلۡعَشِيِّ","m":"مِنْ زوالِ الشمسِ إلى أن تَغِيبَ."},{"w":"وَٱلۡإِبۡكَٰرِ","m":"من مَطْلَعِ الفجرِ إلى وقتِ الضُّحى."}],"42":[{"w":"ٱصۡطَفَىٰكِ","m":"اختارَكِ لطاعتِه."},{"w":"ٱلۡعَٰلَمِينَ","m":"عالَمِي زمانِك."}],"43":[{"w":"ٱقۡنُتِي","m":"أَخْلِصي الطاعةَ لربِّك."}],"44":[{"w":"وَمَا كُنتَ لَدَيۡهِمۡ","m":"أي: نحن نُعْلِمُك أخبارَهم."},{"w":"يُلۡقُونَ أَقۡلَٰمَهُمۡ","m":"يُجْرُون القُرْعَةَ، بإلقاءِ سِهامِهم على كَفالةِ مريمَ، فأصابَتْ زكريا."}],"45":[{"w":"بِكَلِمَةٖ مِّنۡهُ","m":"يكونُ وجودُه بكلمةٍ من اللهِ، وهي قولُه: «كن»، فيكونُ."},{"w":"وَجِيهٗا","m":"له الجاهُ العظيمُ عندَ اللهِ."}],"46":[{"w":"فِي ٱلۡمَهۡدِ","m":"في مَضْجَعِ الصبيِّ في رَضاعِه."},{"w":"وَكَهۡلٗا","m":"مَنْ كان بينَ سِنِّ الشَّبابِ والشيخوخةِ."}],"47":[{"w":"أَنَّىٰ","m":"من أيِّ وجه؟"}],"48":[{"w":"ٱلۡكِتَٰبَ","m":"الكتابةَ."}],"49":[{"w":"بِـَٔايَةٖ","m":"بعلامةٍ دالَّةٍ على أني مُرْسَلٌ من اللهِ."},{"w":"فِيهِ","m":"في ذلك الخَلْقِ."},{"w":"ٱلۡأَكۡمَهَ","m":"مَنْ وُلِدَ أعمى."},{"w":"وَٱلۡأَبۡرَصَ","m":"مَنْ يَظْهَرُ في جِلْده بياضٌ."},{"w":"تَدَّخِرُونَ","m":"تُخَبِّئون لوقتِ الحاجةِ."}],"50":[{"w":"وَمُصَدِّقٗا","m":"وجِئتُكم مُصَدِّقاً."},{"w":"بَعۡضَ ٱلَّذِي حُرِّمَ عَلَيۡكُمۡ","m":"مثلَ لحومِ الإبلِ، والشُّحومِ، وغيرِها."}],"51":[{"w":"صِرَٰطٞ","m":"طريقٌ."}],"52":[{"w":"إِلَى ٱللَّهِ","m":"مُتَوَجِّهاً إلى اللهِ."},{"w":"ٱلۡحَوَارِيُّونَ","m":"هم أصْفِياءُ عيسى عليه السلامُ."}],"53":[{"w":"ٱلشَّٰهِدِينَ","m":"الذين شَهِدُوا بالحقِّ، وأقَرُّوا بالتوحيدِ."}],"54":[{"w":"وَمَكَرُواْ","m":"أرادوا قَتْلَ عيسى عليه السلام."},{"w":"وَمَكَرَ ٱللَّهُ","m":"بحَقٍّ على ما يَلِيقُ به، وذلك من إلقائِه شَبَهَ عيسى على بعض أتبا