رُونَ","m":"ولا يُؤَخَّرُ عنهم لمعذِرَةٍ يَعْتَذِرُون بها."}],"89":[{"w":"وَأَصۡلَحُواْ","m":"ما أفسَدُوه."}],"90":[{"w":"لَن تُقۡبَلَ تَوۡبَتُهُمۡ","m":"عند حُضورِ الموتِ."}],"91":[{"w":"وَلَوِ ٱفۡتَدَىٰ بِهِۦٓ","m":"ولو دَفَعَ هذا المالَ ليَفْتَدِيَ نفسَه من العذابِ."}],"92":[{"w":"ٱلۡبِرَّ","m":"الجنةَ."}],"93":[{"w":"إِلَّا مَا حَرَّمَ إِسۡرَٰٓءِيلُ","m":"هو يعقوبُ، إذ حَرَّمَ على نفسِه -دونَ أتباعِه- لمرضٍ ألَمَّ به، ولمَّا نَزَلَتِ التوراةُ حَرَّمَ اللهُ على بني إسرائيلَ بعضَ الأطعمةِ لظُلْمِهم."},{"w":"إِن كُنتُمۡ صَٰدِقِينَ","m":"في دَعْواكم أنَّ اللهَ أنزلَ في التوراةِ تحريمَ ماحَرَّمه يعقوبُ على نفسِه."}],"95":[{"w":"صَدَقَ ٱللَّهُ","m":"فيما أخبرَ به."},{"w":"حَنِيفٗا","m":"مستقيماً لا عِوَجَ فيه."}],"96":[{"w":"بِبَكَّةَ","m":"بمكةَ."},{"w":"مُبَارَكٗا","m":"تُضاعَفُ فيه الحَسَناتُ."}],"97":[{"w":"ءَايَٰتُۢ","m":"علاماتٌ."},{"w":"مَقَامُ إِبۡرَٰهِيمَ","m":"وهو الحَجَرُ الذي كان يَقِفُ عليه حين كان يرفعُ القَواعدَ من البيت."},{"w":"سَبِيلٗا","m":"سَعَةً."},{"w":"وَمَن كَفَرَ","m":"ومَنْ جَحَدَ وُجوبَه."}],"98":[{"w":"لِمَ تَكۡفُرُونَ بِـَٔايَٰتِ ٱللَّهِ","m":"لِمَ تُنْكِرُون ما في كتبِكم من دلائلَ على أن الدينَ هو الإسلامُ؟"}],"99":[{"w":"تَصُدُّونَ","m":"تمنعون."},{"w":"عِوَجٗا","m":"مَيْلاً عن القصدِ والاستقامةِ."},{"w":"شُهَدَآءُ","m":"عالِمُون أنَّ ما جِئْتُ به هو الحقُّ."}],"100":[{"w":"يَرُدُّوكُم بَعۡدَ إِيمَٰنِكُمۡ كَٰفِرِينَ","m":"يُلْقُوا إليكم الشُّبَهَ، فتَرْجِعُوا جاحِدِين للحقِّ."}],"101":[{"w":"ءَايَٰتُ ٱللَّهِ","m":"القرآنُ الكريمُ."},{"w":"وَفِيكُمۡ رَسُولُهُۥ","m":"يُبَلِّغُها لكم، وهو حُجَّةٌ أخرى للهِ عليكم."},{"w":"يَعۡتَصِم بِٱللَّهِ","m":"يتمسَّكْ بدِينِه، وطاعتِه."},{"w":"هُدِيَ","m":"وُفِّقَ."},{"w":"صِرَٰطٖ","m":"طريقٍ."}],"102":[{"w":"مُسۡلِمُونَ","m":"مُذْعِنُون له بالطاعةِ."}],"103":[{"w":"وَٱعۡتَصِمُواْ بِحَبۡلِ ٱللَّهِ","m":"وتمسَّكُوا بِدِينِ اللهِ."},{"w":"فَأَلَّفَ","m":"فجَمَعَ."},{"w":"إِخۡوَٰنٗا","m":"مُتَحابِّين."},{"w":"شَفَا","m":"حافَةٍ وَطَرفٍ."}],"104":[{"w":"أُمَّةٞ","m":"جماعةٌ."}],"105":[{"w":"كَٱلَّذِينَ تَفَرَّقُواْ","m":"من أهلِ الكتابِ."},{"w":"ٱلۡبَيِّنَٰتُ","m":"الحُجَجُ الواضحاتُ."}],"106":[{"w":"تَبۡيَضُّ وُجُوهٞ","m":"هم أهلُ السَّعادَةِ."},{"w":"وَتَسۡوَدُّ وُجُوهٞ","m":"هم أهلُ الشَّقاءِ."},{"w":"أَكَفَرۡتُم","m":"يُقال لهم ذلك توبيخاً."}],"108":[{"w":"بِٱلۡحَقِّ","m":"بالصِّدْقِ واليقينِ."}],"109":[{"w":"تُرۡجَعُ ٱلۡأُمُورُ","m":"مَصِيرُ أَمْرِ جميعِ الخَلْقِ، فيُجازي كُلّاً بما يستحِقُّ."}],"110":[{"w":"كُنتُمۡ","m":"أنتم يا أمةَ محمدٍ ﷺ، على الشَّرْطِ المذكورِ."},{"w":"ٱلۡفَٰسِقُونَ","m":"الخارِجُون عن دينِ اللهِ."}],"111":[{"w":"إِلَّآ أَذٗى","m":"إلا ما يُؤْذِي أسماعَكم من الكَذِبِ على اللهِ والتحريفِ."},{"w":"يُوَلُّوكُمُ ٱلۡأَدۡبَارَ","m":"يُهْزَموا."}],"112":[{"w":"ٱلذِّلَّةُ","m":"الهَوانُ والصَّغارُ."},{"w":"ثُقِفُوٓاْ","m":"وُجِدُوا."},{"w":"إِلَّا بِحَبۡلٖ مِّنَ ٱللَّهِ","m":"إلا بعَهْدٍ من الله يأمَنُون به على أنفسِهم."},{"w":"وَحَبۡلٖ مِّنَ ٱلنَّاسِ","m":"بذِمَّةٍ من الناسِ."},{"w":"وَبَآءُو","m":"واستحَقُّوا غَضَبَ اللهِ."},{"w":"ٱلۡمَسۡكَنَةُ","m":"ذُلُّ الفاقةِ والفقرِ."}],"113":[{"w":"أُمَّةٞ قَآئِمَةٞ","m":"جماعةٌ ثابتةٌ على الحقِّ."},{"w":"ءَانَآءَ ٱلَّيۡلِ","m":"جَمْعُ إِنىً، وهي ساعاتُه."}],"115":[{"w":"فَلَن يُكۡفَرُوهُ","m":"فلن يُعْدَمُوا ثوابَه."}],"116":[{"w":"لَن تُغۡنِيَ","m":"لن تَدْفَعَ عنهم."},{"w":"مِنَ ٱللَّهِ","m":"من عذابِ اللهِ."}],"117":[{"w":"مَا يُنفِقُونَ","m":"في وجوهِ الخيرِ."},{"w":"صِرٌّ","m":"بَرْدٌ شديدٌ."},{"w":"أَصَابَتۡ حَرۡثَ قَوۡمٖ","m":"هَبَّتْ على زَرْعِ قومٍ كانوا يَرْجُون خيرَه. وكذلك إنفاقُ الكافرِ لا ينفَعُه."}],"118":[{"w":"بِطَانَةٗ مِّن دُونِكُمۡ","m":"أصفياءَ مِنْ دونِ المؤمنين، تُطْلِعُونَهم على أسرارِكم."},{"w":"لَا يَأۡلُونَكُمۡ خَبَالٗا","m":"لا يُقَصِّرُون في إفسادِ حالِكم."},{"w":"مَا عَنِتُّمۡ","m":"مَشَقَّتَكم."},{"w":"ٱلۡأٓيَٰتِ","m":"الحُجَجَ."}],"119":[{"w":"وَتُؤۡمِنُونَ بِٱلۡكِتَٰبِ كُلِّهِۦ","m":"وتؤمنون بالكُتُبِ المنزَّلَةِ كلها، وهم لا يُؤمنون بكتابِكم."},{"w":"مِنَ ٱلۡغَيۡظِ","m":"من شِدَّةِ الغَضَبِ."}],"120":[{"w":"كَيۡدُهُمۡ","m":"أذى مَكْرِهم."}],"121":[{"w":"غَدَوۡتَ مِنۡ أَهۡلِكَ","m":"خَرَجْتَ من بيتِك يومَ أُحُدٍ."},{"w":"تُبَوِّئُ ٱلۡمُؤۡمِنِينَ","m":"تَتَّخِذُ لهم."}],"122":[{"w":"طَآئِفَتَانِ","m":"هما بنو سَلِمَةَ وبنو حارثةَ، حَدَّثَتْهم أنفسُهم يومَ أُحُدٍ بالرُّجوعِ عن لقاءِ العدوِّ، ولكنَّ اللهَ عَصَمَهم."},{"w":"تَفۡشَلَا","m":"تَجْبُنا."},{"w":"وَلِيُّهُمَا","m":"الدافعُ عنهما الضَّعْفَ."}],"123":[{"w":"أَذِلَّةٞ","m":"قليلو العَدَدِ والعُدَّةِ."}],"124":[{"w":"مُنزَلِينَ","m":"من السماءِ يُقاتِلون معكم."}],"125":[{"w":"وَيَأۡتُوكُم","m":"ويأتي كفارُ مكةَ لقتالِكم."},{"w":"مِن فَوۡرِهِمۡ هَٰذَا","m":"مِنْ ساعَتِهم هذه."},{"w":"مُسَوِّمِينَ","m":"مُعْلِمِين أنفسَهم بعلاماتٍ واضِحاتٍ."}],"126":[{"w":"وَمَا جَعَلَهُ","m":"وما جَعَلَ هذا الإمدادَ بالملائكةِ."}],"127":[{"w":"لِيَقۡطَعَ طَرَفٗا","m":"ليُهلِكَ فريقاً من الكفَّارِ بالقَتْلِ."},{"w":"أَوۡ يَكۡبِتَهُمۡ","m":"أو يُغِيظَهم، ويُحْزِنَهم."},{"w":"فَيَنقَلِبُواْ خَآئِبِينَ","m":"فيعودُوا غيرَ ظافِرين بمَطْلَبِهم."}],"130":[{"w":"أَضۡعَٰفٗا مُّضَٰعَفَةٗ","m":"كانوا في الجاهليةِ إذا حانَ موعِدُ السَّدادِ يقولُ المقترضُ: أَخِّرْ عني، وأَزِيدُك."}],"134":[{"w":"ٱلسَّرَّآءِ","m":"في اليُسْرِ وسَعَةِ العيشِ."},{"w":"وَٱلضَّرَّآءِ","m":"الضِّيقِ والشدةِ."},{"w":"وَٱلۡكَٰظِمِينَ","m":"الذين يُمْسِكون ما في أنفسِهم من الغيظِ بالصبر."},{"w":"وَٱلۡعَافِينَ","m":"والذين يَصْفَحُون عمَّن ظَلَمَهم."}],"135":[{"w":"فَٰحِشَةً","m":"هي الفعْلَةُ القبيحةُ الخارجةُ عَمَّا أَذِنَ اللهُ."},{"w":"ظَلَمُوٓاْ أَنفُسَهُمۡ","m":"بارتكابِ مادونَ الفاحشةِ."},{"w":"ذَكَرُواْ ٱللَّهَ","m":"ذكَروا وَعيدَه على المعصية."},{"w":"وَلَمۡ يُصِرُّواْ","m":"ولم يَثْبُتوا على ما أتَوا من الذُّنوبِ."},{"w":"وَهُمۡ يَعۡلَمُونَ","m":"قُبْحَه."}],"136":[{"w":"أَجۡرُ ٱلۡعَٰمِلِينَ","m":"ثوابُ المطيعين."}],"137":[{"w":"خَلَتۡ","m":"مضَتْ."},{"w":"سُنَنٞ","m":"ما سَنَّه اللهُ في الأممِ المكذِّبة. والسُّنَّةُ: المثالُ المُتَّبَعُ."},{"w":"عَٰقِبَةُ ٱلۡمُكَذِّبِينَ","m":"قد أُمْهِلُ المكذِّبين وأسْتَدْرِجُهم إلى أجَلٍ، ثم أُحِلُّ بهم عُقوبتي، وهذا مَا حدَث مع المشركين يومَ أُحُدٍ."}],"138":[{"w":"هَٰذَا","m":"الذي أوضَحْتُه لكم بما تَقَدَّم، أو القرآنُ."}],"139":[{"w":"وَلَا تَهِنُواْ","m":"ولا تضْعُفُوا بالذي نالَكم يومَ أُحُدٍ."},{"w":"ٱلۡأَعۡلَوۡنَ","m":"الغالِبُون على عَدُوِّكم بالنصرِ."}],"140":[{"w":"قَرۡحٞ","m":"جِراحٌ وقَتْلٌ يومَ أُحُد."},{"w":"مِثۡلُهُۥ","m":"يومَ بدرٍ."},{"w":"نُدَاوِلُهَا","m":"يُصَرِّفُها اللهُ، فيظفَرُ المؤمنُ بالكافر، والكافرُ بالمؤمن."},{"w":"وَيَتَّخِذَ مِنكُمۡ شُهَدَآءَ","m":"ويُكَرِّمَ أقواماً بالشهادةِ."}],"141":[{"w":"وَلِيُمَحِّصَ","m":"ولِيَخْتبرَ."},{"w":"وَيَمۡحَقَ","m":"ويُهْلِكَهم."}],"142":[{"w":"وَلَمَّا يَعۡلَمِ","m":"أي: عِلْماً ظاهراً للخَلْقِ."}],"143":[{"w":"ٱلۡمَوۡتَ","m":"أسبابَه. وكان قومٌ من الصَّحابة مِمَّنْ لم يَشْهدوا بدراً تمنَّوا أن يجاهِدُوا."},{"w":"فَقَدۡ رَأَيۡتُمُوهُ","m":"حَصَلَ ذلك يومَ أُحُدٍ، ولكن فَرَّ بعضُهم، وصَبَر بعضُهم."}],"144":[{"w":"خَلَتۡ","m":"مَضَتْ، فسوف يَقْبِضُه اللهُ إليه عند انقضاءِ أجَلِه."},{"w":"ٱنقَلَبۡتُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ","m":"ارتَددْتُم عن دينِكم."},{"w":"فَلَن يَضُرَّ ٱللَّهَ","m":"فلن يُوهِنَ ذلك عزةَ اللهِ ولا سُلطانَه، وإنما يَضُرُّ نفسَه."},{"w":"ٱلشَّٰكِرِينَ","m":"على نِعْمَةِ الإسلامِ، الثابتين على دينِهم."}],"145":[{"w":"بِإِذۡنِ ٱللَّهِ","m":"بقَدَرِه حتى يَسْتوفيَ مُدَّتَه."},{"w":"كِتَٰبٗا","m":"كَتَبَ اللهُ ذلك كتاباً."},{"w":"مُؤَجَّلٗا","m":"مؤقتاً لا يتقدَّمُ على أجَلهِ ولا يتأخَّرُ."},{"w":"نُؤۡتِهِۦ مِنۡهَا","m":"أي: ما قُسِم له فيها من رزقٍ."}],"146":[{"w":"وَكَأَيِّن","m":"كثيرٌ."},{"w":"رِبِّيُّونَ كَثِيرٞ","m":"جموعٌ كثيرةٌ من أصحابِهم، أو علماءُ."},{"w":"وَهَنُواْ","m":"ضَعُفُوا."},{"w":"وَمَا ٱسۡتَكَانُواْ","m":"ما ذَلُّوا لعَدُوِّهم."}],"147":[{"w":"وَإِسۡرَافَنَا","m":"من الذُّنوبِ الكَبائرِ."}],"148":[{"w":"ثَوَابَ ٱلدُّنۡيَا","m":"بالنصر، والتمكينِ في الأرض."},{"w":"وَحُسۡنَ ثَوَابِ ٱلۡأٓخِرَةِ","m":"وخيرَ جزاءِ الآخرةِ."},{"w":"وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ","m":"مَنْ أحسنَ عبادتَه لربِّه."}],"149":[{"w":"يَرُدُّوكُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ","m":"يُضِلُّوكم عن طريقِ الحقِّ."}],"150":[{"w":"مَوۡلَىٰكُمۡ","m":"ناصِرُكم."}],"151":[{"w":"سَنُلۡقِي فِي قُلُوبِ ٱلَّذِينَ كَفَرُواْ ٱلرُّعۡبَ","m":"لأنَّ المشركين عَزَمُوا على استئصالِ المسلمين بعد أُحُدٍ، ولكنَّ اللهَ قَذَفَ فيهم الرُّعْبَ، فرجَعوا عَمّا هَمُّوا به."},{"w":"سُلۡطَٰنٗا","m":"دليلاً على استحقاقِها العبادةَ."},{"w":"مَثۡوَى","m":"مكانُ الإقامةِ."}],"152":[{"w":"صَدَقَكُمُ ٱللَّهُ وَعۡدَهُۥٓ","m":"حَقَّقَ ما وَعَدَكم مِنْ نَصْرٍ في أُحُدٍ قبلَ تَرْكِ الرُّماةِ مقاعِدَهم."},{"w":"تَحُسُّونَهُم","m":"تستأصِلُونهم بالقَتْلِ."},{"w":"فَشِلۡتُمۡ","m":"جَبُنتم. وجواب «إذا» مقدرٌ: امتُحِنْتُم."},{"w":"وَتَنَٰزَعۡتُمۡ","m":"اختلَفْتم: هل تَبْقَون في مَواقِعِكم، أو تتركونها للغَنائم؟"},{"w":"صَرَفَكُمۡ","m":"رَدَّكم عنهم بالهزيمةِ."},{"w":"لِيَبۡتَلِيَكُمۡ","m":"ليَخْتَبِرَكم."}],"153":[{"w":"تُصۡعِدُونَ","m":"تَسِيرون في مستوى الأرضِ وبُطونِ الأوديةِ هاربين."},{"w":"وَلَا تَلۡوُۥنَ","m":"لاتَلْتَفِتُون إلى أَحَدٍ."},{"w":"فِيٓ أُخۡرَىٰكُمۡ","m":"في الطائفةِ المتأخرةِ."},{"w":"فَأَثَٰبَكُمۡ","m":"فجازاكم."},{"w":"غَمَّۢا بِغَمّٖ","m":"الغَمُّ الأولُ ما أُشيعَ من قَتْل الرسولِ ﷺ، والثاني: ما نالهم من القَتْلِ والجِراحِ."},{"w":"عَلَىٰ مَا فَاتَكُمۡ","m":"من نَصْرٍ وغنيمةٍ. وفَعَلَ بكم ذلك تدريباً لاحتمالِ الشدائدِ."}],"154":[{"w":"أَمَنَةٗ","m":"أماناً."},{"w":"طَآئِفَةٗ مِّنكُمۡ","m":"هم أهلُ الإخلاصِ."},{"w":"أَهَمَّتۡهُمۡ أَنفُسُهُمۡ","m":"خَلاصُ أنفسِهم من القَتْلِ، وهم المنافقون."},{"w":"ظَنَّ ٱلۡجَٰهِلِيَّةِ","m":"بأنَّ الإسلامَ لن تقومَ له قائمةٌ."},{"w":"هَل لَّنَا مِنَ ٱلۡأَمۡرِ مِن شَيۡءٖ","m":"هل كان لنا من اختيارٍ في الخروجِ للقتالِ؟"},{"w":"يُخۡفُونَ","m":"من الحَسْرةِ على خروجِهم للقتالِ."},{"w":"إِلَىٰ مَضَاجِعِهِمۡ","m":"إلى المواضع التي كُتِبَ عليهم أَنْ يُقْتَلُوا فيها."},{"w":"مَا فِي صُدُورِكُمۡ","m":"من الشَّكِّ، والنفاق."},{"w":"وَلِيُمَحِّصَ","m":"ليمِيزَ الخبيثَ من الطَّيِّبِ."}],"155":[{"w":"تَوَلَّوۡاْ","m":"فَرُّوا."},{"w":"ٱلۡتَقَى ٱلۡجَمۡعَانِ","m":"أي: يومَ أُحُدٍ، والجَمْعان: المؤمنون، والمشركون."},{"w":"ٱسۡتَزَلَّهُمُ","m":"أَوْقَعَهم."},{"w":"مَا كَسَبُواْ","m":"من الذُّنوبِ."}],"156":[{"w":"كَٱلَّذِينَ كَفَرُواْ","m":"من المنافقين."},{"w":"ضَرَبُواْ فِي ٱلۡأَرۡضِ","m":"سَفَراً للبحث عن معاشِهم فماتوا."},{"w":"غُزّٗى","m":"غازين."},{"w":"ذَٰلِكَ","m":"هذا القولُ."}],"157":[{"w":"مِمَّا يَجۡمَعُونَ","m":"ممَّا يجْمَعُه أهلُ الدنيا."}],"159":[{"w":"فَبِمَا رَحۡمَةٖ","m":"فبرحمةٍ."},{"w":"فَظًّا","m":"سَيِّئَ الخُلُقِ جافياً."},{"w":"لَٱنفَضُّواْ","m":"لَتَفرَّقُوا عنك."},{"w":"وَشَاوِرۡهُمۡ","m":"لتقتديَ بك الأمةُ، وذلك في غير ما وَرَدَ به الشَّرعُ."},{"w":"فَإِذَا عَزَمۡتَ","m":"عَقِبَ المُشاورةِ، وقَصَدْتَ إمضاءَ الأمرِ."}],"161":[{"w":"أَن يَغُلَّ","m":"أن يَخُونَ أصحابَه بأن يأخذَ من الغنيمةِ غيرَ ما اخْتَصَّه اللهُ."},{"w":"بِمَا غَلَّ","m":"بما أخَذَه حاملاً له ليُفضحَ به."}],"162":[{"w":"كَمَنۢ بَآءَ بِسَخَطٖ","m":"كمَنْ رَجَعَ بغضبٍ شديدٍ."}],"163":[{"w":"هُمۡ دَرَجَٰتٌ","m":"ذوو دَرَجاتٍ، فدَرجاتُ مَنِ اتَّبعَ رضوانَه ليسَتْ كدرجاتِ الآخَرين."}],"164":[{"w":"مَنَّ","m":"أنعمَ."},{"w":"مِنۡ أَنفُسِهِمۡ","m":"من أهلِ لسانِهم."},{"w":"وَيُزَكِّيهِمۡ","m":"ويُطَهِّرُهم."},{"w":"وَٱلۡحِكۡمَةَ","m":"والسُّنَّةَ."},{"w":"وَإِن كَانُواْ","m":"وإنَّهم كانوا."}],"165":[{"w":"مُصِيبَةٞ","m":"يومَ أُحدٍ."},{"w":"أَصَبۡتُم مِّثۡلَيۡهَا","m":"يومَ بدرٍ من المشركين."},{"w":"أَنَّىٰ هَٰذَا","m":"كيف يكونُ هذا، ونحن مسلمون فينا نبيُّ اللهِ؟"},{"w":"مِنۡ عِندِ أَنفُسِكُمۡ","m":"عقوبةٌ لكم بسببِ مخالفتِكم أمْرَ رسولِكم."}],"166":[{"w":"يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِ","m":"يومَ أُحُدٍ."},{"w":"فَبِإِذۡنِ ٱللَّهِ","m":"بعِلْمِه."}],"167":[{"w":"ٱدۡفَعُواْ","m":"كونوا عَوْناً لنا بتكثيرِكم سَوادَنا."}],"168":[{"w":"لَوۡ أَطَاعُونَا","m":"بتَرْكِ الخروجِ من المدينةِ."},{"w":"فَٱدۡرَءُواْ","m":"فادفَعُوا."}],"169":[{"w":"أَحۡيَآءٌ","m":"حياةً بَرْزَخيةً."},{"w":"عِندَ رَبِّهِمۡ","m":"في الجنةِ."}],"170":[{"w":"وَيَسۡتَبۡشِرُونَ","m":"ويَفْرحون."},{"w":"أَلَّا خَوۡفٌ عَلَيۡهِمۡ","m":"فيما يَسْتقبلون من أمورِ الآخرةِ."},{"w":"وَلَا هُمۡ يَحۡزَنُونَ","m":"على مافاتَهم في الدنيا."}],"172":[{"w":"ٱلَّذِينَ ٱسۡتَجَابُواْ","m":"هم الذين خرجُوا يَتَعَقَّبون المشركين في «حمراءِ الأسَدِ»، بعد هزيمتِهم في أُحُدٍ."},{"w":"ٱلۡقَرۡحُ","m":"الجراحُ من معركةِ أُحُدٍ."}],"173":[{"w":"قَالَ لَهُمُ ٱلنَّاسُ","m":"هم بعضُ المشركين، قالوا: إن أبا سفيان ومَنْ معه سيعودون إليكم."},{"w":"حَسۡبُنَا ٱللَّهُ","m":"اللهُ كافِينا."}],"174":[{"w":"فَٱنقَلَبُواْ","m":"فرَجَعُوا من حمراءِ الأسَدِ."}],"175":[{"w":"يُخَوِّفُ أَوۡلِيَآءَهُۥ","m":"يُخَوِّفُكم بأوليائِه."}],"176":[{"w":"حَظّٗا","m":"نصيباً."}],"177":[{"w":"ٱشۡتَرَوُاْ","m":"استبدلُوا."}],"178":[{"w":"وَلَا يَحۡسَبَنَّ ٱلَّذِينَ كَفَرُوٓاْ","m":"إذا أطَلْنا أعمارَهم، ومَتَّعْناهم."},{"w":"إِنَّمَا نُمۡلِي لَهُمۡ","m":"نُؤَخِّرُ أجَلَهم وعذابَهم."},{"w":"إِثۡمٗا","m":"ظلماً وطُغياناً."}],"179":[{"w":"لِيَذَرَ","m":"لِيَدَعَ."},{"w":"عَلَىٰ مَآ أَنتُمۡ عَلَيۡهِ","m":"من التباسِ المؤمن مِنكم بالمنافقِ."},{"w":"عَلَى ٱلۡغَيۡبِ","m":"الذي يَعْلَمُه من عبادِه، فتَعْرِفُوا المؤمنَ منهم من المنافقِ، ولكنه يَمِيزُهم بالمِحَنِ."},{"w":"يَجۡتَبِي","m":"يَصْطَفي مِنْ رُسُله ليُطْلِعَه على شيءٍ من غيبهِ."}],"180":[{"w":"سَيُطَوَّقُونَ","m":"سيكونُ طَوْقاً من نارٍ يُوضَعُ في أعناقِهم."}],"181":[{"w":"ٱلَّذِينَ قَالُوٓاْ","m":"هم اليهودُ."},{"w":"إِنَّ ٱللَّهَ فَقِيرٞ","m":"يَطْلبُ منا أن نُقْرِضَه مالاً، وهذا للتشكيكِ على المسلمين."}],"182":[{"w":"بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ","m":"من المعاصي."}],"183":[{"w":"عَهِدَ إِلَيۡنَآ","m":"في التوراةِ."},{"w":"بِقُرۡبَانٖ","m":"بصَدَقَةٍ يُتَقَرَّبُ بها إلى الله، فتنزلُ نارٌ من السماءِ فتحرقُها."}],"184":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالمعجزاتِ الواضحاتِ."},{"w":"وَٱلزُّبُرِ","m":"الكتبِ التي أنزلها اللهُ."}],"185":[{"w":"مَتَٰعُ ٱلۡغُرُورِ","m":"مُتْعَةٌ زائلةٌ، فلا تَغْترُّوا بها."}],"186":[{"w":"لَتُبۡلَوُنَّ","m":"لَتُخْتَبَرُنَّ."},{"w":"فِيٓ أَمۡوَٰلِكُمۡ","m":"بإخراجِ النفقاتِ الواجبةِ والمُسْتَحَبَّةِ، وبالجوائح التي تُصيبها."},{"w":"وَأَنفُسِكُمۡ","m":"بما يجبُ عليكم من الطاعاتِ، وما يَحُلُّ بكم من الجِراح، وفَقْدِ الأحبابِ."},{"w":"مِنۡ عَزۡمِ ٱلۡأُمُورِ","m":"من الأمورِ التي يُتنافَسُ فيها."}],"187":[{"w":"مِيثَٰقَ","m":"العهدَ المُوَثَّقَ."},{"w":"فَنَبَذُوهُ","m":"تركُوا العملَ به."},{"w":"وَٱشۡتَرَوۡاْ بِهِۦ ثَمَنٗا قَلِيلٗا","m":"أخذُوا ثمناً بَخْساً مقابلَ كِتْمانِهم الحقَّ، وتحريفِهم كتبَهم."}],"188":[{"w":"ٱلَّذِينَ يَفۡرَحُونَ","m":"أهلَ الكتابِ ومَنْ كان مثلَهم من الذين أَخَذَ ميثاقَهم."},{"w":"بِمَآ أَتَواْ","m":"بكِتْمانهم أنَّ النبيَّ ﷺ مُرْسَلٌ بالحقِّ."},{"w":"بِمَفَازَةٖ","m":"بمَنْجاةٍ."}],"190":[{"w":"وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","m":"في تَعاقُبِهِما واختلافِهما طُولاً وقِصَراً."},{"w":"لَأٓيَٰتٖ","m":"لَدلائلَ."},{"w":"ٱلۡأَلۡبَٰبِ","m":"العقولِ السليمةِ."}],"191":[{"w":"وَيَتَفَكَّرُونَ","m":"ويتدبَّرون."},{"w":"بَٰطِلٗا","m":"عَبَثاً."},{"w":"سُبۡحَٰنَكَ","m":"نُنَزِّهُك."}],"192":[{"w":"أَخۡزَيۡتَهُۥ","m":"أهَنْتَه، وهو الخالدُ فيها."}],"193":[{"w":"مُنَادِيٗا","m":"هو محمدٌ ﷺ."},{"w":"ٱلۡأَبۡرَارِ","m":"الصالحين."}],"194":[{"w":"وَلَاتُخۡزِنَا","m":"ولاتَفْضَحْنا بذنوبِنا."}],"195":[{"w":"بَعۡضُكُم مِّنۢ بَعۡضٖ","m":"هم سَواءٌ في الجزاءِ على العملِ."}],"196":[{"w":"لَا يَغُرَّنَّكَ تَقَلُّبُ ٱلَّذِينَ كَفَرُواْ","m":"لَا تَغْتَرَّ بما عليه أهلُ الكفرِ من تَصَرُّفِهم في الأرضِ وضَرْبِهم فيها."}],"197":[{"w":"مَأۡوَىٰهُمۡ","m":"مصيرُهم."},{"w":"ٱلۡمِهَادُ","m":"الفِراشُ والمَضْجَعُ."}],"198":[{"w":"نُزُلٗا","m":"هو ما يُهَيَّأ للنَّزيلِ ضِيافةً."}],"199":[{"w":"ثَمَنٗا قَلِيلًا","m":"من حُطامِ الدُّنيا، فلايكتُمون ما أنزلَ اللهُ ولايُحَرِّفُونه."}],"200":[{"w":"وَصَابِرُواْ","m":"أي غالِبُوا أعداءَكم في الصَّبْرِ."},{"w":"وَرَابِطُواْ","m":"وأقِيمُوا على جهادِ العَدُوِّ."}]}