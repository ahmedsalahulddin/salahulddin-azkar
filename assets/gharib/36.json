{"1":[{"w":"يسٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"4":[{"w":"صِرَٰطٖ مُّسۡتَقِيمٖ","m":"طَرِيقٍ مُعْتَدِلٍ؛ وهو الإسْلامُ."}],"7":[{"w":"حَقَّ ٱلۡقَوۡلُ","m":"وَجَبَ القولُ أي: العذابُ."}],"8":[{"w":"أَغۡلَٰلٗا","m":"قُيُوداً تَشُدُّ أيدِيَهُم إلى أعناقِهِم تَحتَ أذقانِهم."},{"w":"مُقۡمَحُونَ","m":"رافِعُونَ رؤوسَهم غاضُّونَ أبْصارَهُم."}],"9":[{"w":"سَدّٗا","m":"حاجِزاً ومانِعاً."},{"w":"فَأَغۡشَيۡنَٰهُمۡ","m":"غَطَّينا أبْصارَهُم."}],"11":[{"w":"أَجۡرٖ كَرِيمٍ","m":"أجْرٍ حَسَنٍ، وهو دخولُ الجنّةِ."}],"12":[{"w":"نُحۡيِ ٱلۡمَوۡتَىٰ","m":"نَبْعَثُهُم بَعْدَ الموتِ."},{"w":"وَءَاثَٰرَهُمۡ","m":"أي: ما أَبْقَوهُ مِنَ الحسَناتِ الَّتي لايَنْقَطِعُ نَفْعُها بَعْدَ الموتِ."},{"w":"إِمَامٖ مُّبِينٖ","m":"كِتابٍ واضِحٍ؛ وهو اللَّوحُ المحفُوظُ."}],"13":[{"w":"أَصۡحَٰبَ ٱلۡقَرۡيَةِ","m":"أَهْلَ القَرْيَةِ، وهي «أنْطاكِيَةُ»."}],"14":[{"w":"فَعَزَّزۡنَا بِثَالِثٖ","m":"أي: قوَّيناهُما بِرَسُولٍ ثالِثٍ."}],"18":[{"w":"تَطَيَّرۡنَا بِكُمۡ","m":"تَشَاءَمْنا بِكُم."},{"w":"لَنَرۡجُمَنَّكُمۡ","m":"لَنَقْتُلَنَّكُم رَمْياً بالِحجارَةِ."}],"19":[{"w":"طَٰٓئِرُكُم مَّعَكُمۡ","m":"شُؤْمُكُم مَعَكُم، الذي هو كُفْرُكُم وشِرْكُكُم."}],"20":[{"w":"أَقۡصَا ٱلۡمَدِينَةِ","m":"مِن مَكانٍ بَعِيدٍ فِيها."}],"22":[{"w":"فَطَرَنِي","m":"خَلَقَنِي."}],"23":[{"w":"وَلَا يُنقِذُونِ","m":"لا يُنَجُّونَنِي مِمَّا أَنا فِيه."}],"24":[{"w":"ضَلَٰلٖ مُّبِينٍ","m":"خَطَأٍ ظاهِرٍ."}],"28":[{"w":"جُندٖ","m":"جَيشٍ."}],"29":[{"w":"صَيۡحَةٗ","m":"صَوْتاً مُهلِكاً مِنَ السَّماءِ."},{"w":"خَٰمِدُونَ","m":"مَيِّتُونَ لا حَرَاكَ فِيهِم."}],"30":[{"w":"يَسۡتَهۡزِءُونَ","m":"يَسْخَرُونَ."}],"31":[{"w":"مِنَ ٱلۡقُرُونِ","m":"مِنَ الأُمَمِ الخالِيةِ."}],"32":[{"w":"مُحۡضَرُونَ","m":"نُحْضِرُهُم للحسابِ والجزاءِ."}],"33":[{"w":"وَءَايَةٞ لَّهُمُ","m":"دَلَالةٌ لَهُم."},{"w":"ٱلۡأَرۡضُ ٱلۡمَيۡتَةُ","m":"هي الَّتي لا نَبَاتَ فِيها."},{"w":"أَحۡيَيۡنَٰهَا","m":"أي: بإنْزالِ المطرِ عَلَيها وإخراجِ النَّباتِ منها."}],"34":[{"w":"جَنَّٰتٖ","m":"بَسَاتِينَ."},{"w":"فَجَّرۡنَا","m":"شَقَقْنا."}],"36":[{"w":"ٱلۡأَزۡوَٰجَ","m":"الأَصْنافَ والأَنْواعَ."}],"37":[{"w":"ءَايَةٞ لَّهُمُ","m":"علامةٌ لَهُم."},{"w":"نَسۡلَخُ مِنۡهُ","m":"نَنْزِعُ مِنْهُ."}],"38":[{"w":"لِمُسۡتَقَرّٖ لَّهَا","m":"مُسْتَقَرُّهَا تَحْتَ العَرْشِ، كما جاء في الحديثِ المتَّفقِ عَلَيه."}],"39":[{"w":"مَنَازِلَ","m":"مسافات، وهي ثمانيةٌ وعِشْرُونَ مَنْزِلاً."},{"w":"كَٱلۡعُرۡجُونِ ٱلۡقَدِيمِ","m":"كالعِذْقِ اليابسِ المُتَضائلِ المتَقَوِّسِ."}],"40":[{"w":"أَن تُدۡرِكَ","m":"أن تَلْحَقَ."},{"w":"فَلَكٖ","m":"مَدَارٍ."},{"w":"يَسۡبَحُونَ","m":"يَدُورُونَ في فَلَكِ السَّماءِ بانْبِساطٍ وسُهُولَةٍ."}],"41":[{"w":"ءَايَةٞ لَّهُمۡ","m":"دليلٌ لَهُم."},{"w":"ٱلۡمَشۡحُونِ","m":"الممْلُوءِ."}],"43":[{"w":"صَرِيخَ لَهُمۡ","m":"مُغِيثَ لَهُم."},{"w":"يُنقَذُونَ","m":"يُخَلَّصُونَ مِنَ الغَرَقِ."}],"45":[{"w":"مَا بَيۡنَ أَيۡدِيكُمۡ","m":"مِنَ الآخرةِ وأهْوَالِهَا."},{"w":"وَمَا خَلۡفَكُمۡ","m":"مِنْ أحْوالِ الدُّنيا وعِقابِها."}],"49":[{"w":"يَنظُرُونَ","m":"ينتظِرُونَ."},{"w":"صَيۡحَةٗ وَٰحِدَةٗ","m":"هي نَفْخَةُ الفَزَعِ عِنْدَ قِيامِ السَّاعةِ."},{"w":"يَخِصِّمُونَ","m":"يَخْتَصِمُونَ في شُؤونِ حياتِهم غافِلينَ عَن يَوْمِ القيامةِ."}],"50":[{"w":"تَوۡصِيَةٗ","m":"وَصِيَّةً."}],"51":[{"w":"ٱلصُّورِ","m":"«القَرْنِ» الذي يُنفَخُ فيه للبعث."},{"w":"ٱلۡأَجۡدَاثِ","m":"القُبُورِ."},{"w":"يَنسِلُونَ","m":"يُسْرِعُونَ في الخُرُوجِ."}],"52":[{"w":"يَٰوَيۡلَنَا","m":"يا هَلَاكَنا."},{"w":"مَنۢ بَعَثَنَا","m":"مَنْ أَحْيانا؟"},{"w":"مِن مَّرۡقَدِنَا","m":"مِنْ قُبُورِنا."}],"53":[{"w":"صَيۡحَةٗ وَٰحِدَةٗ","m":"نَفْخَةً واحِدَةً."},{"w":"مُحۡضَرُونَ","m":"نُحْضِرُهم للحِسابِ والجَزَاءِ."}],"55":[{"w":"فِي شُغُلٖ","m":"في نَعِيمٍ عَظِيمٍ يُلْهِيهِم عمَّا سِواه."},{"w":"فَٰكِهُونَ","m":"مُتَلَذِّذُونَ."}],"56":[{"w":"ٱلۡأَرَآئِكِ","m":"الأَسِرَّةِ المزَيَّنةِ."}],"57":[{"w":"مَا يَدَّعُونَ","m":"ما يَشْتَهُونَ."}],"59":[{"w":"وَٱمۡتَٰزُواْ","m":"تميَّزُوا، وانفرِدُوا عَنِ المؤمِنِينَ."}],"60":[{"w":"أَعۡهَدۡ إِلَيۡكُمۡ","m":"أُوصِكُم وأُبَلِّغْكُم."}],"62":[{"w":"جِبِلّٗا","m":"خَلْقاً."}],"64":[{"w":"ٱصۡلَوۡهَا","m":"ادخُلُوا جَهَنَّمَ وقاسُوا حَرَّها."}],"65":[{"w":"نَخۡتِمُ","m":"نَطْبَعُ."}],"66":[{"w":"لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ","m":"لصَيرَّناها مَمْسُوحَةً لا يُرى لها شَقٌّ ولا جَفْنٌ."},{"w":"فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ","m":"بادَرُوا إليه."},{"w":"فَأَنَّىٰ يُبۡصِرُونَ","m":"فكيفَ يُبْصِرُونَ وقد طُمِسَتْ أَبْصارُهُم؟"}],"67":[{"w":"لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ","m":"لَغَيَّرْنا خَلْقَهم في المكانِ الَّذي هم فيهِ."},{"w":"مُضِيّٗا","m":"أي: ذَهاباً إلى الأمامِ."}],"68":[{"w":"نُعَمِّرۡهُ","m":"نُطِلْ عُمُرَه."},{"w":"نُنَكِّسۡهُ فِي ٱلۡخَلۡقِ","m":"نَرُدَّه إلى أرْذَلِ العُمُرِ وأَضْعَفِه."}],"70":[{"w":"وَيَحِقَّ ٱلۡقَوۡلُ","m":"أي: تَجِبَ كلمةُ العذابِ."}],"71":[{"w":"مِمَّا عَمِلَتۡ أَيۡدِينَآ","m":"أي: مما أبْدَعْناهُ وَعَمِلْناهُ."},{"w":"لَهَا مَٰلِكُونَ","m":"مَالِكُونَ أَمْرَها، يَتَصَرَّفُونَ بِها كيفَ شَاؤُوا."}],"72":[{"w":"وَذَلَّلۡنَٰهَا لَهُمۡ","m":"سَخَّرْناها لَهُم."},{"w":"رَكُوبُهُمۡ","m":"مَرْكُوبُهم الّذي يَرْكَبُونَه."}],"75":[{"w":"وَهُمۡ لَهُمۡ جُندٞ مُّحۡضَرُونَ","m":"والحالُ أَنَّ هذه الآلهةَ قَدْ أُحْضِرَتْ مُجْتَمِعَةً لِتُعايِنَ عذابَ عابِدِيها، وهي لا تَسْتَطِيعُ نَصْرَهُم."}],"77":[{"w":"مِن نُّطۡفَةٖ","m":"هي مَنِيُّ الرَّجُلِ يقْذِفُه في رَحمِ امْرَأتِه."},{"w":"خَصِيمٞ","m":"كثيرُ الخُصُومَةِ بالباطلِ."}],"78":[{"w":"رَمِيمٞ","m":"باليةٌ مُتفَتِّتةٌ."}],"79":[{"w":"أَنشَأَهَآ","m":"خَلَقَها."}],"80":[{"w":"مِنۡهُ تُوقِدُونَ","m":"تَقْدَحُونَ منه."}],"83":[{"w":"مَلَكُوتُ","m":"هو المُلْكُ التَّامُّ للأشياءِ كلِّها."}]}