{"1":[{"w":"أُحۡكِمَتۡ ءَايَٰتُهُۥ","m":"جُعِلَتْ مُحْكَمَةً مُتقنةً، لا نَقْصَ فيها ولا عَيْبَ."},{"w":"فُصِّلَتۡ","m":"بُيِّنَتْ فيها الأحكامُ والقِصصُ والمواعظُ."}],"3":[{"w":"مَتَٰعًا حَسَنًا","m":"بطِيبِ الحياةِ وسَعَةِ الرِّزقِ."},{"w":"إِلَىٰٓ أَجَلٖ مُّسَمّٗى","m":"إلى وقتِ انقضاءِ آجالِكم."},{"w":"فَضۡلَهُۥ","m":"جزاءَ فَضْلِه في الدُّنيا والآخرةِ."},{"w":"تَوَلَّوۡاْ","m":"تُعْرِضُوا."}],"5":[{"w":"يَثۡنُونَ صُدُورَهُمۡ","m":"يَطْوُونها على الكفرِ والعَداوةِ."},{"w":"يَسۡتَغۡشُونَ ثِيَابَهُمۡ","m":"يَتَغَطَّوْن بها."}],"6":[{"w":"دَآبَّةٖ","m":"كلُّ حَيَوانٍ يَمْشي على هيئتهِ على الأرضِ."},{"w":"مُسۡتَقَرَّهَا","m":"مكانَ استقرارِها في حياتِها وبعدَ مَماتِها."},{"w":"وَمُسۡتَوۡدَعَهَا","m":"موضعَ استيداعِها بعد موتِها."},{"w":"كِتَٰبٖ مُّبِينٖ","m":"واضحٍ، وهو اللَّوحُ المحفوظُ."}],"7":[{"w":"عَرۡشُهُۥ","m":"العرشُ: سريرُ المُلْكِ الذي استوى عليه الرحمنُ، وتحمِلُه الملائكةُ، وهو أعظمُ المخلوقاتِ، وهو سَقْفُ الجنَّةِ."},{"w":"لِيَبۡلُوَكُمۡ","m":"لِيَخْتَبِرَكم."},{"w":"أَحۡسَنُ عَمَلٗا","m":"أعْمَلُ بطاعةِ اللهِ وأَوْرَعُ عن مَحارمِه."}],"8":[{"w":"أُمَّةٖ مَّعۡدُودَةٖ","m":"وقتٍ معلومٍ."},{"w":"وَحَاقَ","m":"أحاطَ."}],"9":[{"w":"مِنَّا رَحۡمَةٗ","m":"نِعْمةً مِنْ نِعَمِنا الكثيرةِ."},{"w":"نَزَعۡنَٰهَا مِنۡهُ","m":"سَلَبْناها منه."},{"w":"لَيَـُٔوسٞ","m":"شديدُ اليأسِ من رحمةِ اللهِ."},{"w":"كَفُورٞ","m":"كثيرُ الجُحودِ للنِّعَمِ."}],"10":[{"w":"ضَرَّآءَ مَسَّتۡهُ","m":"بَلْوى أصابَتْه."},{"w":"ٱلسَّيِّـَٔاتُ","m":"المصائبُ والشَّدائدُ."},{"w":"لَفَرِحٞ","m":"بَطِرٌ بالنِّعْمةِ مُغْتَرٌّ بها."},{"w":"فَخُورٌ","m":"كثيرُ التعاظُمِ على الناسِ."}],"12":[{"w":"بَعۡضَ مَا يُوحَىٰٓ إِلَيۡكَ","m":"ما يَشُقُّ على المشركين سماعُه، ويُثيرُ غضَبَهم."},{"w":"أَن يَقُولُواْ","m":"خشيةَ أن يقولوا على وجهِ التكذيبِ والاستهزاءِ."},{"w":"لَوۡلَآ","m":"هَلَّا."},{"w":"وَكِيلٌ","m":"حفيظٌ يُدَبِّرُ جميعَ شؤونِ خَلْقهِ."}],"13":[{"w":"ٱفۡتَرَىٰهُ","m":"أتى به مِنْ عندِ نفسِه."},{"w":"مُفۡتَرَيَٰتٖ","m":"مُخْتَلَقاتٍ من عندِ أنفسِكم."},{"w":"وَٱدۡعُواْ مَنِ ٱسۡتَطَعۡتُم","m":"واستعينُوا بمَنْ أمكنكم الاستعانةُ به."}],"15":[{"w":"نُوَفِّ إِلَيۡهِمۡ أَعۡمَٰلَهُمۡ","m":"نُعْطِهم جزاءَ أعمالِهم في الدنيا."},{"w":"لَا يُبۡخَسُونَ","m":"لا يُنْقَصُون شيئاً ممَّا قُسِمَ لهم."}],"16":[{"w":"وَحَبِطَ","m":"بَطَلَ في الآخرةِ نَفْعُ ما عَمِلوه."}],"17":[{"w":"بَيِّنَةٖ مِّن رَّبِّهِۦ","m":"حُجَّةٍ وبَصيرةٍ من اللهِ."},{"w":"وَيَتۡلُوهُ","m":"يَتْبَعُه ويُقَوِّيه."},{"w":"شَاهِدٞ مِّنۡهُ","m":"يَشْهَدُ على كَوْنِ القرآنِ من عندِ اللهِ."},{"w":"كِتَٰبُ مُوسَىٰٓ","m":"التوراةُ."},{"w":"إِمَامٗا","m":"يُؤتَمُّ به في الدِّين، ويُقْتدَى به."},{"w":"وَرَحۡمَةً","m":"نِعْمَةً عظيمةً من اللهِ."},{"w":"ٱلۡأَحۡزَابِ","m":"الكفارِ الذين جَمَعهم تكذيبُ رسولِ اللهِ عليه الصلاة والسلام، وكَيْدُهم له."},{"w":"مِرۡيَةٖ مِّنۡهُ","m":"شَكٍّ من تنزيلِ القرآنِ من اللهِ."}],"18":[{"w":"يُعۡرَضُونَ عَلَىٰ رَبِّهِمۡ","m":"سيُعْرَضون على اللهِ في موقفِ الحسابِ."},{"w":"ٱلۡأَشۡهَٰدُ","m":"جَمْعُ شاهِدٍ، وهم: الملائكةُ والأنبياءُ والمؤمنون."},{"w":"لَعۡنَةُ ٱللَّهِ","m":"الإبعَادُ عن رحمته."}],"19":[{"w":"يَصُدُّونَ","m":"يَمْنَعُون الناسَ."},{"w":"سَبِيلِ ٱللَّهِ","m":"الطريقِ المُوصِلَةِ إليه، وهي دينُ الإسلامِ."},{"w":"وَيَبۡغُونَهَا عِوَجٗا","m":"ويُريدون أن تكونَ سبيلُ اللهِ مائلةً وَفْقَ أهوائِهم."}],"20":[{"w":"مُعۡجِزِينَ","m":"فائتين من عذابِ اللهِ بالهَرَبِ."},{"w":"أَوۡلِيَآءَ","m":"أنصارٍ."}],"21":[{"w":"وَضَلَّ","m":"ذَهَبَ."},{"w":"يَفۡتَرُونَ","m":"يَكْذِبُون على اللهِ من ادِّعاءِ الشفعاءِ، الذين يَتَوَهَّمُون شفاعتَهم."}],"22":[{"w":"لَا جَرَمَ","m":"حقّاً، أو لا مَحالةَ."}],"23":[{"w":"وَأَخۡبَتُوٓاْ إِلَىٰ رَبِّهِمۡ","m":"أنابُوا إليه وخَضَعُوا له."}],"24":[{"w":"ٱلۡفَرِيقَيۡنِ","m":"فريقَي الكُفْرِ والإيمانِ."}],"25":[{"w":"نَذِيرٞ مُّبِينٌ","m":"بَيِّنُ الإنذارِ بما أُرْسِلْتُ به."}],"27":[{"w":"ٱلۡمَلَأُ","m":"الأشرافُ والسَّادةُ."},{"w":"أَرَاذِلُنَا","m":"سَفَلَةُ الناسِ منا وفُقَراؤُنا."},{"w":"بَادِيَ ٱلرَّأۡيِ","m":"أي: اتّبعُوك من غيرِ تفكيرٍ ولا رَوِيَّةٍ."}],"28":[{"w":"أَرَءَيۡتُمۡ","m":"أخْبِرُوني."},{"w":"بَيِّنَةٖ","m":"حُجَّةٍ وبرهانٍ، تَشْهَدُ بالنبوَّةِ."},{"w":"وَءَاتَىٰنِي رَحۡمَةٗ مِّنۡ عِندِهِۦ","m":"وهي الرِّسالةُ."},{"w":"فَعُمِّيَتۡ","m":"أُخْفِيَتْ."}],"31":[{"w":"خَزَآئِنُ ٱللَّهِ","m":"خزائنُ رزقِه، وما لا يَصِلُ إليه عِلْمُ الناسِ."},{"w":"تَزۡدَرِيٓ أَعۡيُنُكُمۡ","m":"تَسْتَحْقِرُهم وتَسْتهينُ بهم."},{"w":"خَيۡرًا","m":"توفيقاً وإيماناً وأجراً."}],"33":[{"w":"بِمُعۡجِزِينَ","m":"بفائتين من عذابِ اللهِ بالهَرَبِ."}],"34":[{"w":"يُغۡوِيَكُمۡ","m":"يُضِلَّكم."}],"35":[{"w":"فَعَلَيَّ إِجۡرَامِي","m":"فعَلَيَّ إثمي وعُقوبتُه."},{"w":"مِمَّا تُجۡرِمُونَ","m":"ممَّا تَقْترفونه من الكفرِ والتكذيب."}],"36":[{"w":"فَلَا تَبۡتَئِسۡ","m":"لا تَحْزَنْ."}],"37":[{"w":"ٱلۡفُلۡكَ","m":"السَّفينةَ."},{"w":"بِأَعۡيُنِنَا","m":"بمَرْأى مِنَّا وأنت في حِفْظِنا."},{"w":"وَوَحۡيِنَا","m":"وبأَمْرِنا لك ومَعُونَتِنا."},{"w":"وَلَا تُخَٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ","m":"لا تَطْلُبْ مني إمهالَهم."}],"39":[{"w":"يُخۡزِيهِ","m":"يُهينُه ويُذِلُّه."},{"w":"وَيَحِلُّ عَلَيۡهِ","m":"ويَنْزِلُ به."},{"w":"عَذَابٞ مُّقِيمٌ","m":"دائمٌ لاينقطِعُ، وهو النارُ."}],"40":[{"w":"وَفَارَ ٱلتَّنُّورُ","m":"ونَبَعَ الماءُ بقوَّةٍ من المكانِ الذي يُخْبَزُ فيه."},{"w":"مِن كُلّٖ زَوۡجَيۡنِ ٱثۡنَيۡنِ","m":"من كلِّ نوعٍ من أنواعِ الحيَوَاناتِ ذكراً وأنثى."},{"w":"إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ","m":"إلَّا مَنْ تَقَدَّمَ حُكْمُ اللهِ عليه بأنه من المُغْرَقين."}],"41":[{"w":"مَجۡرٜىٰهَا","m":"جَرْيُها على وجهِ الماء."},{"w":"وَمُرۡسَىٰهَآ","m":"ومُنْتَهىٰ سَيْرِها."}],"42":[{"w":"مَعۡزِلٖ","m":"مكانٍ عَزَلَ نفسَه فيه عن المؤمنين."}],"43":[{"w":"سَـَٔاوِيٓ","m":"سألتجِئُ وأتحَصَّنُ."},{"w":"لَا عَاصِمَ","m":"لامانعَ ولاحافِظَ."}],"44":[{"w":"أَقۡلِعِي","m":"أَمْسِكِي عن إنزالِ المطرِ."},{"w":"وَغِيضَ ٱلۡمَآءُ","m":"نَقَصَ وغارَ في الأرضِ."},{"w":"وَقُضِيَ ٱلۡأَمۡرُ","m":"تَمَّ حُكْمُ اللهِ بإهلاكِ قومِ نوحٍ."},{"w":"وَٱسۡتَوَتۡ عَلَى ٱلۡجُودِيِّ","m":"استقرَّتِ السفينةُ على جَبَلِ الجوديِّ."},{"w":"بُعۡدٗا","m":"هَلاكاً."}],"47":[{"w":"أَعُوذُ بِكَ","m":"أعتصِمُ وأستجيرُ بك."}],"48":[{"w":"بِسَلَٰمٖ مِّنَّا","m":"بأمانٍ وسَلامةٍ منَّا."},{"w":"وَبَرَكَٰتٍ عَلَيۡكَ","m":"خيراتٍ ونِعَمٍ دائمةٍ عليك."},{"w":"وَأُمَمٞ سَنُمَتِّعُهُمۡ","m":"وهم الكفارُ."}],"50":[{"w":"عَادٍ","m":"قومِ هودٍ عليه السلام، وهم قبيلةٌ من العَرَبِ."},{"w":"مُفۡتَرُونَ","m":"كاذِبُون في إشراكِكم باللهِ."}],"51":[{"w":"فَطَرَنِيٓ","m":"خَلَقَني."}],"52":[{"w":"ٱلسَّمَآءَ","m":"المطرَ."},{"w":"مِدۡرَارٗا","m":"كثيراً مُتتابعاً من غيرِ إضْرارٍ."},{"w":"وَلَا تَتَوَلَّوۡاْ","m":"لا تُعْرِضُوا عَمَّا دَعَوْتُكم إليه."}],"53":[{"w":"بِبَيِّنَةٖ","m":"بحُجَّةٍ واضحةٍ."},{"w":"عَن قَوۡلِكَ","m":"من أجلِ قولِك."}],"54":[{"w":"إِن نَّقُولُ","m":"ما نقولُ."},{"w":"ٱعۡتَرَىٰكَ","m":"أصابَكَ."},{"w":"بِسُوٓءٖ","m":"بجُنونٍ؛ لنَهْيِك عن عبادتِها."}],"55":[{"w":"فَكِيدُونِي","m":"فاجتهِدُوا في إلحاقِ الضَّرَرِ بي."},{"w":"لَا تُنظِرُونِ","m":"لا تُمْهِلُوني بما تُريدون كيدَه."}],"56":[{"w":"تَوَكَّلۡتُ عَلَى ٱللَّهِ","m":"فَوَّضْتُ أمري إليه، واعتمَدْتُ عليه."},{"w":"دَآبَّةٍ","m":"كلُّ حَيَوانٍ يَمْشِي على هيئتِه على الأرضِ."},{"w":"ءَاخِذُۢ بِنَاصِيَتِهَآ","m":"مالِكُها وقادرٌ عليها."}],"57":[{"w":"وَيَسۡتَخۡلِفُ رَبِّي قَوۡمًا غَيۡرَكُمۡ","m":"يأتي بقومٍ آخَرين بَعْدَكم."},{"w":"حَفِيظٞ","m":"رقيبٌ مُهَيْمِنٌ."}],"58":[{"w":"جَآءَ أَمۡرُنَا","m":"أي: بهَلاكِ قومِ هودٍ."},{"w":"غَلِيظٖ","m":"شديدٍ، وهو الرِّيحُ الباردةُ التي أُهلِكَتْ بها عادٌ."}],"59":[{"w":"جَبَّارٍ","m":"متكبِّرٍ."},{"w":"عَنِيدٖ","m":"لا يَقْبَلُ الحقَّ ولا يَتْبَعُه."}],"60":[{"w":"لَعۡنَةٗ","m":"سُخْطاً من اللهِ، وبُعْداً من رحمتِه."},{"w":"بُعۡدٗا","m":"هَلاكاً."}],"61":[{"w":"ثَمُودَ","m":"قومِ صالحٍ عليه السلامُ، وهم قبيلةٌ من العَرَبِ."},{"w":"أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ","m":"ابتدأ خَلْقَكم منها."},{"w":"وَٱسۡتَعۡمَرَكُمۡ فِيهَا","m":"جَعَلَكم عُمَّارَها وسُكَّانَها."}],"62":[{"w":"كُنتَ فِينَا مَرۡجُوّٗا","m":"كُنَّا نرجو أن تكونَ فينا سَيِّداً مُطاعاً."},{"w":"مُرِيبٖ","m":"مُوقِعٍ في القلقِ وعَدَمِ الاطمئنانِ."}],"63":[{"w":"أَرَءَيۡتُمۡ","m":"أخْبِروني."},{"w":"بَيِّنَةٖ مِّن رَّبِّي","m":"حُجَّةٍ وبُرْهانٍ منه."},{"w":"رَحۡمَةٗ","m":"أي: النبوَّةَ والحِكْمةَ."},{"w":"تَخۡسِيرٖ","m":"إيقاعٍ في الخُسْرانِ وإبعادٍ عن الخير."}],"64":[{"w":"ءَايَةٗ","m":"علامةً دالَّةً على صِدْقي."},{"w":"فَذَرُوهَا","m":"فاترُكوها."},{"w":"بِسُوٓءٖ","m":"بأيِّ أذى."}],"65":[{"w":"فَعَقَرُوهَا","m":"فنَحَرُوا الناقةَ."},{"w":"تَمَتَّعُواْ فِي دَارِكُمۡ","m":"استَمْتِعُوا بالعيشِ في بلدِكم."}],"66":[{"w":"جَآءَ أَمۡرُنَا","m":"أي: بهَلاكِ قومِ صالحٍ."},{"w":"خِزۡيِ","m":"ذُلٍّ ومَهانَةِ."}],"67":[{"w":"ٱلصَّيۡحَةُ","m":"الصوتُ الشديدُ المُهلِكُ."},{"w":"جَٰثِمِينَ","m":"لاصِقِين بالأرضِ على رُكَبهِم ووُجوهِهم، لا حَراكَ بهم."}],"68":[{"w":"كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآ","m":"كأنَّ قومَ صالحٍ لم يُقيموا في ديارِهم ويَتمتَّعُوا فيها."},{"w":"بُعۡدٗا","m":"هَلاكاً."}],"69":[{"w":"رُسُلُنَآ","m":"الملائكةُ."},{"w":"بِٱلۡبُشۡرَىٰ","m":"ببِشارَتِه بالولَدِ."},{"w":"بِعِجۡلٍ حَنِيذٖ","m":"مَشْويٍّ في النارِ، أو على حِجارةٍ مُحمَّاةٍ بها."}],"70":[{"w":"نَكِرَهُمۡ","m":"أنكرَ عَدَمَ أكلِهم."},{"w":"وَأَوۡجَسَ مِنۡهُمۡ خِيفَةٗ","m":"أحَسَّ في نفسِه خوْفاً منهم."}],"72":[{"w":"يَٰوَيۡلَتَىٰٓ","m":"كلمةٌ أرادَتْ بها التعجُّبَ."},{"w":"بَعۡلِي","m":"زوجي."},{"w":"شَيۡخًا","m":"كبيراً في السِّن."}],"73":[{"w":"حَمِيدٞ","m":"محمودٌ في صفاتِه وأفعالِه."},{"w":"مَجِيدٞ","m":"عَظِيمٌ في صفاته، أو كثيرُ الخيرِ والإحسانِ."}],"74":[{"w":"ٱلرَّوۡعُ","m":"الخوفُ."}],"75":[{"w":"لَحَلِيمٌ","m":"صَبُورٌ على الأذَى، كثيرُ الصَّفْحِ عَمَّن ناله بمَكْروهٍ."},{"w":"أَوَّٰهٞ","m":"كثيرُ التضرُّعِ إلى اللهِ."},{"w":"مُنِيبٞ","m":"رَجَّاعٌ إلى اللهِ في أمورِه كلِّها."}],"76":[{"w":"جَآءَ أَمۡرُ رَبِّكَ","m":"أي: بهَلاكِ قومِ لوطٍ."}],"77":[{"w":"سِيٓءَ بِهِمۡ","m":"ساءَه حُضورُهم وأحْزَنَه."},{"w":"وَضَاقَ بِهِمۡ ذَرۡعٗا","m":"ضَعُفَتْ طاقَتُه عن تَدْبيرِ خَلاصِهم."},{"w":"عَصِيبٞ","m":"شديدٌ شَرُّه وبلاؤُه."}],"78":[{"w":"يُهۡرَعُونَ إِلَيۡهِ","m":"يُسْرِعُون المشيَ إليه؛ لطَلَبِ الفاحشةِ."},{"w":"هَٰٓؤُلَآءِ بَنَاتِي","m":"نساؤُكم اللّاتِي بمَنْزِلَةِ بناتي، فتزوَّجُوهنَّ."},{"w":"وَلَا تُخۡزُونِ","m":"لا تَفْضَحُوني ولا تُهينوني."},{"w":"رَشِيدٞ","m":"حَسَنُ التقديرِ للأمورِ."}],"79":[{"w":"مِنۡ حَقّٖ","m":"من حاجةٍ أو رغبةٍ."}],"80":[{"w":"لَوۡ أَنَّ لِي بِكُمۡ قُوَّةً","m":"لو وَجَدْتُ قُوَّة بَدَنٍ وأنصارًا مَعِي لَمَنعْتُكم من أضيافي."},{"w":"أَوۡ ءَاوِيٓ إِلَىٰ رُكۡنٖ شَدِيدٖ","m":"أو ألجأُ إلى عشيرةٍ قويَّة تمنعني منكم."}],"81":[{"w":"فَأَسۡرِ بِأَهۡلِكَ","m":"فاخرُجْ أنتَ وأهلُك المؤمنون."},{"w":"بِقِطۡعٖ مِّنَ ٱلَّيۡلِ","m":"بآخِر الليلِ."},{"w":"إِلَّا ٱمۡرَأَتَكَ","m":"فلا تَسْرِ بها."}],"82":[{"w":"جَآءَ أَمۡرُنَا","m":"أي: بهلاكِ قومِ لوطٍ."},{"w":"جَعَلۡنَا عَٰلِيَهَا سَافِلَهَا","m":"جَعَلْنا عاليَ قُراهم سافِلَها فقَلَبْناها عليهم."},{"w":"وَأَمۡطَرۡنَا","m":"أرْسَلْنا."},{"w":"سِجِّيلٖ","m":"من طِينٍ مُتَحَجِّر."},{"w":"مَنضُودٖ","m":"مُتتابعٍ في النزولِ."}],"83":[{"w":"مُسَوَّمَةً عِندَ رَبِّكَ","m":"مُعَلَّمَةً عند الله بعَلامةٍ تميِّزُها."}],"84":[{"w":"مَدۡيَنَ","m":"قومِ شُعيبٍ عليه السلام، وهم قبيلةٌ من العربِ."},{"w":"يَوۡمٖ مُّحِيطٖ","m":"لا يَفْلِتُ فيه أحدٌ من العذاب."}],"85":[{"w":"أَوۡفُواْ","m":"أتِمُّوا."},{"w":"بِٱلۡقِسۡطِ","m":"بالعدلِ من غيرِ زيادةٍ ولا نقصٍ."},{"w":"وَلَا تَبۡخَسُواْ","m":"ولا تَنْقُصُوا."},{"w":"وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ","m":"ولا تُفْرِطُوا في الفسادِ."}],"86":[{"w":"بَقِيَّتُ ٱللَّهِ خَيۡرٞ لَّكُمۡ","m":"ما أبقَى اللهُ لكم من الحَلالِ فيه بَرَكَةٌ وخيرٌ لكم."},{"w":"بِحَفِيظٖ","m":"برقيبٍ أُحْصِي أعمالَكم."}],"87":[{"w":"ٱلۡحَلِيمُ","m":"العاقلُ المتأنِّي."},{"w":"ٱلرَّشِيدُ","m":"الحَسَنُ التدبيرِ في المالِ."}],"88":[{"w":"بَيِّنَةٖ","m":"حُجَّةٍ واضحةٍ."},{"w":"حَسَنٗا","m":"واسعاً حلالاً."},{"w":"وَمَا تَوۡفِيقِيٓ","m":"وما هدايتي إلى إصابةِ الحقِّ والإصلاحِ."},{"w":"تَوَكَّلۡتُ","m":"اعتمَدْتُ وفوَّضْتُ أمري."},{"w":"وَإِلَيۡهِ أُنِيبُ","m":"أرْجِعُ في كلِّ أموري."}],"89":[{"w":"لَا يَجۡرِمَنَّكُمۡ شِقَاقِيٓ","m":"لا تَحْمِلَنَّكم مُعاداتي."},{"w":"وَمَا قَوۡمُ لُوطٖ مِّنكُم بِبَعِيدٖ","m":"أي: وما إهلاكُهم بزمانٍ ولا مكانٍ بعيدٍ منكم."}],"90":[{"w":"وَدُودٞ","m":"كثيرُ المودَّةِ والمحبَّةِ لِمَنْ تابَ إليه وأنابَ."}],"91":[{