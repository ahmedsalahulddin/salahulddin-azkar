{"1":[{"w":"ٱلۡحَآقَّةُ","m":"القِيامة الواقِعةُ حَقّاً؛ الَّتِي يَتَحَقَّقُ فِيها الوعْدُ والوَعِيدُ."}],"3":[{"w":"وَمَآ أَدۡرَىٰكَ","m":"وأيُّ شَيءٍ عَرَّفَكَ حَقيقَةَ القيامَةِ؟"}],"4":[{"w":"بِٱلۡقَارِعَةِ","m":"بالقِيامَةِ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا."}],"5":[{"w":"بِٱلطَّاغِيَةِ","m":"بالصَّيحَةِ العَظِيمَةِ؛ الَّتِي جاوزَتِ الحدَّ في شِدَّتِها."}],"6":[{"w":"صَرۡصَرٍ","m":"بارِدَةٍ."},{"w":"عَاتِيَةٖ","m":"شَدِيدَةِ الهُبُوبِ."}],"7":[{"w":"سَخَّرَهَا عَلَيۡهِمۡ","m":"سَلَّطَها اللهُ عَلَيهِم."},{"w":"حُسُومٗا","m":"مُتَتَابِعَةً."},{"w":"صَرۡعَىٰ","m":"مَوْتَى."},{"w":"أَعۡجَازُ نَخۡلٍ","m":"أُصُولُ نَخْلٍ."},{"w":"خَاوِيَةٖ","m":"خَرِبَةٍ مُتآكِلَةِ الأَجْوافِ."}],"8":[{"w":"بَاقِيَةٖ","m":"نَفْسٍ باقِيةٍ دُونَ هَلَاكٍ."}],"9":[{"w":"وَٱلۡمُؤۡتَفِكَٰتُ","m":"وَأَهلُ قُرَى قَوْمِ لُوطٍ؛ الَّذِينَ انْقَلَبَتْ بِهم دِيارُهُم."},{"w":"بِٱلۡخَاطِئَةِ","m":"بِسَبَبِ الفَعْلَةِ المنكرَةِ مِنَ الكُفْرِ والفواحِشِ."}],"10":[{"w":"فَأَخَذَهُمۡ","m":"فَأَهْلَكَهُم."},{"w":"رَابِيَةً","m":"بالِغةً في الشِّدَّةِ."}],"11":[{"w":"طَغَا ٱلۡمَآءُ","m":"جاوَزَ حَدَّهُ، حتَّى عَلَا وارْتَفَعَ فَوْقَ كُلِّ شَيءٍ."},{"w":"حَمَلۡنَٰكُمۡ","m":"حَمَلْناكُم وأنتُم في أَصْلابِ آبائِكُم وأُمَّهاتِكُم."},{"w":"ٱلۡجَارِيَةِ","m":"السَّفِينَةِ الَّتِي تَجْرِي في الماءِ، والمراد: سفينة نوح عليه السلام."}],"12":[{"w":"لِنَجۡعَلَهَا","m":"لِنَجْعَلَ الواقِعةَ الَّتِي نَجا فِيها المُؤمِنُونَ، وأُغْرِقَ فِيها الكَافِرُونَ."},{"w":"تَذۡكِرَةٗ","m":"عِبْرةً وعِظَةً."},{"w":"وَتَعِيَهَآ","m":"وَتَحْفَظَها."}],"13":[{"w":"ٱلصُّورِ","m":"القَرْنِ الَّذِي يَنْفُخُ فيه المَلَكُ عِنْدَ قِيامِ السَّاعةِ."}],"14":[{"w":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ","m":"رُفِعَت عن أماكِنِها."},{"w":"فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ","m":"دُقَّتا دَقَّةً واحِدَةً."}],"15":[{"w":"وَقَعَتِ ٱلۡوَاقِعَةُ","m":"قامَتِ القِيامةُ."}],"16":[{"w":"وَٱنشَقَّتِ","m":"انْصَدَعَتْ مُتَشَقِّقَةً."},{"w":"وَاهِيَةٞ","m":"ضَعِيفَةٌ لَا تَماسُكَ فِيها."}],"17":[{"w":"وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَا","m":"والملائِكَةُ على أَطْرَافِها."},{"w":"عَرۡشَ رَبِّكَ","m":"وهو سَرِيرُ الملْكِ الَّذِي تَحْمِلُه الملائِكةُ، واسْتَوى عَلَيهِ الرحمنُ، وهو أَعْظَمُ المَخْلُوقاتِ، وهو سَقْفُ جَنَّةِ الفِرْدَوسِ."},{"w":"ثَمَٰنِيَةٞ","m":"أي: من الملائِكةِ العِظامِ."}],"18":[{"w":"تُعۡرَضُونَ","m":"أي: عَلَى اللهِ."},{"w":"لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ","m":"لا تَخْفى عَلَى اللهِ نَفْسٌ خافِيةٌ مِنْكُم."}],"19":[{"w":"هَآؤُمُ","m":"تعالَوا."}],"20":[{"w":"ظَنَنتُ","m":"أَيْقَنْتُ."},{"w":"حِسَابِيَهۡ","m":"جَزائِي يومَ القيامةِ."}],"21":[{"w":"رَاضِيَةٖ","m":"مَرْضِيَّةٍ."}],"22":[{"w":"عَالِيَةٖ","m":"مُرْتَفِعَةِ المكانِ والدَّرجَاتِ."}],"23":[{"w":"قُطُوفُهَا","m":"ثِمارُها."},{"w":"دَانِيَةٞ","m":"قَرِيبَةُ التَّناوُلِ."}],"24":[{"w":"هَنِيٓـَٔۢا","m":"أَكْلاً وشُرْباً يَهْنأُ بِهما صاحِبُهُما."},{"w":"أَسۡلَفۡتُمۡ","m":"قدَّمْتُم."},{"w":"ٱلۡأَيَّامِ ٱلۡخَالِيَةِ","m":"أَيَّامِ الدُّنيا الماضِيةِ."}],"26":[{"w":"حِسَابِيَهۡ","m":"جَزَائِي."}],"27":[{"w":"يَٰلَيۡتَهَا","m":"ياليتَ الموتَةَ الَّتِي مِتُّها في الدُّنيا."},{"w":"ٱلۡقَاضِيَةَ","m":"القاطِعةَ لِأَمْرِي فلا أُبْعَثُ."}],"28":[{"w":"مَآ أَغۡنَىٰ","m":"ما نَفَعَ."}],"29":[{"w":"هَلَكَ","m":"غَابَ."},{"w":"سُلۡطَٰنِيَهۡ","m":"مُلْكِي."}],"30":[{"w":"فَغُلُّوهُ","m":"اجْعَلُوا القَيْدَ في عُنُقِه."}],"31":[{"w":"صَلُّوهُ","m":"أَدْخِلُوهُ."}],"32":[{"w":"سِلۡسِلَةٖ","m":"مَجْمُوعِ حَلَقٍ مِن حَدِيدٍ؛ دَاخِلٍ بَعْضُها فِي بَعْضٍ."},{"w":"ذَرۡعُهَا","m":"مِقْدَارُ طُولِهَا بالذِّراعِ."},{"w":"فَٱسۡلُكُوهُ","m":"فَأَدْخِلُوه في السِّلْسِلَةِ."}],"34":[{"w":"وَلَا يَحُضُّ","m":"ولا يَحُثُّ."}],"35":[{"w":"هَٰهُنَا","m":"يَومَ القِيامةِ."},{"w":"حَمِيمٞ","m":"قَرِيبٌ يدفعُ عنْه العذابَ."}],"36":[{"w":"غِسۡلِينٖ","m":"صَدِيدِ أَهْلِ النَّارِ، وما يَسِيلُ مِنْ أَجْسَادِهِم."}],"37":[{"w":"ٱلۡخَٰطِـُٔونَ","m":"المُذْنِبُونَ أَشَدَّ الذَّنبِ؛ وهو الإِشْرَاكُ."}],"38":[{"w":"بِمَا تُبۡصِرُونَ","m":"مِنَ الأرضِ، والجِبالِ، والبِحارِ، والبَشَرِ، والسَّمواتِ، ونحوِها."}],"39":[{"w":"وَمَا لَا تُبۡصِرُونَ","m":"مِنَ الأرواحِ، والملائِكةِ، وَأُمُورِ الآخِرَةِ."}],"40":[{"w":"لَقَوۡلُ رَسُولٖ كَرِيمٖ","m":"يَنْطِقُ بِهِ مُحَمَّدٌ ﷺ، والكَلامُ كَلامُ المُرسِلِ سُبْحانَهُ وتَعَالَى."}],"41":[{"w":"قَلِيلٗا مَّا تُؤۡمِنُونَ","m":"تُؤْمِنُونَ إِيماناً قَلِيلاً لا يُنْجِيكُم مِن الخُلُود في النَّارِ."}],"42":[{"w":"قَلِيلٗا مَّا تَذَكَّرُونَ","m":"تَتَذَكَّرُونَ تَذَكُّراً قَلِيلاً."}],"44":[{"w":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ","m":"وَلَو كَذَبَ عَلَينا بأنَّا قُلْنا قَوْلاً لم نَقُلْه."}],"45":[{"w":"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ","m":"لَأَخَذْناهُ بِقُوَّةٍ وقُدْرَةٍ."}],"46":[{"w":"ٱلۡوَتِينَ","m":"هو عِرْقٌ عُلِّقَ به القلبُ، ويَسْقِي الجسدَ بالدَّمِ، فإذا قُطِعَ مات صاحِبُه."}],"47":[{"w":"عَنۡهُ حَٰجِزِينَ","m":"يَمنعُونَ مِنْهُ عِقابَنا."}],"48":[{"w":"لَتَذۡكِرَةٞ","m":"لَعِظَةٌ."}],"50":[{"w":"وَإِنَّهُۥ","m":"أي: التَّكْذِيبَ."},{"w":"لَحَسۡرَةٌ","m":"لَنَدامةٌ عَظِيمَةٌ."}],"51":[{"w":"لَحَقُّ ٱلۡيَقِينِ","m":"الخبرُ الصِّدقُ."}],"52":[{"w":"فَسَبِّحۡ","m":"فَنَزِّهْ."}]}