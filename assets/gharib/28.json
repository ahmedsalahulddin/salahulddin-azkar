{"1":[{"w":"طسٓمٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورةِ البَقَرةِ."}],"3":[{"w":"نَبَإِ مُوسَىٰ","m":"خَبَرِ مُوسَى."},{"w":"بِٱلۡحَقِّ","m":"بالصِّدْقِ."}],"4":[{"w":"عَلَا","m":"تَجَبَّرَ وتكَبَّرَ."},{"w":"شِيَعٗا","m":"طَوائِفَ مُتَفَرِّقةً."},{"w":"وَيَسۡتَحۡيِۦ نِسَآءَهُمۡ","m":"أي: يَسْتَبْقِيهِنَّ للخِدْمَةِ والامْتِهانِ."}],"5":[{"w":"أَن نَّمُنَّ","m":"أن نَتَفَضَّلَ."},{"w":"أَئِمَّةٗ","m":"قادَةً في الخيرِ."},{"w":"ٱلۡوَٰرِثِينَ","m":"أي: وَرِثُوا أرضَ مِصْرَ بَعْدَ هَلَاكِ فِرْعَونَ وقَومِهِ."}],"6":[{"w":"وَنُمَكِّنَ لَهُمۡ","m":"ونُثَبِّتَ لهم."},{"w":"يَحۡذَرُونَ","m":"يَخافُونَ."}],"7":[{"w":"وَأَوۡحَيۡنَآ","m":"وألْهَمْنا."},{"w":"فِي ٱلۡيَمِّ","m":"في نَهْرِ النِّيلِ."}],"8":[{"w":"فَٱلۡتَقَطَهُۥٓ","m":"فأخَذَهُ."},{"w":"لِيَكُونَ","m":"أي: في المآلِ والعاقِبَةِ."}],"9":[{"w":"قُرَّتُ عَيۡنٖ","m":"مَصْدرُ سُرورٍ وسَعادةٍ تَقَرُّ العَينُ بِهِ."}],"10":[{"w":"فُؤَادُ","m":"قَلْبُ."},{"w":"فَٰرِغًا","m":"خالِياً مِن كلِّ شَيءٍ؛ ليمْلَأَه هَمُّ مُوسَى وذِكْرُه."},{"w":"لَتُبۡدِي بِهِۦ","m":"لَتُظْهِرُ أَنَّ مُوسَى ابْنُهَا."},{"w":"أَن رَّبَطۡنَا","m":"أن ثبَّتناها بالصَّبرِ والثَّباتِ."}],"11":[{"w":"قُصِّيهِ","m":"اتَّبعِي أثَرَ مُوسَى، وتَعَرَّفي خَبَرَه."},{"w":"عَن جُنُبٖ","m":"عن بُعدٍ."}],"12":[{"w":"وَحَرَّمۡنَا عَلَيۡهِ","m":"أي: مَنَعْنَاهُ مِن قَبُولِ الرَّضاعَةِ."},{"w":"يَكۡفُلُونَهُۥ","m":"يقُومُونَ بإرْضاعِه وتَرْبِيَتِهِ."},{"w":"نَٰصِحُونَ","m":"مُشْفِقُونَ."}],"13":[{"w":"كَيۡ تَقَرَّ عَيۡنُهَا","m":"كَي تُسَرَّ أمُّ مُوسَى بِسَلَامَةِ وَلَدِها ورُجُوعِهِ إِليها."}],"14":[{"w":"أَشُدَّهُۥ","m":"أي: مُنْتَهى قُوَّتِه."},{"w":"وَٱسۡتَوَىٰٓ","m":"أي: تكَامَلَ عَقْلُه."},{"w":"ءَاتَيۡنَٰهُ حُكۡمٗا وَعِلۡمٗا","m":"أعْطَيناه حِكْمَةً وفَهْماً، ومَعْرِفَةً بالدِّينِ."}],"15":[{"w":"عَلَىٰ حِينِ غَفۡلَةٖ","m":"وَقْتِ غَفْلَةِ أَهْلِها."},{"w":"فَٱسۡتَغَٰثَهُ","m":"فَطَلَبَ الغَوثَ والنَّصْرَ مِن مُوسَى عَلَيهِ الصَّلاةُ والسَّلامُ."},{"w":"مِن شِيعَتِهِۦ","m":"أي: مِن بَنِي إسْرَائِيلَ، قَومِ مُوسَى عَلَيهِ الصَّلاةُ والسَّلامُ."},{"w":"ٱلَّذِي مِنۡ عَدُوِّهِۦ","m":"أي: القِبْطِيِّ الَّذي كان مِن قَومِ فِرْعَونَ."},{"w":"فَوَكَزَهُۥ","m":"ضَرَبَه مُوسَى بجُمْعِ كَفِّه."},{"w":"فَقَضَىٰ عَلَيۡهِ","m":"قَتَلَه."}],"17":[{"w":"ظَهِيرٗا","m":"مُعِيناً."}],"18":[{"w":"يَتَرَقَّبُ","m":"يَتَوَقَّعُ المكْرُوهَ، ويُرَاقِبُ ما يَحْدُثُ."},{"w":"يَسۡتَصۡرِخُهُۥ","m":"يَطْلُبُ مِنْهُ النَّصْرَ."},{"w":"لَغَوِيّٞ","m":"لَشَدِيدُ الضَّلالِ وسُوءِ النَّظرِ."}],"19":[{"w":"أَن يَبۡطِشَ","m":"أن يَأْخُذَ بقوَّةٍ وعُنْفٍ."}],"20":[{"w":"أَقۡصَا ٱلۡمَدِينَةِ","m":"آخِرِ المدينةِ."},{"w":"ٱلۡمَلَأَ","m":"أَشْرَافَ القَومِ وَسَادَتَهُم."},{"w":"يَأۡتَمِرُونَ","m":"يَتَشَاورُونَ في شَأْنِكَ."},{"w":"ٱلنَّٰصِحِينَ","m":"المُشْفِقِينَ."}],"22":[{"w":"تِلۡقَآءَ مَدۡيَنَ","m":"جِهَةَ مَدْيَنَ."},{"w":"سَوَآءَ ٱلسَّبِيلِ","m":"أي: الطَّرِيقَ المُسْتَويَ إلى مَدْيَنَ."}],"23":[{"w":"وَرَدَ","m":"بَلَغَ."},{"w":"أُمَّةٗ","m":"جَمَاعةً."},{"w":"تَذُودَانِ","m":"تَحبِسَانِ غَنَمَهُما عَنِ الماءِ."},{"w":"مَا خَطۡبُكُمَا","m":"ما شَأْنُكمَا؟"},{"w":"يُصۡدِرَ ٱلرِّعَآءُ","m":"يَنْصَرِفَ الرُّعاةُ بِمَواشِيهِم عَنِ الماءِ."}],"24":[{"w":"تَوَلَّىٰٓ إِلَى ٱلظِّلِّ","m":"رَجَعَ إليه."}],"27":[{"w":"تَأۡجُرَنِي","m":"تَكُونَ لي أَجِيراً في رَعْيِ الغَنَمِ."},{"w":"حِجَجٖ","m":"سِنِينَ."}],"28":[{"w":"أَيَّمَا ٱلۡأَجَلَيۡنِ","m":"أيَّ المُدَّتَينِ."},{"w":"قَضَيۡتُ","m":"وَفَّيتُ به وأتْمَمْتُه."},{"w":"فَلَا عُدۡوَٰنَ عَلَيَّ","m":"لا اعْتِدَاءَ ولا ظُلْمَ عليَّ بالمطالَبَةِ بأكْثَرَ مِنْه."},{"w":"وَكِيلٞ","m":"شاهِدٌ وحَفِيظٌ."}],"29":[{"w":"ٱلۡأَجَلَ","m":"المُدَّةَ المُتَّفَقَ عَلَيها وهي عَشْرُ سِنِينَ."},{"w":"ءَانَسَ","m":"أبصَرَ ما يُؤْنِسُ."},{"w":"جَذۡوَةٖ","m":"جَمْرَةٍ وشُعْلَةٍ."},{"w":"تَصۡطَلُونَ","m":"تَسْتَدْفِئُونَ بِها."}],"30":[{"w":"شَٰطِيِٕ","m":"جانِبِ."},{"w":"ٱلۡبُقۡعَةِ","m":"القِطْعَةِ مِنَ الأرْضِ."}],"31":[{"w":"تَهۡتَزُّ","m":"تتحرَّكُ بخِفَّةٍ."},{"w":"جَآنّٞ","m":"حَيَّةٌ خَفِيفَةٌ في سُرْعَةِ حرَكَتِها."},{"w":"وَلَّىٰ","m":"هَرَبَ."},{"w":"وَلَمۡ يُعَقِّبۡ","m":"لم يَرْجِ