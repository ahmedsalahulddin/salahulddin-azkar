{"1":[{"w":"أَوۡلِيَآءَ","m":"خُلَصاءَ وأحبّاءَ."},{"w":"تُلۡقُونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ","m":"أي: تُخْبِرُونَهُم بِأَخْبارِ الرَّسُولِ ﷺ وسَرَائِر المسْلِمِينَ."},{"w":"وَٱبۡتِغَآءَ","m":"طَلَبَ."},{"w":"تُسِرُّونَ","m":"تَنْقُلُونَ إِلَيهِمُ الأخْبارَ سِرّاً."},{"w":"سَوَآءَ ٱلسَّبِيلِ","m":"طَرِيقَ الحقِّ والصَّوابِ."}],"2":[{"w":"إِن يَثۡقَفُوكُمۡ","m":"إن يَظْفَرْ بِكُم هَؤلاءِ الَّذِينَ تُسِرُّونَ إِليهِم بالمودّةِ."},{"w":"وَيَبۡسُطُوٓاْ إِلَيۡكُمۡ","m":"وَيَمُدُّوا إلَيكُم."},{"w":"بِٱلسُّوٓءِ","m":"بالقَتْلِ، والسَّبْيِ، وَالشَّتْمِ."}],"3":[{"w":"أَرۡحَامُكُمۡ","m":"قراباتُكُم."},{"w":"يَفۡصِلُ بَيۡنَكُمۡ","m":"يَفْرُقُ اللهُ بَيْنَكُم، فيُدْخِلُ أهلَ طاعَتهِ الجَنَّةَ، وأهلَ مَعْصِيتِه النَّارَ."}],"4":[{"w":"أُسۡوَةٌ","m":"قُدْوَةٌ."},{"w":"كَفَرۡنَا بِكُمۡ","m":"أَنْكَرْنا ما أنتُم عَلَيهِ مِنَ الكُفْرِ."},{"w":"وَبَدَا","m":"وَظَهَر."},{"w":"تَوَكَّلۡنَا","m":"اعْتَمَدْنا."},{"w":"أَنَبۡنَا","m":"رَجَعْنا بالتَّوبَةِ."},{"w":"ٱلۡمَصِيرُ","m":"المرْجِعُ يومَ القِيامَةِ."}],"5":[{"w":"فِتۡنَةٗ","m":"مَفْتُونِينَ؛ بِتَسْلِيطِ الكُفَّارِ عَلَينا."},{"w":"ٱلۡعَزِيزُ","m":"الَّذِي لا يُغالَبُ."},{"w":"ٱلۡحَكِيمُ","m":"في أَفْعالِهِ وأَقْوالِهِ."}],"6":[{"w":"أُسۡوَةٌ","m":"قُدْوَةٌ."},{"w":"يَرۡجُواْ ٱللَّهَ","m":"يَطْمَعُ في الخيرِ مِنَ اللهِ."},{"w":"وَمَن يَتَوَلَّ","m":"وَمَن يُعْرضْ عَمَّا أَمَرهُ اللهُ بِهِ."},{"w":"ٱلۡغَنِيُّ","m":"عَنْ عِبادِهِ."},{"w":"ٱلۡحَمِيدُ","m":"في ذاتِه وَصِفاتِه، المحْمُودُ عَلى كُلِّ حالٍ."}],"7":[{"w":"عَسَى ٱللَّهُ","m":"وَعَدَ اللهُ."}],"8":[{"w":"تَبَرُّوهُمۡ","m":"تُحْسِنُوا مُعامَلَتَهُم."},{"w":"وَتُقۡسِطُوٓاْ إِلَيۡهِمۡ","m":"وتَعْدِلُوا فِيهِم."}],"9":[{"w":"فِي ٱلدِّينِ","m":"بِسَببِ الدِّينِ."},{"w":"وَظَٰهَرُواْ","m":"وعاوَنُوا الكُفَّارَ."},{"w":"أَن تَوَلَّوۡهُمۡ","m":"بالنُّصْرَةِ والمحبَّةِ."},{"w":"وَمَن يَتَوَلَّهُمۡ","m":"وَمَن يَتَّخِذْهُم أَنْصاراً عَلَى المؤمِنِينَ."}],"10":[{"w":"مُهَٰجِرَٰتٖ","m":"مِن دَارِ الكُفْرِ إلَى دارِ الإِسْلامِ."},{"w":"فَٱمۡتَحِنُوهُنَّ","m":"فاخْتَبرُوا إِيمانَهُنَّ."},{"w":"وَءَاتُوهُم","m":"وَأعْطُوا أزواجَ اللاتِي أَسْلَمْنَ."},{"w":"مَآ أَنفَقُواْ","m":"مِثْلَ ما أَعْطَوهُنَّ مِنَ المهُورِ."},{"w":"أُجُورَهُنَّ","m":"مُهُورَهُنَّ."},{"w":"بِعِصَمِ","m":"بِنِكاحِ، وأصْلُه جَمْعُ عِصْمَةٍ وهي: ما اعتُصِمَ بِهِ من العَقْدِ والسَّبَبِ."},{"w":"ٱلۡكَوَافِرِ","m":"الزَّوجاتِ الكافِرَاتِ."}],"11":[{"w":"فَاتَكُمۡ","m":"فَرَرْنَ ولَحِقْنَ."},{"w":"فَعَاقَبۡتُمۡ","m":"كانَتِ العُقْبَى لَكُم، وهي الغَنِيمَةُ."}],"12":[{"w":"يُبَايِعۡنَكَ","m":"يُعاهِدْنَكَ."},{"w":"أَن لَّا يُشۡرِكۡنَ بِٱللَّهِ شَيۡـٔٗا","m":"ألَّا يَجْعَلْنَ مَعَ اللهِ شَرِيكاً في عِبادَتِهِ."},{"w":"وَلَا يَأۡتِينَ بِبُهۡتَٰنٖ يَفۡتَرِينَهُۥ","m":"ولا يأتِينَ بِكَذِبٍ في مَولُودٍ مِنْ غَيرِ أزْواجِهِنَّ فيُلْحِقْنَهُ بِهِم."},{"w":"فَبَايِعۡهُنَّ","m":"فعاهِدْهُنَّ."}],"13":[{"w":"لَا تَتَوَلَّوۡاْ قَوۡمًا","m":"لا تَتَّخِذُوهُم أَخِلَّاءَ."},{"w":"يَئِسُواْ مِنَ ٱلۡأٓخِرَةِ","m":"أي: مِن ثَوابِ اللهِ في الآخِرَةِ، أَوْ كَما يَئِسَ الكُفَّارُ مِن بَعْثِ مَوْتاهُم."}]}