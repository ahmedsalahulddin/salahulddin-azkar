{"4":[{"w":"ٱلۡبَيَانَ","m":"النُّطْقَ والتَّعْبِيرَ عَمَّا في الضَّمائِرِ."}],"5":[{"w":"بِحُسۡبَانٖ","m":"يَجْرِيانِ بِحِسابٍ مُتْقَنٍ."}],"7":[{"w":"ٱلۡمِيزَانَ","m":"العَدْلَ الَّذِي شَرَعَهُ لِعِبادِهِ."}],"8":[{"w":"أَلَّا تَطۡغَوۡاْ","m":"لِئَلَّا تَعْتَدُوا."}],"9":[{"w":"بِٱلۡقِسۡطِ","m":"بالعَدْلِ."},{"w":"وَلَا تُخۡسِرُواْ","m":"ولا تُنْقِصُوا."}],"10":[{"w":"وَضَعَهَا","m":"مَهَّدَها."},{"w":"لِلۡأَنَامِ","m":"لِلْخَلْقِ."}],"11":[{"w":"ٱلۡأَكۡمَامِ","m":"جَمْعُ «كِمٍّ» وهو وِعاءُ الثَّمرَةِ."}],"12":[{"w":"ذُو ٱلۡعَصۡفِ","m":"ذُو القِشْرِ."},{"w":"وَٱلرَّيۡحَانُ","m":"كُلُّ نَبْتٍ طَيِّبِ الرَّائِحةِ."}],"13":[{"w":"ءَالَآءِ","m":"نِعَمِ."}],"14":[{"w":"ٱلۡإِنسَٰنَ","m":"أي: أَباه، وهو آدَمُ عليه السَّلام."},{"w":"مِن صَلۡصَٰلٖ","m":"مِن طِينٍ يابِسٍ."},{"w":"كَٱلۡفَخَّارِ","m":"الطينِ الَّذِي طُبِخَ بالنَّارِ."}],"15":[{"w":"ٱلۡجَآنَّ","m":"إِبْلِيسَ."},{"w":"مَارِجٖ","m":"لَهَبِ النَّارِ المُخْتَلِطِ بَعْضُهُ بِبَعْضٍ."}],"17":[{"w":"ٱلۡمَشۡرِقَيۡنِ","m":"مَشْرِقَي الشَّمْسِ في الشِّتاءِ والصَّيفِ."},{"w":"ٱلۡمَغۡرِبَيۡنِ","m":"مَغْرِبَيِ الشَّمسِ في الشِّتاءِ والصَّيفِ."}],"19":[{"w":"مَرَجَ","m":"خَلَطَ."},{"w":"ٱلۡبَحۡرَيۡنِ","m":"الماءَ العَذْبَ والمِلْحَ."},{"w":"يَلۡتَقِيَانِ","m":"في مَرْأَى العَينِ."}],"20":[{"w":"بَرۡزَخٞ","m":"حاجِزٌ."},{"w":"لَا يَبۡغِيَانِ","m":"لا يطْغَى أحَدُهُما عَلَى الآخَرِ."}],"22":[{"w":"ٱللُّؤۡلُؤُ","m":"الدُّرُّ."},{"w":"وَٱلۡمَرۡجَانُ","m":"صِغارُ اللُّؤلُؤ."}],"24":[{"w":"ٱلۡجَوَارِ","m":"السُّفُنُ الضَّخْمَةُ الَّتِي تَجْرِي في البَحْرِ."},{"w":"ٱلۡمُنشَـَٔاتُ","m":"المَرْفُوعاتُ الشِّراعِ."},{"w":"كَٱلۡأَعۡلَٰمِ","m":"كالجِبالِ."}],"26":[{"w":"عَلَيۡهَا","m":"عَلَى وَجْهِ الأرْضِ."},{"w":"فَانٖ","m":"هَالِكٌ."}],"27":[{"w":"ٱلۡجَلَٰلِ","m":"ذُو العَظَمَةِ والكِبْرِياءِ."},{"w":"وَٱلۡإِكۡرَامِ","m":"والفَضْلِ والجُوْدِ."}],"31":[{"w":"سَنَفۡرُغُ","m":"سنفرغ لحسابكم ومجازاتكم بأعْمالِكُم."},{"w":"أَيُّهَ ٱلثَّقَلَانِ","m":"أيُّها الإِنْسُ والجِنُّ."}],"33":[{"w":"تَنفُذُواْ","m":"تَخْرُجُوا."},{"w":"أَقۡطَارِ","m":"أَطْرَافِ."},{"w":"بِسُلۡطَٰنٖ","m":"بِقُوَّةٍ وَحُجَّةٍ."}],"35":[{"w":"شُوَاظٞ","m":"لَهَبٌ."},{"w":"وَنُحَاسٞ","m":"مُذابٌ يُصَبُّ على رُؤُوسِكُم."},{"w":"فَلَا تَنتَصِرَانِ","m":"فَلَا يَنْصُرُ بَعْضُكُم بَعْضاً."}],"37":[{"w":"ٱنشَقَّتِ","m":"تَفَطَّرَتْ يَوْمَ القِيامَةِ."},{"w":"وَرۡدَةٗ","m":"حَمْراءَ كَلَونِ الوَرْدِ."},{"w":"كَٱلدِّهَانِ","m":"كالزَّيتِ الْمَغْلِيِّ والرَّصاصِ المُذابِ."}],"41":[{"w":"بِسِيمَٰهُمۡ","m":"بعَلاماتِهِم."},{"w":"بِٱلنَّوَٰصِي","m":"بمُقَدِّمَةِ رُؤُوسِهِم."}],"44":[{"w":"حَمِيمٍ","m":"الماءِ الشَّدِيدِ الحَرارَةِ."},{"w":"ءَانٖ","m":"بالغٍ مُنْتَهاهُ في الحرارةِ."}],"46":[{"w":"مَقَامَ رَبِّهِۦ","m":"وَقْتَ قِيامِهِ بين يَدَي رَبِّهِ."}],"48":[{"w":"أَفۡنَانٖ","m":"أغْصانٍ نَضِرَةٍ مِنَ الفَوَاكِهِ والثِّمارِ."}],"52":[{"w":"زَوۡجَانِ","m":"صِنْفانِ."}],"54":[{"w":"بَطَآئِنُهَا","m":"جَمْعُ بِطانَةٍ، وهي ما يَلِي الأرْضَ مِنَ الفِراشِ."},{"w":"إِسۡتَبۡرَقٖ","m":"غَلِيظِ الحرِيرِ الخالِصِ."},{"w":"وَجَنَى","m":"وَثَمَرُ."},{"w":"دَانٖ","m":"قَرِيبٌ إِليهِم."}],"56":[{"w":"فِيهِنَّ","m":"في هَذِه الفُرُشِ."},{"w":"قَٰصِرَٰتُ ٱلطَّرۡفِ","m":"لا يَصْرِفْنَ أَبْصَارَهُنَّ إِلى غَيرِ أزْوَاجِهِنَّ."},{"w":"لَمۡ يَطۡمِثۡهُنَّ","m":"لم يَطَأْهُنَّ."}],"58":[{"w":"ٱلۡيَاقُوتُ","m":"حَجَرٌ مِنَ الأحْجارِ الكَرِيمَةِ، ذُو ألْوانٍ."},{"w":"وَٱلۡمَرۡجَانُ","m":"صِغارُ اللُّؤلُؤِ."}],"62":[{"w":"وَمِن دُونِهِمَا","m":"وَمِن دُونِ الجنَّتَينِ السَّابِقَتَينِ في الدَّرَجِ."}],"64":[{"w":"مُدۡهَآمَّتَانِ","m":"خَضْرَاوانِ، وَقَدِ اشْتَدَّتْ خُضْرَتُهُما حَتَّى مالَتْ إلى السَّوادِ."}],"66":[{"w":"نَضَّاخَتَانِ","m":"فَوَّارتانِ بالماءِ، لا تَنْقَطِعانِ."}],"70":[{"w":"فِيهِنَّ","m":"في هَذِه الجنَّاتِ الأرْبَعِ."},{"w":"خَيۡرَٰتٌ","m":"زَوْجاتٌ طيِّباتُ الأخْلاقِ."},{"w":"حِسَانٞ","m":"حِسانُ الوُجُوهِ."}],"72":[{"w":"حُورٞ","m":"نِساءٌ ذَوَاتُ حَوَرٍ، وهو شِدَّةُ بَياضِ العَينِ وشِدَّةُ سَوَادِها."},{"w":"مَقۡصُورَٰتٞ","m":"مَسْتُوراتٌ مَصُوناتٌ."},{"w":"ٱلۡخِيَامِ","m":"البُيوتِ."}],"76":[{"w":"رَفۡرَفٍ","m":"وَسَائِدَ ذَوَاتِ أَغْطِيَةٍ."},{"w":"وَعَبۡقَرِيٍّ","m":"وَفُرُشٍ بَدِيعَةٍ."}],"78":[{"w":"تَبَٰرَكَ","m":"كَثُرَ خَيرُهُ."},{"w":"ٱلۡجَلَٰلِ","m":"العَظَمَةِ والمَجْدِ."},{"w":"وَٱلۡإِكۡرَامِ","m":"لِأَوْلِيائِهِ."}]}