{"1":[{"w":"هَوَىٰ","m":"غَابَ."}],"2":[{"w":"غَوَىٰ","m":"خَرَجَ عنِ الرَّشادِ."}],"3":[{"w":"ٱلۡهَوَىٰٓ","m":"ما تَمِيلُ إِلَيهِ النَّفْسُ مِنْ غَيرِ دَلِيلٍ."}],"5":[{"w":"شَدِيدُ ٱلۡقُوَىٰ","m":"مَلَكٌ شَدِيدُ القُوَّةِ."}],"6":[{"w":"مِرَّةٖ","m":"مَنْظَرٍ حَسَنٍ."},{"w":"فَٱسۡتَوَىٰ","m":"عَلَى صُورَتِهِ الحقِيقِيَّةِ للرَّسولِ ﷺ."}],"7":[{"w":"بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ","m":"أُفُقِ الشَّمسِ عِنْدَ مَطْلَعِها."}],"8":[{"w":"فَتَدَلَّىٰ","m":"فَزَادَ في القُرْبِ."}],"9":[{"w":"قَابَ قَوۡسَيۡنِ","m":"مِقْدَارَ قَوسَينِ."}],"11":[{"w":"ٱلۡفُؤَادُ","m":"قَلْبُ النبيِّ ﷺ."}],"12":[{"w":"أَفَتُمَٰرُونَهُۥ","m":"أَتُكَذِّبُونَ مُحَمَّداً ﷺ، فَتُجادِلُونَه عَلَى ما يَرَاهُ مِنْ آياتِ رَبِّهِ؟"}],"13":[{"w":"رَءَاهُ","m":"رَأى مُحَمَّدٌ ﷺ جِبْرِيلَ."},{"w":"نَزۡلَةً","m":"مَرَّةً."}],"14":[{"w":"سِدۡرَةِ ٱلۡمُنتَهَىٰ","m":"شَجَرةِ نَبْقٍ في السَّماءِ السَّابِعةِ؛ يَنْتَهي إِلَيها ما يُعْرَجُ بِهِ مِنَ الأَرْضِ، وما يُهْبَطُ بِه مِنْ فَوْقِها."}],"16":[{"w":"يَغۡشَى ٱلسِّدۡرَةَ","m":"يُغَطِّيها وَيَسْتُرُها."}],"17":[{"w":"زَاغَ","m":"مَالَ."},{"w":"طَغَىٰ","m":"جَاوَزَ ما أُمِرَ برُؤْيَتِهِ."}],"18":[{"w":"ءَايَٰتِ رَبِّهِ","m":"دَلَائلِ عَظَمةِ اللهِ."}],"19":[{"w":"ٱللَّٰتَ وَٱلۡعُزَّىٰ ۞ وَمَنَوٰةَ","m":"هي أصْنَامٌ اتَّخَذَها العَربُ آلِهَةً."},{"w":"ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰٓ","m":"صِفَتا تأكيدٍ لمناةٍ."}],"22":[{"w":"ضِيزَىٰٓ","m":"جائِرةٌ."}],"23":[{"w":"سُلۡطَٰنٍ","m":"حُجَّةٍ."},{"w":"وَمَا تَهۡوَى ٱلۡأَنفُسُ","m":"تَشْتَهِيهِ وتَمِيلُ إِلَيهِ."}],"24":[{"w":"تَمَنَّىٰ","m":"اشْتَهَى."}],"26":[{"w":"وَكَم مِّن مَّلَكٖ","m":"وَكَثِيرٍ مِنَ الملائِكَةِ."}],"27":[{"w":"تَسۡمِيَةَ ٱلۡأُنثَىٰ","m":"صِفَةَ الأُنْثَى، وهي أَن يُقَالَ لَها: بِنْتٌ."}],"28":[{"w":"ٱلظَّنَّ","m":"التَّوهُّمَ الباطِلَ."},{"w":"لَا يُغۡنِي","m":"لا يُجدِي ولا يَقُومُ مَقَامَ الحَقِّ."}],"30":[{"w":"مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِ","m":"مُنْتَهى عِلْمِهِم، لَا عِلْمَ لَهُم فَوْقَهُ؛ والمرادُ ظَنُّهُم الفاسِدُ."}],"31":[{"w":"بِٱلۡحُسۡنَى","m":"بالجنَّةِ."}],"32":[{"w":"ٱللَّمَمَ","m":"الذُّنُوبَ الصِّغارَ الَّتِي لا يُصِرُّ صاحِبُها عَلَيها، أو يُلِمُّ بِها على وَجْهِ النُّدْرَةِ."},{"w":"أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ","m":"خَلَقَ أباكُم آدمَ مِن تُرابٍ."},{"w":"فَلَا تُزَكُّوٓاْ أَنفُسَكُمۡ","m":"فَتَمْدَحُوها بالتَّقْوَى."}],"33":[{"w":"تَوَلَّىٰ","m":"أَعْرَضَ عَن طَاعَةِ اللهِ."}],"34":[{"w":"وَأَكۡدَىٰٓ","m":"تَوَقَّفَ عَنِ العَطاءِ."}],"36":[{"w":"صُحُفِ مُوسَىٰ","m":"هي أسْفارُ التَّوراةِ."}],"37":[{"w":"وَإِبۡرَٰهِيمَ","m":"وصُحُفِ إبراهِيمَ التي سُجِّل فيها ما أَوْحَى اللهُ إليهِ."},{"w":"وَفَّىٰٓ","m":"بَلَّغَ ما أُرْسِلَ بِه."}],"38":[{"w":"أَلَّا تَزِرُ","m":"أي لَا تَحْمِلُ وَلَا تُؤَاخَذُ."},{"w":"وَازِرَةٞ","m":"حاملةُ إِثْمٍ."}],"39":[{"w":"لَيۡسَ لِلۡإِنسَٰنِ إِلَّا مَا سَعَىٰ","m":"لا يَحْصُلُ للإنسانِ مِنَ الأجْرِ إلَّا ما كَسَبَ هُوَ لِنَفْسِهِ بِسَعْيِهِ."}],"40":[{"w":"سَعۡيَهُۥ","m":"عَمَلَه واكْتِسَابَه."},{"w":"يُرَىٰ","m":"يُشاهَدُ عِنْدَ الحسابِ."}],"41":[{"w":"يُجۡزَىٰهُ","m":"يُجزَى الإنسانُ عَلَى سَعْيِهِ."},{"w":"ٱلۡأَوۡفَىٰ","m":"التامَّ الكامِلَ."}],"42":[{"w":"ٱلۡمُنتَهَىٰ","m":"انْتِهَاءَ جَمِيعِ خَلْقِهِ وَرُجُوعَهُم إلى حُكْمِهِ في الآخِرةِ."}],"43":[{"w":"أَضۡحَكَ وَأَبۡكَىٰ","m":"خَلَقَ في الإنْسانِ قُوَّتَي الضَّحِكِ والبُكَاءِ، وأَسْبَابَهُما مِن سُرورٍ وحُزْنٍ."}],"44":[{"w":"أَمَاتَ وَأَحۡيَا","m":"انْفَرَدَ بالإِماتَةِ والإحْياءِ."}],"46":[{"w":"نُطۡفَةٍ","m":"ماءٍ قَلِيلٍ."},{"w":"تُمۡنَىٰ","m":"تُصَبُّ في الرَّحِمِ وتُقْذَفُ."}],"47":[{"w":"ٱلنَّشۡأَةَ","m":"الْخَلقَ."},{"w":"ٱلۡأُخۡرَىٰ","m":"الأخِيرَةَ الَّتِي لا نَشْأَةَ بَعْدَها."}],"48":[{"w":"وَأَقۡنَىٰ","m":"أرضَى الَّذِي أَغْناهُ."}],"49":[{"w":"ٱلشِّعۡرَىٰ","m":"نَجْمٍ مُضِيءٍ، كانَ يَعْبُدُهُ بَعْضُ أَهْل الجاهِلِيَّةِ."}],"50":[{"w":"عَادًا ٱلۡأُولَىٰ","m":"قَوْمَ نَبِيِّ اللهِ هُودٍ عَلَيهِ السَّلامُ، وهي أَوَّلُ العرَبِ البائِدةِ."}],"51":[{"w":"وَثَمُودَاْ","m":"قَوْمَ نَبِيِّ اللهِ صَالِحٍ عَلَيهِ السَّلامُ."},{"w":"فَمَآ أَبۡقَىٰ","m":"فَما تَرَكَها، بَلْ أَهْلَكَها."}],"52":[{"w":"وَأَطۡغَىٰ","m":"أَشَدَّ طُغْياناً وَتَمَرُّداً على اللهِ."}],"53":[{"w":"وَٱلۡمُؤۡتَفِكَةَ","m":"هي القُرَى المَخْسُوفُ بِها، المقلوبُ أعلاها أسفلها، وهي قُرى قَوْمِ لُوطٍ عَلَيهِ السَّلامُ."},{"w":"أَهۡوَىٰ","m":"أَسْقَطَ، فَجَعَلَها هَاوِيَةً."}],"54":[{"w":"فَغَشَّىٰهَا مَا غَشَّىٰ","m":"فَأَلْبَسَها ما أَلْبَسَها مِنَ الحِجارَةِ المُتَتَابِعَةِ النَّازِلَةِ عَلَيهِم."}],"55":[{"w":"ءَالَآءِ","m":"نِعَمِ، جَمْعُ إِلًى."},{"w":"تَتَمَارَىٰ","m":"تَتَشَكَّكُ."}],"56":[{"w":"هَٰذَا","m":"الَّذِي أَنْذَرْتُكُم بِهِ مِنَ الوقائِعِ."},{"w":"نَذِيرٞ","m":"إنْذَارٌ."},{"w":"مِنَ ٱلنُّذُرِ ٱلۡأُولَىٰٓ","m":"الَّتي أَنْذَرْتُها الأُمَمَ الَّتي قَبْلَكُم."}],"57":[{"w":"أَزِفَتِ","m":"قَرُبَتْ."},{"w":"ٱلۡأٓزِفَةُ","m":"القِيامَةُ."}],"58":[{"w":"لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ","m":"لَا يَعْلَمُ بوَقْتِ وُقُوعِها إِلَّا اللهُ."}],"59":[{"w":"هَٰذَا ٱلۡحَدِيثِ","m":"القرآنِ."},{"w":"تَعۡجَبُونَ","m":"مِنْ أَن يَكُونَ صَحِيحاً."}],"60":[{"w":"وَتَضۡحَكُونَ","m":"مِنْهُ سُخْرِيَةً واسْتِهْزَاءً."},{"w":"وَلَا تَبۡكُونَ","m":"خَوْفاً مِن وَعِيدِهِ."}],"61":[{"w":"سَٰمِدُونَ","m":"لاهُونَ مُعْرِضُونَ عَنْهُ."}]}