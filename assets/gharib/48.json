{"1":[{"w":"فَتَحۡنَا لَكَ","m":"قَضَينا لَكَ."},{"w":"مُبِينٗا","m":"عَظِيماً."}],"2":[{"w":"صِرَٰطٗا","m":"طَرِيقاً."}],"4":[{"w":"ٱلسَّكِينَةَ","m":"الطُّمأنِينَةَ."}],"6":[{"w":"ظَنَّ ٱلسَّوۡءِ","m":"الظَّنَّ السَّيِّئَ."},{"w":"دَآئِرَةُ ٱلسَّوۡءِ","m":"الشِّدَّةُ المُحِيطَةُ الَّتِي تسُوءُهُم."},{"w":"وَلَعَنَهُمۡ","m":"وَطَردَهُمْ مِن رحْمَتِهِ."}],"9":[{"w":"وَتُعَزِّرُوهُ","m":"وَتَنْصُروا الله بِنصْرِ دِينِهِ."},{"w":"وَتُوَقِّرُوهُ","m":"وَتُعَظِّمُوا اللهَ."},{"w":"بُكۡرَةٗ","m":"أوَّلَ النَّهارِ."},{"w":"وَأَصِيلًا","m":"آخِرَ النَّهارِ."}],"10":[{"w":"يُبَايِعُونَكَ","m":"يُعاهِدُونَكَ على الطَّاعةِ."},{"w":"نَكَثَ","m":"نَقَضَ بَيْعَتَهُ."},{"w":"يَنكُثُ عَلَىٰ نَفۡسِهِۦ","m":"يَعُودُ وبالُ ذلِكَ عَلَى نَفْسِهِ."}],"11":[{"w":"ٱلۡمُخَلَّفُونَ","m":"الَّذِينَ تَخَلَّفُوا عَنِ الخُروجِ مَعَكَ إلى مكَّةَ."}],"12":[{"w":"يَنقَلِبَ","m":"يَرْجِعَ."},{"w":"بُورٗا","m":"هَلْكَى."}],"13":[{"w":"أَعۡتَدۡنَا","m":"أَعْدَدْنا."},{"w":"سَعِيرٗا","m":"ناراً مُؤَجَّجَةً."}],"15":[{"w":"مَغَانِمَ","m":"غَنائِمِ خَيبَرَ."},{"w":"ذَرُونَا","m":"اتْرُكُونا."},{"w":"كَلَٰمَ ٱللَّهِ","m":"وَعْدَهُ لَكُم بِغنائِمِ خَيبَرَ، واخْتِصاصِها بِمَن شَهِدَ الحُدَيبِيَةَ."}],"16":[{"w":"أُوْلِي بَأۡسٖ","m":"أَصْحابِ قُوَّةٍ."},{"w":"وَإِن تَتَوَلَّوۡاْ","m":"تُعْرِضُوا."}],"17":[{"w":"حَرَجٞ","m":"إِثْمٌ في تَخَلُّفِهِ عَنِ الجِهادِ."}],"18":[{"w":"يُبَايِعُونَكَ","m":"يُعاهِدُونَكَ عَلَى الطَّاعِة والنُّصْرَةِ."},{"w":"ٱلسَّكِينَةَ","m":"الطُّمأنِينةَ."},{"w":"وَأَثَٰبَهُمۡ","m":"جازَاهُم."},{"w":"فَتۡحٗا قَرِيبٗا","m":"هو فَتْحُ «خَيْبَرَ»."}],"20":[{"w":"هَٰذِهِۦ","m":"أَيْ: غَنائِمَ خَيبرَ."},{"w":"وَكَفَّ","m":"وَمَنَعَ."}],"21":[{"w":"وَأُخۡرَىٰ","m":"وَعَدَكُم رَبُّكُم فَتْحَ بَلْدَةٍ أُخْرَى، وهي مكَّةُ."}],"23":[{"w":"سُنَّةَ ٱللَّهِ","m":"سَنَّ اللهُ ذَلِكَ سُنَّةً، أي: جَعَلَهُ عَادَةً لَهُ يَنْصُرُ المؤمِنينَ إذا نَصَرُوا دِينَهُ."}],"24":[{"w":"بِبَطۡنِ مَكَّةَ","m":"الحُدَيبِيَةِ."},{"w":"أَظۡفَرَكُمۡ عَلَيۡهِمۡ","m":"أيَّدكُم عَلَيهِم، وَمَكَّنَكُم مِن رِقابِهِم."}],"25":[{"w":"وَٱلۡهَدۡيَ","m":"ما يُهْدَى إلى الكَعْبَةِ مِنَ الأنْعامِ، أي: حَبَسُوا الهَدْيَ."},{"w":"مَعۡكُوفًا","m":"مَحْبُوساً."},{"w":"مَحِلَّهُۥ","m":"مَكَانَ حِلِّ نَحْرِه؛ وهو الحَرَمُ."},{"w":"تَطَـُٔوهُمۡ","m":"تُهْلِكُوهُم."},{"w":"مَعَرَّةُۢ","m":"إِثْمٌ وَعَيبٌ وَغَرامَةُ دِيَةٍ."},{"w":"لَوۡ تَزَيَّلُواْ","m":"لو تَمَيَّزُوا وفارَقُوا."}],"26":[{"w":"جَعَلَ","m":"وَضَعَ."},{"w":"ٱلۡحَمِيَّةَ","m":"الأَنفَةَ الَّتِي لَا مُوجِبَ لَها."},{"w":"حَمِيَّةَ ٱلۡجَٰهِلِيَّةِ","m":"الحَمِيّةَ المنْسُوبةَ إلى الجاهِليَّةِ لحَقارَتِها وَشَناعَتِها."},{"w":"سَكِينَتَهُۥ","m":"الثَّباتَ والطُّمأنِينَةَ."},{"w":"وَأَلۡزَمَهُمۡ","m":"جَعَلَها لازِمةً لَهُم لا يُفارِقُونَها."},{"w":"كَلِمَةَ ٱلتَّقۡوَىٰ","m":"قولَ: لَا إلَه إلَّا اللهُ."}],"27":[{"w":"صَدَقَ ٱللَّهُ رَسُولَهُ ٱلرُّءۡيَا","m":"صَدَّقَ اللهُ رَسُولَهُ في الرُّؤيا."},{"w":"فَتۡحٗا قَرِيبًا","m":"هو فَتْحُ خَيبرَ."}],"28":[{"w":"بِٱلۡهُدَىٰ","m":"بِالبَيانِ الواضِحِ."},{"w":"وَدِينِ ٱلۡحَقِّ","m":"دِينِ الإسْلامِ."},{"w":"لِيُظۡهِرَهُۥ","m":"ليُعْلِيَهُ ويُشَرِّفَهُ."},{"w":"شَهِيدٗا","m":"شاهِداً."}],"29":[{"w":"سِيمَاهُمۡ","m":"عَلَامةُ طاعَتِهِم للهِ."},{"w":"مِنۡ أَثَرِ ٱلسُّجُودِ","m":"نُورٍ وَسَمْتٍ حَسَنٍ."},{"w":"مَثَلُهُمۡ","m":"صِفَتُهُم وَحالَتُهُم العجِيبَةُ."},{"w":"شَطۡـَٔهُۥ","m":"فُرُوعَهُ وَفِرَاخَهُ."},{"w":"فَـَٔازَرَهُۥ","m":"فَقَوَّى الفَرْعُ أصْلَهُ."},{"w":"فَٱسۡتَغۡلَظَ","m":"غَلُظَ غِلَظاً شَدِيداً في نَوعِهِ."},{"w":"سُوقِهِۦ","m":"جَمعُ ساقٍ؛ وهو الأصْلُ الَّذِي تَخرُجُ فِيهِ السَّنابلُ والأغْصانُ."}]}