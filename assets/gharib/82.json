{"1":[{"w":"ٱنفَطَرَتۡ","m":"انْشَقَّتْ، واخْتَلَّ نِظامُها."}],"2":[{"w":"ٱنتَثَرَتۡ","m":"تَساقَطَتْ."}],"3":[{"w":"فُجِّرَتۡ","m":"فَجَّرَ اللهُ بَعْضَها في بَعْضٍ، فَمَلأَ جَمِيعَها."}],"4":[{"w":"بُعۡثِرَتۡ","m":"قُلِبتْ بِبَعْثِ مَن كانَ فِيها."}],"5":[{"w":"نَفۡسٞ","m":"كلُّ نَفْسٍ."},{"w":"مَا قَدَّمَتۡ وَأَخَّرَتۡ","m":"ما تَقَدَّمَ مِنْ أَعْمالِها وَمَا تَأَخَّرَ."}],"6":[{"w":"ٱلۡإِنسَٰنُ","m":"المنْكِرُ لِلْبَعْثِ."},{"w":"مَا غَرَّكَ بِرَبِّكَ","m":"ما الَّذِي خَدَعَكَ حتَّى كَفَرْتَ بِرَبِّكَ؟"},{"w":"ٱلۡكَرِيمِ","m":"الجَوَادِ الكَثِيرِ الخيرِ."}],"7":[{"w":"فَسَوَّىٰكَ","m":"فَجَعَلَكَ قَوِيماً سَلِيماً."},{"w":"فَعَدَلَكَ","m":"فَجَعَلَكَ مُسْتَقِيمَ القامَةِ مُتَناسِبَ الأجْزَاءِ."}],"8":[{"w":"مَا شَآءَ رَكَّبَكَ","m":"رَكَّبكَ التَّرْكِيبَ الَّذِي شاءَهُ."}],"9":[{"w":"كَلَّا","m":"لَيسَ الأمرُ كَما تَقُولُونَ."},{"w":"بِٱلدِّينِ","m":"بِيومِ الِحسابِ."}],"10":[{"w":"لَحَٰفِظِينَ","m":"لمَلائِكَةً رُقَبَاءَ."}],"11":[{"w":"كِرَامٗا","m":"على اللهِ."},{"w":"كَٰتِبِينَ","m":"لِمَا وُكِّلُوا بإحْصائِهِ."}],"13":[{"w":"ٱلۡأَبۡرَارَ","m":"القائِمينَ بِحُقُوقِ اللهِ وَحُقُوقِ عِبادِهِ."},{"w":"نَعِيمٖ","m":"التَّنَعُّمِ الدَّائِم في الجنَّةِ."}],"14":[{"w":"ٱلۡفُجَّارَ","m":"الَّذِينَ قَصَّرُوا في حُقُوقِ اللهِ وحُقُوقِ عِبادِهِ."}],"15":[{"w":"يَصۡلَوۡنَهَا","m":"يُصِيبُهُم لَهَبُهَا."},{"w":"يَوۡمَ ٱلدِّينِ","m":"يوم الجزاءِ."}],"16":[{"w":"عَنۡهَا","m":"عذابِ جَهَنَّمَ."},{"w":"بِغَآئِبِينَ","m":"لا بِخُرُوج وَلَا بِمَوتٍ."}],"17":[{"w":"وَمَآ أَدۡرَىٰكَ","m":"وَما أَعْلَمَكَ؟"},{"w":"مَا يَوۡمُ ٱلدِّينِ","m":"ما عَظَمَةُ يَومِ الحِسابِ."}],"19":[{"w":"لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗا","m":"لَا يَقْدِرُ أَحدٌ على نَفْعِ أَحَدٍ."}]}