{"2":[{"w":"تَحِلَّةَ أَيۡمَٰنِكُمۡ","m":"تَحْلِيلَ قَسَمِكُم بأَدَاءِ الكَفَّارَةِ عَنْها، وهي إِطْعامُ عَشَرَةِ مَساكِينَ، أَوْ كِسْوتُهُم، أو تَحْرِيرُ رَقَبَةٍ، فَمَن لَمْ يَجِدْ فَصِيامُ ثَلاثَةِ أيَّامٍ."},{"w":"مَوۡلَىٰكُمۡ","m":"ناصِرُكُم، ومُتَوَلّي أُمُورِكُم."}],"3":[{"w":"وَأَظۡهَرَهُ ٱللَّهُ عَلَيۡهِ","m":"وَأَطْلَعَهُ اللهُ عَلَى إِفْشائِها سِرَّهُ."},{"w":"عَرَّفَ بَعۡضَهُۥ","m":"أَعْلَمَ حَفْصَةَ بَعْضَ ما أَخْبرَتْ بِهِ."}],"4":[{"w":"صَغَتۡ","m":"مَالَتْ."},{"w":"وَإِن تَظَٰهَرَا عَلَيۡهِ","m":"وَإِن تَعاوَنا عَلَيهِ بِما يَسُوءُهُ."},{"w":"مَوۡلَىٰهُ","m":"وَليُّهُ وناصِرُهُ."},{"w":"ظَهِيرٌ","m":"أَعْوانٌ لَهُ عَلَى مَن يُعادُونَهُ."}],"5":[{"w":"مُسۡلِمَٰتٖ","m":"خاضِعاتٍ للهِ بالطَّاعةِ."},{"w":"قَٰنِتَٰتٖ","m":"مُطِيعاتٍ للهِ."},{"w":"سَٰٓئِحَٰتٖ","m":"صائِماتٍ."}],"6":[{"w":"قُوٓاْ","m":"احْفَظُوا."},{"w":"لَا يَعۡصُونَ","m":"لا يخالِفُونَ."}],"7":[{"w":"لَا تَعۡتَذِرُواْ","m":"لَا تلْتَمِسُوا الأَعْذارَ."}],"8":[{"w":"تُوبُوٓاْ","m":"ارْجِعُوا عَن ذُنُوبِكُم."},{"w":"تَوۡبَةٗ نَّصُوحًا","m":"رُجُوعاً لا مَعْصِيَةَ بَعْدَهُ."},{"w":"عَسَىٰ رَبُّكُمۡ","m":"يَتَحَقَّقُ رَجاؤُكُم بِوَعْدِ ربِّكُم."},{"w":"يُكَفِّرَ","m":"يَمْحُوَ."},{"w":"مِن تَحۡتِهَا","m":"من تَحْتِ قُصُورِها وأَشْجارِها."},{"w":"لَا يُخۡزِي","m":"لا يُلْحِقُ بِهِم هَوَاناً وذُلّاً بِسَبَبِ العَذابِ، بَلْ يُعْلي شَأْنَهُم."},{"w":"يَسۡعَىٰ","m":"يسِيرُ."},{"w":"بَيۡنَ أَيۡدِيهِمۡ","m":"أَمامَهُم."},{"w":"أَتۡمِمۡ","m":"أَدِمْ، أو زِدْ."}],"9":[{"w":"وَٱغۡلُظۡ عَلَيۡهِمۡ","m":"واسْتَعْمِلْ مَعَهُم الشِّدَّةَ في جِهادِهِم."},{"w":"وَمَأۡوَىٰهُمۡ","m":"وَمَسْكَنُهُم الَّذِي يصيرُونَ إِلَيهِ في الآخِرَةِ."},{"w":"وَبِئۡسَ ٱلۡمَصِيرُ","m":"وقَبُحَ ذَلِكَ المَرْجِعُ الَّذِي يَرْجِعُونَ إلَيهِ."}],"10":[{"w":"فَخَانَتَاهُمَا","m":"أي: في الدِّين بالكُفْرِ."},{"w":"فَلَمۡ يُغۡنِيَا","m":"فَلَمْ يَدْفَعَا."}],"12":[{"w":"أَحۡصَنَتۡ","m":"حَفِظَتْ."},{"w":"فَنَفَخۡنَا","m":"أَمَرْنا جِبْرِيلَ أَن يَنْفُخَ في جَيْبِ قَمِيصِها."},{"w":"ٱلۡقَٰنِتِينَ","m":"المُطِيعِينَ للهِ."}]}