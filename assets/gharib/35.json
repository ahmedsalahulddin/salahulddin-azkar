{"1":[{"w":"فَاطِرِ","m":"مُبْدِعٍ عَلى غَيرِ مِثالٍ سَبَقَ."},{"w":"أُوْلِيٓ أَجۡنِحَةٖ","m":"أَصْحابَ أجْنِحَةٍ."}],"2":[{"w":"مَا يَفۡتَحِ","m":"أي: ما يُرسِلْ ويُعْطِ."},{"w":"رَحۡمَةٖ","m":"نِعْمَةٍ."},{"w":"مُمۡسِكَ","m":"مانِعَ."},{"w":"مُرۡسِلَ","m":"مُعْطِيَ."}],"3":[{"w":"فَأَنَّىٰ تُؤۡفَكُونَ","m":"فَكَيفَ تُصْرَفُونَ عَن تَوحِيدِهِ؟."}],"5":[{"w":"وَعۡدَ ٱللَّهِ","m":"أي: بالبعْثِ والثَّوَابِ والعِقابِ."},{"w":"حَقّٞ","m":"ثابِتٌ وكائِنٌ لا محالةَ."},{"w":"فَلَا تَغُرَّنَّكُمُ","m":"فَلَا تَخْدَعَنَّكُم."},{"w":"ٱلۡغَرُورُ","m":"الشَّيطانُ."}],"6":[{"w":"حِزۡبَهُۥ","m":"أي: أَتْبَاعَهُ."},{"w":"ٱلسَّعِيرِ","m":"النَّارِ الموقَدَةِ."}],"7":[{"w":"أَجۡرٞ كَبِيرٌ","m":"وهو الجنَّةُ."}],"8":[{"w":"زُيِّنَ لَهُۥ","m":"أي: حَسَّنَ له الشَّيطانُ."},{"w":"سُوٓءُ عَمَلِهِۦ","m":"عَمَلُه السَّيِّئُ والقبيحُ."},{"w":"فَلَا تَذۡهَبۡ نَفۡسُكَ عَلَيۡهِمۡ حَسَرَٰتٍ","m":"فلا تُهْلِكْ نفسَك حُزْناً على كُفْرِهِم."}],"9":[{"w":"فَتُثِيرُ","m":"فَتُحَرِّكُ."},{"w":"مَيِّتٖ","m":"جَدْب."},{"w":"بَعۡدَ مَوۡتِهَا","m":"بَعْدَ يُبْسِها وَجَفافِها."},{"w":"ٱلنُّشُورُ","m":"بَعْثُ الموتى مِن قُبُورِهِم للجزاءِ."}],"10":[{"w":"يَصۡعَدُ","m":"يَرْتَقِي."},{"w":"ٱلۡكَلِمُ ٱلطَّيِّبُ","m":"الكلامُ الطَّيِّبُ مِن ذِكْرٍ ودُعاءٍ وتِلَاوَةٍ."},{"w":"يَرۡفَعُهُۥ","m":"أي: يَرفَعُه اللهُ إلَيهِ ويَقْبَلُه."},{"w":"يَمۡكُرُونَ ٱلسَّيِّـَٔاتِ","m":"أي: يَمْكُرُونَ المكَراتِ السَّيِّئاتِ، وهي مَذْكُورةٌ في قوله تعالى:"},{"w":"وَإِذۡ يَمۡكُرُ بِكَ ٱلَّذِينَ كَفَرُواْ لِيُثۡبِتُوكَ أَوۡ يَقۡتُلُوكَ أَوۡ يُخۡرِجُوكَ","m":"[الأنفال: 30]."},{"w":"يَبُورُ","m":"يَفسُدُ وَيَبْطُلُ."}],"11":[{"w":"مِن نُّطۡفَةٖ","m":"هي مَنِيُّ الرجلِ يَقْذِفُه في رَحِمِ امْرَأَتِه."},{"w":"أَزۡوَٰجٗا","m":"ذُكُوراً وإناثاً تَزَوَّجَ بعضُهم بَعْضاً."},{"w":"لَا تَضَعُ","m":"لاتَلِدُ."},{"w":"مُعَمَّرٖ","m":"طَوِيلِ العُمُرِ."}],"12":[{"w":"فُرَاتٞ","m":"حُلْوٌ شَدِيدُ الحَلَاوَةِ."},{"w":"سَآئِغٞ شَرَابُهُۥ","m":"سَهْلٌ مُرُورُهُ في الْحَلْقِ."},{"w":"أُجَاجٞ","m":"شَدِيدُ المُلوحَةِ."},{"w":"لَحۡمٗا طَرِيّٗا","m":"هو السَّمَكُ."},{"w":"حِلۡيَةٗ","m":"هي اللُّؤلُؤُ والمَرْجانُ."},{"w":"ٱلۡفُلۡكَ","m":"السُّفُنَ."},{"w":"مَوَاخِرَ","m":"جوارِيَ تَشُقُّ الماءَ شَقّاً."},{"w":"لِتَبۡتَغُواْ","m":"لِتَطْلُبُوا."}],"13":[{"w":"يُولِجُ","m":"يُدخِلُ."},{"w":"لِأَجَلٖ مُّسَمّٗى","m":"لِوقْتٍ مَعْلُومٍ."},{"w":"قِطۡمِيرٍ","m":"القِشْرَةِ الرَّقيقَةِ على نَوَاةِ التَّمْرَةِ."}],"14":[{"w":"وَلَا يُنَبِّئُكَ","m":"وَلَا يُخْبِرُكَ."}],"15":[{"w":"ٱلۡفُقَرَآءُ","m":"المحْتاجُونَ."}],"17":[{"w":"بِعَزِيزٖ","m":"بمُمْتَنِعٍ."}],"18":[{"w":"وَلَا تَزِرُ","m":"لَا تَحْمِلُ."},{"w":"وَازِرَةٞ","m":"أي: نفسٌ مُذْنِبَةٌ."},{"w":"مُثۡقَلَةٌ","m":"أي: نَفْسٌ أَثْقَلَتْها الذُّنوبُ."},{"w":"حِمۡلِهَا","m":"ذُنُوبِها التي أَثْقَلَتْها."},{"w":"يَخۡشَوۡنَ","m":"يخافُونَ."},{"w":"تَزَكَّىٰ","m":"تَطَهَّرَ مِنَ الشِّرْكِ والمعاصِي."},{"w":"ٱلۡمَصِيرُ","m":"المرْجِعُ."}],"19":[{"w":"ٱلۡأَعۡمَىٰ","m":"مَن فَقَدَ بَصَرَه، والمُرادُ بِه هُنا الكافِرُ؛ لأنَّهُ عَمِيَ عَن دِينِ الحقِّ."}],"21":[{"w":"ٱلۡحَرُورُ","m":"الرِّيحُ الحارَّةُ."}],"23":[{"w":"نَذِيرٌ","m":"رَسُولٌ مُنْذِرٌ مِنْ عَذَابِ اللهِ."}],"24":[{"w":"بَشِيرٗا وَنَذِيرٗا","m":"بَشِيراً لِأَهْلِ الطَّاعةِ ونَذِيراً لِأَهْلِ المعْصِيةِ."},{"w":"نَذِيرٞ","m":"نَبِيٌّ مُنْذِرٌ مِنْ عَذَابِ اللهِ."}],"25":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالمعْجِزاتِ الواضِحةِ."},{"w":"وَبِٱلزُّبُرِ","m":"بالكُتُبِ التي فيها مَوَاعِظُ."},{"w":"وَبِٱلۡكِتَٰبِ ٱلۡمُنِيرِ","m":"الكُتُبِ الَّتي أنارَتْ طَرِيقَ الشَّرْعِ والهِدَايَةِ، ومِنْها القرآنُ الكريمُ."}],"27":[{"w":"جُدَدُۢ","m":"جَمْعُ جُدَّةٍ، وهي الطَّرِيقَةُ والخِطَّةُ في الشَّيءِ تكونُ واضِحةً فِيهِ."},{"w":"وَغَرَابِيبُ","m":"جمع غِرْبِيبٍ، وهو شَديدُ السَّوادِ يُشْبِهُ لَونُه لَونَ الغُرابِ."}],"29":[{"w":"لَن تَبُورَ","m":"لَن تَكْسُدَ، ولَن تَهْلِكَ."}],"32":[{"w":"ٱلَّذِينَ ٱصۡطَفَيۡنَا","m":"الَّذِينَ اخْتَرْناهُم."},{"w":"ظَالِمٞ لِّنَفۡسِهِۦ","m":"أي: بِأن وَقَعَ في بَعْضِ المعاصِي."},{"w":"مُقۡتَصِدٞ","m":"أي: بِأَدَاءِ الواجِباتِ واجْتِنابِ المُحَرَّماتِ."},{"w":"سَابِقُۢ بِٱلۡخَيۡرَٰتِ","m":"أي: مُسارعٌ مُجْتَهِدٌ في الأعْمالِ الصَّالحةِ فَرْضِها ونَفْلِها."}],"33":[{"w":"يُحَلَّوۡنَ","m":"يُزيَّنُونَ بالحِلْيةِ."},{"w":"أَسَاوِرَ","m":"مُفْرَدُه سِوارٌ: وهو ما يُلْبَسُ في اليدِ مِنَ الحُلِيِّ ويُحِيطُ بالمِعْصَمِ."},{"w":"حَرِيرٞ","m":"ثِيابٌ رَقِيقَةٌ."}],"34":[{"w":"ٱلۡحَزَنَ","m":"أي: كُلَّ ما يُحْزِنُ ويَغُمُّ."}],"35":[{"w":"أَحَلَّنَا","m":"أنزَلَنا."},{"w":"دَارَ ٱلۡمُقَامَةِ","m":"دَارَ الإقامةِ الدَّائمةِ، وهي الجنَّةُ."},{"w":"نَصَبٞ","m":"تَعَبٌ ومَشَقَّةٌ."},{"w":"لُغُوبٞ","m":"إعياءٌ مِنَ التَّعَبِ وفُتُورٌ."}],"36":[{"w":"لَا يُقۡضَىٰ عَلَيۡهِمۡ","m":"أي: بالموتِ."},{"w":"كَفُورٖ","m":"مُتَمادٍ في الكُفْرِ مُصِرٍّ عليه."}],"37":[{"w":"يَصۡطَرِخُونَ","m":"يَصْرُخُونَ بِشِدَّةٍ مُسْتَغِيثِينَ."},{"w":"مَا يَتَذَكَّرُ فِيهِ مَن تَذَكَّرَ","m":"أي: مِثْلُه كافٍ للاتِّعاظِ لِمَنْ أَرَادَ أن يَتَّعِظَ."},{"w":"ٱلنَّذِيرُ","m":"وهو الرَّسولُ ﷺ."}],"39":[{"w":"خَلَٰٓئِفَ","m":"يَخْلُفُ بَعْضُكُم بَعْضاً."},{"w":"مَقۡتٗا","m":"بُغْضاً وغَضَباً."},{"w":"خَسَارٗا","m":"هَلَاكاً وخُسْرَاناً."}],"40":[{"w":"أَرَءَيۡتُمۡ شُرَكَآءَكُمُ","m":"أَخْبِرُونِي عَن شُركائِكُم."},{"w":"ءَاتَيۡنَٰهُمۡ","m":"أَعْطَيناهُم."},{"w":"غُرُورًا","m":"خِدَاعاً."}],"42":[{"w":"جَهۡدَ أَيۡمَٰنِهِمۡ","m":"مُجْتَهِدِينَ فِيها بالحَلِفِ بأغْلَظِها."},{"w":"نُفُورًا","m":"بُعْداً عَنِ الحقِّ وفِرَاراً مِنْه."}],"43":[{"w":"لَا يَحِيقُ","m":"لا يُحِيطُ ولا يَنْزِلُ."},{"w":"ٱلۡمَكۡرُ ٱلسَّيِّئُ","m":"أي: وبالُ مَكْرِهِم السَّيِّئِ."},{"w":"سُنَّتَ ٱلۡأَوَّلِينَ","m":"طَرِيقَةَ اللهِ فِيهِم وعادَتَهُ بِتَعْذِيبِهِم لِتكْذِيبِهِم."}],"44":[{"w":"لِيُعۡجِزَهُۥ","m":"لِيَفُوتَه."}],"45":[{"w":"يُؤَاخِذُ","m":"يُعاقِبُ."},{"w":"يُؤَخِّرُهُمۡ","m":"يُمْهِلُهُم."}]}