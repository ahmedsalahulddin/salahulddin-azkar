{"1":[{"w":"عِوَجَا","m":"اختِلافاً، ولا اختِلالاً فِي ألفاظِه، ولا فِي معانيه."}],"2":[{"w":"قَيِّمٗا","m":"مستقيماً معتدلاً، لا إفراطَ فيه ولا تفريطَ."},{"w":"بَأۡسٗا شَدِيدٗا","m":"عقوبةً عاجلةً في الدنيا، وآجِلَةً في الآخرةِ."},{"w":"أَجۡرًا حَسَنٗا","m":"ثواباً جزيلاً، هو الجنةُ."}],"5":[{"w":"كَبُرَتۡ","m":"عَظُمَتْ في الشَّناعَةِ والقُبْحِ."}],"6":[{"w":"بَٰخِعٞ نَّفۡسَكَ","m":"مُهْلِكُها ومُجْهِدُها."},{"w":"عَلَىٰٓ ءَاثَٰرِهِمۡ","m":"بعدَ تَوَلِّي قومِك عنك."},{"w":"ٱلۡحَدِيثِ","m":"القرآنِ."},{"w":"أَسَفًا","m":"حُزْناً وغَضَباً؛ لحِرْصِك على إيمانهم."}],"7":[{"w":"لِنَبۡلُوَهُمۡ","m":"لِنَخْتَبِرَهم."}],"8":[{"w":"صَعِيدٗا","m":"تُراباً."},{"w":"جُرُزًا","m":"لا نباتَ فيه."}],"9":[{"w":"ٱلۡكَهۡفِ","m":"النَّقْبِ المتَّسِعِ في الجبل، وهو أكبرُ من المغارة."},{"w":"وَٱلرَّقِيمِ","m":"اللَّوْحِ الذي كُتِبَتْ فيه أسماءُ أهلِ الكهفِ."}],"10":[{"w":"أَوَى ٱلۡفِتۡيَةُ إِلَى ٱلۡكَهۡفِ","m":"لجَؤُوا إليه؛ لعبادةِ اللهِ، وفِراراً بدِينهم."},{"w":"وَهَيِّئۡ","m":"يَسِّرْ."},{"w":"رَشَدٗا","m":"اهتداءً إلى الحق، وسَداداً في العمل."}],"11":[{"w":"فَضَرَبۡنَا عَلَىٰٓ ءَاذَانِهِمۡ","m":"أَنَمْناهم نوماً عميقاً؛ بحيث لا يَسْمعون."}],"12":[{"w":"بَعَثۡنَٰهُمۡ","m":"أيقَظْناهم مِنْ نومِهم."},{"w":"ٱلۡحِزۡبَيۡنِ","m":"الفريقَين المختلفَين في مُدَّةِ بقائِهم في الكهفِ."},{"w":"أَمَدٗا","m":"غايةً ومُدَّة."}],"14":[{"w":"وَرَبَطۡنَا عَلَىٰ قُلُوبِهِمۡ","m":"قَوَّيْناها بالصَّبْرِ والتثبيتِ على الحقِّ."},{"w":"شَطَطًا","m":"قولاً بعيداً مجانِباً للحقِّ."}],"15":[{"w":"لَوۡلَا","m":"هَلَّا."},{"w":"بِسُلۡطَٰنِۭ بَيِّنٖ","m":"دليلٍ واضحٍ."},{"w":"ٱفۡتَرَىٰ","m":"اختَلَقَ."},{"w":"كَذِبٗا","m":"بنسبةِ الشريكِ إلى اللهِ تعالى."}],"16":[{"w":"ٱعۡتَزَلۡتُمُوهُمۡ","m":"فارَقْتُم قومَكم؛ فِراراً بدِينِكم."},{"w":"فَأۡوُۥٓاْ","m":"الجَؤُوا."},{"w":"يَنشُرۡ","m":"يَبْسُطْ ويُوَسِّعْ."},{"w":"وَيُهَيِّئۡ","m":"يُيَسِّرْ."},{"w":"مِرۡفَقٗا","m":"ما تنتفعون به من أسبابِ العيشِ."}],"17":[{"w":"تَزَٰوَرُ","m":"تميلُ."},{"w":"ذَاتَ ٱلۡيَمِينِ","m":"جهةَ يمينِ الكهفِ."},{"w":"تَقۡرِضُهُمۡ","m":"تَتْرُكُهم وتتجاوَزُهم."},{"w":"فَجۡوَةٖ مِّنۡهُ","m":"مُتَّسَعٍ من الكهفِ وفَضائِه، فلا يتأَذَّون من جَوِّه، أو من حرارةِ الشمس، ويأتيهم الهواءُ النافعُ."},{"w":"ءَايَٰتِ ٱللَّهِ","m":"دلائلِ قُدرتِه."},{"w":"يَهۡدِ ٱللَّهُ","m":"يوفِّقه."},{"w":"وَلِيّٗا","m":"مُعِيناً وناصِراً."}],"18":[{"w":"رُقُودٞ","m":"نِيامٌ."},{"w":"بِٱلۡوَصِيدِ","m":"بفِناءِ الكَهْفِ، كأنه يَحْرُسُهم."},{"w":"رُعۡبٗا","m":"خَوفاً وفَزَعاً."}],"19":[{"w":"وَكَذَٰلِكَ","m":"وكما أَنَمْناهم وحَفِظْناهم مدةً طويلة."},{"w":"بَعَثۡنَٰهُمۡ","m":"أَيْقَظْناهم من نومِهم كما كانوا."},{"w":"بِوَرِقِكُمۡ","m":"بنقُودِكم الفِضِّيَّةِ."},{"w":"أَيُّهَآ","m":"أيُّ أهلِ المدينةِ."},{"w":"أَزۡكَىٰ طَعَامٗا","m":"أَحَلُّ وأطيبُ."},{"w":"وَلۡيَتَلَطَّفۡ","m":"وليتكلَّفِ اللُّطْفَ والرِّفْقَ في المعاملةِ، حتى لا ينكشِفَ أمرُنا."}],"20":[{"w":"يَظۡهَرُواْ عَلَيۡكُمۡ","m":"يَطَّلِعُوا على مكانِكم ويَعْلَمُوا به."},{"w":"يَرۡجُمُوكُمۡ","m":"يَقْتُلوكم بالرَّجْمِ بالحجارةِ."},{"w":"مِلَّتِهِمۡ","m":"دينِهم الباطلِ."}],"21":[{"w":"وَكَذَٰلِكَ","m":"وكما أَنَمْناهم السنينَ الطِّوالَ، ثم أيْقَظْناهم بعدَها."},{"w":"أَعۡثَرۡنَا عَلَيۡهِمۡ","m":"أطْلَعْنا عليهم أهلَ زمانِهم."},{"w":"وَعۡدَ ٱللَّهِ","m":"بالبعثِ."},{"w":"أَمۡرَهُمۡ","m":"في أمرِ القِيامةِ، فمِنْ مُقِرٍّ لها وجاحِدٍ، أو في أمْرِ الفِتْيَةِ المؤمنين وما اطَّلعوا عليه مِنْ أحوالِهم."},{"w":"ٱلَّذِينَ غَلَبُواْ عَلَىٰٓ أَمۡرِهِمۡ","m":"أصحابُ الكلمةِ والنفوذِ."}],"22":[{"w":"رَجۡمَۢا بِٱلۡغَيۡبِ","m":"قولاً بلا عِلْمٍ ولا اطِّلاعٍ."},{"w":"بِعِدَّتِهِم","m":"بعَدَدِهم."},{"w":"فَلَا تُمَارِ فِيهِمۡ","m":"فلا تجادِلْ في شأنِ أصحابِ الكهفِ وعَدَدِهم أحداً من الخائضين فيه."},{"w":"إِلَّا مِرَآءٗ ظَٰهِرٗا","m":"إلا جِدالاً واضحاً بذِكْرِ ما قَصَصْنا عليك مِنْ شأنِهم دونَ زيادةٍ."}],"24":[{"w":"وَٱذۡكُر رَّبَّكَ","m":"بقولِ: إنْ شاء الله."},{"w":"يَهۡدِيَنِ","m":"يُوَفِّقَني."},{"w":"مِنۡ هَٰذَا","m":"من قصةِ أصحابِ الكهفِ في الدِّلالةِ على نُبُوَّتي."},{"w":"رَشَدٗا","m":"هدايةً ودَلالة للناسِ على ذلك."}],"25":[{"w":"وَلَبِثُواْ فِي كَهۡفِهِمۡ","m":"ومَكَثَ الفِتْيانُ فيه نِياماً."}],"26":[{"w":"أَبۡصِرۡ بِهِۦ وَأَسۡمِعۡ","m":"ما أبصَرَ اللهَ وأسمَعَه بكلِّ موجودٍ، فهو لا يَغِيبُ عنه شيء."},{"w":"مَا لَهُم","m":"ليس للخَلْقِ."},{"w":"وَلِيّٖ","m":"مُعينٍ وناصرٍ."},{"w":"حُكۡمِهِۦٓ","m":"قَضائِه وتشريعِه."}],"27":[{"w":"مُلۡتَحَدٗا","m":"مَلْجَأً ومَلاذاً."}],"28":[{"w":"وَٱصۡبِرۡ نَفۡسَكَ","m":"احبِسْها في طاعةِ اللهِ."},{"w":"بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ","m":"أولِ النهار وآخرِه، والمرادُ دوامُ العبادةِ."},{"w":"وَلَا تَعۡدُ عَيۡنَاكَ عَنۡهُمۡ","m":"لا تَصْرِفْ نَظَرَكَ عنهم إلى غيرِهِم."},{"w":"أَغۡفَلۡنَا قَلۡبَهُۥ","m":"جَعَلْناه غافلاً."},{"w":"فُرُطٗا","m":"ضَياعاً وهَلاكاً، ومُتَجاوِزاً فيه الاعتدالَ."}],"29":[{"w":"ٱلۡحَقُّ","m":"ما جئتكُم به هو الحقُّ."},{"w":"فَمَن شَآءَ فَلۡيُؤۡمِن وَمَن شَآءَ فَلۡيَكۡفُرۡ","m":"تهديدٌ ووعيدٌ لمن اختارَ الكفرَ بعد بيانِ الحقِّ ووُضوحِه."},{"w":"سُرَادِقُهَا","m":"سُوْرُها المحيطُ بها."},{"w":"كَٱلۡمُهۡلِ","m":"ماءٌ غليظٌ كالمُنْصَهِر من المعادنِ، أو كعَكَرِ الزيتِ، بَلَغَ منتهى الحَرارةِ."},{"w":"مُرۡتَفَقًا","m":"منزِلاً ومُقاماً."}],"31":[{"w":"جَنَّٰتُ عَدۡنٖ","m":"جِنانُ إقامةٍ دائمةٍ."},{"w":"يُحَلَّوۡنَ","m":"يُزَيَّنُون."},{"w":"سُندُسٖ","m":"رقيقِ الحَريرِ."},{"w":"وَإِسۡتَبۡرَقٖ","m":"ما غَلُظَ من الحريرِ وثَخُنَ."},{"w":"ٱلۡأَرَآئِكِ","m":"الأَسِرَّةِ المزيَّنَةِ بفاخِرِ السَّتائرِ."}],"32":[{"w":"وَٱضۡرِبۡ لَهُم","m":"واذكُرْ للمؤمنين والكافرين المستكبرِين وأَوْرِدْ لهم."},{"w":"جَنَّتَيۡنِ","m":"حديقتَين."},{"w":"وَحَفَفۡنَٰهُمَا بِنَخۡلٖ","m":"جَعَلْنا النَّخْلَ محيطاً بكلٍّ منهما."}],"33":[{"w":"ءَاتَتۡ أُكُلَهَا","m":"أثمرَتْ ثمرَها الذي يُؤْكَلُ."},{"w":"وَلَمۡ تَظۡلِم مِّنۡهُ","m":"ولم تَنْقُصْ من إثمارها عَبْرَ السنينَ."}],"34":[{"w":"لَهُۥ ثَمَرٞ","m":"لصاحبِ البستانينِ أنواعٌ من المال سِوَىٰ حديقتَيه."},{"w":"نَفَرٗا","m":"أولاداً وخَدَماً وأعواناً."}],"35":[{"w":"ظَالِمٞ لِّنَفۡسِهِۦ","m":"كافرٌ بالبعثِ، مُعْجَبٌ بمالِه."},{"w":"تَبِيدَ","m":"تَهْلِكَ وتَفْنَى."}],"36":[{"w":"قَآئِمَةٗ","m":"كائنةً وواقعةً."},{"w":"مُنقَلَبٗا","m":"مَرْجِعاً وعاقبةً."}],"38":[{"w":"لَٰكِنَّا۠","m":"لكنْ أنا أقولُ."}],"39":[{"w":"وَلَوۡلَآ","m":"وهَلَّا."}],"40":[{"w":"حُسۡبَانٗا","m":"جَمْعُ حُسْبانَةٍ، وهو العذابُ كالصَّواعِقِ."},{"w":"صَعِيدٗا","m":"أرضاً أو تراباً."},{"w":"زَلَقًا","m":"لا نَباتَ فيها، ومَلْساءُ لا تَثْبُتُ عليها قَدَمٌ، والمرادُ أنها عَدِيمةُ النَّفْعِ."}],"41":[{"w":"غَوۡرٗا","m":"غائِراً ذاهباً في أسفلِ الأرضِ."}],"42":[{"w":"وَأُحِيطَ بِثَمَرِهِۦ","m":"وأُهلِكَتْ أموالُ الكافرِ بما فيها حديقتاه، كما تَوَقَّعَ المؤمنُ."},{"w":"يُقَلِّبُ كَفَّيۡهِ","m":"دَلالةً على نَدَمِه وأَسَفِه وحَسْرَتِه."},{"w":"خَاوِيَةٌ عَلَىٰ عُرُوشِهَا","m":"متهدِّمةٌ سَقَطَ بعضُها على بعضٍ، خاليةٌ مما كان فيها."}],"43":[{"w":"فِئَةٞ","m":"جماعةٌ ممَّنِ افتَخَرَ بهم."},{"w":"وَمَا كَانَ مُنتَصِرًا","m":"ما كان ممتنعاً بنفسِه وقوَّتِه عندَ انتقامِ اللهِ منه."}],"44":[{"w":"هُنَالِكَ","m":"في مثلِ هذه الشَّدائدِ، أو يومِ القيامةِ."},{"w":"ٱلۡوَلَٰيَةُ لِلَّهِ","m":"النُّصْرَةُ للهِ وحدَه لا يَقْدِرُ عليها غيرُه."},{"w":"عُقۡبٗا","m":"عاقبةً لمَنْ تَوَلَّاهم."}],"45":[{"w":"وَٱضۡرِبۡ لَهُم","m":"اذكُرْ للناسِ وأَوْرِدْ."},{"w":"مَثَلَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","m":"صِفَتَها في زينتِها، وتَقَلُّبها وسُرْعَة زوالِها."},{"w":"هَشِيمٗا","m":"يابساً مُتَكَسِّراً، بعد خُضْرَتِه ونَضارَتِه."},{"w":"تَذۡرُوهُ ٱلرِّيَٰحُ","m":"تُذْهِبُه وتُفَرِّقُه إلى كلِّ جهةٍ."},{"w":"مُقۡتَدِرًا","m":"كاملَ القُدْرةِ على كلِّ شيءٍ."}],"46":[{"w":"زِينَةُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","m":"فيهما جَمالٌ ونَفْعٌ وقوَّةٌ."},{"w":"وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ","m":"الأعمالُ الصالحةُ بما فيها: التسبيحُ، والتحميدُ، والتكبيرُ، والتهليلُ."},{"w":"أَمَلٗا","m":"ما كان يأمُلُه صاحبُها في الدُّنيا عندَ اللهِ في الآخِرة."}],"47":[{"w":"نُسَيِّرُ ٱلۡجِبَالَ","m":"نُزِيلُها عن أماكنِها، ونُسَيِّرها في الجوِّ كالسَّحابِ."},{"w":"بَارِزَةٗ","m":"ظاهرةً للأَعْيُنِ لا يَسْتُرها شيءٌ."},{"w":"وَحَشَرۡنَٰهُمۡ","m":"جَمَعْنا الأوَّلِين والآخِرين لموقفِ الحسابِ."},{"w":"نُغَادِرۡ","m":"نَتْرُكْ."}],"48":[{"w":"صَفّٗا","m":"مُصْطَفِّين جميعاً، لا يَغِيبُ أحدٌ منهم."},{"w":"كَمَا خَلَقۡنَٰكُمۡ أَوَّلَ مَرَّةِۭ","m":"مِثْلَ خَلْقِنا الأولِ لكم: فُرادى، حُفاةَ الأقدامِ، عُراةَ الأجسامِ، غيرَ مَخْتُونين."},{"w":"بَلۡ زَعَمۡتُمۡ","m":"يا مُنْكِري البَعْثِ."},{"w":"مَوۡعِدٗا","m":"لبَعْثِكم ومُجازاتِكم على أعمالِكم."}],"49":[{"w":"ٱلۡكِتَٰبُ","m":"صحائفُ أعمالِ العبادِ."},{"w":"مُشۡفِقِينَ","m":"خائفين."},{"w":"يَٰوَيۡلَتَنَا","m":"يا هَلاكَنا، نداءٌ منهم على أنفسِهم بالخُسْرانِ والهَلاكِ."},{"w":"لَا يُغَادِرُ","m":"لا يَتْرُك."},{"w":"أَحۡصَىٰهَا","m":"عَدَّها وأثْبتَها."}],"50":[{"w":"ٱسۡجُدُواْ لِأٓدَمَ","m":"تحيةً وإكراماً له وإظهاراً لفَضْلِه، لاعبادةً."},{"w":"فَفَسَقَ عَنۡ أَمۡرِ رَبِّهِۦٓ","m":"خَرَجَ عن طاعةِ ربِّه بتَرْكِ السُّجودِ؛ تَكَبُّراً."},{"w":"أَوۡلِيَآءَ","m":"أعواناً."}],"51":[{"w":"مَآ أَشۡهَدتُّهُمۡ","m":"أي: إبليسَ وذريتَه."},{"w":"عَضُدٗا","m":"أعواناً وأنصاراً في شأنٍ من شؤوني."}],"52":[{"w":"فَدَعَوۡهُمۡ","m":"استغاثُوا بهم."},{"w":"مَوۡبِقٗا","m":"مَهْلِكاً في جَهَنَّمَ يَهْلِكُون فيه."}],"53":[{"w":"فَظَنُّوٓاْ","m":"أيقَنوا."},{"w":"مُوَاقِعُوهَا","m":"واقِعُونَ فيها وداخِلُوها."},{"w":"مَصۡرِفٗا","m":"مكاناً يَنْصَرِفُون ويَلْجَؤُون إليه."}],"54":[{"w":"صَرَّفۡنَا","m":"بَيَّنَّا ونوَّعْنا بأساليبَ مختلفةٍ."},{"w":"كُلِّ مَثَلٖ","m":"كلِّ معنى يَحْصُلُ الاتِّعاظُ به."},{"w":"جَدَلٗا","m":"خُصومةً في الباطل."}],"55":[{"w":"سُنَّةُ ٱلۡأَوَّلِينَ","m":"سُنَّةُ اللهِ في إهلاكِ السابقين بالاستئصال."},{"w":"قُبُلٗا","m":"صُنوفاً وأنواعاً، أو مُوَاجَهَةً ومقابَلَةً."}],"56":[{"w":"لِيُدۡحِضُواْ بِهِ","m":"ليُزِيلُوا بجِدالِهم وباطِلِهم."},{"w":"هُزُوٗا","m":"استهزاءً وسُخْريَةً."}],"57":[{"w":"أَكِنَّةً","m":"أغطيةً مانعةً."},{"w":"أَن يَفۡقَهُوهُ","m":"لِئلَّا يَفْهَمُوا القرآنَ؛ عُقوبةً لهم."},{"w":"وَقۡرٗا","m":"ثِقَلاً في السَّمعِ."}],"58":[{"w":"مَوۡعِدٞ","m":"أي: مُقَدَّرٌ لعذابهِم."}],"59":[{"w":"وَتِلۡكَ ٱلۡقُرَىٰٓ","m":"مِنَ الأممِ السابقةِ."},{"w":"لِمَهۡلِكِهِم","m":"لهَلاكِهم."}],"60":[{"w":"لِفَتَىٰهُ","m":"تلميذِه وخادِمِه يُوشَعَ ابنِ نونٍ."},{"w":"لَآ أَبۡرَحُ","m":"لا أزال أسِيرُ."},{"w":"مَجۡمَعَ ٱلۡبَحۡرَ