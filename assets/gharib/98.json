{"1":[{"w":"مُنفَكِّينَ","m":"تاركِينَ كُفْرَهُم."},{"w":"ٱلۡبَيِّنَةُ","m":"العَلامةُ الَّتِي وُعِدُوا بِها في الكُتُبِ السَّابِقَةِ."}],"2":[{"w":"صُحُفٗا","m":"قُرآناً في صُحُفٍ."}],"3":[{"w":"كُتُبٞ قَيِّمَةٞ","m":"أَخْبارٌ صادِقَةٌ، تهدِي إلى الحقِّ."}],"4":[{"w":"جَآءَتۡهُمُ ٱلۡبَيِّنَةُ","m":"تَبيَّنُوا أَنَّه النَّبِيُّ الَّذِي وُعِدُوا بِهِ."}],"5":[{"w":"مُخۡلِصِينَ لَهُ ٱلدِّينَ","m":"قاصِدِينَ بِعِبادَتِهِم وَجْهَهُ."},{"w":"حُنَفَآءَ","m":"مائِلِينَ عَنِ الشِّركِ إلى الإيمانِ."},{"w":"دِينُ ٱلۡقَيِّمَةِ","m":"دِينُ الاسْتِقامةِ، وهو الإسلامُ."}],"6":[{"w":"شَرُّ","m":"أَشَدُّ شَرّاً."}],"7":[{"w":"ٱلۡبَرِيَّةِ","m":"الخَلْقِ."}],"8":[{"w":"جَنَّٰتُ عَدۡنٖ","m":"جَنَّاتُ إقامَةٍ واسْتِقرارٍ في مُنْتَهى الحُسْنِ."},{"w":"مِن تَحۡتِهَا","m":"مِن تَحْتِ قُصُورِها وأشجارِها."},{"w":"خَشِيَ رَبَّهُۥ","m":"خَافَ اللهَ واجْتَنَبَ مَعاصيَهُ."}]}