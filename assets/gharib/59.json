{"1":[{"w":"سَبَّحَ","m":"نَزَّهَ."}],"2":[{"w":"ٱلَّذِينَ كَفَرُواْ","m":"هُم بنُو النَّضِيرِ مِنَ اليهُودِ."},{"w":"دِيَٰرِهِمۡ","m":"مَساكِنِهِم الَّتِي جَاوَرُوا بِها المسْلِمِينَ حَوْلَ «المدينةِ»."},{"w":"لِأَوَّلِ ٱلۡحَشۡرِ","m":"عِنْدَ أَوَّلِ جَمْعِهِم لِلْخُرُوجِ مِن جَزِيرةِ العَرَبِ."},{"w":"مَانِعَتُهُمۡ","m":"تَدْفَعُ عَنْهُم."},{"w":"فَأَتَىٰهُمُ ٱللَّهُ","m":"فَجَاءَهُم أَمْرُ اللهِ."},{"w":"مِنۡ حَيۡثُ لَمۡ يَحۡتَسِبُواْ","m":"مِن مَكانٍ لم يَظُنُّوهُ."},{"w":"وَقَذَفَ","m":"وَجَعَل."},{"w":"ٱلرُّعۡبَ","m":"الخَوْفَ والفَزَعَ الشَّدِيدَ."},{"w":"فَٱعۡتَبِرُواْ","m":"فاتَّعِظُوا."},{"w":"يَٰٓأُوْلِي ٱلۡأَبۡصَٰرِ","m":"يا أَصْحابَ البَصائِر السَّلِيمَةِ، والعُقُولِ الرَّاجِحَةِ."}],"3":[{"w":"ٱلۡجَلَآءَ","m":"الخُرُوجَ مِنَ الوطنِ بِنِيَّةِ عَدَمِ العَوْدِ."}],"4":[{"w":"شَآقُّواْ","m":"خالفُوا."}],"5":[{"w":"لِينَةٍ","m":"نَخْلَةٍ ذَاتِ ثَمَرٍ طَيِّبٍ."},{"w":"أُصُولِهَا","m":"قَواعِدِها، والمرادُ: سُوقُ النَّخْلِ."},{"w":"وَلِيُخۡزِيَ","m":"ولِيُهِينَ."},{"w":"ٱلۡفَٰسِقِينَ","m":"الكَافِرِينَ، وَهُمْ يَهُودُ بَنِي النَّضِيرِ."}],"6":[{"w":"وَمَآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ","m":"وما أَعطاهُ اللهُ لِرَسُولِه مما يَظْفَرُ بِهِ الجيشُ مِن عَدُوِّهِم."},{"w":"فَمَآ أَوۡجَفۡتُمۡ","m":"فَمَا أَرْكَضْتُم للإِغارَةِ، وَأَوْجَفَهُ: حَمَلَهُ عَلَى السَّيرِ السَّرِيعِ."},{"w":"رِكَابٖ","m":"الإِبِلِ الَّتِي تُرْكَبُ."}],"7":[{"w":"ٱلۡقُرَىٰ","m":"قُرىً فُتِحَتْ في عَهْدِ الرَّسُولِ ﷺ."},{"w":"فَلِلَّهِ وَلِلرَّسُولِ","m":"أي يُصْرَفُ في مصالِحِ المسْلِمِينَ."},{"w":"وَلِذِي ٱلۡقُرۡبَىٰ","m":"وَلِذِي قَرَابَةِ رَسُولِ اللهِ ﷺ، وهم بنُو هاشِم، وبنُو المطَّلِبِ."},{"w":"وَٱلۡيَتَٰمَىٰ","m":"الأَطْفَالِ الَّذِين ماتَ آباؤُهم، وهم دُونَ سِنِّ البُلُوغِ."},{"w":"وَٱلۡمَسَٰكِينِ","m":"هم أهلُ الحاجةِ الَّذِينَ لا يَمْلِكُونَ ما يَسُدُّ حاجَتَهَم."},{"w":"وَٱبۡنِ ٱلسَّبِيلِ","m":"هو الغريبُ المسافِر الَّذِي نَفِدَتْ نَفَقَتُهُ."},{"w":"دُولَةَۢ بَيۡنَ ٱلۡأَغۡنِيَآءِ","m":"مُداوَلَةً يَتَدَاولُه الأَغْنِياءُ ويتعاقَبُونَ في التَّصَرُّفِ فِيهِ."}],"9":[{"w":"تَبَوَّءُو","m":"اسْتَوطَنُوا وَتَمَكَّنُوا."},{"w":"ٱلدَّارَ","m":"المدِينَةَ، وهي دارُ الهِجْرَةِ."},{"w":"حَاجَةٗ","m":"حَسَداً."},{"w":"مِمَّآ أُوتُواْ","m":"مِمَّا أُعْطِي المهاجِرُونَ من فَيْءِ بَنِي النَّضِيرِ."},{"w":"وَيُؤۡثِرُونَ عَلَىٰٓ أَنفُسِهِمۡ","m":"وَيُقَدِّمُونَ غيرَهُم مِنَ المهاجِرِينَ وَذَوِي الحاجةِ عَلَى أَنْفُسِهِم."},{"w":"خَصَاصَةٞ","m":"شِدَّةُ احْتِياجٍ."},{"w":"وَمَن يُوقَ","m":"وَمَن سَلَّمَهُ اللهُ فمُنِعَ."},{"w":"شُحَّ نَفۡسِهِۦ","m":"بُخْلَها مَعَ حِرْصِها."},{"w":"ٱلۡمُفۡلِحُونَ","m":"الفائِزُونَ بِمَطْلُوبِهِم."}],"10":[{"w":"غِلّٗا","m":"حَسَداً وحِقْدَاً."}],"11":[{"w":"ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ","m":"هم بَنُو النَّضِيرِ."},{"w":"وَلَا نُطِيعُ فِيكُمۡ","m":"أي: في ضُرِّكُم."}],"12":[{"w":"وَلَئِن نَّصَرُوهُمۡ","m":"وَلئِنْ أَرادُوا نُصْرَتَهُم."},{"w":"ثُمَّ لَا يُنصَرُونَ","m":"أي: لا يَغْلِبُونَ."}],"13":[{"w":"رَهۡبَةٗ","m":"خَوْفاً."}],"14":[{"w":"مُحَصَّنَةٍ","m":"ممنُوعَةٍ بأسْوَارٍ أو خَنادِقَ مِمَّن يُرِيدُ أَخْذَها."},{"w":"جُدُرِۭ","m":"حِيْطانٍ."},{"w":"بَأۡسُهُم","m":"قوَّتُهُم."},{"w":"شَتَّىٰ","m":"مُتَفَرِّقَةٌ."}],"15":[{"w":"وَبَالَ أَمۡرِهِمۡ","m":"سُوءَ عاقِبَةِ كُفْرِهِم وَعَداوَتِهِم لِلرَّسُولِ ﷺ."}],"18":[{"w":"مَا قَدَّمَتۡ","m":"أي: مِنَ الأعْمالِ."},{"w":"لِغَدٖ","m":"يومِ القِيامةِ."}],"19":[{"w":"نَسُواْ ٱللَّهَ","m":"تَرَكُوا أَدَاءَ حَقِّ اللهِ الَّذِي أَوْجَبَهُ عَلَيهِم."},{"w":"فَأَنسَىٰهُمۡ أَنفُسَهُمۡ","m":"مِمَّا يُنَجِّيهِم مِن عَذابِ يَوْمِ القِيامةِ."},{"w":"ٱلۡفَٰسِقُونَ","m":"الخارجُونَ عَن طاعَةِ اللهِ وَرَسُولِهِ."}],"21":[{"w":"خَٰشِعٗا","m":"خاضِعاً مُتَذَلِّلاً."},{"w":"مُتَصَدِّعٗا","m":"مُتَشَقِّقاً."},{"w":"نَضۡرِبُهَا","m":"نُوَضِّحُها."}],"22":[{"w":"عَٰلِمُ ٱلۡغَيۡبِِ","m":"يَعْلَمُ ما غابَ عنكم وعن أبصاركم."},{"w":"وَٱلشَّهَٰدَةِ","m":"وَيَعْلَمُ ما تَرَوْنَهُ وتُشَاهِدونه."}],"23":[{"w":"ٱلۡمَلِكُ","m":"المالِكُ لجمِيعِ الأشْياءِ، المتَصَرِّفُ فِيها بِلَا مُمانَعَةٍ ولا مُدَافَعَةٍ."},{"w":"ٱلۡقُدُّوسُ","m":"الْمُنَزَّهُ عَن كُلِّ نَقْصٍ."},{"w":"ٱلسَّلَٰمُ","m":"الَّذِي سَلِمَ مِن كُلِّ عيبٍ."},{"w":"ٱلۡمُؤۡمِنُ","m":"المصَدِّقُ رُسُلَه وأنبياءَه بِما أَرْسَلَهُم بِهِ."},{"w":"ٱلۡمُهَيۡمِنُ","m":"الرَّقِيبُ على خَلْقِهِ في أعمالِهِم."},{"w":"ٱلۡعَزِيزُ","m":"الَّذِي لا يُغالَبُ."},{"w":"ٱلۡجَبَّارُ","m":"الَّذِي قَهَرَ جَميعَ العِبادِ، وأَذْعَنُوا لَهُ."},{"w":"ٱلۡمُتَكَبِّرُ","m":"الَّذِي له الكبرياءُ والعَظَمَةُ."},{"w":"سُبۡحَٰنَ ٱللَّهِ","m":"تنَزَّهَ اللهُ."}],"24":[{"w":"ٱلۡخَٰلِقُ","m":"المقَدِّرُ لِلْخَلْقِ."},{"w":"ٱلۡبَارِئُ","m":"المنْشِئُ لِلْخَلْقِ."},{"w":"ٱلۡمُصَوِّرُ","m":"صَوَّر خَلْقَهُ كَيفَ يَشَاءُ."},{"w":"ٱلۡعَزِيزُ","m":"الشَّدِيدُ الانتِقامِ مِنْ أعدائِهِ."},{"w":"ٱلۡحَكِيمُ","m":"في تَدْبِيرِه أُمُورَ خَلْقِه."}]}