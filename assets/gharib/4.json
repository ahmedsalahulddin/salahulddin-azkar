{"1":[{"w":"مِن نَّفۡسٖ وَٰحِدَةٖ","m":"هي آدَمُ."},{"w":"زَوۡجَهَا","m":"هي حَوَّاءُ، خُلِقَتْ من ضِلْعٍ من أضلاعِ آدمَ."},{"w":"وَبَثَّ مِنۡهُمَا","m":"نَشَر من آدمَ وحَواءَ."},{"w":"تَسَآءَلُونَ بِهِۦ","m":"يَسْألُ به بعضُكم بعضاً، فيقولُ السائلُ: أسألُك باللهِ."},{"w":"وَٱلۡأَرۡحَامَ","m":"واتقوا الأرحامَ أن تقطعُوها."}],"2":[{"w":"وَءَاتُواْ","m":"وأَعطُوا يا أوصياءَ اليتامى."},{"w":"ٱلۡيَتَٰمَىٰٓ","m":"هم مَنْ ماتَ آباؤهم وهم دونَ البلوغ. وإعطاؤُهم المالَ إذا وَصَلُوا سِنَّ البُلوغِ، وأصبح لديهم قُدْرَةٌ على حِفْظِ المالِ."},{"w":"وَلَا تَتَبَدَّلُواْ ٱلۡخَبِيثَ بِٱلطَّيِّبِ","m":"ولا تأخُذوا الجيِّدَ من أموالهِم، وتجعلُوا مكانَه الرديءَ من أموالِكم."},{"w":"وَلَا تَأۡكُلُوٓاْ أَمۡوَٰلَهُمۡ إِلَىٰٓ أَمۡوَٰلِكُمۡ","m":"ولا تَخْلِطُوا أموالَهم بأموالِكم، فتأكلُوها مع أموالِكم."},{"w":"حُوبٗا","m":"إثْماً وظُلماً."}],"3":[{"w":"تُقۡسِطُواْ","m":"تَعْدِلُوا."},{"w":"فِي ٱلۡيَتَٰمَىٰ","m":"في يَتامى النساءِ اللاتي تحتَ أيديكم بألَّا تُعْطُوهنَّ مهورَهنَّ كغيرِهنَّ، فلا تَنْكِحُوهن، وانكِحُوا غيرَهن."},{"w":"طَابَ","m":"حَلَّ."},{"w":"أَدۡنَىٰٓ أَلَّا تَعُولُواْ","m":"أقربُ إلى ألَّا تَجُوروا، ولا تَميلوا."}],"4":[{"w":"صَدُقَٰتِهِنَّ","m":"مُهورَهنَّ."},{"w":"نِحۡلَةٗ","m":"عَطِيةً واجبةً."},{"w":"شَيۡءٖ مِّنۡهُ","m":"شيءٍ من المَهْرِ، فوَهَبْنَه لكم."}],"5":[{"w":"ٱلسُّفَهَآءَ","m":"المضَيِّعين لمالِهِم بسوءِ تَدْبيرِهم."},{"w":"قِيَٰمٗا","m":"قِوامَكم في مَعايِشكم."}],"6":[{"w":"وَٱبۡتَلُواْ","m":"واختبِرُوهم لمعرفةِ قُدُراتِهم."},{"w":"بَلَغُواْ ٱلنِّكَاحَ","m":"وَصَلُوا إلى سِنِّ البلوغِ."},{"w":"ءَانَسۡتُم مِّنۡهُمۡ رُشۡدٗا","m":"عَلِمْتُمْ منهم صَلاحاً في العقلِ والدِّين."},{"w":"إِسۡرَافٗا","m":"بغيرِ ما أباحَه اللهُ لكم."},{"w":"وَبِدَارًا","m":"ومُبادرةً لأَكْلِها."},{"w":"أَن يَكۡبَرُواْ","m":"قبل أن يكبَرُوا فيأخُذُوها منكم."},{"w":"بِٱلۡمَعۡرُوفِ","m":"بقَدْرِ حاجتِه عند الضرورةِ."},{"w":"فَأَشۡهِدُواْ","m":"بأَنْ يَشْهَدَ شهودٌ معكم."},{"w":"حَسِيبٗا","m":"محاسِباً."}],"7":[{"w":"لِلرِّجَالِ","m":"للذُّكورِ من أولادِ الميتِ، صغاراً وكباراً."}],"8":[{"w":"أُوْلُواْ ٱلۡقُرۡبَىٰ","m":"ممَّن لا حَقَّ لهم في التَّرِكَةِ."},{"w":"فَٱرۡزُقُوهُم مِّنۡهُ","m":"على وجهِ الاستحبابِ."}],"9":[{"w":"فَلۡيَتَّقُواْ ٱللَّهَ","m":"في ذلك النهي عن الإجحافِ بالورثةِ الضعفاءِ، فلايزيدُ في وصيَّتِه لغيرِهم على الثلث، وكذلك إنْ تَرَكهم أغنياءَ حَسُنَ أن يُوصِيَ لغيرِهم."}],"10":[{"w":"سَعِيرٗا","m":"ناراً مُوقدةً."}],"11":[{"w":"لِلذَّكَرِ مِثۡلُ حَظِّ ٱلۡأُنثَيَيۡنِ","m":"لِلابْن مِن مال الميِّت مِثْلُ نَصِيب البِنْتَيْنِ إذا اجْتَمعَتا معه ولم يُوجَدْ صاحبُ فَرضٍ وارثٍ."},{"w":"فَلِأُمِّهِ ٱلثُّلُثُ","m":"ولأبيه الباقي."},{"w":"مِنۢ بَعۡدِ وَصِيَّةٖ","m":"هذه القِسْمَةُ للتَّرِكَةِ بعد إخراجِ وصيةِ الميتِ بما لايتجاوزُ الثلثَ."}],"12":[{"w":"لَهُنَّ وَلَدٞ","m":"ذكراً أو أنثى."},{"w":"مِنۢ بَعۡدِ وَصِيَّةٖ","m":"من بعدِ إنفاذِ وَصِيَّتِهنّ الجائزةِ."},{"w":"لَكُمۡ وَلَدٞ","m":"ذَكَراً أو أنثى، منهن، أو من غيرِهنّ."},{"w":"كَلَٰلَةً","m":"هو الميتُ الذي لا وَلَدَ له ولا والدَ."},{"w":"أَخٌ أَوۡ أُخۡتٞ","m":"من أُمّ."},{"w":"غَيۡرَ مُضَآرّٖ","m":"لا ضَرَرَ فيه على الوَرَثَةِ، فإنْ قَصَدَ صاحبُها الضَّرَرَ لوَرَثَتِه فهو باطلٌ لا يَنْفُذُ."}],"14":[{"w":"مُهِينٞ","m":"مُخْزٍ."}],"15":[{"w":"ٱلۡفَٰحِشَةَ","m":"الزِّنى."},{"w":"فَأَمۡسِكُوهُنَّ","m":"فاحبِسُوهُنَّ، وكان هذا قبل نَسْخِها."},{"w":"سَبِيلٗا","m":"مَخْرَجاً، والسبيلُ هو: الحُكْمُ بالرَّجْمِ للمُحْصَنِ والمحصَنةِ، والجلْدِ مئةَ جَلْدَةٍ، وتَغْريبِ عامٍ لغيرهما."}],"16":[{"w":"يَأۡتِيَٰنِهَا","m":"أي: فاحشةَ الزِّنى."},{"w":"فَـَٔاذُوهُمَا","m":"بالضَّرْبِ، والهَجْرِ والتوبيخِ، ثم نُسِخَ بالجلْدِ والرَّجْمِ."}],"17":[{"w":"عَلَى ٱللَّهِ","m":"فهو الذي يقبَلُها."},{"w":"بِجَهَٰلَةٖ","m":"بجَهْلٍ منهم لعاقِبَتِها، وإيجابِها لسَخَطِ اللهِ."}],"19":[{"w":"كَرۡهٗا","m":"أي: وهُنَّ كارهاتٌ لذلك، وكانوا في الجاهليَّةِ يجعلون نِساءَ الآباءِ والأقاربِ من التَّرِكَةِ، فيتزوَّجُون بهنَّ."},{"w":"وَلَا تَعۡضُلُوهُنَّ","m":"لا يَحِلُّ لكم أن تَحْبِسُوا زوجاتِكم عندَكم مع عَدَمِ رغبتِكم فيهن، وذلك لقَصْدِ أن يفتَدِينَ ببعضِ المهْرِ من الحبْسِ."},{"w":"بِفَٰحِشَةٖ مُّبَيِّنَةٖ","m":"بالزِّنى البيِّنِ، أو بذاءةِ اللسانِ، أو النُّشوزِ."}],"20":[{"w":"إِحۡدَىٰهُنَّ","m":"هي مَنْ تُريدون طَلاقَها."},{"w":"قِنطَارٗا","m":"مالاً كثيراً مَهْراً لها."},{"w":"بُهۡتَٰنٗا","m":"ظُلماً بغيرِ حَقّ."}],"21":[{"w":"أَفۡضَىٰ","m":"بالجِماعِ."},{"w":"مِيثَٰقًا غَلِيظٗا","m":"إمساكهُنَّ بمعروفٍ، أو تَسْرِيحهُنَّ بإحسانٍ."}],"22":[{"w":"سَلَفَ","m":"مضىٰ في الجاهلية، فلا مُؤاخَذَةَ فيه."},{"w":"وَمَقۡتٗا","m":"وبُغْضاً، أي: يُبْغِضُ اللهُ فاعلَه."}],"23":[{"w":"أُمَّهَٰتُكُمۡ","m":"ويَدْخُلُ فيه الجَدَّاتُ."},{"w":"وَبَنَاتُكُمۡ","m":"وَيشْمَلُ بناتِ الأولادِ."},{"w":"وَأَخَوَٰتُكُمۡ","m":"الشقيقاتُ، أو لأبٍ، أو لأمّ."},{"w":"وَأُمَّهَٰتُ نِسَآئِكُمۡ","m":"سواءٌ أدَخَلْتُمْ بنسائكم أم لا."},{"w":"وَرَبَٰٓئِبُكُمُ","m":"وبناتُ نسائِكم من غيرِكم، اللاتي يتربَّينَ في بيوتِكم، فإن لم يكونوا كذلك، ولم تَدْخُلوا بأمَّهاتِهن وطَلَّقْتموهن، أو مِتْنَ قبلَ الدُّخولِ، فلا جُناحَ عليكم أن تنكِحُوهنّ."},{"w":"وَحَلَٰٓئِلُ أَبۡنَآئِكُمُ","m":"زوجاتُ أبنائِكم ممَّن دَخَلَ الابنُ بها، أو لَم يدْخُلْ."}],"24":[{"w":"وَٱلۡمُحۡصَنَٰتُ","m":"يَحْرُمُ نِكاحُ ذَواتِ الأزواج غيرِ المَسْبِيَّات."},{"w":"مَا مَلَكَتۡ أَيۡمَٰنُكُمۡ","m":"مَنْ سَبَيْتم في الجهادِ، فيَحِلُّ النكاحُ بعد الاستِبْراءِ بحَيْضَةٍ، من غير طلاقِ زوجِها الحربيِّ لها."},{"w":"مَا وَرَآءَ ذَٰلِكُمۡ","m":"مِنْ سِواهنّ."},{"w":"مُحۡصِنِينَ","m":"أعِفَّاءَ."},{"w":"غَيۡرَ مُسَٰفِحِينَ","m":"غيرَ زانِين."},{"w":"أُجُورَهُنَّ","m":"مُهورَهُنَّ، وهذا في النِّكاحِ الشَّرْعيِّ."},{"w":"مِنۢ بَعۡدِ ٱلۡفَرِيضَةِ","m":"من زيادةٍ أو نقصانٍ في المهْرِ، فذلك سائغٌ عند التَّراضي."}],"25":[{"w":"طَوۡلًا","m":"قُدرةً وسَعَةً، وهو المَهْرُ لنِكاحِ الحَرائرِ."},{"w":"بَعۡضُكُم مِّنۢ بَعۡضٖ","m":"في النَّسَبِ والدِّينِ."},{"w":"بِإِذۡنِ أَهۡلِهِنَّ","m":"بموافقةِ سَيّدِهن؛ لأنَّ منافعَهنّ له."},{"w":"أَخۡدَانٖ","m":"ولا مُسِرَّاتٍ بالزِّنى باتخاذِ أصدقاءَ."},{"w":"فَعَلَيۡهِنَّ","m":"فعلى الإماءِ خمسون جَلْدَةً، ونَفْيُ ستةِ أشهرٍ، وليس على الإماءِ رَجْمٌ لأنه لايَتَنَصَّفُ."},{"w":"ذَٰلِكَ","m":"أي: ما أُبيحَ لكم من نِكاحِ الإماءِ."},{"w":"خَشِيَ ٱلۡعَنَتَ","m":"خاف الوقوعَ في الزِّنى والمشقَّةِ."},{"w":"وَأَن تَصۡبِرُواْ","m":"عن نكاحِ الإماء، مع العفَّةِ."}],"26":[{"w":"سُنَنَ","m":"طُرُقَ الأنبياءِ وأتباعِهم؛ لتَقْتَدُوا بها."}],"27":[{"w":"ٱلَّذِينَ يَتَّبِعُونَ ٱلشَّهَوَٰتِ","m":"الذين يَنْقادُون لشهَواتِ أنفسِهم من أهلِ الباطلِ."},{"w":"تَمِيلُواْ","m":"تَنْحَرفُوا عن الدِّينِ بإتيانِكم ما حَرَّمَ عليكم."}],"28":[{"w":"أَن يُخَفِّفَ","m":"أن يُيَسِّرَ عليكم."}],"29":[{"w":"بِٱلۡبَٰطِلِ","m":"كالرِّبا والقِمار."},{"w":"تِجَٰرَةً","m":"موافِقَةً للشَّرعِ."},{"w":"وَلَا تَقۡتُلُوٓاْ أَنفُسَكُمۡ","m":"بألَّا تُهْلِكُوها بارتكابِ المعاصي، وألَّا يقتلَ بعضُكم بعضاً، وألَّا يقتلَ نفسَه حقيقةً."}],"30":[{"w":"ذَٰلِكَ","m":"ما نهى اللهُ عنه مما تقدَّم."},{"w":"عُدۡوَٰنٗا","m":"متجاوِزاً حَدَّ الشَّرْعِ."}],"31":[{"w":"كَبَآئِرَ مَا تُنۡهَوۡنَ عَنۡهُ","m":"هي كلُّ ذَنْبٍ رَتَّبَ اللهُ عليه الحَدَّ، أو صَرَّح بالوعيدِ فيه."},{"w":"سَيِّـَٔاتِكُمۡ","m":"الصَّغائرَ."},{"w":"مُدۡخَلٗا كَرِيمٗا","m":"الجنةَ."}],"32":[{"w":"مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعۡضَكُمۡ عَلَىٰ بَعۡضٖ","m":"ما فَضَّل اللهُ به غيرَكم عليكم في المواهِبِ والأرزاقِ."},{"w":"نَصِيبٞ","m":"مقدارٌ من الجزاءِ بحسَبِ العملِ."},{"w":"مِن فَضۡلِهِۦٓ","m":"من عَوْنِه، وتوفيقِه."}],"33":[{"w":"وَلِكُلّٖ","m":"ولكلِّ واحدٍ."},{"w":"مَوَٰلِيَ","m":"وَرَثَةً يرثُون."},{"w":"عَقَدَتۡ أَيۡمَٰنُكُمۡ","m":"تحالَفْتُم معهم بالأيمانِ على النُّصرةِ، وإعطائِهم قَدْراً من الميراثِ، وهذا منسوخٌ."}],"34":[{"w":"قَوَّٰمُونَ","m":"أهلُ قيامٍ بمصالحهنَّ."},{"w":"بِمَا فَضَّلَ ٱللَّهُ","m":"بما خَصَّهم من القِوامةِ والتفضيلِ، كالإنفاقِ وكفايةِ المؤونةِ."},{"w":"قَٰنِتَٰتٌ","m":"مطيعاتٌ لله، قائماتٌ بحقوقِ الزوج."},{"w":"حَٰفِظَٰتٞ لِّلۡغَيۡبِ","m":"حافظاتٌ لما يَجبُ حِفْظُه عند غَيبةِ أزواجِهنَّ عنهن."},{"w":"بِمَا حَفِظَ ٱللَّهُ","m":"بحِفْظِ اللهِ، وتوفيقِه لهن."},{"w":"نُشُوزَهُنَّ","m":"استعلاءَهن على أزواجِهنَّ."},{"w":"فَعِظُوهُنَّ","m":"بالكلمةِ الطيبةِ، إن نفعَتْ."},{"w":"ٱلۡمَضَاجِعِ","m":"جَمْعُ مَضْجَع، وهو الفِراشُ، فلا تَقْرَبُوهنَّ، إنْ نَفَعَ ذلك."},{"w":"وَٱضۡرِبُوهُنَّ","m":"ضَرْباً غيرَ مُبَرِّحٍ أومؤثِّرٍ."},{"w":"فَلَا تَبۡغُواْ عَلَيۡهِنَّ سَبِيلًا","m":"فاحذَرُوا ظُلْمَهنَّ."}],"35":[{"w":"فَٱبۡعَثُواْ","m":"أي: إلى الزوجَيْن."},{"w":"حَكَمٗا","m":"عَدْلاً ممَّنْ يَصْلُحُ لذلك."},{"w":"بَيۡنَهُمَآ","m":"بينَ الزوجَين، أو الحكَمَين."}],"36":[{"w":"وَٱلۡيَتَٰمَىٰ","m":"الأولادِ الذين ماتَ آباؤُهم وهم دونَ البُلوغ."},{"w":"وَٱلۡمَسَٰكِينِ","m":"الذين لا يملِكُون ما يَكْفيهم."},{"w":"ٱلۡجُنُبِ","m":"البعيدِ."},{"w":"وَٱلصَّاحِبِ بِٱلۡجَنۢبِ","m":"الرفيقِ في السَّفَر والحَضَرِ."},{"w":"وَٱبۡنِ ٱلسَّبِيلِ","m":"المسافرِ المحتاجِ."},{"w":"وَمَا مَلَكَتۡ أَيۡمَٰنُكُمۡ","m":"الرقيقِ، ذكوراً وإناثاً."}],"37":[{"w":"وَأَعۡتَدۡنَا","m":"وأَعْدَدْنا."},{"w":"مُهِينٗا","m":"مُخْزِياً."}],"38":[{"w":"رِئَآءَ ٱلنَّاسِ","m":"من أجلِ الرِّياءِ والسُّمعةِ."},{"w":"قَرِينٗا","m":"مُلازِماً له، ويعملُ بطاعتِه."}],"39":[{"w":"وَمَاذَا عَلَيۡهِمۡ","m":"وأيُّ ضررٍ يَلْحقهم؟"}],"40":[{"w":"لَا يَظۡلِمُ مِثۡقَالَ ذَرَّةٖ","m":"لا يُنْقِصُ أحداً من جزاءِ عَمَلِه مقدارَ ذَرّة."}],"41":[{"w":"فَكَيۡفَ","m":"فكيف يكون حالُ الناسِ يومَ القيامةِ؟"},{"w":"بِكَ","m":"أيها الرسولُ."},{"w":"عَلَىٰ هَٰٓؤُلَآءِ","m":"على أمَّتِك."},{"w":"شَهِيدٗا","m":"شاهداً على الأمَّةِ بما عَمِلت."}],"42":[{"w":"تُسَوَّىٰ بِهِمُ ٱلۡأَرۡضُ","m":"يجعلهم الله والأرضَ سواءً، فيصيرون تراباً."},{"w":"وَلَا يَكۡتُمُونَ","m":"ولا يُخْفُون عن اللهِ شيئاً، وسوف تَشْهَدُ على عَمَلِهم جَوارحُهم."}],"43":[{"w":"وَأَنتُمۡ سُكَٰرَىٰ","m":"نَزَلَ هذا الحكمُ قبلَ تحريمِ الخمرِ."},{"w":"عَابِرِي سَبِيلٍ","m":"مَنْ كان مُجتازاً من باب المسجد، أو هو المسافر."},{"w":"لَٰمَسۡتُمُ","m":"جامَعْتُمْ."},{"w":"فَتَيَمَّمُواْ صَعِيدٗا طَيِّبٗا","m":"فاقصِدوا تراباً طاهراً."}],"44":[{"w":"نَصِيبٗا مِّنَ ٱلۡكِتَٰبِ","m":"حَظّاً من العِلْم بالتوراةِ."},{"w":"ٱلسَّبِيلَ","m":"الطريقَ المستقيمَ."}],"45":[{"w":"وَلِيّٗا","m":"يَتَوَلَّاكم."}],"46":[{"w":"هَادُواْ","m":"هم اليهودُ."},{"w":"يُحَرِّفُونَ ٱلۡكَلِمَ","m":"بتغييرِ اللفظِ أو المعنى أو هما جميعاً."},{"w":"غَيۡرَ مُسۡمَعٖ","m":"لا سَمِعْتَ، وهذا من قَبيلِ الاستهزاءِ."},{"w":"وَرَٰعِنَا","m":"افهَمْ عنا، وأفْهِمْنا."},{"w":"لَيَّۢا بِأَلۡسِنَتِهِمۡ","m":"يَلْوُون ألسنتَهم عن الحق."},{"w":"وَٱسۡمَعۡ","m":"بَدَل «غيرَ مُسْمَعٍ»."},{"w":"وَٱنظُرۡنَا","m":"انتظِرْنا نَفْهَمْ عنك، بَدَلَ «راعِنا»."},{"w":"وَأَقۡوَمَ","m":"وأصوبَ قولاً."},{"w":"لَعَنَهُمُ","m":"طَرَدَهم من رحمتِه."}],"47":[{"w":"لِمَا مَعَكُم","m":"من الكُتُبِ."},{"w":"أَن نَّطۡمِسَ وُجُوهٗا فَنَرُدَّهَا عَلَىٰٓ أَدۡبَارِهَآ","m":"نَمْحُوَ الوجوهَ، ونجعلَ أبصارَها في أدبارِ الوجوهِ."},{"w":"أَصۡحَٰبَ ٱلسَّبۡتِ","m":"هم اليهودُ الذين نُهُوا عن الصَّيدِ في يومِ السبت، فلم يَنْتَهُوا."},{"w":"مَفۡعُولًا","m":"كائناً لا محالةَ."}],"49":[{"w":"يُزَكُّونَ أَنفُسَهُم","m":"يُثْنُون على أَنْفُسِهم وأعْمَالِهم، وهم اليهودُ."}],"51":[{"w":"نَصِيبٗا","m":"حَظّاً."},{"w":"بِٱلۡجِبۡتِ وَٱلطَّٰغُوتِ","m":"هما كلُّ معبودٍ من دونِ اللهِ، أو مُطاعٍ في معصيته."}],"53":[{"w":"نَصِيبٞ","m":"حَظٌّ."},{"w":"فَإِذٗا لَّا يُؤۡتُونَ","m":"إن جُعِلَ لهم ذلك فإذَن لايُعْطُون، لشِدَّةِ بُخْلِهم."},{"w":"نَقِيرًا","m":"النُّقطةَ في ظَهْر النَّواةِ، أو وسَطِها."}],"54":[{"w":"ٱلنَّاسَ","m":"محمداً ﷺ وأصحابَه."},{"w":"فَضۡلِهِۦ","m":"النبوَّةِ، والنصْرِ."},{"w":"فَقَدۡ ءَاتَيۡنَآ ءَالَ إِبۡرَٰهِيمَ","m":"فكيف لا يَحْسُدون آلَ إبراهيمَ، واليهودُ يعترفون به؟ فما آتينا محمداً ﷺ ليس ببِدْعٍ حتى يُحْسَدَ عليه."},{"w":"ٱلۡحِكۡمَةَ","m":"ما أُوحِي إليهم من غيرِ الكتابِ."},{"w":"مُلۡكًا عَظِيمٗا","m":"مُلْكَ سليمانَ."}],"55":[{"w":"سَعِيرًا","m":"ناراً تُوقَدُ عليهم."}],"56":[{"w":"نَضِجَتۡ","m":"احترقَتْ."}],"57":[{"w":"مُطَهَّرَةٞ","m":"من كلِّ دَنَسٍ يكونُ في نساءِ أهلِ الدُّنيا."},{"w":"ظَلِيلًا","m":"كثيفاً ممتدّاً."}],"58":[{"w":"نِعِمَّا","m":"نِعْمَ الشيءُ."}],"59":[{"w":"وَأُوْلِي ٱلۡأَمۡرِ","m":"الأئمةَ، ومَنْ وَلَّاه المسلمون، ما لم يَكُنْ في طاعتِهم معصيةٌ."},{"w":"فَرُدُّوهُ","m":"أرْجِعُوا الحُكْمَ فيه."},{"w":"تَأۡوِيلًا","m":"عاقبةً ومَرْجِعاً."}],"60":[{"w":"أُنزِلَ إِلَيۡكَ","m":"هو القرآنُ."},{"w":"ٱلطَّٰغُوتِ","m":"غيرِ ما شَرَع الله."}],"61":[