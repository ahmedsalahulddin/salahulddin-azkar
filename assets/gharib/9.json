{"1":[{"w":"بَرَآءَةٞ","m":"إعذارٌ وتَحَلُّلٌ من العهودِ."},{"w":"عَٰهَدتُّم","m":"التزَمْتُم معهم بميثاقٍ."}],"2":[{"w":"فَسِيحُواْ","m":"فسِيروا آمنين."},{"w":"غَيۡرُ مُعۡجِزِي ٱللَّهِ","m":"لن تُفْلِتُوا من عقوبةِ الله."},{"w":"مُخۡزِي ٱلۡكَٰفِرِينَ","m":"مُذِلُّهم في الدنيا والآخرة."}],"3":[{"w":"وَأَذَٰنٞ","m":"إعلامٌ وإنذارٌ."},{"w":"يَوۡمَ ٱلۡحَجِّ ٱلۡأَكۡبَرِ","m":"يومَ النَّحرِ."},{"w":"تُبۡتُمۡ","m":"رَجَعْتُم إلى الحقِّ وتَرَكْتُم الشِّركَ."},{"w":"تَوَلَّيۡتُمۡ","m":"أعْرَضْتُم."},{"w":"وَبَشِّرِ","m":"وأنذِرْ."}],"4":[{"w":"لَمۡ يَنقُصُوكُمۡ شَيۡـٔٗا","m":"لم يَخُونوا العهدَ ولا شروطَه."},{"w":"وَلَمۡ يُظَٰهِرُواْ","m":"ولم يُعاونوا."},{"w":"إِلَىٰ مُدَّتِهِمۡ","m":"إلى مدةِ العهدِ المحددةِ."}],"5":[{"w":"ٱنسَلَخَ","m":"خَرَجَ وانقَضَى."},{"w":"ٱلۡأَشۡهُرُ ٱلۡحُرُمُ","m":"الأشهرُ الأربعةُ التي أمَّنتم فيها المشركين."},{"w":"وَخُذُوهُمۡ","m":"وأْسِروهم."},{"w":"وَٱحۡصُرُوهُمۡ","m":"اقصِدُوهم بالحِصارِ في معاقِلِهم، أو امنعُوهم من الخروجِ والتنقُّلِ في البلادِ."},{"w":"كُلَّ مَرۡصَدٖ","m":"كلَّ طريقٍ ومَرْقَبٍ."},{"w":"تَابُواْ","m":"رَجَعُوا عن الكفر ودخلوا في الإسلام."},{"w":"فَخَلُّواْ سَبِيلَهُمۡ","m":"فاترُكوهم ولا تتعرَّضوا لهم."}],"6":[{"w":"ٱسۡتَجَارَكَ","m":"طَلَبَ جِوارَكَ، أي: حمايتَك وأمانَك."},{"w":"فَأَجِرۡهُ","m":"فأمِّنْهُ."},{"w":"كَلَٰمَ ٱللَّهِ","m":"القرآنَ الكريمَ."},{"w":"أَبۡلِغۡهُ مَأۡمَنَهُۥ","m":"أعِدْهُ من حيثُ أتى آمِناً."}],"7":[{"w":"كَيۡفَ يَكُونُ","m":"لا يكونُ."},{"w":"عَهۡدٌ","m":"التزامٌ بميثاقٍ."},{"w":"ٱلۡمَسۡجِدِ ٱلۡحَرَامِ","m":"الحَرَمِ كلِّه."},{"w":"فَمَا ٱسۡتَقَٰمُواْ لَكُمۡ","m":"فما أقاموا على الوفاءِ بعهدكم."}],"8":[{"w":"يَظۡهَرُواْ عَلَيۡكُمۡ","m":"يَظْفَرُوا بكم ويَغْلِبوكم."},{"w":"لَا يَرۡقُبُواْ","m":"لا يُراعُوا."},{"w":"إِلّٗا","m":"قَرابةً ولا حِلْفاً."},{"w":"ذِمَّةٗ","m":"عَهْداً ولا حَقّاً."}],"9":[{"w":"ٱشۡتَرَوۡاْ","m":"استبدَلُوا."},{"w":"ثَمَنٗا قَلِيلٗا","m":"عَرَضَ الدنيا الزائلَ."},{"w":"فَصَدُّواْ عَن سَبِيلِهِۦٓ","m":"فأعرضُوا عن الحقِّ، ومنعُوا غيرَهم عنه."},{"w":"سَآءَ","m":"قَبُحَ."}],"11":[{"w":"وَنُفَصِّلُ","m":"نُبيِّنُ."}],"12":[{"w":"نَكَثُوٓاْ","m":"نَقَضُوا."},{"w":"أَيۡمَٰنَهُم","m":"مواثيقَهم المؤكَّدةَ بالأَيْمان."},{"w":"وَطَعَنُواْ فِي دِينِكُمۡ","m":"ذَمُّوا الإسلامَ وعابُوه."},{"w":"لَآ أَيۡمَٰنَ لَهُمۡ","m":"لا عهودَ لهم يُوَفَّى بها."}],"13":[{"w":"وَهَمُّواْ","m":"وعَزَمُوا وعَمِلوا."},{"w":"بَدَءُوكُمۡ","m":"بالإيذاءِ والقتالِ."},{"w":"أَوَّلَ مَرَّةٍ","m":"أولَ الأمرِ بـ «مكةَ» وبـ «بَدْرٍ» وغيرِهما."},{"w":"أَتَخۡشَوۡنَهُمۡ","m":"أتَخافُونهم، أو أتخافون ملاقاتَهم في الحربِ؟"}],"14":[{"w":"يُعَذِّبۡهُمُ","m":"يَقْتُلْهم."},{"w":"وَيُخۡزِهِمۡ","m":"ويُذِلَّهم بالهزيمةِ والأَسْرِ."},{"w":"وَيَشۡفِ","m":"يُزِلِ الغَمَّ ونحوَه."}],"15":[{"w":"غَيۡظَ قُلُوبِهِمۡ","m":"غَضَبَها، وما تحمِلُه من كراهةٍ للأعداءِ."}],"16":[{"w":"تُتۡرَكُواْ","m":"دونَ اختبارٍ وابتلاءٍ."},{"w":"وَلِيجَةٗ","m":"بِطانةً وأولياءَ."}],"17":[{"w":"مَا كَانَ","m":"ما صَحَّ ولا استقامَ."},{"w":"أَن يَعۡمُرُواْ مَسَٰجِدَ ٱللَّهِ","m":"أن يَبْنُوها ويَصُونوها، أو أن يُقيموا العبادةَ فيها."},{"w":"حَبِطَتۡ","m":"بَطَلتْ."}],"19":[{"w":"سِقَايَةَ ٱلۡحَآجِّ","m":"سَقْيَ الحُجَّاجِ الماءَ."},{"w":"لَا يَهۡدِي","m":"لا يُوَفِّقُ"},{"w":"ٱلظَّٰلِمِينَ","m":"الكافرين."}],"20":[{"w":"دَرَجَةً","m":"مَنْزِلَةً."}],"21":[{"w":"وَرِضۡوَٰنٖ","m":"رضا اللهِ عنهم الذي لا سُخْطَ بعدَه."},{"w":"مُقِيمٌ","m":"دائمٌ لا يَزُولُ."}],"23":[{"w":"أَوۡلِيَآءَ","m":"نُصَراءَ وأَصْدِقاءَ."},{"w":"ٱسۡتَحَبُّواْ ٱلۡكُفۡرَ","m":"اختارُوه ودامُوا عليه."}],"24":[{"w":"وَعَشِيرَتُكُمۡ","m":"قبيلتُكم وذوو القَرابةِ القريبة."},{"w":"ٱقۡتَرَفۡتُمُوهَا","m":"اكتسَبْتموها."},{"w":"كَسَادَهَا","m":"عَدَمَ رَواجِها."},{"w":"تَرۡضَوۡنَهَآ","m":"تُعْجِبُكم وتميلُ أنفسُكم إليها."},{"w":"فَتَرَبَّصُواْ","m":"فانتظِرُوا."},{"w":"بِأَمۡرِهِۦ","m":"بعقابِه."}],"25":[{"w":"بِمَا رَحُبَتۡ","m":"مع وُسْعِها."},{"w":"وَلَّيۡتُم","m":"فَرَرْتُم."},{"w":"مُدۡبِرِينَ","m":"مُنْهَزِمِين، جاعِلين ظُهورَكم جهةَ عدوِّكم."}],"26":[{"w":"سَكِينَتَهُۥ","m":"طمأنينتَه وأَمْنَه."},{"w":"جُنُودٗا","m":"ملائكةً."}],"28":[{"w":"نَجَسٞ","m":"خُبَثاءُ في عقائدِهم وأعمالِهم الشِّرْكيةِ."},{"w":"عَامِهِمۡ هَٰذَا","m":"وهو العامُ التاسعُ من الهجرةِ."},{"w":"عَيۡلَةٗ","m":"فَقْراً."}],"29":[{"w":"وَلَا يَدِينُونَ دِينَ ٱلۡحَقِّ","m":"ولا يَلْتزمون أحكامَ الإسلام الذي ارتضاه الله دِيناً للناسِ."},{"w":"ٱلۡجِزۡيَةَ","m":"ما قُدِّرَ على أهل الكِتابِ من المالِ كلَّ عامٍ؛ جزاءً لما مُنِحُوا من الأمنِ."},{"w":"عَن يَدٖ","m":"بأيدِيهم غيرَ ممتنعين."},{"w":"صَٰغِرُونَ","m":"خاضِعونَ أذلّاءُ."}],"30":[{"w":"عُزَيۡرٌ","m":"حَبْرٌ من علماءِ اليهودِ، يُعَظِّمُونه؛ لعِلْمِه وعبادتِه."},{"w":"يُضَٰهِـُٔونَ","m":"يُشابِهُون."},{"w":"قَٰتَلَهُمُ ٱللَّهُ","m":"دعاءٌ عليهم بالهَلاكِ."},{"w":"أَنَّىٰ يُؤۡفَكُونَ","m":"كيف يُصْرَفُون عن الحقِّ الواضحِ إلى الباطلِ؟"}],"31":[{"w":"أَحۡبَارَهُمۡ","m":"جَمْعُ حَبْرٍ، وهم العلماءُ من اليهودِ."},{"w":"وَرُهۡبَٰنَهُمۡ","m":"جَمْعُ راهبٍ، وهم العُبَّادُ من النَّصارى."},{"w":"أَرۡبَابٗا مِّن دُونِ ٱللَّهِ","m":"إذْ أطاعُوهم في تحريمِ ما أحلَّ اللهُ، وتحليلِ ما حَرَّمه."},{"w":"وَٱلۡمَسِيحَ ٱبۡنَ مَرۡيَمَ","m":"واتخذ النصارىٰ عيسى عليه السلام إلهاً فعبدُوه."},{"w":"سُبۡحَٰنَهُۥ","m":"تَنَزَّه اللهُ وتَقَدَّسَ."}],"32":[{"w":"يُرِيدُونَ","m":"يريدُ الكفَّارُ بتكذيبهِم."},{"w":"أَن يُطۡفِـُٔواْ","m":"أن يُبْطِلُوا."},{"w":"نُورَ ٱللَّهِ","m":"دينَ الإسلامِ وما فيه من الهُدى والرَّشادِ."},{"w":"يُتِمَّ نُورَهُۥ","m":"يُكْمِلَ اللهُ دينَه ويُظْهِرَه."}],"33":[{"w":"بِٱلۡهُدَىٰ","m":"بالإيمانِ الصَّحيحِ، والعلمِ النافعِ."},{"w":"وَدِينِ ٱلۡحَقِّ","m":"دينِ الإسلامِ."},{"w":"لِيُظۡهِرَهُۥ","m":"ليُعْلِيَه."},{"w":"عَلَى ٱلدِّينِ كُلِّهِۦ","m":"على الأديانِ جميعاً."}],"34":[{"w":"لَيَـأۡكُلُونَ أَمۡـوَٰلَ ٱلنَّـاسِ","m":"لَيأخُذُونها."},{"w":"بِٱلۡبَٰطِلِ","m":"بغيرِ حَقٍّ كالرِّشوةِ وغيرِها."},{"w":"وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ","m":"ويمنعون الناسَ من الدخولِ في الإسلامِ، أو اتباعِ الحقِّ."},{"w":"يَكۡنِزُونَ ٱلذَّهَبَ وَٱلۡفِضَّةَ","m":"يجمعونَ الأموالَ."},{"w":"وَلَا يُنفِقُونَهَا فِي سَبِيلِ ٱللَّهِ","m":"ولايُؤَدُّون زَكاتَها، ولايُخْرِجون منها الحقوقَ الواجبةَ."}],"35":[{"w":"فَتُكۡوَىٰ","m":"تُحْرَقُ."},{"w":"فَذُوقُواْ مَا كُنتُمۡ تَكۡنِزُونَ","m":"ذُوقوا سوءَ عاقبةِ جَمْعِكم."}],"36":[{"w":"عِدَّةَ ٱلشُّهُورِ","m":"أي: عَدَدَها الذي يَتَألَّفُ منه العامُ."},{"w":"فِي كِتَٰبِ ٱللَّهِ","m":"في حُكْمِه القَدَريِّ الذي كُتب في اللَّوحِ المحفوظِ."},{"w":"أَرۡبَعَةٌ حُرُمٞ","m":"أي: ذاتُ حُرْمَةٍ وتعظيمٍ، وهي: رَجَبٌ، وذو القَعْدة، وذو الحِجَّةِ، والمُحَرَّمُ."},{"w":"ٱلۡقَيِّمُ","m":"المستقيمُ الذي لا عِوَجَ فيه."},{"w":"فَلَا تَظۡلِمُواْ فِيهِنَّ أَنفُسَكُمۡ","m":"بارتكابِ ما حَرَّمَ اللهُ؛ لعِظَمِ حُرْمتِها."},{"w":"كَآفَّةٗ","m":"جميعاً، وفي كلِّ الشهورِ."},{"w":"وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ","m":"بالعَوْنِ والنَّصرِ."}],"37":[{"w":"ٱلنَّسِيٓءُ","m":"تأخيرُ حُرْمَةِ شهرٍ إلى شهرٍ آخرَ، كما كانت تفعلُه العربُ في الجاهليةِ."},{"w":"يُحِلُّونَهُۥ","m":"أي: النسيءَ."},{"w":"لِّيُوَاطِـُٔواْ","m":"ليوافِقُوا بتحليلِ شهرٍ وتحريمِ آخرَ بَدَلَه."},{"w":"عِدَّةَ","m":"عددَ."},{"w":"مَا حَرَّمَ ٱللَّهُ","m":"من الأشهرِ، بحيث تكونُ أربعةً في العددِ."},{"w":"لَا يَهۡدِي","m":"لا يُوَفِّقُ."}],"38":[{"w":"ٱنفِرُواْ","m":"اخرُجُوا بخِفَّةٍ ونشاطٍ."},{"w":"فِي سَبِيلِ ٱللَّهِ","m":"إلى الجهادِ لإعلاءِ كلمةِ اللهِ."},{"w":"ٱثَّاقَلۡتُمۡ إِلَى ٱلۡأَرۡضِ","m":"تباطَأْتم في الخروجِ، ومِلْتُم إلى الإقامةِ في أرضِكم ومساكِنِكُم."},{"w":"مِنَ ٱلۡأٓخِرَةِ","m":"بدلَ نعيمِ الآخرةِ."},{"w":"مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","m":"ما يُتَمَتَّعُ به مِنْ لَذَّاتِ الدنيا."}],"39":[{"w":"يُعَذِّبۡكُمۡ","m":"يُنْزِلْ عقوبتَه بكم."}],"40":[{"w":"إِلَّا تَنصُرُوهُ","m":"إن لم تَنْصُروا النبيَّ ﷺ."},{"w":"ثَانِيَ ٱثۡنَيۡنِ","m":"أحدَ اثنين، والثاني هو أبوبكرٍ الصِّدِّيقُ رضي الله عنه."},{"w":"ٱلۡغَارِ","m":"النَّقْبِ في الجَبَلِ، وهو في جبلِ ثورٍ بـ «مكةَ»."},{"w":"لِصَٰحِبِهِۦ","m":"أبي بكرٍ الصِّدِّيقِ رضي الله عنه."},{"w":"سَكِينَتَهُۥ","m":"طمأنينتَه."},{"w":"بِجُنُودٖ","m":"هم الملائكةُ، يَحْرُسُونه ويَصْرِفُون أبصارَ الكفارِ عنه."},{"w":"كَلِمَةَ ٱلَّذِينَ كَفَرُواْ","m":"أي: دعوةَ الشِّركِ والكفرِ."},{"w":"ٱلسُّفۡلَىٰ","m":"المغلوبةَ."},{"w":"كَلِمَةُ ٱللَّهِ","m":"كلمةُ التوحيدِ."},{"w":"ٱلۡعُلۡيَا","m":"الغالبةُ."}],"41":[{"w":"خِفَافٗا","m":"على الصِّفةِ التي يَخِفُّ عليكم الجهادُ فيها."},{"w":"وَثِقَالٗا","m":"وعلى الصفةِ التي يَثْقُلُ عليكم الجهادُ فيها."}],"42":[{"w":"لَوۡ كَانَ","m":"أي: ما دَعَوْتَهم إليه من الخروجِ للجهادِ."},{"w":"عَرَضٗا","m":"مَتاعاً وغَنيمةً."},{"w":"قَرِيبٗا","m":"سَهْلَ المأخَذِ."},{"w":"قَاصِدٗا","m":"متوسِّطاً بَيْنَ القُرْبِ والبُعْدِ، لا مَشَقَّةَ فيه."},{"w":"ٱلشُّقَّةُ","m":"المسافةُ البعيدةُ التي تُقْطَعُ بمَشَقَّةٍ."},{"w":"يُهۡلِكُونَ أَنفُسَهُمۡ","m":"بالحَلِفِ الكاذبِ والنِّفاقِ."}],"43":[{"w":"عَفَا ٱللَّهُ عَنكَ","m":"العَفْوُ: هو التجاوُزُ عن الخطأ وتَرْكُ المؤاخذةِ عليه."}],"45":[{"w":"يَسۡتَـٔۡذِنُكَ","m":"يَطْلُبُ الإذنَ للتخَلُّفِ عن الجهادِ."},{"w":"وَٱرۡتَابَتۡ قُلُوبُهُمۡ","m":"شَكَّتْ في الإسلامِ وشرائعِه."},{"w":"يَتَرَدَّدُونَ","m":"يتَحيَّرُون."}],"46":[{"w":"ٱلۡخُرُوجَ","m":"مَعَك إلى الجهادِ."},{"w":"لَأَعَدُّواْ لَهُۥ عُدَّةٗ","m":"لَتَأهَّبُوا له بإعدادِ السِّلاحِ والزادِ، وما يُحتاجُ إليه."},{"w":"ٱنۢبِعَاثَهُمۡ","m":"خروجَهم للجهادِ."},{"w":"فَثَبَّطَهُمۡ","m":"مَنَعهم وعوَّقهم بقَضائِه وقَدَرِه."},{"w":"ٱقۡعُدُواْ","m":"تَخَلَّفُوا عن الجِهادِ."},{"w":"مَعَ ٱلۡقَٰعِدِينَ","m":"من المرضى والضُّعَفاءِ والنِّساءِ والصِّبْيانِ."}],"47":[{"w":"خَبَالٗا","m":"شرّاً وفساداً."},{"w":"وَلَأَوۡضَعُواْ خِلَٰلَكُمۡ","m":"أسْرَعُوا في المَشْيِ بينَكم بالنميمةِ وإفسادِ القلوبِ."},{"w":"يَبۡغُونَكُمُ","m":"يُريدُون لكم."},{"w":"ٱلۡفِتۡنَةَ","m":"ما تُفْتَنُون به؛ كي تتثاقَلُوا عن الجهادِ في سبيلِ اللهِ."},{"w":"سَمَّٰعُونَ لَهُمۡ","m":"مَنْ يَسْمعون كلام المنافقين، ويُطيعونهم."}],"48":[{"w":"ٱبۡتَغَوُاْ","m":"طلبُوا وأرادوا."},{"w":"ٱلۡفِتۡنَةَ","m":"فتنةَ المؤمنين وصَدَّهم عن دينِهم."},{"w":"مِن قَبۡلُ","m":"من قبلِ غزوةِ «تبوكَ»."},{"w":"وَقَلَّبُواْ لَكَ ٱلۡأُمُورَ","m":"أرادُوا إبطالَ ما جِئْتَ به بتحايُلِهم ومَكْرِهم."},{"w":"ٱلۡحَقُّ","m":"النصرُ من عندِ اللهِ."},{"w":"وَظَهَرَ","m":"علا وغَلَبَ."},{"w":"أَمۡرُ ٱللَّهِ","m":"دينُه، وهو الإسلامُ."}],"49":[{"w":"وَمِنۡهُم","m":"ومن المنافقين."},{"w":"ٱئۡذَن لِّي","m":"في التخَلُّف عن الجهادِ."},{"w":"وَلَا تَفۡتِنِّيٓ","m":"لاتُوقِعْني في فتنةِ النِّساءِ حالةَ الخروجِ معك."},{"w":"فِي ٱلۡفِتۡنَةِ","m":"فتنةِ النِّفاقِ والتخلُّفِ عن الجهادِ."},{"w":"سَقَطُواْ","m":"وقعوا في الإثمِ لمخالَفَتِهم أمرَ اللهِ ورسولِه."}],"50":[{"w":"حَسَنَةٞ","m":"نصرٌ وغنيمةٌ."},{"w":"مُصِيبَةٞ","m":"مَكْرُوهٌ من هزيمةٍ أو شدَّةٍ."},{"w":"قَدۡ أَخَذۡنَآ أَمۡرَنَا مِن قَبۡلُ","m":"قد احْتَطْنا لأنفسِنا حين تَخَلَّفْنا عن الجهادِ قبلَ هذه المصيبةِ."},{"w":"وَيَتَوَلَّواْ","m":"وينصَرِفُوا."}],"51":[{"w":"مَا كَتَبَ ٱللَّهُ لَنَا","m":"ما قَدَّرَه علينا."},{"w":"هُوَ مَوۡلَىٰنَا","m":"ناصِرُنا ومُتَوَلِّي أمورِنا."},{"w":"وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ","m":"فلْيَعْتَمِدْ ولْيُفَوِّضْ أمرَه إليه."}],"52":[{"w":"هَلۡ تَرَبَّصُونَ","m":"ما تنتظرون أن يَقَعَ."},{"w":"إِحۡدَى ٱلۡحُسۡنَيَيۡنِ","m":"إحدى العاقبتَين: النصرَ، أوالشهادةَ في سبيلِ اللهِ."}],"53":[{"w":"طَوۡعًا","m":"طائعِين."},{"w":"كَرۡهٗا","m":"كارهِين."},{"w":"فَٰسِقِينَ","m":"خارجِين عن دينِ اللهِ."}],"54":[{"w":"كُسَالَىٰ","m":"متثاقلون عن الصَّلاةِ."}],"55":[{"w":"لِيُعَذِّبَهُم بِهَا","m":"بما يَلْقَون من التعبِ في جَمْعِها، وبالمصائبِ التي تقعُ فيها."},{"w":"وَتَزۡهَقَ","m":"تَخْرُجَ."}],"56":[{"w":"يَفۡرَقُونَ","m":"يَخافُون."}],"57":[{"w":"مَلۡجَـًٔا","m":"حِصْناً ومأمَناً يلجَؤُون إليه."},{"w":"مَغَٰرَٰتٍ","m":"جَمْعُ مَغارةٍ، وهي الكَهْفُ، أو الغارُ في الجبلِ يُؤْويهم."},{"w":"مُدَّخَلٗا","m":"مكاناً يَدْخلونه كالنَّفَقِ في الأرضِ."},{"w":"لَوَلَّوۡاْ","m":"لأَدْبَرُوا وانْصَرَفُوا."},{"w":"يَجۡمَحُونَ","m":"يُسْرِعون في دخولِه، لا يَمْنَعُهم شيءٌ."}],"58":[{"w":"يَلۡمِزُكَ","m":"يَعِيْبُك."},{"w":"فِي ٱلصَّدَقَٰتِ","m":"في قِسْمةِ أموالِ الصَّدقاتِ."}],"59":[{"w":"حَسۡبُنَا ٱللَّهُ","m":"كافِينا."},{"w":"إِلَى ٱللَّهِ رَٰغِبُونَ","m":"مُحِبُّون أن يُغْنيَنا من فضلِه."}],"60":[{"w":"ٱلصَّدَقَٰتُ","m":"الزَّكَواتُ المفروضةُ."},{"w":"لِلۡفُقَرَآءِ","m":"للمحتاجِين الذين لا يَمْلِكُون شيئاً."},{"w":"وَٱلۡمَسَٰكِينِ","m":"الذين لا يَمْلِكُون ما يَكْفيهم ويَسُدُّ حاجتَهم."},{"w":"وَٱلۡعَٰمِلِينَ عَلَيۡهَا","m":"السُّعاةُ الذين يَجْمعون الزكاةَ من أصحابِها."},{"w":"وَٱلۡمُؤَلَّفَةِ قُلُوبُهُمۡ","m":"المستمالةِ قلوبُهم إلى الإسلام، كمن يُرْجَى إسلامُه أو قوَّةُ إيمانِه."},{"w":"وَفِي ٱلرِّقَابِ","m":"وتُعطى الزكاةُ في عِتْقِ رقابِ العبيدِ والمكاتَبين."},{"w":"وَٱلۡغَٰرِمِينَ","m":"الذين استدانُوا لأنفسهم، ولا قُدَرةَ لهم على الوفاءِ، أو استدانُوا لإصلاحِ ذاتِ البَيْنِ."},{"w":"وَفِي سَبِيلِ ٱللَّهِ","m":"وللغُزاةِ وللمرابطين في سبيل الله."},{"w":"وَٱبۡنِ ٱلسَّبِيلِ","m":"المسافرِ المنقطعِ عن مالِه في سفرِه، وإن كان غنياً في بلدِه."},{"w":"فَرِيضَةٗ مِّنَ ٱللَّهِ","m":"هذه القِسْمةُ فَرَضَها اللهُ فريضةً وقَدَّرها."}],"61":[{"w":"أُذُنٞ","m":"يستمعُ لكلِّ ما يُقالُ له ويُصَدِّقُه."},{"w":"قُلۡ أُذُنُ خَيۡرٖ لَّكُمۡ","m":"أي: أُذُنٌ في الخيرِ والحقِّ، وفيما يجبُ سَماعُه وقَبولُه."},{"w":"وَيُؤۡمِنُ لِلۡمُؤۡمِنِينَ","m":"ويُصَدِّقُ المؤمنين فيما يُخبرونه."}],"63":[{"w":"يُحَادِدِ","m":"يخالِفْ."}],"64":[{"w":"تُنَبِّئُهُم","m":"تُخَبِّرُهم."},{"w":"بِمَا فِي قُلُوبِهِمۡ","m":"بما يُضْمِرُونَه في قلوبِهم من الكفرِ."},{"w":"مُخۡرِجٞ مَّا تَحۡذَرُونَ","m":"مُظْهِرٌ ما تَخافُونه من الفضيحةِ."}],"65":[{"w":"وَلَئِن سَأَلۡتَهُمۡ","m":"عَمَّا قالوا من الطَّعْنِ في حَقِّك وحَقِّ أصحابِك."},{"w":"نَخُوضُ وَنَلۡعَبُ","m":"نتحَدَّثُ بكلامٍ لم نَقْصِدْ به الإساءةَ."}],"66":[{"w":"إِن نَّعۡفُ عَن طَآئِفَـةٖ مِّنـكُمۡ","m":"بالتوفيق للتوبةِ والإخلاصِ فيها."},{"w":"نُعَذِّبۡ طَآئِفَةَۢ","m":"بسبب تَرْكِ التوبةِ والإصرارِ على النِّفاقِ."}],"67":[{"w":"بَعۡضُهُم مِّنۢ بَعۡضٖ","m":"أي: مُتَشابهون في صفةِ النِّفاقِ والبُعْدِ عن الإيمانِ."},{"w":"بِٱلۡمُنكَرِ","m":"بالكفرِ والمعاصي."},{"w":"ٱلۡمَعۡرُوفِ","m":"هو كلُّ ما عُرِفَ حُسْنُه في الشَّرعِ والعَقْلِ."},{"w":"وَيَقۡبِضُونَ أَيۡدِيَهُمۡ","m":"ويُمْسِكُون عن الإنفاقِ في طاعةِ اللهِ ومَرْضاتِه."},{"w":"نَسُواْ ٱللَّهَ","m":"تَرَكُوا طاعتَه وأوامرَه."},{"w":"فَنَسِيَهُمۡ","m":"فتركَهم من رحمتِه وثوابِه."},{"w":"ٱلۡفَٰسِقُونَ","m":"الخارجُون عن الإيمانِ والطاعة."}],"68":[{"w":"حَسۡبُهُمۡ","m":"كافِيهم؛ عقاباً على كفرِهم."},{"w":"وَلَعَنَهُمُ ٱللَّهُ","m":"طَرَدَهم مِنْ رحمتِه."},{"w":"مُقِيمٞ","m":"دائمٌ لا ينقطعُ."}],"69":[{"w":"بِخَلَٰقِهِمۡ","m":"بنصيبِهم الذي قُدِّرَ لهم من مَلاذِّ الدنيا."},{"w":"وَخُضۡتُمۡ","m":"ودَخَلْتُم في الباطلِ والطَّعْنِ في الدِّينِ."},{"w":"حَبِطَتۡ","m":"بَطَلَتْ."}],"70":[{"w":"نَبَأُ","m":"خبرُ."},{"w":"وَأَصۡحَٰبِ مَدۡيَنَ","m":"هم قومُ شعيبٍ عليه السلام."},{"w":"وَٱلۡمُؤۡتَفِكَٰتِ","m":"قُرى قومِ لوطٍ عليه السلام، التي انقلبَتْ بهم، فصار عالِيها سافلَها."},{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالوَحْيِ والمعجزاتِ."},{"w":"كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ","m":"بتعريضِها للعقابِ؛ بسببِ كُفْرِهم."}],"71":[{"w":"أَوۡلِيَآءُ بَعۡضٖ","m":"أنصارُ بعضٍ."},{"w":"عَزِيزٌ","m":"لا يُعْجِزُه شيء عن إنجازِ وَعْدِه للمؤمنين، ووعيدِه لِمَنْ عَصَاه وكَفَرَ به."},{"w":"حَكِيمٞ","m":"يَضَعُ الأمورَ في محَالِّها."}],"72":[{"w":"مِن تَحۡتِهَا","m":"من تحتِ قصورِها وأشجارِها."},{"w":"طَيِّبَةٗ","m":"حسنةَ البناءِ، طَيِّبةَ القَرارِ."},{"w":"جَنَّٰتِ عَدۡنٖ","m":"أي: إقامةٍ وخُلودٍ."},{"w":"أَكۡبَرُ","m":"ممَّا هم فيه من أنواعِ النعيمِ."}],"73":[{"w":"وَٱغۡلُظۡ","m":"واشدُدْ في جهادِك."},{"w":"وَمَأۡوَىٰهُمۡ","m":"مصيرُهم."}],"74":[{"w":"كَلِمَةَ ٱلۡكُفۡرِ","m":"هي استهزاؤهُم بالرسولِ عليه الصلاةُ والسلام، وبالدِّينِ."},{"w":"وَهَمُّواْ","m":"وصَمَّمَ المنافقون على قَتْلِ الرسولِ ﷺ."},{"w":"بِمَا لَمۡ يَنَالُواْ","m":"بما لم يُمَكِّنْهم اللهُ منه."},{"w":"وَمَا نَقَمُوٓاْ","m":"وما وَجَدَ المنافقون شيئاً يَكْرَهُونه ويَعِيبونَه."},{"w":"وَإِن يَتَوَلَّوۡاْ","m":"يُعْرِضُوا، أو يَسْتمِرُّوا على حالِهم."},{"w":"وَلِيّٖ","m":"يَلي أمورَهم وينفَعُهم."},{"w":"وَلَا نَصِيرٖ","m":"ولا ناصرٍ يَدْفَعُ عنهم ما هم فيه."}],"75":[{"w":"عَٰهَدَ ٱللَّهَ","m":"قَطَعَ على نفسِه العهدَ مع اللهِ."}],"77":[{"w":"فَأَعۡقَبَهُمۡ نِفَاقٗا","m":"فأَوْرَثَهم اللهُ جزاءَ صنيعِهم زيادةً في نفاقِهم."}],"78":[{"w":"سِرَّهُمۡ","m":"ما انطَوتْ عليه نفوسُهم من النِّفاق."},{"w":"وَنَجۡوَىٰهُمۡ","m":"ما يتحَدَّثون به بينَهم من الكَيْدِ والمَكْر."}],"79":[{"w":"يَلۡمِزُونَ ٱلۡمُطَّوِّعِينَ","m":"يَعِيبُون المتصدِّقين ويَطْعَنُون في إخلاصِهم."},{"w":"جُهۡدَهُمۡ","m":"طاقَتَهم وما تَبْلُغُه قُوَّتُهم."}],"80":[{"w":"سَبۡعِينَ مَرَّةٗ","m":"أي: مهما كَثُرَ استغفارُك لهم وتكرَّر."},{"w":"لَا يَهۡدِي","m":"لا يُوَفِّقُ."},{"w":"ٱلۡفَٰسِقِينَ","m":"الخارجين عن دينِ الله."}],"81":[{"w":"ٱلۡمُخَلَّفُونَ","m":"الذين تخلَّفُوا عن الجهادِ في غزوةِ «تبوكَ»."},{"w":"بِمَقۡعَدِهِمۡ","m":"أي: بقُعودِهم."},{"w":"خِلَٰفَ رَسُولِ ٱللَّهِ","m":"مخالِفِين رسولَ الله ﷺ."},{"w":"لَا تَنفِرُواْ","m":"لا تَخْرُجُوا إلى الجهادِ."}],"82":[{"w":"قَلِيلٗا","m":"في الدنيا."},{"w":"كَثِيرٗا","m":"في الآخرةِ."}],"83":[{"w":"أَوَّلَ مَرَّةٖ","m":"هي غزوةُ «تبوكَ»."},{"w":"ٱلۡخَٰلِفِينَ","m":"المتخلِّفين عن الجهادِ، كالنِّساءِ والصِّبيانِ."}],"84":[{"w":"وَلَا تَقُمۡ عَلَىٰ قَبۡرِهِۦٓ","m":"لأجلِ الدَّفْنِ، أو الزيارةِ، أو الدعاءِ له."}],"85":[{"w":"أَن يُعَذِّبَهُم بِهَا","m":"بما يَلْقَون من التعب في جَمْعِها، وبالمصائبِ التي تقعُ فيها."},{"w":"وَتَزۡهَقَ","m":"تَخْرُجَ."}],"86":[{"w":"أُوْلُواْ ٱلطَّوۡلِ","m":"أصحابُ الغِنى والمقدرةِ على الجهادِ."},{"w":"ذَرۡنَا","m":"اتْرُكْنا."}],"87":[{"w":"ٱلۡخَوَالِفِ","m":"جَمْعُ خالِفة، ويقال للمرأةِ والرجل، والمرادُ: النِّساءُ اللاتي تخلَّفْنَ في البيوتِ، أو الرجالُ العاجزون عن القتال."},{"w":"وَطُبِعَ","m":"ختمَ اللهُ."}],"88":[{"w":"ٱلۡخَيۡرَٰتُ","m":"في الدنيا والآخرةِ."}],"90":[{"w":"ٱلۡمُعَذِّرُونَ","m":"المعتذرون بأعذارٍ كاذبةٍ عن عدمِ الخروجِ للغَزْوِ."},{"w":"ٱلۡأَعۡرَابِ","m":"سُكَّانِ الباديةِ."},{"w":"وَقَعَدَ","m":"عن الغزوِ لغيرِ عُذْرٍ."}],"91":[{"w":"حَرَجٌ","m":"إثمٌ."},{"w":"نَصَحُواْ","m":"أخلَصُوا."},{"w":"مِن سَبِيلٖ","m":"من طريقٍ للمؤاخذةِ."}],"92":[{"w":"لِتَحۡمِلَهُمۡ","m":"على ما يَرْكَبون عليه في الْغَزْو."},{"w":"تَوَلَّواْ","m":"انْصَرَفُوا مِنْ عندِك."},{"w":"حَزَنًا","m":"أسَفاً على ما فاتَهم من شَرَفِ الجهادِ وثوابِه."}],"93":[{"w":"ٱلسَّبِيلُ","m":"طريقُ العقوبةِ والمؤاخَذَةِ."}],"94":[{"w":"إِذَا رَجَعۡتُمۡ إِلَيۡهِمۡ","m":"من الغَزْوِ."},{"w":"لَن نُّؤۡمِنَ لَكُمۡ","m":"لن نُصَدِّقَكم."}],"95":[{"w":"إِذَا ٱنقَلَبۡتُمۡ إِلَيۡهِمۡ","m":"رَجَعْتُم إليهم من الغَزْو."},{"w":"لِتُعۡرِضُواْ عَنۡهُمۡ","m":"لتَتْرُكُوهم وتَصْفَحُوا عنهم."},{"w":"رِجۡسٞ","m":"خبثاءُ في بَواطِنِهم واعتقاداتِهم."},{"w":"وَمَأۡوَىٰهُمۡ","m":"مصيرُهم."}],"96":[{"w":"ٱلۡفَٰسِقِينَ","m":"الخارجين عن دينِ اللهِ."}],"97":[{"w":"ٱلۡأَعۡرَابُ","m":"سُكَّانُ الباديةِ."},{"w":"وَأَجۡدَرُ","m":"وأحَقُّ."}],"98":[{"w":"مَغۡرَمٗا","m":"غَرامةً وخَسارةً."},{"w":"وَيَتَرَبَّصُ","m":"ينتظرُ."},{"w":"ٱلدَّوَآئِرَ","m":"جَمْعُ دائرةٍ، وهي: تَقَلُّباتُ الدَّهْرِ ومصائبُه."},{"w":"ٱلسَّوۡءِ","m":"كلُّ ما يسوءُ وَيَضُرُّ."}],"99":[{"w":"وَيَتَّخِذُ مَا يُنفِقُ","m":"ويحتسِبُ ما ينفقُه في سبيلِ اللهِ."},{"w":"قُرُبَٰتٍ عِندَ ٱللَّهِ","m":"جَمْعُ قُرْبَةٍ، وهي: ما يُتَقَرَّبُ به إلى اللهِ تعالى."},{"w":"وَصَلَوَٰتِ ٱلرَّسُولِ","m":"جَمْعُ صلاةٍ، وهي هنا: الدُّعاءُ، أي: ويَجْعَلُ إنفاقَه في سبيلِ اللهِ وسيلةً إلى دعاءِ الرسولِ ﷺ له."}],"100":[{"w":"ٱلۡمُهَٰجِرِينَ","m":"الذين هَجَرُوا قومَهم، وانتقلُوا من بلدِ الفتنةِ إلى دارِ الإسلامِ."},{"w":"وَٱلۡأَنصَارِ","m":"الذين نصرُوا النبي ﷺ، وآوَوا المهاجرين."},{"w":"بِإِحۡسَٰنٖ","m":"في الاعتقادِ، والأقوالِ، والأعمالِ."},{"w":"تَحۡتَهَا","m":"تحتَ قصورِها وأشجارِها."}],"101":[{"w":"مَرَدُواْ عَلَى ٱلنِّفَاقِ","m":"مَهَرُوا فيه واستمَرُّوا عليه."},{"w":"سَنُعَذِّبُهُم مَّرَّتَيۡنِ","m":"الأولى: في الدنيا بفضيحتِهم، أو بأنواعِ المكارِهِ التي تنالُهم، والثانية: بعذابِ القبرِ."},{"w":"عَذَابٍ عَظِيمٖ","m":"نارِ جهنمَ."}],"102":[{"w":"عَمَلٗا صَٰلِحٗا","m":"ما سَبَقَ لهم من الجهادِ، مع توبتِهم."},{"w":"وَءَاخَرَ سَيِّئًا","m":"تَخَلُّفَهم عن غزوةِ «تبوكَ»."}],"103":[{"w":"تُطَهِّرُهُمۡ","m":"تُزيلُ بها أثَرَ ذنوبِهم."},{"w":"وَتُزَكِّيهِم بِهَا","m":"تُنَمِّي بها حَسَناتِهم، وترفَعُهم إلى منازلِ المُخْلَصِين."},{"w":"وَصَلِّ عَلَيۡهِمۡ","m":"ادْعُ لهم واستغفِرْ."},{"w":"سَكَنٞ لَّهُمۡ","m":"سكينةٌ لنفوسِهم، وطُمَأنينةٌ لقلوبِهم."}],"104":[{"w":"وَيَأۡخُذُ ٱلصَّدَقَٰتِ","m":"يَقْبَلُها ويُثيبُ عليها."}],"105":[{"w":"وَسَتُرَدُّونَ","m":"ستُرْجَعُون يومَ القيامةِ."}],"106":[{"w":"مُرۡجَوۡنَ لِأَمۡرِ ٱللَّهِ","m":"مُؤَخَّرون لحُكمِ اللهِ فيهم."}],"107":[{"w":"ضِرَارٗا","m":"لأجل الضَّرَر بِالمؤمنين."},{"w":"وَإِرۡصَادٗا","m":"انتظاراً وإعداداً."},{"w":"لِمَنۡ حَارَبَ ٱللَّهَ وَرَسُولَهُۥ","m":"هو أبو عامرٍ الفاسقُ."},{"w":"مِن قَبۡلُ","m":"أي: من قَبْلِ بناءِ مسجدِ الضِّرارِ."},{"w":"ٱلۡحُسۡنَىٰ","m":"الخيرَ والإحسانَ إلى المسلمين."}],"108":[{"w":"لَا تَقُمۡ فِيهِ","m":"أي للصَّلاةِ في مَسْجدِ الضِّرارِ."},{"w":"لَمَسۡجِدٌ أُسِّسَ عَلَى ٱلتَّقۡوَىٰ","m":"هو مَسْجدُ قُباءٍ."},{"w":"يُحِبُّونَ أَن يَتَطَهَّرُواْ","m":"طهارةً حِسِّيَّةً من النجاساتِ، ومعنويةً من الذُّنوبِ والمعاصي."}],"109":[{"w":"وَرِضۡوَٰنٍ","m":"ورجاءِ مَرْضاةِ اللهِ."},{"w":"عَلَىٰ شَفَا جُرُفٍ","m":"على طَرَفِ حُفْرَةٍ، أو مكانٍ جَرَفَهُ السَّيْلُ."},{"w":"هَارٖ","m":"مُشْرِفٍ على السُّقوط."},{"w":"فَٱنۡهَارَ بِهِۦ","m":"فسَقَطَ المكانُ بالبُنيانِ مع بانيه."},{"w":"لَا يَهۡدِي","m":"لا يُوَفِّقُ."}],"110":[{"w":"بُنۡيَٰنُهُمُ","m":"مسجدُ الضِّرارِ."},{"w":"رِيبَةٗ فِي قُلُوبِهِمۡ","m":"شَكّاً ونفاقاً راسخاً في قلوبِهم."},{"w":"تَقَطَّعَ قُلُوبُهُمۡ","m":"تتقَطَّعَ قلوبُهم بَمْوتِهم، فالنِّفاقُ ملازمٌ لهم ماداموا أحياءً."}],"111":[{"w":"فَٱسۡتَبۡشِرُواْ","m":"أظْهِرُوا السُّرورَ."}],"112":[{"w":"ٱلسَّٰٓئِحُونَ","m":"الصَّائمون."}],"114":[{"w":"مَوۡعِدَةٖ وَعَدَهَآ إِيَّاهُ","m":"وهي الاستغفارُ له."},{"w":"لَأَوَّٰهٌ","m":"كثيرُ التضرُّعِ إلى اللهِ."},{"w":"حَلِيمٞ","m":"صَبُورٌ على الأذى، كثيرُ الصَّفْحِ عَمَّن نالَه بمَكْروه."}],"115":[{"w":"مَا يَتَّقُونَ","m":"ما يَجِبُ عليهم اتقاؤُه من المُحَرَّماتِ."}],"116":[{"w":"وَلِيّٖ","m":"يَتَوَلَّى أمورَكم وينفَعُكم."},{"w":"وَلَا نَصِيرٖ","m":"يَنْصُرُكم ويَدْفَعُ عنكم ما أنتم فيه."}],"117":[{"w":"سَاعَةِ ٱلۡعُسۡرَةِ","m":"وقتِ الشِّدةِ، وهي غزوةُ «تبوكَ»."},{"w":"يَزِيغُ قُلُوبُ","m":"تميلُ إلى التخَلُّفِ عن الجهادِ."},{"w":"بِهِمۡ رَءُوفٞ","m":"كثيرُ الرأفةِ والرحمةِ بهم في عاجِلِهم وآجِلِهم."}],"118":[{"w":"وَعَلَى ٱلثَّلَٰثَةِ","m":"أي: وتابَ على الثلاثةِ، وهم: كَعْبُ بنُ مالك، وهِلَالُ ابنُ أميةَ، ومُرَارةُ بنُ الرَّبِيعِ."},{"w":"خُلِّفُواْ","m":"خُلِّفوا عن التوبة عليهم وقبول عذرهم، وأُخِّروا."},{"w":"بِمَا رَحُبَتۡ","m":"أي: مع سَعَتِها؛ ندماً بسبب تَخَلُّفِهم عن الغزوِ."},{"w":"وَظَنُّوٓاْ","m":"أيقنوا."},{"w":"ثُمَّ تَابَ عَلَيۡهِمۡ","m":"وَفَّقهم اللهُ للتوبةِ."},{"w":"لِيَتُوبُوٓاْ","m":"ليستمِرُّوا على التوبةِ ويثبتُوا عليها."}],"120":[{"w":"مَا كَانَ لِأَهۡلِ ٱلۡمَدِينَةِ","m":"أي: ليس لهم."},{"w":"وَلَا يَرۡغَبُواْ بِأَنفُسِهِمۡ عَن نَّفۡسِهِۦ","m":"لا يَرْضَوْا لها بالراحة، ورسولُ الله ﷺ في تعبٍ ومشقةٍ."},{"w":"ظَمَأٞ","m":"عَطَشٌ."},{"w":"وَلَا نَصَبٞ","m":"تَعَبٌ."},{"w":"وَلَا مَخۡمَصَةٞ","m":"جُوعٌ شديدٌ."},{"w":"مَوۡطِئٗا","m":"مكاناً."},{"w":"يَغِيظُ","m":"يُغْضِبُ."},{"w":"نَيۡلًا","m":"بقَتْلٍ، أو أَسْرٍ، أو جِراحَةٍ، أو غنيمةٍ ونحوِها."}],"122":[{"w":"فَلَوۡلَا","m":"فهَلَّا."},{"w":"نَفَرَ","m":"خَرَج للغزوِ والجهادِ."}],"123":[{"w":"يَلُونَكُم","m":"يجاوِرُونكم."},{"w":"غِلۡظَةٗ","m":"شدَّةً."}],"124":[{"w":"فَمِنۡهُم","m":"فمِنَ المنافقين."},{"w":"يَسۡتَبۡشِرُونَ","m":"يَفْرحُون بفضلِ اللهِ عليهم."}],"125":[{"w":"مَرَضٞ","m":"شكٌّ ونِفاقٌ."},{"w":"رِجۡسًا إِلَىٰ رِجۡسِهِمۡ","m":"نِفاقاً وكُفْراً إلى كُفْرِهم."}],"126":[{"w":"يُفۡتَنُونَ","m":"يُبْتلَوْن بأنواعِ البَلاءِ."},{"w":"وَلَا هُمۡ يَذَّكَّرُونَ","m":"لا يَتَّعِظُون بما نَزَلَ بهم."}],"127":[{"w":"نَظَرَ بَعۡضُهُمۡ إِلَىٰ بَعۡضٍ","m":"تغامَزَ المنافقون بالعيونِ؛ إنكاراً لنزولِ السورةِ، وغيظاً لما فيها من بيانِ عيوبِهم."},{"w":"هَلۡ يَرَىٰكُم مِّنۡ أَحَدٖ","m":"يُريدون الهروبَ من مجلسِ النبيِّ ﷺ."},{"w":"صَرَفَ ٱللَّهُ قُلُوبَهُم","m":"عن الإيمانِ."},{"w":"لَا يَفۡقَهُونَ","m":"لا يَفْهَمونَ؛ لعَدَمِ تَدَبُّرِهم وإنصافِهم."}],"128":[{"w":"مِنۡ أَنفُسِكُمۡ","m":"من قومِكم."},{"w":"عَزِيزٌ عَلَيۡهِ","m":"ما تَلْقَوْن من المكروهِ والمشقَّةِ."},{"w":"رَءُوفٞ","m":"عظيمُ الرحمةِ شفيقٌ."}],"129":[{"w":"تَوَلَّوۡاْ","m":"أعْرَضُوا."},{"w":"حَسۡبِيَ ٱللَّهُ","m":"يكفيني اللهُ."},{"w":"عَلَيۡهِ تَوَكَّلۡتُ","m":"اعتمَدْتُ عليه، وفوَّضْتُ جميعَ أموري إليه."},{"w":"ٱلۡعَرۡشِ ٱلۡعَظِيمِ","m":"سريرِ المُلْكِ الذي استوى عليه الرحمنُ، وتحمِلُه الملائكةُ، وهو أعظمُ المخلوقاتِ، وهو سَقْفُ الجَنَّةِ."}]}