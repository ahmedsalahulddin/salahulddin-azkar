{"1":[{"w":"الٓمٓ","m":"سَبَقَ الكَلَامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"4":[{"w":"يُؤۡتُونَ","m":"يُعْطُونَ."},{"w":"يُوقِنُونَ","m":"يُؤْمِنُونَ."}],"5":[{"w":"ٱلۡمُفۡلِحُونَ","m":"الفائِزُونَ."}],"6":[{"w":"لَهۡوَ ٱلۡحَدِيثِ","m":"هُوَ كلُّ ما يُلْهِي عَن طَاعةِ اللهِ."},{"w":"بِغَيۡرِ عِلۡمٖ","m":"جَهْلاً بِعاقِبَةِ ذَلِكَ."},{"w":"وَيَتَّخِذَهَا","m":"وَيَتَّخِذَ سَبيلَ اللهِ وآياتِ كِتابِه."},{"w":"هُزُوًا","m":"مُسْتهْزَأً بِها."}],"7":[{"w":"وَلَّىٰ","m":"أَعْرَضَ وأَدْبَرَ."},{"w":"مُسۡتَكۡبِرٗا","m":"مُتَكبِّراً."},{"w":"وَقۡرٗا","m":"ثِقَلاً أو صَمَماً فلا يَنْتَفِعُ بِما يَسْمَعُ."}],"9":[{"w":"حَقّٗا","m":"أي: وَعْداً حَقّاً ثابِتاً لا شَكَّ فيه ولا خُلْفَ له."}],"10":[{"w":"عَمَدٖ","m":"دَعائِمَ، مُفْرَدُه: عِمادٌ."},{"w":"رَوَٰسِيَ","m":"أي: جِبالاً ثَوَابِتَ."},{"w":"أَن تَمِيدَ بِكُمۡ","m":"أي: لِئلا تَتَحَرَّكَ الأرْضُ وتَضْطَرِبَ بِكم."},{"w":"بَثَّ","m":"نَشَر وفَرَّقَ."},{"w":"زَوۡجٖ كَرِيمٍ","m":"صِنْفٍ حَسَنٍ كَثِيرِ المَنْفَعَةِ."}],"11":[{"w":"ضَلَٰلٖ مُّبِينٖ","m":"عُدُولٍ واضِحٍ عَنِ الطَّرِيقِ المُسْتَقِيمِ."}],"12":[{"w":"لُقۡمَٰنَ","m":"هو رَجُلٌ صالِحٌ، كَانَ مِنْ حُكَماءِ بني إسْرائِيلَ."},{"w":"ٱلۡحِكۡمَةَ","m":"العقلَ والفهمَ وإصابةَ القولِ."},{"w":"كَفَرَ","m":"أي: جَحَدَ نِعَمَ اللهِ بِعَدَمِ شُكْرِها."}],"14":[{"w":"وَصَّيۡنَا","m":"أمَرْنا."},{"w":"وَهۡنًا","m":"ضَعْفاً."},{"w":"وَفِصَٰلُهُۥ","m":"تمامُ فِطامِه عَنِ الرَّضاعَةِ."},{"w":"ٱلۡمَصِيرُ","m":"المَرْجِعُ."}],"15":[{"w":"جَٰهَدَاكَ","m":"بَذَلا الجُهْدَ وحاوَلَا أن يُجْبِرَاكَ."},{"w":"وَصَاحِبۡهُمَا","m":"عاشِرْهُما."},{"w":"أَنَابَ إِلَيَّ","m":"رَجَع إليّ بالإخْلاصِ والتَّوبة."},{"w":"مَرۡجِعُكُمۡ","m":"مَصِيرُكُم."},{"w":"فَأُنَبِّئُكُم","m":"فَأُخْبِرُكُم."}],"16":[{"w":"إِنَّهَآ","m":"أي: السَّيِّئةَ أو الحَسَنَةَ."},{"w":"مِثۡقَالَ حَبَّةٖ","m":"وَزْنَ حَبَّةٍ."},{"w":"خَرۡدَلٖ","m":"وَهُوَ أصْغَرُ الحُبُوبِ، والمرادُ أصغرُ شيءٍ."},{"w":"فِي صَخۡرَةٍ","m":"في باطِنِ جَبَلٍ."}],"17":[{"w":"بِٱلۡمَعۡرُوفِ","m":"المعْرُوفُ كُلُّ فِعْلٍ يُعْرَفُ حُسْنُه بالشَّرْعِ أو العَقْلِ."},{"w":"ٱلۡمُنكَرِ","m":"وَهُوَ كُلُّ فِعْلٍ يُنكِرُه الشَّرعُ أوِ العَقْلُ."},{"w":"مِنۡ عَزۡمِ ٱلۡأُمُورِ","m":"أي: مِنَ الأمُورِ الَّتي يَنْبَغِي العَزْمُ والحِرْصُ عليها."}],"18":[{"w":"وَلَا تُصَعِّرۡ خَدَّكَ","m":"أي: لا تُمِلْه عُجْباً واسْتِكْباراً."},{"w":"مَرَحًا","m":"فَرَحاً وبَطَراً."},{"w":"مُخۡتَالٖ","m":"مُتَكَبِّرٍ."},{"w":"فَخُورٖ","m":"مُتَباهٍ بنفسه."}],"19":[{"w":"وَٱقۡصِدۡ فِي مَشۡيِكَ","m":"أي: تَوَسَّطْ فِيه مَعَ تَوَاضُعٍ وَسَكِينَةٍ."},{"w":"وَٱغۡضُضۡ","m":"واخْفِضْ."},{"w":"أَنكَرَ ٱلۡأَصۡوَٰتِ","m":"أي: أقبَحَها."}],"20":[{"w":"سَخَّرَ لَكُم","m":"ذَلَّلَ لَكُم."},{"w":"وَأَسۡبَغَ","m":"عَمَّ وأَتَمَّ."},{"w":"يُجَٰدِلُ","m":"يُخاصِمُ."},{"w":"فِي ٱللَّهِ","m":"أي: في تَوحِيدِه وإخْلاصِ العِبادَةِ لَهُ."}],"21":[{"w":"عَذَابِ ٱلسَّعِيرِ","m":"عَذَابِ جَهَنَّمَ المُسْتَعِرَةِ."}],"22":[{"w":"يُسۡلِمۡ وَجۡهَهُۥٓ إِلَى ٱللَّهِ","m":"يُفوِّضْ إِلِيهِ أَمْرَهُ، ويُخلِصْ لَهُ عِبادَتَه."},{"w":"مُحۡسِنٞ","m":"مُطِيعٌ للهِ في أَمْرِهِ وَنَهْيِهِ."},{"w":"ٱسۡتَمۡسَكَ","m":"تمسَّكَ واعْتَصَمَ."},{"w":"بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰ","m":"العَهْدِ الأوْثَقِ، والسَّبَبِ الأقْوَى."},{"w":"عَٰقِبَةُ ٱلۡأُمُورِ","m":"مَرْجِعُها."}],"23":[{"w":"فَنُنَبِّئُهُم","m":"فَنُخْبِرُهُم."}],"24":[{"w":"نَضۡطَرُّهُمۡ","m":"نُلْجِئُهُم وَنَسُوقُهُم."},{"w":"عَذَابٍ غَلِيظٖ","m":"أي: فَظِيعٍ وثَقِيلٍ؛ وَهُوَ عَذَابُ جَهَنَّمَ."}],"27":[{"w":"يَمُدُّهُۥ","m":"أي: يَزِيدُه، فَيَصِيرُ ما في البِحارِ كلِّها مِداداً."},{"w":"مَا نَفِدَتۡ","m":"ما فَنِيَتْ."}],"28":[{"w":"كَنَفۡسٖ وَٰحِدَةٍ","m":"أي: كَخَلْقِ نَفْسٍ وَاحِدَةٍ وبَعْثِها."}],"29":[{"w":"يُولِجُ","m":"يُدخِلُ."},{"w":"سَخَّرَ","m":"ذلَّلَ."},{"w":"مُسَمّٗى","m":"مَعْلُومٍ مُحدَّدٍ."}],"31":[{"w":"ٱلۡفُلۡكَ","m":"السُّفُنَ."},{"w":"لِيُرِيَكُم","m":"ليُظْهِرَ لَكُم."},{"w":"مِنۡ ءَايَٰتِهِۦٓ","m":"أي: مِنْ آياتِه الدَّالَّةِ عَلَى قُدْرَتِه."},{"w":"لَأٓيَٰتٖ","m":"لدَلالَاتٍ."},{"w":"صَبَّارٖ شَكُورٖ","m":"أي: صَبَّارٍ عَلَى الضَّرَّاءِ، وشَكُورٍ عَلَى السَّرَّاءِ."}],"32":[{"w":"غَشِيَهُم","m":"عَلاهُم وغَطَّاهُم."},{"w":"كَٱلظُّلَلِ","m":"أي: جَمْعُ ظُلَّة: ما أَظَلَّ من جِبَال أو سَحَاب."},{"w":"مُقۡتَصِدٞ","m":"مُتَوَسِّطٌ في عَمَلِهِ وعِبادَتِه."},{"w":"يَجۡحَدُ","m":"يُنكِرُ."},{"w":"بِـَٔايَٰتِنَآ","m":"بحُجَجِنا."},{"w":"خَتَّارٖ","m":"غَدَّارٍ ناقِضٍ لِلْعهَدِ."},{"w":"كَفُورٖ","m":"جَحُودٍ للنِّعَمِ لا يَشْكُرُها."}],"33":[{"w":"وَٱخۡشَوۡاْ يَوۡمٗا","m":"أي: خافُوه واسْتَعِدُّوا لَهُ."},{"w":"لَا يَجۡزِي","m":"لا يُغْنِي."},{"w":"فَلَا تَغُرَّنَّكُمُ","m":"فلا تَخْدَعَنَّكُم."},{"w":"ٱلۡغَرُورُ","m":"ما يَغُرُّ ويَخْدَعُ مِن شَيطانٍ وَغَيرِهِ."}],"34":[{"w":"ٱلۡغَيۡثَ","m":"المَطَرَ."},{"w":"تَدۡرِي","m":"تَعْلَمُ."}]}