{"1":[{"w":"سَأَلَ سَآئِلُۢ","m":"دَعا دَاعٍ مِنَ المُشْرِكِينَ على نَفْسِهِ وَقَوْمِهِ."},{"w":"بِعَذَابٖ","m":"بِنُزُولِ العَذابِ عَلَيهِم."},{"w":"وَاقِعٖ","m":"مُتَحَقِّقِ الوُقُوعِ."}],"2":[{"w":"دَافِعٞ","m":"مانِعٌ يَمْنَعُهُ مِنَ اللهِ عَزَّ وَجَلَّ."}],"3":[{"w":"ذِي ٱلۡمَعَارِجِ","m":"صاحِبِ العُلُوِّ وَالفَوَاضِلِ."}],"4":[{"w":"تَعۡرُجُ","m":"تَصْعَدُ."},{"w":"وَٱلرُّوحُ","m":"جِبْرِيلُ."},{"w":"خَمۡسِينَ أَلۡفَ سَنَةٖ","m":"أي: مِن سَنَواتِ الدُّنيا عَلَى الكَافِرِ."}],"6":[{"w":"يَرَوۡنَهُۥ بَعِيدٗا","m":"يَرَونَ وَقُوعَ العذابِ مُسْتَحِيلاً."}],"8":[{"w":"كَٱلۡمُهۡلِ","m":"ما أُذِيب مِنَ النُّحاسِ وَغَيرِهِ."}],"9":[{"w":"كَٱلۡعِهۡنِ","m":"كالصُّوفِ."}],"10":[{"w":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا","m":"ولا يَتَفَرَّغُ قَرِيبٌ للسُّؤالِ عَنْ حالِ قَرِيبِهِ مِنَ الهَولِ والشُّغْلِ بِحالِ نَفْسِهِ."}],"11":[{"w":"يُبَصَّرُونَهُمۡ","m":"يَرَونَهُم ويَعْرِفُونَهُم، وَلَا يَسْتَطِيعُ أَحَدٌ أَن يَنفَعَ أَحَداً."},{"w":"يَوَدُّ","m":"يَتَمَنَّى."},{"w":"لَوۡ يَفۡتَدِي","m":"لو يُخَلِّصُ نَفْسَهُ بِفِدْيَةٍ."}],"13":[{"w":"وَفَصِيلَتِهِ","m":"وَعَشِيرَتِهِ."},{"w":"تُـٔۡوِيهِ","m":"تَضُمُّهُ، وَيَنْتَمِي إِلَيها في القَرَابَةِ."}],"14":[{"w":"يُنجِيهِ","m":"يُنجِيهِ الافْتِدَاءُ مِنَ العَذابِ."}],"15":[{"w":"كَلَّآ","m":"لا افْتِدَاءَ وَلَا إِنْجَاءَ."}],"19":[{"w":"هَلُوعًا","m":"شَدِيدَ الجَزَعِ والحِرْصِ."}],"21":[{"w":"ٱلۡخَيۡرُ","m":"ما يَنفَعُ الإِنْسَانَ."},{"w":"مَنُوعًا","m":"كَثِيرَ المنْعِ للخيرِ."}],"23":[{"w":"دَآئِمُونَ","m":"مُواظِبُونَ على أدائِها."}],"24":[{"w":"حَقّٞ مَّعۡلُومٞ","m":"نَصِيبٌ مُعَيَّنٌ لِذَوِي الحاجاتِ."}],"25":[{"w":"وَٱلۡمَحۡرُومِ","m":"الَّذِي يَتَعَفَّفُ عَن سُؤالِ النَّاسِ مَعَ حاجَتِهِ؛ فَلَا يَتَفَطَّن لَهُ كَثِيرٌ مِنَ النَّاسِ."}],"26":[{"w":"بِيَوۡمِ ٱلدِّينِ","m":"بيومِ الجَزَاءِ."}],"27":[{"w":"مُشۡفِقُونَ","m":"خائِفُونَ."}],"28":[{"w":"غَيۡرُ مَأۡمُونٖ","m":"لَا يَأمَنُه أَحَدٌ مِمَّنْ عَقَلَ عَنِ اللهِ أَمْرَهُ، إلا بِأَمانٍ مِنَ اللهِ تَبارَكَ وَتَعالى."}],"29":[{"w":"لِفُرُوجِهِمۡ حَٰفِظُونَ","m":"يَحْفظُونَ أَنْفُسَهُم مِنَ الحَرَامِ."}],"30":[{"w":"أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ","m":"النِّساءِ الإِمَاءِ."},{"w":"غَيۡرُ مَلُومِينَ","m":"غَيرُ مؤاخَذِينَ."}],"31":[{"w":"وَرَآءَ ذَٰلِكَ","m":"غَيرَ الزَّوجاتِ والمملُوكاتِ."},{"w":"ٱلۡعَادُونَ","m":"المُجَاوِزُون مَا أحَلَّ اللهُ لَهُمْ إلَى ما حَرَّم عَلَيهم."}],"32":[{"w":"لِأَمَٰنَٰتِهِمۡ","m":"لأماناتِ اللهِ، وأماناتِ النَّاسِ الَّتِي اؤْتُمِنُوا عَلَيها."},{"w":"وَعَهۡدِهِمۡ","m":"عُهُودِهِم مَعَ اللهِ، وَمَعَ العِبادِ."},{"w":"رَٰعُونَ","m":"حافِظُونَ."}],"33":[{"w":"بِشَهَٰدَٰتِهِمۡ","m":"بِما عِنْدَهُم مِنَ الدَّلالةِ عَلى حَقٍّ لِغَيرِهِم."},{"w":"قَآئِمُونَ","m":"يَهْتَمُّونَ بِها، وَيَحْفَظُونَها إلى أن تُؤَدَّى."}],"34":[{"w":"يُحَافِظُونَ","m":"يعتَنُونَ باسْتِكْمالِ أَرْكانِها وَشُرُوطِها وَأَوْقاتِها."}],"35":[{"w":"مُكۡرَمُونَ","m":"يُكْرَمُونَ بِحُسْنِ اللقاءِ، والثَّناءِ، وَأَنْواعِ اللذَّاتِ، والمَسارِّ."}],"36":[{"w":"فَمَالِ ٱلَّذِينَ كَفَرُواْ","m":"فأيُّ شَيءٍ ثَبَتَ لَهُم؟"},{"w":"قِبَلَكَ","m":"في حالِ كَونِهِم عِندَك."},{"w":"مُهۡطِعِينَ","m":"مُسْرِعِينَ، وَقَدْ مَدُّوا أَعْناقَهُم إِليكَ مُقْبِلِينَ عَلَيكَ."}],"37":[{"w":"عِزِينَ","m":"مُتَفَرِّقِينَ."}],"39":[{"w":"مِمَّا يَعۡلَمُونَ","m":"مِن مَّاءٍ مَهِينٍ كَغَيرِهِم."}],"40":[{"w":"ٱلۡمَشَٰرِقِ","m":"مَشارِقِ الشَّمْسِ والكَوَاكِبِ."},{"w":"وَٱلۡمَغَٰرِبِ","m":"مَغارِبِ الشَّمْسِ والكَوَاكِبِ."}],"41":[{"w":"وَمَا نَحۡنُ بِمَسۡبُوقِينَ","m":"وَما أَحَدٌ يَفُوتُنا ويُعْجِزُنا."}],"42":[{"w":"فَذَرۡهُمۡ","m":"فاتْرُكْهُم."},{"w":"يَخُوضُواْ","m":"يَتَكلَّمُوا في باطِلِهِم عَلَى غَيرِ هُدىً."},{"w":"وَيَلۡعَبُواْ","m":"في دُنْياهُم."}],"43":[{"w":"ٱلۡأَجۡدَاثِ","m":"القُبُورِ."},{"w":"سِرَاعٗا","m":"مُسْرِعِينَ."},{"w":"نُصُبٖ","m":"أصْنامٍ."},{"w":"يُوفِضُونَ","m":"يُهَرْوِلُونَ، وَيُسْرِعُونَ أيُّهُم يَسْتَلِمُه أَوَّلُ؟"}],"44":[{"w":"خَٰشِعَةً","m":"ذَلِيلةً مُنْكَسِرَةً."},{"w":"تَرۡهَقُهُمۡ","m":"تَغْشاهُم."},{"w":"ذِلَّةٞ","m":"حَقارَةٌ وَمَهانَةٌ."}]}