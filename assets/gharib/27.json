{"1":[{"w":"طسٓ","m":"سَبَقَ الكَلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"4":[{"w":"يَعۡمَهُونَ","m":"يَتَرَدَّدُونَ ويَتَحَيَّرُونَ."}],"7":[{"w":"ءَانَسۡتُ","m":"أَبْصَرْتُ ما يُؤْنِسُ."},{"w":"بِشِهَابٖ قَبَسٖ","m":"بِشُعْلَةِ نارٍ مَقْبُوسَةٍ، أي: مأخُوذَةٍ."},{"w":"تَصۡطَلُونَ","m":"تَسْتَدْفِئُونَ بِها."}],"8":[{"w":"بُورِكَ مَن فِي ٱلنَّارِ","m":"أي: إنَّ اللهَ باركَ مَن فِي النَّارِ، ومَنْ حَولَها مِنَ الملائِكَةِ."}],"10":[{"w":"تَهۡتَزُّ","m":"تَتَحَرَّكُ بخِفَّةٍ."},{"w":"جَآنّٞ","m":"حَيَّةٌ خَفِيفَةٌ في سُرْعَةِ حَرَكَتِها."},{"w":"وَلَّىٰ","m":"هرَبَ."},{"w":"وَلَمۡ يُعَقِّبۡ","m":"لم يَرْجِعْ."}],"12":[{"w":"فِي جَيۡبِكَ","m":"في فَتْحَةِ قَمِيصِكَ الَّتي يُدْخَلُ منها الرَّأسُ."},{"w":"مِنۡ غَيۡرِ سُوٓءٖ","m":"مِنْ غَيرِ بَرَصٍ ولا مَرَضٍ."},{"w":"فِي تِسۡعِ ءَايَٰتٍ","m":"وهي: اليدُ، والْعَصَا، والسِّنونَ، ونَقْصُ الثَّمراتِ، والطُّوفانُ، والجَرَادُ، والقُمَّلُ، والضَّفادِعُ، والدَّمُ."}],"13":[{"w":"مُبۡصِرَةٗ","m":"واضِحَةً هادِيةً."}],"14":[{"w":"وَجَحَدُواْ بِهَا","m":"أنْكَرُوهَا بألْسِنَتِهِم."},{"w":"وَعُلُوّٗا","m":"تَرَفُّعاً واسْتِكْباراً عَنِ الإيمانِ بِها."}],"16":[{"w":"وَوَرِثَ سُلَيۡمَٰنُ دَاوُۥدَ","m":"أي: نُبوَّتَه وعِلْمَه ومُلْكَه."},{"w":"مَنطِقَ ٱلطَّيۡرِ","m":"فَهْمَ أغْرَاضِه كلِّها مِنْ أصْواتِه."},{"w":"وَأُوتِينَا","m":"وأُعْطِينا."}],"17":[{"w":"وَحُشِرَ","m":"وجُمِعَ."},{"w":"فَهُمۡ يُوزَعُونَ","m":"فهم يُكَفُّونَ عَنِ التَّفرُّقِ، فكان على كُلِّ جِنْسٍ مَن يَرُدُّ أوَّلَهم على آخِرِهم كي يقِفُوا ويسِيرُوا مُنْتَظِمِينَ."}],"18":[{"w":"لَا يَحۡطِمَنَّكُمۡ","m":"أي: لا تُمَكِّنوهُم مِن قَتْلِكُم وإهْلَاكِكُم."}],"19":[{"w":"أَوۡزِعۡنِيٓ","m":"أَلْهِمْنِي ووَفِّقْنِي."}],"21":[{"w":"بِسُلۡطَٰنٖ مُّبِينٖ","m":"بِحُجَّةٍ تُبيِّنُ عُذْرَه في غِيابِه."}],"22":[{"w":"أَحَطتُ","m":"عَلِمْتُ الأمرَ مِن جَميعِ جِهاتِهِ."},{"w":"سَبَإِۭ","m":"بَلَدٍ باليمنِ، سُمِّي باسْمِ «سَبأِ بنِ يَشْجُبَ»، ويقَعُ شَرْقَ صَنْعَاء، ويُسَمَّى الآنَ «مَأْرِباً»."}],"23":[{"w":"وَلَهَا عَرۡشٌ","m":"أي: سَرِيرُ المُلْكِ، تَجْلِسُ عليه لإدارةِ مُلْكِها."}],"24":[{"w":"فَصَدَّهُمۡ","m":"فَصَرَفَهُم."}],"25":[{"w":"ٱلۡخَبۡءَ","m":"المخْبُوءَ المسْتُورَ."}],"27":[{"w":"سَنَنظُرُ","m":"أي: سَنَتَأَمَّلُ."}],"28":[{"w":"تَوَلَّ عَنۡهُمۡ","m":"تَنَحَّ عَنْهُم."}],"31":[{"w":"أَلَّا تَعۡلُواْ عَلَيَّ","m":"ألَّا تَتَكَبَّرُوا عليَّ."}],"32":[{"w":"يَٰٓأَيُّهَا ٱلۡمَلَؤُاْ","m":"يا أيُّها الأشْرَافُ."},{"w":"أَفۡتُونِي","m":"أشِيرُوا عَليَّ."},{"w":"قَاطِعَةً أَمۡرًا","m":"مُبْرِمَةً أمْراً."},{"w":"تَشۡهَدُونِ","m":"تَحْضُرُونِ."}],"33":[{"w":"وَأُوْلُواْ بَأۡسٖ","m":"أصْحَابُ نَجْدةٍ وبَلَاءٍ في الحرْبِ."}],"35":[{"w":"فَنَاظِرَةُۢ","m":"فمُنتَظِرةٌ."}],"37":[{"w":"لَا قِبَلَ لَهُم بِهَا","m":"لا طَاقَةَ لَهُم بِمُقَاوَمَتِها."},{"w":"صَٰغِرُونَ","m":"ذَلِيلُونَ مُهَانُونَ."}],"39":[{"w":"عِفۡرِيتٞ","m":"مارِدٌ قويٌّ شَدِيدٌ."}],"40":[{"w":"أَن يَرۡتَدَّ","m":"أن يَرْجِعَ."},{"w":"طَرۡفُكَ","m":"نَظَرُكَ."},{"w":"لِيَبۡلُوَنِيٓ","m":"لِيَخْتَبِرَنِي."},{"w":"أَمۡ أَكۡفُرُ","m":"أي: بِتَرْكِ شُكْرِ النِّعْمةِ."}],"41":[{"w":"نَكِّرُواْ","m":"غيِّرُوا."}],"42":[{"w":"وَأُوتِينَا ٱلۡعِلۡمَ","m":"وأُعْطِينا العِلْمَ بِاللهِ وبِقُدْرَتِه."}],"44":[{"w":"ٱلصَّرۡحَ","m":"القَصْرَ."},{"w":"حَسِبَتۡهُ لُجَّةٗ","m":"ظنَّتْهُ ماءً تتردَّدُ أَمْوَاجُه."},{"w":"مُمَرَّدٞ","m":"أمْلَسُ."},{"w":"مِن قَوَارِيرَ","m":"مِن زُجَاجٍ صافٍ شَفَّافٍ."}],"45":[{"w":"يَخۡتَصِمُونَ","m":"يَتَنَازَعُونَ."}],"46":[{"w":"بِٱلسَّيِّئَةِ قَبۡلَ ٱلۡحَسَنَةِ","m":"أي: بالكُفْرِ قَبْلَ الإيمانِ."}],"47":[{"w":"ٱطَّيَّرۡنَا بِكَ","m":"تَشَاءَمْنا بِكَ، لأنَّنا أُصِبْنا بالشَّدائِدِ."},{"w":"طَٰٓئِرُكُمۡ","m":"شُؤْمُكُم."},{"w":"عِندَ ٱللَّهِ","m":"أي: قَدَّرَهُ اللهُ عَلَيكُم."},{"w":"تُفۡتَنُونَ","m":"تُمتَحَنُونَ وتُخْتَبرُونَ."}],"48":[{"w":"رَهۡطٖ","m":"رِجَالٍ مِنْ أبْنَاءِ الأشْرَافِ."}],"49":[{"w":"تَقَاسَمُواْ بِٱللَّهِ","m":"تحَالَفُوا باللهِ."},{"w":"لَنُبَيِّتَنَّهُۥ","m":"لَنَأْتِيَنَّهُ بَغْتَةً في الليلِ، فَنْقتُلَهُ."},{"w":"مَا شَهِدۡنَا","m":"ما حَضَرْنا."}],"50":[{"w":"وَمَكَرُواْ","m":"دبَّرُوا الشَّرَّ بِحِيلَةٍ."}],"51":[{"w":"دَمَّرۡنَٰهُمۡ","m":"أهْلكْناهُم."}],"52":[{"w":"خَاوِيَةَۢ","m":"خَالِيةً خَرِبةً."}],"56":[{"w":"يَتَطَهَّرُونَ","m":"يَتَنَزَّهُونَ عَنْ إِتْيانِ الرِّجالِ."}],"57":[{"w":"مِنَ ٱلۡغَٰبِرِينَ","m":"مِنَ الباقِينَ في العَذَابِ والهَلَاكِ."}],"59":[{"w":"ٱصۡطَفَىٰٓ","m":"اخْتارَ."}],"60":[{"w":"حَدَآئِقَ ذَاتَ بَهۡجَةٖ","m":"بَسَاتِينَ ذاتَ مَنْظَرٍ حَسَنٍ."},{"w":"يَعۡدِلُونَ","m":"يَنْحَرِفُونَ عَن طَرِيقِ الحقِّ إلى طَرِيقِ الباطِلِ وهو الشِّركُ."}],"61":[{"w":"قَرَارٗا","m":"مُسْتَقَرّاً."},{"w":"خِلَٰلَهَآ","m":"وَسَطَها."},{"w":"رَوَٰسِيَ","m":"جِبالاً ثَوَابِتَ."},{"w":"ٱلۡبَحۡرَيۡنِ","m":"العَذْبِ والمِلْحِ."},{"w":"حَاجِزًا","m":"فاصِلاً يَمْنَعُ اخْتِلَاطَهُما."}],"62":[{"w":"ٱلۡمُضۡطَرَّ","m":"الَّذي أَصابَه بَلَاءٌ وَشِدَّةٌ."},{"w":"خُلَفَآءَ","m":"أي: تَخْلُفُونَ مَنْ سَبَقَكُم في الأرضِ."}],"63":[{"w":"بُشۡرَۢا","m":"تُبَشِّرُ بالمَطَرِ."}],"64":[{"w":"يَبۡدَؤُاْ ٱلۡخَلۡقَ","m":"يُنْشِئُه."},{"w":"بُرۡهَٰنَكُمۡ","m":"حُجَّتَكُم."}],"65":[{"w":"أَيَّانَ يُبۡعَثُونَ","m":"مَتَى يُبْعثُونَ مِن قُبُورِهِم."}],"66":[{"w":"بَلِ ٱدَّٰرَكَ عِلۡمُهُمۡ فِي ٱلۡأٓخِرَةِ","m":"بَلْ تَكَامَلَ علمُهُم بِها عِنْدَما بُعِثُوا يومَ القيامةِ."},{"w":"فِي شَكّٖ مِّنۡهَا","m":"أي: مِنَ الآخِرةِ في الدُّنيا."},{"w":"عَمُونَ","m":"أي: غافِلُونَ، فَقُلُوبُهُم عَمْيَاءُ."}],"67":[{"w":"لَمُخۡرَجُونَ","m":"لمَبْعُوثُونَ مِن قُبُورِنا."}],"68":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"الأكاذيبُ الَّتي كَتَبها المتقدِّمُونَ."}],"70":[{"w":"ضَيۡقٖ","m":"حَرَجٍ وضِيقِ صَدْرٍ."}],"72":[{"w":"رَدِفَ لَكُم","m":"لَحِقَكُم، أو اقْتَرَبَ لَكُم."}],"74":[{"w":"مَا تُكِنُّ","m":"ما تُخْفِي."},{"w":"وَمَا يُعۡلِنُونَ","m":"وما يُظْهِرُونَ."}],"75":[{"w":"غَآئِبَةٖ","m":"هو كلُّ ما يَغيبُ ويَخْفى عَلى الخَلْقِ."},{"w":"كِتَٰبٖ مُّبِينٍ","m":"وَاضِحٍ، وهو اللَّوْحُ المحْفُوظ."}],"80":[{"w":"مُدۡبِرِينَ","m":"مُعْرِضِينَ."}],"82":[{"w":"وَقَعَ ٱلۡقَوۡلُ","m":"أي: وَجَبَ العَذَابُ."},{"w":"دَآبَّةٗ","m":"هي مِنْ أشْراطِ السَّاعةِ الكُبْرى."},{"w":"تُكَلِّمُهُمۡ","m":"تُحدِّثُهُم."},{"w":"لَا يُوقِنُونَ","m":"لا يُصَدِّقُونَ."}],"83":[{"w":"نَحۡشُرُ","m":"نَجْمَعُ."},{"w":"فَهُمۡ يُوزَعُونَ","m":"فهم يُكَفُّونَ عَنِ التَّفَرُّقِ، فكان على كُلِّ جِنْسٍ مَنْ يَرُدُّ أوَّلَهم على آخِرِهِم ثُمَّ يُسَاقُون جميعاً."}],"87":[{"w":"ٱلصُّورِ","m":"القَرْنِ الَّذي يُنفَخُ فيهِ للبَعْثِ."},{"w":"فَفَزِعَ","m":"خافَ خَوْفاً شَدِيداً مِنْ هَوْلِ النَّفخَةِ."},{"w":"دَٰخِرِينَ","m":"صاغِرِينَ مُطِيعِينَ."}],"88":[{"w":"تَحۡسَبُهَا جَامِدَةٗ","m":"تَظُنُّها ثابِتةً في أماكِنِها."},{"w":"مَرَّ ٱلسَّحَابِ","m":"مِثْلَ السَّحابِ الَّذي تُسَيِّرُه الرِّياحُ."}],"90":[{"w":"فَكُبَّتۡ وُجُوهُهُمۡ فِي ٱلنَّارِ","m":"أي: أُلقُوا على وُجُوهِهِم فِيها."}],"91":[{"w":"حَرَّمَهَا","m":"جَعَلها حَرَماً آمِناً لا يُسْفَكُ فيها دَمٌ."}]}