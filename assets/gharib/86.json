{"1":[{"w":"وَٱلطَّارِقِ","m":"أَقْسَمَ اللهُ سُبحانَهُ بالنَّجْمِ الَّذِي يَطْرُقُ ليلاً."}],"2":[{"w":"وَمَآ أَدۡرَىٰكَ","m":"وأيُّ شَيءٍ أَعْلَمَكَ؟"},{"w":"مَا ٱلطَّارِقُ","m":"ما عِظَمُ هذا النَّجمِ؟"}],"3":[{"w":"ٱلنَّجۡمُ ٱلثَّاقِبُ","m":"النَّجمُ المُضِيءُ المُتَوهِّجُ."}],"4":[{"w":"إِن","m":"ما."},{"w":"لَمَّا","m":"إلَّا."},{"w":"عَلَيۡهَا حَافِظٞ","m":"أُوْكِلَ بها مَلَكٌ رَقِيبٌ يَحْفَظُ عَلَيها أَعْمَالَها."}],"6":[{"w":"مَآءٖ دَافِقٖ","m":"مَنيٍّ مُنْصَبٍّ بِسُرعَةٍ في الرَّحِم."}],"7":[{"w":"ٱلصُّلۡبِ","m":"العَمُودِ العَظْميِّ في وَسَطِ الظَّهْرِ، وهو ذُو الفِقْراتِ."},{"w":"وَٱلتَّرَآئِبِ","m":"جَمْع ترِيبةٍ، وهي عظامُ الصَّدرِ الَّتِي بَينَ التَّرقُوَتَينِ والثَّديينِ."}],"8":[{"w":"رَجۡعِهِۦ","m":"إعادَتِهِ إلى الحياةِ بَعْدَ الموتِ."}],"9":[{"w":"تُبۡلَى","m":"تُخْتَبرُ."},{"w":"ٱلسَّرَآئِرُ","m":"ما يُخْفيهِ الإِنسانُ مِنَ العقائِدِ والأعْمالِ."}],"10":[{"w":"قُوَّةٖ","m":"يدفعُ بِها عَن نَّفْسِهِ."}],"11":[{"w":"ذَاتِ ٱلرَّجۡعِ","m":"ذَاتِ المطَرِ الَّذِي يَرْجِعُ وَ يَتَكَرَّرُ."}],"12":[{"w":"ٱلصَّدۡعِ","m":"التَّشَقُّقِ بِما يَتَخلَّلُها مِن نَّباتٍ."}],"13":[{"w":"فَصۡلٞ","m":"فاصِلٌ بَيْنَ الحقِّ والباطِلِ."}],"14":[{"w":"بِٱلۡهَزۡلِ","m":"باللَّعِبِ والباطِل."}],"15":[{"w":"يَكِيدُونَ كَيۡدٗا","m":"يُخْفونَ قَصْدَ الضُّرِّ ويُظْهِرُونَ خِلافَه."}],"16":[{"w":"وَأَكِيدُ كَيۡدٗا","m":"لإِظْهارِ الحقِّ."}],"17":[{"w":"فَمَهِّلِ ٱلۡكَٰفِرِينَ","m":"فأنْظِرْهُم."},{"w":"أَمۡهِلۡهُمۡ","m":"أنْظِرْهُم."},{"w":"رُوَيۡدَۢا","m":"مُهلةً غيرَ طويلةٍ."}]}