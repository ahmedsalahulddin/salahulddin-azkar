{"1":[{"w":"يَغۡشَىٰ","m":"يُغَطِّي بِظلامِهِ الأَرْضَ وَمَا عَلَيها."}],"2":[{"w":"تَجَلَّىٰ","m":"انكَشَفَ عَن ظَلام الليلِ بضِيائِهِ."}],"3":[{"w":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","m":"أَقْسَمَ اللهُ بِخَلْقِ الزَّوجينِ."}],"4":[{"w":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","m":"عَمَلَكُم لَمُخْتَلِفٌ بَينَ عامِلٍ للدُّنيا وعامِلٍ للآخِرَةِ."}],"5":[{"w":"أَعۡطَىٰ","m":"بَذَلَ مِن مَّالِهِ."}],"6":[{"w":"بِٱلۡحُسۡنَىٰ","m":"بـ «لَا إِلَه إلا اللهُ» وما دَلَّتْ عَلَيهِ، وما تَرتَّبَ عَلَيها مِنَ الجَزاءِ."}],"7":[{"w":"فَسَنُيَسِّرُهُۥ","m":"فَسَنُوَفِّقُهُ."},{"w":"لِلۡيُسۡرَىٰ","m":"لِعَمَلِ الخيرِ والشَّرِيعةِ السَّهْلَةِ."}],"8":[{"w":"بَخِلَ","m":"بِمالِهِ."},{"w":"وَٱسۡتَغۡنَىٰ","m":"عَن جزاءِ اللهِ."}],"9":[{"w":"بِٱلۡحُسۡنَىٰ","m":"بِالْعِوَضِ مِنَ اللهِ."}],"10":[{"w":"فَسَنُيَسِّرُهُۥ","m":"فسَنُهَيِّئُهُ في الدُّنيا."},{"w":"لِلۡعُسۡرَىٰ","m":"للْخَصْلَةِ العُسْرى، فَتَتَعَسَّرُ عَلَيه أسبابُ الخيرِ."}],"11":[{"w":"وَمَا يُغۡنِي عَنۡهُ","m":"ولا يَنفَعُهُ."},{"w":"تَرَدَّىٰٓ","m":"وَقَعَ في النَّارِ."}],"12":[{"w":"لَلۡهُدَىٰ","m":"بيانَ طَرِيقِ الهُدَى المُوصِلِ إلى اللهِ."}],"13":[{"w":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ","m":"وإِنَّ لَنا مُلْكَ الحياةِ الآخِرَةِ."},{"w":"وَٱلۡأُولَىٰ","m":"والحياةَ الدُّنيا."}],"14":[{"w":"فَأَنذَرۡتُكُمۡ","m":"فَحَذَّرْتُكُم."},{"w":"نَارٗا تَلَظَّىٰ","m":"ناراً تَتَوهَّجُ، وهي نَارُ جَهَنَّمَ."}],"15":[{"w":"لَا يَصۡلَىٰهَآ","m":"لا يُقاسِي حَرَّها."}],"16":[{"w":"كَذَّبَ","m":"أي: نبيَّ اللهِ محمدًا ﷺ."},{"w":"وَتَوَلَّىٰ","m":"وَأَعْرَضَ عَنِ الإيمانِ باللهِ ورسولِه، وطاعَتِهِما."}],"17":[{"w":"وَسَيُجَنَّبُهَا","m":"وَسَيُزَحْزَحُ عَنْها."}],"18":[{"w":"يُؤۡتِي مَالَهُۥ","m":"يَبْذُلُ مالَهُ."},{"w":"يَتَزَكَّىٰ","m":"يَطلبُ المزيدَ مِنَ الخيرِ."}],"19":[{"w":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ","m":"وَلَيسَ إِنفَاقُه ذَاكَ مُكَافأةً لِمنْ أَسْدَى إِلَيهِ معرُوفاً."}],"20":[{"w":"إِلَّا","m":"لَكِنَّهُ."}]}