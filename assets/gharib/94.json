{"1":[{"w":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","m":"أَلَمْ نُوَسِّعْ -أَيُّها النَّبِيُّ- لَكَ صَدْرَكَ لِشرائِعِ الدِّينِ، والدَّعْوةِ إلى اللهِ، والاتِّصافِ بِمكارِمِ الأخلاقِ."}],"2":[{"w":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","m":"وَحَطَطْنا عَنكَ بِذَلِكَ حِمْلكَ."}],"3":[{"w":"أَنقَضَ","m":"أَثْقَلَ."}],"5":[{"w":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","m":"فإنَّ مَعَ الضِّيقِ فَرَجاً."}],"7":[{"w":"فَرَغۡتَ","m":"أتْمَمْتَ عَمَلاً مِنْ أُمُورِ الدُّنيا."},{"w":"فَٱنصَبۡ","m":"فَجِدَّ في الِعبادةِ."}]}