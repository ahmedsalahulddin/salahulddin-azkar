{"1":[{"w":"تَبَٰرَكَ ٱلَّذِي","m":"تَكَاثَرَ خَيرُ اللهِ وبِرُّهُ عَلَى جَمِيعِ خَلْقِهِ."},{"w":"بِيَدِهِ ٱلۡمُلۡكُ","m":"التَّصَرُّفُ في مُلْكِ الدُّنيا والآخِرَةِ."}],"2":[{"w":"لِيَبۡلُوَكُمۡ","m":"لِيَخْتَبِرَكُم."}],"3":[{"w":"طِبَاقٗا","m":"مُتَناسِقَةً."},{"w":"تَفَٰوُتٖ","m":"اخْتِلافٍ وَتَبايُنٍ."},{"w":"فَٱرۡجِعِ ٱلۡبَصَرَ","m":"فَأَعِدِ النَّظَرَ."},{"w":"فُطُورٖ","m":"شُقُوقٍ أو صُدُوعٍ."}],"4":[{"w":"كَرَّتَيۡنِ","m":"مَرَّةً بَعْدَ مَرَّةٍ."},{"w":"يَنقَلِبۡ","m":"يَرْجِعْ."},{"w":"خَاسِئٗا","m":"ذَلِيلاً صاغِراً."},{"w":"حَسِيرٞ","m":"مُتْعَبٌ كَلِيلٌ."}],"5":[{"w":"ٱلدُّنۡيَا","m":"القَرِيبةَ."},{"w":"بِمَصَٰبِيحَ","m":"بِنُجُومٍ عَظِيمَةٍ مُضِيئةٍ."},{"w":"رُجُومٗا","m":"شُهُباً مُحْرِقَةً."},{"w":"لِلشَّيَٰطِينِ","m":"لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّياطِينِ."},{"w":"ٱلسَّعِيرِ","m":"النَّارِ المُوقَدَةِ."}],"6":[{"w":"وَبِئۡسَ ٱلۡمَصِيرُ","m":"وَسَاءَ المَرْجِعُ لهم جَهَنَّمُ."}],"7":[{"w":"أُلۡقُواْ","m":"طُرِحُوا."},{"w":"شَهِيقٗا","m":"صَوْتاً شَدِيداً مُنْكَراً."},{"w":"تَفُورُ","m":"تَغْلِي غَلَيَاناً شَدِيداً."}],"8":[{"w":"تَمَيَّزُ","m":"تَتَمَزَّقُ."},{"w":"مِنَ ٱلۡغَيۡظِ","m":"مِن شِدَّةِ غَضَبِها عَلَى الكُفَّارِ."},{"w":"أُلۡقِيَ","m":"طُرِحَ."},{"w":"فَوۡجٞ","m":"جَماعةٌ مِنَ النَّاسِ."},{"w":"خَزَنَتُهَا","m":"الملائِكةُ المُوكَّلُونَ بأَمْرِها."},{"w":"نَذِيرٞ","m":"رَسُولٌ يُحَذِّرُكُم مِنْ هَذا العَذابِ."}],"10":[{"w":"نَسۡمَعُ","m":"سَمَاعَ مَن يَطْلُبُ الحقَّ."},{"w":"نَعۡقِلُ","m":"نُفَكِّرُ فِيما نُدْعَى إِلَيهِ."},{"w":"ٱلسَّعِيرِ","m":"النَّارِ المُوقَدَةِ."}],"11":[{"w":"فَسُحۡقٗا","m":"فَبُعْداً عَن رَحْمَةِ اللهِ."}],"12":[{"w":"بِٱلۡغَيۡبِ","m":"وَهُمْ غائِبُونَ عَنْ أعْيُنِ النَّاسِ، وَقَبْلَ مُعايَنَةِ العَذابِ."},{"w":"وَأَجۡرٞ","m":"ثَوَابٌ."}],"13":[{"w":"وَأَسِرُّواْ","m":"وأَخْفُوا."},{"w":"أَوِ ٱجۡهَرُواْ بِهِۦٓ","m":"أَعْلِنُوهُ."},{"w":"بِذَاتِ ٱلصُّدُورِ","m":"بِما يَتَرَدَّدُ في النَّفْسِ مِنَ الخواطِرِ والنِّياتِ."}],"14":[{"w":"يَعۡلَمُ","m":"اللهُ."},{"w":"مَنۡ خَلَقَ","m":"المخلُوقِينَ."},{"w":"ٱللَّطِيفُ","m":"العالِمُ خَبايا الأُمُورِ والمُدَبِّرُ لَها بِرِفْقٍ وَحِكْمَةٍ."},{"w":"ٱلۡخَبِيرُ","m":"العَلِيمُ بِباطِنِ أَمرِهِم."}],"15":[{"w":"ذَلُولٗا","m":"سَهْلةً مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيها."},{"w":"مَنَاكِبِهَا","m":"نواحِيها وَجَوَانِبِها."},{"w":"ٱلنُّشُورُ","m":"البَعْثُ مِن قُبُورِكُم لِلْحِسابِ."}],"16":[{"w":"ءَأَمِنتُم","m":"هَلْ أَمِنْتُم؟"},{"w":"مَن فِي ٱلسَّمَآءِ","m":"الَّذِي فَوقَ السَّماءِ."},{"w":"يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ","m":"يَقْلِبَ ظاهِرَ الأرضِ باطِناً، وباطِنَها ظاهِراً مُصاحِبةً لِذَواتِكم."},{"w":"تَمُورُ","m":"تَضْطَرِبُ بِكُم حَتَّى تَهْلِكُوا."}],"17":[{"w":"حَاصِبٗا","m":"رِيحاً تَرْجُمُكُم بالحِجارةِ الصَّغِيرةِ."},{"w":"نَذِيرِ","m":"تَحْذِيرِي لَكُم."}],"18":[{"w":"نَكِيرِ","m":"إِنْكارِي عَلَيهِم بإنْزَالِ العَذابِ بِهِم."}],"19":[{"w":"صَٰٓفَّٰتٖ","m":"باسِطاتٍ أَجْنِحَتَها عِنْدَ طَيَرَانِها في الهواءِ."},{"w":"وَيَقۡبِضۡنَ","m":"ويَضْمُمْنَ أَجْنِحَتَها."}],"20":[{"w":"أَمَّنۡ هَٰذَا","m":"بَلْ مَنْ هَذا."},{"w":"جُندٞ لَّكُمۡ","m":"حِزْبٌ لَكُم."},{"w":"مِن دُونِ ٱلرَّحۡمَٰنِ","m":"مِن غَيْرِ الرَّحمنِ."},{"w":"إِن","m":"ما."},{"w":"غُرُورٍ","m":"خِدَاعٍ وضَلَالٍ مِنَ الشَّيطانِ."}],"21":[{"w":"لَجُّواْ","m":"اسْتَمَرُّوا في طُغْيانِهِم وَكُفْرِهِم."},{"w":"عُتُوّٖ","m":"مُعانَدَةٍ واسْتِكْبارٍ"},{"w":"وَنُفُورٍ","m":"فِرارٍ مِنَ الحقِّ."}],"22":[{"w":"مُكِبًّا","m":"ساقِطاً عَلَى وَجْهِهِ."},{"w":"أَهۡدَىٰٓ","m":"أَشَدُّ اسْتِقامةً عَلى الطَّرِيقةِ."},{"w":"سَوِيًّا","m":"مُسْتَوِياً."}],"23":[{"w":"أَنشَأَكُمۡ","m":"أَوْجَدَكُم مِن العَدَمِ."},{"w":"وَٱلۡأَفۡـِٔدَةَ","m":"القُلُوبَ."}],"24":[{"w":"ذَرَأَكُمۡ","m":"خَلَقَكُم وَنَشَرَكُم."},{"w":"تُحۡشَرُونَ","m":"تُجْمَعُونَ لِلْحِسابِ والجَزَاءِ."}],"26":[{"w":"نَذِيرٞ","m":"مُخَوِّفٌ."},{"w":"مُبِينٞ","m":"أُبَيِّنُ لَكُمُ الشَّرَائِعَ."}],"27":[{"w":"زُلۡفَةٗ","m":"قَرِيباً مِنْهُم."},{"w":"سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ","m":"ظَهَرَتْ عَلَيها الذِّلَّةُ والكآبةُ."},{"w":"بِهِۦ تَدَّعُونَ","m":"تَطْلُبُونَ تَعْجِيلَه في الدُّنيا."}],"28":[{"w":"أَرَءَيۡتُمۡ","m":"أَخْبِرُوني."},{"w":"أَهۡلَكَنِيَ","m":"أماتَنِي."},{"w":"يُجِيرُ","m":"يَحْمِي وَيَمْنَعُ."}],"29":[{"w":"ءَامَنَّا بِهِۦ","m":"صَدَّقْنا بِهِ وَعَمِلْنا بِشَرْعِهِ."},{"w":"تَوَكَّلۡنَا","m":"اعْتَمَدْنا في كُلِّ أُمُورِنا."},{"w":"ضَلَٰلٖ","m":"بُعْدٍ عَن صِراطِ اللهِ المُسْتَقِيمِ."}],"30":[{"w":"أَرَءَيۡتُمۡ","m":"أَخْبِرُونِي."},{"w":"أَصۡبَحَ","m":"صارَ."},{"w":"غَوۡرٗا","m":"ذاهِباً في الأرضِ لا تصِلُونَ إِلَيهِ."},{"w":"مَعِينِۭ","m":"جارٍ على وَجْهِ الأَرْضِ تَرَاهُ العُيُونُ."}]}