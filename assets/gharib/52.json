{"1":[{"w":"وَٱلطُّورِ","m":"هُوَ الجَبَلُ الَّذِي كَلَّمَ اللهُ عَلَيهِ مُوسَى عَلَيهِ السَّلامُ."}],"2":[{"w":"مَسۡطُورٖ","m":"مَكْتُوبٍ، وَهُو القُرآنُ."}],"3":[{"w":"فِي رَقّٖ مَّنشُورٖ","m":"مَكْتُوبٍ في صَحِيفةٍ مَبْسُوطَةٍ."}],"4":[{"w":"وَٱلۡبَيۡتِ ٱلۡمَعۡمُورِ","m":"هو فَوْقَ السَّماءِ السَّابِعةِ، تَطُوفُ بِه الملائِكةُ دائِماً."}],"5":[{"w":"وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ","m":"هو السَّماءُ الدُّنيا، جَعَلَها اللهُ سَقْفاً للأرْضِ."}],"6":[{"w":"ٱلۡمَسۡجُورِ","m":"الممْلُوءِ بالمياهِ."}],"8":[{"w":"دَافِعٖ","m":"مانِعٍ يَمْنَعُه حِينَ وقُوعِهِ."}],"9":[{"w":"تَمُورُ","m":"تَتَحرَّكُ وتَضْطَرِبُ."}],"10":[{"w":"وَتَسِيرُ","m":"تَزُولُ عَنْ أماكِنِها، وَتَسيرُ كَسَيرِ السَّحابِ."}],"11":[{"w":"فَوَيۡلٞ","m":"فَهَلَاكٌ."}],"12":[{"w":"فِي خَوۡضٖ","m":"في انْدِفاعٍ في الكَلَامِ الباطِلِ."},{"w":"يَلۡعَبُونَ","m":"يَسْتَهْزِئُونَ."}],"13":[{"w":"يُدَعُّونَ","m":"يُدْفَعُونَ."},{"w":"دَعًّا","m":"دَفْعاً بِعُنْفٍ وَمهانَةٍ."}],"16":[{"w":"ٱصۡلَوۡهَا","m":"ادْخُلُوها واحْتَرِقُوا بِنارِها."}],"18":[{"w":"فَٰكِهِينَ","m":"طَيِّبَةً أَنْفُسُكُم، مُتَمَتِّعِينَ عَلَى وَجْهِ السُّرُورِ."}],"19":[{"w":"هَنِيٓـَٔۢا","m":"أَكْلاً وَشُرْباً هَنِيئاً أي: سائِغاً."}],"20":[{"w":"مُتَّكِـِٔينَ","m":"جالِسِين عَلَى وَجْهِ التَّمَكُّن والرَّاحةِ."},{"w":"سُرُرٖ","m":"جَمْعُ سَرِيرٍ وهو ما يُضْطَجَعُ عَلَيهِ؛ وهو مَجْلِسُ المنَعَّمِينَ."},{"w":"مَّصۡفُوفَةٖ","m":"مُتَقابِلَةٍ."},{"w":"وَزَوَّجۡنَٰهُم","m":"قَرَنَّاهُم."},{"w":"بِحُورٍ","m":"بِنِساءٍ شَدِيداتِ بَياضِ العَينِ وَسَوادها."},{"w":"عِينٖ","m":"واسِعاتِ العُيونِ حِسانِهِنَّ."}],"21":[{"w":"وَمَآ أَلَتۡنَٰهُم","m":"وما نَقَصْنَاهُم."},{"w":"رَهِينٞ","m":"مَحْبُوسٌ مقْرُونٌ."}],"22":[{"w":"وَأَمۡدَدۡنَٰهُم","m":"وَزِدْناهُم."}],"23":[{"w":"يَتَنَٰزَعُونَ","m":"يَتَعاطَونَ، وَيُناوِلُ بعضُهم بَعْضاً."},{"w":"كَأۡسٗا","m":"إِناءً مَمْلُوءاً مِنَ الخَمْرِ."},{"w":"لَغۡوٞ","m":"كَلَامٌ لا فَائِدةَ فِيهِ."},{"w":"تَأۡثِيمٞ","m":"إِثْمٌ ومَعْصِيَةٌ."}],"24":[{"w":"مَكۡنُونٞ","m":"مَصُونٌ في أَصْدَافِهِ."}],"26":[{"w":"مُشۡفِقِينَ","m":"خائِفِينَ مِنْ عَذابِ رَبِّنا."}],"27":[{"w":"ٱلسَّمُومِ","m":"نَارِ جَهَنَّمَ وَحَرَارَتِها."}],"28":[{"w":"ٱلۡبَرُّ","m":"المُحْسِنُ."}],"29":[{"w":"بِنِعۡمَتِ رَبِّكَ","m":"بمَنِّهِ وَلُطْفِهِ."},{"w":"بِكَاهِنٖ","m":"يُخْبِرُ بالغَيبِ دُونَ عِلْمٍ."}],"30":[{"w":"نَتَرَبَّصُ","m":"نَنْتَظِرُ."},{"w":"رَيۡبَ ٱلۡمَنُونِ","m":"حوادِثَ الدَّهرِ فَيَمُوتُ."}],"32":[{"w":"أَحۡلَٰمُهُم","m":"عُقُولُهم."},{"w":"طَاغُونَ","m":"مُتَجاوِزُونَ الحدَّ."}],"33":[{"w":"تَقَوَّلَهُۥ","m":"اخْتَلَقَهُ."}],"37":[{"w":"ٱلۡمُصَۜيۡطِرُونَ","m":"المُتَسَلِّطُونَ."}],"38":[{"w":"سُلَّمٞ","m":"دَرَجٌ وَمَصْعَدٌ إلى السَّماءِ."},{"w":"يَسۡتَمِعُونَ","m":"الكَلامَ الَّذِي يَجْرِي في السَّماءِ وَيَسْتَرِقُونَهُ."},{"w":"بِسُلۡطَٰنٖ","m":"بِحُجَّةٍ."}],"40":[{"w":"مَغۡرَمٖ","m":"غَرَامةٍ مَطْلُوبَةٍ مِنْهُم."}],"42":[{"w":"كَيۡدٗا","m":"مَكْراً."},{"w":"ٱلۡمَكِيدُونَ","m":"يَعُودُ ضَرَرُ مَكْرِهِم عَلَيهِم."}],"44":[{"w":"كِسۡفٗا","m":"قِطَعاً كِباراً مِنَ العَذَابِ."},{"w":"مَرۡكُومٞ","m":"مُتَراكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."}],"45":[{"w":"فَذَرۡهُمۡ","m":"فَدَعْهُم."},{"w":"يُصۡعَقُونَ","m":"يُهلَكُونَ."}],"46":[{"w":"لَا يُغۡنِي","m":"لا يَدْفَعُ."}],"47":[{"w":"عَذَابٗا دُونَ ذَٰلِكَ","m":"مِنَ القَتْلِ، والسَّبْيِ، وعَذابِ القَبْرِ."}],"48":[{"w":"بِأَعۡيُنِنَا","m":"بِمَرْأىً مِنَّا وَحِفْظٍ واعْتِناءٍ."},{"w":"حِينَ تَقُومُ","m":"إلى الصَّلاةِ، وحِينَ تَقُومُ مِنَ النَّومِ."}],"49":[{"w":"وَإِدۡبَٰرَ ٱلنُّجُومِ","m":"عِنْدَ صَلَاةِ الصُّبْحِ، حِينَ يُغَطِّي ضَوءُ الصُّبْحِ النُّجُومَ."}]}