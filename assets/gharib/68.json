{"1":[{"w":"نٓ","m":"سَبَقَ الكَلامُ عَلَى الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."},{"w":"وَٱلۡقَلَمِ","m":"أَقْسَمَ اللهُ بالقلمِ الَّذِي يَكْتُبُ بهِ الملائِكةُ والنَّاسُ."},{"w":"وَمَا يَسۡطُرُونَ","m":"أَقْسَمَ اللهُ بِما يَكْتُبُونَ مِنَ الخَيرِ والنَّفْعِ والعُلُومِ."}],"3":[{"w":"لَأَجۡرًا","m":"لَثَوَاباً عَظِيماً."},{"w":"غَيۡرَ مَمۡنُونٖ","m":"غيرَ مَنْقُوصٍ ولا مَقْطُوعٍ."}],"6":[{"w":"بِأَييِّكُمُ","m":"في أَيٍّ مِنْكُم."},{"w":"ٱلۡمَفۡتُونُ","m":"الفِتْنَةُ و الجنُونُ."}],"9":[{"w":"وَدُّواْ","m":"تَمَنَّوا وأحَبُّوا."},{"w":"لَوۡ تُدۡهِنُ","m":"لو تُلايِنُهُم وَتُصانِعُهُم عَلَى بَعْضِ ما هُم عَلَيهِ."},{"w":"فَيُدۡهِنُونَ","m":"فَيَلِينُونَ لَكَ."}],"10":[{"w":"حَلَّافٖ","m":"كَثِيرِ الحَلْفِ."},{"w":"مَهِينٍ","m":"حَقِيرٍ."}],"11":[{"w":"هَمَّازٖ","m":"مُغْتابٍ للنَّاسِ."},{"w":"مَشَّآءِۭ بِنَمِيمٖ","m":"يَمْشِي بَينَ النَّاسِ وَيَنْقُلُ حَدِيثَ بَعْضِهِم إلى بَعْضٍ عَلى وَجْهِ الإفْسادِ بَيْنَهُم."}],"12":[{"w":"مَنَّاعٖ لِّلۡخَيۡرِ","m":"شَدِيدِ المنْعِ لِلخَيْرِ."},{"w":"مُعۡتَدٍ","m":"مُتَجاوِزٍ حَدَّه في العُدْوانِ عَلَى النَّاسِ وَتَناوُلِ (المُحَرَّماتِ)."},{"w":"أَثِيمٍ","m":"كَثِيرِ الآثامِ."}],"13":[{"w":"عُتُلِّۭ","m":"شَدِيدٍ في كُفْرِهِ، فاحِشٍ لَئِيمٍ."},{"w":"زَنِيمٍ","m":"مَنْسُوبٍ إلى غَيرِ أَبِيهِ."}],"14":[{"w":"أَن كَانَ ذَا مَالٖ وَبَنِينَ","m":"طَغَى وَتَكَبَّرَ لِأَجْلِ أَن رَزَقَهُ اللهُ مالاً وَبَنِينَ فَلَمْ يَشْكُرِ النِّعْمَةَ."}],"15":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"أَباطِيلُ الأوَّلِينَ وَخُرافاتُهُم."}],"16":[{"w":"سَنَسِمُهُۥ","m":"سَنَجْعلُ عَلامةً لَازِمةً لا تُفارِقُهُ."},{"w":"عَلَى ٱلۡخُرۡطُومِ","m":"عَلَى أَنْفِهِ عُقُوبةً لَهُ."}],"17":[{"w":"بَلَوۡنَٰهُمۡ","m":"اخْتَبَرْنا أَهْلَ مَكَّةَ بالجُوعِ والقَحْطِ."},{"w":"ٱلۡجَنَّةِ","m":"الحَدِيقَةِ."},{"w":"لَيَصۡرِمُنَّهَا","m":"لَيَقْطَعُنَّ ثِمارَها."},{"w":"مُصۡبِحِينَ","m":"مُبَكِّرِينَ في الصَّباحِ."}],"18":[{"w":"وَلَا يَسۡتَثۡنُونَ","m":"وَلَمْ يَقُولُوا: إِن شَاءَ اللهُ."}],"19":[{"w":"فَطَافَ عَلَيۡهَا طَآئِفٞ مِّن رَّبِّكَ","m":"فَأَنْزَلَ اللهُ عَلَيها ناراً أَحْرَقَتْها لَيلاً."}],"20":[{"w":"كَٱلصَّرِيمِ","m":"مُحْتَرِقَةً سَوْداءَ كالليلِ المُظْلمِ."}],"21":[{"w":"فَتَنَادَوۡاْ","m":"فَنَادَى بَعْضُهُم بَعْضاً."},{"w":"مُصۡبِحِينَ","m":"وَقْتَ الصَّباحِ."}],"22":[{"w":"ٱغۡدُواْ","m":"اذْهَبُوا مُبَكِّرِينَ."},{"w":"حَرۡثِكُمۡ","m":"زَرْعِكُم."},{"w":"صَٰرِمِينَ","m":"قاطِعِينَ ثِمارَكُم."}],"23":[{"w":"يَتَخَٰفَتُونَ","m":"يُسِرُّ بَعْضُهُم إِلَى بَعْضٍ في الكَلامِ."}],"25":[{"w":"وَغَدَوۡاْ","m":"سارُوا في أَوَّلِ النَّهارِ."},{"w":"عَلَىٰ حَرۡدٖ","m":"على أَمْرٍ مُجْمَعٍ عَلَيهِ."}],"26":[{"w":"فَلَمَّا رَأَوۡهَا","m":"أي مُحْتَرِقَةً."},{"w":"لَضَآلُّونَ","m":"أَخْطأنا الطَّريقَ إلى حَدِيقَتِنا."}],"27":[{"w":"مَحۡرُومُونَ","m":"حُرِمْنا خيرَها بِسَبَبِ مَنْعِنَا المَساكِينَ."}],"28":[{"w":"أَوۡسَطُهُمۡ","m":"أَعْدَلُهُم وَأَفْضَلُهُم."},{"w":"لَوۡلَا","m":"هَلَّا."},{"w":"تُسَبِّحُونَ","m":"تَقُولُونَ: إن شاء اللهُ."}],"29":[{"w":"سُبۡحَٰنَ رَبِّنَآ","m":"نُنَزِّهُ رَبَّنا عَنِ الظُّلْمِ فِيما أَصَابَنا."}],"30":[{"w":"يَتَلَٰوَمُونَ","m":"يَلُومُ بَعْضُهم بَعْضاً."}],"31":[{"w":"يَٰوَيۡلَنَآ","m":"نادَوا عَلَى أَنْفُسِهِم بِالشَّرِّ وَالعَذابِ."},{"w":"طَٰغِينَ","m":"مُتَجاوِزِينَ الحدَّ في مَنْعِنَا الفُقَراءَ."}],"32":[{"w":"رَٰغِبُونَ","m":"طالِبُونَ الخيرَ والعفوَ عَن سيِّئاتِنا."}],"33":[{"w":"كَذَٰلِكَ ٱلۡعَذَابُ","m":"نَفْعَلُ بِمن تَعَدَّى حُدُودَنا مِثلَ ما فَعَلْنَا بِهَؤُلاءِ."}],"36":[{"w":"كَيۡفَ تَحۡكُمُونَ","m":"كَيفَ تَقْضُونَ بِهذا الحُكْمِ الظَّالِمِ؟"}],"37":[{"w":"كِتَٰبٞ","m":"أُنْزِلَ مِنْ عِنْدِ اللهِ."},{"w":"تَدۡرُسُونَ","m":"تَقْرَؤونَ فِيهِ هَذا الحُكْمَ الجائِرَ."}],"38":[{"w":"لَمَا تَخَيَّرُونَ","m":"ما تَشْتَهُونَ وَتَخْتَارُونَ، ليسَ لَكُم ذَلِكَ."}],"39":[{"w":"أَيۡمَٰنٌ عَلَيۡنَا","m":"عُهُودٌ ومَواثِيقُ عَلَينا."},{"w":"بَٰلِغَةٌ","m":"مُؤَكَّدةٌ."}],"40":[{"w":"زَعِيمٌ","m":"كَفِيلٌ وَضامِنٌ."}],"41":[{"w":"أَمۡ لَهُمۡ شُرَكَآءُ","m":"أَلَهُم أَرْبَابٌ يَفْعَلُونَ بِهِم ما زَعَمُوا مِنَ الكَرَامةِ؟"}],"42":[{"w":"يُكۡشَفُ عَن سَاقٖ","m":"يَكْشِفُ رَبُّنا عَن ساقِهِ يَوْمَ القِيامَةِ فَيَسْجُدُ لَهُ كُلُّ مُؤْمِنٍ وَمُؤْمِنَةٍ، وَلَا يَتَمكَّنُ المنافِقُونَ مِنَ السُّجُودِ."}],"43":[{"w":"خَٰشِعَةً أَبۡصَٰرُهُمۡ","m":"مُنْكَسِرَةً لَا يَرْفَعُونَها."},{"w":"تَرۡهَقُهُمۡ","m":"تَغْشاهُم."}],"44":[{"w":"فَذَرۡنِي وَمَن يُكَذِّبُ","m":"خَلِّ بينِي وَبَينَ مَنْ يُكذِّبُ."},{"w":"سَنَسۡتَدۡرِجُهُم","m":"سَنَمُدُّهُم بالأمْوَالِ، والأَولَادِ، والنِّعَمِ؛ اسْتِدْراجاً لَهُم."}],"45":[{"w":"وَأُمۡلِي لَهُمۡ","m":"وأُمْهِلُهُم، وَأُطِيلُ أَعْمَارَهُم؛ لِيَزْدَادُوا إِثْما."},{"w":"كَيۡدِي","m":"مَكْرِي بِالكُفَّارِ."},{"w":"مَتِينٌ","m":"قَوِيٌّ شدِيدٌ."}],"46":[{"w":"مِن مَّغۡرَمٖ","m":"مِنْ غَرامَةِ ذَلِكَ الأَجْرِ."},{"w":"مُثۡقَلُونَ","m":"يَثْقُلُ عَلَيهِم حِمْلُهُ."}],"47":[{"w":"أَمۡ عِندَهُمُ ٱلۡغَيۡبُ","m":"بَلْ أَعِنْدَهُم عِلْمُ الغَيبِ؟"}],"48":[{"w":"كَصَاحِبِ ٱلۡحُوتِ","m":"هُو يُونُسُ عَلَيهِ السَّلامُ."},{"w":"مَكۡظُومٞ","m":"مَمْلُوءٌ غَمّاً وَكَرْباً."}],"49":[{"w":"نِعۡمَةٞ مِّن رَّبِّهِۦ","m":"التَّوبَةُ وَقَبُولُها مِنْهُ."},{"w":"لَنُبِذَ","m":"لَطُرِحَ."},{"w":"بِٱلۡعَرَآءِ","m":"بالأرْضِ الفَضَاءِ المُهْلِكَةِ."},{"w":"مَذۡمُومٞ","m":"آتٍ بِما يُلامُ عَلَيهِ."}],"50":[{"w":"فَٱجۡتَبَٰهُ","m":"فاخْتارَهُ لِرِسالتِهِ."}],"51":[{"w":"لَيُزۡلِقُونَكَ","m":"لَيُصِيبُونَكَ بالعَينِ؛ لِبُغْضِهِم إِيَّاكَ."},{"w":"ٱلذِّكۡرَ","m":"القُرْآنَ."}]}