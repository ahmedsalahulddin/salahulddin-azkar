{"1":[{"w":"طه","m":"تَقَدَّمَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"2":[{"w":"لِتَشۡقَىٰٓ","m":"لِتَتْعبَ بفَرْطِ تأسُّفِكَ على كُفْرِهِم."}],"3":[{"w":"تَذۡكِرَةٗ","m":"عِظَةً وعِبْرةً."}],"5":[{"w":"ٱلۡعَرۡشِ","m":"هو سَرِيرُ المُلْكِ الذي اسْتَوى عَلَيه الرحمنُ، وتَحمِلُه الملائِكةُ، وهو أَعْظَمُ المخْلُوقَاتِ، وهو سَقْفُ الجنَّةِ."},{"w":"ٱسۡتَوَىٰ","m":"عَلا وارْتَفَعَ، اسْتِوَاءً يلِيقُ بِجَلالِه وَعَظَمَتِه."}],"6":[{"w":"وَمَا تَحۡتَ ٱلثَّرَىٰ","m":"باطِنِ الأَرْضِ."}],"7":[{"w":"ٱلسِّرَّ","m":"ما حَدَّثَ الإنْسانُ بِه غَيْرَه في خَفَاءٍ."},{"w":"وَأَخۡفَى","m":"وَما هُوَ أَخْفَى مِنَ السِّرِّ، مِمَّا تُحدِّثُ بِه نَفْسَكَ."}],"9":[{"w":"حَدِيثُ مُوسَىٰٓ","m":"خبرُ مُوسَى بن عِمْرَانَ عليه الصَّلاةُ والسَّلامُ، لمَّا رَجَعَ مِن مَدْيَنَ إلى مِصْرَ."}],"10":[{"w":"ءَانَسۡتُ","m":"أَبْصَرْتُ ما يُؤنِسُ."},{"w":"بِقَبَسٍ","m":"بِشُعْلةٍ مِن نَّارٍ تَنْفَعُكُم."},{"w":"هُدٗى","m":"هادِياً يَدُلُّنا عَلى الطَّرِيقِ."}],"12":[{"w":"طُوٗى","m":"اسْمِ الوَادِي المُقَدَّسِ."}],"13":[{"w":"ٱخۡتَرۡتُكَ","m":"اصْطَفَيتُك للنُّبوَّةِ والرِّسالَةِ."}],"14":[{"w":"لِذِكۡرِيٓ","m":"لِتَذْكُرَني فِيها."}],"15":[{"w":"أَكَادُ أُخۡفِيهَا","m":"أَكَادُ أُخْفِيها مِن نَّفْسِي."}],"16":[{"w":"فَلَا يَصُدَّنَّكَ","m":"فلا يَصْرِفَنَّكَ."},{"w":"فَتَرۡدَىٰ","m":"فَتَهْلِكَ."}],"18":[{"w":"أَتَوَكَّؤُاْ عَلَيۡهَا","m":"أَعْتَمِدُ عَلَيها في الْمَشْيِ."},{"w":"وَأَهُشُّ بِهَا","m":"وَأَهُزُّ بِها الشَّجَرَ لِيَسْقُطَ مِنْه الوَرَقُ."},{"w":"مَـَٔارِبُ","m":"حاجاتٌ ومَنافعُ."}],"21":[{"w":"سِيرَتَهَا ٱلۡأُولَىٰ","m":"حالتَها الأُوْلى التي كانَتْ عَلَيها."}],"22":[{"w":"إِلَىٰ جَنَاحِكَ","m":"جَنبِك تَحْتَ العَضُدِ."},{"w":"مِنۡ غَيۡرِ سُوٓءٍ","m":"مِنْ غَيرِ مَرَضٍ ولا بَرَصٍ."}],"24":[{"w":"طَغَىٰ","m":"تَجاوَزَ حَدَّه بالتَّمَرُّدِ على ربِّه."}],"27":[{"w":"وَٱحۡلُلۡ عُقۡدَةٗ مِّن لِّسَانِي","m":"وأَطْلِقْ عَنْ لِساني العُقْدَةَ التي فِيه."}],"29":[{"w":"وَزِيرٗا","m":"مُعِيناً في إبْلاغِ رِسالتِكَ."}],"31":[{"w":"ٱشۡدُدۡ بِهِۦٓ أَزۡرِي","m":"قَوِّني به وشُدَّ به ظَهْري."}],"32":[{"w":"فِيٓ أَمۡرِي","m":"في النُّبوَّةِ وتَبْلِيغِ الرِّسالةِ."}],"36":[{"w":"أُوتِيتَ سُؤۡلَكَ","m":"أُعطِيتَ كلَّ ما سألتَ."}],"37":[{"w":"وَلَقَدۡ مَنَنَّا عَلَيۡكَ","m":"ولَقَدْ أنْعَمْنا عَلَيكَ."},{"w":"مَرَّةً أُخۡرَىٰٓ","m":"نِعْمَةً أُخْرَى بإِنْجائِكَ مِن بَطْشِ فِرْعَونَ وجُنُودِه حِينَ كُنْتَ رَضِيعاً."}],"38":[{"w":"أَوۡحَيۡنَآ","m":"ألْهَمْنَا."}],"39":[{"w":"ٱقۡذِفِيهِ","m":"ضَعِيه."},{"w":"ٱلتَّابُوتِ","m":"الصُّنْدُوقِ الخَشَبِيِّ."},{"w":"فَٱقۡذِفِيهِ فِي ٱلۡيَمِّ","m":"فاطْرَحِيه في النِّيلِ."},{"w":"وَأَلۡقَيۡتُ عَلَيۡكَ مَحَبَّةٗ مِّنِّي","m":"أي: أَحْبَبْتُك، فَصِرْتَ بِذَلكَ مَحْبُوباً بَيْنَ العِبادِ."},{"w":"وَلِتُصۡنَعَ عَلَىٰ عَيۡنِيٓ","m":"وَلِتُرَبَّى بِمَرأىً مِنِّي."}],"40":[{"w":"كَيۡ تَقَرَّ عَيۡنُهَا","m":"كي تُسَرَّ أُمّ مُوسى بِسَلامةِ وَلَدِها وَرُجُوعِه إِليها."},{"w":"وَفَتَنَّٰكَ","m":"وابْتَلَيناك."},{"w":"عَلَىٰ قَدَرٖ","m":"عَلى مَوْعِدٍ مُوافِقٍ للوقْتِ المُقَدَّرِ في عِلْمِ اللهِ تَعالى."}],"41":[{"w":"وَٱصۡطَنَعۡتُكَ لِنَفۡسِي","m":"هَيَّأْتُكَ لِتَبْلِيغِ الرِّسالةِ عَنِّي."}],"42":[{"w":"وَلَا تَنِيَا","m":"ولا تَضْعُفا."}],"43":[{"w":"طَغَىٰ","m":"جاوَزَ الحَدَّ في الكُفْرِ والظُّلْمِ."}],"45":[{"w":"أَن يَفۡرُطَ عَلَيۡنَآ","m":"أن يُعَاجِلَنا ويُبادِرَ بالعُقُوبَةِ."},{"w":"أَوۡ أَن يَطۡغَىٰ","m":"أو أن يَتَمَرَّدَ على الحقِّ فلا يَقْبَلَه."}],"47":[{"w":"وَلَا تُعَذِّبۡهُمۡ","m":"أي: ولَا تُعَذِّبْهم بِذَبْحِ أبْنائِهِم واسْتِحْياءِ بَناتِهِم وتَكْلِيفِهِم بِما لا يُطِيقُونَ مِنَ الأَعْمالِ."}],"50":[{"w":"خَلۡقَهُۥ","m":"أي: صورتَه اللائِقَةَ بخاصَّتِه ومَنْفَعَتِه."}],"51":[{"w":"فَمَا بَالُ ٱلۡقُرُونِ ٱلۡأُولَىٰ","m":"فما شأنُ الأممِ السَّابِقَةِ؟"}],"52":[{"w":"فِي كِتَٰبٖ","m":"وهو اللَّوحُ المَحْفُوظُ."},{"w":"لَا يَضِلُّ رَبِّي","m":"أي: لا يُخْطِئُ ربِّي في أَفْعالِه وأَحْكامِه."},{"w":"وَلَا يَنسَى","m":"أيَّ شيءٍ ممَّا عَلِمه مِنْها."}],"53":[{"w":"مَهۡدٗا","m":"أي: مُيَسَّرةً للانْتِفاعِ بِها، فَصارَتْ كالْفِرَاشِ والْمِهادِ لكلِّ واحدٍ مِنْكُم."},{"w":"وَسَلَكَ لَكُمۡ فِيهَا سُبُلٗا","m":"وَجَعَل لَكُم فِيها طُرُقاً كَثِيرَةً."},{"w":"أَزۡوَٰجٗا مِّن نَّبَاتٖ شَتَّىٰ","m":"أنْوَاعاً مُخْتَلِفَةً مِنَ النَّباتِ."}],"54":[{"w":"لِأُوْلِي ٱلنُّهَىٰ","m":"لِذَوي الْعُقُولِ السَّلِيمَةِ."}],"56":[{"w":"ءَايَٰتِنَا","m":"أدلَّتَنا وحُجَجَنا."},{"w":"وَأَبَىٰ","m":"وامْتَنَعَ عَن قَبُولِ الْحَقِّ."}],"58":[{"w":"مَكَانٗا سُوٗى","m":"في مَكانٍ مُعْتَدِلٍ مُسْتَوٍ بَيْنَنا وبَيْنَكَ."}],"59":[{"w":"يَوۡمُ ٱلزِّينَةِ","m":"يومُ العيدِ حِينَ يتزيَّنُ الناسُ."},{"w":"وَأَن يُحۡشَرَ","m":"وأن يُجْمَعَ."}],"61":[{"w":"لَا تَفۡتَرُواْ","m":"لا تَخْتَلِقُوا."},{"w":"فَيُسۡحِتَكُم","m":"فَيَسْتَأْصِلَكُم ويُبِيدَكُمْ."},{"w":"خَابَ","m":"خَسِرَ وَهَلَكَ."}],"62":[{"w":"وَأَسَرُّواْ ٱلنَّجۡوَىٰ","m":"تَحَادَثَ السَّحَرةُ سِرّاً في خَفَاءٍ."}],"63":[{"w":"بِطَرِيقَتِكُمُ ٱلۡمُثۡلَىٰ","m":"بِطَرِيقةِ السِّحْرِ العظيمةِ التي أَنْتُم عَلَيها."}],"64":[{"w":"فَأَجۡمِعُواْ كَيۡدَكُمۡ","m":"فأَحْكِمُوا مَكْرَكُم، ولا تَجْعَلُوهُ مُتَفَرِّقاً."},{"w":"مَنِ ٱسۡتَعۡلَىٰ","m":"مَنْ عَلا عَلى صاحِبِه فَغَلَبَهُ وقَهَرَهُ."}],"67":[{"w":"فَأَوۡجَسَ","m":"فَأَضْمَرَ."},{"w":"خِيفَةٗ","m":"خَوْفاً."}],"68":[{"w":"أَنتَ ٱلۡأَعۡلَىٰ","m":"أَنتَ الْغالِبُ على هَؤلاءِ السَّحَرةِ."}],"69":[{"w":"تَلۡقَفۡ","m":"تَبْتَلِعْ بِسُرْعَةٍ."},{"w":"وَلَا يُفۡلِحُ ٱلسَّاحِرُ","m":"ولا يَظْفَرُ السَّحرةُ بِبُغْيتِهِم."}],"71":[{"w":"مِنۡ خِلَٰفٖ","m":"مُخَالِفاً بينها: يداً مِن جِهَةٍ ورِجْلاً مِنَ الْجِهَةِ الأخْرَى."},{"w":"وَلَأُصَلِّبَنَّكُمۡ","m":"وَلَأُبالِغَنّ في شَدِّ أَطْرافِكُم وَرَبْطِ أجْسَادِكُم."},{"w":"فِي جُذُوعِ ٱلنَّخۡلِ","m":"على جُذُوعِ النَّخْلِ."},{"w":"وَأَبۡقَىٰ","m":"وأَدْوَمُ، لَا يَنْقَطِعُ."}],"72":[{"w":"لَن نُّؤۡثِرَكَ","m":"لن نُفَضِّلَكَ."}],"74":[{"w":"مُجۡرِمٗا","m":"كافِراً."},{"w":"لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","m":"أي: لا يمُوتُ فيها فَيَسْتَرِيحَ، ولا يحيا حياةً يتلذَّذُ بِها."}],"76":[{"w":"جَنَّٰتُ عَدۡنٖ","m":"جَنَّاتُ إِقامَةٍ دائمةٍ."},{"w":"مَن تَزَكَّىٰ","m":"مَنْ تَطهَّرَ مِنَ الْكُفْرِ والْمَعَاصِي."}],"77":[{"w":"أَنۡ أَسۡرِ","m":"أَنِ اخْرُجْ ليلاً بِعِبادِي."},{"w":"فَٱضۡرِبۡ لَهُمۡ","m":"فَاجْعَلْ لهم."},{"w":"يَبَسٗا","m":"يابساً لَا ماءٌ فِيها وَلَا طِينٌ."},{"w":"لَا تَخَٰفُ دَرَكٗا","m":"لَا تخافُ مِن فِرْعَونَ وجُنُودِهِ أن يَلْحَقَ بكُم فيُدْرِكَكُم."},{"w":"وَلَا تَخۡشَىٰ","m":"ولَا تَخْشَى مِنَ الْغَرَقِ في الْبَحْرِ."}],"78":[{"w":"فَغَشِيَهُم مِّنَ ٱلۡيَمِّ مَا غَشِيَهُمۡ","m":"فَغَمَرَهُم مِن مَّاءِ البَحْرِ مَا لَا يَعْلَمُ كُنهَه إلَّا اللهُ."}],"80":[{"w":"ٱلۡمَنَّ","m":"شيءٌ يُشْبِهُ الصَّمْغَ، طَعْمُه كالْعَسَلِ."},{"w":"وَٱلسَّلۡوَىٰ","m":"طَيرٌ يُشْبِهُ السُّمانَىٰ."}],"81":[{"w":"وَلَا تَطۡغَوۡاْ فِيهِ","m":"وَلَا تَحْمِلنَّكُم العافيةُ والسَّعَةُ في الرِّزقِ على تَجَاوُزِ الحدِّ في الْعِصْيانِ."},{"w":"فَيَحِلَّ عَلَيۡكُمۡ","m":"فيَنْزِلَ بِكُم."},{"w":"هَوَىٰ","m":"هَلَكَ وخَسِرَ."}],"82":[{"w":"ثُمَّ ٱهۡتَدَىٰ","m":"ثُمَّ الْتَزَمَ الْهِدايةَ واسْتَقَامَ عَلَيها."}],"84":[{"w":"عَلَىٰٓ أَثَرِي","m":"خَلْفي سَوفَ يَلْحَقُون بِي."},{"w":"لِتَرۡضَىٰ","m":"لِتَزْدَادَ عَنِّي رِضاً."}],"85":[{"w":"قَدۡ فَتَنَّا","m":"قد ابتلينا."},{"w":"وَأَضَلَّهُمُ","m":"دَعاهُم إلى الضَّلالَةِ التي هِيَ عِبادةُ الْعِجْلِ."},{"w":"ٱلسَّامِرِيُّ","m":"مَنْسُوبٌ إلى «قبيلةِ السَّامِرَة» قيل: كان إسْرَائِيلياً، وقيل: كانَ قِبْطياً."}],"86":[{"w":"أَسِفٗا","m":"حَزِيناً كَئِيباً."},{"w":"وَعۡدًا حَسَنًا","m":"أي: بإنزالِ التَّوراةِ."},{"w":"ٱلۡعَهۡدُ","m":"الزَّمانُ."},{"w":"فَأَخۡلَفۡتُم مَّوۡعِدِي","m":"خالفْتُم ما وَعَدْتُّمُونِي مِنْ عِبادَةِ اللهِ وَحْدَه."}],"87":[{"w":"بِمَلۡكِنَا","m":"باخْتِيارِنا."},{"w":"أَوۡزَارٗا","m":"أثْقالاً."},{"w":"مِن زِينَةِ ٱلۡقَوۡمِ","m":"مِنْ حُلِيِّ قومِ فِرْعَونَ."},{"w":"فَقَذَفۡنَٰهَا","m":"فَأَلْقَينا الْحُلِيَّ في النَّارِ."},{"w":"فَكَذَٰلِكَ أَلۡقَى ٱلسَّامِرِيُّ","m":"أي: فَكَذَلِك ألْقَى السَّامِريُّ ما كان مَعَهُ مِن تُرْبَةِ حافِرِ فَرَسِ جِبْريلَ عليه السَّلامُ."}],"88":[{"w":"عِجۡلٗا جَسَدٗا","m":"مَعْبُوداً مِن ذَهَبِهِم على صُورَةِ الْعِجْلِ بلا رُوحٍ."},{"w":"لَهُۥ خُوَارٞ","m":"له صَوْتٌ يُشْبِهُ صوتَ الْبَقَرِ."},{"w":"فَنَسِيَ","m":"فَغَفَلَ عنه مُوسى نِسْياناً."}],"89":[{"w":"أَلَّا يَرۡجِعُ إِلَيۡهِمۡ قَوۡلٗا","m":"لا يُكَلِّمُهم ولا يَرُدُّ عَليهِم جَوَاباً."}],"90":[{"w":"فُتِنتُم بِهِۦ","m":"بِهَذا الْعِجْلِ."}],"91":[{"w":"لَن نَّبۡرَحَ عَلَيۡهِ عَٰكِفِينَ","m":"لَن نَزَالَ مُقيمِينَ على عِبادَةِ الْعِجْل."}],"94":[{"w":"وَلَمۡ تَرۡقُبۡ قَوۡلِي","m":"وَلَمْ تَعْمَلْ بوَصِيَّتِي لَكَ فِيهِم."}],"95":[{"w":"فَمَا خَطۡبُكَ","m":"أي: ما الَّذِي حَمَلَكَ على ما صَنَعْتَ؟"}],"96":[{"w":"فَقَبَضۡتُ قَبۡضَةٗ","m":"فَأَخَذْتُ بِكَفِّي تُرَاباً."},{"w":"مِنۡ أَثَرِ ٱلرَّسُولِ","m":"مِنْ أَثَرِ حافِرِ فرسِ جِبْرِيلَ عليهِ السلامُ."},{"w":"فَنَبَذۡتُهَا","m":"فألقيتُ حَفْنَةَ التُّرابِ على الحُليِّ التي صُنِعَ منها العِجلُ."},{"w":"سَوَّلَتۡ لِي نَفۡسِي","m":"زَيَّنَتْ لي نَفْسِي ما صَنَعْتُ."}],"97":[{"w":"لَا مِسَاسَ","m":"أي لا يَمَسَّكَ أحدٌ، ولا تَمَسَّ أحداً في الدُّنيا، فَتَعِيشَ مَنْبُوذاً."},{"w":"لَكَ مَوۡعِدٗا","m":"أي: في الآخرةِ لِعِقابِك."},{"w":"لَن تُخۡلَفَهُۥ","m":"لَن يُخْلِفَكَ اللهُ إيَّاهُ."},{"w":"ظَلۡتَ عَلَيۡهِ عَاكِفٗا","m":"أقمتَ مواظِباً على عبادتِه."},{"w":"ثُمَّ لَنَنسِفَنَّهُۥ","m":"ثم لنَذْرُوَنَّه حَتَّى لا يَبْقَى منه أَثَرٌ."},{"w":"ٱلۡيَمِّ","m":"الْبَحرِ."}],"99":[{"w":"ذِكۡرٗا","m":"القرآنَ؛ لِمَا فيه مِنَ التَّذْكِيرِ."}],"100":[{"w":"وِزۡرًا","m":"إثماً عَظِيماً."}],"102":[{"w":"ٱلصُّورِ","m":"القَرْنِ الذي يُنفَخُ فيه للبعثِ."},{"w":"وَنَحۡشُرُ","m":"نَسُوقُ."},{"w":"زُرۡقٗا","m":"زُرْقَ العُيونِ والأجْسادِ من هَوْلِ المصيبة."}],"103":[{"w":"يَتَخَٰفَتُونَ بَيۡنَهُمۡ","m":"يَتَسارُّونَ فِيما بَيْنَهم."}],"104":[{"w":"أَمۡثَلُهُمۡ طَرِيقَةً","m":"أَعْلَمُهم وأَكْمَلُهم رأياً."}],"105":[{"w":"يَنسِفُهَا رَبِّي نَسۡفٗا","m":"يَقْلعُها رَبي مِنْ أُصُولِها فَتَتَطايرُ كالصُّوفِ المنفُوشِ."}],"106":[{"w":"فَيَذَرُهَا","m":"فَيَتْرُكُ الأرضَ."},{"w":"قَاعٗا","m":"أرْضاً لا نَباتٌ فيها ولا بناءٌ."},{"w":"صَفۡصَفٗا","m":"مَلْساءَ مُسْتَوِيَةً."}],"107":[{"w":"عِوَجٗا","m":"مَيْلاً."},{"w":"وَلَآ أَمۡتٗا","m":"وَلَا ارْتِفَاعاً ولا انْخِفاضاً."}],"108":[{"w":"لَا عِوَجَ","m":"لا مَحِيدَ لهم من اتِّباعِ داعِي اللهِ إلى المَحْشَرِ."},{"w":"هَمۡسٗا","m":"صَوْتاً خَفِيّاً."}],"110":[{"w":"مَا بَيۡنَ أَيۡدِيهِمۡ","m":"أي: مِنْ أَمْرِ القِيامةِ."},{"w":"وَمَا خَلۡفَهُمۡ","m":"أي: مِنْ أَمْرِ الدُّنْيا."}],"111":[{"w":"وَعَنَتِ","m":"ذلَّتْ وخَضَعَتْ."},{"w":"ٱلۡقَيُّومِ","m":"الدَّائِمِ القَيَّامِ بِتَدْبِيرِ الْخَلْقِ وَحِفْظِهِم."},{"w":"خَابَ","m":"خَسِرَ وهَلَكَ."},{"w":"ظُلۡمٗا","m":"شِرْكاً باللهِ."}],"112":[{"w":"ظُلۡمٗا وَلَا هَضۡمٗا","m":"ظُلْماً بِزيادةِ سَيِّئاتِه في الآخِرةِ، ولا هَضْماً بِنَقْصِ حَسَناتِه فيها."}],"113":[{"w":"أَوۡ يُحۡدِثُ لَهُمۡ ذِكۡرٗا","m":"أي: يُحدِثُ فِيهم هذا القرآنُ تَذَكُّراً واعْتِباراً."}],"114":[{"w":"وَلَا تَعۡجَلۡ بِٱلۡقُرۡءَانِ","m":"لا تُسَارِعْ بِقِراءتِه."},{"w":"مِن قَبۡلِ أَن يُقۡضَىٰٓ إِلَيۡكَ وَحۡيُهُۥ","m":"من قَبْلِ أن يَفرُغَ جبريلُ ويُتِمَّ إليك الوحيَ."}],"115":[{"w":"عَهِدۡنَآ إِلَىٰٓ ءَادَمَ","m":"وصَّيناهُ، أو أوحينا إليه."},{"w":"عَزۡمٗا","m":"قوَّةً في الإرادةِ يَحْفَظُ بها ما أُمِرَ به."}],"116":[{"w":"أَبَىٰ","m":"امْتَنَعَ مِنَ السُّجُودِ اسْتِكْباراً."}],"117":[{"w":"فَتَشۡقَىٰٓ","m":"فتعانيَ المتاعِبَ والمشاقَّ في الدُّنيا."}],"118":[{"w":"أَلَّا تَجُوعَ فِيهَا","m":"أي: لا يُصِيبَكَ في الجنَّةِ جُوعٌ."},{"w":"وَلَا تَعۡرَىٰ","m":"أي: لا تَعْرَىٰ فيها عن الملابِسِ."}],"119":[{"w":"لَا تَظۡمَؤُاْ فِيهَا","m":"لا يُصِيبُكَ في الجنَّةِ عَطَشٌ."},{"w":"وَلَا تَضۡحَىٰ","m":"ولا يُصيبُك حرُّ شَمْسٍ."}],"120":[{"w":"شَجَرَةِ ٱلۡخُلۡدِ","m":"هي الشجرةُ التي مَنْ أَكَلَ مِنْها لم يَمُتْ."},{"w":"لَا يَبۡلَىٰ","m":"لا يَنْقَطِعُ."}],"121":[{"w":"فَبَدَتۡ لَهُمَا سَوۡءَٰتُهُمَا","m":"فَانْكَشَفَتْ لِآدَمَ وحَوَّاءَ عَوْراتُهما."},{"w":"وَطَفِقَا يَخۡصِفَانِ","m":"وجَعلا يُلْصِقان."},{"w":"فَغَوَىٰ","m":"فَضَلَّ طَريقَ الصَّوابِ."}],"122":[{"w":"ٱجۡتَبَٰهُ","m":"اصْطَفاه."}],"123":[{"w":"ٱهۡبِطَا","m":"انْزِلا مِنَ الْجَنَّةِ إلى الأرضِ."},{"w":"فَلَا يَضِلُّ","m":"أي: عَن طَرِيقِ الهِدايةِ."},{"w":"وَلَا يَشۡقَىٰ","m":"لا يَشْقَى في الآخرةِ بعِقابِ اللهِ."}],"124":[{"w":"ذِكۡرِي","m":"أي: عَن ذِكْرِي الَّذِي أُذَكِّرهُ بِهِ مِن قُرآنٍ وَغَيْرِهِ."},{"w":"ضَنكٗا","m":"ضَيِّقةً شاقَّةً في حَياتِه وقَبْرِه."}],"126":[{"w":"فَنَسِيتَهَا","m":"أي: بِتَرْكِ الإيمانِ بها."},{"w":"تُنسَىٰ","m":"تُتْرَكُ في النَّارِ."}],"127":[{"w":"مَنۡ أَسۡرَفَ","m":"تَجاوَزَ حدودَ ما شَرَعَ اللهُ."},{"w":"وَأَبۡقَىٰٓ","m":"أَدْوَمُ مِنْ عذابِ الدُّنيا، فلا يَنْقَطِعُ."}],"128":[{"w":"يَهۡدِ لَهُمۡ","m":"أي: يَدُلَّهم على طَريقِ الرَّشادِ."},{"w":"مِنَ ٱلۡقُرُونِ","m":"مِنَ الأُمَمِ الماضيةِ."},{"w":"لَأٓيَٰتٖ","m":"لَعِبَراً وعِظاتٍ."},{"w":"لِأُوْلِي ٱلنُّهَىٰ","m":"لأصْحابِ العقولِ السَّلِيمةِ."}],"129":[{"w":"لَكَانَ لِزَامٗا","m":"لَلَازَمَهم الهَلاكُ عاجِلاً؛ بسببِ كُفْرِهم."}],"130":[{"w":"ءَانَآيِٕ ٱلَّيۡلِ","m":"ساعاتِ الليلِ."},{"w":"تَرۡضَىٰ","m":"أي: تُثابُ على عَمَلِك بما يُرضِيكَ."}],"131":[{"w":"وَلَا تَمُدَّنَّ عَيۡنَيۡكَ","m":"لا تُكَرِّرِ النَّظَرَ إلى المُشْرِكِينَ مُسْتَحْسِناً."},{"w":"أَزۡوَٰجٗا مِّنۡهُمۡ","m":"أصْنافاً مِن الكفَّارِ."},{"w":"زَهۡرَةَ ٱلۡحَيَوٰةِ","m":"زينتَها وبَهْجَتَها التي لا تَدُومُ."},{"w":"لِنَفۡتِنَهُمۡ","m":"لِنَبْتليَهم."}],"132":[{"w":"وَٱصۡطَبِرۡ عَلَيۡهَا","m":"داوِمْ على إقامةِ الصَّلاةِ بِصَبْرٍ."}],"133":[{"w":"بِـَٔايَةٖ","m":"بِمُعْجِزَةٍ."},{"w":"بَيِّنَةُ مَا فِي ٱلصُّحُفِ ٱلۡأُولَىٰ","m":"أي: هذا القرآنُ مصدِّقٌ لما في الكُتُبِ السَّابِقَةِ مِنَ الحقِّ."}],"134":[{"w":"مِن قَبۡلِهِۦ","m":"أي: من قبْلِ أن نُرسِلَ إليهم رَسُولاً."},{"w":"أَن نَّذِلَّ وَنَخۡزَىٰ","m":"أن يُصيبنا ذُلٌّ وخِزيٌ بعذابِكَ في الدُّنيا والآخِرةِ."}],"135":[{"w":"كُلّٞ مُّتَرَبِّصٞ","m":"كلٌّ مِنَّا ومِنْكُم منتظِرٌ دوائرَ الزمانِ."},{"w":"فَتَرَبَّصُواْ","m":"فانْتَظِرُوا."}]}