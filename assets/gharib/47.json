{"1":[{"w":"أَضَلَّ","m":"أَبْطلَ."}],"2":[{"w":"كَفَّرَ","m":"سَتَرَ."},{"w":"بَالَهُمۡ","m":"شَأْنَهُم."}],"3":[{"w":"يَضۡرِبُ","m":"يُبَيِّنُ."},{"w":"أَمۡثَٰلَهُمۡ","m":"أَحْوَالَهُم الَّتي تُميِّزُهُم."}],"4":[{"w":"لَقِيتُمُ","m":"قاتَلْتُم."},{"w":"فَضَرۡبَ ٱلرِّقَابِ","m":"فاضْرِبُوا مِنْهُم الأَعْناقَ."},{"w":"أَثۡخَنتُمُوهُمۡ","m":"أَضْعَفْتُمُوهُم بِكَثْرةِ القَتْلِ، وَبالَغْتُم في قَتْلِهِم."},{"w":"فَشُدُّواْ","m":"فأحْكِمُوا."},{"w":"ٱلۡوَثَاقَ","m":"قَيْدَ الأسْرَى."},{"w":"مَنَّۢا","m":"إطْلَاقاً مِنَ الأَسْرِ."},{"w":"فِدَآءً","m":"مُبادَلةً بالمالِ أو بأسْرَى مُسْلِمِينَ."},{"w":"حَتَّىٰ تَضَعَ ٱلۡحَرۡبُ أَوۡزَارَهَا","m":"حَتَّى يَنْتَهِيَ المُحَارِبُونَ عَنْ قِتَالِكُم."}],"6":[{"w":"عَرَّفَهَا","m":"بَيَّنها."}],"8":[{"w":"فَتَعۡسٗا","m":"فَخِزْياً لَهُم وشَقاءً وَبَلَاءً."}],"9":[{"w":"فَأَحۡبَطَ","m":"فَأَبْطَلَ."}],"10":[{"w":"أَمۡثَٰلُهَا","m":"أَمْثالُ عاقِبةِ تَكْذِيبِ الأُمَمِ السَّابِقةِ مِنَ التَّدْمِيرِ وَالهَلَاكِ."}],"11":[{"w":"مَوۡلَىٰ","m":"وَلِيٌّ وَناصِرٌ."}],"12":[{"w":"مَثۡوٗى","m":"مَنْزِلٌ."}],"13":[{"w":"وَكَأَيِّن مِّن قَرۡيَةٍ","m":"وَكَثِيرٍ مِنْ أَهْلِ قَرْيَةٍ."},{"w":"مِن قَرۡيَتِكَ","m":"مِنْ أَهْلِ قَرْيَتِكَ."}],"15":[{"w":"مَثَلُ","m":"صِفَةُ."},{"w":"ءَاسِنٖ","m":"مُتَغَيِّرٍ."},{"w":"لَذَّةٖ","m":"ذَاتِ لَذّةٍ."},{"w":"حَمِيمٗا","m":"تَنَاهَى في شِدَّةِ حَرِّهِ."}],"16":[{"w":"ءَانِفًا","m":"الآنَ، أي: أوَّلَ وَقْتٍ يَقْرُبُ مِنَّا."},{"w":"طَبَعَ","m":"خَتَمَ."}],"18":[{"w":"فَهَلۡ يَنظُرُونَ","m":"فَمَا يَنْتَظِرُونَ."},{"w":"بَغۡتَةٗ","m":"فَجْأَةً."},{"w":"أَشۡرَاطُهَا","m":"عَلامَاتُها."},{"w":"ذِكۡرَىٰهُمۡ","m":"تَذَكُّرُهُم ما ضَيَّعُوا مِن طَاعَةِ اللهِ."}],"19":[{"w":"مُتَقَلَّبَكُمۡ","m":"تَصَرُّفَكُم في يَقَظَتِكُم نَهاراً."},{"w":"وَمَثۡوَىٰكُمۡ","m":"ومُسْتَقَرَّكُم في نَوْمِكُم لَيلاً."}],"20":[{"w":"لَوۡلَا","m":"هَلَّا."},{"w":"مُحۡكَمَةٞ","m":"لا نَسْخَ فِيها."},{"w":"مَرَضٞ","m":"شَكٌّ في دينِ اللهِ ونِفاقٌ."},{"w":"ٱلۡمَغۡشِيِّ عَلَيۡهِ","m":"المُحْتضَرِ الَّذي في سَكْرةِ الموتِ لا يَطْرِفُ بَصَرُه."},{"w":"مِنَ ٱلۡمَوۡتِ","m":"خَوْفَ الموتِ."},{"w":"فَأَوۡلَىٰ لَهُمۡ","m":"وَلِيَهُم شرٌّ فَلْيَحْذَرُوا."}],"21":[{"w":"عَزَمَ ٱلۡأَمۡرُ","m":"جَدَّ وعُزِمَ عَلَيهِ."}],"22":[{"w":"فَهَلۡ عَسَيۡتُمۡ","m":"فَلَعَلَّكُم."},{"w":"تَوَلَّيۡتُمۡ","m":"أَعْرَضْتُم."}],"23":[{"w":"لَعَنَهُمُ","m":"أَبْعَدَهُم."}],"24":[{"w":"يَتَدَبَّرُونَ","m":"يتأمَّلُونَ."},{"w":"أَمۡ","m":"بَلْ."},{"w":"عَلَىٰ قُلُوبٍ أَقۡفَالُهَآ","m":"قُلُوبُهم مُقْفَلَةٌ، فلا يَصِلُ إِلَيها ذِكْرُ اللهِ."}],"25":[{"w":"سَوَّلَ","m":"زَيَّنَ."},{"w":"وَأَمۡلَىٰ لَهُمۡ","m":"أَطَالَ لَهُم أَمَلَهُم."}],"27":[{"w":"فَكَيۡفَ","m":"أَيْ: فَكَيفَ حَالُهُم؟"},{"w":"تَوَفَّتۡهُمُ","m":"قَبَضَتْ أَرْواحَهُم."}],"29":[{"w":"أَمۡ حَسِبَ","m":"بَلْ أَظَنَّ؟"},{"w":"أَضۡغَٰنَهُمۡ","m":"أَحْقادَهُم وعَدَاوَتَهُم."}],"30":[{"w":"بِسِيمَٰهُمۡ","m":"بِعَلاماتٍ ظاهِرَةٍ فِيهِم."},{"w":"لَحۡنِ ٱلۡقَوۡلِ","m":"فَحْوى الكلامِ ومَعْناهُ."}],"31":[{"w":"وَلَنَبۡلُوَنَّكُمۡ","m":"وَلَنَخْتَبِرَنَّكُم."}],"32":[{"w":"وَشَآقُّواْ","m":"وَخَالَفُوا."},{"w":"وَسَيُحۡبِطُ","m":"وسَيُبْطِلُ."}],"35":[{"w":"ٱلسَّلۡمِ","m":"الصُّلْحِ."},{"w":"يَتِرَكُمۡ","m":"يَنْقُصَكُم."}],"37":[{"w":"فَيُحۡفِكُمۡ","m":"فيُلِحَّ عليكُم، وَيُبَالِغْ في طَلَبِها."}]}