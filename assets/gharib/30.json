{"1":[{"w":"الٓمٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"3":[{"w":"أَدۡنَى ٱلۡأَرۡضِ","m":"أقْرَبِ أرْضِ الشَّامِ إلى فارِس."},{"w":"غَلَبِهِمۡ","m":"أي: كَوْنِهِم مَغْلُوبِينَ."}],"4":[{"w":"بِضۡعِ سِنِينَ","m":"أي: ما بينَ الثَّلاثَةِ إلى العَشْرَةِ."}],"7":[{"w":"ظَٰهِرٗا مِّنَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","m":"فَيَنْظُرُونَ إلى الأسْبابِ الظَّاهِرَةِ وَلَا يَنْظُرُونَ إلى مُسَبِّبِها المتَصَرِّفِ فِيها الَّذي هُوَ اللهُ تَعالى."}],"8":[{"w":"أَوَ لَمۡ يَتَفَكَّرُواْ","m":"أَوَلَمْ يَتَأَمَّلُوا وَيَتَدَبَّرُوا."},{"w":"أَجَلٖ مُّسَمّٗى","m":"وَقْتٍ مُقَدَّرٍ هُوَ يومُ القِيامَةِ."},{"w":"بِلِقَآيِٕ رَبِّهِمۡ","m":"المُرَادُ به البَعْثُ بَعْدَ الموتِ."}],"9":[{"w":"عَٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡ","m":"أي: مَصِيرُهُم الَّذي انْتهَوا إِليهِ."},{"w":"وَأَثَارُواْ ٱلۡأَرۡضَ","m":"حَرَثُوها للزِّرَاعَةِ."},{"w":"وَعَمَرُوهَآ","m":"أي: بالبُنْيانِ والزِّراعَةِ."},{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالبَراهِينِ الواضِحةِ، ومنها المُعْجِزَاتُ الحِسِّيةُ."}],"10":[{"w":"ٱلسُّوٓأَىٰٓ","m":"تَأْنِيثُ «الأسْوأ»، ومعناها: العُقُوبَةُ المتناهِيةُ في السُّوءِ، وهي نارُ جَهَنَّم."}],"11":[{"w":"يَبۡدَؤُاْ","m":"يُنْشِئُ ابتِدَاءً."},{"w":"يُعِيدُهُۥ","m":"يُعِيدُ الخَلْقَ مِن بَعْدِ فَنائِهِ."}],"12":[{"w":"يُبۡلِسُ ٱلۡمُجۡرِمُونَ","m":"يَيْئَسُونَ بانْقِطاعِ حُجَّتِهِم."}],"13":[{"w":"مِن شُرَكَآئِهِمۡ","m":"أي: مِنْ آلهَتِهِم الَّتي كانُوا يَعْبُدُونَها مِن دُونِ اللهِ."}],"14":[{"w":"يَتَفَرَّقُونَ","m":"أي: فَرِيقٌ في الجنَّة، وفَرِيقٌ في السَّعِيرِ."}],"15":[{"w":"رَوۡضَةٖ","m":"المرادُ بِها هُنا «الجنَّةُ»."},{"w":"يُحۡبَرُونَ","m":"يُكَرَّمُونَ ويُنَعَّمُونَ."}],"16":[{"w":"وَلِقَآيِٕ ٱلۡأٓخِرَةِ","m":"أي: البَعْثِ بَعْدَ الموتِ."},{"w":"فِي ٱلۡعَذَابِ مُحۡضَرُونَ","m":"مُقيمُونَ فِيهِ."}],"17":[{"w":"فَسُبۡحَٰنَ ٱللَّهِ","m":"أي: فنزِّهُوهُ عمَّا لا يَلِيقُ بِه."},{"w":"حِينَ تُمۡسُونَ","m":"أي: وقْتَ دُخُولِكُم في المساءِ."},{"w":"وَحِينَ تُصۡبِحُونَ","m":"أي: وقْتَ دُخُولِكُم في الصَّباحِ."}],"18":[{"w":"وَعَشِيّٗا","m":"وقْتَ العَشِيِّ، أي: بَعْدَ زَوالِ الشَّمسِ."},{"w":"وَحِينَ تُظۡهِرُونَ","m":"أي: وَقْتَ الظَّهِيرَةِ."}],"19":[{"w":"بَعۡدَ مَوۡتِهَا","m":"أي: قَحْطِها وجَفَافِها."},{"w":"تُخۡرَجُونَ","m":"أي: تُبعثُونَ مِن قُبُورِكُم."}],"20":[{"w":"تَنتَشِرُونَ","m":"تَتَفَرَّقُونَ."}],"21":[{"w":"مِنۡ أَنفُسِكُمۡ","m":"مِن جِنْسِكُم."},{"w":"لِتَسۡكُنُوٓاْ إِلَيۡهَا","m":"لِتألَفُوها وتَطْمئنُّوا إِلَيها."},{"w":"مَوَدَّةٗ وَرَحۡمَةً","m":"مَحَبَّةً وشَفَقَةً."},{"w":"يَتَفَكَّرُونَ","m":"يَتَدَبَّرُونَ."}],"22":[{"w":"أَلۡسِنَتِكُمۡ","m":"لُغَاتِكُم."}],"23":[{"w":"ٱبۡتِغَآؤُكُم","m":"طَلَبُكُم والْتِماسُكُم."},{"w":"مِن فَضۡلِهِۦٓ","m":"مِن رِزْقِه."}],"24":[{"w":"خَوۡفٗا وَطَمَعٗا","m":"أي: خَوْفاً مِنَ الصَّواعِقِ وَطَمعاً في الغَيثِ."},{"w":"بَعۡدَ مَوۡتِهَآ","m":"بَعْدَ قَحْطِها وَجَفافِها."}],"25":[{"w":"بِأَمۡرِهِۦ","m":"بِإِرَادَتِه وَقُدْرَتِهِ."},{"w":"تَخۡرُجُونَ","m":"أي: مِن قُبُورِكُم أحْيَاءً."}],"26":[{"w":"لَهُۥ قَٰنِتُونَ","m":"مُنْقادُونَ لإرَادَتِه."}],"27":[{"w":"يَبۡدَؤُاْ","m":"يُنْشِئُ."},{"w":"أَهۡوَنُ","m":"هيِّنٌ وَيَسِيرٌ."},{"w":"ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ","m":"الوصْفُ الأَعْلى."}],"28":[{"w":"مَلَكَتۡ أَيۡمَٰنُكُم","m":"أي: العبِيدُ والإماءُ."},{"w":"كَخِيفَتِكُمۡ أَنفُسَكُمۡ","m":"أي: كَما تَخافُونَ الأحْرَارَ المُشَابِهِينَ لَكُم في الحرِّيَّةِ وتَمَلُّكِ الأمْوالِ."}],"30":[{"w":"فَأَقِمۡ وَجۡهَكَ لِلدِّينِ","m":"أي: اسْتَقِمْ واسْتَمِرَّ عَلى دِينِ الإسْلامِ."},{"w":"حَنِيفٗا","m":"مائِلاً إليه مُسْتَقِيماً عَلَيْهِ، غَيْرَ مُلْتَفِتٍ إلى غَيْرِه مِنَ الأدْيانِ الباطِلَةِ."},{"w":"فِطۡرَتَ ٱللَّهِ","m":"أي: الزَمُوا فِطْرَةَ اللهِ، وَهِيَ الإسْلامُ."},{"w":"فَطَرَ ٱلنَّاسَ عَلَيۡهَا","m":"أي: خَلَقَهُم عَلَيها."}],"31":[{"w":"مُنِيبِينَ إِلَيۡهِ","m":"راجِعِينَ إليهِ بالتَّوبَةِ والإخْلاصِ."}],"32":[{"w":"فَرَّقُواْ دِينَهُمۡ","m":"أي: آمَنُوا بِبَعْضٍ وكَفَرُوا بِبَعْضٍ."},{"w":"شِيَعٗا","m":"فِرَقاً وأحْزاباً مُخْتلِفَةً."},{"w":"كُلُّ حِزۡبِۭ","m":"كلُّ فَرِيقٍ."},{"w":"فَرِحُونَ","m":"مَسْرُورُونَ."}],"33":[{"w":"ضُرّٞ","m":"قَحْطٌ وَشِدَّةٌ."},{"w":"مُنِيبِينَ إِلَيۡهِ","m":"مُلْتَجِئِينَ إليهِ بالتَّوبَةِ والإخْلاصِ."},{"w":"أَذَاقَهُم مِّنۡهُ رَحۡمَةً","m":"أي: كَشَفَ عَنْهُم ضُرَّهُم."}],"35":[{"w":"سُلۡطَٰنٗا","m":"بُرْهاناً أو كِتاباً."}],"36":[{"w":"فَرِحُواْ بِهَا","m":"فرِحُوا بِها فَرَحَ بَطَرٍ لا فَرَحَ شُكْرٍ."},{"w":"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ","m":"أي: بِسَبَبِ أعْمالِهِم السَّيِّئةِ."},{"w":"يَقۡنَطُونَ","m":"يَيْئَسُونَ."}],"37":[{"w":"أَوَ لَمۡ يَرَوۡاْ","m":"أي: أَوَلَمْ يَعْلَمُوا."},{"w":"وَيَقۡدِرُ","m":"يُضَيِّقُ."}],"38":[{"w":"فَـَٔاتِ","m":"فأعْطِ."},{"w":"ٱلۡمِسۡكِينَ","m":"الفَقِيرَ الَّذِي لا يَمْلِكُ ما يَكْفِيهِ وَيَسُدُّ حاجَتَه."},{"w":"ٱبۡنَ ٱلسَّبِيلِ","m":"المُسَافِرَ المُحْتاجَ."}],"39":[{"w":"وَمَآ ءَاتَيۡتُم","m":"وما أَعطَيتُم."},{"w":"رِبٗا","m":"قَرْضاً أو هَدِيَّةً بِقَصْدِ الرِّبا والزِّيادَةِ."},{"w":"لِيَرۡبُوَاْ","m":"لِيَزِيدَ ويَنْمُوَ."},{"w":"فَلَا يَرۡبُواْ","m":"فَلا يَزِيدُ."},{"w":"ٱلۡمُضۡعِفُونَ","m":"أي: هُمْ أَصْحابُ الأجْرِ المُضَاعَفِ."}],"40":[{"w":"مِن شُرَكَآئِكُم","m":"مِن آلِهَتِكُم الَّتي تَعْبُدُونَها مِن دُونِ اللهِ."},{"w":"سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ","m":"تَنَزَّهَ اللهُ وتَقَدَّسَ."}],"41":[{"w":"بِمَا كَسَبَتۡ أَيۡدِي ٱلنَّاسِ","m":"أي: بِسَبَبِ أعْمالِهِم السَّيِّئةِ."},{"w":"بَعۡضَ ٱلَّذِي","m":"أي: عُقُوبَةَ بَعْضِ الَّذي."},{"w":"يَرۡجِعُونَ","m":"أي: يَتُوبُونَ إلى اللهِ."}],"43":[{"w":"لِلدِّينِ ٱلۡقَيِّمِ","m":"أي: نَحْوَ الدِّينِ المسْتَقِيم، وهو الإسْلامُ."},{"w":"لَا مَرَدَّ لَهُۥ","m":"أي: لا يقْدِرُ أحدٌ على ردِّهِ."},{"w":"يَصَّدَّعُونَ","m":"يَتَفَرَّقُونَ، فَرِيقٌ في الجنَّةِ وفَرِيقٌ في السَّعيرِ."}],"44":[{"w":"يَمۡهَدُونَ","m":"يُوَطِّئُونَ ويُهَيِّئُونَ الطَّريقَ إلى مَنَازِلَ في الجنَّةِ."}],"46":[{"w":"مُبَشِّرَٰتٖ","m":"أي: بِنُزُولِ المَطَرِ."},{"w":"مِن رَّحۡمَتِهِۦ","m":"والمرادُ بها هُنا: المَطرُ."},{"w":"ٱلۡفُلۡكُ","m":"السُّفُنُ."},{"w":"لِتَبۡتَغُواْ","m":"لِتَطْلُبُوا."}],"47":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالمُعْجِزاتِ والبراهِينِ الواضِحةِ."},{"w":"ٱلَّذِينَ أَجۡرَمُواْ","m":"الَّذينَ فَعَلُوا الإجْرَامَ واكْتَسَبُوا السَّيِّئاتِ."}],"48":[{"w":"فَتُثِيرُ","m":"فتُحَرِّكُ وتَنْشُرُ."},{"w":"فَيَبۡسُطُهُۥ","m":"فَيَنْشُرُه."},{"w":"كِسَفٗا","m":"قِطَعاً متفرِّقةً."},{"w":"ٱلۡوَدۡقَ","m":"المطَرَ."},{"w":"مِنۡ خِلَٰلِهِۦ","m":"مِنْ فُرَجِ السَّحابِ ووَسَطِه."},{"w":"يَسۡتَبۡشِرُونَ","m":"يَفْرَحُونَ."}],"49":[{"w":"لَمُبۡلِسِينَ","m":"لَآيسِينَ مِن نُّزُولِ المطَرِ."},{"w":"بَعۡدَ مَوۡتِهَآ","m":"بَعْدَ جَدْبِها وجَفافِها."}],"51":[{"w":"رِيحٗا","m":"أي: رِيحاً مُفْسِدَةً لِنَباتِهم."},{"w":"فَرَأَوۡهُ مُصۡفَرّٗا","m":"فَرَأَوُا النَّباتَ مُصْفَرّاً بَعْدَ الخُضْرَةِ."},{"w":"لَظَلُّواْ","m":"لَصارُوا."},{"w":"يَكۡفُرُونَ","m":"باللهِ ويَجْحَدُون نِعَمَهُ الماضِيَة."}],"52":[{"w":"وَلَّوۡاْ","m":"انصَرَفُوا."}],"53":[{"w":"بِهَٰدِ ٱلۡعُمۡيِ","m":"بمُرْشِدٍ مَنْ أعْماهُ اللهُ عَنِ الحقِّ."},{"w":"مُسۡلِمُونَ","m":"خاضِعُونَ مُنْقادُونَ."}],"54":[{"w":"مِن ضَعۡفٖ","m":"أي: مِن نُّطْفَةٍ ضَعِيفَةٍ."},{"w":"مِنۢ بَعۡدِ ضَعۡفٖ","m":"أي: مِن بَعْدِ ضَعْفِ الطُّفولَةِ والصِّغَرِ."},{"w":"قُوَّةٖ","m":"أي: قُوَّةِ الشَّبابِ."},{"w":"ضَعۡفٗا","m":"أي: ضَعْفَ الكِبَرِ والهرَمِ."},{"w":"وَشَيۡبَةٗ","m":"أي: بياضاً في الشَّعْرِ وضَعْفاً في قُوى الجِسمِ."}],"55":[{"w":"غَيۡرَ سَاعَةٖ","m":"غيرَ فَتْرَةٍ قَصِيرةٍ مِنَ الزَّمَنِ."},{"w":"يُؤۡفَكُونَ","m":"يُصْرَفُونَ عَنِ الحقِّ والصِّدقِ."}],"57":[{"w":"مَعۡذِرَتُهُمۡ","m":"اعْتِذَارُهُم."},{"w":"وَلَا هُمۡ يُسۡتَعۡتَبُونَ","m":"لا يُطْلَبُ مِنْهُم إرْضَاءُ اللهِ تَعالَى بالتَّوبَةِ والطَّاعَةِ."}],"58":[{"w":"بِـَٔايَةٖ","m":"أي: بِأيِّ حُجَّةٍ."},{"w":"مُبۡطِلُونَ","m":"أي: أصْحابُ أباطِيلَ."}],"59":[{"w":"يَطۡبَعُ","m":"يَخْتِمُ، فلا تَعِي شيئاً مِنَ الحَقِّ."}],"60":[{"w":"وَلَا يَسۡتَخِفَّنَّكَ","m":"لا يَحْمِلَنَّكَ على الخِفَّةِ وتَرْكِ الصَّبْرِ."}]}