{"2":[{"w":"مِن ذِكۡرٖ","m":"أي: مِنْ قُرْآنٍ."},{"w":"مُحۡدَثٍ","m":"أي: يَتَجَدَّدُ نُزُولُه."}],"3":[{"w":"لَاهِيَةٗ","m":"غافِلةً."},{"w":"وَأَسَرُّواْ ٱلنَّجۡوَى","m":"اجْتَمَعُوا سِرّاً على أَمْرٍ خَفِيٍّ."},{"w":"ٱلسِّحۡرَ","m":"القرآنَ (على زَعْمِ الكُفَّار)."}],"5":[{"w":"أَضۡغَٰثُ أَحۡلَٰمِۭ","m":"أَخْلاطُ أَحْلامٍ لا حقيقةَ لها."},{"w":"بَلِ ٱفۡتَرَىٰهُ","m":"بَلِ اخْتَلَقَه."}],"7":[{"w":"إِلَّا رِجَالٗا","m":"أي: مِنَ الْبَشَرِ فقط."},{"w":"أَهۡلَ ٱلذِّكۡرِ","m":"أَهْلَ الْعِلْمِ بالْكُتُبِ المُنَزَّلةِ السَّابقَةِ."}],"9":[{"w":"ٱلۡمُسۡرِفِينَ","m":"المُتَجاوِزِينَ الحَدَّ بِكُفْرِهم بِرَبِّهم."}],"10":[{"w":"ذِكۡرُكُمۡ","m":"عِزُّكُم وشَرَفُكم إنْ عَمِلْتُم بما جاءَ فيه."}],"11":[{"w":"قَصَمۡنَا","m":"أَهْلَكْنا واسْتَأْصَلْنا."},{"w":"كَانَتۡ ظَالِمَةٗ","m":"كانَ أهلُها ظالِمينَ بِكُفْرِهم باللهِ، وبِما جاءتْهم به رُسُلُه."},{"w":"وَأَنشَأۡنَا","m":"خَلَقْنا وأَوْجَدْنا."}],"12":[{"w":"أَحَسُّواْ بَأۡسَنَآ","m":"أي: عَلِمُوا وتيَقَّنُوا بِوُقُوعِ عَذابِنا بِمُشاهَدَةِ بَوادِرِه."},{"w":"يَرۡكُضُونَ","m":"يَهرُبُون مُسرِعِينَ."}],"13":[{"w":"لَا تَرۡكُضُواْ","m":"لا تَهرُبُوا."},{"w":"أُتۡرِفۡتُمۡ فِيهِ","m":"أُنْعِمْتُم فِيه مِنَ التَّرفِ."},{"w":"لَعَلَّكُمۡ تُسۡـَٔلُونَ","m":"لَعَلَّكُم تُسْأَلُونَ مِن دُنْياكُم شَيْئاً، قِيلَ لَهُم ذَلك اسْتِهْزاءً بِهِم."}],"14":[{"w":"يَٰوَيۡلَنَآ","m":"يا هَلَاكَنا."}],"15":[{"w":"تِلۡكَ دَعۡوَىٰهُمۡ","m":"أي: كلِمتَهم: «يا ويلَنا» يَدْعُونَ بها، ويُرَدِّدُونَها."},{"w":"حَصِيدًا","m":"مُسْتَأْصَلِينَ كما يُحصَدُ الزَّرْعُ."},{"w":"خَٰمِدِينَ","m":"هالِكِينَ، قدِ انْطَفَأَتْ شَرَارَةُ حَياتِهم."}],"16":[{"w":"لَٰعِبِينَ","m":"عَبَثاً ولَهْواً وباطِلاً."}],"17":[{"w":"لَهۡوٗا","m":"ما يُتلهَّى بِه مِن زَوْجَةٍ ووَلَدٍ."},{"w":"مِن لَّدُنَّآ","m":"مِن عِنْدِنا مِن أَهْل السَّماءِ مِنَ الْحُورِ الْعِينِ."}],"18":[{"w":"بَلۡ نَقۡذِفُ","m":"بل نَرْمِي."},{"w":"فَيَدۡمَغُهُۥ","m":"فيَمْحَقُه ويَدْحَضُه."},{"w":"زَاهِقٞ","m":"زَائِلٌ وذاهِبٌ."},{"w":"ٱلۡوَيۡلُ","m":"العَذَابُ."}],"19":[{"w":"لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ","m":"لا يَتَعاظَمُونَ عَن عِبادتِه."},{"w":"وَلَا يَسۡتَحۡسِرُونَ","m":"لا يُصِيبُهُم إعياءٌ ولا مَلَلٌ مِن عِبادَةِ اللهِ."}],"20":[{"w":"لَا يَفۡتُرُونَ","m":"لا يَضْعُفُونَ ولا يَسْأمُونَ."}],"21":[{"w":"أَمِ ٱتَّخَذُوٓاْ ءَالِهَةٗ مِّنَ ٱلۡأَرۡضِ هُمۡ يُنشِرُونَ","m":"هَلِ اتَّخَذَ المُشْرِكُونَ آلهةً مِنَ الأرْضِ قادِرَةً على إحْياءِ المَوتى؟"}],"22":[{"w":"لَفَسَدَتَا","m":"لبَطَلَتا، واخْتَلَّ نِظامُهما."},{"w":"فَسُبۡحَٰنَ ٱللَّهِ","m":"تَنَزَّهَ اللهُ تعالى."},{"w":"عَمَّا يَصِفُونَ","m":"عَمَّا يَصِفُه الكافِرونَ مِنِ ادِّعاءِ شَريكٍ لَه."}],"24":[{"w":"أَمِ ٱتَّخَذُواْ","m":"بَلِ اتَّخَذُوا."},{"w":"هَاتُواْ بُرۡهَٰنَكُمۡ","m":"ايتُوا بِحُجَّتِكُم على اتِّخاذِكُم الآلِهَةَ المزْعُومةَ."},{"w":"ذِكۡرُ مَن مَّعِيَ","m":"القرآنُ الذي جِئْتُ به."},{"w":"وَذِكۡرُ مَن قَبۡلِي","m":"أي: الكُتُبُ السَّابِقَةُ."}],"26":[{"w":"ٱتَّخَذَ ٱلرَّحۡمَٰنُ وَلَدٗا","m":"أي: بزَعْمِهِم أنَّ الملائِكةَ بناتُ اللهِ."},{"w":"سُبۡحَٰنَهُۥ","m":"تَنَزَّهَ اللهُ عَنْ ذَلِكَ."},{"w":"مُكۡرَمُونَ","m":"أَكْرَمَهُم الله بِعِبادَتِه وَخَصَّصَهم بالفَضَائِلِ."}],"27":[{"w":"لَا يَسۡبِقُونَهُۥ بِٱلۡقَوۡلِ","m":"أي: لا يَتَكَلَّمُونَ إِلَّا بمَا يأْمُرُهم بِه ربُّهم؛ لِكَمالِ انْقِيادِهم وطاعَتِهم."}],"28":[{"w":"يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ","m":"يَعلَمُ كلَّ ما عَمِلُوه."},{"w":"وَمَا خَلۡفَهُمۡ","m":"وما هم عامِلُونَ في الُمسْتَقْبَل."},{"w":"إِلَّا لِمَنِ ٱرۡتَضَىٰ","m":"أي: إلا لِمَنْ رَضِيَ اللهُ بشَفاعَتِهم لَهُ."},{"w":"مُشۡفِقُونَ","m":"حَذِرونَ أن يَعْصُوه."}],"30":[{"w":"رَتۡقٗا","m":"مُلْتَصِقَتَينِ لا فاصِلَ بَيْنَهما."},{"w":"فَفَتَقۡنَٰهُمَا","m":"ففَصَلْناهُما بِقُدرَتِنا."}],"31":[{"w":"رَوَٰسِيَ","m":"جبالاً ثَوَابِتَ."},{"w":"أَن تَمِيدَ بِهِمۡ","m":"لِئلا تَتَحَرَّكَ الأرضُ وَتَضطَرِبَ بِأهْلِها."},{"w":"فِجَاجٗا سُبُلٗا","m":"طُرُقاً واسِعةً."}],"32":[{"w":"سَقۡفٗا","m":"أي: سَقْفاً لِلأَرْضِ."},{"w":"مَحۡفُوظٗا","m":"أي: عَنِ السُّقوطِ، وعَنِ اخْتِراقِ الشَّياطِينِ."}],"33":[{"w":"كُلّٞ","m":"أي: كلٌّ مِنَ الشَّمسِ والقَمَرِ والنُّجُومِ."},{"w":"فَلَكٖ","m":"مَدَارٍ."},{"w":"يَسۡبَحُونَ","m":"يدُورُونَ بانْبِساطٍ وسُهُولةٍ."}],"34":[{"w":"ٱلۡخُلۡدَ","m":"دَوَامَ البقاءِ في الدُّنيا."}],"35":[{"w":"وَنَبۡلُوكُم","m":"نَخْتَبِرُكُم ونَبْتَلِيكُم."},{"w":"فِتۡنَةٗ","m":"اخْتِباراً وابْتِلاءً."}],"36":[{"w":"هُزُوًا","m":"مُسْتَهْزَأً بِك."},{"w":"يَذۡكُرُ ءَالِهَتَكُمۡ","m":"يَعِيبُ آلهتَكُم."}],"37":[{"w":"خُلِقَ ٱلۡإِنسَٰنُ مِنۡ عَجَلٖ","m":"خُلِقَ الإنسانُ عَجُولاً مُتَسَرِّعاً بِفِطْرَتِه."},{"w":"سَأُوْرِيكُمۡ ءَايَٰتِي","m":"أي: بنَصْرِ هذا الدِّينِ وهَلاكِ مَن كَفَرَ به وحارَبَه."}],"38":[{"w":"ٱلۡوَعۡدُ","m":"أي: الوعدُ بالعذابِ."}],"39":[{"w":"لَا يَكُفُّونَ","m":"لا يَقْدِرُونَ أن يَمْنَعُوا."}],"40":[{"w":"بَغۡتَةٗ","m":"فَجْأَةً."},{"w":"فَتَبۡهَتُهُمۡ","m":"فتُحَيِّرُهم."},{"w":"وَلَا هُمۡ يُنظَرُونَ","m":"ولا هم يُؤخَّرُونَ، أَوْ يُمهَلُونَ لتوبَةٍ أو اعْتِذارٍ."}],"41":[{"w":"فَحَاقَ","m":"نَزَلَ وأَحَاطَ."},{"w":"سَخِرُواْ مِنۡهُم","m":"اسْتَهْزَؤُوا بهم."}],"42":[{"w":"يَكۡلَؤُكُم","m":"يَحْفَظُكُم ويَحْرُسُكُم."},{"w":"مِنَ ٱلرَّحۡمَٰنِ","m":"أي: مِنْ عَذابِه وعِقابِه إذا حَلَّ بِكُم."},{"w":"ذِكۡرِ رَبِّهِم","m":"أي: القرآنِ وما فيه مِن موَاعِظَ."}],"43":[{"w":"وَلَا هُم مِّنَّا يُصۡحَبُونَ","m":"أي: ولا هم يُجارُون مِنْ عَذابِنا."}],"44":[{"w":"بَلۡ مَتَّعۡنَا هَـٰٓؤُلَآءِ","m":"بل أمهَلْناهُم؛ لِيَتَمَتَّعُوا."},{"w":"نَنقُصُهَا مِنۡ أَطۡرَافِهَآ","m":"أي: نَنْقُصُ أرضَ الكفَّارِ بالظُّهُورِ والغَلَبَةِ عليها مِن كُلِّ ناحيةٍ وجِهَةٍ، فنَفْتحُها بلَداً بعد بلَدٍ."},{"w":"أَفَهُمُ ٱلۡغَٰلِبُونَ","m":"أي: كيف يكونُون غالِبينَ بعد نَقْصِنا لأَرْضِهم مِنْ أطْرَافِها؟"}],"45":[{"w":"أُنذِرُكُم","m":"أُخَوِّفُكُم."},{"w":"بِٱلۡوَحۡيِ","m":"بالقرآنِ."},{"w":"ٱلصُّمُّ","m":"جمعُ الأصَمّ، وهو الذي لا يَسْمَعُ، والمرادُ الكافرُ الذي لا يُصْغِي لِلْحَقِّ."},{"w":"ٱلدُّعَآءَ","m":"النِّداءَ."}],"46":[{"w":"مَسَّتۡهُمۡ","m":"أصابَتْهُم."},{"w":"نَفۡحَةٞ","m":"دُفْعَةٌ يسيرةٌ."},{"w":"يَٰوَيۡلَنَآ","m":"يا هلاكَنا."}],"47":[{"w":"ٱلۡمَوَٰزِينَ ٱلۡقِسۡطَ","m":"المَوَازِينَ العادلةَ."},{"w":"لِيَوۡمِ ٱلۡقِيَٰمَةِ","m":"لِأهْلِ يومِ القيامةِ."},{"w":"مِثۡقَالَ حَبَّةٖ","m":"وزنَ حَبَّة."},{"w":"خَرۡدَلٍ","m":"وهو أصغرُ الحُبوبِ، والمرادُ أصْغرُ شَيءٍ."}],"48":[{"w":"ٱلۡفُرۡقَانَ","m":"المُعْجِزاتِ التي يُمَيَّزُ بها الحقُّ عنِ الْباطِلِ."},{"w":"وَضِيَآءٗ","m":"أي: التَّوْرَاةَ التي أضاءتْ لهم أمرَ دينِهِم."},{"w":"وَذِكۡرٗا","m":"يَتَذَكَّرُونَ بما في التَّوراةِ من المواعظِ."}],"49":[{"w":"يَخۡشَوۡنَ رَبَّهُم","m":"يخافُونَ عذابَه."},{"w":"بِٱلۡغَيۡبِ","m":"في حالِ غيابِهم عَنْ أَعْيُنِ النَّاسِ."},{"w":"مُشۡفِقُونَ","m":"خائِفُونَ."}],"50":[{"w":"وَهَٰذَا ذِكۡرٞ","m":"وهذا القرآنُ موعظَة لِمَن اتَّعَظَ به."}],"51":[{"w":"رُشۡدَهُۥ","m":"هُداه اللائقَ به."},{"w":"مِن قَبۡلُ","m":"مِن قَبْلِ مُوسى وهارُونَ."}],"52":[{"w":"ٱلتَّمَاثِيلُ","m":"الأصنامُ التي صَنَعْتُمُوها بِأَيْدِيكُم."},{"w":"لَهَا عَٰكِفُونَ","m":"مُقِيمُونَ على عِبادَتِها على الدَّوامِ."}],"54":[{"w":"ضَلَٰلٖ مُّبِينٖ","m":"بُعْدٍ عن الحَقِّ واضِحٍ لا لَبْس فِيه."}],"55":[{"w":"بِٱلۡحَقِّ","m":"أي: أجادٌّ أنت فيما تَقُولُ؟"},{"w":"مِنَ ٱللَّـٰعِبِينَ","m":"مِن الهازِلِينَ."}],"56":[{"w":"فَطَرَهُنَّ","m":"خَلَقَهُنَّ."}],"57":[{"w":"لَأَكِيدَنَّ أَصۡنَٰمَكُم","m":"لَأَمْكُرَنَّ بأصنامِكُم ولَأُكسِّرنَّها."}],"58":[{"w":"جُذَٰذًا","m":"حُطاماً قِطَعاً مُكسَّرةً."}],"60":[{"w":"يَذۡكُرُهُمۡ","m":"يَعِيبُهم."}],"61":[{"w":"عَلَىٰٓ أَعۡيُنِ ٱلنَّاسِ","m":"ظاهراً بِمَرْأىً مِنَ النَّاسِ."},{"w":"يَشۡهَدُونَ","m":"أي: يَشْهَدُونَ عليه أنَّه يَذْكُرُهم بِسُوءٍ."}],"65":[{"w":"نُكِسُواْ عَلَىٰ رُءُوسِهِمۡ","m":"أي: لمّا غُلِبوا في الحُجَّةِ غَيَّروا رأيَهم."}],"67":[{"w":"أُفّٖ لَّكُمۡ","m":"قُبْحاً لكم."}],"70":[{"w":"كَيۡدٗا","m":"مَكْراً لهلاكِه."}],"71":[{"w":"إِلَى ٱلۡأَرۡضِ","m":"هي أرضُ «الشَّام»."},{"w":"بَٰرَكۡنَا فِيهَا","m":"أي: بِكَثْرَةِ الخيراتِ، وبِكَوْنِها أَرْضَ الأنبياءِ عليهمُ الصَّلاةُ والسَّلامُ."}],"72":[{"w":"وَيَعۡقُوبَ نَافِلَةٗ","m":"زِيادةً عمّا طَلَبَ إبراهيمُ عليه الصَّلاةُ والسَّلامُ."}],"74":[{"w":"حُكۡمٗا","m":"نُبُوَّةً وفَصْلَ القَضاءِ بينَ الخُصُومِ."},{"w":"ٱلۡقَرۡيَةِ","m":"هي قريةُ «سَدُوم»."},{"w":"ٱلۡخَبَٰٓئِثَ","m":"هي أفعالُهم الُمنْكَرَةُ من إتيانِهم الرِّجالَ، وقَطْعِ السبيلِ وغيرِ ذلك."},{"w":"قَوۡمَ سَوۡءٖ","m":"قوماً عُرِفُوا بالأعمالِ القبيحةِ."},{"w":"فَٰسِقِينَ","m":"خارجِينَ عَن طاعةِ اللهِ."}],"75":[{"w":"فِي رَحۡمَتِنَآ","m":"أي: بِإِنجائنا إيَّاه ممّا حلَّ بقَومه من العَذاب."}],"76":[{"w":"مِن قَبۡلُ","m":"أي: مِن قَبْلِ إبراهيمَ ولوطٍ عليهما الصَّلاةُ والسَّلامُ."},{"w":"ٱلۡكَرۡبِ","m":"أي: الغَرَقِ بالطُّوفانِ."}],"77":[{"w":"بِـَٔايَٰتِنَآ","m":"بِحُجَجِنا الدالَّةِ على صِدْقِه."},{"w":"قَوۡمَ سَوۡءٖ","m":"قَوماً عُرِفُوا بالسُّوءِ والقُبْحِ."},{"w":"فَأَغۡرَقۡنَٰهُمۡ","m":"أي: بالطُّوفانِ الذي حَلَّ بهم."}],"78":[{"w":"فِي ٱلۡحَرۡثِ","m":"أي: في قَضِيَّةِ الحَرْثِ."},{"w":"نَفَشَتۡ فِيهِ","m":"انْتَشَرَتْ في الْحَرْثِ ليلاً مِنْ غَيرِ راعٍ."}],"79":[{"w":"فَفَهَّمۡنَٰهَا سُلَيۡمَٰنَ","m":"ففَهَّمنا سُليمانَ المسْأَلةَ بِمُراعاةِ مَصْلَحَةِ الطرفَينِ بالْعَدْلِ."},{"w":"حُكۡمٗا وَعِلۡمٗا","m":"نُبُوَّةً وعِلْماً بأحْكامِ اللهِ."},{"w":"وَسَخَّرۡنَا","m":"طَوَّعْنا."}],"80":[{"w":"صَنۡعَةَ لَبُوسٖ","m":"صِناعةَ دُروعٍ تُلبَسُ في الحربِ."},{"w":"لِتُحۡصِنَكُم","m":"لِتَحْمِيَكم وتحفظَكُم."},{"w":"مِنۢ بَأۡسِكُمۡ","m":"مِنْ حَرْبِكُم."}],"81":[{"w":"عَاصِفَةٗ","m":"شديدةَ الهُبُوب."},{"w":"إِلَى ٱلۡأَرۡضِ","m":"أي: أرْضِ بيتِ المقْدِسِ بالشَّامِ."}],"82":[{"w":"يَغُوصُونَ لَهُۥ","m":"يَنْزِلُونَ له في البحرِ لاسْتِخْراجِ ما يُطْلَبُ."},{"w":"حَٰفِظِينَ","m":"أي: حفِظَهمُ اللهُ من أَنْ يَنْفَلِتُوا عَنْ سُليمانَ ومِنْ أَنْ يُفْسِدُوا أعْمالَهم."}],"83":[{"w":"مَسَّنِيَ ٱلضُّرُّ","m":"أصابَنِي الضُّرُّ مِن مَّرَضٍ ونَحْوِه."}],"84":[{"w":"فَكَشَفۡنَا مَا بِهِۦ مِن ضُرّٖ","m":"فَرَفَعْنا عَنْه مَرَضَهُ بِشِفائِنا إيِّاهُ."},{"w":"وَذِكۡرَىٰ","m":"تَذْكِرَةً."}],"87":[{"w":"وَذَا ٱلنُّونِ","m":"أي: واذْكُرْ صاحِبَ الحُوتِ، و«ذو النُّون» لَقَبُ نَبِيِّ اللهِ يُونُسَ عليه الصَّلاةُ والسَّلامُ لابْتِلاعِ الحُوتِ لَه."},{"w":"مُغَٰضِبٗا","m":"غَضْبَانَ على قَومِه؛ لِكُفْرِهم."},{"w":"أَن لَّن نَّقۡدِرَ عَلَيۡهِ","m":"أن لَن نُّضَيِّقَ عليه، وَلَن نُّؤَاخِذَه بِخُروجِه مِن بَيْنِ قومِه."},{"w":"ٱلظُّلُمَٰتِ","m":"هي ظُلْمَةُ الليلِ، وظُلْمَةُ البحرِ، وظُلْمَةُ بَطْنِ الحُوتِ."}],"88":[{"w":"وَنَجَّيۡنَٰهُ مِنَ ٱلۡغَمِّ","m":"وخَلَّصْناه مِنْ غَمِّهِ بإخْرَاجِنا له مِن بَطْنِ الحُوتِ."}],"89":[{"w":"لَا تَذَرۡنِي فَرۡدٗا","m":"لا تَتْرُكْنِي وحِيداً لا عَقِبَ لي."}],"90":[{"w":"وَأَصۡلَحۡنَا لَهُۥ زَوۡجَهُۥٓ","m":"أي: جَعَلْناها صالحةً في أَخْلاقِها وصالحةً للحَمْلِ والولادةِ."},{"w":"وَيَدۡعُونَنَا رَغَبٗا","m":"يَعْبُدُونَنا راغِبينَ فيما عِنْدَنا."},{"w":"وَرَهَبٗا","m":"خَائِفِينَ من عُقُوبَتِنا."},{"w":"خَٰشِعِينَ","m":"مُتَواضِعِينَ مُتَذَلِّلينَ."}],"91":[{"w":"أَحۡصَنَتۡ فَرۡجَهَا","m":"حَفِظَتْ فَرْجَها مِنَ الْحَرَام، وَلَمْ يَمَسَّها بَشَرٌ."},{"w":"فَنَفَخۡنَا فِيهَا مِن رُّوحِنَا","m":"أي: أَمَرْنا جبريلَ حتَّى نَفَخَ في جَيْبِ قميصِها، فَخَلقَ اللهُ بذلكَ النَّفْخِ عيسى -عليه السلام- في بَطْنِها."},{"w":"ءَايَةٗ لِّلۡعَٰلَمِينَ","m":"علامةً للخلْقِ على قُدْرَةِ اللهِ تعالى."}],"92":[{"w":"أُمَّتُكُمۡ","m":"أي: مِلَّتُكُم وشريعَتُكُمْ أيُّها الأنبياءُ، عليهمُ الصَّلاةُ والسَّلامُ."},{"w":"أُمَّةٗ وَٰحِدَةٗ","m":"أي: دينُهم واحدٌ، وهو الإسلامُ."}],"93":[{"w":"وَتَقَطَّعُوٓاْ أَمۡرَهُم","m":"تَفَرَّقُوا في أَمْرِ دِينِهم فِرَقاً."}],"94":[{"w":"فَلَا كُفۡرَانَ لِسَعۡيِهِۦ","m":"لا جُحَودَ لِعَمَلِه، بل يُشْكَرُ سَعْيُه ويُثابُ عليه."}],"95":[{"w":"وَحَرَٰمٌ","m":"واجِبٌ."}],"96":[{"w":"فُتِحَتۡ يَأۡجُوجُ وَمَأۡجُوجُ","m":"أي: يُفْتَحُ السَّدُّ عنهما فينطَلِقُونَ."},{"w":"حَدَبٖ","m":"مَكانٍ مُرْتَفعٍ مِنَ الْأَرْضِ."},{"w":"يَنسِلُونَ","m":"يَتَفَّرقُونَ في الأَرْضِ مُسْرِعِينَ."}],"97":[{"w":"ٱلۡوَعۡدُ ٱلۡحَقُّ","m":"يومُ القيامةِ."},{"w":"شَٰخِصَةٌ","m":"مَفْتُوحَةٌ أجْفانُهم لا تَطْرِفُ."},{"w":"مِنۡ هَٰذَا","m":"أي: يومِ البعثِ والحسابِ."}],"98":[{"w":"حَصَبُ","m":"حَطَبُ."},{"w":"وَٰرِدُونَ","m":"داخِلُونَ."}],"100":[{"w":"زَفِيرٞ","m":"أنينُ تَنَفُّسِهم الشَّدِيدُ."},{"w":"لَا يَسۡمَعُونَ","m":"مِنْ هَولِ عَذابِهم."}],"101":[{"w":"ٱلۡحُسۡنَىٰٓ","m":"السَّعادَةُ بِدُخُولِ الجنَّة."},{"w":"عَنۡهَا","m":"أي: عَن نَّارِ جَهَنَّمَ."}],"102":[{"w":"حَسِيسَهَا","m":"أي: صَوْتَ لَهِيبِها."}],"103":[{"w":"لَا يَحۡزُنُهُمُ","m":"لا يُخِيفُهم."},{"w":"ٱلۡفَزَعُ ٱلۡأَكۡبَرُ","m":"الهولُ العظيمُ يومَ القيامةِ."},{"w":"تَتَلَقَّىٰهُمُ","m":"تَسْتَقْبِلُهم مُهَنِّئين."}],"104":[{"w":"كَطَيِّ ٱلسِّجِلِّ لِلۡكُتُبِ","m":"كما تُطوى الصَّحِيفةُ على ما دُوِّنَ فيها وكُتِبَ."},{"w":"كَمَا بَدَأۡنَآ أَوَّلَ خَلۡقٖ نُّعِيدُهُۥ","m":"أي: نُعيدُ الخَلْقَ حُفاةً عُراةً غُرْلاً يومَ القيامةِ، كما بَدَأْناهم أوَّلَ مرَّةٍ في بُطُونِ أمَّهاتِهم."}],"105":[{"w":"ٱلزَّبُورِ","m":"كِتابِ داودَ عليه الصلاةُ والسلامُ، أو الكُتُبِ المنزَّلَةِ."},{"w":"مِنۢ بَعۡدِ ٱلذِّكۡرِ","m":"أي: مِن بَعْدِ الكِتابةِ في الذِّكْرِ، وهو التَّوراةُ، أو اللَّوحُ المَحْفُوظُ."}],"106":[{"w":"إِنَّ فِي هَٰذَا","m":"أي: في هذا المَتْلُوِّ."},{"w":"لَبَلَٰغٗا","m":"وُصُولاً إلى البُغْيةِ."}],"108":[{"w":"مُسۡلِمُونَ","m":"مُسْتَسْلِمُونَ مُنْقَادُونَ للهِ تعالى."}],"109":[{"w":"فَإِن تَوَلَّوۡاْ","m":"فَإِنْ أَعْرَضُوا عَنِ الإِسْلامِ."},{"w":"ءَاذَنتُكُمۡ","m":"أَعْلَمْتُكُم بالحَرْبِ وأن لَّاصُلْحَ بيننا وَبَيْنكُم ولا سِلْمَ."},{"w":"عَلَىٰ سَوَآءٖ","m":"فأنا وأنتم مُسْتَوُونَ في العِلْمِ به."},{"w":"وَإِنۡ أَدۡرِيٓ","m":"لا أدْرِي."}],"111":[{"w":"لَعَلَّهُۥ فِتۡنَةٞ لَّكُمۡ","m":"أي: لعلَّ الإمهالَ اختبارٌ لَكُم."}],"112":[{"w":"قَٰلَ رَبِّ ٱحۡكُم بِٱلۡحَقِّ","m":"أي: افصِلْ بَيْنِي وَبَيْنَ قومِي بِما هُو الحقُّ عِنْدَكَ."}]}