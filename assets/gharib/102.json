{"1":[{"w":"أَلۡهَىٰكُمُ","m":"شَغَلَكُم عَن طاعَةِ اللهِ."},{"w":"ٱلتَّكَاثُرُ","m":"التَّفاخُرُ بِكَثْرةِ الأَمْوالِ والأولادِ."}],"2":[{"w":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","m":"وانْشَغَلتُم بِذَلِكَ إلى أَن دُفِنتم في المقابِر."}],"3":[{"w":"كَلَّا","m":"ما هَكَذا ينبغي أن يُلْهيَكُم التكاثُرُ بالأَمْوالِ."},{"w":"سَوۡفَ تَعۡلَمُونَ","m":"أَنَّ الدَّارَ الآخِرةَ خَيرٌ لَكُم."}],"5":[{"w":"لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","m":"لو تَعْلَمُونَ حَقَّ العِلْمِ لانْزَجَرْتُم، وَلَبادَرْتُم إلى إنقاذِ أَنفُسِكُم مِنَ الهَلاكِ."}],"6":[{"w":"لَتَرَوُنَّ ٱلۡجَحِيمَ","m":"لَتُبصِرُنَّ الجحِيمَ."}],"7":[{"w":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","m":"ثُمَّ لَتُبْصِرُنَّها دُونَ رَيبٍ."}],"8":[{"w":"يَوۡمَئِذٍ","m":"يومَ القِيامةِ."},{"w":"عَنِ ٱلنَّعِيمِ","m":"عَن كُلِّ أنَواعِ النَّعِيمِ."}]}