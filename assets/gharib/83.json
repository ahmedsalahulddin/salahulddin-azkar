{"1":[{"w":"وَيۡلٞ","m":"عذابٌ شَدِيدٌ."},{"w":"لِلۡمُطَفِّفِينَ","m":"وَهُمُ الَّذِينَ يَبْخَسُونَ المِكْيالَ والِميزانَ."}],"2":[{"w":"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ","m":"الَّذِينَ إذا اشْتَرَوا مِنَ النَّاسِ مَكِيلاً أو مَوزُوناً."},{"w":"يَسۡتَوۡفُونَ","m":"يَطْلُبُونَ وفاءَ نَصِيبِهِم."}],"3":[{"w":"وَإِذَا كَالُوهُمۡ","m":"وَإذا باعُوا النَّاس مَكِيلاً."},{"w":"وَزَنُوهُمۡ","m":"بَاعُوا النَّاسَ مَوزُوناً."},{"w":"يُخۡسِرُونَ","m":"يَنْقُصُونَ في المِكيالِ والِميزانِ."}],"4":[{"w":"يَظُنُّ","m":"يَعْتَقِدُ."}],"7":[{"w":"كَلَّآ","m":"ليسَ الأَمْرُ كَما يَظُنُّ هَؤُلاءِ الكُفَّارُ، أنَّهم غَيرُ مَبْعُوثِينَ."},{"w":"كِتَٰبَ ٱلۡفُجَّارِ","m":"صَحِيفةَ أَعْمالِ المُشْرِكِينَ."},{"w":"لَفِي سِجِّينٖ","m":"أَسْفَلِ الأرْضِ السَّابِعَةِ."}],"8":[{"w":"وَمَآ أَدۡرَىٰكَ","m":"وأيُّ شَيءٍ أعْلَمكَ؟"}],"9":[{"w":"مَرۡقُومٞ","m":"مَكْتُوبٌ كِتابَةً بَيِّنةً."}],"10":[{"w":"وَيۡلٞ","m":"عذابٌ شَدِيدٌ."}],"11":[{"w":"بِيَوۡمِ ٱلدِّينِ","m":"بُوقُوعِ يَومِ الجَزاءِ."}],"12":[{"w":"مُعۡتَدٍ","m":"ظالِمٍ."},{"w":"أَثِيمٍ","m":"كَثِيرِ الإِثْمِ."}],"13":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"أباطِيلُ السَّابِقِينَ."}],"14":[{"w":"رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ","m":"غَطَّى عَلى قُلُوبِهِم كَثْرَةُ ما يَرْتَكِبُونَهُ مِنَ الذُّنُوبِ."}],"15":[{"w":"عَن رَّبِّهِمۡ","m":"عَن رُؤْيَةِ رَبِّهِم جَلَّ وَعَلَا."},{"w":"لَمَحۡجُوبُونَ","m":"لَمَمْنُوعُونَ."}],"16":[{"w":"لَصَالُواْ ٱلۡجَحِيمِ","m":"لَدَاخِلُو النَّارِ."}],"18":[{"w":"كَلَّا","m":"حَقّاً."},{"w":"كِتَٰبَ","m":"صَحائِفَ أَعْمالِ."},{"w":"ٱلۡأَبۡرَارِ","m":"الأَتْقِيَاءِ."},{"w":"لَفِي عِلِّيِّينَ","m":"لَفِي المراتِبِ العالِيَةِ في الجنَّةِ."}],"20":[{"w":"كِتَٰبٞ مَّرۡقُومٞ","m":"مَكْتُوبٌ كِتابَةً بَيِّنةً."}],"21":[{"w":"يَشۡهَدُهُ","m":"يَطَّلِعُ عَلَيهِ."},{"w":"ٱلۡمُقَرَّبُونَ","m":"الملائكةُ المُقرَّبُونَ مِنَ اللهِ."}],"22":[{"w":"ٱلۡأَبۡرَارَ","m":"أَهْلَ الصِّدقِ والطَّاعَةِ."},{"w":"لَفِي نَعِيمٍ","m":"لَفِي الجنَّةِ يَتَنَعَّمُونَ."}],"23":[{"w":"ٱلۡأَرَآئِكِ","m":"الأَسِرَّةِ."},{"w":"يَنظُرُونَ","m":"يَنْظُرُونَ إلى رَبِّهِم، وَإلى ما أَعَدَّ لَهُم مِنْ خَيراتٍ."}],"24":[{"w":"نَضۡرَةَ ٱلنَّعِيمِ","m":"بَهْجَةَ النَّعِيمِ وحُسْنَه."}],"25":[{"w":"رَحِيقٖ","m":"خَمْرٍ صافِيةٍ."},{"w":"مَخۡتُومٍ","m":"مُحْكَمٍ إِناؤُها."}],"26":[{"w":"خِتَٰمُهُۥ","m":"آخِرُهُ."},{"w":"مِسۡكٞ","m":"رائِحَةُ مِسْكٍ."},{"w":"فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ","m":"فَليَتَسابَقِ المُتَسابِقُونَ."}],"27":[{"w":"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ","m":"وخَلْطُه مِنْ عَينٍ في الجنَّةِ تُعْرَفُ بـ «تَسْنِيمٍ»."}],"28":[{"w":"يَشۡرَبُ بِهَا","m":"أَيْ: مِنْهاَ."},{"w":"ٱلۡمُقَرَّبُونَ","m":"الأَبْرارُ المقَرَّبون مِن اللهِ، المُكَرَّمون في الجَنَّةِ."}],"29":[{"w":"أَجۡرَمُواْ","m":"ارْتَكَبُوا الإثمَ العَظِيمَ، وهو الشِّرْكُ."},{"w":"يَضۡحَكُونَ","m":"يَهْزَؤُونَ."}],"30":[{"w":"يَتَغَامَزُونَ","m":"يُشِيرُونَ بأطْرافِ العُيُونِ سُخْرِيَةً بِهم."}],"31":[{"w":"وَإِذَا ٱنقَلَبُوٓاْ","m":"رَجَعُوا."},{"w":"فَكِهِينَ","m":"مُتَفَكِّهِينَ بالسُّخْرِيَةِ مِنَ المُؤْمِنِينَ."}],"32":[{"w":"رَأَوۡهُمۡ","m":"رَأَى هَؤُلاءِ الكُفَّارُ أَصْحابَ مُحَمَّدٍ ﷺ."}],"33":[{"w":"حَٰفِظِينَ","m":"رُقَباءَ عَلَى أصْحابِ مُحَمَّدٍ ﷺ."}],"35":[{"w":"ٱلۡأَرَآئِكِ","m":"المجالِسِ الفاخِرَةِ."},{"w":"يَنظُرُونَ","m":"يَنْظُرُ المؤمِنُونَ إلى ما أَعْطاهُم اللهُ مِنَ الكَرَامةِ والنَّعِيم في الجنَّةِ."}],"36":[{"w":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ","m":"هل جُوزِي الكُفَّارُ مِن جِنْسِ أَعمالِهِم؟"}]}