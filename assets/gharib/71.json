{"1":[{"w":"أَنذِرۡ","m":"حَذِّرْ."}],"7":[{"w":"جَعَلُوٓاْ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِمۡ","m":"أي: لِئَلَّا يَسْمَعُوا دَعْوةَ الحقِّ."},{"w":"وَٱسۡتَغۡشَوۡاْ ثِيَابَهُمۡ","m":"تَغَطَّوا بِثيابِهِم عَلى أَعْيُنِهِم كَي لَا يَرَونِي."},{"w":"وَأَصَرُّواْ","m":"أي: عَلَى ما هُم فِيهِ مِنَ الكُفْرِ."}],"8":[{"w":"جِهَارٗا","m":"ظاهِراً عَلَناً."}],"9":[{"w":"أَعۡلَنتُ لَهُمۡ","m":"دَعَوتُهم بكَلَامٍ ظاهِرٍ وصَوْتٍ مرتَفِع."}],"11":[{"w":"يُرۡسِلِ ٱلسَّمَآءَ","m":"يُنْزِلِ اللهُ المَطَرَ."},{"w":"مِدۡرَارٗا","m":"كَثِيرَ الدَّرِّ والصَّبِّ."}],"12":[{"w":"وَيُمۡدِدۡكُم","m":"ويُعْطِكُم."}],"13":[{"w":"لَا تَرۡجُونَ لِلَّهِ وَقَارٗا","m":"لا تَخافُونَ عَظَمَةَ اللهِ وَسُلْطَانَهُ."}],"14":[{"w":"وَقَدۡ خَلَقَكُمۡ أَطۡوَارًا","m":"أطواراً مُتَدَرِّجَةً: نُطْفَةً، ثم عَلَقَةً، ثم مُضْغَةً، ثم عِظاماً ولحماً."}],"15":[{"w":"طِبَاقٗا","m":"مُتَطابِقَةً بعضُها فَوقَ بَعْضٍ."}],"16":[{"w":"سِرَاجٗا","m":"مُضِيئاً."}],"17":[{"w":"وَٱللَّهُ أَنۢبَتَكُم","m":"أَنْشأَ أَصْلَكُم."},{"w":"نَبَاتٗا","m":"إِنْشاءً."}],"18":[{"w":"وَيُخۡرِجُكُمۡ","m":"يَومَ البَعْثِ."}],"19":[{"w":"بِسَاطٗا","m":"مُمهَّدةً كالبِساطِ."}],"20":[{"w":"سُبُلٗا","m":"طُرُقًا."},{"w":"فِجَاجٗا","m":"واسِعةً."}],"22":[{"w":"كُبَّارٗا","m":"عَظِيماً."}],"23":[{"w":"لَا تَذَرُنَّ ءَالِهَتَكُمۡ","m":"لا تَترُكُوا عِبادةَ آلهتِكُم."},{"w":"وَلَا تَذَرُنَّ وَدّٗا وَلَا سُوَاعٗا وَلَا يَغُوثَ وَيَعُوقَ وَنَسۡرٗا","m":"وَلَا تَتْرُكُوا عِبادةَ هَذِهِ الأصْنامِ الَّتِي هي تَماثِيلُ رجالٍ صالِحِينَ."}],"24":[{"w":"كَثِيرٗا","m":"مِنَ النَّاسِ."},{"w":"ٱلظَّٰلِمِينَ","m":"لِأَنفُسِهِم بالكُفْرِ والعِنادِ."},{"w":"ضَلَٰلٗا","m":"بُعْداً عَن الحقِّ."}],"25":[{"w":"مِمَّا خَطِيٓـَٰٔتِهِمۡ","m":"بِسَبَبِ ذُنُوبِهِم وَإِصْرارِهِم عَلَى الكُفْرِ والطُّغْيانِ."},{"w":"أُغۡرِقُواْ","m":"بالطُّوفانِ."},{"w":"أَنصَارٗا","m":"مَن يَنْصُرُهُم، أو يَدْفَعُ عَنْهُم عَذابَ اللهِ."}],"26":[{"w":"لَا تَذَرۡ","m":"لا تَتْرُكْ."},{"w":"دَيَّارًا","m":"أَحَداً حَيّاً عَلَى الأرْضِ، يَدُورُ وَيَتَحَرَّكُ."}],"27":[{"w":"إِن تَذَرۡهُمۡ","m":"إن تَتْرُكْهُم دُونَ إِهْلاكٍ."},{"w":"إِلَّا فَاجِرٗا","m":"إلا مائِلاً عَنِ الحقِّ."},{"w":"كَفَّارٗا","m":"شَدِيدَ الكُفْرِ بِكَ والعِصْيانِ لَك."}],"28":[{"w":"تَبَارَۢا","m":"هَلَاكاً وَخُسْراناً في الدُّنيا والآخِرَةِ."}]}