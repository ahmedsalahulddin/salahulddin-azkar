{"1":[{"w":"وَٱلصَّٰٓفَّٰتِ","m":"هي الملائِكَةُ التي تَصْطَفُّ في عِبادَتِها."}],"2":[{"w":"فَٱلزَّٰجِرَٰتِ","m":"هي الملائكةُ التي تَزْجُرُ السَّحابَ وتَسُوقُه."}],"3":[{"w":"ذِكۡرًا","m":"هو القرآنُ."}],"6":[{"w":"ٱلۡكَوَاكِبِ","m":"النُّجُومِ."}],"7":[{"w":"مَارِدٖ","m":"مُتَمَرِّدٍ خارجٍ عَنِ الطَّاعةِ."}],"8":[{"w":"وَيُقۡذَفُونَ","m":"ويُرْجَمُونَ (بالشُّهُبِ)."}],"9":[{"w":"دُحُورٗا","m":"إبْعاداً وطَرْداً."},{"w":"وَاصِبٌ","m":"دائمٌ لا يَنْقَطِعُ."}],"10":[{"w":"خَطِفَ ٱلۡخَطۡفَةَ","m":"أي: اسْتَرَقَ السَّمْعَ خِلْسةً."},{"w":"فَأَتۡبَعَهُۥ","m":"تَبِعَه ولحِقَه."},{"w":"شِهَابٞ ثَاقِبٞ","m":"نَجْمٌ مُضِيءٌ."}],"11":[{"w":"لَازِبِۭ","m":"مُلْتَزِقٍ بَعْضُه ببَعْضٍ."}],"12":[{"w":"وَيَسۡخَرُونَ","m":"يَسْتَهْزِئُونَ بِكَ."}],"14":[{"w":"ءَايَةٗ","m":"مُعْجِزَةً مِن مُّعْجِزاتِكَ."},{"w":"يَسۡتَسۡخِرُونَ","m":"يبالِغُونَ في سُخْرِيَّتِهِم."}],"18":[{"w":"دَٰخِرُونَ","m":"أَذِلَّاءُ صاغِرُونَ."}],"19":[{"w":"زَجۡرَةٞ وَٰحِدَةٞ","m":"نَفْخَةٌ واحِدَةٌ."}],"20":[{"w":"يَٰوَيۡلَنَا","m":"يا هَلاكَنا."}],"21":[{"w":"يَوۡمُ ٱلۡفَصۡلِ","m":"يومُ القضاءِ بَيْنَ الخَلْقِ."}],"22":[{"w":"ٱحۡشُرُواْ","m":"اجْمَعُوا."},{"w":"وَأَزۡوَٰجَهُمۡ","m":"قُرَناءَهُم ونُظراءَهُم."}],"23":[{"w":"فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ","m":"دُلُّوهُم إلى طَرِيقِ النَّارِ، وسُوقُوهُم إليها."}],"24":[{"w":"وَقِفُوهُمۡ","m":"احْبِسُوهُم في مَوْقِفِ الحِسابِ."}],"26":[{"w":"مُسۡتَسۡلِمُونَ","m":"مُنْقادُونَ أذلَّاءُ لِعَجِزِهِم عَنِ الحِيلَةِ."}],"28":[{"w":"عَنِ ٱلۡيَمِينِ","m":"أي: عَنِ النَّاحيةِ الَّتي كان مِنْها الحقُّ، فَتَصْرِفُونَنا عَنْها."}],"30":[{"w":"طَٰغِينَ","m":"متجاوِزِينَ الحَدَّ في الكُفْرِ والضَّلالِ."}],"31":[{"w":"فَحَقَّ","m":"ثَبَتَ ووَجَبَ."}],"32":[{"w":"فَأَغۡوَيۡنَٰكُمۡ","m":"فأَضْلَلْناكُم."},{"w":"غَٰوِينَ","m":"ضَالِّينَ."}],"45":[{"w":"يُطَافُ","m":"يُدارُ."},{"w":"بِكَأۡسٖ","m":"بِكأسٍ مِنْ خمْرٍ."},{"w":"مَعِينِۭ","m":"نابِعٍ مِنَ العُيُونِ."}],"47":[{"w":"لَا فِيهَا غَوۡلٞ","m":"لا أذىً فيها ولا مَكْروهٌ على شاربيها."},{"w":"وَلَا هُمۡ عَنۡهَا يُنزَفُونَ","m":"ولا هم عَن شُرْبِهَا تَذْهَبُ عُقُولُهم، أي: لا تُنزَفُ عُقُولُهم كما يُنْزَفُ دَمُ الجَرِيحِ."}],"48":[{"w":"قَٰصِرَٰتُ ٱلطَّرۡفِ","m":"حُورٌ قَصَرْنَ نَظَرَهُنَّ على أزْواجِهِنَّ."},{"w":"عِينٞ","m":"جَمْعُ «عَيناءَ»: واسعةُ العَينِ حَسَنَتُها."}],"49":[{"w":"مَكۡنُونٞ","m":"مَصُونٌ لم يَمْسَسْهُ أَحَدٌ."}],"51":[{"w":"قَرِينٞ","m":"صاحِبٌ مُلَازِمٌ."}],"53":[{"w":"لَمَدِينُونَ","m":"لَمَجْزِيُّونَ ومُحاسَبُونَ."}],"55":[{"w":"سَوَآءِ ٱلۡجَحِيمِ","m":"وَسَطِها."}],"56":[{"w":"تَٱللَّهِ","m":"واللهِ."},{"w":"كِدتَّ","m":"قارَبْتَ."},{"w":"لَتُرۡدِينِ","m":"لَتُهْلِكُنِي."}],"57":[{"w":"ٱلۡمُحۡضَرِينَ","m":"أي: في العذابِ مِثلَك."}],"62":[{"w":"نُزُلًا","m":"ما يُهَيَّأُ للنَّزيلِ إكْراماً لهُ."},{"w":"شَجَرَةُ ٱلزَّقُّومِ","m":"الشَّجَرَةُ الخَبِيثَةُ الملعُونةُ ذاتُ الثَّمرِ المُرِّ الكرِيهِ الرَّائِحَةِ."}],"63":[{"w":"فِتۡنَةٗ لِّلظَّٰلِمِينَ","m":"مِحْنَةً لَهُم لِكَوْنِهِم يُعَذَّبُونَ بِها في الآخِرةِ."}],"64":[{"w":"تَخۡرُجُ","m":"تَنْبُتُ."},{"w":"أَصۡلِ ٱلۡجَحِيمِ","m":"قَعْرِ جَهَنَّمَ."}],"65":[{"w":"طَلۡعُهَا","m":"ثَمَرُها."},{"w":"كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","m":"تشبيهٌ للمَحْسُوسِ بالمتَخَيَّلِ؛ لِتناهِيهِ في البَشاعَةِ والقُبْحِ."}],"67":[{"w":"لَشَوۡبٗا","m":"لخَلْطاً ومِزاجاً."},{"w":"مِنۡ حَمِيمٖ","m":"الماءِ الحارِّ الشَّديدِ الحرارةِ."}],"68":[{"w":"مَرۡجِعَهُمۡ","m":"مَرَدَّهُم."},{"w":"ٱلۡجَحِيمِ","m":"جَهَنَّمَ."}],"69":[{"w":"أَلۡفَوۡاْ","m":"وَجَدُوا."}],"70":[{"w":"يُهۡرَعُونَ","m":"يُسْرِعُونَ إلى متابعةِ آبائِهِم الضَّالِّينَ."}],"72":[{"w":"مُنذِرِينَ","m":"مُرسَلِينَ."}],"76":[{"w":"ٱلۡكَرۡبِ ٱلۡعَظِيمِ","m":"الغَرَقِ بالطُّوفانِ العظيمِ."}],"78":[{"w":"ٱلۡأٓخِرِينَ","m":"الَّذينَ جاؤُوا بَعْدَه."}],"82":[{"w":"ٱلۡأٓخَرِينَ","m":"الباقِينَ الَّذين كذَّبُوا نوحاً عليه الصَّلاةُ والسَّلامُ."}],"83":[{"w":"شِيعَتِهِۦ","m":"أي: جَماعَتِهِ الَّذينَ هُمُ الأنبِياءُ والمرْسَلُونَ، عليهم الصَّلاةُ والسَّلامُ."}],"86":[{"w":"أَئِفۡكًا","m":"أَكَذِباً وباطِلاً."}],"88":[{"w":"فَنَظَرَ","m":"تَأَمَّلَ."}],"89":[{"w":"سَقِيمٞ","m":"مَرِيضٌ."}],"90":[{"w":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ","m":"فانصَرَفُوا عنه مُعْرِضِين."}],"91":[{"w":"فَرَاغَ إِلَىٰٓ","m":"ذَهَبَ خُفْيَةً."}],"93":[{"w":"فَرَاغَ عَلَيۡهِمۡ","m":"مَالَ وأَقْبَل عَلَيهِم."},{"w":"بِٱلۡيَمِينِ","m":"أي: بيَدِه اليُمْنَى."}],"94":[{"w":"يَزِفُّونَ","m":"يُسْرِعُونَ في مَشْيِهِم."}],"95":[{"w":"تَنۡحِتُونَ","m":"تَبْرُونَ وتَقْشِرُونَ بِأَيْدِيكُم."}],"97":[{"w":"ٱلۡجَحِيمِ","m":"النَّارِ الشَّديدةِ الاتِّقادِ."}],"98":[{"w":"ٱلۡأَسۡفَلِينَ","m":"المقْهُورِينَ المغْلُوبِينَ."}],"101":[{"w":"حَلِيمٖ","m":"أي: عِنْدَما يَكْبَرُ."}],"103":[{"w":"أَسۡلَمَا","m":"اسْتَسْلَما لأمْرِ اللهِ وانْقَادا لَه."},{"w":"وَتَلَّهُۥ لِلۡجَبِينِ","m":"أي: أَضْجَعَه على جَبينِه على الأرضِ."}],"106":[{"w":"ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ","m":"الاخْتِبارُ الواضِحُ."}],"107":[{"w":"بِذِبۡحٍ عَظِيمٖ","m":"بكَبْشٍ مَذْبُوحٍ عَظِيمِ القَدْرِ."}],"108":[{"w":"عَلَيۡهِ","m":"أي: على ذِكْرِه الحَسَنِ."},{"w":"فِي ٱلۡأٓخِرِينَ","m":"في الأُمَمِ التي جاءتْ بَعْدَه."}],"115":[{"w":"مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","m":"أي: مِنَ الغَرَقِ وتَسَلُّطِ فِرْعَونَ."}],"119":[{"w":"عَلَيۡهِمَا","m":"أي: على ذِكْرِهِما الحَسَنِ."},{"w":"فِي ٱلۡأٓخِرِينَ","m":"في الأمَمِ الَّتي جاءَتْ بَعْدَهُما."}],"125":[{"w":"بَعۡلٗا","m":"وهو اسْمٌ لِصَنَمٍ كانُوا يَعْبُدُونَهُ."},{"w":"وَتَذَرُونَ","m":"تَتْرُكُونَ."}],"127":[{"w":"لَمُحۡضَرُونَ","m":"أي: لِلْحِسَابِ والعِقابِ."}],"129":[{"w":"عَلَيۡهِ","m":"أي: على ذِكْرِه الحَسَنِ."},{"w":"فِي ٱلۡأٓخِرِينَ","m":"في الأُمَمِ الَّتي جاءَتْ بَعْدَهُ."}],"135":[{"w":"فِي ٱلۡغَٰبِرِينَ","m":"الباقِينَ في العذابِ."}],"136":[{"w":"دَمَّرۡنَا","m":"أَهْلَكْنا."},{"w":"ٱلۡأٓخَرِينَ","m":"الباقِينَ مِن قَومِ لُوطٍ عَلَيهِ السَّلامُ الَّذينَ لم يُؤْمِنُوا بِهِ."}],"137":[{"w":"مُصۡبِحِينَ","m":"داخِلِينَ وَقْتَ الصَّباحِ."}],"140":[{"w":"أَبَقَ","m":"هَرَبَ."},{"w":"ٱلۡمَشۡحُونِ","m":"المَمْلُوءِ."}],"141":[{"w":"فَسَاهَمَ","m":"اقْتَرَعَ وقَبِلَ القُرْعَةَ."},{"w":"ٱلۡمُدۡحَضِينَ","m":"المَغْلُوبِينَ بالقُرْعَةِ."}],"142":[{"w":"فَٱلۡتَقَمَهُ","m":"فَابْتَلَعَه."},{"w":"مُلِيمٞ","m":"آتٍ بما يُلامُ عَلَيهِ."}],"143":[{"w":"ٱلۡمُسَبِّحِينَ","m":"بِذِكْرِ اللهِ وكَثْرةِ العِبادةِ."}],"144":[{"w":"لَلَبِثَ","m":"لمَكَثَ."}],"145":[{"w":"فَنَبَذۡنَٰهُ","m":"طَرَحْناه."},{"w":"بِٱلۡعَرَآءِ","m":"بِأرْضٍ خاليةٍ عاريةٍ من الشَّجرِ والبناءِ."},{"w":"سَقِيمٞ","m":"ضَعِيفُ البَدَنِ بسَبِبِ حَبْسِهِ في بَطْنِ الحُوتِ."}],"146":[{"w":"يَقۡطِينٖ","m":"القَرْعِ."}],"151":[{"w":"إِفۡكِهِمۡ","m":"من كَذِبِهِم وافْتِرَائِهِم."}],"153":[{"w":"أَصۡطَفَى","m":"هل اخْتارَ؟"}],"156":[{"w":"سُلۡطَٰنٞ مُّبِينٞ","m":"حُجَّةٌ واضِحةٌ."}],"158":[{"w":"وَبَيۡنَ ٱلۡجِنَّةِ","m":"بَيْنَ الملائِكَةِ."},{"w":"لَمُحۡضَرُونَ","m":"أي: لِلْعَذابِ."}],"162":[{"w":"بِفَٰتِنِينَ","m":"بمُضِلِّينَ ومُفْسِدِينَ أَحَداً."}],"163":[{"w":"صَالِ ٱلۡجَحِيمِ","m":"يَدْخُلُ النارَ، ويُقاسي حَرَّها."}],"165":[{"w":"ٱلصَّآفُّونَ","m":"الواقِفُونَ صُفُوفاً."}],"166":[{"w":"ٱلۡمُسَبِّحُونَ","m":"المُنَزِّهُونَ للهِ والمُقَدِّسُونَ له عَن كُلِّ ما لا يَلِيقُ بِه."}],"168":[{"w":"ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ","m":"أي: كِتاباً مِن كُتُبِ الأوَّلِينَ كالتَّوراةِ والإنْجِيلِ."}],"170":[{"w":"فَكَفَرُواْ بِهِۦ","m":"أي: فَجَاءَهُم الرَّسُولُ ﷺ بالقرآنِ فَكَفَرُوا بِهِ."}],"177":[{"w":"بِسَاحَتِهِمۡ","m":"بِفِنائِهِم، والمرادُ: القَومُ."}]}