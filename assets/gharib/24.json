{"1":[{"w":"وَفَرَضۡنَٰهَا","m":"أوْجَبْنا أَحْكامَ هذه السُّورةِ عَلَيكُم."},{"w":"ءَايَٰتِۭ بَيِّنَٰتٖ","m":"دَلالاتٍ واضِحَاتٍ."}],"2":[{"w":"فَٱجۡلِدُواْ","m":"فاضربُوا بالسَّوطِ."},{"w":"رَأۡفَةٞ","m":"رَحْمَةٌ ورِقَّةٌ."},{"w":"وَلۡيَشۡهَدۡ","m":"وَلْيَحْضُرْ."}],"3":[{"w":"وَحُرِّمَ ذَٰلِكَ","m":"أي: نكاحُ الزِّانِيةِ حتى تَتَوْبَ، أوْ حُرِّم الزِّنى نَفْسُه."}],"4":[{"w":"يَرۡمُونَ","m":"يَقْذِفُونَ بالزِّنى."},{"w":"ٱلۡمُحۡصَنَٰتِ","m":"النِّساءَ الحرائِرَ العَفِيفاتِ، وكذلك الرِّجالُ."},{"w":"ٱلۡفَٰسِقُونَ","m":"الخارِجُونَ عَن طاعَةِ اللهِ."}],"6":[{"w":"يَرۡمُونَ أَزۡوَٰجَهُمۡ","m":"يَقْذِفُونَ زَوْجاتِهم بالزِّنى."},{"w":"لَمِنَ ٱلصَّٰدِقِينَ","m":"أي: في قَذْفِه زَوْجَتَه بالزِّنى."}],"7":[{"w":"وَٱلۡخَٰمِسَةُ","m":"أي: الشَّهادَةُ الخامِسَةُ."},{"w":"مِنَ ٱلۡكَٰذِبِينَ","m":"أي: في قَذْفِه زَوْجتَه بالزِّنى."}],"8":[{"w":"وَيَدۡرَؤُاْ عَنۡهَا","m":"ويَدْفَعُ عَنِ الزَّوجَةِ المَقْذُوفَةِ."}],"10":[{"w":"تَوَّابٌ","m":"كثِيرُ القَبُولِ لِتَوْبَةِ مَنْ تابَ إليهِ مِنْ عِبادِهِ."},{"w":"حَكِيمٌ","m":"أي: في شَرَائِعِه وأَحْكَامِه، فلم يُنْزِلْ بالكاذِبِ مِن المتَلاعِنَينِ ما دَعا به على نَفْسِه."}],"11":[{"w":"بِٱلۡإِفۡكِ","m":"أَقْبحِ الكَذِبِ وأفْحَشِه، وهو اتِّهامُ أمِّ المؤمنينَ عائِشَةَ رضي اللهُ عَنَها بالفاحِشةِ."},{"w":"عُصۡبَةٞ مِّنكُمۡ","m":"جَماعةٌ مُنْتَسِبُونَ إليكُم."},{"w":"مَا ٱكۡتَسَبَ","m":"جَزاءُ ما ارْتَكَبَ."},{"w":"تَوَلَّىٰ كِبۡرَهُۥ","m":"تَحَمَّلَ مُعْظَمَ الإِفْكِ، وهو عبدُ اللهِ بنُ أُبيِّ بنِ سَلُولٍ كبيرُ المنافِقِيِنَ."}],"12":[{"w":"لَوۡلَآ","m":"هَلَّا."},{"w":"إِفۡكٞ مُّبِينٞ","m":"بُهْتانٌ واضِحٌ."}],"14":[{"w":"لَمَسَّكُمۡ","m":"لَأصَابَكُم."},{"w":"فِي مَآ أَفَضۡتُمۡ فِيهِ","m":"بِسَبَبِ ماخُضْتُم فيه مِنْ حَدِيثِ الإِفْكِ."}],"15":[{"w":"إِذۡ تَلَقَّوۡنَهُۥ","m":"حِينَ تَتَلَقَّفُونَ حَدِيثَ الإِفْكِ وتَتَناقَلُونَه."},{"w":"وَتَحۡسَبُونَهُۥ هَيِّنٗا","m":"وتَظُنُّونَ تَلَقِّيَ الإِفْكِ شَيئاً سَهْلاً لا يَلْحَقُكُم فيه إثْمٌ."}],"16":[{"w":"مَا يَكُونُ لَنَآ","m":"ما يَحِلُّ لَنا ولا يَنْبَغِي."},{"w":"سُبۡحَٰنَكَ","m":"تَنْزِيهاً لكَ يا رَبِّ."},{"w":"بُهۡتَٰنٌ","m":"افْتِرَاءٌ وكَذِبٌ."}],"18":[{"w":"ٱلۡأٓيَٰتِ","m":"آياتِ القرآنِ المشْتَمِلَةَ على الأحْكَامِ والمَوَاعِظِ."}],"19":[{"w":"تَشِيعَ","m":"تَنْتَشِرَ."},{"w":"ٱلۡفَٰحِشَةُ","m":"الزِّنى وكلُّ قولٍ سيِّئٍ."}],"20":[{"w":"وَلَوۡلَا فَضۡلُ ٱللَّهِ","m":"أي: لولا فَضْلُ اللهِ لَعَاجَلَ مَنْ خَالَفَ أمْرَه بالعُقُوبَةِ."},{"w":"رَءُوفٞ","m":"كَثِيرُ الرَّأْفَةِ والمَحَبَّةِ لِعِبَادِه."},{"w":"رَحِيمٞ","m":"بِعِبادِه فَيَتَقَدَّمُ إِلَيِهم بِمِثْلِ هذا الإِعْذَارِ والإِنْذَارِ."}],"21":[{"w":"خُطُوَٰتِ ٱلشَّيۡطَٰنِ","m":"طُرُقَه وآثارَه."},{"w":"بِٱلۡفَحۡشَآءِ","m":"ما عَظُمَ قُبْحُه مِنَ الذُّنوب."},{"w":"وَٱلۡمُنكَرِ","m":"ما يُنْكِرُه الشَّرعُ أو يَكرَهُه."},{"w":"مَا زَكَىٰ","m":"ما طَهُرَ، ولا تَطَهَّرَ مِن دَنَسِ الذُّنُوبِ"},{"w":"يُزَكِّي","m":"يُطَهِّرُ."}],"22":[{"w":"وَلَا يَأۡتَلِ","m":"وَلَا يَحْلِفْ."},{"w":"أُوْلُواْ ٱلۡفَضۡلِ","m":"أصْحابُ الفَضَلِ في الدِّينِ."},{"w":"وَٱلسَّعَةِ","m":"الغِنى في المالِ."},{"w":"أَن يُؤۡتُوٓاْ","m":"أي: يَحْلِفُونَ على أَلَّا يُعْطُوا."},{"w":"أُوْلِي ٱلۡقُرۡبَىٰ","m":"أَصْحابَ القَرَابَةِ."},{"w":"وَلۡيَعۡفُواْ","m":"أي: ولْيَتَجاوزُوا عَن ذَنْبِهِم وإساءَتِهِم."},{"w":"وَلۡيَصۡفَحُوٓاْ","m":"أي: بالإعْرَاضِ عَن مُّؤاخَذَتِهِم."}],"23":[{"w":"يَرۡمُونَ","m":"يَقْذِفُون بالزِّنى."},{"w":"ٱلۡمُحۡصَنَٰتِ","m":"العفِيفاتِ."},{"w":"ٱلۡغَٰفِلَٰتِ","m":"اللَّاتي لا تَخْطُرُ بِبالِهنَّ الفاحِشَةُ."}],"25":[{"w":"دِينَهُمُ ٱلۡحَقَّ","m":"جَزَاءَهم الثَّابِتَ لهم بالعَدْلِ."}],"26":[{"w":"مِمَّا يَقُولُونَ","m":"أي: مِنِ اتِّهامِهِم."}],"27":[{"w":"حَتَّىٰ تَسۡتَأۡنِسُواْ","m":"حتى تَسْتأذِنُوا."}],"28":[{"w":"هُوَ أَزۡكَىٰ لَكُمۡ","m":"الرُّجُوعُ أْطَهرُ لكُم."}],"29":[{"w":"جُنَاحٌ","m":"حَرَجٌ."},{"w":"غَيۡرَ مَسۡكُونَةٖ","m":"ليسَتْ مُخَصَّصَةً لِسَكَنِ أُنَاسٍ مُعَيَّنِينَ كَالفَنادِقِ والمسَاجِدِ."},{"w":"مَتَٰعٞ لَّكُمۡ","m":"مَنْفَعَةٌ ومَصْلَحَةٌ لكُم."}],"30":[{"w":"يَغُضُّواْ مِنۡ أَبۡصَٰرِهِمۡ","m":"يَخْفِضُوا نَظَرَهُم إلى المُحَرَّماتِ."},{"w":"أَزۡكَىٰ","m":"أَطَهرُ."}],"31":[{"w":"وَلَا يُبۡدِينَ","m":"ولا يُظْهِرْنَ."},{"w":"زِينَتَهُنَّ","m":"مواضِعَ زينَتِهنَّ مِنَ الجَسَدِ."},{"w":"إِلَّا مَا ظَهَرَ مِنۡهَا","m":"مِنَ الثِّيابِ الظَّاهِرَةِ التي جَرَتِ العَادَةُ بِلُبسِها."},{"w":"عَلَىٰ جُيُوبِهِنَّ","m":"أي: على فَتَحات ثِيابِهِنَّ مِن جِهَةِ صُدُورِهِنَّ."},{"w":"لِبُعُولَتِهِنَّ","m":"لأزْوَاجِهِنَّ."},{"w":"أَوۡ نِسَآئِهِنَّ","m":"مِنَ المسْلِماتِ المخْتَصَّاتِ بهِنَّ بالصُّحْبَةِ أو الخِدْمَةِ."},{"w":"أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُنَّ","m":"أي: مِنَ العَبِيدِ والإِماءِ."},{"w":"غَيۡرِ أُوْلِي ٱلۡإِرۡبَةِ","m":"الَّذينَ لا حاجةَ لهم في النِّساءِ."},{"w":"أَوِ ٱلطِّفۡلِ","m":"أي: الأطْفالِ."},{"w":"لَمۡ يَظۡهَرُواْ","m":"لم يَطَّلِعُوا ولم يَبْلُغُوا حَدَّ الشَّهْوةِ."}],"32":[{"w":"ٱلۡأَيَٰمَىٰ","m":"الَّذينَ لا أزْوَاجَ لَهُم مِنَ الأحْرارِ والحرائِر."}],"33":[{"w":"وَلۡيَسۡتَعۡفِفِ","m":"وَلْيطْلُب العِفَّةَ عَنِ الزِّنى والحَرَامِ."},{"w":"لَا يَجِدُونَ نِكَاحًا","m":"أي: لا يَجِدُونَ قُدْرَةً مالِيَّةً على النِّكاحِ."},{"w":"ٱلۡكِتَٰبَ","m":"أي: المُكاتَبَةَ، وهي أن يكَاتِبَ الرَّجلُ عبدَه على مالٍ يُؤَدِّيهِ مُنَجَّماً، فإذا أدّاه فهو حُرٌّ."},{"w":"مِمَّا مَلَكَتۡ أَيۡمَٰنُكُمۡ","m":"مِنْ عَبيدِكُم وإمائِكُم."},{"w":"فَكَاتِبُوهُمۡ","m":"أي: فَاكْتُبُوا مَعَهُم عَقْدَ مُكَاتَبَةٍ."},{"w":"فَتَيَٰتِكُمۡ","m":"إِماءَكُم وَجَوَارِيَكُم."},{"w":"ٱلۡبِغَآءِ","m":"الزِّنى."},{"w":"تَحَصُّنٗا","m":"تَعَفُّفاً."},{"w":"غَفُورٞ رَّحِيمٞ","m":"أي: لمن أُكرِهَتْ على الزِّنى، وبَقِيَ الإثْمُ على مَنْ أَكْرَهَها."}],"34":[{"w":"ءَايَٰتٖ مُّبَيِّنَٰتٖ","m":"آياتِ القرآنِ المفصَّلاتِ."},{"w":"خَلَوۡاْ","m":"مَضَوا."}],"35":[{"w":"كَمِشۡكَوٰةٖ","m":"الِمشْكاةُ: الكَوَّة في الحائِطِ غيرُ النَّافِذَةِ."},{"w":"مِصۡبَاحٌ","m":"سِرَاجٌ."},{"w":"زُجَاجَةٍ","m":"قِنْدِيلٍ مِنَ الزُّجاجِ صافٍ أزْهَرَ."},{"w":"كَوۡكَبٞ دُرِّيّٞ","m":"نَجْمٌ مُضِيءٌ كالدُّرِّ في صَفائِه وإشْرَاقِه."},{"w":"لَا شَرۡقِيَّةٖ وَلَا غَرۡبِيَّةٖ","m":"أي: بَلْ هِيَ في موقِعٍ مُتَوَسِّطٍ بينَ الشَّرقِ والغَرْبِ، فَتَتَعَرَّضُ للشَّمسِ طوالَ النَّهارِ."}],"36":[{"w":"بُيُوتٍ","m":"مَسَاجِدَ."},{"w":"أَذِنَ","m":"أمَرَ وقَضَى."},{"w":"تُرۡفَعَ","m":"تُبْنىَ وتُعَظَّمَ."},{"w":"بِٱلۡغُدُوِّ وَٱلۡأٓصَالِ","m":"أَوَّلِ النَّهار وآخِرِه."}],"37":[{"w":"لَا تُلۡهِيهِمۡ","m":"لا تشْغَلُهُم."},{"w":"تَتَقَلَّبُ","m":"تَضْطَربُ وتَتَحَوَّلُ."}],"39":[{"w":"كَسَرَابِۭ","m":"السَّرابُ: ما يُرى ظُهراً في المفاوِزِ من لَمَعَانِ الشَّمْسِ عِنْدَ اشْتِدادِ الحرِّ، يَظُنُّه العَطْشانُ ماءً."},{"w":"بِقِيعَةٖ","m":"جَمْعِ «قاعٍ» وهو المستَوي مِنَ الأرضِ."}],"40":[{"w":"لُجِّيّٖ","m":"عَمِيقٍ كَثِيرِ الماءِ."},{"w":"يَغۡشَىٰهُ","m":"يَعْلُو ويُغَطِّي."},{"w":"يَدَهُۥ لَمۡ يَكَدۡ يَرَىٰهَا","m":"لم يُقَارِبْ رُؤيتَها مِن شِدَّةِ الظُّلُماتِ."}],"41":[{"w":"صَٰٓفَّٰتٖ","m":"باسِطاتٍ أجْنِحَتَها في الهَوَاءِ."},{"w":"صَلَاتَهُۥ","m":"أي: المُصَلِّي مِنْهُم عَلِم صَلاتَه."},{"w":"وَتَسۡبِيحَهُۥ","m":"أي: المُسَبِّحُ مِنْهم عَلِمَ تَسْبِيحَهُ."}],"42":[{"w":"ٱلۡمَصِيرُ","m":"المَرْجِعُ بعد الموتِ."}],"43":[{"w":"يُزۡجِي","m":"يَسُوقُ بِرِفْقٍ."},{"w":"يُؤَلِّفُ","m":"يَجْمَعُ."},{"w":"رُكَامٗا","m":"مُجْتَمِعاً وَمُتَرَاكِماً بَعْضُهَ فَوْقَ بَعْضٍ."},{"w":"ٱلۡوَدۡقَ","m":"المَطَرَ."},{"w":"مِنۡ خِلَٰلِهِۦ","m":"مِن مَّخارِجِ السَّحابِ."},{"w":"مِن جِبَالٖ","m":"أي: مِثلِ جبَالٍ في عَظَمَتِه."},{"w":"سَنَا بَرۡقِهِۦ","m":"ضَوءُ بَرْقِه ولمَعَانُه."}],"44":[{"w":"لِأُوْلِي ٱلۡأَبۡصَٰرِ","m":"لأصْحَابِ العُقُولِ السَّلِيمةِ."}],"45":[{"w":"عَلَىٰ بَطۡنِهِۦ","m":"كالحيَّاتِ ونحوِها."},{"w":"عَلَىٰ رِجۡلَيۡنِ","m":"كالإِنْسَانِ."},{"w":"عَلَىٰٓ أَرۡبَعٖ","m":"كالبهَائِمِ ونحوِها."}],"47":[{"w":"يَتَوَلَّىٰ","m":"يُعرِضُ."}],"49":[{"w":"لَهُمُ ٱلۡحَقُّ","m":"أي: في قَضاءِ النَّبيِّ ﷺ وحُكْمِهِ."},{"w":"مُذۡعِنِينَ","m":"مُسْرِعِينَ مُنْقَادِينَ."}],"50":[{"w":"مَرَضٌ","m":"أي: مِنَ النِّفاقِ."},{"w":"ٱرۡتَابُوٓاْ","m":"شَكُّوا."},{"w":"أَن يَحِيفَ","m":"أن يَجُورَ."}],"53":[{"w":"جَهۡدَ أَيۡمَٰنِهِمۡ","m":"أي: بأَيمانٍ مُغَلَّظَةٍ."},{"w":"لَيَخۡرُجُنَّ","m":"أي: لِلْجِهَادِ."}],"54":[{"w":"فَإِن تَوَلَّوۡاْ","m":"فَإِن تُعْرِضُوا."},{"w":"مَا حُمِّلَ","m":"ما أُمِرَ به مِن تَبْلِيغِ الرِّسَالَةِ."},{"w":"مَا حُمِّلۡتُمۡ","m":"ما أُمِرْتُم بِه مِنَ الطَّاعةِ والانْقِيادِ."},{"w":"ٱلۡبَلَٰغُ ٱلۡمُبِينُ","m":"التَّبْلِيغُ الواضِحُ."}],"55":[{"w":"لَيَسۡتَخۡلِفَنَّهُمۡ","m":"أي: لَيَجْعَلَنَّهم خُلَفاءَ."},{"w":"وَلَيُمَكِّنَنَّ لَهُمۡ","m":"وَلَيُثَبِّتَنَّ لَهُم."},{"w":"دِينَهُمُ","m":"وهو دينُ الإسلامِ."},{"w":"ٱلۡفَٰسِقُونَ","m":"الخارِجُونَ عَن طَاعَةِ اللهِ."}],"57":[{"w":"مُعۡجِزِينَ","m":"فائتِينَ مِنْ عَذابِ اللهِ."},{"w":"وَمَأۡوَىٰهُمُ","m":"ومَرْجِعُهُم."},{"w":"وَلَبِئۡسَ","m":"وقَبُحَ."},{"w":"ٱلۡمَصِيرُ","m":"المرجِعُ."}],"58":[{"w":"ٱلَّذِينَ مَلَكَتۡ أَيۡمَٰنُكُمۡ","m":"هُمُ العبيدُ والإِماءُ."},{"w":"ٱلۡحُلُمَ","m":"أي: سِنَّ الاحْتِلامِ."},{"w":"ثَلَٰثُ عَوۡرَٰتٖ لَّكُمۡ","m":"أي: ثلاثةُ أوقاتٍ يَخْتَلُّ فيها السِّتْرُ ويَقِلُّ."},{"w":"جُنَاحُۢ","m":"حَرَجٌ."},{"w":"طَوَّٰفُونَ","m":"أي: كَثِيرُو التَّطْوَافِ والتَّردُّدِ عَلَيكُم لِلْخِدْمَةِ وقَضَاءِ المصالِحِ."},{"w":"يُبَيِّنُ","m":"يُوضِّحُ."},{"w":"ٱلۡأٓيَٰتِ","m":"أي: آياتِ القُرآنِ الدَّالَّةَ على الأحْكامِ."}],"59":[{"w":"ٱلۡحُلُمَ","m":"سِنَّ الاحْتِلامِ والبُلُوغِ."}],"60":[{"w":"وَٱلۡقَوَٰعِدُ مِنَ ٱلنِّسَآءِ","m":"العَجَائِزُ اللَّاتي قَعَدْنَ عَنِ الحَيضِ والاسْتِمْتاعِ لِكِبَرِهِنَّ."},{"w":"لَا يَرۡجُونَ نِكَاحٗا","m":"لا يَطْمَعْنَ فيه."},{"w":"مُتَبَرِّجَٰتِۭ","m":"مُظْهِرَاتٍ."},{"w":"وَأَن يَسۡتَعۡفِفۡنَ","m":"وأن يَتْرُكْنَ وَضْعَ الثِّيابِ لِطَلَبِ العِفَّةِ."}],"61":[{"w":"حَرَجٞ","m":"إِثْمٌ."},{"w":"أَوۡ مَا مَلَكۡتُم مَّفَاتِحَهُۥٓ","m":"أي: البُيوتِ الَّتي تَمْلِكُونَ التَّصرُّفَ فِيها بإذِنِ أَرْبابِها."},{"w":"أَشۡتَاتٗا","m":"مُتَفَرِّقِينَ."},{"w":"ٱلۡأٓيَٰتِ","m":"أي: آياتِ القرآنِ الدَّالَّةَ على الأحْكامِ."}],"62":[{"w":"أَمۡرٖ جَامِعٖ","m":"أمرٍ مُهِمٍّ يَجِبُ اجْتِماعُهُم لَهُ."},{"w":"لِبَعۡضِ شَأۡنِهِمۡ","m":"أي: لِبَعْضِ أُمُورِهِم."}],"63":[{"w":"دُعَآءَ ٱلرَّسُولِ","m":"دَعْوتَهُ لَكُم لِلاجْتِماعِ، أو نِدَاءَكُم لَهُ ﷺ."},{"w":"يَتَسَلَّلُونَ","m":"يَخْرُجُونَ خِفْيةً مِنْ غَيرِ إِذْنٍ."},{"w":"لِوَاذٗا","m":"أي: مُسْتَترِينَ بعضُهم بِبَعْضٍ عنْدَ الخُروجِ."},{"w":"فِتۡنَةٌ","m":"بَلَاءٌ ومِحْنَةٌ في الدُّنْيا."}]}