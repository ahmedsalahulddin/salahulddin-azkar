{"1":[{"w":"أَفۡلَحَ","m":"فازَ بِالنَّجَاةِ مِنَ النَّارِ."}],"2":[{"w":"خَٰشِعُونَ","m":"خاضِعُونَ بِقُلوبِهِم وجَوَارِحِهِم."}],"3":[{"w":"عَنِ ٱللَّغۡوِ مُعۡرِضُونَ","m":"أي: تارِكُونَ لِكُلِّ ما لا خَيرَ فِيه مِنَ العَبَثِ."}],"5":[{"w":"حَٰفِظُونَ","m":"أي: ممَّا حَرَّم الله مِنَ الزِّنى وسائرِ الفواحِشِ."}],"7":[{"w":"ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ","m":"طَلَبَ التَّمَتُّعَ بِغَيرِ ما أَحَلَّه اللهُ."},{"w":"ٱلۡعَادُونَ","m":"المُجاوِزُونَ حُدَودَ اللهِ."}],"8":[{"w":"رَٰعُونَ","m":"حافِظُونَ."}],"11":[{"w":"ٱلۡفِرۡدَوۡسَ","m":"أعْلَى مَنازِلِ الجنَّةِ وَأَوسَطَها، وهو أَفْضَلُها."}],"12":[{"w":"ٱلۡإِنسَٰنَ","m":"آدَمَ."},{"w":"مِن سُلَٰلَةٖ مِّن طِينٖ","m":"أي: مِن طِينٍ مأخُوذٍ مِنْ جَمِيعِ الأرضِ."}],"13":[{"w":"نُطۡفَةٗ","m":"هي مَنِيُّ الرَّجُلِ يَقْذِفُه في رَحِمِ امْرَأَتِه."},{"w":"قَرَارٖ مَّكِينٖ","m":"مُسْتَقَرٍّ تَثْبتُ فِيه النُّطْفَةُ، وهو رَحِمُ المرْأَةِ."}],"14":[{"w":"عَلَقَةٗ","m":"دَماً أحْمرَ غَلِيظاً."},{"w":"مُضۡغَةٗ","m":"قِطْعَةَ لَحْمٍ قَدْرَ ما يُمْضَغُ."},{"w":"فَكَسَوۡنَا ٱلۡعِظَٰمَ لَحۡمٗا","m":"أي: أنْبَتْنا على كُلِّ عَظْمٍ لَحْماً مُناسِباً."},{"w":"خَلۡقًا ءَاخَرَ","m":"مُبايناً لِلْأَوَّلِ، وذلِكَ بِنَفْخِ الرُّوحِ فيه بَعْدَ أنْ كانَ جماداً."}],"16":[{"w":"تُبۡعَثُونَ","m":"تُحْيَوْن مِن قُبُورِكُم؛ لِلْحِسابِ."}],"17":[{"w":"سَبۡعَ طَرَآئِقَ","m":"سَبْعَ سَمَواتٍ جُعِلَ بعضُها فَوْقَ بَعْضٍ."}],"18":[{"w":"بِقَدَرٖ","m":"أي: بِمِقْدَارِ الحاجَةِ."},{"w":"فَأَسۡكَنَّٰهُ فِي ٱلۡأَرۡضِ","m":"أي: جَعَلْنَاه مُسْتَقِرّاً فِيها."},{"w":"عَلَىٰ ذَهَابِۭ بِهِۦ","m":"أي: على إذْهابِ هذا الماءِ."}],"19":[{"w":"جَنَّٰتٖ","m":"بساتِينَ."}],"20":[{"w":"وَشَجَرَةٗ","m":"هي شَجَرَةُ الزَّيتُونِ."},{"w":"طُورِ","m":"هو جَبَلٌ بـ «سَيْنَاءَ»."},{"w":"بِٱلدُّهۡنِ","m":"أي: مُلْتَبِساً ثَمَرُها بالزَّيتِ."},{"w":"وَصِبۡغٖ","m":"إدامٍ يُغْمَسُ فيه الخُبْزُ."}],"21":[{"w":"لَعِبۡرَةٗ","m":"لَعِظَةً وآيةً على القُدْرَةِ والرَّحْمَةِ."}],"22":[{"w":"وَعَلَيۡهَا","m":"أي: وعلى الإبِلِ من الأنعامِ."},{"w":"ٱلۡفُلۡكِ","m":"السُّفُنِ."}],"24":[{"w":"ٱلۡمَلَؤُاْ","m":"أشرافُ القومِ وسادَتُهم."},{"w":"أَن يَتَفَضَّلَ","m":"أن يتَرَأَّسَ ويَشْرُفَ عليكم."}],"25":[{"w":"جِنَّةٞ","m":"أي: جُنُونٌ، أو مَسٌّ من الجِنِّ."},{"w":"فَتَرَبَّصُواْ","m":"فانْتَظِرُوا."},{"w":"حِينٖ","m":"أي: وقتٍ مَّا."}],"27":[{"w":"بِأَعۡيُنِنَا","m":"بِمَرْأىً مِنَّا."},{"w":"أَمۡرُنَا","m":"أي: بِعَذابِهم بالطُّوفانِ."},{"w":"وَفَارَ","m":"نَبَعَ الماءُ وخَرَجَ بِقُوَّةٍ."},{"w":"ٱلتَّنُّورُ","m":"هو المكانُ الذي يُخْبزُ فِيه."},{"w":"فَٱسۡلُكۡ","m":"أَدْخِلْ."},{"w":"مِن كُلّٖ","m":"أي: من كُلِّ الأَحْيَاءِ."},{"w":"زَوۡجَيۡنِ","m":"ذَكَراً وأنْثَى."},{"w":"سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ","m":"أي: سَبَق القضاءُ بِهلَاكِه؛ لِكُفْرِه كزَوْجَتِكَ وابْنِكَ."}],"28":[{"w":"ٱسۡتَوَيۡتَ","m":"اعْتَدَلَتْ، أي: بَعْدَ رُكُوبِكَ في السَّفِينةِ."},{"w":"ٱلۡفُلۡكِ","m":"السَّفِينةِ."}],"29":[{"w":"مُنزَلٗا","m":"إنْزِالاً أومَكَانَ إِنْزالٍ."}],"30":[{"w":"لَأٓيَٰتٖ","m":"عِبَراً وحُجَجاً يُسْتَدَلُّ بها على سُنَنِ اللهِ في أَمْثالِ هؤلاءِ مِنَ الكَفَرةِ والمُشْرِكِينَ."},{"w":"وَإِن كُنَّا","m":"وإننا كُنَّا."},{"w":"لَمُبۡتَلِينَ","m":"لمُخْتَبِرِينَ الناسَ بهذه الآياتِ."}],"31":[{"w":"ثُمَّ أَنشَأۡنَا","m":"أَحْدَثْنا وخَلَقْنا."},{"w":"قَرۡنًا ءَاخَرِينَ","m":"جِيلاً آخَرَ: هم قَومُ عادٍ أو قومُ ثمُودَ."}],"32":[{"w":"رَسُولٗا مِّنۡهُمۡ","m":"هو هودٌ أو صالحٌ عليهما الصَّلاةُ والسَّلامُ."}],"33":[{"w":"ٱلۡمَلَأُ","m":"أَشْرافُ القوْمِ وَسادَتُهم."},{"w":"بِلِقَآءِ ٱلۡأٓخِرَةِ","m":"أي: بِلقاءِ اللهِ يومَ القِيامةِ."},{"w":"وَأَتۡرَفۡنَٰهُمۡ","m":"جَعَلْناهُم في تَرَفٍ وسَعَةٍ حتَّى بَطِرُوا."}],"34":[{"w":"لَخَٰسِرُونَ","m":"أي: بِتَرْكِكُم آلِهَتَكم واتِّبَاعِكُم الرسولَ عليه السلام."}],"35":[{"w":"مُخۡرَجُونَ","m":"أي: من قُبُورِكُم أحياءً."}],"36":[{"w":"هَيۡهَاتَ","m":"بَعُدَ، أي: ما تُوعدُونَ به أيُّها القومُ."},{"w":"لِمَا تُوعَدُونَ","m":"هو البعثُ بَعْدَ الموتِ."}],"37":[{"w":"وَمَا نَحۡنُ بِمَبۡعُوثِينَ","m":"أي: بَعْدَ المماتِ."}],"38":[{"w":"إِنۡ هُوَ إِلَّا رَجُلٌ","m":"هو هُودٌ أو صالحٌ عليهما الصَّلاةُ والسَّلامُ."},{"w":"ٱفۡتَرَىٰ","m":"اختَلَقَ."},{"w":"بِمُؤۡمِنِينَ","m":"بِمُصَدِّقِينَ."}],"40":[{"w":"عَمَّا قَلِيلٖ","m":"أي: بَعْدَ زَمَنٍ قَريبٍ."}],"41":[{"w":"ٱلصَّيۡحَةُ","m":"صَوْتٌ شَدِيدٌ مُهْلِكٌ."},{"w":"بِٱلۡحَقِّ","m":"أي: يَسْتَحِقُّونَ ذَلك العذابَ؛ لِكُفْرِهم وطُغْيانِهم."},{"w":"فَجَعَلۡنَٰهُمۡ غُثَآءٗ","m":"أي: أمْواتاً كَغُثَاءِ السَّيلِ الذي يَطْفُو على الماءِ."},{"w":"فَبُعۡدٗا","m":"أي: عَن رَّحْمَةِ اللهِ."}],"42":[{"w":"أَنشَأۡنَا","m":"خلَقْنا وأوْجَدْنا."},{"w":"قُرُونًا ءَاخَرِينَ","m":"أقْوَاماً آخَرِينَ مِثْلَ قَوْمِ لُوطٍ وشُعَيبٍ وأيُّوبَ ويونسَ عليهمُ الصَّلاةُ والسَّلامُ."}],"43":[{"w":"مَا تَسۡبِقُ","m":"ما تَتَقَدَّمُ."},{"w":"أَجَلَهَا","m":"الوَقْتَ المَحْدُودَ لهلاكِها."},{"w":"وَمَا يَسۡتَـٔۡخِرُونَ","m":"ولا يتأخَّرُونَ."}],"44":[{"w":"تَتۡرَا","m":"يَتْبَعُ بعضُهم بَعْضاً."},{"w":"أَحَادِيثَ","m":"أخْباراً يَتَحَدَّثُ الناسُ بها للعِبْرَةِ وغيرِها."},{"w":"فَبُعۡدٗا","m":"أي: بُعْداً عَن رَّحْمَةِ اللهِ."}],"45":[{"w":"بِـَٔايَٰتِنَا","m":"أي: بالمُعْجِزاتِ التِّسْعِ، وهي: العَصا، واليدُ البيضاءُ، والسِّنونَ المُجْدِبةُ، ونَقْصُ الثَّمَراتِ، والطُّوفانُ، والجَرادُ، والقُمَّلُ، والضَّفَادِعُ، والدَّمُ"},{"w":"وَسُلۡطَٰنٖ مُّبِينٍ","m":"بُرْهانٍ مُظْهِرٍ لِلْحَقِّ."}],"46":[{"w":"وَمَلَإِيْهِۦ","m":"وأشْرَافِ قَومِه."},{"w":"عَالِينَ","m":"مُسْتَعْلِينَ على النَّاسِ بالبَغْي والظُّلْمِ."}],"47":[{"w":"لَنَا عَٰبِدُونَ","m":"أي: مُنْقَادُون انِقيَادَ العَبِيدِ."}],"50":[{"w":"ءَايَةٗ","m":"علامةً على عَظِيمِ قُدْرَتِنا."},{"w":"وَءَاوَيۡنَٰهُمَآ","m":"وَجَعَلْنا لَهُما مأْوىً وَمنزِلاً."},{"w":"رَبۡوَةٖ","m":"بُقْعَةٍ مُرْتَفِعَةٍ."},{"w":"ذَاتِ قَرَارٖ","m":"أي: فيها أَسْبابُ الاسْتِقْرارِ من الزَّرعِ والثِّمارِ."},{"w":"وَمَعِينٖ","m":"وماءٍ جارٍ تَسْتَمْتِعُ بِرُؤيَتِه العُيونُ."}],"51":[{"w":"مِنَ ٱلطَّيِّبَٰتِ","m":"مايُسْتَطابُ مِنَ الحَلَالِ."}],"52":[{"w":"أُمَّتُكُمۡ أُمَّةٗ وَٰحِدَةٗ","m":"دِينُكُم دِينٌ واحِدٌ وهو دَعْوةُ جَمِيعِ الأنْبِياءِ إلى عِبادَةِ اللهِ وَحْدَه لا شَرِيكَ لَه."}],"53":[{"w":"فَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡ","m":"تَفرَّقَ الأتْباعُ في أَمْرِ دِينِهِم."},{"w":"زُبُرٗا","m":"قِطَعاً وفِرَقاً."},{"w":"فَرِحُونَ","m":"مَسْرُورُونَ."}],"54":[{"w":"فَذَرۡهُمۡ","m":"فاتْرُكْهُم."},{"w":"فِي غَمۡرَتِهِمۡ","m":"في غَفْلَتِهِم التي غَمَرَتْهُم وغَطَّتْهم مِن كُلِّ الجِهاتِ."},{"w":"حَتَّىٰ حِينٍ","m":"إلى وَقْتِ نُزُولِ العَذَاب بِهِم."}],"55":[{"w":"أَيَحۡسَبُونَ","m":"أَيظُنُّونَ."},{"w":"نُمِدُّهُم","m":"نُعْطِيهِم اسْتِدْرَاجاً"}],"57":[{"w":"مُشۡفِقُونَ","m":"وَجِلُونَ وحَذِرُونَ."}],"60":[{"w":"يُؤۡتُونَ مَآ ءَاتَواْ","m":"يُعْطُونَ ما أعْطَوا مِنَ الصَّدقاتِ."},{"w":"وَجِلَةٌ","m":"خائِفَةٌ."}],"63":[{"w":"فِي غَمۡرَةٖ","m":"في غَفْلَةٍ."},{"w":"مِن دُونِ ذَٰلِكَ","m":"مِن دُونِ الشِّركِ."}],"64":[{"w":"مُتۡرَفِيهِم","m":"مُنَعَّمِيهِم الذين أبْطَرَتْهُم النِّعَمُ."},{"w":"يَجۡـَٔرُونَ","m":"يَصْرُخُون مُسْتَغِيثِينَ."}],"65":[{"w":"لَا تَجۡـَٔرُواْ","m":"لا تَصْرُخُوا."}],"66":[{"w":"تَنكِصُونَ","m":"تَرْجِعُونَ وَرَاءَكُم مُعْرِضِينَ عَنْ سَماعِ الآياتِ."}],"67":[{"w":"بِهِۦ سَٰمِرٗا","m":"أي: مُتَسامِرِينَ باللَّيلِ حَولَ الكَعْبَةِ."},{"w":"تَهۡجُرُونَ","m":"تَتَكَلَّمُونَ بِساقِطِ القولِ."}],"68":[{"w":"أَفَلَمۡ يَدَّبَّرُواْ ٱلۡقَوۡلَ","m":"أفلم يَتَفَكَّرُوا في القرآنِ."}],"70":[{"w":"جِنَّةُۢ","m":"جُنُونٌ."}],"71":[{"w":"بِذِكۡرِهِمۡ","m":"بالقرآنِ الذي فِيهِ عِزُّهُم وَشَرفُهُم."}],"72":[{"w":"خَرۡجٗا","m":"أجْراً مِنَ المالِ."},{"w":"فَخَرَاجُ رَبِّكَ","m":"ثوابُ اللهِ وعَطاؤُه."}],"73":[{"w":"صِرَٰطٖ مُّسۡتَقِيمٖ","m":"دِينٍ قَوِيمٍ وهو الإسْلامُ."}],"74":[{"w":"لَنَٰكِبُونَ","m":"لمائِلُونَ ومُنْحَرِفُونَ عَنْه."}],"75":[{"w":"مِن ضُرّٖ","m":"مِن جَدْبٍ وَجُوعٍ."},{"w":"لَلَجُّواْ","m":"لَتَمادَوا واسْتَمَرُّوا."},{"w":"فِي طُغۡيَٰنِهِمۡ","m":"في كُفْرِهِم وَعِنادِهِم."},{"w":"يَعۡمَهُونَ","m":"يَتَرَدَّدُونَ."}],"76":[{"w":"فَمَا ٱسۡتَكَانُواْ","m":"فما خَضَعُوا وما أظْهَرُوا المَسْكَنَةَ."},{"w":"وَمَا يَتَضَرَّعُونَ","m":"وما يَتَذَلَّلُونَ للهِ تعالى بالدُّعاءِ."}],"77":[{"w":"مُبۡلِسُونَ","m":"آيِسُونَ مِن كُلِّ خَيرٍ، مُتَحَيِّرُونَ."}],"79":[{"w":"ذَرَأَكُمۡ","m":"خَلَقَكُم وبَثَّكُم."}],"80":[{"w":"ٱخۡتِلَٰفُ ٱلَّيۡلِ وَٱلنَّهَارِ","m":"تَعاقُبُهُما وتَفَاوُتُهُما."}],"81":[{"w":"ٱلۡأَوَّلُونَ","m":"آباؤهُم وأَسْلافُهُم المُتَقَدِّمون."}],"82":[{"w":"لَمَبۡعُوثُونَ","m":"أي: من قُبُورِنا أَحْياءً."}],"83":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"الأكَاذِيبُ الَّتي كَتَبَها المُتَقَدِّمُونَ."}],"85":[{"w":"أَفَلَا تَذَكَّرُونَ","m":"أَنَّ اللهَ قادِرٌ على البَعْثِ والنُّشُورِ؟"}],"87":[{"w":"أَفَلَا تَتَّقُونَ","m":"أفلا تَخَافُونَ عِقابَ اللهِ على كُفْرِكُم وشِرْكِكُم؟"}],"88":[{"w":"مَلَكُوتُ كُلِّ شَيۡءٖ","m":"مالِكُ كُلِّ شَيءٍ والمُتَصَرِّفُ فِيه."},{"w":"يُجِيرُ","m":"يُغِيثُ ويَحْمِي غيرَه."},{"w":"وَلَا يُجَارُ عَلَيۡهِ","m":"ولا يُغِيثُ ولا يَحْمِي أَحَدٌ منه أَحَداً."}],"89":[{"w":"فَأَنَّىٰ تُسۡحَرُونَ","m":"فَكَيفَ تُصْرَفَونَ عَنِ الحقِّ، ويُخَيَّل إليكُم الكَذِبُ صِدْقاً، والفَاسِدُ صَحِيحاً؟"}],"90":[{"w":"لَكَٰذِبُونَ","m":"أي: في شِرْكِهِم وإنْكَارِهِم البَعْثَ."}],"91":[{"w":"لَذَهَبَ كُلُّ إِلَٰهِۭ بِمَا خَلَقَ","m":"أي: لانْفَردَ كُلُّ مَعْبُودٍ بِمَخْلُوقَاتِه."},{"w":"وَلَعَلَا","m":"وَلَغَلَبَ."},{"w":"سُبۡحَٰنَ ٱللَّهِ","m":"تَنَزَّه وتَقَدَّسَ."},{"w":"عَمَّا يَصِفُونَ","m":"أي: من كَذِبِهِم وبُهْتانِهِم بِأَنَّ له شَرِيكاً أَوْ وَلَداً."}],"92":[{"w":"وَٱلشَّهَٰدَةِ","m":"وما يُشاهَدُ."}],"93":[{"w":"مَا يُوعَدُونَ","m":"أي: مِنَ العَذَابِ."}],"97":[{"w":"هَمَزَٰتِ","m":"نَزَغات ووَسَاوِس."}],"98":[{"w":"أَن يَحۡضُرُونِ","m":"أي: مِنْ حُضُورِ الشَّياطِينِ في أُمُورِي."}],"99":[{"w":"ٱرۡجِعُونِ","m":"رُدُّوني إلى الدُّنيا."}],"100":[{"w":"هُوَ قَآئِلُهَا","m":"يَقُولُها باللِّسانِ ولا يَعْمَلُ بِمُقْتَضاها."},{"w":"بَرۡزَخٌ","m":"هو الحاجِزُ الَّذي بين الموتِ والبَعْثِ."}],"101":[{"w":"ٱلصُّورِ","m":"القَرْنِ الذي يُنفَخُ فيه للبعْثِ."},{"w":"فَلَآ أَنسَابَ بَيۡنَهُمۡ","m":"أي: فلا تَنْفَعُهم أَنْسَابُهم، ولا يَتَفاخَرُونَ بها؛ مِنْ هَوْلِ الموْقِفِ."},{"w":"وَلَا يَتَسَآءَلُونَ","m":"أي: لا يَسْأَلُ أَحَدٌ أَحَداً."}],"102":[{"w":"ثَقُلَتۡ مَوَٰزِينُهُۥ","m":"أي: بِكَثْرةِ حسناتِهِ."},{"w":"ٱلۡمُفۡلِحُونَ","m":"الفائِزُونَ بالجنَّةِ والنَّجاةِ مِنَ النَّارِ."}],"103":[{"w":"خَفَّتۡ مَوَٰزِينُهُۥ","m":"أي: قَلَّتْ أعْمالُه الصَّالِحَةُ."},{"w":"خَسِرُوٓاْ أَنفُسَهُمۡ","m":"أي: ضَيَّعُوها."}],"104":[{"w":"تَلۡفَحُ","m":"تَحْرِقُ."},{"w":"كَٰلِحُونَ","m":"عابِسُونَ تَقَلَّصَتْ شِفاهُهُم عن أسْنانِهِم؛ مِنْ إحْراقِ النَّارِ وُجُوهَهُم."}],"105":[{"w":"ءَايَٰتِي","m":"أي: آياتُ القُرآن."}],"106":[{"w":"شِقۡوَتُنَا","m":"هي المَلَذَّاتُ والشَّهَواتُ التي كُتِبَتْ عَلَينا في سابِقِ عِلْمِكَ، وساقَتْنا إلى الشَّقاءِ."}],"107":[{"w":"فَإِنۡ عُدۡنَا","m":"فَإن رَجَعْنا إلى الضَّلالِ."}],"108":[{"w":"ٱخۡسَـُٔواْ فِيهَا","m":"امْكُثُوا في النَّارِ أذِلَّاءَ صاغِرِينَ."}],"110":[{"w":"سِخۡرِيًّا","m":"مَهْزُوءاً بهم."}],"113":[{"w":"ٱلۡعَآدِّينَ","m":"أي: المُتَمَكِّنِينَ مِن مَعْرِفَةِ العَدَدِ مِنَ الملائِكَةِ أو مِنَ النَّاسِ."}],"115":[{"w":"عَبَثٗا","m":"لَعِباً مِنْ غَيرِ فائِدةٍ وَلاحِكْمَةٍ."}],"116":[{"w":"ٱلۡمَلِكُ","m":"الَّذي يَحِقُّ لَهُ المُلْكُ على الإطْلاقِ."},{"w":"ٱلۡحَقُّ","m":"الثَّابِتُ الَّذي لا يَزُولُ."},{"w":"ٱلۡعَرۡشِ","m":"هو سَرِيرُ المُلْكِ الَّذي اسْتَوى عليه الرَّحمنُ، وتَحْمِلُه الملائِكةُ، وهو أعْظَمُ المَخْلُوقاتِ، وهو سَقْفُ الجنَّةِ."}]}