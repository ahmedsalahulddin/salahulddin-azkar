{"1":[{"w":"قٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرَةِ."},{"w":"ٱلۡمَجِيدِ","m":"ذي المجْدِ والشَّرَفِ."}],"2":[{"w":"عَجِيبٌ","m":"مُسْتَغْرَبٌ يُتَعَجَّبُ مِنْهُ."}],"3":[{"w":"رَجۡعُۢ","m":"بَعْثٌ."}],"4":[{"w":"تَنقُصُ ٱلۡأَرۡضُ مِنۡهُمۡ","m":"تُفْنِي مِنْ أَجْسامِهِم."},{"w":"حَفِيظُۢ","m":"مَحفُوظٌ."}],"5":[{"w":"مَرِيجٍ","m":"مُخْتَلِطٍ مُضْطَرِبٍ."}],"6":[{"w":"فُرُوجٖ","m":"شُقُوقٍ وَصُدُوعٍ."}],"7":[{"w":"مَدَدۡنَٰهَا","m":"بَسَطْناها."},{"w":"رَوَٰسِيَ","m":"جِبالاً ثَوابِتَ."},{"w":"زَوۡجِۭ","m":"نَوْعٍ وَجِنْسٍ."},{"w":"بَهِيجٖ","m":"حَسَنِ المنْظَر."}],"8":[{"w":"تَبۡصِرَةٗ","m":"تَجْعَلُ المرءَ مُبْصِراً."},{"w":"وَذِكۡرَىٰ","m":"تُذَكِّرُ النَّاسِي."},{"w":"مُنِيبٖ","m":"رَجَّاعٍ إلى اللهِ."}],"9":[{"w":"مُبَٰرَكٗا","m":"كَثِيرَ الخَيْرِ والمنافِعِ."},{"w":"وَحَبَّ ٱلۡحَصِيدِ","m":"وحَبَّ الزَّرْعِ المحْصُودِ."}],"10":[{"w":"بَاسِقَٰتٖ","m":"مُرْتَفِعاتٍ."},{"w":"طَلۡعٞ","m":"هُو أوَّلُ ما يَظْهَرُ مِن ثَمَرِ التَّمْرِ، وَهُو غِلافُ العُنْقُودِ."},{"w":"نَضِيدٞ","m":"مَنْضُودٌ، مُصَفَّفٌ بعْضُهُ فَوْقَ بَعْضٍ."}],"11":[{"w":"مَيۡتٗا","m":"أَجْدَبَتْ وَقَحَطَتْ."},{"w":"كَذَٰلِكَ","m":"كَمَا أَحْيا اللهُ هَذِه الأَرْضَ الميتَةَ."},{"w":"ٱلۡخُرُوجُ","m":"خُرُوجُ النَّاسِ يَومَ البعْثِ."}],"12":[{"w":"ٱلرَّسِّ","m":"البِئْرِ."}],"14":[{"w":"وَأَصۡحَٰبُ ٱلۡأَيۡكَةِ","m":"أَصْحابُ الشَّجَرِ المُلْتَفِّ، وهم قَوْمُ شُعَيبٍ عَلَيهِ السَّلامُ."},{"w":"وَقَوۡمُ تُبَّعٖ","m":"هُم سَبأٌ، وتُبَّعٌ هُوَ أَحَدُ مُلُوكِ اليمَنِ."},{"w":"فَحَقَّ","m":"صَدَقَ وَتَحَقَّقَ."},{"w":"وَعِيدِ","m":"إنذارِي بالعُقُوبةِ."}],"15":[{"w":"أَفَعَيِينَا","m":"أَفَعَجَزْنا."},{"w":"لَبۡسٖ","m":"اشْتِباهٍ وَشَكٍّ."},{"w":"خَلۡقٖ جَدِيدٖ","m":"قِيامِ الخَلْقِ في البَعْثِ."}],"16":[{"w":"مَا تُوَسۡوِسُ بِهِۦ","m":"تُحَدِّث بِه."},{"w":"حَبۡلِ ٱلۡوَرِيدِ","m":"عِرْقِ العُنُقِ المُتَّصِلِ بالقلبِ."}],"17":[{"w":"يَتَلَقَّى","m":"يُسَجِّلُ."},{"w":"ٱلۡمُتَلَقِّيَانِ","m":"المَلَكَانِ المُوكَّلَانِ بِكِتابَةِ أعْمالِ النَّاسِ وأَقْوالِهِم."},{"w":"عَنِ ٱلۡيَمِينِ","m":"عَن يَمِينِ الإِنْسانِ."},{"w":"قَعِيدٞ","m":"مُقاعِدٌ، مِثْلُ جَلِيسٍ للمُجالِسِ."}],"18":[{"w":"رَقِيبٌ","m":"مَلَكٌ يَرْقُبُ قَوْلَهُ وَيَكْتُبُهُ."},{"w":"عَتِيدٞ","m":"حَاضِرٌ مُعَدٌّ لِذَلِكَ."}],"19":[{"w":"سَكۡرَةُ ٱلۡمَوۡتِ","m":"شِدَّةُ غَمَراتِ الموتِ."},{"w":"تَحِيدُ","m":"تَفِرُّ وَتَهْرُبُ."}],"20":[{"w":"ٱلصُّورِ","m":"القَرْنِ الَّذِي يَنْفُخُ فِيهِ إسْرَافِيلُ."},{"w":"يَوۡمُ ٱلۡوَعِيدِ","m":"أي الَّذِي تَوَعَّدَ اللهُ بِه الكُفَّارَ."}],"21":[{"w":"سَآئِقٞ","m":"مَلَكٌ يَسُوقُ الإنْسَانَ إِلى الْمَحْشَرِ."},{"w":"وَشَهِيدٞ","m":"مَلَكٌ يَشْهَدُ عَلَى النَّفْسِ بِما عَمِلَتْ."}],"22":[{"w":"حَدِيدٞ","m":"قَوِيُّ النَّفاذِ في المرئِيِّ."}],"23":[{"w":"قَرِينُهُۥ","m":"المَلَكُ الكاتِبُ الشَّهِيدُ عَلَيهِ."},{"w":"عَتِيدٌ","m":"مُهَيَّأٌ محفُوظٌ."}],"24":[{"w":"عَنِيدٖ","m":"مُعانِدٍ لِلْحَقِّ."}],"25":[{"w":"مُعۡتَدٖ","m":"ظَالِمٍ مُتَجاوِزٍ لِلْحَقِّ."},{"w":"مُرِيبٍ","m":"شَاكٍّ."}],"27":[{"w":"قَرِينُهُۥ","m":"شَيْطَانُه الَّذِي كَانَ مُوَكَّلاً بِهِ في الدُّنيا."},{"w":"مَآ أَطۡغَيۡتُهُۥ","m":"ما أَضْلَلْتُهُ."},{"w":"ضَلَٰلِۭ","m":"طَرِيقٍ بَعِيدٍ عن سَبِيلِ الهُدَى."}],"28":[{"w":"قَدَّمۡتُ إِلَيۡكُم بِٱلۡوَعِيدِ","m":"أَعْلَمْتُكُم ما يَنْتَظِرُ العاصِيَ مِن العُقُوبَةِ."}],"30":[{"w":"مَزِيدٖ","m":"زِيادةٍ في وارِدِيها."}],"31":[{"w":"وَأُزۡلِفَتِ","m":"وقُرِّبَتْ."},{"w":"غَيۡرَ بَعِيدٍ","m":"مَكَاناً غَيرَ بَعِيدٍ مِنَ المُتَّقِينَ."}],"32":[{"w":"أَوَّابٍ","m":"كَثِيرِ الرُّجُوعِ عن ذُنُوبِهِ."},{"w":"حَفِيظٖ","m":"حافظٍ لِكُلِّ عَمَلٍ صَالِحٍ قَرَّبَهُ إلى ربِّهِ."}],"33":[{"w":"بِٱلۡغَيۡبِ","m":"في حالِ غِيابهِ عَنْ أَعْيُنِ النَّاسِ."},{"w":"مُنِيبٍ","m":"تائبٍ مِنْ ذُنُوبِهِ."}],"34":[{"w":"بِسَلَٰمٖ","m":"وَأَنْتُم سالِمُونَ."},{"w":"يَوۡمُ ٱلۡخُلُودِ","m":"هُوَ الَّذِي لا زَوَالَ لَهُ، وَلَا مَوْتَ."}],"35":[{"w":"مَزِيدٞ","m":"أي: النَّظَرُ إلى وَجْهِ اللهِ الكريمِ."}],"36":[{"w":"مِن قَرۡنٍ","m":"مِنْ أُمَّةٍ."},{"w":"بَطۡشٗا","m":"قُوَّةً وَسَطْوَةً."},{"w":"فَنَقَّبُواْ","m":"فَطَوَّفُوا."},{"w":"مَحِيصٍ","m":"مَهْرَبٍ مِنْ عَذَابِ اللهِ."}],"37":[{"w":"قَلۡبٌ","m":"عَقْلٌ."},{"w":"أَلۡقَى ٱلسَّمۡعَ","m":"أَصْغَى السَّمْعَ، واسْتَمَعَ بِأُذُنَيْهِ."},{"w":"شَهِيدٞ","m":"حاضِرٌ بِقَلْبِهِ."}],"38":[{"w":"وَمَا مَسَّنَا","m":"وَمَا أَصَابَنا."},{"w":"لُغُوبٖ","m":"تَعَبٍ."}],"40":[{"w":"وَأَدۡبَٰرَ ٱلسُّجُودِ","m":"عَقِبَ الصَّلَواتِ."}],"41":[{"w":"وَٱسۡتَمِعۡ","m":"أيُّها النَّبِيُّ لِمَا أُخْبِرُكَ بِهِ مِنْ أَهْوَالِ يَوْمِ القِيامَةِ."},{"w":"ٱلۡمُنَادِ","m":"هُوَ المَلَكُ المُوَكَّلُ بِنَفْخِ الصُّورِ."},{"w":"مَكَانٖ قَرِيبٖ","m":"صَخْرَةِ بَيتِ المَقْدِسِ."}],"42":[{"w":"بِٱلۡحَقِّ","m":"بِالصِّدْقِ."},{"w":"يَوۡمُ ٱلۡخُرُوجِ","m":"يومُ البَعْثِ مِنَ القُبُورِ."}],"44":[{"w":"تَشَقَّقُ","m":"تَتَصَدَّعُ."},{"w":"سِرَاعٗا","m":"مُسْرِعِينَ."}],"45":[{"w":"بِجَبَّارٖ","m":"بِمُسَلَّطٍ عَلَيهِم تُجْبِرُهُم عَلَى الإِيمانِ."}]}