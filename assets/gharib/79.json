{"1":[{"w":"وَٱلنَّٰزِعَٰتِ","m":"أُقْسِمُ بالملائِكةِ الَّتِي تَنْزِعُ أَرْوَاحَ الكُفَّارِ."},{"w":"غَرۡقٗا","m":"نَزْعاً غَرْقاً، أي مُغْرِقاً، أي: تَنْزِعُ الأرْوَاحَ من أَقاصِي الأَجْسادِ."}],"2":[{"w":"وَٱلنَّٰشِطَٰتِ","m":"والملائِكَةِ الَّتِي تَقْبِضُ أرْوَاحَ المؤمِنِينَ."},{"w":"نَشۡطٗا","m":"بِنَشاطٍ وَرِفقٍ."}],"3":[{"w":"وَٱلسَّٰبِحَٰتِ","m":"والملائِكَةِ الَّتِي تَسْبَحُ في نُزُولِها مِنَ السَّماءِ وصُعُودِها إِليها."}],"4":[{"w":"فَٱلسَّٰبِقَٰتِ","m":"فالملائِكَةِ الَّتِي تُسارِعُ إلى تَنِفيذِ أَمْرِ اللهِ."}],"5":[{"w":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","m":"فالملائِكةِ المُنَفِّذاتِ أَمْرَ رَبِّها."}],"6":[{"w":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","m":"يومَ تَضْطَرِبُ الأرضُ بالنَّفْخَةِ الأُولَى نَفْخَةِ الإِماتَةِ."}],"7":[{"w":"تَتۡبَعُهَا ٱلرَّادِفَةُ","m":"تَتْبَعُها نَفْخَةٌ أُخْرَى لِبَعْثِ الخَلْقِ."}],"8":[{"w":"قُلُوبٞ","m":"قُلُوبُ الكُفَّارِ."},{"w":"وَاجِفَةٌ","m":"مُضْطَرِبَةٌ مِن شِدَّةِ الخوفِ."}],"9":[{"w":"خَٰشِعَةٞ","m":"ذَلِيلَةٌ مِنْ هَوْلِ ما تَرَى."}],"10":[{"w":"أَءِنَّا لَمَرۡدُودُونَ","m":"أنُرَدُّ بَعْدَ مَوتِنا؟"},{"w":"ٱلۡحَافِرَةِ","m":"إلى أَوَّلِ حالِنا، فَنَصِيرُ أحياءً بَعْدَ مَوْتِنا."}],"11":[{"w":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","m":"أنُرَدُّ وَقَدْ صِرْنا عِظاماً بالِيةً؟"}],"12":[{"w":"كَرَّةٌ خَاسِرَةٞ","m":"رَجْعَةٌ خائِبةٌ كاذِبةٌ."}],"13":[{"w":"زَجۡرَةٞ وَٰحِدَةٞ","m":"نَفْخَةٌ وَاحِدَةٌ."}],"14":[{"w":"بِٱلسَّاهِرَةِ","m":"على وَجْهِ الأَرْضِ."}],"16":[{"w":"ٱلۡمُقَدَّسِ","m":"المُطَهَّرِ المبارَكِ."},{"w":"طُوًى","m":"وادٍ في جانِبِ جَبَلِ الطُّورِ."}],"17":[{"w":"طَغَىٰ","m":"أَفْرَطَ في العِصْيانِ."}],"18":[{"w":"هَل لَّكَ","m":"أَتَوَدُّ."},{"w":"تَزَكَّىٰ","m":"تُطَهِّرَ نَفْسَكَ."}],"20":[{"w":"فَأَرَىٰهُ","m":"فَأَرى مُوسَى فِرْعَونَ."},{"w":"ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","m":"العلامةَ العُظْمَى: العَصا واليدَ."}],"22":[{"w":"أَدۡبَرَ","m":"وَلَّى مُعْرِضاً عَنِ الإِيمانِ."},{"w":"يَسۡعَىٰ","m":"في مُعارَضَةِ مُوسى."}],"23":[{"w":"فَحَشَرَ","m":"فَجَمَعَ النَّاسَ."}],"25":[{"w":"فَأَخَذَهُ ٱللَّهُ","m":"فَعَاقَبَهُ."},{"w":"نَكَالَ ٱلۡأٓخِرَةِ","m":"عَذابَ الآخِرَةِ."},{"w":"وَٱلۡأُولَىٰٓ","m":"وَعَذابَ الدُّنيا."}],"26":[{"w":"لَعِبۡرَةٗ","m":"لَمَوْعِظَةً."}],"27":[{"w":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُ","m":"أبَعْثُكُم-أيُّها الناسُ- بَعْدَ الموتِ أَشَدُّ في تَقْدِيرِكُم أم خَلْقُ السَّماءِ؟"},{"w":"بَنَىٰهَا","m":"خَلَقَها."}],"28":[{"w":"رَفَعَ سَمۡكَهَا","m":"رَفَعَها فَوقَكُم كالبِناءِ فَأَعلى سَقْفَها في الهوَاءِ."},{"w":"فَسَوَّىٰهَا","m":"فعَدَّلَ أَجْزَاءَها بإتْقان."}],"29":[{"w":"وَأَغۡطَشَ لَيۡلَهَا","m":"وَأَظْلَمَ لَيْلَها."},{"w":"وَأَخۡرَجَ ضُحَىٰهَا","m":"وَأَبْرَزَ نَهارَها."}],"30":[{"w":"بَعۡدَ ذَٰلِكَ","m":"بَعْدَ خَلْقِ السَّماءِ."},{"w":"دَحَىٰهَآ","m":"بَسَطَها وَأَوْدَعَ فِيها منافِعَها."}],"31":[{"w":"وَمَرۡعَىٰهَا","m":"وَأَنبَتَ فِيها ما يُرعَى مِنَ النباتاتِ."}],"32":[{"w":"أَرۡسَىٰهَا","m":"أَثْبتَهَا في الأرضِ."}],"33":[{"w":"مَتَٰعٗا لَّكُمۡ","m":"مَنفَعَةً لَكُم."}],"34":[{"w":"ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","m":"القِيامَةُ الكُبْرَى والشِّدَّةُ العُظْمَى وهي النَّفْخَةُ الثَّانِيةُ."}],"35":[{"w":"يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","m":"يُعْرَضُ عَلى الإنسانِ عَمَلُهُ، فَيَتَذَكَّرُهُ وَيَعْتَرِفُ بِهِ."}],"36":[{"w":"وَبُرِّزَتِ","m":"وأُظهِرَتْ."}],"37":[{"w":"طَغَىٰ","m":"أَفْرَطَ في العِصيانِ."}],"38":[{"w":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","m":"وَفَضَّل الحياةَ الدُّنيا على الآخِرَةِ."}],"39":[{"w":"ٱلۡمَأۡوَىٰ","m":"المصِيرُ والمآلُ."}],"40":[{"w":"مَقَامَ رَبِّهِۦ","m":"القِيامَ بينَ يَدَيِ اللهِ لِلحِسابِ."},{"w":"ٱلۡهَوَىٰ","m":"الأَهْواءِ الفاسِدةِ."}],"41":[{"w":"ٱلۡمَأۡوَىٰ","m":"مَسْكَنُهُ."}],"42":[{"w":"أَيَّانَ مُرۡسَىٰهَا","m":"مَتَى وَقْتُ السَّاعةِ؟"}],"43":[{"w":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","m":"لَسْتَ في شَيءٍ مِن عِلْمِها."}],"44":[{"w":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","m":"مَرَدُّ ذَلِكَ إلى اللهِ عَزَّ وَجَلَّ."}],"45":[{"w":"مُنذِرُ","m":"مُحذِّرٌ مِنْها."}],"46":[{"w":"عَشِيَّةً","m":"ما بَينَ الظُّهْرِ إلى غُرُوبِ الشَّمسِ."},{"w":"ضُحَىٰهَا","m":"ما بَينَ طُلُوعِ الشَّمسِ إلى نِصْفِ النَّهارِ."}]}