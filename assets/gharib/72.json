{"1":[{"w":"ٱسۡتَمَعَ","m":"لِتِلاوَتِي لِلْقُرآنِ."},{"w":"نَفَرٞ","m":"جَماعَةٌ."},{"w":"عَجَبٗا","m":"بَدِيعًا في بَلَاغَتِهِ وَأَحْكامِهِ."}],"2":[{"w":"يَهۡدِيٓ إِلَى ٱلرُّشۡدِ","m":"يَدْعُو إِلى الحقِّ."}],"3":[{"w":"تَعَٰلَىٰ جَدُّ رَبِّنَا","m":"عَلَتْ وارْتَفَعَتْ عَظَمَةُ رَبِّنا وَجَلَالُهُ، وَأمْرُهُ، وقُدْرَتُهُ."},{"w":"صَٰحِبَةٗ","m":"زَوْجةً."}],"4":[{"w":"سَفِيهُنَا","m":"إِبْلِيسُ."},{"w":"شَطَطٗا","m":"قَوْلاً بعِيداً عَنِ الحقِّ والصَّوَابِ."}],"6":[{"w":"يَعُوذُونَ","m":"يَسْتَجِيرُونَ وَيَلُوذُونَ."},{"w":"فَزَادُوهُمۡ","m":"فَزَادَ رِجالُ الجِنِّ الإنسَ باسْتِعاذَتِهم بِهِم."},{"w":"رَهَقٗا","m":"خَوْفاً."}],"7":[{"w":"وَأَنَّهُمۡ","m":"وَأَنَّ كُفَّارَ الإِنْسِ."},{"w":"ظَنُّواْ كَمَا ظَنَنتُمۡ","m":"حَسِبُوا كما حَسِبْتُم يا مَعْشرَ الِجنِّ."},{"w":"أَن لَّن يَبۡعَثَ ٱللَّهُ أَحَدٗا","m":"بَعْدَ الموتِ."}],"8":[{"w":"لَمَسۡنَا ٱلسَّمَآءَ","m":"طَلَبْنا بُلُوغَ السَّماءِ لاسْتِماعِ كَلَامِ أَهْلِها."},{"w":"حَرَسٗا شَدِيدٗا","m":"مَلائِكةً تَحْرُسُها."},{"w":"وَشُهُبٗا","m":"جَمْعُ شِهابٍ، وهي النُّجُومُ الَّتِي كانتْ تُرْجَمُ بِها الشَّياطِينُ."}],"9":[{"w":"نَقۡعُدُ مِنۡهَا مَقَٰعِدَ","m":"نَتَّخِذُ مِنَ السَّماءِ مَوَاضِعَ."},{"w":"لِلسَّمۡعِ","m":"لِنَسْتَمِعَ إلى أخْبارِها."},{"w":"فَمَن يَسۡتَمِعِ ٱلۡأٓنَ","m":"فَمَن يُحاوِلِ الآنَ اسْتِراقَ السَّمْعِ."},{"w":"شِهَابٗا رَّصَدٗا","m":"شِهاباً بالمِرْصادِ، يُحْرِقُه وَيُهْلِكُهُ."}],"10":[{"w":"رَشَدٗا","m":"خَيراً وهُدَىً."}],"11":[{"w":"وَمِنَّا دُونَ ذَٰلِكَ","m":"وَمِنَّا قَومٌ دُونَ ذَلِكَ كُفَّارٌ وفُسَّاقٌ."},{"w":"طَرَآئِقَ","m":"فِرَقاً وَمَذَاهِبَ."},{"w":"قِدَدٗا","m":"مخْتَلِفَةً."}],"12":[{"w":"ظَنَنَّآ","m":"أَيْقَنَّا."},{"w":"أَن لَّن نُّعۡجِزَ ٱللَّهَ فِي ٱلۡأَرۡضِ","m":"أَن لَن نَفُوتَ اللهَ إذا أَرَادَ بِنا أَمْراً فِي الأَرْضِ."},{"w":"وَلَن نُّعۡجِزَهُۥ هَرَبٗا","m":"وَلَن نسْتَطِيعَ أَن نُفْلِتَ مِن عِقابِهِ هَرَباً."}],"13":[{"w":"ٱلۡهُدَىٰٓ","m":"القُرآنَ."},{"w":"بَخۡسٗا","m":"نُقْصاناً مِنْ حَسَناتِه."},{"w":"رَهَقٗا","m":"ظُلماً يَلْحَقُهُ بِزِيادةٍ في سَيِّئاتِهِ."}],"14":[{"w":"ٱلۡمُسۡلِمُونَ","m":"الخاضِعُونَ للهِ بالطَّاعةِ."},{"w":"ٱلۡقَٰسِطُونَ","m":"الجائِرُونَ العُصاةُ."},{"w":"أَسۡلَمَ","m":"خَضَعَ للهِ بالطَّاعةِ."},{"w":"تَحَرَّوۡاْ","m":"قَصَدُوا."},{"w":"رَشَدٗا","m":"طَرِيقَ الحقِّ والصَّوابِ."}],"15":[{"w":"وَأَمَّا ٱلۡقَٰسِطُونَ","m":"الجائِرُونَ عَن طَرِيقِ الإسْلامِ."},{"w":"حَطَبٗا","m":"وَقُوداً."}],"16":[{"w":"وَأَلَّوِ ٱسۡتَقَٰمُواْ عَلَى ٱلطَّرِيقَةِ","m":"لَو سارَ الكُفَّارُ مِنَ الإِنْسِ والِجنِّ على طَرِيقَةِ الإِسْلامِ."},{"w":"غَدَقٗا","m":"كَثِيراً."}],"17":[{"w":"لِنَفۡتِنَهُمۡ فِيهِ","m":"لِنَخْتَبِرَهُم."},{"w":"ذِكۡرِ رَبِّهِۦ","m":"طاعَةِ رَبِّهِ، واسْتِماعِ القُرآنِ، والعَمَلِ بِهِ."},{"w":"يَسۡلُكۡهُ","m":"يُدْخِلْهُ."},{"w":"صَعَدٗا","m":"شَدِيداً شاقّاً."}],"18":[{"w":"وَأَنَّ ٱلۡمَسَٰجِدَ لِلَّهِ","m":"وَأَنَّ المساجِدَ لِعبادَة اللهِ وَحْدَهُ."},{"w":"فَلَا تَدۡعُواْ مَعَ ٱللَّهِ أَحَدٗا","m":"فلا تَعْبُدُوا فِيها غَيرَهُ."}],"19":[{"w":"عَبۡدُ ٱللَّهِ","m":"مُحَمَّدٌ ﷺ."},{"w":"لِبَدٗا","m":"جَماعاتٍ مُتَراكِمَةً، بَعْضُها فَوْقَ بَعْضٍ؛ مِن شِدَّةِ ازْدِحامِهِم لِسَمَاعِ القُرآنِ مِنْهُ."}],"21":[{"w":"إِنِّي لَآ أَمۡلِكُ لَكُمۡ ضَرّٗا","m":"لا أَقْدِرُ أَن أَدْفَعَ عَنْكُم ضَرًّا."},{"w":"وَلَا رَشَدٗا","m":"وَلا أَجْلِبُ لَكُم نَفْعاً."}],"22":[{"w":"لَن يُجِيرَنِي","m":"لَن يُنْقِذَني مِنْ عَذابِ اللهِ."},{"w":"مُلۡتَحَدًا","m":"مَلْجَأً أفِرُّ إلَيهِ مِنْ عَذابِهِ."}],"23":[{"w":"إِلَّا بَلَٰغٗا مِّنَ ٱللَّهِ وَرِسَٰلَٰتِهِۦ","m":"لَكِنْ أمْلِكُ أَنْ أُبَلِّغَكُم عَنِ اللهِ ما أَمَرَنِي بِتَبْلِيغِهِ لَكُم."}],"24":[{"w":"مَا يُوعَدُونَ","m":"ما يَعِدُهُم رَبُّهُم."},{"w":"نَاصِرٗا","m":"مُعِيناً."},{"w":"عَدَدٗا","m":"جُنْداً."}],"25":[{"w":"إِنۡ أَدۡرِيٓ","m":"ما أَعْلَمُ."},{"w":"مَا تُوعَدُونَ","m":"ما يَعِدُكُم رَبُّكُم مِنَ العَذَابِ وَقِيامِ السَّاعةِ."},{"w":"أَمَدًا","m":"مُدَّةً طَوِيلَةً."}],"26":[{"w":"ٱلۡغَيۡبِ","m":"ما غَابَ عَنِ الأبْصارِ."},{"w":"فَلَا يُظۡهِرُ","m":"فلا يُطْلِعُ."}],"27":[{"w":"إِلَّا مَنِ ٱرۡتَضَىٰ مِن رَّسُولٖ","m":"إلَّا مَن اختارهم اللهُ لِرسالَتِهِ، فَإِنَّه يُطْلِعُهُم عَلَى بَعْضِ الغَيبِ."},{"w":"يَسۡلُكُ مِنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦ رَصَدٗا","m":"يُرْسِلُ مِنْ أمامِ الرَّسُولِ ومِنْ خَلْفِهِ ملائِكَةً يحفَظُونَهُ مِنَ الِجنِّ؛ لِئلَّا يَسْتَرِقُوهُ وَيَهْمِسُوا بِهِ إلى الكَهَنَةِ."}],"28":[{"w":"وَأَحَاطَ بِمَا لَدَيۡهِمۡ","m":"وعَلِمَ اللهُ بِكُلِّ ما عِنْدَهُم."},{"w":"وَأَحۡصَىٰ كُلَّ شَيۡءٍ عَدَدَۢا","m":"عَلِمَ اللهُ عَدَدَ الأَشْياءِ كُلِّها."}]}