{"1":[{"w":"حمٓ","m":"سَبَقَ الكلامُ عَلى الحُرُوفِ المقَطَّعةِ أوَّلَ سُورَةِ البَقَرةِ."}],"2":[{"w":"ٱلۡمُبِينِ","m":"الواضِحِ لَفْظاً وَمَعْنىً."}],"3":[{"w":"مُبَٰرَكَةٍ","m":"كَثِيرَةِ الخَيراتِ، وهي لَيلةُ القَدْرِ."}],"4":[{"w":"يُفۡرَقُ","m":"يُقضَىٰ ويُفْصَلُ مِنَ اللَّوْحِ المحْفُوظِ إلى الكَتَبةِ مِنَ الملائِكَةِ."},{"w":"حَكِيمٍ","m":"مُحْكَمٍ."}],"10":[{"w":"فَٱرۡتَقِبۡ","m":"فانْتَظِرْ."},{"w":"بِدُخَانٖ","m":"ظُلْمَةٍ كَهَيئَةِ الدُّخانِ بِسَبَبِ الجَدْبِ."},{"w":"مُبِينٖ","m":"واضِحٍ."}],"11":[{"w":"يَغۡشَى","m":"يَعُمُّ."}],"13":[{"w":"أَنَّىٰ","m":"كَيفَ."},{"w":"ٱلذِّكۡرَىٰ","m":"التَّذَكُّرُ والاتِّعاظُ."}],"14":[{"w":"تَوَلَّوۡاْ عَنۡهُ","m":"أَعْرَضُوا عَنْه."},{"w":"مُعَلَّمٞ","m":"عَلَّمَه بَشَرٌ أو الكَهَنَةُ أو الشَّياطِينُ."}],"16":[{"w":"نَبۡطِشُ","m":"نُعَذِّبُ، والبَطْشُ أَخْذٌ بِشِدَّةٍ."}],"17":[{"w":"فَتَنَّا","m":"ابْتَلينا واخْتَبَرْنا."}],"18":[{"w":"أَدُّوٓاْ","m":"سَلِّمُوا وأرْسِلُوا مَعِي."},{"w":"عِبَادَ ٱللَّهِ","m":"بَنِي إسْرائِيلَ."}],"19":[{"w":"وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِ","m":"لا تَتَكَبَّرُوا على اللهِ بِتَكْذِيبِ رُسُلِه."},{"w":"بِسُلۡطَٰنٖ","m":"بِبُرْهانٍ."}],"20":[{"w":"عُذۡتُ بِرَبِّي","m":"استَجَرْتُ بِاللهِ."},{"w":"تَرۡجُمُونِ","m":"تَقْتُلُوني رَجْماً بالحِجارَةِ."}],"21":[{"w":"فَٱعۡتَزِلُونِ","m":"كُفُّوا عَنْ أذَايَ."}],"22":[{"w":"مُجۡرِمُونَ","m":"مُشْرِكُونَ بِاللهِ كافِرُونَ."}],"23":[{"w":"فَأَسۡرِ","m":"اجْعَلْهُم يَسِيُرونَ لَيلاً."}],"24":[{"w":"رَهۡوًا","m":"سَاكِناً مُسْتَقِرّاً عَلَى حالِه مُنْفَرِجاً."}],"26":[{"w":"وَمَقَامٖ كَرِيمٖ","m":"وَمَنازِلَ جَمِيلَةٍ."}],"27":[{"w":"وَنَعۡمَةٖ","m":"عَيْشٍ لَيِّنٍ رَغْدٍ."},{"w":"فَٰكِهِينَ","m":"مُتَنَعِّمِينَ، مُتْرَفِينَ."}],"28":[{"w":"كَذَٰلِكَ","m":"مِثْلَ ذَلِكَ العِقابِ يُعاقِبُ اللهُ مَنْ كَذَّبَ وَبَدّلَ نِعْمةَ اللهِ كُفْراً."},{"w":"وَأَوۡرَثۡنَٰهَا","m":"ومَلَّكْناها."}],"29":[{"w":"مُنظَرِينَ","m":"مُؤَخَّرِينَ عَنِ العُقُوبَةِ."}],"30":[{"w":"ٱلۡمُهِينِ","m":"المُذِلِّ."}],"31":[{"w":"عَالِيٗا","m":"جَبَّاراً."},{"w":"مِنَ ٱلۡمُسۡرِفِينَ","m":"مُتَجاوِزاً للحَدِّ في العُلوِّ والتَّكَبُّرِ عَلَى عبادِ اللهِ."}],"32":[{"w":"ٱلۡعَٰلَمِينَ","m":"عالَمِي زَمانِهِم."}],"33":[{"w":"ٱلۡأٓيَٰتِ","m":"المُعْجِزاتِ."},{"w":"بَلَٰٓؤٞاْ","m":"اخْتِبارٌ بالرَّخاءِ والشِّدَةِ."}],"35":[{"w":"بِمُنشَرِينَ","m":"بِمَبْعُوثِينَ."}],"37":[{"w":"تُبَّعٖ","m":"أَحَدِ مُلُوكِ اليمنِ الحِمْيَرِيِّينَ مِمَّن جَمَعَ مُلْكَ مَناطِقِ اليمنِ كُلِّها."}],"40":[{"w":"يَوۡمَ ٱلۡفَصۡلِ","m":"يومَ القَضاءِ بَينَ الخَلْقِ."},{"w":"مِيقَٰتُهُمۡ","m":"مَوعِدُ جزائِهِم."}],"41":[{"w":"يُغۡنِي","m":"يَدْفَعُ."},{"w":"مَوۡلٗى","m":"صَاحِبٌ."}],"43":[{"w":"شَجَرَتَ ٱلزَّقُّومِ","m":"شَجَرةً كَرِيهةَ الرَّائِحَةِ صَغِيرةَ الوَرَقِ مَسْمُومةً، خَلَقَها اللهُ في جَهَنَّمَ."}],"44":[{"w":"ٱلۡأَثِيمِ","m":"الكَثِيرِ الآثامِ، والمرادُ بِه المشْرِكُ."}],"45":[{"w":"كَٱلۡمُهۡلِ","m":"كالمَعْدِنِ المُذابِ."}],"46":[{"w":"ٱلۡحَمِيمِ","m":"الماءِ الَّذِي بَلَغَ الغايَةَ فِي الحرارةِ."}],"47":[{"w":"فَٱعۡتِلُوهُ","m":"ادْفَعُوهُ وقُودُوهُ بِعُنْفٍ."},{"w":"سَوَآءِ","m":"وَسَطِ."}],"48":[{"w":"صُبُّواْ","m":"أَفْرِغُوا."}],"49":[{"w":"ذُقۡ","m":"قُولُوا لَهُ عَلَى وَجْهِ الإهانَةِ: أَحْسِسْ."},{"w":"أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ","m":"أي: الذَّلِيلُ المُهانُ، عُكِسَ المَدْلُولُ للتَّهَكُّمِ بِهِ."}],"50":[{"w":"تَمۡتَرُونَ","m":"تَشُكُّونَ."}],"51":[{"w":"مَقَامٍ","m":"مَسْكَنٍ."},{"w":"أَمِينٖ","m":"آمِنٍ صاحِبُه مِنَ الآفاتِ."}],"53":[{"w":"سُندُسٖ","m":"الرقِيقِ مِنَ الحرِيرِ الخالِصِ."},{"w":"وَإِسۡتَبۡرَقٖ","m":"الغليظِ مِنَ الحريرِ الخالصِ."},{"w":"مُتَقَٰبِلِينَ","m":"أي: في مَجالِسِهِم ومُحادَثاتِهِم."}],"54":[{"w":"وَزَوَّجۡنَٰهُم","m":"قَرَنَّاهُم."},{"w":"بِحُورٍ","m":"جَمْعُ حَوْراءَ وهي البيضاءُ."},{"w":"عِينٖ","m":"وَاسِعاتِ الأَعْيُنِ."}],"55":[{"w":"يَدۡعُونَ","m":"يَطْلُبُونَ."}],"56":[{"w":"ٱلۡمَوۡتَةَ ٱلۡأُولَىٰ","m":"الَّتِي سَلَفَتْ لَهُم في الدُّنيا."}],"58":[{"w":"يَسَّرۡنَٰهُ","m":"سَهَّلْنا لَفْظَ القرآنِ وَمَعْناهُ."}],"59":[{"w":"فَٱرۡتَقِبۡ","m":"فانْتَظِر ما وَعَدْتُكَ."},{"w":"مُرۡتَقِبُونَ","m":"مُنْتَظِرُونَ موتَكَ وقَهْرَكَ."}]}