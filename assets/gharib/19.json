{"1":[{"w":"كٓهيعٓصٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"3":[{"w":"خَفِيّٗا","m":"سِرّاً."}],"4":[{"w":"وَهَنَ","m":"ضَعُفَ."},{"w":"وَٱشۡتَعَلَ ٱلرَّأۡسُ شَيۡبٗا","m":"انْتَشَرَ الشَّيبُ في رَأسِي."},{"w":"شَقِيّٗا","m":"مَحْرُوماً مِن إِجابَةِ الدُّعاءِ."}],"5":[{"w":"ٱلۡمَوَٰلِيَ","m":"العَصَبَةَ وأقْرَبَ القَرَابَةِ."},{"w":"عَاقِرٗا","m":"التي لا تَلِدُ."},{"w":"وَلِيّٗا","m":"وَلَداً وَارِثاً ومُعِيناً."}],"6":[{"w":"يَرِثُنِي","m":"يَرِثُ نُبُوَّتي."},{"w":"رَضِيّٗا","m":"مَرْضِيّاً عِنْدَكَ وَعِنْدَ عِبَادِكَ."}],"7":[{"w":"سَمِيّٗا","m":"مُسَمّىً باسْمِه."}],"8":[{"w":"أَنَّىٰ","m":"كيفَ؟"},{"w":"عِتِيّٗا","m":"النِّهايةَ في كِبَر السِّنِّ."}],"9":[{"w":"هَيِّنٞ","m":"سَهْلٌ."},{"w":"وَلَمۡ تَكُ شَيۡـٔٗا","m":"ولم تَكُ شيئاً مَذْكُوراً ولا مَوْجُوداً."}],"10":[{"w":"ءَايَةٗ","m":"علامةً."},{"w":"سَوِيّٗا","m":"صَحِيحاً مُعَافىً."}],"11":[{"w":"ٱلۡمِحۡرَابِ","m":"المُصَلَّى."},{"w":"بُكۡرَةٗ وَعَشِيّٗا","m":"صَباحاً ومَسَاءً."}],"12":[{"w":"ٱلۡكِتَٰبَ","m":"أي: التَّوْرَاةَ."},{"w":"بِقُوَّةٖ","m":"بجِدٍّ واجْتِهَادٍ."},{"w":"ٱلۡحُكۡمَ","m":"الحِكْمَةَ وحُسنَ الفَهْمِ."},{"w":"صَبِيّٗا","m":"صغيرَ السِّنِّ."}],"13":[{"w":"حَنَانٗا","m":"رَحْمَةً ومحبةً."},{"w":"وَزَكَوٰةٗ","m":"طَهَارةً مِنَ الذُّنُوبِ."},{"w":"تَقِيّٗا","m":"خائفاً مِنَ اللهِ، ومُطِيعاً لَه."}],"14":[{"w":"بَرَّۢا","m":"بَارّاً ومُطيعاً."},{"w":"جَبَّارًا","m":"مُتَكَبِّراً عَنْ طاعةِ ربِّه، وطاعةِ والدَيْه."},{"w":"عَصِيّٗا","m":"عاصِياً لِرَبِّه وَلِوالِدَيْه."}],"16":[{"w":"فِي ٱلۡكِتَٰبِ","m":"في هَذا القُرْآنِ."},{"w":"ٱنتَبَذَتۡ","m":"تباعَدَتْ واعْتَزَلَتْ."},{"w":"شَرۡقِيّٗا","m":"مَكَاناً مِمَّا يلِي الشَّرقَ عَنْ أَهْلِها."}],"17":[{"w":"رُوحَنَا","m":"أي: جِبْرِيلَ عليهِ السَّلامُ."},{"w":"فَتَمَثَّلَ لَهَا بَشَرٗا","m":"تصَوَّرَ لَها في صُورَةِ إنْسَانٍ."},{"w":"سَوِيّٗا","m":"تامَّ الخَلْقِ."}],"18":[{"w":"أَعُوذُ بِٱلرَّحۡمَٰنِ","m":"ألْتَجِئُ وأَسْتَجِيرُ بالرَّحمنِ."}],"19":[{"w":"زَكِيّٗا","m":"طاهِراً مِنَ الذُّنوبِ."}],"20":[{"w":"أَنَّىٰ","m":"كيفَ؟"},{"w":"لَمۡ يَمۡسَسۡنِي بَشَرٞ","m":"لم يَمَسَّني بَشَرٌ بِنِكَاحٍ حَلَالٍ."},{"w":"بَغِيّٗا","m":"زانيةً."}],"21":[{"w":"ءَايَةٗ","m":"علامةً تَدُلُّ على قُدْرَةِ اللهِ."},{"w":"رَحۡمَةٗ مِّنَّا","m":"جَعَلَه اللهُ رحمةً لأمِّه ولِمَن آمَنَ به."},{"w":"مَقۡضِيّٗا","m":"قَضاءً سابِقاً مُقَدَّراً."}],"22":[{"w":"فَٱنتَبَذَتۡ","m":"فتباعَدَتْ."}],"23":[{"w":"نَسۡيٗا مَّنسِيّٗا","m":"شَيْئاً لا يُعْرَفُ ولا يُذكَرُ."}],"24":[{"w":"فَنَادَىٰهَا","m":"أي: جبريلُ أو عِيسى."},{"w":"سَرِيّٗا","m":"جَدْوَلَ ماءٍ."}],"25":[{"w":"هُزِّيٓ","m":"حَرِّكِي."}],"26":[{"w":"وَقَرِّي عَيۡنٗا","m":"وطِيبِي نَفْساً بِمَولُودِكِ."},{"w":"نَذَرۡتُ","m":"أوْجَبْتُ على نَفْسِي."},{"w":"صَوۡمٗا","m":"سُكُوتاً."},{"w":"إِنسِيّٗا","m":"أَحَداً مِنَ النَّاسِ."}],"27":[{"w":"شَيۡـٔٗا فَرِيّٗا","m":"أمْراً عَظِيماً مُفْتَرَىً."}],"28":[{"w":"يَٰٓأُخۡتَ هَٰرُونَ","m":"يا أُخْتَ الرَّجلِ الصَّالحِ هارُونَ."},{"w":"ٱمۡرَأَ سَوۡءٖ","m":"رَجُلَ سَوْءٍ يأتي الفَوَاحِشَ."},{"w":"بَغِيّٗا","m":"زَانيةً."}],"29":[{"w":"ٱلۡمَهۡدِ","m":"ما يُهَيَّأ للرَّضِيعِ مِن فِراشٍ ونَحْوِه."},{"w":"صَبِيّٗا","m":"طِفْلاً رَضِيعاً."}],"30":[{"w":"ٱلۡكِتَٰبَ","m":"الإنْجِيلَ."}],"31":[{"w":"مُبَارَكًا","m":"عَظِيمَ الْخيرِ والنَّفْعِ"},{"w":"مَا دُمۡتُ حَيّٗا","m":"ما بَقِيِتُ حَيّاً."}],"32":[{"w":"بَرَّۢا","m":"بَارّاً ومُطِيعاً."},{"w":"جَبَّارٗا","m":"مُتَكَبِّراً."},{"w":"شَقِيّٗا","m":"عَاصِياً لِربِّي."}],"33":[{"w":"وَيَوۡمَ أُبۡعَثُ حَيّٗا","m":"أي: يَوْمَ الْقِيَامةِ."}],"34":[{"w":"فِيهِ يَمۡتَرُونَ","m":"يَشُكُّ فيه اليهودُ والنَّصَارَىٰ ويُجَادِلُونَ."}],"35":[{"w":"مَا كَانَ","m":"ما يَنْبَغِي وَلَا يَلِيقُ."},{"w":"سُبۡحَٰنَهُۥٓ","m":"تَقَدَّسَ وتَنَزَّهَ عَن ذَلِكَ."},{"w":"قَضَىٰٓ","m":"أَرَادَ."},{"w":"فَيَكُونُ","m":"أي: كَمَا أرَادَه."}],"36":[{"w":"هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ","m":"هَذَا طريقٌ لا اعْوِجَاجَ فِيه."}],"37":[{"w":"ٱلۡأَحۡزَابُ","m":"الفِرَقُ مِنْ أَهْلِ الْكِتَابِ."},{"w":"فَوَيۡلٞ","m":"فهَلاكٌ."},{"w":"مَشۡهَدِ","m":"شُهُودِ."},{"w":"يَوۡمٍ عَظِيمٍ","m":"يومِ القِيامَةِ."}],"38":[{"w":"أَسۡمِعۡ بِهِمۡ وَأَبۡصِرۡ","m":"ما أقدَرَهم على السَّمعِ والبَصَرِ يوم القيامةِ!"},{"w":"فِي ضَلَٰلٖ مُّبِينٖ","m":"في انْحِرَافٍ واضحٍ عَن سَبيلِ الحقِّ."}],"39":[{"w":"يَوۡمَ ٱلۡحَسۡرَةِ","m":"يومَ النَّدامةِ على ما فرَّطُوا في جَنْبِ اللهِ."}],"41":[{"w":"صِدِّيقٗا","m":"عَظِيمَ الصِّدقِ."}],"42":[{"w":"وَلَا يُغۡنِي","m":"ولا يَدْفَعُ."}],"43":[{"w":"أَهۡدِكَ","m":"أُرْشِدْكَ."},{"w":"صِرَٰطٗا سَوِيّٗا","m":"طريقاً مُسْتَوياً لا اعْوِجَاجَ فيه."}],"44":[{"w":"لَا تَعۡبُدِ ٱلشَّيۡطَٰنَ","m":"لا تُطِعِ الشَّيطانَ في عِبادةِ الأصْنام."},{"w":"عَصِيّٗا","m":"مُخَالِفاً مُسْتكْبِراً عَن طاعَةِ اللهِ."}],"45":[{"w":"لِلشَّيۡطَٰنِ وَلِيّٗا","m":"قَرِيناً لَه في اللَّعنةِ، وقريباً منه في النَّار."}],"46":[{"w":"أَرَاغِبٌ أَنتَ عَنۡ ءَالِهَتِي","m":"أَمُعْرِضٌ أنت عَن عِبادَةِ آلِهَتِي."},{"w":"لَأَرۡجُمَنَّكَ","m":"لَأَقْتُلَنَّك رَمْياً بِالْحِجارَةِ."},{"w":"مَلِيّٗا","m":"زَماناً طَوِيلاً مِنَ الدَّهْرِ."}],"47":[{"w":"سَلَٰمٌ عَلَيۡكَ","m":"تحيةُ تَودِيعٍ ومُتَارَكَةٍ، أي: تَسْلَمُ ممَّا تَكْرَهُه مِنِّي."},{"w":"بِي حَفِيّٗا","m":"كَثيرَ البِرِّ واللُّطْفِ."}],"48":[{"w":"وَأَعۡتَزِلُكُمۡ","m":"وأُفارِقُكُم."},{"w":"شَقِيّٗا","m":"مَحْرُوماً مِنْ إجابَةِ الدُّعاءِ."}],"50":[{"w":"لِسَانَ صِدۡقٍ","m":"ثَناءً حَسَناً."},{"w":"عَلِيّٗا","m":"رفيعَ القَدْرِ باقياً في النَّاسِ."}],"51":[{"w":"مُخۡلَصٗا","m":"مُخْتاراً لِرِسالتِه."}],"52":[{"w":"ٱلطُّورِ","m":"جَبَلِ طُورِ سَيناءَ."},{"w":"وَقَرَّبۡنَٰهُ نَجِيّٗا","m":"فشَرَّفْناه بِمُناجاتِنا وتَكْلِيمِنا إيَّاه سرّاً."}],"56":[{"w":"صِدِّيقٗا","m":"عظيمَ الصِّدقِ في قولِه وعَمَلِه."}],"57":[{"w":"وَرَفَعۡنَٰهُ","m":"أي: ذِكْرَه ومَنْزِلَتَه، قيل: إنَّه رُفِعَ إلى السَّماءِ الرابعةِ."},{"w":"عَلِيًّا","m":"رفيعَ القَدْرِ، أو ذا مَكانٍ عالٍ في السَّماءِ."}],"58":[{"w":"وَٱجۡتَبَيۡنَآ","m":"واصْطَفَينا للرِّسالةِ والنُّبوَّةِ."},{"w":"خَرُّواْ","m":"وَقَعُوا."},{"w":"وَبُكِيّٗا","m":"وباكِينَ مِنْ خَشْيَتِه سُبْحَانَه وتَعالَى."}],"59":[{"w":"فَخَلَفَ مِنۢ بَعۡدِهِمۡ","m":"فجاءَ بَعْدَهُم."},{"w":"خَلۡفٌ","m":"أتْبَاعُ سُوءٍ."},{"w":"غَيًّا","m":"جَزاءَ الغَيِّ، أو وَادِياً في جَهَنَّمَ."}],"61":[{"w":"جَنَّٰتِ عَدۡنٍ","m":"جناتِ خُلْدٍ وإقامَةٍ دَائِمةٍ."},{"w":"بِٱلۡغَيۡبِ","m":"أي: غائبةً عَنْهم لا يُشاهِدُونها."},{"w":"مَأۡتِيّٗا","m":"آتِياً لا مَحالةَ."}],"62":[{"w":"لَغۡوًا","m":"كَلاماً باطِلاً."},{"w":"بُكۡرَةٗ وَعَشِيّٗا","m":"أي: على مِقْدارِ ما يَعرِفُونَ من الغَداءِ والعَشَاءِ، وإلَّا فليسَ في الجنَّةِ بُكْرَةٌ ولا عَشِيَّةٌ."}],"63":[{"w":"نُورِثُ","m":"نُعْطِي."}],"64":[{"w":"وَمَا نَتَنَزَّلُ","m":"أي: نَحْنُ الملائكةُ مِنَ السَّماءِ إلى الأرضِ."},{"w":"لَهُۥ مَا بَيۡنَ أَيۡدِينَا","m":"مما يُسْتَقْبَلُ مِنْ أُمُورِ الآخِرَةِ."},{"w":"وَمَا خَلۡفَنَا","m":"مِمَّا مَضَى مِنْ أُمُورِ الدُّنْيا."},{"w":"وَمَا بَيۡنَ ذَٰلِكَ","m":"وَمَا بَيْنَ الدُّنْيا والآخِرةِ."},{"w":"نَسِيّٗا","m":"ناسِياً لشيءٍ مِنَ الأشياءِ."}],"65":[{"w":"وَٱصۡطَبِرۡ لِعِبَٰدَتِهِۦ","m":"واثْبُتْ عَلى طاعةِ الله بِصَبْرٍ ومُوَاظَبَةٍ."},{"w":"سَمِيّٗا","m":"مُماثِلاً في ذَاتِه وَأَسْمائِه وصِفاتِه وأفعالِه."}],"68":[{"w":"لَنَحۡشُرَنَّهُمۡ","m":"لَنَجْمَعَنَّ هَؤلاءِ المُنْكِرِينَ لِلبَعْثِ يومَ القيامةِ."},{"w":"جِثِيّٗا","m":"بارِكِينَ على رُكَبِهِم."}],"69":[{"w":"ثُمَّ لَنَنزِعَنَّ","m":"ثم لَنَأخُذَنَّ."},{"w":"شِيعَةٍ","m":"طائِفَةٍ."},{"w":"عِتِيّٗا","m":"تَمرُّداً وعِصْياناً للهِ تَعالى."}],"70":[{"w":"هُمۡ أَوۡلَىٰ بِهَا صِلِيّٗا","m":"هُم أَوْلى بجَهَنَّمَ دُخُولاً."}],"71":[{"w":"إِلَّا وَارِدُهَا","m":"إلَّا واردٌ النارَ بالمُرُورِ على الصِّراطِ المنْصُوبِ على مَتْنِ جَهَنَّمَ."},{"w":"حَتۡمٗا مَّقۡضِيّٗا","m":"أَمْراً مَحْتُوماً قُضِيَ وحُكِمَ أنَّه لابُدَّ مِن وُقُوعِه."}],"72":[{"w":"وَنَذَرُ","m":"ونَتْرُكُ."}],"73":[{"w":"خَيۡرٞ مَّقَامٗا","m":"أَفْضَلُ مَنْزِلاً."},{"w":"وَأَحۡسَنُ نَدِيّٗا","m":"وأَحْسَنُ مَجْلِساً."}],"74":[{"w":"مِن قَرۡنٍ","m":"مِنْ أُمَمٍ."},{"w":"هُمۡ أَحۡسَنُ أَثَٰثٗا وَرِءۡيٗا","m":"أَحْسنُ مَتاعاً مِنْهُم، وأَجْمَلُ مَنْظَراً."}],"75":[{"w":"فَلۡيَمۡدُدۡ","m":"فَلْيُمْهِلْهُ اسْتِدْرَاجاً."},{"w":"هُوَ شَرّٞ مَّكَانٗا","m":"شرٌّ مَسْكَناً ومُسْتَقَرّاً."},{"w":"وَأَضۡعَفُ جُندٗا","m":"وأَضْعَفُ قوةً وَرِجالاً."}],"76":[{"w":"وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ","m":"أَعمالُ الخيرِ."},{"w":"وَخَيۡرٞ مَّرَدًّا","m":"وخيرٌ مَرْجِعاً وَعاقِبَةً."}],"77":[{"w":"لَأُوتَيَنَّ","m":"لَأُعْطَينَّ في الآخِرَةِ."}],"78":[{"w":"أَطَّلَعَ ٱلۡغَيۡبَ","m":"أعَلِمَ الغَيبَ؟"},{"w":"عَهۡدٗا","m":"أي: عَهْداً بِدُخُولِ الجنَّةِ."}],"79":[{"w":"وَنَمُدُّ لَهُۥ","m":"ونَزِيدُه في الآخِرَةِ."}],"80":[{"w":"وَنَرِثُهُۥ","m":"أي: بَعْدَ هَلاكِه فيَصِيرُ لنا مالُه وولدُه."}],"81":[{"w":"عِزّٗا","m":"شُفَعَاءَ وأنْصَاراً يَتَعزَّزُونَ بِهِم."}],"82":[{"w":"وَيَكُونُونَ عَلَيۡهِمۡ ضِدًّا","m":"وتَكُونُ هذه الآلهةُ مُخَالِفةً لهم تُخاصِمُهُم، على عَكْسِ ما كانُوا يَرْجُونَه مِنْ هَؤلاءِ."}],"83":[{"w":"تَؤُزُّهُمۡ","m":"تُهَيِّجُ الكَافِرِينَ وتَدْفَعُهُم إلى المَعاصِي."}],"84":[{"w":"نَعُدُّ لَهُمۡ","m":"نُحْصِي أَعْمالَهم وَأَعمارَهُم."}],"85":[{"w":"وَفۡدٗا","m":"قادِمِينَ على اللهِ مُكْرَمِينَ."}],"86":[{"w":"وَنَسُوقُ ٱلۡمُجۡرِمِينَ","m":"أي: نَحُثُّهم على السَّيرِ، ونَطْرُدُهم كما تُطْرَدُ البَهَائِمُ"},{"w":"وِرۡدٗا","m":"عِطاشاً."}],"89":[{"w":"شَيۡـًٔا إِدّٗا","m":"شَيئاً عَظِيماً مُنْكَراً."}],"90":[{"w":"يَتَفَطَّرۡنَ مِنۡهُ","m":"يَتَشَقَّقْنَ ويَتَفَتَّتْنَ مِن شَناعَتِه."},{"w":"وَتَنشَقُّ","m":"وتَتَصَدَّعُ."},{"w":"وَتَخِرُّ ٱلۡجِبَالُ","m":"أي: تَسْقُطُ وتَنْهَدِمُ."},{"w":"هَدًّا","m":"أي: مَهْدُودَةً ومَكْسُورَةً."}],"96":[{"w":"وُدّٗا","m":"حُبّاً في قُلُوبِ عِبَادِه."}],"97":[{"w":"لُدّٗا","m":"شَدِيدِي الخُصُومَةِ بالباطِل."}],"98":[{"w":"مِن قَرۡنٍ","m":"مِنْ أُمَمٍ."},{"w":"رِكۡزَۢا","m":"صَوْتاً خَفِيّاً."}]}