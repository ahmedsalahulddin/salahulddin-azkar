{"1":[{"w":"وَجَعَلَ ٱلظُّلُمَٰتِ وَٱلنُّورَ","m":"وخَلَقَ سَوادَ الليلِ وضياءَ النهارِ."},{"w":"يَعۡدِلُونَ","m":"يُشْرِكُون."}],"2":[{"w":"خَلَقَكُم","m":"خَلَقَ أباكم آدمَ."},{"w":"قَضَىٰٓ أَجَلٗا","m":"قَدَّر مُدَّةَ بقائِكم في الدنيا."},{"w":"وَأَجَلٞ مُّسَمًّى عِندَهُۥ","m":"وقَدَّر أجلاً محدَّداً هو يومُ القِيامةِ."},{"w":"تَمۡتَرُونَ","m":"تَشُكُّون في أمرِ الساعةِ."}],"3":[{"w":"سِرَّكُمۡ وَجَهۡرَكُمۡ","m":"ما تُخْفُونه، وما تُعْلِنُونه."},{"w":"مَا تَكۡسِبُونَ","m":"جميعَ أعمالِكم."}],"4":[{"w":"مِنۡ ءَايَةٖ","m":"من دليلٍ على أنَّ اللهَ حقُّ."}],"5":[{"w":"أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","m":"أخبارُ ما استَهْزَؤُوا به، وهو القرآنُ، أو محمدٌ ﷺ."}],"6":[{"w":"مِن قَرۡنٖ","m":"من أُمَّةٍ مُكَذِّبَةٍ."},{"w":"مَا لَمۡ نُمَكِّن لَّكُمۡ","m":"ما لم نُعْطِكم، كطُولِ الأعمارِ، وقوةِ الأبدانِ."},{"w":"مِدۡرَارٗا","m":"مطراً كثيراً."},{"w":"قَرۡنًا ءَاخَرِينَ","m":"أُمَماً أخرى."}],"7":[{"w":"كِتَٰبٗا فِي قِرۡطَاسٖ","m":"كتاباً مكتوباً في صحيفةٍ."}],"8":[{"w":"مَلَكٗا","m":"أي: لِيُصَدِّقَه، ويُنْذِرَ معه."},{"w":"لَقُضِيَ ٱلۡأَمۡرُ","m":"بإهلاكِهم، والمعاجَلَةِ بعقوبتِهم."},{"w":"لَا يُنظَرُونَ","m":"لا يُمْهَلُون للتوبةِ."}],"9":[{"w":"وَلَوۡ جَعَلۡنَٰهُ","m":"ولو جَعَلْنا الرسولَ المُرْسَلَ إلى النبيِّ ﷺ."},{"w":"وَلَلَبَسۡنَا عَلَيۡهِم مَّا يَلۡبِسُونَ","m":"ولَكان الأمرُ مختلِطاً عليهم بسببِ ما لَبَسُوه على أنفسِهم."}],"10":[{"w":"فَحَاقَ","m":"فَنَزَل وأحاطَ."},{"w":"مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","m":"هو العذابُ الذي كانوا يستنكرونه."}],"13":[{"w":"مَا سَكَنَ","m":"ما استقرَّ."}],"14":[{"w":"وَلِيّٗا","m":"مَعْبُوداً."},{"w":"فَاطِرِ","m":"خالقِ."},{"w":"أَسۡلَمَ","m":"انقادَ واستسلمَ."}],"16":[{"w":"مَن يُصۡرَفۡ عَنۡهُ","m":"أي: العذابُ."}],"18":[{"w":"ٱلۡقَاهِرُ","m":"الغالِبُ."}],"19":[{"w":"وَمَنۢ بَلَغَ","m":"كلَّ مَنْ بَلَغَه."}],"22":[{"w":"أَيۡنَ شُرَكَآؤُكُمُ","m":"أين آلهتُكم لينفعُوكُم؟"}],"23":[{"w":"فِتۡنَتُهُمۡ","m":"جوابُهم حين يُخْتَبَرُون بهذا السؤالِ."}],"24":[{"w":"وَضَلَّ عَنۡهُم","m":"وغابَ عنهم."},{"w":"مَا كَانُواْ يَفۡتَرُونَ","m":"ما كانوا يعتقدونه مِنْ نَفْعِ آلهتِهم لَهُمْ."}],"25":[{"w":"أَكِنَّةً","m":"أغْطِيةً فلا تفقهُ القرآنَ فِقْهَ انتفاعٍ به."},{"w":"وَقۡرٗا","m":"ثِقَلاً، وصَمَماً."},{"w":"يُجَٰدِلُونَكَ","m":"يُخاصِمُونك."},{"w":"أَسَٰطِيرُ","m":"ما سَطَّرُوه من الأباطيلِ."}],"26":[{"w":"يَنۡهَوۡنَ عَنۡهُ","m":"يَنْهَون الناسَ عن اتِّباع محمدٍ ﷺ."},{"w":"وَيَنۡـَٔوۡنَ عَنۡهُ","m":"ويَبْتَعِدُون عنه."}],"27":[{"w":"وُقِفُواْ","m":"حُبِسُوا."},{"w":"نُرَدُّ","m":"إلى الدُّنيا."}],"28":[{"w":"بَدَا","m":"ظَهَرَ."},{"w":"مَا كَانُواْ يُخۡفُونَ","m":"أي: عن أَتْباعهِم من أَمْرِ البعثِ، وصِدْقِ الرُّسُلِ."},{"w":"لَكَٰذِبُونَ","m":"في أنهم لو عادُوا إلى الدنيا لآمَنوا."}],"29":[{"w":"بِمَبۡعُوثِينَ","m":"بعد الموتِ."}],"30":[{"w":"وُقِفُواْ","m":"حُبِسوا."},{"w":"هَٰذَا","m":"أي: البعثُ الذي كنتم تُنْكِرونه."}],"31":[{"w":"ٱلسَّاعَةُ","m":"يومُ القيامةِ."},{"w":"عَلَىٰ مَا فَرَّطۡنَا فِيهَا","m":"على ما قَدَّمْناه في حياتِنا الدُّنيا."},{"w":"أَوۡزَارَهُمۡ","m":"ذنوبَهم."},{"w":"يَزِرُونَ","m":"يَحْمِلون."}],"33":[{"w":"لَا يُكَذِّبُونَكَ","m":"في قَرارةِ أنفسِهم، بل يعتقدون صِدْقَك."}],"34":[{"w":"لِكَلِمَٰتِ ٱللَّهِ","m":"لِآياتِه التي وَعَدَ فيها النبيَّ ﷺ بالنصرِ."}],"35":[{"w":"نَفَقٗا","m":"مَنْفَذاً، وسَرَباً."},{"w":"سُلَّمٗا","m":"دَرَجاً تَرْتقي عليه."},{"w":"فَتَأۡتِيَهُم بِـَٔايَةٖ","m":"بغيرِ ما جِئْنا به."}],"36":[{"w":"يَسۡمَعُونَ","m":"سَماعَ تَفَهُّمٍ وقَبُولٍ لما يُلْقَى إلَيْهِمْ."},{"w":"وَٱلۡمَوۡتَىٰ","m":"هم الكفارُ."}],"37":[{"w":"لَوۡلَا","m":"هَلَّا."},{"w":"ءَايَةٞ","m":"علامةٌ تَدُلُّ على صِدْقِه، وتَضْطَرُّهُمْ إلى الإيمانِ."},{"w":"لَا يَعۡلَمُونَ","m":"أي: إنَّ الإنزالَ يكونُ وَفْقَ حِكْمَتِه تعالى."}],"38":[{"w":"أُمَمٌ","m":"جماعاتٌ متجانِسَةٌ في الخَلْقِ والرِّزقِ."},{"w":"مَا فَرَّطۡنَا","m":"ما أغفَلْنا."},{"w":"ٱلۡكِتَٰبِ","m":"اللوحِ المحفوظِ."}],"39":[{"w":"صُمّٞ","m":"لا يَسْمَعُون ما ينفَعُهم."},{"w":"وَبُكۡمٞ","m":"لا يتكلَّمُون بالحقِّ."},{"w":"فِي ٱلظُّلُمَٰتِ","m":"في ظلماتِ الكفرِ، والحَيْرةِ."},{"w":"صِرَٰطٖ","m":"طريقٍ."}],"40":[{"w":"أَرَءَيۡتَكُمۡ","m":"أَخْبرُوني."},{"w":"عَذَابُ ٱللَّهِ","m":"في الدُّنيا."},{"w":"إِن كُنتُمۡ صَٰدِقِينَ","m":"أي: في أنَّ آلهتَكُم تنفَعُ، أو تضرُّ."}],"41":[{"w":"وَتَنسَوۡنَ مَا تُشۡرِكُونَ","m":"وتَتْرُكون آلهتَكم."}],"42":[{"w":"بِٱلۡبَأۡسَآءِ","m":"شِدَّةِ الفَقْر والضِّيق في المعِيشَةِ."},{"w":"وَٱلضَّرَّآءِ","m":"الأَمْراضِ في الأبدانِ."},{"w":"يَتَضَرَّعُونَ","m":"يَتَذَلَّلُون لربِّهم."}],"43":[{"w":"فَلَوۡلَآ","m":"فَهَلَّا."},{"w":"بَأۡسُنَا","m":"بَلاؤُنا."}],"44":[{"w":"أَبۡوَٰبَ كُلِّ شَيۡءٍ","m":"من الخيرِ كالرِّزْقِ والعافيةِ؛ استدراجاً منَّا."},{"w":"بَغۡتَةٗ","m":"فَجأة."},{"w":"مُبۡلِسُونَ","m":"يائِسون من كلِّ خيرٍ."}],"45":[{"w":"فَقُطِعَ دَابِرُ ٱلۡقَوۡمِ","m":"فاسْتُؤصِلُوا جميعاً."}],"46":[{"w":"وَخَتَمَ عَلَىٰ قُلُوبِكُم","m":"وطَبَعَ عليها."},{"w":"بِهِ","m":"بذلك المأخوذِ منكم."},{"w":"نُصَرِّفُ ٱلۡأٓيَٰتِ","m":"نَجِيءُ بالحُجَجِ على وجوهٍ متعددةٍ."},{"w":"يَصۡدِفُونَ","m":"يُعْرِضُون."}],"47":[{"w":"بَغۡتَةً","m":"من غيرِ مُقَدِّماتٍ."},{"w":"جَهۡرَةً","m":"بعد مُقَدِّماتٍ تَدُلُّ عليه."}],"49":[{"w":"يَفۡسُقُونَ","m":"يَخْرُجُون عن طاعةِ اللهِ."}],"50":[{"w":"وَلَآ أَعۡلَمُ ٱلۡغَيۡبَ","m":"أي: فأُخْبِرَكم بما سيكونُ مستقبلاً."},{"w":"ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ","m":"الضالُّ والمهتدي."}],"51":[{"w":"وَأَنذِرۡ بِهِ","m":"وأعْلِمْ، وخَوِّفْ -أيها الرسولُ- بالقرآنِ."},{"w":"وَلِيّٞ","m":"ناصرٌ يَنْصُرُهم."},{"w":"وَلَا شَفِيعٞ","m":"يَشْفَعُ لهم من دونِ اللهِ."}],"52":[{"w":"وَلَا تَطۡرُدِ ٱلَّذِينَ","m":"ولا تُبْعِدْ عن مَجالسِك الضُّعفاءَ؛ موافَقَةً لمن طَلَبَ منك."},{"w":"بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ","m":"أولِ النهار وآخرِه."}],"53":[{"w":"فَتَنَّا","m":"ابتَلَيْنا عبادَنا باختلافِ حظوظِهم في الرِّزْقِ والشَّرَفِ الدُّنيَوِيِّ؛ لِيَظْهَرَ سَيِّئُ الخُلُق الَّذي يَتَكَبَّر عن قَبُولِ حقٍّ سَبَق إليه ضُعَفاء."},{"w":"لِيَقُولُوٓاْ","m":"ليقولَ الكافرون الأغنياءُ."},{"w":"أَهَٰٓؤُلَآءِ","m":"الضعفاءُ من المسلمين."},{"w":"مَنَّ ٱللَّهُ عَلَيۡهِم","m":"أي: بالهدايةِ دونَنا."}],"54":[{"w":"ٱلَّذِينَ يُؤۡمِنُونَ","m":"يُصَدِّ