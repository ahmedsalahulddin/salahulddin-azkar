m":"فَكِّرُوا في قُدْرَةِ خالقهِ."},{"w":"وَيَنۡعِهِۦٓ","m":"ونُضْجِه."}],"100":[{"w":"وَخَرَقُواْ","m":"واختَلَقُوا، ونَسَبُوا."}],"101":[{"w":"بَدِيعُ","m":"مُبْدِعٌ على غيرِ مثالٍ سَبَقَ."},{"w":"أَنَّىٰ","m":"كيف؟"}],"102":[{"w":"وَكِيلٞ","m":"رقيبٌ مُدَبِّرٌ لأمورِ خَلْقِه."}],"103":[{"w":"لَا تُدۡرِكُهُ","m":"لا تُحيطُ به، ولا تَبْلُغُ كُنْهَ حَقيقتِه."}],"104":[{"w":"بَصَآئِرُ","m":"براهينُ واضحةٌ."},{"w":"فَعَلَيۡهَا","m":"فعلى نفسِه يعودُ وَبالُ ذلك."},{"w":"بِحَفِيظٖ","m":"أُحْصِي أعمالَكم، بل أنا مُبَلِّغٌ."}],"105":[{"w":"نُصَرِّفُ ٱلۡأٓيَٰتِ","m":"نُبَيِّنُ البراهينَ والحُجَجَ."},{"w":"وَلِيَقُولُواْ دَرَسۡتَ","m":"أي: لتقومَ الحُجَّةُ عليهم، وليقولوا: تَعَلَّمْتَ من أهلِ الكتابِ."}],"107":[{"w":"حَفِيظٗا","m":"رقيباً تحفَظُ أقوالَهم وأعمالَهم."},{"w":"بِوَكِيلٖ","m":"مُوَكَّلٍ على أمورِهم."}],"108":[{"w":"ٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ","m":"هم الأصنامُ."},{"w":"عَدۡوَۢا","m":"اعتداءً."},{"w":"زَيَّنَّا","m":"حَسَّنَّا."}],"109":[{"w":"جَهۡدَ أَيۡمَٰنِهِمۡ","m":"بأيمانٍ مُؤَكَّدةٍ."},{"w":"ءَايَةٞ","m":"معجزةٌ خارقةٌ."},{"w":"وَمَا يُشۡعِرُكُمۡ","m":"وما يُدْريكم."},{"w":"أَنَّهَآ","m":"لعلَّ المعجزاتِ."}],"110":[{"w":"وَنُقَلِّبُ أَفۡـِٔدَتَهُمۡ","m":"فنَحُولُ بينَهم وبينَ الإيمانِ."},{"w":"فِي طُغۡيَٰنِهِمۡ","m":"في تَمَرُّدِهم."},{"w":"يَعۡمَهُونَ","m":"يَتَحَيَّرون، فلا يَهْتَدُون إلى الحقِّ."}],"111":[{"w":"وَحَشَرۡنَا","m":"وجَمَعْنا."},{"w":"قُبُلٗا","m":"فعايَنُوه مُواجَهةً."}],"112":[{"w":"شَيَٰطِينَ ٱلۡإِنسِ","m":"هم المَرَدَةُ العُتاةُ من الإنسِ."},{"w":"زُخۡرُفَ ٱلۡقَوۡلِ","m":"هو القولُ المُزَيَّنُ."},{"w":"غُرُورٗا","m":"ليَغْتَرَّ به سامِعُه."},{"w":"وَمَا يَفۡتَرُونَ","m":"وما يَخْتَلِقُونه من كَذِبٍ."}],"113":[{"w":"وَلِتَصۡغَىٰٓ إِلَيۡهِ","m":"ولتَمِيلَ إلى القولِ المُزَيَّنِ."},{"w":"وَلِيَقۡتَرِفُواْ","m":"ولِيكْتَسِبُوا من الأعمالِ السيئةِ."}],"114":[{"w":"أَبۡتَغِي","m":"أَطْلُبُ."},{"w":"ٱلۡمُمۡتَرِينَ","m":"الشَّاكِّين."}],"115":[{"w":"كَلِمَتُ رَبِّكَ","m":"القرآنُ الكريمُ."},{"w":"لَا مُبَدِّلَ لِكَلِمَٰتِهِۦ","m":"لا