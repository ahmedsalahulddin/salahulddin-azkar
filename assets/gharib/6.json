نِّ هم الذين يُنْذِرُون قومَهم."},{"w":"وَغَرَّتۡهُمُ","m":"وخَدَعَتْهم زِينتُها؛ فاطمأنُّوا إليها."}],"131":[{"w":"بِظُلۡمٖ","m":"بسببِ ظُلْمِ مَنْ يَظْلِمُ."},{"w":"وَأَهۡلُهَا غَٰفِلُونَ","m":"أي: لا يُهلِكُهم إلا بعد إرسالِ الرسل، وارتفاعِ الغفلةِ عنهم بذلك، وتَحَقُّقِ الإنذارِ."}],"132":[{"w":"دَرَجَٰتٞ","m":"مراتبُ."}],"133":[{"w":"كَمَآ أَنشَأَكُم مِّن ذُرِّيَّةِ قَوۡمٍ ءَاخَرِينَ","m":"أَحْدَثَكم من نَسْلِ خَلْقٍ آخرين كانوا قبلَكم."}],"134":[{"w":"بِمُعۡجِزِينَ","m":"بفائتين عَمَّا هو نازلٌ بكم."}],"135":[{"w":"مَكَانَتِكُمۡ","m":"طريقتِكم، فاثبُتُوا عليها."},{"w":"عَٰقِبَةُ ٱلدَّارِ","m":"الجنةُ."}],"136":[{"w":"ذَرَأَ","m":"خَلَقَ."},{"w":"ٱلۡحَرۡثِ","m":"ثمراتِ الزَّرْعِ."},{"w":"لِشُرَكَآئِنَا","m":"للأصنامِ التي يعبُدونها."}],"137":[{"w":"قَتۡلَ أَوۡلَٰدِهِمۡ","m":"وهو دَفْنُ البناتِ وهُنَّ أحياءٌ."},{"w":"شُرَكَآؤُهُمۡ","m":"رؤساؤُهم، وشياطينُهم."},{"w":"لِيُرۡدُوهُمۡ","m":"ليُهْلِكُوهم."},{"w":"وَلِيَلۡبِسُواْ","m":"ولِيَخْلِطُوا."}],"138":[{"w":"وَحَرۡثٌ","m":"وزَرْعٌ."},{"w":"حِجۡرٞ","m":"ممنوعةٌ، فهي لأصنامِهم."},{"w":"حُرِّمَتۡ ظُهُورُهَا","m":"فلا يركبونَها."}],"139":[{"w":"خَالِصَةٞ","m":"حلالٌ."},{"w":"أَزۡوَٰجِنَا","m":"نسائِنا."},{"w":"شُرَكَآءُ","m":"يأكلُ منه الذكورُ والإناثُ."},{"w":"وَصۡفَهُمۡ","m":"جزاءَ وَصْفِهم."}],"140":[{"w":"سَفَهَۢا","m":"طَيشاً."},{"w":"مَا رَزَقَهُمُ","m":"من الأنعام."}],"141":[{"w":"جَنَّٰتٖ مَّعۡرُوشَٰتٖ","m":"بساتينَ مرفوعاتٍ عن الأرض كالعِنَبِ."},{"w":"وَغَيۡرَ مَعۡرُوشَٰتٖ","m":"قائمةً على سُوقِها كالنَّخْلِ، أوما خَرَج في البَرِّ."},{"w":"مُتَشَٰبِهٗا","m":"في المنظرِ."},{"w":"وَغَيۡرَ مُتَشَٰبِهٖ","m":"في الطَّعْمِ."},{"w":"وَءَاتُواْ حَقَّهُۥ","m":"بالزَّكاةِ والصدقات."}],"142":[{"w":"حَمُولَةٗ","m":"مُهَيَّأً للحَمْلِ عليه."},{"w":"وَفَرۡشٗا","m":"صِغارَ الأنعامِ."}],"143":[{"w":"ثَمَٰنِيَةَ أَزۡوَٰجٖ","m":"هذه الأنعامُ ثمانيةُ أصنافٍ، أربعةٌ منها في الغنم، وهي: الضَّأْنُ ذُكوراً وإناثاً، والمَعْزُ ذكوراً وإناثاً، وأربعةٌ في الإبِلِ والبقَرِ، ذكوراً وإناثاً."},{"w":"أَمَّا ٱشۡتَمَلَتۡ عَلَيۡهِ","m":"أي: هل حَرَّمَ ما اشتملت عليه؟ فإن كان التحريمُ منه فإن ذلك يَسْتَلْزِمُ تحريمَ الجميعِ، فلماذا حَلَّلُوا بعضَها، وحَرَّمُوا بعضَها الآخر؟"}],"144":[{"w":"شُهَدَآءَ","m":"حاضِرين."}],"145":[{"w":"مُحَرَّمًا","m":"أي: طعاماً محرَّماً."},{"w":"عَلَىٰ طَاعِمٖ يَطۡعَمُهُۥٓ","m":"على مَنْ يأكلُه."},{"w":"مَسۡفُوحًا","m":"جارياً."},{"w":"رِجۡسٌ","m":"نَجَسٌ."},{"w":"أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦ","m":"هو المذبوحُ الذي ذُكِرَ عليه اسمُ غيرِ اللهِ."},{"w":"فَمَنِ ٱضۡطُرَّ","m":"إلى الأَكْلِ من هذه المحرَّماتِ."},{"w":"غَيۡرَ بَاغٖ","m":"غيرَ طالبٍ بأَكْلِه التلذُّذَ."},{"w":"وَلَا عَادٖ","m":"ولا متجاوزٍ حَدَّ الضَّرورةِ."}],"146":[{"w":"إِلَّا مَا حَمَلَتۡ ظُهُورُهُمَآ","m":"إلا الشَّحْمَ المخالِطَ لظُهورِهما."},{"w":"أَوِ ٱلۡحَوَايَآ","m":"أو المخالِطَ للأمعاءِ."},{"w":"بِبَغۡيِهِمۡ","m":"بأعمالهِم السيئةِ."}],"147":[{"w":"وَلَا يُرَدُّ بَأۡسُهُۥ","m":"ولا يُدْفَعُ عِقابُه إنْ أنْزَلَه بهم."}],"148":[{"w":"وَلَا حَرَّمۡنَا مِن شَيۡءٖ","m":"أي: لو شاءَ ما حَرَّمْنا على أنفسِنا شيئاً من الأنعام."},{"w":"بَأۡسَنَا","m":"عقابَنا."},{"w":"تَخۡرُصُونَ","m":"تَظُنُّون وَتُخَمِّنُون."}],"149":[{"w":"ٱلۡحُجَّةُ ٱلۡبَٰلِغَةُ","m":"هي القاطِعَةُ لشُبَهِهِم، وهذه الحُجَّةُ هي الرُّسُلُ، وما جاؤُوا به من كُتُبٍ، ومعجزاتٍ."}],"150":[{"w":"هَلُمَّ","m":"هاتُوا."},{"w":"حَرَّمَ هَٰذَا","m":"حَرَّم ماحَرَّمْتُم من الأنعام."},{"w":"فَلَا تَشۡهَدۡ","m":"لأنَّ شهادتَهم باطلةٌ."},{"w":"يَعۡدِلُونَ","m":"يُشْرِكون."}],"151":[{"w":"إِمۡلَٰقٖ","m":"فَقْرٍ."},{"w":"مَا ظَهَرَ","m":"ما أُعْلِنَ منها."},{"w":"وَمَا بَطَنَ","m":"ما خَفِيَ منها."}],"152":[{"w":"بِٱلَّتِي هِيَ أَحۡسَنُ","m":"بما يُصْلِحُ مالَه، وينتفعُ به."},{"w":"يَبۡلُغَ أَشُدَّهُۥ","m":"وهو سِنُّ البُلوغِ مع الرُّشْدِ، فادفعُوا إليه ماله."},{"w":"بِٱلۡقِسۡطِ","m":"بالعدلِ."},{"w":"وُسۡعَهَا","m":"طاقَتَها."},{"w":"وَبِعَهۡدِ ٱللَّهِ أَوۡفُواْ","m":"بما عَهِدَ به إليكم من الالتزامِ بشرعِه."}],"153":[{"w":"هَٰذَا صِرَٰطِي","m":"الإسلامُ طريقي."},{"w":"ٱلسُّبُلَ","m":"طُرُقَ الضَّلالِ والبِدَعِ."},{"w":"فَتَفَرَّقَ بِكُمۡ","m":"ف