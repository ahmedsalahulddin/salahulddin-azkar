{"1":[{"w":"وَٱلذَّٰرِيَٰتِ","m":"الرِّياحِ المُثِيرَاتِ للتُّرَابِ."}],"2":[{"w":"فَٱلۡحَٰمِلَٰتِ","m":"فالسُّحُبِ الحامِلاتِ."},{"w":"وِقۡرٗا","m":"ثِقَلاً عَظِيماً مِنَ الماءِ."}],"3":[{"w":"فَٱلۡجَٰرِيَٰتِ","m":"فَالسُّفُنِ الجارِياتِ في البِحارِ."},{"w":"يُسۡرٗا","m":"جَرْياً ذا يُسْرٍ وسُهُولةٍ."}],"4":[{"w":"فَٱلۡمُقَسِّمَٰتِ","m":"فالملائِكةِ المُقَسِّماتِ."},{"w":"أَمۡرًا","m":"أَمْرَ اللهِ في خَلْقِهِ."}],"5":[{"w":"لَصَادِقٞ","m":"لَكائِنٌ حقٌّ يَقِينٌ."}],"6":[{"w":"ٱلدِّينَ","m":"الحِسابَ."},{"w":"لَوَٰقِعٞ","m":"لَكَائِنٌ لَا مَحالةَ."}],"7":[{"w":"ذَاتِ ٱلۡحُبُكِ","m":"ذاتِ الخَلْقِ الحَسَنِ."}],"8":[{"w":"مُخۡتَلِفٖ","m":"مُضْطَرِبٍ."}],"9":[{"w":"يُؤۡفَكُ","m":"يُصْرَفُ."}],"10":[{"w":"قُتِلَ","m":"لُعِنَ."},{"w":"ٱلۡخَرَّٰصُونَ","m":"الكَذّابُونَ الظَّانُّونَ غيرَ الحقِّ."}],"11":[{"w":"غَمۡرَةٖ","m":"لُجَّةٍ مِنَ الكُفْرِ."},{"w":"سَاهُونَ","m":"غافِلُونَ."}],"12":[{"w":"أَيَّانَ","m":"مَتَى."},{"w":"يَوۡمُ ٱلدِّينِ","m":"يومُ الجَزَاءِ."}],"13":[{"w":"يُفۡتَنُونَ","m":"يُعَذَّبُونَ بالإحْرَاقِ بالنَّارِ."}],"14":[{"w":"فِتۡنَتَكُمۡ","m":"عَذَابَكُم"}],"16":[{"w":"ءَاخِذِينَ","m":"قابِلينَ على وَجْهِ الرِّضا."},{"w":"ءَاتَىٰهُمۡ","m":"أعْطاهُم."},{"w":"مُحۡسِنِينَ","m":"فاعِلِينَ الحَسَناتِ والطَّاعاتِ."}],"17":[{"w":"يَهۡجَعُونَ","m":"يَنامُونَ."}],"18":[{"w":"وَبِٱلۡأَسۡحَارِ","m":"جَمْعُ سَحَر، وَهُو آخِرُ الليلِ."}],"19":[{"w":"حَقّٞ","m":"واجِبٌ ثابِتٌ."},{"w":"لِلسَّآئِلِ","m":"الَّذِي يُظْهِرُ فَقْرَهُ، فَيسْأَلُ النَّاسَ."},{"w":"وَٱلۡمَحۡرُومِ","m":"الفَقِيرِ المُتَعَفِّفِ."}],"20":[{"w":"لِلۡمُوقِنِينَ","m":"لِأَهْلِ اليقِينِ بِأنَّ اللهَ وَرَسُولَه حَقٌّ."}],"21":[{"w":"وَفِيٓ أَنفُسِكُمۡ","m":"وَفي خَلْقِ أَنْفُسِكُم دَلَائِلُ وَعِبَرٌ."}],"22":[{"w":"رِزۡقُكُمۡ","m":"مادَّةُ رِزْقِكُم، مِنَ الأمْطارِ، وصُنُوفِ الأقْدَارِ."},{"w":"وَمَا تُوعَدُونَ","m":"مِنَ الجَزاءِ في الدُّنيا والآخِرةِ."}],"23":[{"w":"مِثۡلَ مَآ أَنَّكُمۡ تَنطِقُونَ","m":"فَتَحَقَّقَ الوعِيدُ مِثْلَ نُطْقِكُم الَّذِي لا تَشُكُّونَ فِيهِ."}],"24":[{"w":"ضَيۡفِ إِبۡرَٰهِيمَ","m":"هُم مِن الملائِكةِ."}],"25":[{"w":"سَلَٰمٗا","m":"سَلَّمنا سَلَاما."},{"w":"سَلَٰمٞ","m":"أَمْرِي سَلامٌ لَكُم."},{"w":"مُنكَرُونَ","m":"لا أَعْرِفُهُم."}],"26":[{"w":"فَرَاغَ","m":"فَمَال خِفْيَةً."}],"28":[{"w":"فَأَوۡجَسَ","m":"أَحَسَّ في نَفْسِهِ."},{"w":"بِغُلَٰمٍ عَلِيمٖ","m":"هو إسْحاقُ عَلَيهِ السَّلامُ."}],"29":[{"w":"صَرَّةٖ","m":"صَيْحَةٍ."},{"w":"فَصَكَّتۡ","m":"فَلَطَمَتْ."},{"w":"عَقِيمٞ","m":"لا تَحْمِلُ."}],"31":[{"w":"فَمَا خَطۡبُكُمۡ","m":"فَمَا شَأنُكُم؟"}],"32":[{"w":"قَوۡمٖ مُّجۡرِمِينَ","m":"هُم قَومُ لُوطٍ عَلَيهِ السَّلامُ."}],"34":[{"w":"مُسَوَّمَةً","m":"عَلَيها عَلَامةٌ، وَكُلُّ حَجَرٍ عَلَيهِ اسْمُ صاحِبِهِ."},{"w":"لِلۡمُسۡرِفِينَ","m":"للمُفَرِّطِينَ بِكُفْرِهِم وشُيُوعِ الفاحِشَةِ فِيهِم."}],"36":[{"w":"بَيۡتٖ","m":"بيتِ لُوطٍ عَلَيهِ السَّلامُ."}],"37":[{"w":"تَرَكۡنَا","m":"أَبْقينَا."},{"w":"ءَايَةٗ","m":"أَثَراً مِن العَذَابِ والخَرَابِ يُتَّعظُ بِه."}],"38":[{"w":"بِسُلۡطَٰنٖ","m":"بِحُجَّةٍ."}],"39":[{"w":"فَتَوَلَّىٰ","m":"فَأَعْرَضَ."},{"w":"بِرُكۡنِهِۦ","m":"بِقُوَّتِهِ وجانِبِهِ."}],"40":[{"w":"فَأَخَذۡنَٰهُ","m":"فَأَهْلَكْنَاهُ."},{"w":"فَنَبَذۡنَٰهُمۡ","m":"فَطَرَحْناهُم."},{"w":"ٱلۡيَمِّ","m":"البَحْرِ."},{"w":"مُلِيمٞ","m":"مُسْتَوْجِبٌ العِقابَ، آتٍ بِما يَلُومُهُ اللهُ عَلَيهِ."}],"41":[{"w":"ٱلۡعَقِيمَ","m":"التي لا بَرَكَةَ فِيها وَلَا تَأْتِي بِخَيرٍ."}],"42":[{"w":"مَا تَذَرُ","m":"ما تَدَعُ."},{"w":"كَٱلرَّمِيمِ","m":"العَظْمِ الَّذِي بَلِيَ فَتَفَتَّتَ."}],"43":[{"w":"تَمَتَّعُواْ","m":"مُباحٌ لكُم أَن تَتَمَتَّعُوا بِنِعَمِ الدُّنيا الزّائِلةِ."},{"w":"حَتَّىٰ حِينٖ","m":"إِلى آجالِكُم."}],"44":[{"w":"فَعَتَوۡاْ","m":"تَكَبَّرُوا فَأَعْرَضُوا."},{"w":"فَأَخَذَتۡهُمُ","m":"فَأَصَابَتْهُم."},{"w":"ٱلصَّٰعِقَةُ","m":"الصَّيحَةُ العَظِيمَةُ المُهْلِكَةُ."},{"w":"يَنظُرُونَ","m":"إلى عُقُوبَتِهِم بأَعْيُنِهِم فَيَكُونُ أَشَدَّ للعُقُوبَةِ."}],"45":[{"w":"قِيَامٖ","m":"نُهُوضٍ ودِفاعٍ."}],"47":[{"w":"بَنَيۡنَٰهَا","m":"خَلَقْناهَا وَجَعَلْناهَا سَقْفاً لِلأَرْضِ."},{"w":"بِأَيۡيْدٖ","m":"بِقُوَّةٍ."},{"w":"لَمُوسِعُونَ","m":"لَمُقْتَدِرُونَ، مِنْ “أوْسَعَ” إِذا كَانَ ذَا وُسْعٍ، أي: قُدْرةٍ."}],"48":[{"w":"فَرَشۡنَٰهَا","m":"جَعَلْنَاهَا فِراشاً لاسْتِقْرَارِ الخَلْقِ عَلَيها."},{"w":"ٱلۡمَٰهِدُونَ","m":"المُوطِّئُونَ الَمُهَيِّئُونَ."}],"49":[{"w":"زَوۡجَيۡنِ","m":"صِنْفَينِ: ذَكَراً وأُنْثَى."}],"50":[{"w":"فَفِرُّوٓاْ","m":"فارِقُوا الشِّرْكَ المُسَبِّبَ لِعَذابِكُم."}],"53":[{"w":"أَتَوَاصَوۡاْ","m":"هَلْ أوْصَى بَعْضُهُم بَعْضاً؟"},{"w":"طَاغُونَ","m":"مُتَعَدُّونَ، طُغَاةٌ عَنْ أَمْرِ رَبِّهِم."}],"54":[{"w":"فَتَوَلَّ عَنۡهُمۡ","m":"فأَعْرِضْ عَنْهُم."},{"w":"فَمَآ أَنتَ بِمَلُومٖ","m":"فَلَيسَ عَلَيكَ لَوْمٌ في ذَنْبِهِم."}],"55":[{"w":"ٱلذِّكۡرَىٰ","m":"التَّذْكِيرَ والمَوعِظَةَ."}],"56":[{"w":"لِيَعۡبُدُونِ","m":"إرَادَةَ أَن يَعْبُدُونِي إِرَادَةً شَرْعِيَّةً دِينِيَّةً، وقَدْ تَقَعُ العِبادة وَقَدْ لَا تَقَعُ."}],"58":[{"w":"ٱلۡمَتِينُ","m":"الشَّدِيدُ الكامِلُ في قُوَّتِهِ."}],"59":[{"w":"ذَنُوبٗا","m":"حَظّاً ونَصِيباً."}],"60":[{"w":"فَوَيۡلٞ","m":"عَذابٌ وَهَلاكٌ."}]}