{"1":[{"w":"وَيۡلٞ","m":"شَرٌّ وَهَلاكٌ."},{"w":"لِكُلِّ هُمَزَةٖ","m":"لِكُلِّ مُغْتابٍ للنَّاسِ."},{"w":"لُمَزَةٍ","m":"طَعَّانٍ فِيهِم."}],"2":[{"w":"جَمَعَ مَالٗا وَعَدَّدَهُۥ","m":"كانَ هَمُّه جَمْعَ المالِ وتَعْدَادَهُ."}],"3":[{"w":"أَخۡلَدَهُۥ","m":"جَعَلَه خالِداً في الدُّنيا."}],"4":[{"w":"لَيُنۢبَذَنَّ","m":"ليُطْرَحَنَّ."},{"w":"فِي ٱلۡحُطَمَةِ","m":"في النَّارِ الَّتِي تُحَطِّم كُلَّ ما يُلْقى فِيها."}],"5":[{"w":"وَمَآ أَدۡرَىٰكَ","m":"وأيُّ شيءٍ أَعْلَمَكَ؟"}],"6":[{"w":"ٱلۡمُوقَدَةُ","m":"المسْتَعِرَةُ الَّتِي لا يزُولُ لَهِيبُها."}],"7":[{"w":"تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","m":"من شِدَّتِها تَنفُذُ مِنَ الأجْسام إِلى القُلُوبِ."}],"8":[{"w":"مُؤۡصَدَةٞ","m":"مُغْلَقةٌ غَلْقاً مُطْبِقاً."}],"9":[{"w":"فِي عَمَدٖ","m":"مُوْثَقِينَ في سَلاسِلَ وأغلالٍ."},{"w":"مُمَدَّدَةِۭ","m":"مُطَوَّلَةٍ؛ لئلَّا يَخرُجُوا مِنها."}]}