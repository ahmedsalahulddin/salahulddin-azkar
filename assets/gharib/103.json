{"1":[{"w":"وَٱلۡعَصۡرِ","m":"أَقْسَمَ اللهُ بالدَّهْرِ."}],"2":[{"w":"إِنَّ ٱلۡإِنسَٰنَ","m":"إنَّ بَنِي آدَمَ."},{"w":"لَفِي خُسۡرٍ","m":"لَفِي هَلَكَةٍ، ونُقْصانٍ، وسُوءِ عاقبةٍ."}],"3":[{"w":"وَتَوَاصَوۡاْ","m":"وأوصَى بَعْضُهم بَعْضاً."},{"w":"بِٱلۡحَقِّ","m":"بالاسْتِمساكِ بالحقِّ، والعملِ بِطاعةِ اللهِ."}]}