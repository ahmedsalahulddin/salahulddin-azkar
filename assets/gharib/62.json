{"1":[{"w":"يُسَبِّحُ","m":"يُنَزِّهُ."},{"w":"ٱلۡمَلِكِ","m":"المالِكِ لِكُلِّ شَيءٍ، المتَصَرِّفِ فِيهِ بِلا مُنازِعٍ."},{"w":"ٱلۡقُدُّوسِ","m":"المنَزَّهِ عَن كُلِّ نَقْصٍ."},{"w":"ٱلۡعَزِيزِ","m":"الَّذِي لا يُغَالَبُ."},{"w":"ٱلۡحَكِيمِ","m":"المحْكِمِ فِي تَدْبِيرِهِ وصُنْعِهِ."}],"2":[{"w":"ٱلۡأُمِّيِّـۧنَ","m":"العربِ الَّذِينَ لا يَقْرَؤُونَ وَلَا يَكْتُبُونَ."},{"w":"ءَايَٰتِهِۦ","m":"القُرْآنَ."},{"w":"وَيُزَكِّيهِمۡ","m":"ويُطَهِّرهم مِنَ العقائِدِ الفاسِدَةِ، والأخْلاقِ السَّيِّئةِ."},{"w":"ٱلۡكِتَٰبَ","m":"القُرْآنَ."},{"w":"وَٱلۡحِكۡمَةَ","m":"والسُّنَّةَ."}],"3":[{"w":"وَءَاخَرِينَ","m":"وَأَرْسَلَهُ إلى آخَرِينَ."},{"w":"مِنۡهُمۡ","m":"مِنَ العَرَبِ ومِنْ غَيْرِهِم."},{"w":"لَمَّا يَلۡحَقُواْ بِهِمۡ","m":"لَمْ يَجِيئُوا بَعْدُ، وَسَيَجِيئُونَ."}],"4":[{"w":"فَضۡلُ ٱللَّهِ","m":"مِمَّا تَفَضَّلَ اللهُ بِهِ عَلَى هَؤلَاءِ دُونَ غَيرِهِم."},{"w":"ٱلۡفَضۡلِ ٱلۡعَظِيمِ","m":"الإحْسانِ، والعَطاءِ الجَزِيلِ."}],"5":[{"w":"مَثَلُ","m":"شَبَهُ."},{"w":"حُمِّلُواْ ٱلتَّوۡرَىٰةَ","m":"كُلِّفُوا العَمَلَ بِها."},{"w":"لَمۡ يَحۡمِلُوهَا","m":"لم يَعْمَلُوا بِها."},{"w":"أَسۡفَارَۢا","m":"كُتُباً لا يَدْرِي ما فِيها."},{"w":"بِئۡسَ","m":"قَبُحَ."},{"w":"لَا يَهۡدِي","m":"لا يُوفِّقُ."}],"6":[{"w":"هَادُوٓاْ","m":"تَمَسَّكُوا بالِملَّةِ اليهُودِيَّةِ."},{"w":"أَوۡلِيَآءُ لِلَّهِ","m":"أَحِبّاءُ للهِ."}],"7":[{"w":"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ","m":"بِسببِ ما اكْتَسَبُوا في هذه الدُّنيا مِنَ الآثامِ."}],"8":[{"w":"فَإِنَّهُۥ مُلَٰقِيكُمۡ","m":"آتٍ إلَيكُم وَقْتَ مَجِيءِ آجالِكُم."},{"w":"ثُمَّ تُرَدُّونَ","m":"ثم تُرْجَعُونَ يَومَ القِيامةِ."},{"w":"ٱلۡغَيۡبِ","m":"ما غابَ عنكم وعن أَبْصَارِكم."},{"w":"ٱلشَّهَٰدَةِ","m":"ما تَرَوْنَه وتُشَاهِدونه."}],"9":[{"w":"نُودِيَ","m":"نادى المؤَذِّنُ."},{"w":"فَٱسۡعَوۡاْ","m":"فامْضُوا وأَقْبِلُوا."},{"w":"ذِكۡرِ ٱللَّهِ","m":"الموعظةِ في خُطْبَةِ الإِمامِ."},{"w":"وَذَرُواْ","m":"واتْرُكُوا."}],"10":[{"w":"وَٱبۡتَغُواْ مِن فَضۡلِ ٱللَّهِ","m":"واطْلُبُوا مِن رِزْقِ اللهِ."},{"w":"تُفۡلِحُونَ","m":"تَفُوزُونَ بِخَيرَيِ الدُّنيا والآخِرَةِ."}],"11":[{"w":"لَهۡوًا","m":"صارِفاً عَنِ الصَّلاةِ."},{"w":"ٱنفَضُّوٓاْ","m":"تَفَرَّقُوا."},{"w":"قَآئِمٗا","m":"أي: عَلَى الِمنْبَرِ."}]}