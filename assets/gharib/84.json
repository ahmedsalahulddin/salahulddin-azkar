{"1":[{"w":"ٱنشَقَّتۡ","m":"تَصَدَّعتْ يومَ القِيامَةِ."}],"2":[{"w":"وَأَذِنَتۡ لِرَبِّهَا","m":"وَأَطاعَتْ أَمْرَ رَبِّها."},{"w":"وَحُقَّتۡ","m":"وحُقَّ لَها أَن تَنقَادَ لِأَمْرِهِ."}],"3":[{"w":"مُدَّتۡ","m":"بُسِطَتْ وَوُسِّعَتْ."}],"4":[{"w":"وَأَلۡقَتۡ مَا فِيهَا","m":"وَقَذَفَتْ ما في بَطْنِها مِنَ الأمْوَاتِ."},{"w":"وَتَخَلَّتۡ","m":"لم يَبْقَ شَيءٌ مِمَّا في بَطْنِها."}],"5":[{"w":"وَأَذِنَتۡ لِرَبِّهَا","m":"وانْقادَتْ لِرَبِها فِيما أَمَرها بِهِ."}],"6":[{"w":"كَادِحٌ","m":"ساعٍ إلى اللهِ."},{"w":"فَمُلَٰقِيهِ","m":"تُلاقِي الله يَومَ القِيامَةِ."}],"7":[{"w":"أُوتِيَ كِتَٰبَهُۥ","m":"أُعطِيَ صَحِيفةَ أعمالِهِ."}],"8":[{"w":"يَسِيرٗا","m":"سَهْلا."}],"9":[{"w":"وَيَنقَلِبُ","m":"وَيَرْجِعُ."}],"10":[{"w":"كِتَٰبَهُۥ","m":"صَحِيفةَ أَعْمالِهِ."}],"11":[{"w":"يَدۡعُواْ ثُبُورٗا","m":"أَيْ: بِالْهَلَاكِ."}],"12":[{"w":"وَيَصۡلَىٰ سَعِيرًا","m":"وَيَدْخُلُ النَّارَ مُقاسِياً حَرَّها."}],"13":[{"w":"مَسۡرُورًا","m":"مَغْرُوراً لا يُفَكِّرُ في العواقِبِ."}],"14":[{"w":"يَحُورَ","m":"يَرْجِعَ إلى خالِقِه لِلْحِسابِ."}],"16":[{"w":"بِٱلشَّفَقِ","m":"باحْمِرارِ الأُفُقِ عِنْدَ الغُرُوب."}],"17":[{"w":"وَمَا وَسَقَ","m":"وما جَمَعَ من الدَّوابِّ والحَشراتِ والهَوَامِّ وَغَيرِ ذَلِكَ."}],"18":[{"w":"ٱتَّسَقَ","m":"تَكَامَلَ نُورُهُ."}],"19":[{"w":"طَبَقًا عَن طَبَقٖ","m":"أطواراً مُتَعَدِّدَةً وَأَحْوالاً مُتَبايِنَةً: مِنَ النُّطْفَةِ إلى العَلَقَةِ إلى المُضْغةِ إلى نَفْخِ الرُّوحِ، إلى الموتِ، إلى البعْثِ والنُّشُورِ."}],"20":[{"w":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","m":"فأيُّ شَيءٍ يَمْنَعُهُم مِنَ الإيمانِ بَعْدَ ما وُضِّحَتْ لَهُمُ الآياتُ؟"}],"21":[{"w":"لَا يَسۡجُدُونَ","m":"لا يَخْضَعُونَ للهِ، ولا يُسَلِّمُونَ بِما جاءَ في القُرآنِ."}],"23":[{"w":"بِمَا يُوعُونَ","m":"بِما يَكْتُمُونَ مِن العِنادِ مَعَ عِلْمِهِم بأنَّ ما جاءَ بهِ القرآنُ حَقٌّ."}],"24":[{"w":"فَبَشِّرۡهُم","m":"أي: بَشِّرْ هَؤُلاءِ المكذِّبِينَ."}],"25":[{"w":"غَيۡرُ مَمۡنُونِۭ","m":"غَيرُ مَقْطُوعٍ ولا مَنْقُوصٍ."}]}