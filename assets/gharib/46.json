{"1":[{"w":"حمٓ","m":"سَبقَ الكلامُ على الحُرُوفِ المقطَّعةِ أَوَّلَ سُورةِ الْبَقَرَةِ."}],"3":[{"w":"وَأَجَلٖ مُّسَمّٗى","m":"وتَعْيِينِ ساعَةٍ مُحَدَّدَةٍ لِبَقائِهِما."}],"4":[{"w":"شِرۡكٞ","m":"شِرْكَةٌ ونَصِيبٌ."},{"w":"مِن قَبۡلِ هَٰذَآ","m":"مِن قَبْل هذا القرآنِ."},{"w":"أَثَٰرَةٖ","m":"بَقِيَّةٍ تُؤْثَرُ عَنِ الأوَّلِينَ."}],"6":[{"w":"كَانُواْ لَهُمۡ","m":"كانَتِ الأصْنامُ للعابِدِينَ."}],"8":[{"w":"فَلَا تَمۡلِكُونَ لِي","m":"فَلَا تَقْدِرُونَ على أَن تَرُدُّوا عَنِّي."},{"w":"تُفِيضُونَ","m":"تُكْثِرُونَ القَوْلَ فِيهِ، وتَخُوضُونَ وتتوسَّعُونَ."}],"9":[{"w":"بِدۡعٗا","m":"أوَّلَ مَبْعُوثٍ، فَقَدْ كَانَ قَبْلِي رُسُلٌ."}],"10":[{"w":"أَرَءَيۡتُمۡ","m":"أَخْبِرُونِي."},{"w":"شَاهِدٞ","m":"هُوَ عَبْدُ اللهِ بْنُ سَلَامٍ."},{"w":"عَلَىٰ مِثۡلِهِۦ","m":"أي: مِثْلِ القُرآنِ، مِنَ المعانِي الموجُودَةِ في التَّوراةِ."}],"11":[{"w":"مَا سَبَقُونَآ إِلَيۡهِ","m":"ما سَبَقَنَا فُقَرَاءُ المسلِمِينَ إلى الإيمانِ."},{"w":"إِفۡكٞ","m":"كَذِبٌ."}],"12":[{"w":"إِمَامٗا","m":"يُقْتَدَى بِهِ في الدِّينِ."},{"w":"مُصَدِّقٞ","m":"لِكِتاب مُوسى وغيرِه من كُتُب اللهِ."}],"15":[{"w":"كُرۡهٗا","m":"مَشَقَّةً."},{"w":"وَفِصَٰلُهُۥ","m":"وفِطامُهُ."},{"w":"أَشُدَّهُۥ","m":"نِهايةَ قُوَّتِهِ البَدَنِيَّةِ والعقْلِيَّةِ."},{"w":"أَوۡزِعۡنِيٓ","m":"أَلْهِمْنِي."}],"16":[{"w":"فِيٓ أَصۡحَٰبِ ٱلۡجَنَّةِ","m":"في جُمْلة أصْحابِ الجنَّة."}],"17":[{"w":"أُفّٖ","m":"اسْمُ فِعْلٍ مَعْناه: أَتَضَجَّرُ."},{"w":"أُخۡرَجَ","m":"أُبْعَثَ بَعْدَ الموتِ."},{"w":"خَلَت","m":"مَضَت."},{"w":"ٱلۡقُرُونُ","m":"جَمْعُ قَرْنٍ، وهو الأُمَّةُ الَّتي تَقَارَبَ زَمانُ حياتِها، أي: فماتُوا ولم يُبْعَثْ مِنْهُم أَحَدٌ؟"},{"w":"يَسۡتَغِيثَانِ ٱللَّهَ","m":"يَطْلُبانِ عَوْنَهُ."},{"w":"وَيۡلَكَ","m":"هَلَاكاً لَكَ."},{"w":"أَسَٰطِيرُ","m":"القِصَصُ الباطِلةُ."}],"18":[{"w":"حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ","m":"وَجَبَ عَلَيهِمُ القَوْلُ بالعَذَابِ."}],"20":[{"w":"أَذۡهَبۡتُمۡ","m":"أَيْ: يقُولُ اللهُ لَهُم ذَلِكَ."},{"w":"ٱلۡهُونِ","m":"الهَوَانِ والذُّلِّ."},{"w":"تَفۡسُقُونَ","m":"تَخْرُجُونَ عَن طَاعَةِ اللهِ بالشِّرْكِ."}],"21":[{"w":"بِٱلۡأَحۡقَافِ","m":"الرِّمالِ الكثِيرَةِ الَّتي لَمْ تَبْلُغْ أَن تَكُونَ جَبَلاً، وَتَقَعُ في جَنُوبِ الجزِيرَةِ العَرَبِيَّةِ، وهي مَنازلُ عادٍ قَومِ هُوْدٍ."},{"w":"ٱلنُّذُرُ","m":"جَمْعُ النَّذِيرِ، وهو الرَّسُولُ."}],"22":[{"w":"لِتَأۡفِكَنَا","m":"لِتَصْرِفَنا."}],"24":[{"w":"رَأَوۡهُ","m":"أي العذابَ."},{"w":"عَارِضٗا","m":"كالسَّحابِ الَّذي يَعْتَرِضُ جَوَّ السَّماءِ."},{"w":"أَوۡدِيَتِهِمۡ","m":"منازِلِهم في السُّهُولِ."}],"25":[{"w":"كُلَّ شَيۡءِۭ","m":"أَيْ: ما مِن شَأنِه أَن تُدَمِّرَهُ: مِنَ الإنْسانِ والحيوانِ والدِّيارِ."},{"w":"مَسَٰكِنُهُمۡ","m":"أي: آثارُ المساكِنِ وبقاياها."}],"26":[{"w":"فِيمَآ إِن مَّكَّنَّٰكُمۡ فِيهِ","m":"في الَّذِي لَم نَجْعَل لَّكُم القُدْرَةَ عَلَيهِ."},{"w":"وَأَفۡـِٔدَةٗ","m":"عُقُولاً."},{"w":"أَغۡنَىٰ","m":"نَفَعَ."},{"w":"يَجۡحَدُونَ","m":"يُنْكِرُونَ."},{"w":"وَحَاقَ بِهِم","m":"نَزَلَ بهم وأحاط."},{"w":"مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","m":"العَذابُ الَّذِي كانُوا يَسْخَرُونَ مِنْهُ."}],"27":[{"w":"وَصَرَّفۡنَا ٱلۡأٓيَٰتِ","m":"بيَّنَّا لَهُم أَنْواعَ الأَدِلَّةِ."}],"28":[{"w":"فَلَوۡلَا","m":"فَهَلَّا."},{"w":"قُرۡبَانًا","m":"لِأَجْلِ التَّقَرُّبِ بِهِم إلى اللهِ، وهو مُعْتَرِضٌ بَيْنَ:"},{"w":"ٱتَّخَذُواْ","m":"ومَفْعُولِهِ:"},{"w":"ءَالِهَةَۢ","m":"."},{"w":"ضَلُّواْ عَنۡهُمۡ","m":"غابُوا عَنْهُم."},{"w":"إِفۡكُهُمۡ","m":"كَذِبُهُم في زَعمِهِم أَنَّ الأصْنامَ شُرَكَاءُ لله."},{"w":"يَفۡتَرُونَ","m":"يَخْتَلِقُونَه مِن كَونِ الأصْنامِ تُقَرِّبُهُم إلى اللهِ."}],"29":[{"w":"صَرَفۡنَآ إِلَيۡكَ","m":"أَمَلْنَاهُم إلَيكَ، وَأَقْبَلْنا بِهِم نَحْوَك."},{"w":"نَفَرٗا","m":"جَماعَةً."},{"w":"أَنصِتُواْ","m":"وَجِّهُوا أسْمَاعَكُم إلى الكَلَامِ."},{"w":"قُضِيَ","m":"فُرِغَ مِن قِراءتِه."},{"w":"وَلَّوۡاْ","m":"انْصَرفُوا."},{"w":"مُنذِرِينَ","m":"المُنْذِرُ: المُخْبِرُ بِخَبرٍ مُخِيفٍ."}],"30":[{"w":"مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ","m":"مُصَدِّقاً لما سَبَقَه مِن كُتُبِ اللهِ الَّتِي أَنْزَلَها على رُسُلِه."}],"31":[{"w":"دَاعِيَ ٱللَّهِ","m":"رَسُولَ اللهِ محمَّداً ﷺ."},{"w":"وَيُجِرۡكُم","m":"وَيَمْنَعْكُم."}],"32":[{"w":"فَلَيۡسَ بِمُعۡجِزٖ فِي ٱلۡأَرۡضِ","m":"فَلَا يَفُوتُ عِقابَ الله."},{"w":"أَوۡلِيَآءُ","m":"نُصَراءُ."}],"33":[{"w":"وَلَمۡ يَعۡيَ بِخَلۡقِهِنَّ","m":"وَلَمْ يَعْجِزْ عَنْ خَلْقِهِنَّ."}],"35":[{"w":"أُوْلُواْ ٱلۡعَزۡمِ مِنَ ٱلرُّسُلِ","m":"هُمْ: نُوحٌ، وإبراهيمُ، وموسَى، وعِيسَى، ومُحَمَّدٌ، عَلَيهِمُ الصَّلاةُ والسَّلامُ."},{"w":"وَلَا تَسۡتَعۡجِل","m":"الهَلَاكَ."},{"w":"لَمۡ يَلۡبَثُوٓاْ","m":"لم يَمْكُثُوا."},{"w":"بَلَٰغٞ","m":"هَذا بَلاغٌ للنَّاسِ."},{"w":"ٱلۡفَٰسِقُونَ","m":"الخارِجُونَ عَنِ الإيمانِ بالإشْرَاكِ، وعَدَمِ قَبولِ الحَقِّ الَّذي جَاءتْهُمْ بِهِ الرُّسُل."}]}