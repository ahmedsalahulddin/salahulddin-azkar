{"1":[{"w":"الٓمٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"2":[{"w":"لَا رَيۡبَ فِيهِ","m":"لاشَكَّ فِيه."}],"3":[{"w":"أَمۡ يَقُولُونَ","m":"بل أيقُولُ المشرِكُونَ."},{"w":"ٱفۡتَرَىٰهُ","m":"اختَلَقَ محمدٌ ﷺ القرآنَ مِن تِلْقاءِ نَفْسِهِ."},{"w":"نَذِيرٖ","m":"أي: رَسُولٍ مُنْذِرٍ."}],"4":[{"w":"ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِ","m":"عَلَا وارْتَفَعَ سُبْحَانَه وَتَعَالَى عَلَى عَرْشِهِ كَما يَليقُ بِجَلَالِهِ."},{"w":"ٱلۡعَرۡشِ","m":"هُوَ سَريرُ المُلْكِ الَّذي اسْتَوى عَلَيهِ الرَّحْمَنُ، وَتَحْمِلُهُ الملائِكَةُ، وَهْوَ أَعْظَمُ المْخلُوقاتِ، وهو سَقْفُ الجنَّةِ."},{"w":"وَلِيّٖ","m":"ناصِرٍ يَنْصُرُكُم."},{"w":"تَتَذَكَّرُونَ","m":"تَتَّعِظُونَ."}],"5":[{"w":"يُدَبِّرُ ٱلۡأَمۡرَ","m":"يَقْضِي القَضَاءَ."},{"w":"يَعۡرُجُ","m":"يَصْعَدُ."}],"7":[{"w":"أَحۡسَنَ كُلَّ شَيۡءٍ","m":"أَحْكَمَهُ وأَتْقَنَهُ."},{"w":"طِينٖ","m":"تُرَابٍ."}],"8":[{"w":"نَسۡلَهُۥ","m":"ذُرِّيَّتَه."},{"w":"سُلَٰلَةٖ","m":"نُطْفَةٍ مَسْلُولَةٍ."},{"w":"مَهِينٖ","m":"ذَلِيلٍ."}],"9":[{"w":"سَوَّىٰهُ","m":"أتمَّ خَلْقَهُ."},{"w":"وَٱلۡأَفۡـِٔدَةَ","m":"القُلُوبَ."}],"10":[{"w":"ضَلَلۡنَا فِي ٱلۡأَرۡضِ","m":"هَلَكَتْ أجْسَادُنا وتَفَرَّقَت وصِرْنا تُرَاباً."},{"w":"كَٰفِرُونَ","m":"مُنْكِرُونَ."}],"11":[{"w":"يَتَوَفَّىٰكُم","m":"يَقبِضُ أَرْوَاحَكُم."},{"w":"وُكِّلَ بِكُمۡ","m":"وُكِّلَ بِقَبْضِ أرْوَاحِكُم."}],"12":[{"w":"نَاكِسُواْ رُءُوسِهِمۡ","m":"أي: مُطْرِقُوها خِزْياً وَنَدَامَةً."},{"w":"مُوقِنُونَ","m":"مُصَدِّقُونَ."}],"13":[{"w":"هُدَىٰهَا","m":"رُشْدَها، وَتَوفِيقَها لِلْإِيمانِ."},{"w":"حَقَّ","m":"وَجَبَ وثَبَتَ."}],"14":[{"w":"ٱلۡخُلۡدِ","m":"الدَّائِمِ."}],"15":[{"w":"يُؤۡمِنُ","m":"يُصَدِّقُ."},{"w":"ذُكِّرُواْ بِهَا","m":"وُعِظُوا بِها."},{"w":"خَرُّواْ","m":"سَقَطُوا."}],"16":[{"w":"تَتَجَافَىٰ","m":"تَرْتَفِعُ وتَتَنَحَّى."},{"w":"عَنِ ٱلۡمَضَاجِعِ","m":"عَنِ الفُرُشِ الَّتِي يُضْطَجَعُ عَلَيها."}],"17":[{"w":"مِن قُرَّةِ أَعۡيُنٖ","m":"مِن موجِباتِ المسَرَّةِ والفَرَحِ."}],"19":[{"w":"نُزُلَۢا","m":"ما يُهيَّأُ للنَّزيلِ ضِيافَةً وإكْرَاماً."}],"20":[{"w":"فَمَأۡوَىٰهُمُ","m":"المكَانُ الَّذي يَأْوُونَ إليه."}],"21":[{"w":"ٱلۡعَذَابِ ٱلۡأَدۡنَىٰ","m":"وهو ما يُصِيبُهُم في الدُّنيا مِنَ البَلاءِ والِمحَنِ."},{"w":"ٱلۡعَذَابِ ٱلۡأَكۡبَرِ","m":"وهو ما يُصِيبُهُم يومَ القِيامةِ مِنْ عَذَابِ جَهَنَّمَ."}],"22":[{"w":"ذُكِّرَ","m":"وُعِظَ."}],"23":[{"w":"فِي مِرۡيَةٖ","m":"في شَكٍّ."},{"w":"مِن لِّقَآئِهِۦ","m":"أي: مِن لِقَاءِ مُوسَى عَلَيهِ الصَّلاةُ والسَّلامُ."}],"25":[{"w":"يَفۡصِلُ","m":"يَقْضِي."}],"26":[{"w":"أَوَ لَمۡ يَهۡدِ لَهُمۡ","m":"أَوَلم يُبَيِّنْ لَهُم."},{"w":"مِنَ ٱلۡقُرُونِ","m":"مِنَ الأُمَمِ السَّابِقَةِ."},{"w":"لَأٓيَٰتٍ","m":"لَعِبَراً وعِظاتٍ."}],"27":[{"w":"ٱلۡجُرُزِ","m":"الأرْضِ اليابِسةِ الغَلِيظَةِ الجرْداءِ الَّتي لا نَباتَ فِيها."}],"28":[{"w":"هَٰذَا ٱلۡفَتۡحُ","m":"هذا القضاءُ بين العِبادِ."}],"29":[{"w":"يُنظَرُونَ","m":"يُمْهَلُونَ لِيؤْمِنُوا."}],"30":[{"w":"وَٱنتَظِرۡ","m":"أي: انْتَظِرْ ما اللهُ صانِعٌ بِهِم."}]}