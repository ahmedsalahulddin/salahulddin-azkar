{"1":[{"w":"الٓمٓصٓ","m":"سبقَ الكلام على الحروفِ المقطَّعة أوَّلَ سورة البقرة."}],"2":[{"w":"حَرَجٞ","m":"ضِيقٌ منه لتبليغِه."},{"w":"وَذِكۡرَىٰ","m":"وتذكيرٍ."}],"3":[{"w":"أَوۡلِيَآءَ","m":"أنصاراً كالشياطين والأحبارِ."}],"4":[{"w":"أَهۡلَكۡنَٰهَا","m":"أَرَدْنا إهلاكَها."},{"w":"بَأۡسُنَا","m":"عذابُنا."},{"w":"بَيَٰتًا","m":"نائمين ليلاً."},{"w":"قَآئِلُونَ","m":"حالَ استراحتِهم وسطَ النهارِ."}],"7":[{"w":"عَلَيۡهِم","m":"على الرسُلِ والمُرْسَلِ إليهم."},{"w":"بِعِلۡمٖ","m":"عالمِين بما يُسِرُّون، وما يُعْلِنون."}],"8":[{"w":"وَٱلۡوَزۡنُ يَوۡمَئِذٍ ٱلۡحَقُّ","m":"وزنُ الأعمالِ يَوْمَ القِيامَةِ بالميزانِ العَدْلِ."},{"w":"ثَقُلَتۡ مَوَٰزِينُهُۥ","m":"بثِقَلِ ما فيها من أعمالٍ حسنةٍ."}],"10":[{"w":"مَكَّنَّٰكُمۡ","m":"جَعَلْنا لكم مكاناً."},{"w":"مَعَٰيِشَ","m":"ما تعيشُون به من مَأْكَلٍ، ومَشْرَبٍ."}],"11":[{"w":"خَلَقۡنَٰكُمۡ","m":"خَلَقْنا أباكم آدمَ من ترابٍ."},{"w":"صَوَّرۡنَٰكُمۡ","m":"صَوَّرْناه على الهيئةِ المفضَّلَةِ."}],"12":[{"w":"مَا مَنَعَكَ أَلَّا تَسۡجُدَ","m":"ما مَنَعَكَ من السجودِ."}],"13":[{"w":"فَٱهۡبِطۡ مِنۡهَا","m":"فانْزِلْ من الجنةِ."},{"w":"تَتَكَبَّرَ فِيهَا","m":"تَتَعالى في الجنةِ عن أمري وطاعتي."},{"w":"ٱلصَّٰغِرِينَ","m":"الذَّلِيلِين الحقيرِين."}],"14":[{"w":"أَنظِرۡنِيٓ","m":"أمْهِلْني."},{"w":"يَوۡمِ يُبۡعَثُونَ","m":"يومَ يُحيي اللهُ الخَلْقَ."}],"15":[{"w":"مِنَ ٱلۡمُنظَرِينَ","m":"ممن كَتَبْتُ عليهم تأخيرَ الأجَلِ إلى النفخةِ الأولى."}],"16":[{"w":"فَبِمَآ أَغۡوَيۡتَنِي","m":"فبسببِ إضلالِكَ لي."},{"w":"لَأَقۡعُدَنَّ لَهُمۡ","m":"لَأَتَرَبَّصَنَّ في إغواءِ بني آدمَ."},{"w":"صِرَٰطَكَ ٱلۡمُسۡتَقِيمَ","m":"طريقَك القويمَ، وهو الإسلامُ."}],"17":[{"w":"شَٰكِرِينَ","m":"ذاكِرين نعمتَك مُثْنِين بها عليك."}],"18":[{"w":"مَذۡءُومٗا","m":"ممقُوتاً مَعِيباً."},{"w":"مَدۡحُورٗا","m":"مُبْعَداً مَطْروداً."}],"19":[{"w":"ٱلظَّٰلِمِينَ","m":"المتجاوِزِين حُدودَ اللهِ."}],"20":[{"w":"فَوَسۡوَسَ لَهُمَا","m":"فألقَى الشيطانُ لآدمَ وحواءَ وَسْوَسَةً لإيقاعِهما في معصيةِ اللهِ."},{"w":"مَا وُۥرِيَ","m":"ما سُتِرَ."},{"w":"سَوۡءَٰتِهِمَا","m":"عَوْراتِهما."},{"w":"ٱلۡخَٰلِدِينَ","m":"في الجنةِ، الماكثين فيها أبداً."}],"21":[{"w":"وَقَاسَمَهُمَآ","m":"وحَلَفَ الشيطانُ باللهِ لآدمَ وحوّاءَ."}],"22":[{"w":"فَدَلَّىٰهُمَا","m":"فأوقعهما وجَرَّأهما على ما أراد."},{"w":"بِغُرُورٖ","m":"بخِداعِه."},{"w":"وَطَفِقَا","m":"وأَخَذا."},{"w":"يَخۡصِفَانِ عَلَيۡهِمَا","m":"يُلْصِقَانِ على عَوْراتهِما."}],"23":[{"w":"ظَلَمۡنَآ أَنفُسَنَا","m":"بمخالفةِ أمْرِك."}],"24":[{"w":"ٱهۡبِطُواْ","m":"انزِلُوا من الجنةِ إلى الأرضِ."},{"w":"وَمَتَٰعٌ","m":"ما تتمتعون به."},{"w":"إِلَىٰ حِينٖ","m":"إلى وقتِ انقضاءِ آجالِكم."}],"25":[{"w":"تُخۡرَجُونَ","m":"تُبْعَثُون أحياءً من الأرض يومَ القيامةِ."}],"26":[{"w":"أَنزَلۡنَا","m":"جَعَلْنا لكم."},{"w":"يُوَٰرِي","m":"يَسْتُرُ."},{"w":"سَوۡءَٰتِكُمۡ","m":"عَوْراتِكم."},{"w":"وَرِيشٗا","m":"لباساً للزِّينةِ والتجمُّلِ."},{"w":"وَلِبَاسُ ٱلتَّقۡوَىٰ","m":"ولباسُ تقوى الله بفِعْل الأوامرِ واجتنابِ النواهي."}],"27":[{"w":"لَا يَفۡتِنَنَّكُمُ","m":"لا يَخْدَعَنَّكم الشيطانُ بتزيينِ المعصيةِ."},{"w":"لِيُرِيَهُمَا سَوۡءَٰتِهِمَآ","m":"لتنكشِفَ لهما عوراتُهما."},{"w":"وَقَبِيلُهُۥ","m":"ذريّةُ الشيطانِ."},{"w":"أَوۡلِيَآءَ","m":"أنصاراً."}],"28":[{"w":"فَٰحِشَةٗ","m":"قَبيحاً من الفِعْلِ."}],"29":[{"w":"بِٱلۡقِسۡطِ","m":"بالعدلِ."},{"w":"وَأَقِيمُواْ وُجُوهَكُمۡ","m":"وأخْلِصُوا لله العبادةَ."},{"w":"عِندَ كُلِّ مَسۡجِدٖ","m":"في كلِّ موضعٍ من مواضعِ العبادةِ، ولا سِيَّما المساجدُ."},{"w":"ٱلدِّينَ","m":"الطاعةَ والعبادةَ."}],"30":[{"w":"حَقَّ عَلَيۡهِمُ","m":"ثَبَتَتْ لهم، ووَجَبَتْ عليهم."}],"31":[{"w":"زِينَتَكُمۡ","m":"الزينةَ المشروعةَ من ثيابٍ ساترةٍ، ونظافةٍ، وطهارةٍ."},{"w":"عِندَ كُلِّ مَسۡجِدٖ","m":"عند أداءِ كلِّ صلاةٍ."},{"w":"وَلَا تُسۡرِفُوٓاْ","m":"ولا تتجاوزُوا حدودَ الاعتدالِ."}],"32":[{"w":"زِينَةَ ٱللَّهِ","m":"اللِّباسَ الحسنَ الذي جَعَلَه اللهُ زينةً لكم."},{"w":"خَالِصَةٗ","m":"مخصوصةً بالمؤمنين."}],"33":[{"w":"ٱلۡفَوَٰحِشَ","m":"القبائحَ من الأعمالِ."},{"w":"وَمَا بَطَنَ","m":"وما كان خفيّاً."},{"w":"وَٱلۡإِثۡمَ","m":"المعاصيَ كلَّها."},{"w":"وَٱلۡبَغۡيَ","m":"الاعتداءَ على الناس."},{"w":"سُلۡطَٰنٗا","m":"دليلاً وبرهاناً."},{"w":"وَأَن تَقُولُواْ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ","m":"وحَرَّم اللهُ أن تَنْسِبوا إليه ما لم يَشْرَعْه."}],"34":[{"w":"أَجَلٞ","m":"وقتٌ لحُلولِ العقوبةِ."},{"w":"لَا يَسۡتَأۡخِرُونَ","m":"لا يتأخَّرُون عنه."},{"w":"وَلَا يَسۡتَقۡدِمُونَ","m":"ولا يتقدَّمُون عليه."}],"35":[{"w":"يَقُصُّونَ","m":"يَتْلُون ويُبَيِّنُون."},{"w":"ءَايَٰتِي","m":"آياتِ كتابي، وأدلَّتي على صِدْقِ ما جاؤُوا به."}],"36":[{"w":"وَٱسۡتَكۡبَرُواْ عَنۡهَآ","m":"استعْلَوا عن اتِّباع دلائلِ توحيدِ اللهِ."}],"37":[{"w":"ٱفۡتَرَىٰ","m":"اختلَقَ."},{"w":"نَصِيبُهُم","m":"حَظُّهم من خيرٍ وشرٍّ في الدُّنيا."},{"w":"مِنَ ٱلۡكِتَٰبِ","m":"مما كُتِبَ لهم في اللَّوحِ المحفوظِ."},{"w":"رُسُلُنَا","m":"مَلَكُ الموتِ وأعوانُه."},{"w":"يَتَوَفَّوۡنَهُمۡ","m":"يقبِضُون أرواحَهم."},{"w":"ضَلُّواْ عَنَّا","m":"ذهَبُوا عنَّا."},{"w":"وَشَهِدُواْ","m":"واعتَرفوا."}],"38":[{"w":"فِيٓ أُمَمٖ","m":"في جملةِ جماعاتٍ من أمثالِكم في الكفر."},{"w":"خَلَتۡ","m":"سَبَقتْ."},{"w":"لَعَنَتۡ أُخۡتَهَا","m":"لَعَنَتِ الجماعةُ الداخلةُ النارَ نظيرتَها من أهلِ ملَّتِها."},{"w":"ٱدَّارَكُواْ فِيهَا","m":"اجتمعَتِ الأممُ في النار جميعاً."},{"w":"أُخۡرَىٰهُمۡ","m":"منزلةً ودخولاً، وهم الأتباعُ."},{"w":"لِأُولَىٰهُمۡ","m":"منزلةً ودخولاً، وهم الرؤساءُ والقادةُ في الضلالِ."},{"w":"ضِعۡفٗا","m":"زائداً على مِثْلِه مرَّةً أو مرَّاتٍ."},{"w":"لَا تَعۡلَمُونَ","m":"لا تُدْرِكُون -أيها الأتباعُ- ما لكلِّ فريقٍ منكم من العذابِ."}],"39":[{"w":"فَمَا كَانَ لَكُمۡ عَلَيۡنَا مِن فَضۡلٖ","m":"نحن القادةُ متساوون معكم -أيُّها الأتباعُ- في الضَّلالِ واستحقاقِ العذابِ."}],"40":[{"w":"بِـَٔايَٰتِنَا","m":"بحُجَجِنا وآياتِنا الدالَّةِ على وَحْدانيَّتِنا."},{"w":"وَٱسۡتَكۡبَرُواْ عَنۡهَا","m":"واستعْلَوْا عن التصديقِ بها، والعملِ بَشْرعِنا."},{"w":"لَا تُفَتَّحُ لَهُمۡ أَبۡوَٰبُ ٱلسَّمَآءِ","m":"لا يَصْعَدُ لهم في الحياةِ إلى اللهِ عملٌ صالحٌ، ولا تُفَتَّحُ لأرواحِهم إذا ماتوا أبوابُ السماءِ."},{"w":"حَتَّىٰ يَلِجَ","m":"إلا إذا دَخَلَ."},{"w":"سَمِّ ٱلۡخِيَاطِ","m":"ثَقْبِ الإبرةِ."}],"41":[{"w":"مِهَادٞ","m":"فراشٌ مِنْ تحتهم."},{"w":"غَوَاشٖ","m":"أغطيةٌ من النارِ."}],"42":[{"w":"إِلَّا وُسۡعَهَآ","m":"إلَّا ما تُطيقُ من الأعمالِ."}],"43":[{"w":"وَنَزَعۡنَا","m":"وأذهبَ اللهُ تعالى."},{"w":"مِنۡ غِلّٖ","m":"من حِقْدٍ وضغائنَ كانت من بعضِهم في الدُّنيا."},{"w":"مِن تَحۡتِهِمُ","m":"من تحتِ غُرَفِهم ومنازلهِم."},{"w":"هَدَىٰنَا لِهَٰذَا","m":"وَفَّقَنا للعملِ الصالحِ."},{"w":"أُورِثۡتُمُوهَا","m":"آلَ أمرُكم إليها."}],"44":[{"w":"مَا وَعَدَنَا رَبُّنَا","m":"على ألسنةِ رُسُلِه من إثابةِ أهلِ طاعتِه."},{"w":"مَا وَعَدَ رَبُّكُمۡ","m":"على ألسنةِ رُسُلِه من عِقابِ أهلِ معصيتِه."},{"w":"فَأَذَّنَ مُؤَذِّنُۢ","m":"فنادىٰ منادٍ."},{"w":"لَعۡنَةُ ٱللَّهِ","m":"غَضَبُ اللهِ وسَخَطُه."},{"w":"ٱلظَّٰلِمِينَ","m":"الذين كفرُوا، وتجاوَزُوا حدودَه."}],"45":[{"w":"وَيَبۡغُونَهَا عِوَجٗا","m":"ويَطْلُبون أن تكونَ سبيلُ اللهِ غيرَ مستقيمةٍ."}],"46":[{"w":"وَبَيۡنَهُمَا","m":"وبينَ أصحابِ الجنةِ وأصحابِ النارِ."},{"w":"حِجَابٞ","m":"حاجزٌ عظيمٌ يسمَّى بـ «الأعراف»."},{"w":"وَعَلَى ٱلۡأَعۡرَافِ رِجَالٞ","m":"وعلى أعالي ذلك السُّورِ رجالٌ استوَتْ حسناتُهم وسيئاتُهم."},{"w":"كُلَّۢا","m":"من أهلِ الجنةِ والنارِ."},{"w":"بِسِيمَىٰهُمۡ","m":"بعلاماتِهم، كبياضِ وجوهِ أهلِ الجنةِ، وسوادِ وجوهِ أهلِ النارِ."},{"w":"يَطۡمَعُونَ","m":"يَرْجُون دخولَ الجنةِ."}],"47":[{"w":"صُرِفَتۡ","m":"حُوِّلَتْ."},{"w":"تِلۡقَآءَ","m":"جِهةَ."}],"48":[{"w":"مَآ أَغۡنَىٰ عَنكُمۡ","m":"ما نَفَعكم."},{"w":"جَمۡعُكُمۡ","m":"ما كنتم تَجْمعون من الأموالِ والرجالِ."}],"49":[{"w":"أَهَٰٓؤُلَآءِ","m":"أي: الضعفاءُ والفقراءُ."},{"w":"لَا يَنَالُهُمُ ٱللَّهُ بِرَحۡمَةٍ","m":"لا يُدْخِلُهم الجنةَ."}],"50":[{"w":"أَفِيضُواْ","m":"صُبُّوا بكثرةٍ."},{"w":"رَزَقَكُمُ ٱللَّهُ","m":"من الطعام."}],"51":[{"w":"ٱتَّخَذُواْ دِينَهُمۡ لَهۡوٗا وَلَعِبٗا","m":"جَعَلُوا ما أمرَهم اللهُ باتِّباعِه لهواً وباطلاً."},{"w":"وَغَرَّتۡهُمُ","m":"وخَدَعَتْهم."},{"w":"نَنسَىٰهُمۡ","m":"نُعامِلُهم معاملةَ الشيء المَنْسِيِّ."},{"w":"كَمَا نَسُواْ","m":"كما تركُوا العملَ."},{"w":"يَوۡمِهِمۡ هَٰذَا","m":"يومِ الق