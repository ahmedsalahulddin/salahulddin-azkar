ُ القومِ وسادَتُهم."}],"110":[{"w":"تَأۡمُرُونَ","m":"تُشيرون عليَّ أيها الأشرافُ."}],"111":[{"w":"أَرۡجِهۡ وَأَخَاهُ","m":"أخِّرْ موسى وأخاه هارونَ، ولا تَفْصِلْ في شأنِهما الآن."},{"w":"فِي ٱلۡمَدَآئِنِ","m":"في مُدُنِ مِصْرَ وأقاليمِها."},{"w":"حَٰشِرِينَ","m":"مَنْ يَحْشُرُ السَّحَرَةَ فيَجْمَعُهم إليك."}],"116":[{"w":"سَحَرُوٓاْ أَعۡيُنَ ٱلنَّاسِ","m":"صَرَفُوها عن حقيقةِ إدراكِها؛ فخُيِّلَ إلى الأبصارِ أنَّ ما فعلُوه حقيقةٌ."},{"w":"وَٱسۡتَرۡهَبُوهُمۡ","m":"وأخافوا الناسَ إخافةً شديدةً."}],"117":[{"w":"تَلۡقَفُ","m":"تبتلِعُ بسرعة."},{"w":"مَا يَأۡفِكُونَ","m":"ما يُلْقُونه من الحِبال والعِصِيِّ، ويُوهِمونَ الناسَ أنه حقٌّ."}],"118":[{"w":"فَوَقَعَ ٱلۡحَقُّ","m":"فظهر الحقُّ في أمرِ موسى عليه السلام."}],"119":[{"w":"وَٱنقَلَبُواْ","m":"وانصرفَ فرعونُ وقومُه."},{"w":"صَٰغِرِينَ","m":"أذلَّاءَ بما لَحِقَهم من الهزيمةِ والخَيبةِ."}],"123":[{"w":"ءَاذَنَ لَكُمۡ","m":"أسْمَحَ لكم بالإيمان بما يَدْعُو إليه موسى."},{"w":"لَمَكۡرٞ مَّكَرۡتُمُوهُ","m":"إن إيمانَكم بالله وإقرارَكم بنبوَّةِ موسى لَحيلةٌ احتَلْتُموها."}],"124":[{"w":"مِنۡ خِلَٰفٖ","m":"بقَطْع اليدِ اليمنى والرِّجلِ اليسرى، أو اليدِ اليسرى والرِّجلِ اليمنى."},{"w":"لَأُصَلِّبَنَّكُمۡ","m":"لَأُبالِغَنَّ في شَدِّ أطرافِكم وتعليقِكم على جُذوع النَّخْلِ."}],"125":[{"w":"مُنقَلِبُونَ","m":"راجِعُون إلى اللهِ."}],"126":[{"w":"وَمَا تَنقِمُ","m":"ولَسْتَ تَعِيبُ منا -يا فرعونُ- وتُنْكِرُ."},{"w":"بِـَٔايَٰتِ رَبِّنَا","m":"بحُجَجِه وأدلَّتِه."},{"w":"أَفۡرِغۡ","m":"أَنْزِلْ وأسبِغْ."}],"127":[{"w":"أَتَذَرُ","m":"أتَتْرُك."},{"w":"لِيُفۡسِدُواْ فِي ٱلۡأَرۡضِ","m":"في أرضِ مصرَ بتغييرِ دينِ الناسِ إلى عبادةِ اللهِ وحدَه."},{"w":"وَيَذَرَكَ وَءَالِهَتَكَ","m":"وقد تَرَكَك وتَرَكَ عبادةَ آلهتِك؟"},{"w":"وَنَسۡتَحۡيِۦ نِسَآءَهُمۡ","m":"ونَسْتبقيهنَّ أحياءً للخدمةِ والامتهانِ."},{"w":"قَٰهِرُونَ","m":"عالُون عليهم بقَهْرِ المُلْكِ والسلطانِ."}],"129":[{"w":"مِن قَبۡلِ أَن تَأۡتِيَنَا","m":"برسالةِ اللهِ إلينا."},{"w":"وَمِنۢ بَعۡدِ مَا جِئۡتَنَا","m":"برسالةِ اللهِ."},{"w":"وَيَسۡتَخۡلِفَكُمۡ فِي ٱلۡأَرۡضِ","m":"ويَجْعَلَكم خلفاءَ في أرضِ مصرَ بعد هَلاكِ فرعونَ وقومِه."}],"130":[{"w":"أَخَذۡنَآ","m":"ابتَلَيْنا."},{"w":"بِٱلسِّنِينَ","m":"بالقحطِ والجَدْبِ."}],"131":[{"w":"ٱلۡحَسَنَةُ","m":"العافيةُ والرَّخاءُ والخِصْبُ."},{"w":"سَيِّئَةٞ","m":"بلاءٌ وجَدْبٌ."},{"w":"يَطَّيَّرُواْ","m":"يتشاءمُوا."},{"w":"طَٰٓئِرُهُمۡ","m":"ما يُصيبُهم من البلاءِ والجَدْبِ."},{"w":"عِندَ ٱللَّهِ","m":"بقضاءِ اللهِ وقَدَرِه."}],"132":[{"w":"مِنۡ ءَايَةٖ","m":"من دَلالةٍ وحُجَّةٍ."}],"133":[{"w":"وَٱلۡقُمَّلَ","m":"حشراتٍ تُفْسِدُ الثمار، وتَقْضي على الحَيَوانِ والنباتِ."},{"w":"وَٱلدَّمَ","m":"فصارَتْ مياهُ القِبْط دماً، ولم يَجِدوا ماءً صالحاً للشُّربِ."},{"w":"مُفَصَّلَٰتٖ","m":"مُفَرَّقاتٍ بعضُها في إثرِ بعضٍ."}],"134":[{"w":"وَقَعَ","m":"نَزَلَ."},{"w":"ٱلرِّجۡزُ","m":"العذابُ."},{"w":"بِمَا عَهِدَ عِندَكَ","m":"بما أوحَى إليك مِنْ رَفْعِ العذاب بالتوبةِ."}],"135":[{"w":"يَنكُثُونَ","m":"يَنْقُضُون عُهودَهم، وَيَبْقَوْن على كُفْرِهم وضلالهِم."}],"136":[{"w":"بِـَٔايَٰتِنَا","m":"بحُجَجِنا، وما أَرَيْناهم من المعجزاتِ على يدِ موسى."},{"w":"غَٰفِلِينَ","m":"مُعْرِضِين."}],"137":[{"w":"يُسۡتَضۡعَفُونَ","m":"يُسْتَذَلُّون للخِدْمَةِ والامتهانِ."},{"w":"مَشَٰرِقَ ٱلۡأَرۡضِ وَمَغَٰرِبَهَا","m":"بلادَ الشامِ."},{"w":"كَلِمَتُ رَبِّكَ ٱلۡحُسۡنَىٰ","m":"ما وَعَدَهم من تمكينِهم في الأرضِ ونَصْرِه إياهم على فرعونَ وقومِه."},{"w":"يَعۡرِشُونَ","m":"يَبْنُون من الأبنيةِ والقصورِ وغيرِهما."}],"138":[{"w":"يَعۡكُفُونَ","m":"يُقيمون ويُواظِبون من أجلِ العبادةِ."}],"139":[{"w":"مُتَبَّرٞ مَّا هُمۡ فِيهِ","m":"مُهْلَكٌ ما هم فيه من الدِّين الباطِل والشِّرْكِ بالله."}],"140":[{"w":"فَضَّلَكُمۡ","m":"بكثرةِ الأنبياء وإهلاكِ عدوِّكم."},{"w":"عَلَى ٱلۡعَٰلَمِينَ","m":"من أهلِ عَصْرِكم."}],"141":[{"w":"يَسُومُونَكُمۡ","m":"يُذيقُونكم."},{"w":"وَيَسۡتَحۡيُونَ نِسَآءَكُمۡ","m":"ويَسْتَبْقُون نساءَكم للخِدْمَةِ والامتهانِ."},{"w":"بَلَآءٞ","m":"اختبارٌ ونعمةٌ."}],"142":[{"w":"وَأَصۡلِحۡ","m":"واحمِلْ بني إسرائيلَ على عبادةِ اللهِ وطاعتِه."}],"143":[{"w":"لَن تَرَىٰنِي","m":"لن تَقْدِرَ على رؤيتي في الدنيا."},{"w":"تَجَلَّىٰ رَبُّهُۥ لِلۡجَبَلِ","m":"ظَهَرَ ربُّه للجَبَلِ على الوجهِ اللائقِ بجَلالِه."},{"w":"دَكّٗا","m":"مُسْتوياً بالأرض."},{"w":"وَخَرَّ","m":"وسقط."},{"w":"صَعِقٗا","m":"مَغْشِيّاً عليه؛ لعِظَمِ ما رأى."},{"w":"أَوَّلُ ٱلۡمُؤۡمِنِينَ","m":"بك من قومي."}],"144":[{"w":"ٱصۡطَفَيۡتُكَ","m":"اختَرْتُك."},{"w":"وَبِكَلَٰمِي","m":"وبتكليمي إياك من غيرِ واسطةٍ."}],"145":[{"w":"فِي ٱلۡأَلۡوَاحِ","m":"ألواحِ التوراةِ."},{"w":"مِن كُلِّ شَيۡءٖ","m":"يحتاجون إليه في دينِهم، وما يُصْلِحُ معاشَهم."},{"w":"فَخُذۡهَا بِقُوَّةٖ","m":"فخُذِ التوراةَ بجِدٍّ واجتهاد."},{"w":"بِأَحۡسَنِهَا","m":"بحَسَنِها، وكلُّها حَسَنٌ بما شَرَعَ اللهُ فيها."},{"w":"دَارَ ٱلۡفَٰسِقِينَ","m":"مصيرَهم في الآخرة، وهي النارُ."}],"146":[{"w":"عَنۡ ءَايَٰتِيَ","m":"عن فَهْمِ حُجَجِ الله وأدلَّتِه وكتابِه."},{"w":"ٱلۡغَيِّ","m":"الضلالِ."}],"147":[{"w":"حَبِطَتۡ أَعۡمَٰلُهُمۡ","m":"بطَلَتْ أعمالُهم، فلا ثوابَ عليها."}],"148":[{"w":"مِنۢ بَعۡدِهِۦ","m":"مِنْ بعدِ ما فارَقَهم لمناجاةِ ربِّه."},{"w":"عِجۡلٗا جَسَدٗا","m":"معبوداً مِن ذَهَبِهم على صورةِ عجلٍ بلا رُوحٍ."},{"w":"لَهُۥ خُوَارٌ","m":"له صوتٌ يُشْبِهُ صوتَ البقرِ."}],"149":[{"w":"وَلَمَّا سُقِطَ فِيٓ أَيۡدِيهِمۡ","m":"ولما نَدِمُوا على عبادةِ العجلِ عند رجوعِ موسى عليه السلام."}],"150":[{"w":"أَسِفٗا","m":"حزيناً على عبادةِ قومِه العجلَ."},{"w":"أَعَجِلۡتُمۡ أَمۡرَ رَبِّكُمۡ","m":"أستعجَلْتم مجيئي إليكم وما وصَّيتُكم به من التوحيدِ، فَعَبدْتُم العِجْلَ؟"},{"w":"فَلَا تُشۡمِتۡ","m":"فلا تَسُرَّ."}],"152":[{"w":"ٱلۡمُفۡتَرِينَ","m":"المكذِّبين المبتدِعين."}],"154":[{"w":"يَرۡهَبُونَ","m":"يخافون أشدَّ الخوفِ من ربِّهم."}],"155":[{"w":"لِمِيقَٰتِنَا","m":"للوقتِ الذي واعَدَ اللهُ موسى أن يَلْقاه فيه؛ للتوبةِ والاعتذارِ عَمَّا فعلَ سُفَهاءُ بني إسرائيل."},{"w":"ٱلرَّجۡفَةُ","m":"الزَّلزلةُ الشديدةُ."},{"w":"ٱلسُّفَهَآءُ","m":"ضِعافُ العقولِ."},{"w":"إِنۡ هِيَ إِلَّا فِتۡنَتُكَ","m":"ما عبادةُ قومي للعِجْلِ إلا ابتلاءٌ واختبارٌ."}],"156":[{"w":"وَٱكۡتُبۡ لَنَا","m":"واجعَلْنا ممَّن كَتَبْتَ له."},{"w":"حَسَنَةٗ","m":"الصالحاتِ من الأعمالِ."},{"w":"يَتَّقُونَ","m":"يخافون اللهَ ويخشَونَ عقابَه."},{"w":"بِـَٔايَٰتِنَا","m":"بدلائلِ توحيدِنا."}],"157":[{"w":"ٱلۡأُمِّيَّ","m":"الذي لا يقرأُ ولا يكتبُ."},{"w":"يَجِدُونَهُۥ","m":"يَجِدونَ صفتَه ونبوَّتَه."},{"w":"ٱلۡخَبَٰٓئِثَ","m":"من المطاعمِ والمشاربِ والمناكحِ."},{"w":"وَيَضَعُ عَنۡهُمۡ","m":"ويَرْفَعُ عنهم بالتخفيفِ أو الإذهاب."},{"w":"إِصۡرَهُمۡ وَٱلۡأَغۡلَٰلَ ٱلَّتِي كَانَتۡ عَلَيۡهِمۡ","m":"ما أُلْزِمُوا العملَ به من التكاليفِ الشاقةِ في التوراة."},{"w":"وَعَزَّرُوهُ","m":"وعَظَّموه ووَقَّرُوه."},{"w":"ٱلنُّورَ","m":"القرآنَ."}],"158":[{"w":"وَكَلِمَٰتِهِۦ","m":"ما أُنْزِلَ إلى النبي ﷺ من ربِّه، والنبيين من قبلِه."}],"159":[{"w":"يَهۡدُونَ بِٱلۡحَقِّ","m":"يستقيمون على الحقِّ، ويَدْعُون الناسَ إلى الهدايةِ."}],"160":[{"w":"وَقَطَّعۡنَٰهُمُ","m":"وفَرَّقْنا قومَ موسى من بني إسرائيلَ."},{"w":"أَسۡبَاطًا","m":"جمعُ سِبْطٍ، وهو وَلَدُ الوَلَدِ، والمرادُ: قبائلُ بعددِ الأسباطِ مِنْ وَلَدِ يعقوبَ."},{"w":"فَٱنۢبَجَسَتۡ","m":"فانفجرَتْ."},{"w":"ٱلۡغَمَٰمَ","m":"السَّحابَ."},{"w":"ٱلۡمَنَّ","m":"شيءٌ يُشْبِهُ الصَّمْغَ، طعمُه كالعَسَل."},{"w":"وَٱلسَّلۡوَىٰ","m":"طائرٌ يُشْبِهُ السُّمَانَى."}],"161":[{"w":"ٱلۡقَرۡيَةَ","m":"بيتَ المَقْدِسِ."},{"w":"حِطَّةٞ","m":"مسألتُنا حِطَّةٌ، أي: حُطَّ عنا ذنوبَنا."},{"w":"سُجَّدٗا","m":"خاضِعين للهِ تواضُعاً."}],"162":[{"w":"رِجۡزٗا","m":"عذاباً."}],"163":[{"w":"حَاضِرَةَ ٱلۡبَحۡرِ","m":"قريبةً من البحرِ الأحمرِ مُشْرِفةً عليه."},{"w":"إِذۡ يَعۡدُونَ","m":"إذ يعتدي أهلُ القريةِ بصيدِ السمكِ."},{"w":"فِي ٱلسَّبۡتِ","m":"في يومِ السبتِ الذي أُمِرُوا بتعظيمِه."},{"w":"شُرَّعٗا","m":"ظاهرةً على وجهِ البحرِ قريبةً من الشاطئ."},{"w":"وَيَوۡمَ لَا يَسۡبِتُونَ","m":"وفي سائرِ الأيام غيرِ يومِ السبتِ."},{"w":"نَبۡلُوهُم","m":"نَخْتَبِرُهم."}],"164":[{"w":"قَالُواْ مَعۡذِرَةً","m":"نَعِظُهم لنُعْذَرَ فيهم عندَ اللهِ."}],"165":[{"w":"بَـِٔيسِۭ","m":"أليمٍ شديدٍ."}],"166":[{"w":"عَتَوۡاْ","m":"تمرَّدوا وتكبَّروا."}],"167":[{"w":"تَأَذَّنَ","m":"أعلمَ."},{"w":"لَيَبۡعَثَنَّ","m":"ليُسَلِّطَنَّ."},{"w":"يَسُومُهُمۡ","m":"يُذيقُهم."}],"168":[{"w":"وَقَطَّعۡنَٰهُمۡ","m":"وفَرَّقْنا بني إسرائيلَ."},{"w":"وَبَلَوۡنَٰهُم","m":"واخْتَبَرناهم."}],"169":[{"w":"خَلۡفٞ","m":"مَنْ يَخْلُفُ غيرَه بالسُّوءِ."},{"w":"عَرَضَ هَٰذَا ٱلۡأَدۡنَىٰ","m":"ما يَعْرِضُ لهم من متاعِ الدنيا مِنْ دنيءِ المكاسبِ، كالرِّشوةِ والتحريفِ."},{"w":"عَرَضٞ مِّثۡلُهُۥ","m":"متاعٌ زائلٌ من أنواعِ الكسبِ الحرامِ."},{"w":"مِيثَٰقُ ٱلۡكِتَٰبِ","m":"ما أَخذه اللهُ عليهم من العهودِ في التوراةِ على العملِ بها."},{"w":"وَدَرَسُواْ مَا فِيهِ","m":"وعَلِمُوا ما في التوراةِ، فضيَّعوها وتَرَكُوا العملَ بها."}],"170":[{"w":"يُمَسِّكُونَ","m":"يتمسَّكون."}],"171":[{"w":"نَتَقۡنَا","m":"اقتلَعْنا ورَفَعْنا."},{"w":"ظُلَّةٞ","m":"سَحابةٌ تُظِلُّهم."},{"w":"وَظَنُّوٓاْ","m":"وأيقَنُوا."},{"w":"وَاقِعُۢ بِهِمۡ","m":"إن لم يقبَلُوا أحكامَ التوراةِ."},{"w":"بِقُوَّةٖ","m":"بجِدٍّ واجتهادٍ."},{"w":"وَٱذۡكُرُواْ مَا فِيهِ","m":"بالعملِ بما فيه."}],"172":[{"w":"أَخَذَ","m":"استخرج."},{"w":"وَأَشۡهَدَهُمۡ عَلَىٰٓ أَنفُسِهِمۡ","m":"وقرَّرَهم جميعاً بتوحيدِه بما أَوْدَعَه في فِطَرِهم."},{"w":"أَن تَقُولُواْ","m":"لئلا تقولوا."}],"173":[{"w":"أَفَتُهۡلِكُنَا","m":"أفتعذِّبُنا."},{"w":"ٱلۡمُبۡطِلُونَ","m":"الذين أَبْطَلُوا أعمالهم بالإشراكِ بالله."}],"174":[{"w":"نُفَصِّلُ","m":"نبيِّنُ."}],"175":[{"w":"وَٱتۡلُ","m":"واقصُصْ."},{"w":"نَبَأَ","m":"خبرَ رجلٍ من بني إسرائيلَ."},{"w":"ءَاتَيۡنَٰهُ ءَايَٰتِنَا","m":"آتاه اللهُ علماً ببعض الكتبِ المنزَّلَةِ."},{"w":"فَٱنسَلَخَ مِنۡهَا","m":"ثم كَفَرَ بها وجَعَلَها وراءَ ظهرِه."},{"w":"فَأَتۡبَعَهُ ٱلشَّيۡطَٰنُ","m":"لَحِقه فأدركَه فصارَ قرينَه."},{"w":"ٱلۡغَاوِينَ","m":"الضالِّين الراسِخين في الضلالِ."}],"176":[{"w":"لَرَفَعۡنَٰهُ بِهَا","m":"لَرَفَعْنا قَدْرَه بالعلمِ والعملِ بها."},{"w":"أَخۡلَدَ إِلَى ٱلۡأَرۡضِ","m":"رَكَنَ إلى الدُّنيا، واطمأَنَّ بها."}],"177":[{"w":"سَآءَ","m":"قَبُحَ."},{"w":"يَظۡلِمُونَ","m":"بالتكذيب وأنواع المعاصي."}],"178":[{"w":"مَن يَهۡدِ ٱللَّهُ","m":"مَنْ يُوَفِّقْه للإيمانِ والعَمَلِ الصالحِ."}],"179":[{"w":"ذَرَأۡنَا","m":"خَلَقْنا."},{"w":"لَا يَفۡقَهُونَ بِهَا","m":"لَا يفْهمون بها الحقَّ ولا يَعْقلون."},{"w":"كَٱلۡأَنۡعَٰمِ","m":"كالبَهائمِ التي لا تفقَهُ ما يُقالُ لها، ولا تُمَيِّزُ."}],"180":[{"w":"فَٱدۡعُوهُ بِهَا","m":"فاطْلُبُوا من الله بأسمائِه ما تُريدون."},{"w":"وَذَرُواْ","m":"واترُكُوا."},{"w":"يُلۡحِدُونَ فِيٓ أَسۡمَٰٓئِهِۦ","m":"يَميلون بها عَمَّا جُعِلَتْ له."}],"181":[{"w":"يَهۡدُونَ بِٱلۡحَقِّ","m":"يَسْتقيمون على الحقِّ، ويَدْعُون الناسَ إلى الهدايةِ."},{"w":"وَبِهِۦ يَعۡدِلُونَ","m":"وبالحقِّ يقْضُون بينَ الناسِ."}],"182":[{"w":"سَنَسۡتَدۡرِجُهُم","m":"سَنُدْنِيهم -في حالِ اغْتِرارِهم- إلى ما يُهْلِكُهم ويضاعِفُ عِقابَهم."}],"183":[{"w":"وَأُمۡلِي لَهُمۡ","m":"وأُمْهِلُهم مدةً طويلةً."},{"w":"مَتِينٌ","m":"قويٌّ لا يُدْفَعُ."}],"184":[{"w":"جِنَّةٍ","m":"جُنونٍ."}],"185":[{"w":"مَلَكُوتِ","m":"المُلْكِ العظيمِ. (زِيدت فيه الواوُ والتاء للمبالغةِ)."},{"w":"بَعۡدَهُۥ","m":"بعد القرآنِ العظيمِ."}],"186":[{"w":"وَيَذَرُهُمۡ","m":"وَيَتْرُكُهم."},{"w":"طُغۡيَٰنِهِمۡ","m":"ضَلالِهم وكُفْرِهم."},{"w":"يَعۡمَهُونَ","m":"يتردَّدُون مُتَحَيِّرين."}],"187":[{"w":"مُرۡسَىٰهَا","m":"قيامُها."},{"w":"لَا يُجَلِّيهَا","m":"لا يُظْهِرُها."},{"w":"ثَقُلَتۡ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ","m":"ثَقُلَ عِلْمُ قيامِ الساعةِ، وخَفِيَ على أهلِ السمواتِ والأرض."},{"w":"بَغۡتَةٗ","m":"فجأةً."},{"w":"حَفِيٌّ عَنۡهَا","m":"عالِمٌ بها، مُسْتَقْصٍ بالسؤالِ عنها."}],"189":[{"w":"نَفۡسٖ وَٰحِدَةٖ","m":"هي آدمُ عليه السلام."},{"w":"وَجَعَلَ مِنۡهَا","m":"وخَلَقَ منها."},{"w":"زَوۡجَهَا","m":"هي حواءُ."},{"w":"لِيَسۡكُنَ إِلَيۡهَا","m":"ليأنسَ ويطمئِنَّ بها."},{"w":"تَغَشَّىٰهَا","m":"جامَعَها، والمرادُ جنسُ الزوجين مِنْ ذريةِ آدمَ."},{"w":"فَمَرَّتۡ بِهِۦ","m":"استمرَّ بذلك الحَمْلِ إلى تمامهِ."},{"w":"أَثۡقَلَت","m":"صارت ذات ثِقَلٍ بكِبَرِ الحَمْلِ."},{"w":"صَٰلِحٗا","m":"أي: خَلْقاً سَوِيّاً صالحاً."}],"190":[{"w":"جَعَلَا","m":"أي: الزوجان من ذريةِ آدمَ."},{"w":"لَهُۥ شُرَكَآءَ","m":"أي: للهِ في ذلك الوَلَدِ، كنَحْوِ تسميتِه: عبدَ العُزَّى."}],"195":[{"w":"أَلَهُمۡ","m":"ألهذه الآلهة؟"},{"w":"يَبۡطِشُونَ","m":"يأخذُون بها، فَيدْفَعُون عنكم."},{"w":"فَلَا تُنظِرُونِ","m":"فلا تُمْهلوني بعد تدبيرِ كَيْدِكم."}],"196":[{"w":"وَلِـِّۧيَ","m":"مُتَوَلِّي حِفْظي وجميعِ أموري."},{"w":"ٱلۡكِتَٰبَ","m":"القرآنَ العظيمَ."}],"199":[{"w":"خُذِ","m":"اقْبَلْ أنتَ وأمَّتُكَ."},{"w":"ٱلۡعَفۡوَ","m":"ما تيسَّرَ من أخلاقِ الناسِ وأعمالِهم."},{"w":"بِٱلۡعُرۡفِ","m":"هو كلُّ ما عُرِفَ حُسْنُه في الشَّرْعِ والعَقْلِ."}],"200":[{"w":"يَنزَغَنَّكَ","m":"يُصِيبَنَّك وَسْوَسَةٌ."},{"w":"فَٱسۡتَعِذۡ بِٱللَّهِ","m":"فاستَجِرْ به والْجَأْ إليه."}],"201":[{"w":"ٱتَّقَوۡاْ","m":"خافُوا اللهَ بفِعْلِ أوامرِه وتَرْكِ نواهِيه."},{"w":"طَٰٓئِفٞ مِّنَ ٱلشَّيۡطَٰنِ","m":"عارضٌ من وَسْوَسَتِه."},{"w":"تَذَكَّرُواْ","m":"عقابَ اللهِ وثوابَه."},{"w":"مُبۡصِرُونَ","m":"مُنْتَهُون عن المعصيةِ على بَصيرةٍ."}],"202":[{"w":"وَإِخۡوَٰنُهُمۡ","m":"وإخوانُ الشَّياطين."},{"w":"يَمُدُّونَهُمۡ","m":"يَزيدُونهم."},{"w":"ٱلۡغَيِّ","m":"الضَّلالِ."},{"w":"لَا يُقۡصِرُونَ","m":"لا يَكُفُّون عن الإغواءِ."}],"203":[{"w":"بِـَٔايَةٖ","m":"بعلامةٍ دالَّةٍ على صِدْقِك."},{"w":"ٱجۡتَبَيۡتَهَا","m":"اختلَقْتَها واخترَعْتَها."},{"w":"هَٰذَا","m":"أي القرآنُ المجيدُ."},{"w":"بَصَآئِرُ","m":"جمعُ بَصيرةٍ، وهي الحُجَجُ والبراهينُ التي يُسْتَبصَرُ بها."},{"w":"وَهُدٗى","m":"بيانٌ يَهْدي المؤمنين."}],"205":[{"w":"تَضَرُّعٗا","m":"تَذَلُّلاً وخُضوعاً."},{"w":"وَخِيفَةٗ","m":"خائفاً منه تعالى."},{"w":"وَدُونَ ٱلۡجَهۡرِ","m":"متوسِّطاً بين الْجَهْرِ والإسرارِ."},{"w":"بِٱلۡغُدُوِّ","m":"أولِ النهارِ."},{"w":"وَٱلۡأٓصَالِ","m":"جمعُ أصيلٍ، وهو من العَصْرِ إلى المغربِ، والمرادُ: آخرُ النهارِ."}],"206":[{"w":"وَيُسَبِّحُونَهُۥ","m":"يُنَزِّهُونه عن كلِّ ما لا يليقُ به."}]}