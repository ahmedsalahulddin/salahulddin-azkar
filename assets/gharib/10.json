{"1":[{"w":"ٱلۡحَكِيمِ","m":"المُحْكَمِ في لَفْظِه ومعناه."}],"2":[{"w":"قَدَمَ صِدۡقٍ","m":"أجراً حسناً؛ بما قَدَّموا من صالحِ الأعمالِ."}],"3":[{"w":"ٱسۡتَوَىٰ","m":"علا وارتفعَ، استواءً يَليق بجَلالِه وعَظَمَتِه."},{"w":"يُدَبِّرُ ٱلۡأَمۡرَ","m":"يَقْضِي أمورَ الدنيا والآخرةِ، ويُصَرِّفُها وحدَه على أكملِ الوجوهِ."},{"w":"إِلَّا مِنۢ بَعۡدِ إِذۡنِهِۦ","m":"إلا أَنْ يأذنَ اللهُ له بالشفاعةِ."}],"4":[{"w":"مَرۡجِعُكُمۡ","m":"مَعادُكم يومَ القيامةِ."},{"w":"بِٱلۡقِسۡطِ","m":"بالعَدْلِ."},{"w":"حَمِيمٖ","m":"ماءٍ شديدِ الحرارةِ."}],"5":[{"w":"ضِيَآءٗ","m":"ذاتَ ضياءٍ في النهار."},{"w":"نُورٗا","m":"ذا نورٍ في الليل."},{"w":"وَقَدَّرَهُۥ مَنَازِلَ","m":"وهَيَّأ للقَمَرِ منازلَ لا يتَعدَّاها."},{"w":"وَٱلۡحِسَابَ","m":"ولتعلمُوا حسابَ الأشهرِ والأيامِ."},{"w":"ذَٰلِكَ","m":"أي: الخَلْقُ والتقديرُ."},{"w":"إِلَّا بِٱلۡحَقِّ","m":"إلا لحكمةٍ عظيمةٍ بالغةٍ."},{"w":"يُفَصِّلُ","m":"يُبَيِّنُ."},{"w":"ٱلۡأٓيَٰتِ","m":"الحُجَجَ والأدِلَّةَ الدالَّةَ على عَظَمَتِه."}],"6":[{"w":"ٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","m":"إتيانِ أحدِهما بعد الآخَرِ."}],"7":[{"w":"لَا يَرۡجُونَ لِقَآءَنَا","m":"لا يتوقَّعُون ولا يَخَافُون حسابَ الآخرةِ وَعِقَابَها."},{"w":"وَٱطۡمَأَنُّواْ بِهَا","m":"رَكَنُوا إليها."},{"w":"ءَايَٰتِنَا","m":"الكونيةِ والشرعيةِ."},{"w":"غَٰفِلُونَ","m":"ساهُون ومُعْرِضُون."}],"9":[{"w":"يَهۡدِيهِمۡ","m":"يُرْشِدُهم، ويُوَفِّقُهم إلى العملِ المُوصِلِ إلى الجنة."},{"w":"مِن تَحۡتِهِمُ","m":"مِنْ تحتِ غُرَفِهم ومنازلهِم."}],"10":[{"w":"دَعۡوَىٰهُمۡ فِيهَا سُبۡحَٰنَكَ ٱللَّهُمَّ","m":"دعاؤُهم الذي يَدْعُون به في الجنةِ التسبيحُ والتنزيهُ لله."},{"w":"وَتَحِيَّتُهُمۡ","m":"من اللهِ وملائكتِه لهم، وتحيةُ بعضِهم بعضاً."},{"w":"سَلَٰمٞ","m":"دعاءٌ لهم بالسَّلامةِ من كلِّ مكروهٍ."}],"11":[{"w":"ٱلشَّرَّ","m":"إجابةَ دعائِهم في الشرِّ."},{"w":"ٱسۡتِعۡجَالَهُم بِٱلۡخَيۡرِ","m":"تعجيلَ اللهِ لهم بالخيرِ."},{"w":"لَقُضِيَ إِلَيۡهِمۡ أَجَلُهُمۡ","m":"لأُهْلِكُوا جميعاً."},{"w":"فَنَذَرُ","m":"نَتْرُكُ."},{"w":"طُغۡيَٰنِهِمۡ","m":"تجاوُزِهم الْحَدَّ في إنكارِ البعثِ."},{"w":"يَعۡمَهُونَ","m":"يتردَّدُون متحَيِّرين."}],"12":[{"w":"مَسَّ","m":"أصاب."},{"w":"ٱلضُّرُّ","m":"الشِّدَّةُ والمكروهُ."},{"w":"لِجَنۢبِهِۦٓ","m":"مُضْطجعاً على جَنْبِه."},{"w":"مَرَّ كَأَن لَّمۡ يَدۡعُنَآ","m":"استمرَّ على ما كان عليه قبل أن يُبْتلَى."},{"w":"لِلۡمُسۡرِفِينَ","m":"المتجاوِزِين الْحَدَّ في الكفرِ والمعاصي."}],"13":[{"w":"ٱلۡقُرُونَ","m":"جَمْعُ قَرْن، وهم: القومُ المقتَرِنون في زمانٍ واحدٍ."},{"w":"ظَلَمُواْ","m":"أشرَكُوا وكَذَّبُوا."},{"w":"بِٱلۡبَيِّنَٰتِ","m":"الدَّلالاتِ الواضحاتِ الدالَّةِ على صدقِهم."}],"14":[{"w":"خَلَٰٓئِفَ","m":"جَمْعُ خليفة، وهو مَنْ يَخْلُفُ غيرَه."}],"15":[{"w":"بَيِّنَٰتٖ","m":"واضحاتٍ."},{"w":"لَا يَرۡجُونَ لِقَآءَنَا","m":"لا يتَوقَّعُون ولا يَخَافُون حسابَ الآخرةِ وعِقَابَها."},{"w":"أَوۡ بَدِّلۡهُ","m":"أو غَيِّرْ فيه بما ليس منه."}],"16":[{"w":"وَلَآ أَدۡرَىٰكُم بِهِۦ","m":"ولا أَعْلَمَكم به على لساني."},{"w":"عُمُرٗا","m":"زَمَناً طويلاً، وهو أربعون سنةً."}],"17":[{"w":"ٱفۡتَرَىٰ","m":"اختَلَق."}],"18":[{"w":"شُفَعَٰٓؤُنَا","m":"يَشْفَعُون لنا."},{"w":"بِمَا لَا يَعۡلَمُ","m":"وهو أنَّ له شفيعاً عندَه بغيرِ إذنِه."},{"w":"سُبۡحَٰنَهُۥ","m":"تنزيهاً له."}],"19":[{"w":"أُمَّةٗ وَٰحِدَةٗ","m":"على دينٍ واحدٍ، وهو الإسلامُ."},{"w":"وَلَوۡلَا كَلِمَةٞ سَبَقَتۡ مِن رَّبِّكَ","m":"وهي تأخيرُه القضاءَ بينَهم إلى يومِ القيامةِ."},{"w":"لَقُضِيَ بَيۡنَهُمۡ","m":"عاجلاً في الدُّنيا."}],"20":[{"w":"لَوۡلَآ","m":"هَلَّا."},{"w":"ءَايَةٞ","m":"علامةٌ حِسِّيَّةٌ مما اقترحُوه، كجَعْلِ الجبالِ ذَهَباً."},{"w":"إِنَّمَا ٱلۡغَيۡبُ لِلَّهِ","m":"نُزولُ الآيةِ غَيْبٌ، واللهُ هو المختصُّ به."}],"21":[{"w":"ٱلنَّاسَ","m":"المشركين."},{"w":"رَحۡمَةٗ","m":"يُسْراً ورَخاءً."},{"w":"ضَرَّآءَ","m":"شِدَّةٍ وبَلاءٍ."},{"w":"مَكۡرٞ فِيٓ ءَايَاتِنَا","m":"بالتكذيبِ والاستهزاءِ بها."},{"w":"أَسۡرَعُ مَكۡرًا","m":"أسرعُ استدراجاً وعقوبةً لكم."},{"w":"رُسُلَنَا","m":"الكَتَبةَ من الملائكةِ."}],"22":[{"w":"ٱلۡفُلۡكِ","m":"السُّفُنِ."},{"w":"طَيِّبَةٖ","m":"سَهْلَةِ الهُبوبِ، موافِقَةٍ للغَرَضِ والمنفعةِ."},{"w":"عَاصِفٞ","m":"شديدةُ الهُبوبِ."},{"w":"وَظَنُّوٓاْ","m":"أيقَنُوا."},{"w":"أُحِيطَ بِهِمۡ","m":"وَقَعَ عليهم الهلاكُ."},{"w":"ٱلدِّينَ","m":"الدُّعاءَ."}],"23":[{"w":"يَبۡغُونَ فِي ٱلۡأَرۡضِ","m":"يُفْسِدُون فيها متجاوِزينَ الحَدَّ في المعاصي."},{"w":"بَغۡيُكُمۡ عَلَىٰٓ أَنفُسِكُم","m":"مَصِيرُ فسادِكم عائدٌ عليكم."},{"w":"مَتَٰعَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","m":"تتمتعون به مَتاعاً زائلاً."}],"24":[{"w":"مَثَلُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","m":"حالُها في سُرْعَةِ انقضائِها وذَهابِ لَذَّاتِها."},{"w":"فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ","m":"فَنَبتَ بماءِ المطر أنواعٌ من النباتِ، تشابَكَتْ واختلَطَ بعضُها ببعض."},{"w":"أَخَذَتِ ٱلۡأَرۡضُ زُخۡرُفَهَا","m":"ظَهَرَ حُسْنُها واستكمَلَت بهاءَها."},{"w":"وَٱزَّيَّنَتۡ","m":"وتَزَيَّنَتْ بأصنافِ النباتِ وأشكالِه وألوانِه."},{"w":"وَظَنَّ","m":"أيقنَ."},{"w":"قَٰدِرُونَ عَلَيۡهَآ","m":"مُتَمَكِّنون مِن جَنْي ثمارِها والانتفاعِ بها."},{"w":"أَمۡرُنَا","m":"قضاؤُنا بهَلاكِ ما عليها من النباتِ والزينةِ."},{"w":"فَجَعَلۡنَٰهَا حَصِيدٗا","m":"فجَعَلْنا زَرْعَها كالنَّباتِ المقطوعِ."},{"w":"كَأَن لَّمۡ تَغۡنَ","m":"كأن لم تَكُنِ الزروعُ قائمةً على ظَهْرِ الأرض."},{"w":"بِٱلۡأَمۡسِ","m":"في الماضي القريب."},{"w":"نُفَصِّلُ","m":"نُبَيِّنُ."},{"w":"ٱلۡأٓيَٰتِ","m":"الحُجَجَ والأدلَّةَ الواضحةَ."}],"25":[{"w":"دَارِ ٱلسَّلَٰمِ","m":"الجنةِ."},{"w":"وَيَهۡدِي","m":"وَيُوفِّقُ."},{"w":"صِرَٰطٖ مُّسۡتَقِيمٖ","m":"الطريقِ الواضحِ، وهو دينُ الإسلامِ."}],"26":[{"w":"ٱلۡحُسۡنَىٰ","m":"الجنةُ."},{"w":"وَزِيَادَةٞ","m":"النظرُ إلى وجهِ اللهِ الكريمِ في الجنةِ."},{"w":"وَلَا يَرۡهَقُ","m":"لا يَغْشَى ولا يعلُو."},{"w":"قَتَرٞ","m":"غبارٌ فيه سَوادٌ."},{"w":"ذِلَّةٌ","m":"هَوانٌ وكآبةٌ."}],"27":[{"w":"كَسَبُواْ","m":"عَمِلُوا."},{"w":"مِنَ ٱللَّهِ","m":"من عذابِه."},{"w":"مِنۡ عَاصِمٖ","m":"من مانعٍ."},{"w":"قِطَعٗا","m":"أجزاءً."}],"28":[{"w":"مَكَانَكُمۡ","m":"الزَمُوا مكانَكم في موقفِ الحسابِ."},{"w":"أَنتُمۡ وَشُرَكَآؤُكُمۡ","m":"أنتم وآلهتكُم، حتى تَرَوْا ما يُفْعَلُ بكم."},{"w":"فَزَيَّلۡنَا بَيۡنَهُمۡ","m":"فرَّقْنا بينَ المشركين ومَعْبُوديهم."}],"30":[{"w":"تَبۡلُواْ","m":"تَ