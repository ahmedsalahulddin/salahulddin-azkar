{"1":[{"w":"لَا تُقَدِّمُواْ","m":"لا تَقْطَعُوا أَمْراً دُونَ اللهِ ورَسُولِهِ."}],"2":[{"w":"أَن تَحۡبَطَ","m":"خَشْيَة أَن تَبْطُلَ."},{"w":"لَا تَشۡعُرُونَ","m":"لا تُحِسُّونَ."}],"3":[{"w":"يَغُضُّونَ","m":"يَخْفِضُونَ."},{"w":"ٱمۡتَحَنَ","m":"اخْتَبَرَ."}],"4":[{"w":"ٱلۡحُجُرَٰتِ","m":"غُرَفِ النَّبِيِّ ﷺ."}],"6":[{"w":"فَاسِقُۢ","m":"خارِجٌ عَن طاعَة اللهِ وَرَسُولِهِ بارْتِكابِ الكبائِرِ."},{"w":"بِنَبَإٖ","m":"بأيِّ خَبَرٍ."},{"w":"فَتَبَيَّنُوٓاْ","m":"فَتَبَيَّنُوا الحقَّ مِنْ غَيرِ جِهَةِ الفاسِقِ."},{"w":"أَن تُصِيبُواْ","m":"خَشْيةَ أن تُصِيبُوا بضُرٍّ."},{"w":"بِجَهَٰلَةٖ","m":"مُتَلَبّسِينَ بِعَدَمِ العِلمِ."},{"w":"فَتُصۡبِحُواْ","m":"فتَصِيرُوا."}],"7":[{"w":"لَعَنِتُّمۡ","m":"لَوَقَعْتُم في مَشَقَّةٍ وَضَرَرٍ وَإِثْمٍ."},{"w":"ٱلرَّٰشِدُونَ","m":"المُسْتَقِيمُونَ عَلَى طَرِيقِ الحقِّ."}],"9":[{"w":"بَغَتۡ","m":"اعْتَدَتْ، ولم تَقْبَلِ الصُّلْحَ."},{"w":"تَفِيٓءَ","m":"تَرْجِعَ."},{"w":"وَأَقۡسِطُوٓاْ","m":"واعْدِلُوا."},{"w":"ٱلۡمُقۡسِطِينَ","m":"العادِلِينَ."}],"11":[{"w":"يَسۡخَرۡ","m":"يَهْزَأْ."},{"w":"وَلَا تَلۡمِزُوٓاْ أَنفُسَكُمۡ","m":"وَلَا يَعِبْ بَّعْضُكُم بَعْضاً."},{"w":"وَلَا تَنَابَزُواْ","m":"ولا يَدْعُ بعضُكُم بَعْضاً."},{"w":"بِٱلۡأَلۡقَٰبِ","m":"بِما يَكْرَهُ مِنَ الألقابِ."},{"w":"ٱلِٱسۡمُ","m":"الذِّكْرُ والتَّسمِيَةُ."},{"w":"ٱلۡفُسُوقُ","m":"ما ذُكِرَ مِنَ السُّخْرِيَةِ واللَّمْزِ والتنابُزِ بالألقابِ."}],"12":[{"w":"وَلَا تَجَسَّسُواْ","m":"وَلَا تُفَتِّشُوا عَنْ عَوْرَاتِ المُسْلِمِينَ، وَتَبْحَثُوا عَنْ أَخْبارِهِم."},{"w":"وَلَا يَغۡتَب بَّعۡضُكُم بَعۡضًا","m":"وَلَا يَذْكُرْ بَعْضُكُم بَعْضاً بِما يَكْرَهُ في غَيبَتِهِ."}],"13":[{"w":"شُعُوبٗا","m":"نَسَباً بَعِيداً، وهي أَكْثَرُ مِنَ القبائِل."},{"w":"وَقَبَآئِلَ","m":"نَسَباً قَرِيباً، وهي تَدْخُل تَحْتَ الشُّعوبِ."},{"w":"لِتَعَارَفُوٓاْ","m":"لِيَعْرِفَ بَعْضُكُم بَعْضاً."},{"w":"أَكۡرَمَكُمۡ","m":"أَشْرَفَكُم."}],"14":[{"w":"ٱلۡأَعۡرَابُ","m":"هُمْ في الأَصْلِ سُكَّانُ البادِيةِ مِنَ العَرَبِ، والمرادُ هُنا أَعْرابُ بَنِي أَسَدِ بن خُزَيْمَةَ."},{"w":"لَا يَلِتۡكُم","m":"لا يَنْقُصْكُم."}],"15":[{"w":"لَمۡ يَرۡتَابُواْ","m":"لَمْ يَشُكُّوا."}],"16":[{"w":"أَتُعَلِّمُونَ ٱللَّهَ بِدِينِكُمۡ","m":"أَتُخْبِرُونَهُ بِطاعَتِكُم؟"}],"17":[{"w":"لَا تَمُنُّواْ","m":"لَا تَذْكُرُوا إِنْعامَكُم."}]}