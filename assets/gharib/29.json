{"1":[{"w":"الٓمٓ","m":"سَبَقَ الكلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"2":[{"w":"لَا يُفۡتَنُونَ","m":"لا يُبتَلَونَ."}],"4":[{"w":"أَن يَسۡبِقُونَا","m":"أن يُعْجِزُونا ويَفُوتُونا."},{"w":"سَآءَ","m":"بِئْسَ."}],"5":[{"w":"يَرۡجُواْ","m":"يَتَوَقَّعُ ويَطْمَعُ."},{"w":"أَجَلَ ٱللَّهِ","m":"الوَقْتَ المُعَيَّنَ للبَعْثِ والجَزَاءِ."}],"6":[{"w":"جَٰهَدَ","m":"أي: الكُفَّارَ ونَفْسَه الأَمَّارةَ بالسُّوءِ."}],"7":[{"w":"لَنُكَفِّرَنَّ","m":"لَنَمْحُوَنَّ."},{"w":"وَلَنَجۡزِيَنَّهُمۡ","m":"لَنُثِيبَنَّهم."}],"8":[{"w":"وَوَصَّيۡنَا","m":"أي: أَمَرْنا."},{"w":"حُسۡنٗا","m":"أي: بِرّاً بِهِما وعَطْفاً عَلَيهِما."},{"w":"جَٰهَدَاكَ","m":"ألْزَماكَ."}],"10":[{"w":"فِتۡنَةَ ٱلنَّاسِ","m":"ابتلاءَهم وتَعْذِيبَهُم."}],"12":[{"w":"وَلۡنَحۡمِلۡ","m":"ولْنَتَحَمَّلْ."}],"13":[{"w":"أَثۡقَالَهُمۡ","m":"أي: أثْقَالَ ذُنُوبِهِم الْعَظِيمَةَ."},{"w":"يَفۡتَرُونَ","m":"يَخْتَلِقُونَ."}],"14":[{"w":"فَلَبِثَ","m":"مَكَثَ."},{"w":"ٱلطُّوفَانُ","m":"الماءُ الكَثِيرُ الذي غَمَرهُم مِن جَمِيعِ الجِهاتِ."}],"15":[{"w":"ءَايَةٗ","m":"عِبْرةً عَظِيمةً."}],"17":[{"w":"أَوۡثَٰنٗا","m":"أصْناماً."},{"w":"تَخۡلُقُونَ إِفۡكًا","m":"تَفْتَرُونَ كَذِباً."},{"w":"فَٱبۡتَغُواْ","m":"فالتَمِسُوا."}],"19":[{"w":"أَوَ لَمۡ يَرَوۡاْ","m":"أَوَلم يَعْلَمُوا."},{"w":"يُبۡدِئُ","m":"يُنشِئُ ابتداءً."},{"w":"يُعِيدُهُۥٓ","m":"يُعِيدُ الخَلْقَ مِن بَعْدِ فَنَائِهِ."}],"20":[{"w":"يُنشِئُ","m":"يَخلُقُ."},{"w":"ٱلنَّشۡأَةَ ٱلۡأٓخِرَةَ","m":"أي: نَشْأَةً ثانيةً عِنْدَ البعْثِ."}],"21":[{"w":"تُقۡلَبُونَ","m":"تُرجَعُونَ."}],"22":[{"w":"بِمُعۡجِزِينَ","m":"بِسَابِقِينَ اللهَ."}],"23":[{"w":"بِـَٔايَٰتِ ٱللَّهِ","m":"أي: بالقرآنِ."},{"w":"وَلِقَآئِهِۦٓ","m":"أي: بالبعثِ بَعْدَ الموتِ."}],"24":[{"w":"لَأٓيَٰتٖ","m":"لَأَدِلَّةً واضِحَةً."}],"25":[{"w":"أَوۡثَٰنٗا","m":"أصْناماً، أي: اتَّخذتُموها آلِهَةً."},{"w":"مَوَدَّةَ بَيۡنِكُمۡ","m":"أي: للتَّوادِّ والتَّواصُل بَيْنَكُم لاجْتِماعِكُم على عِبادَتِها."},{"w":"يَكۡفُرُ بَعۡضُكُم بِبَعۡضٖ","m":"أي: يتبرَّأُ بعضُكُم مِن بَعْضٍ."},{"w":"مَأۡوَىٰكُمُ","m":"مَنْزِلُكُم الذي تَأْوُونَ إليهِ وتَرْجِعُونَ."}],"26":[{"w":"فَـَٔامَنَ لَهُۥ","m":"أي: صَدَّقَ إبراهيمَ عَلَيهِ الصَّلاةُ والسَّلامُ."}],"27":[{"w":"وَٱلۡكِتَٰبَ","m":"أي: الكُتُبَ المنزَّلةَ، مِنَ التَّورَاةِ والإنْجِيلِ والزَّبُورِ والقرآنِ."},{"w":"أَجۡرَهُۥ","m":"أي: ثَوَابَه."}],"28":[{"w":"ٱلۡفَٰحِشَةَ","m":"هي إِتْيانُهم الرِّجالَ في أدْبارِهِم."}],"29":[{"w":"وَتَقۡطَعُونَ ٱلسَّبِيلَ","m":"أي: الطَّريقَ على المارَّةِ والمسَافِرِينَ، بأخْذِ أمْوالِهِم، أو قَتْلِهِم، أو إِكْرَاهِهِم على الفاحِشَةِ."},{"w":"فِي نَادِيكُمُ","m":"في مَجْلِسِكُم."},{"w":"ٱلۡمُنكَرَ","m":"وهو كلُّ فِعْلٍ يُنكِره الشَّرْعُ أو العقْلُ كالسُّخْرِيَةِ مِنَ النَّاسِ وحَذْفِ المارّةِ."}],"31":[{"w":"رُسُلُنَآ","m":"أي: مِنَ الَملاَئِكَةِ."},{"w":"هَٰذِهِ ٱلۡقَرۡيَةِ","m":"هي «سَدُومُ» قَرْيَةُ قَوْمِ لُوطٍ."}],"32":[{"w":"مِنَ ٱلۡغَٰبِرِينَ","m":"مِنَ الباقِينَ في العَذَابِ والهَلَاكِ."}],"33":[{"w":"سِيٓءَ بِهِمۡ","m":"اعْتَراهُ الغَمُّ بِمَجِيئِهِم خَوْفاً عَليهِم مِن قَومِهِ."},{"w":"وَضَاقَ بِهِمۡ ذَرۡعٗا","m":"أي: عَجَزَ عَن تَدْبِيرِ خَلَاصِهِم."}],"34":[{"w":"رِجۡزٗا","m":"عَذَاباً شَدِيداً."}],"35":[{"w":"مِنۡهَآ","m":"أي: مِن دِيارِ قَومِ لُوطٍ."},{"w":"ءَايَةَۢ بَيِّنَةٗ","m":"أي: آثاراً واضِحةً."}],"36":[{"w":"وَٱرۡجُواْ","m":"تَوَقّعُوا، أَوِ اخْشَوا."},{"w":"وَلَا تَعۡثَوۡاْ","m":"لا تُفْسدُوا أشدَّ الفَسَادِ."}],"37":[{"w":"ٱلرَّجۡفَةُ","m":"الزَّلْزَلةُ الشَّدِيدَةُ."},{"w":"جَٰثِمِينَ","m":"مَيِّتِينَ بارِكِينَ على رُكَبِهِم."}],"38":[{"w":"فَصَدَّهُمۡ","m":"فصَرفَهُم."},{"w":"ٱلسَّبِيلِ","m":"أي: سَبِيلِ اللهِ المُسْتَقِيمِ."},{"w":"مُسۡتَبۡصِرِينَ","m":"أي: عُقَلاءَ ذَوِي بَصَائِرَ مُتَمَكِّنِينَ مِن مَّعْرِفَةِ الحقِّ."}],"39":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالأدِلَّةِ الواضِحةِ."},{"w":"سَٰبِقِينَ","m":"فائِتِينَ مِنْ عَذَابِ اللهِ."}],"40":[{"w":"حَاصِبٗا","m":"ريحاً عاصِفاً ترمِيهِم بالحَصْباءِ."},{"w":"ٱلصَّيۡحَةُ","m":"صَوْتٌ مِنَ السَّماءِ مُهلِكٌ مُرْجِفٌ."},{"w":"خَسَفۡنَا بِهِ","m":"جَعَلْنا الأرْضَ تبتَلِعُه وهو حَيٌّ."}],"41":[{"w":"أَوۡهَنَ ٱلۡبُيُوتِ","m":"أضْعَفَها."}],"43":[{"w":"نَضۡرِبُهَا","m":"أي: نُبَيِّنُها."},{"w":"وَمَا يَعۡقِلُهَآ","m":"وَما يَفْهَمُها."}],"44":[{"w":"لَأٓيَةٗ","m":"لدَلالَةً عَظِيمةً."}],"45":[{"w":"ٱلۡفَحۡشَآءِ","m":"أي: كُلِّ عَمَلٍ قَبِيحٍ."},{"w":"وَٱلۡمُنكَرِ","m":"وهو كلُّ فِعْلٍ يُنكِرُه الشَّرعُ أو العَقْلُ."}],"46":[{"w":"أَهۡلَ ٱلۡكِتَٰبِ","m":"وهُمُ اليَهُودُ والنَّصارَى."}],"47":[{"w":"وَمَا يَجۡحَدُ","m":"وما يُنكِرُ."},{"w":"بِـَٔايَٰتِنَآ","m":"أي: بالقرآنِ وما فيه مِن دَلَائِلَ وبَرَاهِينَ."},{"w":"ٱلۡكَٰفِرُونَ","m":"أي: المُكابِرُونَ في كُفْرِهِم."}],"48":[{"w":"لَٱرۡتَابَ","m":"لَشَكَّ."},{"w":"ٱلۡمُبۡطِلُونَ","m":"هُمْ أَهلُ الباطِلِ."}],"49":[{"w":"هُوَ ءَايَٰتُۢ","m":"أي: القرآنُ آياتٌ تُتْلى."},{"w":"بَيِّنَٰتٞ","m":"واضِحاتٌ."},{"w":"أُوتُواْ","m":"أُعْطُوا."},{"w":"ٱلظَّٰلِمُونَ","m":"أي: المُعانِدُونَ الَّذينَ يَعْلَمُونَ الحقَّ ولا يَتَّبعُونَه."}],"50":[{"w":"ءَايَٰتٞ","m":"أي: مُعْجِزَاتٌ حِسِّيَّةٌ تُثْبِتُ صِدْقَهُ."},{"w":"عِندَ ٱللَّهِ","m":"أي: إِنْ شَاءَ أنْزَلَها، وإِنْ شَاءَ مَنَعَها."}],"53":[{"w":"أَجَلٞ مُّسَمّٗى","m":"وَقْتٌ مُعَيَّنٌ لا يَتَقَدَّمُ وَلَا يَتَأَخَّرُ."},{"w":"بَغۡتَةٗ","m":"فُجَاءَةً."}],"54":[{"w":"لَمُحِيطَةُۢ","m":"أي: سَتُحِيطُ بِهِم في الآخِرَةِ."}],"58":[{"w":"لَنُبَوِّئَنَّهُم","m":"لَنُنَزِّلَنَّهُم."},{"w":"غُرَفٗا","m":"مَنازِلَ عَالِيةً."}],"60":[{"w":"وَكَأَيِّن مِّن دَآبَّةٖ","m":"أي: كَثِيرٌ مِنَ الدَّوابِّ."},{"w":"لَا تَحۡمِلُ رِزۡقَهَا","m":"أي: لا تُطِيقُ حَمْلَهُ ولا ادِّخارَهُ."}],"61":[{"w":"فَأَنَّىٰ يُؤۡفَكُونَ","m":"فَكَيفَ يُصرَفُونَ عَن تَوحِيدِهِ؟"}],"62":[{"w":"يَبۡسُطُ","m":"يُوَسِّعُ."},{"w":"وَيَقۡدِرُ","m":"يُضَيِّقُ."}],"63":[{"w":"مِنۢ بَعۡدِ مَوۡتِهَا","m":"مِن بَعْدِ قَحْطِ الأرْضِ وَجَفافِها."}],"64":[{"w":"لَهِيَ ٱلۡحَيَوَانُ","m":"لَهِيَ الحَيَاةُ الدَّائِمَةُ الَّتي لا يُنَغِّصُها شَيءٌ."}],"65":[{"w":"فِي ٱلۡفُلۡكِ","m":"في السُّفُن."}],"67":[{"w":"وَيُتَخَطَّفُ ٱلنَّاسُ","m":"أي: يُسْتَلَبُونَ قَتْلاً وأسْراً."},{"w":"أَفَبِٱلۡبَٰطِلِ","m":"أي: بالشِّركِ."}],"68":[{"w":"ٱفۡتَرَىٰ","m":"اخْتَلَقَ."},{"w":"مَثۡوٗى","m":"مَسْكَنٌ."}],"69":[{"w":"جَٰهَدُواْ فِينَا","m":"أي: الكُفَّارَ والنَّفْسَ والشَّيطانَ."},{"w":"لَنَهۡدِيَنَّهُمۡ سُبُلَنَا","m":"لَنُرْشِدَنَّهُم طُرُقَنا."}]}