{"1":[{"w":"سُبۡحَٰنَ ٱلَّذِيٓ","m":"تنزيهاً لله عن كلِّ سوءٍ، وتعظيماً لشأنِه على كمالِ قدرتِه."},{"w":"أَسۡرَىٰ","m":"الإسراءُ هو سَيْرُ الليلِ."},{"w":"بِعَبۡدِهِۦ","m":"محمد ﷺ بجسَدِه ورُوحِه، حالَ اليَقَظةِ."},{"w":"بَٰرَكۡنَا حَوۡلَهُۥ","m":"أكْثَرْنا فيه الخيرَ بالخِصْبِ والثِّمارِ والمياهِ، وببَعْثِ كثيرٍ من الأنبياءِ منه."},{"w":"مِنۡ ءَايَٰتِنَآ","m":"من عجائبِ قدرةِ اللهِ وأدِلَّةِ وَحْدانيتِه."}],"2":[{"w":"ٱلۡكِتَٰبَ","m":"التوراةَ."},{"w":"وَكِيلٗا","m":"معبوداً تُفَوِّضون إليه أمورَكم."}],"3":[{"w":"ذُرِّيَّةَ مَنۡ حَمَلۡنَا مَعَ نُوحٍ","m":"يا سُلالةَ الذين نَجَّاهم اللهُ من الغَرَقِ مع نوحٍ، لا تُشْرِكوا بالله."}],"4":[{"w":"وَقَضَيۡنَآ إِلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ","m":"وأَعْلَمْناهم."},{"w":"ٱلۡكِتَٰبِ","m":"التوراةِ."},{"w":"فِي ٱلۡأَرۡضِ","m":"في بيتِ المَقْدِسِ والشامِ."},{"w":"وَلَتَعۡلُنَّ","m":"لتَتَجاوَزُنَّ الحَدَّ في التكبُّرِ والظُّلْمِ."}],"5":[{"w":"وَعۡدُ أُولَىٰهُمَا","m":"مَوْعِدُ أُولىٰ مَرَّتَي الإفسادِ."},{"w":"بَعَثۡنَا","m":"سَلَّطْنا."},{"w":"أُوْلِي بَأۡسٖ","m":"ذوي شجاعةٍ وقُوَّةٍ في الحروب."},{"w":"فَجَاسُواْ","m":"طافُوا وعاثُوا."},{"w":"خِلَٰلَ ٱلدِّيَارِ","m":"وسْطَها بالإفسادِ."},{"w":"مَفۡعُولٗا","m":"نافِذاً لابُدَّ من وقُوعِه."}],"6":[{"w":"ٱلۡكَرَّةَ عَلَيۡهِمۡ","m":"الغَلَبَةَ والانتصارَ على عَدُوِّكم."},{"w":"نَفِيرًا","m":"عدداً وعشيرةً."}],"7":[{"w":"وَعۡدُ ٱلۡأٓخِرَةِ","m":"مَوْعِدُ المرَّةِ الثانيةِ من الإفسادِ."},{"w":"لِيَسُـُٔواْ وُجُوهَكُمۡ","m":"ليجعَلُوا آثارَ الإهانةِ والمَذَلَّةِ باديةً فيها."},{"w":"وَلِيُتَبِّرُواْ","m":"يُدَمِّرُوا ويُهْلِكُوا."},{"w":"مَا عَلَوۡاْ","m":"ما استَوْلَوْا عليه."},{"w":"تَتۡبِيرًا","m":"تَدْميراً كاملاً."}],"8":[{"w":"وَإِنۡ عُدتُّمۡ","m":"يا بني إسرائيلَ إلى الإفسادِ والظُّلمِ."},{"w":"عُدۡنَا","m":"إلى عقابِكم ومَذلَّتِكم."},{"w":"حَصِيرًا","m":"سِجْناً يُحْبَسون فيه."}],"9":[{"w":"يَهۡدِي","m":"يُرْشِدُ الناسَ ويَدْعُوهم."},{"w":"هِيَ أَقۡوَمُ","m":"أحسنُ الطرقِ وأصوبُها."}],"10":[{"w":"أَعۡتَدۡنَا","m":"أعدَدْنا."}],"11":[{"w":"دُعَآءَهُۥ بِٱلۡخَيۡرِ","m":"مِثلَ ما يَدْعُو بالخيرِ."}],"12":[{"w":"ءَايَتَيۡنِ","m":"علامتَين في الدَّلالةِ على وَحْدانيَّة اللهِ وقدرتِه."},{"w":"ءَايَةَ ٱلَّيۡلِ","m":"علامتَه، وهي القمرُ."},{"w":"ءَايَةَ ٱلنَّهَارِ","m":"علامتَه، وهي الشمسُ."},{"w":"مُبۡصِرَةٗ","m":"مضيئةً ومُبْصَراً بها."},{"w":"فَضۡلٗا","m":"رِزْقاً؛ لأنَّ النهارَ وقتٌ للتصرُّفِ في شؤونِ المعاشِ."},{"w":"وَٱلۡحِسَابَ","m":"حسابَ الأشهرِ والأيامِ."}],"13":[{"w":"طَٰٓئِرَهُۥ","m":"ما عَمِلَه من خيرٍ أو شرٍّ."},{"w":"كِتَٰبٗا","m":"وهو صحيفةُ أعمالِه."},{"w":"يَلۡقَىٰهُ","m":"يَراه."},{"w":"مَنشُورًا","m":"مفتوحاً غيرَ مَطْوِيٍّ."}],"14":[{"w":"حَسِيبٗا","m":"مُحاسِباً."}],"15":[{"w":"وَلَا تَزِرُ وَازِرَةٞ","m":"ولا تحمِلُ نفسٌ آثمةٌ."},{"w":"وِزۡرَ أُخۡرَىٰ","m":"إثْمَ نفسٍ مُذْنبةٍ غيرِها."}],"16":[{"w":"أَمَرۡنَا","m":"بطاعةِ الله وتوحيدِه واتِّباعِ رُسُلِه."},{"w":"مُتۡرَفِيهَا","m":"مُنَعَّمِيها، وهم الرؤساءُ والكبراءُ فيها."},{"w":"فَفَسَقُواْ","m":"فخَرَجُوا عن أمرِ ربِّهم وعَصَوْه."},{"w":"فَحَقَّ","m":"وَجَبَ."},{"w":"ٱلۡقَوۡلُ","m":"الوعيدُ والعذابُ."},{"w":"فَدَمَّرۡنَٰهَا تَدۡمِيرٗا","m":"أَهْلَكْناها إهلاكاً مُسْتأصِلاً."}],"17":[{"w":"وَكَمۡ","m":"وكثيراً."},{"w":"ٱلۡقُرُونِ","m":"الأُمَمِ المكذِّبةِ."}],"18":[{"w":"ٱلۡعَاجِلَةَ","m":"الحياةَ الدنيا."},{"w":"يَصۡلَىٰهَا","m":"يَدْخُلها."},{"w":"مَذۡمُومٗا","m":"مَلُوماً."},{"w":"مَدۡحُورٗا","m":"مَطْروداً من رحمةِ اللهِ."}],"19":[{"w":"مَشۡكُورٗا","m":"مقبولاً عندَ اللهِ، وسيُثِيبُهم عليه."}],"20":[{"w":"كُلّٗا نُّمِدُّ","m":"نَزيدُ كُلّاً من الفريقَين من غيرِ انقطاعٍ."},{"w":"عَطَآءِ رَبِّكَ","m":"رزقِه."},{"w":"مَحۡظُورًا","m":"ممنوعاً عن أحدٍ."}],"22":[{"w":"فَتَقۡعُدَ","m":"فتَصيرَ."},{"w":"مَذۡمُومٗا","m":"من اللهِ وملائكتِه وصالحي المؤمنين."}],"23":[{"w":"وَقَضَىٰ","m":"حَكَمَ وأَمَرَ."},{"w":"أُفّٖ","m":"كلمةٌ تَدُلُّ على التضجُّرِ والاستثقالِ."},{"w":"وَلَا تَنۡهَرۡهُمَا","m":"لا يَصْدُرْ منك إليهما قولٌ قبيحٌ."},{"w":"كَرِيمٗا","m":"طَيِّباً حَسَناً مَقْروناً بالاحترامِ والحياءِ."}],"24":[{"w":"وَٱخۡفِضۡ لَهُمَا جَنَاحَ ٱلذُّلِّ","m":"وكُنْ متواضِعاً مُتَذَلِّلاً لأمِّك وأبيك."},{"w":"مِنَ ٱلرَّحۡمَةِ","m":"لرِقَّتِك ورحمتِك بهما."}],"25":[{"w":"لِلۡأَوَّٰبِينَ","m":"الرَّجَّاعين إلى اللهِ بالتوبةِ والإنابةِ."}],"26":[{"w":"وَءَاتِ","m":"وأعْطِ."},{"w":"وَٱلۡمِسۡكِينَ","m":"الذي لا يَمْلِكُ ما يَكْفيه ويَسُدُّ حاجتَه."},{"w":"وَٱبۡنَ ٱلسَّبِيلِ","m":"المسافرَ المنقطعَ عن مالِه في سَفَرِه، وإن كان غنياً في بلدِه."},{"w":"وَلَا تُبَذِّرۡ","m":"لا تُنْفِقْ مالَكَ في غيرِ موضِعِه الموافِقِ للشَّرعِ."}],"27":[{"w":"إِخۡوَٰنَ ٱلشَّيَٰطِينِ","m":"أشباهَهم وقُرَناءَهم في الفسادِ والمعاصي."}],"28":[{"w":"ٱبۡتِغَآءَ رَحۡمَةٖ","m":"طَلَباً لرزقٍ تنتظرُه."},{"w":"مَيۡسُورٗا","m":"لَيِّناً لطيفاً."}],"29":[{"w":"مَغۡلُولَةً","m":"مقبوضَةً عن الإنفاقِ في الخيرِ."},{"w":"وَلَا تَبۡسُطۡهَا كُلَّ ٱلۡبَسۡطِ","m":"لا تُسْرِفْ، ولا تتوسَّعْ في النفقةِ فوقَ طاقَتِك."},{"w":"مَحۡسُورًا","m":"نادماً على إسرافِك وضَياعِ مالِك."}],"30":[{"w":"يَبۡسُطُ ٱلرِّزۡقَ","m":"يُوَسِّعُه."},{"w":"وَيَقۡدِرُ","m":"ويُضَيِّقُه."}],"31":[{"w":"إِمۡلَٰقٖ","m":"فَقْرٍ."},{"w":"خِطۡـٔٗا","m":"إثماً."}],"32":[{"w":"فَٰحِشَةٗ","m":"فَعْلَةً قبيحةً ظاهرةَ القُبْحِ."},{"w":"وَسَآءَ سَبِيلٗا","m":"بئسَ الطريقُ طريقُه."}],"33":[{"w":"فَقَدۡ جَعَلۡنَا","m":"بما أَذِنَ فيه الشَّرْعُ؛ كالقِصاصِ."},{"w":"لِوَلِيِّهِۦ","m":"لِمَنْ يَلي أمرَه مِنْ وارثٍ أو حاكمٍ."},{"w":"سُلۡطَٰنٗا","m":"حُجَّةً في طَلَبِ قَتْلِ القاتلِ أو الدِّيَةِ."},{"w":"فَلَا يُسۡرِف فِّي ٱلۡقَتۡلِ","m":"لا يُجاوِزِ الحَدَّ المشروعَ فيه."}],"34":[{"w":"ٱلۡيَتِيمِ","m":"مَنْ مات أبوه وهو دونَ سِنِّ البُلوغِ."},{"w":"هِيَ أَحۡسَنُ","m":"بالطريقةِ الحُسنىٰ."},{"w":"يَبۡلُغَ أَشُدَّهُۥ","m":"قوتَه على حِفْظِ مالِه، وحُسْنِ التصرُّفِ فيه."},{"w":"مَسۡـُٔولٗا","m":"يُسأَل صاحبُ العهدِ عنه، ويحاسَبُ يومَ القيامةِ."}],"35":[{"w":"بِٱلۡقِسۡطَاسِ ٱلۡمُسۡتَقِيمِ","m":"بالميزانِ السَّوِيِّ."},{"w":"تَأۡوِيلٗا","m":"مآلاً وعاقبةً عندَ اللهِ."}],"36":[{"w":"وَلَا تَقۡفُ","m":"لا تَتَّبِعْ."},{"w":"مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٌ","m":"ما لا عِلْمَ لك به من قولٍ أو فِعْلٍ."},{"w":"وَٱلۡفُؤَادَ","m":"القلبَ."},{"w":"مَسۡـُٔولٗا","m":"أي: صاحبُها، يُسْأَلُ عَمَّا فَعَلَ بها."}],"37":[{"w":"مَرَحًا","m":"فَخْراً وتكبُّراً."},{"w":"لَن تَخۡرِقَ ٱلۡأَرۡضَ","m":"تَثْقُبَها بمَشْيِك عليها بهذه الصفةِ."}],"38":[{"w":"كُلُّ ذَٰلِكَ","m":"ما تَقَدَّم ذِكْرُه من الأوامرِ والنَّواهي."},{"w":"كَانَ سَيِّئُهُۥ","m":"السَّيِّئُ منه، هو المَنْهِيَّاتُ."}],"39":[{"w":"ٱلۡحِكۡمَةِ","m":"الأحكامِ المُحْكَمَةِ التي لا يَتَطرَّقُ إليها الفسادُ."},{"w":"مَدۡحُورًا","m":"مَطْروداً من رحمةِ اللهِ."}],"40":[{"w":"أَفَأَصۡفَىٰكُمۡ","m":"اختاركم وخَصَّكم."}],"41":[{"w":"صَرَّفۡنَا","m":"بيَّنَّا، ونَوَّعْنا القولَ في أساليبَ مختلفةٍ."}],"42":[{"w":"سَبِيلٗا","m":"طريقاً إلى المغالَبَةِ."}],"43":[{"w":"سُبۡحَٰنَهُۥ","m":"تنزيهاً لله."}],"44":[{"w":"يُسَبِّحُ بِحَمۡدِهِۦ","m":"يُنَزِّهُ اللهَ تنزيهاً مَقْروناً بالثناءِ والحمدِ له."},{"w":"لَا تَفۡقَهُونَ","m":"لا تَفْهَمُون ولا تُدْرِكُون."},{"w":"حَلِيمًا","m":"لا يُعاجِلُ بالعقوبةِ مَنِ انطمَسَتْ بَصيرتُه فعَصاه."}],"45":[{"w":"حِجَابٗا مَّسۡتُورٗا","m":"مانِعاً ساتِراً، يَمْنَعُ عقولَهم عن فَهْمِ القُرآنِ والانتفاعِ به؛ عقوبةً لهم على كُفرِهم."}],"46":[{"w":"أَكِنَّةً","m":"أغْطِيَةً."},{"w":"وَقۡرٗا","m":"ثِقَلاً وصَمَماً عن استماعِ القرآنِ وتَدَبُّرِه."},{"w":"وَحۡدَهُۥ","m":"داعياً لتوحيدِه، ناهياً عن الشِّرك بِه."},{"w":"وَلَّوۡاْ عَلَىٰٓ أَدۡبَٰرِهِمۡ","m":"أَدْبَرُوا راجِعين."},{"w":"نُفُورٗا","m":"نافِرين من قولِك؛ تَكَبُّراً عن الحقّ."}],"47":[{"w":"بِمَا يَسۡتَمِعُونَ بِهِۦٓ","m":"بما يستمعون القرآنَ، وقَصْدُهم السخريةُ والتكذيبُ."},{"w":"وَإِذۡ هُمۡ نَجۡوَىٰٓ","m":"ونَعْلَمُ ما هم مُتَسَارُّون بينهم في شأنِكِ."},{"w":"مَسۡحُورًا","m":"أصابَه السِّحْرُ فاختلطَ عَقْلُه."}],"48":[{"w":"ٱنظُرۡ","m":"تأمَّلْ وتَعَجَّبْ."},{"w":"ضَرَبُواْ لَكَ ٱلۡأَمۡثَالَ","m":"شَبَّهُوك فقالُوا: ساحِرٌ، وتارةً شاعرٌ، وتارةً مجنونٌ، مع عِلْمِهم بخِلافِه."},{"w":"فَضَلُّواْ","m":"انحرَفُوا."},{"w":"سَبِيلٗا","m":"طريقاً إلى الحقِّ والصوابِ."}],"49":[{"w":"وَرُفَٰتًا","m":"أجزاءً مُتَكَسِّرةً مُتَفَتِّتَةً."}],"51":[{"w":"يَكۡبُرُ فِي صُدُورِكُمۡ","m":"يَعْظُمُ ويُسْتَبْعَدُ في عقولِكم قَبولُه للحياةِ، كالسمواتِ."},{"w":"يُعِيدُنَا","m":"يُرْجِعُنا إلى الحياةِ بعدَ موتِنا."},{"w":"فَطَرَكُمۡ","m":"خَلَقَكم من غيرِ مثالٍ سابقٍ."},{"w":"فَسَيُنۡغِضُونَ إِلَيۡكَ رُءُوسَهُمۡ","m":"سيُحَرِّكُونها استهزاءً وتعجُّباً."},{"w":"مَتَىٰ هُوَ","m":"أي: البعثُ."}],"52":[{"w":"يَدۡعُوكُمۡ","m":"يُناديكم خالقُكم على لسانِ المَلَكِ؛ للخروجِ من قبورِكم."},{"w":"بِحَمۡدِهِۦ","m":"بأمرِ اللهِ، حامدين اللهَ على كمالِ قدرتِه."}],"53":[{"w":"يَنزَغُ","m":"يُفْسِدُ ويُوَسْوِسُ."},{"w":"مُّبِينٗا","m":"واضحَ العداوةِ."}],"54":[{"w":"وَكِيلٗا","m":"مُفَوَّضاً إليك أمرُهم."}],"55":[{"w":"فَضَّلۡنَا بَعۡضَ ٱلنَّبِيِّـۧنَ","m":"بالفضائلِ وإنزالِ الكتبِ."},{"w":"زَبُورٗا","m":"الكتابُ المنزَّلُ على داودَ عليه السلام، وكلُّه تحميدٌ وثناءٌ على اللهِ."}],"56":[{"w":"كَشۡفَ ٱلضُّرِّ","m":"إزالتَه."},{"w":"تَحۡوِيلًا","m":"نَقْلَه إلى غيرِكم، أوتبديلَه من حالٍ إلى أخرى."}],"57":[{"w":"ٱلَّذِينَ يَدۡعُونَ","m":"اتخذهم المُشْركون آلهةً؛ كالملائكة والأنبياء."},{"w":"يَبۡتَغُونَ","m":"يَطْلبون باجتهادٍ."},{"w":"ٱلۡوَسِيلَةَ","m":"القُرْبةَ بالطاعةِ والدرجةِ العُليا."},{"w":"أَيُّهُمۡ أَقۡرَبُ","m":"يَطْلُبها الذي هو أقربُ إلى اللهِ، فكيف بمَنْ دونَه؟"},{"w":"مَحۡذُورٗا","m":"حقيقاً بأن يَحْذَرَه العِبادُ."}],"58":[{"w":"وَإِن مِّن قَرۡيَةٍ","m":"وما مِنْ قريةٍ كَذَّب أهلُها."},{"w":"فِي ٱلۡكِتَٰبِ","m":"في اللَّوحِ المحفوظِ."},{"w":"مَسۡطُورٗا","m":"مَكْتوباً."}],"59":[{"w":"بِٱلۡأٓيَٰتِ","m":"بالمُعْجزاتِ التي اقترحها المشركون."},{"w":"مُبۡصِرَةٗ","m":"معجزةً واضحةً."},{"w":"فَظَلَمُواْ بِهَا","m":"فكفَرُوا بها فأَهْلَكَهم اللهُ."}],"60":[{"w":"أَحَاطَ بِٱلنَّاسِ","m":"عِلْماً وقُدرةً، فهُم في قَبْضَتِه، ولا يَخْرجُون عن مشيئتِه."},{"w":"ٱلرُّءۡيَا","m":"ما عاينَه النبيُّ ﷺ ليلةَ الإسراءِ والمعراجِ من عجائبِ مخلوقاتِ اللهِ."},{"w":"فِتۡنَةٗ","m":"ابتلاءً وامتحاناً."},{"w":"وَٱلشَّجَرَةَ ٱلۡمَلۡعُونَةَ","m":"شجرةَ الزَّقُّومِ، جَعَلَها اللهُ ابتلاءً لبعضِ الناس الذين أنكروا خَلْقَ شجرةٍ في النارِ."},{"w":"وَنُخَوِّفُهُمۡ","m":"نُخَوِّفُ المشركين بأصنافِ الوعيدِ والعذابِ."},{"w":"طُغۡيَٰنٗا","m":"تجاوُزاً للحَدِّ في الكفرِ والضَّلالِ."}],"61":[{"w":"ٱسۡجُدُواْ لِأٓدَمَ","m":"تحيةً وإكراماً له وإظهاراً لفضلِه، لا عِبادةً."}],"62":[{"w":"أَرَءَيۡتَكَ","m":"أخْبِرْني."},{"w":"لَأَحۡتَنِكَنَّ ذُرِّيَّتَهُۥٓ","m":"لأَسْتَوْلِيَنَّ عليهم بالإغواءِ والإضلالِ."},{"w":"إِلَّا قَلِيلٗا","m":"مَنْ عَصَمَه اللهُ تعالى مِنْ عبادِه."}],"64":[{"w":"وَٱسۡتَفۡزِزۡ","m":"واستَخِفَّ، أو أَزْعِجْ."},{"w":"بِصَوۡتِكَ","m":"بدَعْوَتِك إياهم إلى المعاصي والآثام."},{"w":"وَأَجۡلِبۡ عَلَيۡهِم","m":"واستحِثَّهم، واجْمَعْ عليهم كلَّ ما تَقْدِرُ عليه مِن جنودِك."},{"w":"بِخَيۡلِكَ وَرَجِلِكَ","m":"من كلِّ راكبٍ وماشٍ في المعصيةِ والفَسادِ."},{"w":"وَشَارِكۡهُمۡ فِي ٱلۡأَمۡوَٰلِ","m":"بتحريضِهم على كَسْبِ الأموالِ المحرَّمةِ، وإنفاقِها فيما يُغضبُ اللهَ."},{"w":"وَٱلۡأَوۡلَٰدِ","m":"وبتَزْيِينِ إنجابِهم عن طريقِ الزِّنى، أو التخلُّصِ منهم، وتجاوزِ حدودِ الشَّرعِ."},{"w":"غُرُورًا","m":"وَعْداً باطلاً خادِعاً."}],"65":[{"w":"سُلۡطَٰنٞ","m":"تَسَلُّطٌ وقوةٌ على إغوائِهم."},{"w":"وَكِيلٗا","m":"حافِظاً لعبادِه."}],"66":[{"w":"يُزۡجِي","m":"يُجْري ويُسَيِّرُ برِفْقٍ."},{"w":"ٱلۡفُلۡكَ","m":"السُّفُنَ."},{"w":"لِتَبۡتَغُواْ","m":"لتَطْلُبُوا."},{"w":"مِن فَضۡلِهِۦٓ","m":"مِنْ رزقِ اللهِ."}],"67":[{"w":"ٱلضُّرُّ","m":"الشِّدَّةُ وخَوْفُ الغَرَقِ."},{"w":"ضَلَّ","m":"غابَ عن عقولِكم."},{"w":"مَن تَدۡعُونَ إِلَّآ إِيَّاهُ","m":"الذين تَعْبُدُونهم من الآلهةِ، وتَذَكَّرْتُم اللهَ وحدَه."}],"68":[{"w":"يَخۡسِفَ بِكُمۡ جَانِبَ ٱلۡبَرِّ","m":"يُغَوِّرَ بكم الأرضَ، ويُغيِّبَكم فيها."},{"w":"حَاصِبٗا","m":"المَطَرَ الذي فيه حِجارةٌ من السماء، أو ريحاً شديدة تَرْمي بالحصَى الصِّغارِ."},{"w":"وَكِيلًا","m":"حَفيظاً وناصِراً من الله."}],"69":[{"w":"فِيهِ","m":"في البحر."},{"w":"قَاصِفٗا","m":"شديدةً عاصفةً، تُكَسِّرُ كلَّ ما أتَتْ عليه."},{"w":"تَبِيعٗا","m":"مُطالِباً بما فَعَلْنا، ونصيراً يأخذُ بالثأرِ لكم."}],"70":[{"w":"كَرَّمۡنَا بَنِيٓ ءَادَمَ","m":"بالرسُلِ والرِّسالات، وغيرِها من النِّعَمِ. ومَنحْناهم عقولاً يُدْرِكون بها ويُمَيِّزون."}],"71":[{"w":"يَوۡمَ","m":"أي: يومَ القيامةِ."},{"w":"بِإِمَٰمِهِمۡ","m":"بمَنِ اقتَدَوْا به في الدُّنيا من كتابٍ، أو نبيّ، أو قائدٍ."},{"w":"كِتَٰبَهُۥ","m":"كتابَ أعمالِه."},{"w":"فَتِيلٗا","m":"مِقْدارَ الخيطِ الذي في شَقِّ النَّواة."}],"72":[{"w":"فِي هَٰذِهِۦٓ أَعۡمَىٰ","m":"في الدُّنيا أعمى القَلْبِ والبَصيرةِ."}],"73":[{"w":"وَإِن كَادُواْ","m":"ولقد قارَبَ المشركون."},{"w":"لَيَفۡتِنُونَكَ","m":"لَيَصْرِفُونك ويَخْدَعُونك في ظَنِّهم."},{"w":"لِتَفۡتَرِيَ عَلَيۡنَا","m":"لِتَتَقَوَّلَ علينا ممَّا اقترحُوه عليك."},{"w":"لَٱتَّخَذُوكَ خَلِيلٗا","m":"خَصُّوك بالصداقةِ الخاصَّةِ."}],"74":[{"w":"تَرۡكَنُ","m":"تميلُ."}],"75":[{"w":"ضِعۡفَ ٱلۡحَيَوٰةِ وَضِعۡفَ ٱلۡمَمَاتِ","m":"عذاباً مُضاعَفاً مِثْلَي ما يُعَذَّبُ به غيرُك في الدنيا والآخِرَةِ."}],"76":[{"w":"لَيَسۡتَفِزُّونَكَ","m":"لَيُزْعِجُونك بعَداوتهم لِيُخْرِجُوك."},{"w":"مِنَ ٱلۡأَرۡضِ","m":"من مكةَ."},{"w":"وَإِذٗا","m":"لو أخرجُوك."},{"w":"خِلَٰفَكَ","m":"بَعْدَك."}],"77":[{"w":"تَحۡوِيلًا","m":"تَبْديلاً."}],"78":[{"w":"لِدُلُوكِ ٱلشَّمۡسِ","m":"وقتِ ميلِها عن وَسَطِ السماءِ، وهو الزَّوالُ في الظَّهيرةِ."},{"w":"غَسَقِ ٱلَّيۡلِ","m":"إقبالِ ظُلْمَتِه وسَوادِه."},{"w":"وَقُرۡءَانَ ٱلۡفَجۡرِ","m":"وأقِمْ صَلاةَ الفجرِ."},{"w":"مَشۡهُودٗا","m":"تَحْضُرُها ملائكةُ الليلِ، وملائكةُ النهارِ."}],"79":[{"w":"فَتَهَجَّدۡ بِهِۦ","m":"فاقْرأ القرآنَ في صلاةِ الليلِ."},{"w":"نَافِلَةٗ لَّكَ","m":"زيادةً لك، وفضيلةً ورَفْعَ دَرَجاتٍ."},{"w":"مَقَامٗا مَّحۡمُودٗا","m":"شافِعاً للناسِ عند فَصْلِ القضاءِ بينَهم، يحْمَدُكَ فيه الأوَّلون والآخِرون."}],"80":[{"w":"مُدۡخَلَ صِدۡقٖ","m":"إدخالاً مَرْضِيّاً لا أَرى فيه ما أَكْرَهُ."},{"w":"مُخۡرَجَ صِدۡقٖ","m":"إخراجاً مَرْضِيّاً مما هو شَرٌّ لي."},{"w":"سُلۡطَٰنٗا","m":"حُجَّةً بيِّنةً ثابتةً، أو قوَّةً وعِزّاً."},{"w":"نَصِيرٗا","m":"ناصراً ومُعِيناً على مَنْ خالفني."}],"81":[{"w":"ٱلۡحَقُّ","m":"الإسلامُ."},{"w":"وَزَهَقَ ٱلۡبَٰطِلُ","m":"ذَهَبَ وبَطَل الشِّرْكُ."}],"82":[{"w":"خَسَارٗا","m":"ضَلالاً وهَلاكاً؛ بسبب كُفْرِهم."}],"83":[{"w":"وَنَـَٔا بِجَانِبِهِۦ","m":"تباعَدَ عن شُكْرِ اللهِ وطاعَتِه؛ تَكَبُّراً."},{"w":"ٱلشَّرُّ","m":"الشِّدَّةُ والضَّرَرُ."},{"w":"يَـُٔوسٗا","m":"شديدَ اليأسِ من رحمةِ اﷲ."}],"84":[{"w":"شَاكِلَتِهِۦ","m":"ما يُجانِسُ أخلاقَه التي اعتادَ عليها."}],"85":[{"w":"مِنۡ أَمۡرِ رَبِّي","m":"مما استأثرَ اللهُ تعالى بعِلْمِها."}],"86":[{"w":"لَنَذۡهَبَنَّ بِٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ","m":"لَمَحَوْنا القرآنَ من القلوبِ والمصاحِفِ، حتى لا يَبْقَى له أثرٌ."},{"w":"وَكِيلًا","m":"مَن يَلْتزِمُ باستردادِه بعد الذَّهابِ به."}],"87":[{"w":"إِلَّا رَحۡمَةٗ مِّن رَّبِّكَ","m":"لكن رحمةً من اللهِ أبقَيْنا القرآنَ فلم نُذْهِبْه."}],"88":[{"w":"ظَهِيرٗا","m":"مُعِيناً على تحقيقِ مُرادِهم."}],"89":[{"w":"صَرَّفۡنَا","m":"بَيَّنَّا ونَوَّعْنا بأساليبَ مختلفةٍ."},{"w":"كُلِّ مَثَلٖ","m":"كلِّ معنى يَحْصُلُ الاتعاظُ به."},{"w":"كُفُورٗا","m":"جُحوداً للحَقِّ."}],"90":[{"w":"يَنۢبُوعًا","m":"عَيْناً لا يَجِفُّ ماؤُها."}],"91":[{"w":"جَنَّةٞ","m":"حديقةٌ."},{"w":"فَتُفَجِّرَ ٱلۡأَنۡهَٰرَ","m":"تُجْرِيها بقُوَّةٍ."}],"92":[{"w":"كِسَفًا","m":"قِطَعاً."},{"w":"قَبِيلًا","m":"مقابَلَةً وعِياناً."}],"93":[{"w":"زُخۡرُفٍ","m":"ذَهَبٍ."},{"w":"تَرۡقَىٰ","m":"تَصْعَدَ."},{"w":"سُبۡحَانَ رَبِّي","m":"تَنْزيهاً للهِ عن اقتراحاتهم، وتَعجُّباً من شِدَّةِ كُفْرِهم."}],"95":[{"w":"مُطۡمَئِنِّينَ","m":"ساكنِين فيها."}],"97":[{"w":"وَبُكۡمٗا","m":"لايَنْطِقُون."},{"w":"وَصُمّٗا","m":"لا يَسْمَعُون."},{"w":"مَأۡوَىٰهُمۡ","m":"مَصيرُهم."},{"w":"خَبَتۡ","m":"سَكَنَ لَهَبُها."},{"w":"سَعِيرٗا","m":"تَوَقُّداً واشتِعالاً."}],"98":[{"w":"ذَٰلِكَ","m":"الموصوفُ من العذابِ."},{"w":"وَرُفَٰتًا","m":"أجزاءً مُتَفَتِّتَةً."}],"99":[{"w":"أَجَلٗا","m":"وَقْتاً مُحَدَّداً للموتِ والحسابِ."},{"w":"لَا رَيۡبَ فِيهِ","m":"لا شَكَّ في وقوعِه."},{"w":"كُفُورٗا","m":"جُحوداً للحَقِّ."}],"100":[{"w":"رَحۡمَةِ رَبِّيٓ","m":"رِزْقِه وسائرِ نِعَمِه."},{"w":"قَتُورٗا","m":"بخيلاً مَنُوعاً."}],"101":[{"w":"ءَايَٰتِۭ بَيِّنَٰتٖ","m":"معجزاتٍ واضحاتِ الدَّلالةِ على نُبُوَّتِه."},{"w":"فَسۡـَٔلۡ","m":"سؤالَ تقريرٍ على صِدْقِك."},{"w":"مَسۡحُورٗا","m":"أصابكَ السِّحْرُ؛ فاختلطَ عَقْلُكَ."}],"102":[{"w":"هَٰٓؤُلَآءِ","m":"المعجزاتِ التسعَ."},{"w":"بَصَآئِرَ","m":"دَلالاتٍ وعِبَراً يُستَدَلُّ بها على وَحدانيةِ اللهِ وقدرتِه."},{"w":"لَأَظُنُّكَ","m":"لَمُوقِنٌ كَوْنَكَ."},{"w":"مَثۡبُورٗا","m":"مُهْلَكاً، أو ممنوعاً عن الخير، مطبوعاً على الشَّرِّ."}],"103":[{"w":"يَسۡتَفِزَّهُم","m":"يُزْعِجَهم بعَداوتِه ليُخْرِجَهم."},{"w":"مِنَ ٱلۡأَرۡضِ","m":"من أرضِ مصرَ."}],"104":[{"w":"ٱلۡأَرۡضَ","m":"أرضَ مصرَ والشام."},{"w":"وَعۡدُ ٱلۡأٓخِرَةِ","m":"يومُ القِيامةِ."},{"w":"لَفِيفٗا","m":"جميعاً، مختلِطِين من كلِّ نوعٍ، لا تتعارفُون."}],"106":[{"w":"فَرَقۡنَٰهُ","m":"أَوْضَحْناه، وفَرَقْنا فيه بين الحقِّ والباطِل."},{"w":"عَلَىٰ مُكۡثٖ","m":"على تَمَهُّلٍ وتَأَنٍّ؛ ليَفْهموه، ويَتَيَسَّرَ لهم حِفْظُه."},{"w":"وَنَزَّلۡنَٰهُ تَنزِيلٗا","m":"على حَسَبِ الحوادث، والمصالحِ، والأحوالِ."}],"107":[{"w":"مِن قَبۡلِهِۦٓ","m":"من قَبْلِ القرآنِ."},{"w":"يَخِرُّونَ لِلۡأَذۡقَانِ سُجَّدٗا","m":"يَسْقُطون بسرعةٍ ساجدين على وجوهِهم؛ تعظيماً لله وشُكْراً له."}],"108":[{"w":"سُبۡحَٰنَ رَبِّنَآ","m":"تنزيهاً له على قُدرتِه التامةِ، وأنه لا يُخْلِفُ الميعادَ."},{"w":"لَمَفۡعُولٗا","m":"مُنْجَزاً واقعاً."}],"109":[{"w":"خُشُوعٗا","m":"سُكوناً، وضَراعةً، وخُضوعاً."}],"110":[{"w":"بِصَلَاتِكَ","m":"بقراءتِك في الصلاةِ."},{"w":"وَلَا تُخَافِتۡ","m":"ولا تُسِرَّ."},{"w":"وَٱبۡتَغِ","m":"اقْصِدْ."},{"w":"بَيۡنَ ذَٰلِكَ","m":"بينَ الجَهْرِ بقراءتِك والإسرارِ بها."},{"w":"سَبِيلٗا","m":"طريقاً وسَطاً."}],"111":[{"w":"وَلِيّٞ مِّنَ ٱلذُّلِّ","m":"ناصرٌ ومُعِينٌ لذُلٍّ يَلْحَقُه، فهو الغَنِيُّ العزيزُ القَوِيُّ."},{"w":"وَكَبِّرۡهُ تَكۡبِيرَۢا","m":"عَظِّمْه تعظيماً تامّاً مع كمالِ التنزيهِ."}]}