{"1":[{"w":"وَضُحَىٰهَا","m":"أَقْسَمَ اللهُ بإشْرَاقِ الشَّمْسِ ضُحىً."}],"2":[{"w":"تَلَىٰهَا","m":"تَبِعَها في الطُّلُوعِ والأُفُول."}],"3":[{"w":"جَلَّىٰهَا","m":"جَلَّى الظُّلْمةَ وكَشَفَها."}],"4":[{"w":"يَغۡشَىٰهَا","m":"يُغَطِّي الأَرْضَ فيكُونُ ما عَلَيها مُظْلِماً."}],"5":[{"w":"وَمَا بَنَىٰهَا","m":"وَبِنائِها المُحْكَمِ."}],"6":[{"w":"وَمَا طَحَىٰهَا","m":"وبَسْطِها."}],"7":[{"w":"وَمَا سَوَّىٰهَا","m":"وَإِكْمالِ اللهِ خَلْقَها لأداءِ مُهِمَّتِها."}],"8":[{"w":"فَأَلۡهَمَهَا","m":"فَبيَّنَ لَها."},{"w":"فُجُورَهَا","m":"طَرِيقَ الشَّرِّ."},{"w":"وَتَقۡوَىٰهَا","m":"وَطَرِيقَ الخيرِ."}],"9":[{"w":"أَفۡلَحَ","m":"فاز."},{"w":"زَكَّىٰهَا","m":"طَهَّرَها، ونَمَّاها بالخيرِ."}],"10":[{"w":"خَابَ","m":"خَسِرَ."},{"w":"دَسَّىٰهَا","m":"أَخْفَى نَفْسَهُ في المعاصِي."}],"11":[{"w":"بِطَغۡوَىٰهَآ","m":"بِبُلُوغِها الغايةَ في العِصْيانِ."}],"12":[{"w":"ٱنۢبَعَثَ","m":"نَهَضَ لِعَقْرِ النَّاقةِ."},{"w":"أَشۡقَىٰهَا","m":"أَكْثَرُ القبيلةِ شَقاوَةً."}],"13":[{"w":"نَاقَةَ ٱللَّهِ","m":"احْذَرُوا أَن تَمَسُّوا النَّاقَةَ بسُوءٍ."},{"w":"وَسُقۡيَٰهَا","m":"واحذَرُوا أن تَعْتَدُوا على سَقْيِها."}],"14":[{"w":"فَعَقَرُوهَا","m":"فَنَحَرُوها."},{"w":"فَدَمۡدَمَ عَلَيۡهِمۡ","m":"فَأَطْبَقَ عليهِم العُقُوبةَ."},{"w":"فَسَوَّىٰهَا","m":"فَجَعَلَها عَلَيهِم على السَّواءِ، فلم يُفْلِتْ مِنهُم أَحَدٌ."}],"15":[{"w":"عُقۡبَٰهَا","m":"تَبِعةَ ما أَنزَلَهُ بِهِم مِنَ العِقابِ."}]}