{"1":[{"w":"تَبَارَكَ","m":"تَكَاثَرَ خَيْرُه، وعَظُمَتْ بَرَكَاتُه."},{"w":"ٱلۡفُرۡقَانَ","m":"القُرآنَ، الفارقَ بَيْنَ الحقِّ والْبَاطِلِ."},{"w":"نَذِيرًا","m":"مُخَوِّفاً."}],"2":[{"w":"فَقَدَّرَهُۥ","m":"أي: فَهَيَّأَه لِمَا يَصْلُحُ لَهُ وَيلِيقُ بِهِ."}],"3":[{"w":"نُشُورٗا","m":"بَعْثاً بَعْدَ الموتِ."}],"4":[{"w":"هَٰذَآ","m":"أي: القرآنُ."},{"w":"إِفۡكٌ","m":"كَذِبٌ وبُهْتانٌ."},{"w":"ٱفۡتَرَىٰهُ","m":"اختَلَقَه وتَقَوَّلَه."},{"w":"قَوۡمٌ ءَاخَرُونَ","m":"أي: من الَّذينَ أسْلَمُوا مِنْ أَهْلِ الكِتابِ."},{"w":"وَزُورٗا","m":"كَذِباً عظِيماً."}],"5":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"الأكاذيبُ الَّتي كَتَبها المتقدِّمُونَ."},{"w":"ٱكۡتَتَبَهَا","m":"طَلَبَ كِتابَتَها."},{"w":"تُمۡلَىٰ عَلَيۡهِ","m":"تُقْرَأُ عَلَيهِ لِيَحْفَظَها."}],"6":[{"w":"ٱلسِّرَّ","m":"هو كلُّ ما يَغِيبُ ويَخْفَى."}],"8":[{"w":"جَنَّةٞ","m":"أي: بُسْتانٌ مُثْمِرٌ."},{"w":"مَسۡحُورًا","m":"مَجْنُوناً، غَلَبَ السِّحرُ على عَقْلِه."}],"10":[{"w":"جَنَّٰتٖ","m":"بَسَاتِينَ وحَدَائقَ."},{"w":"قُصُورَۢا","m":"بُيُوتاً مُشَيَّدةً."}],"11":[{"w":"وَأَعۡتَدۡنَا","m":"وجَعَلْناه مُعَدّاً لهم."},{"w":"سَعِيرًا","m":"أي: ناراً مُشْتَعِلةً تُسَعَّر بهم."}],"12":[{"w":"تَغَيُّظٗا","m":"صَوْتَ غَلَيانٍ وفَوَرانٍ."},{"w":"وَزَفِيرٗا","m":"النَّفَسَ الخارِجَ مِنَ الجَوفِ بِشِدَّةٍ."}],"13":[{"w":"مِنۡهَا","m":"أي: مِن جَهَنَّمَ."},{"w":"مُقَرَّنِينَ","m":"مُقَيَّدةً أيدِيهِم إلى أعْناقِهِم."},{"w":"ثُبُورٗا","m":"هَلَاكاً."}],"15":[{"w":"وَمَصِيرٗا","m":"ومَرْجِعاً."}],"16":[{"w":"مَّسۡـُٔولٗا","m":"أي: يَسْأَلُ اللهَ عِبَادُه المتَّقُونَ."}],"18":[{"w":"سُبۡحَٰنَكَ","m":"تَنْزِيهاً لَكَ يا رَبَّنا."},{"w":"مَا كَانَ يَنۢبَغِي لَنَآ","m":"ما كان يَحِقُّ ولا يَصِحُّ لَنا."},{"w":"أَوۡلِيَآءَ","m":"المُرادُ به: آلهةٌ نَعْبُدُهُم."},{"w":"نَسُواْ ٱلذِّكۡرَ","m":"غَفَلُوا عَن دَلَائِلِ الوَحْدَانيَّةِ."},{"w":"بُورٗا","m":"هَالِكِينَ أو فَاسِدِين."}],"19":[{"w":"صَرۡفٗا","m":"دَفْعاً."},{"w":"يَظۡلِم","m":"أي: يُشْرِكْ بِاللهِ."}],"20":[{"w":"فِتۡنَةً","m":"ابْتِلاءً واخْتِباراً."}],"21":[{"w":"لَا