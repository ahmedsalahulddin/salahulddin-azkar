{"1":[{"w":"وَٱلۡفَجۡرِ","m":"أَقْسَم اللهُ بِوَقْتِ الفجْرِ."}],"2":[{"w":"وَلَيَالٍ عَشۡرٖ","m":"هي الليالي العَشْرُ الأُوَلُ مِن ذِي الحِجَّةِ."}],"3":[{"w":"وَٱلشَّفۡعِ","m":"كُلُّ شَيءٍ خَلَقَه اللهُ زَوْجاً فهو شَفْعٌ."},{"w":"وَٱلۡوَتۡرِ","m":"الفَرْدِ."}],"4":[{"w":"يَسۡرِ","m":"يَسْرِي بِظَلامِهِ."}],"5":[{"w":"قَسَمٞ","m":"مَقْنَعٌ ومُكْتَفىً في القَسَمِ."},{"w":"لِذِي حِجۡرٍ","m":"لِصاحِبِ عَقْلٍ."}],"7":[{"w":"إِرَمَ","m":"قَبِيلةِ إِرَمَ."},{"w":"ذَاتِ ٱلۡعِمَادِ","m":"صاحبةِ القُوُّةِ والأبْنِيَةِ المَرْفُوعَةِ على الأعْمِدَةِ."}],"8":[{"w":"مِثۡلُهَا","m":"مِثْلُ تِلْكَ القَبِيلةِ في الطُّولِ والقُوَّةِ."}],"9":[{"w":"جَابُواْ","m":"قَطَعُوا."},{"w":"ٱلصَّخۡرَ","m":"الحَجَرَ العَظِيمَ الصُّلْبَ الَّذِي عَمِلُوا مِنْهُ البُيوتَ."},{"w":"بِٱلۡوَادِ","m":"بِوَادِي القُرَى."}],"10":[{"w":"ذِي ٱلۡأَوۡتَادِ","m":"صاحِبِ الجُنُودِ الَّذِين ثَبَّتُوا مُلكَهُ، وقَوَّوا لَهُ أَمْرَهُ."}],"11":[{"w":"طَغَوۡاْ","m":"تَجَاوَزُوا الحدَّ في الظُّلْمِ."}],"13":[{"w":"فَصَبَّ عَلَيۡهِمۡ","m":"فَغَشَّاهُم."},{"w":"سَوۡطَ عَذَابٍ","m":"عَذاباً شَدِيداً."}],"14":[{"w":"لَبِٱلۡمِرۡصَادِ","m":"لا يفُوتُه شَيءٌ مِنْ أَعْمالِ العِبادِ."}],"15":[{"w":"ٱبۡتَلَىٰهُ","m":"اخْتَبَرَهُ."},{"w":"فَأَكۡرَمَهُۥ","m":"بَسَطَ لَهُ في رِزقِهِ."},{"w":"وَنَعَّمَهُۥ","m":"جَعَلَه في أَطْيَبِ عَيْشٍ."}],"16":[{"w":"ٱبۡتَلَىٰهُ","m":"اخْتَبَرَهُ."},{"w":"فَقَدَرَ","m":"فَضَيَّقَ."},{"w":"أَهَٰنَنِ","m":"أَذَلَّنِي بالفَقْرِ."}],"17":[{"w":"كَلَّا","m":"ليسَ الأمرُ كَما يَظُنُّ هَذا الإِنْسانُ."},{"w":"لَا تُكۡرِمُونَ","m":"لا تُحْسنُونَ مُعامَلةَ."},{"w":"ٱلۡيَتِيمَ","m":"الطِّفْلَ الَّذِي مَاتَ أبُوهُ وهو صَغِيرٌ."}],"18":[{"w":"وَلَا تَحَٰٓضُّونَ","m":"وَلا يَحثُّ بعضُكُم بعْضاً."},{"w":"ٱلۡمِسۡكِينِ","m":"المُحْتاجِ الَّذِي لا يَمْلِكُ ما يَكْفِيهِ."}],"19":[{"w":"ٱلتُّرَاثَ","m":"حُقُوقَ الآخرِينَ في الِميراثِ."},{"w":"لَمّٗا","m":"شَدِيداً، وهو أَن يأكُلَ نَصِيبَهُ وَنَصِيبَ غَيرِه."}],"20":[{"w":"جَمّٗا","m":"كَثِيراً مُفْرِطاً."}],"21":[{"w":"كَلَّآ","m":"لا ينبغِي أَن يكُونَ حالُكُم كَما ذُكِر."},{"w":"دُكَّتِ ٱلۡأَرۡضُ","m":"زُلْزِلَتِ الأرْضُ وكَسَّرَ بَعْضُها بَعْضاً."},{"w":"دَكّٗا دَكّٗا","m":"مَرَّةً بعدَ مَرَّةٍ."}],"22":[{"w":"وَٱلۡمَلَكُ","m":"والملائِكةُ."},{"w":"صَفّٗا صَفّٗا","m":"صُفُوفاً صُفُوفاً."}],"23":[{"w":"يَتَذَكَّرُ ٱلۡإِنسَٰنُ","m":"يتَّعِظُ الكافِرُ ويتُوبُ."},{"w":"وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","m":"ومِنْ أينَ لَهُ التَّوبةُ؟"}],"24":[{"w":"قَدَّمۡتُ","m":"العملَ الصَّالحَ."},{"w":"لِحَيَاتِي","m":"في الآخِرةِ."}],"26":[{"w":"وَلَا يُوثِقُ","m":"ولا يَشُدُّ ويَربِطُ للعذابِ."},{"w":"وَثَاقَهُۥٓ","m":"رَبْطَهُ بالسَّلاسِلِ ونَحْوِهَا للعذَابِ."}],"27":[{"w":"ٱلۡمُطۡمَئِنَّةُ","m":"الموقِنَةُ بِأنَّ اللهَ ربُّها، المطيعةُ لَهُ."}],"28":[{"w":"رَاضِيَةٗ","m":"بالثَّوابِ."},{"w":"مَرۡضِيَّةٗ","m":"مَرْضِيّاً عَنكِ."}],"29":[{"w":"فِي عِبَٰدِي","m":"مَعَ عِبادِي، وقيل: في جُمْلةِ عِبادِي الصَّالحِينَ المُطِيعِينَ."}]}