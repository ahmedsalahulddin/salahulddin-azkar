{"1":[{"w":"ٱلۡوَاقِعَةُ","m":"القِيامَةُ."}],"2":[{"w":"كَاذِبَةٌ","m":"لَا يَكُونُ عِنْدَ وُقُوعِها تَكْذِيبٌ."}],"3":[{"w":"خَافِضَةٞ رَّافِعَةٌ","m":"هي خافِضَةٌ يَحْصُلُ عِنْدَها خَفْضُ أَقْوامٍ كانُوا مُرْتَفِعِينَ، وَرَفْعُ أَقْوَامٍ كانُوا مُنْخَفِضِينَ، وَخافِضَةُ جِهاتٍ كانَتْ مُرْتَفِعَةً كالجِبالِ والصَّوامِعِ، رافِعَةٌ ما كانَ مُنْخَفِضاً بِسَبَبِ ما يَحْدُثُ في الكَونِ."}],"4":[{"w":"رُجَّتِ","m":"اضْطَرَبَتْ، بِسَبَبِ الزَّلَازِلِ، والخَسْفِ، ونَحْوِ ذَلِكَ."}],"5":[{"w":"وَبُسَّتِ","m":"فُتِّتَتِ الجبالُ ونُسِفَتْ."}],"6":[{"w":"هَبَآءٗ","m":"ما يَلُوحُ في خُيُوطِ شُعاعِ الشَّمسِ مِن دَقِيقِ الغُبارِ."},{"w":"مُنۢبَثّٗا","m":"مُتَفَرِّقاً."}],"7":[{"w":"أَزۡوَٰجٗا","m":"أَصْنافاً."}],"8":[{"w":"أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","m":"هُمُ الَّذِينَ يُجْعَلُونَ في الجِهَةِ اليُمْنَى فِي الجَنَّةِ، أَوْ فِي الْمَحْشَرِ."}],"9":[{"w":"أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","m":"أَصْحابُ الشَّقاوَةِ الَّذِينَ يُؤْخَذُ بِهِم ذَاتَ الشِّمال إِلى النَّارِ."}],"10":[{"w":"وَٱلسَّٰبِقُونَ","m":"إِلى الخَيْرَاتِ."},{"w":"ٱلسَّٰبِقُونَ","m":"إِلى مُنْتَهَى الفَضْلِ والرِّفْعَةِ."}],"13":[{"w":"ثُلَّةٞ","m":"جَمَاعةٌ."}],"15":[{"w":"سُرُرٖ","m":"جَمْعُ سَرِيرٍ، وهو مَجْلِسُ العُظَماءِ والمُلُوكِ أَيْضاً."},{"w":"مَوۡضُونَةٖ","m":"مَسْبُوكٍ بَعْضُها بِبَعْضٍ."}],"16":[{"w":"مُتَقَٰبِلِينَ","m":"يَجْلِسُ بَعْضُهُم مُقابِلَ بَعْضٍ؛ وَذَلِكَ مِن تَمامِ النَّعِيمِ؛ لِمَا فِيهِ مِنَ الأُنْسِ بِمُشاهَدَةِ الأَصْحابِ والحَدِيثِ مَعَهُم."}],"17":[{"w":"يَطُوفُ","m":"يَدُورُ عَلَى نَحْوٍ دائِمٍ."},{"w":"مُخَلَّدُونَ","m":"أي دائِمُونَ عَلَى الطَّوافِ عَلَيهِم وَمُناوَلَتِهِم."}],"18":[{"w":"بِأَكۡوَابٖ","m":"جَمْعُ كُوبٍ، وهو إِناءُ الخمْرِ."},{"w":"وَأَبَارِيقَ","m":"جَمْعِ إبْريقٍ، وهو إِناءٌ تُحْمَلُ فِيهِ الخمْرُ فتُصَبُّ في الأكْوَابِ."},{"w":"وَكَأۡسٖ","m":"هو إِناءٌ للخَمْرِ كَالْكُوبِ."},{"w":"مَعِينٖ","m":"هو الجارِي، والمُرادُ بِهِ الخَمْرُ الَّتِي لِكَثْرَتِها تَجْرِي، وَلَيسَتْ قَلِيلَةً كَمَا هِي في الدُّنيا."}],"19":[{"w":"لَا يُصَدَّعُونَ","m":"لا يُصِيبُهُم صُدَاعُ الرَّأْسِ."},{"w":"وَلَا يُنزِفُونَ","m":"أي لا يَعْتَرِيهِم اخْتِلاطُ العَقْلِ."}],"20":[{"w":"يَتَخَيَّرُونَ","m":"يَخْتارُونَهُ ويَشْتَهُونَهُ."}],"22":[{"w":"وَحُورٌ","m":"نِساءٌ ذَواتُ حَوَرٍ، أي: نِساءٌ شَدِيداتُ بياضِ العَينِ وسَوَادِها."},{"w":"عِينٞ","m":"وَاسِعاتُ العُيُونِ."}],"23":[{"w":"كَأَمۡثَٰلِ","m":"كأشْباهِ."},{"w":"ٱللُّؤۡلُوِٕ","m":"الدُّرِّ."},{"w":"ٱلۡمَكۡنُونِ","m":"المَخْزُونِ المُخَبَّأِ لِنَفاسَتِهِ."}],"25":[{"w":"لَغۡوٗا","m":"هُوَ الكَلَامُ الَّذِي لا يُعْتَدُّ بِهِ."},{"w":"تَأۡثِيمًا","m":"هُوَ اللَّومُ والإِنْكَارُ."}],"26":[{"w":"سَلَٰمٗا سَلَٰمٗا","m":"سَلَّمْنا سَلَاماً إِثْرَ سَلَامٍ."}],"28":[{"w":"سِدۡرٖ","m":"شَجَرٍ مِن شَجَرِ العِضَاه، ذِي وَرَقٍ عَرِيضٍ مُدَوَّرٍ."},{"w":"مَخۡضُودٖ","m":"أُزِيلَ شَوْكُهُ."}],"29":[{"w":"وَطَلۡحٖ","m":"شَجَرٍ مِن شَجَرِ العِضاه، واحدُه طَلْحةٌ، كَثِيرَةُ الظِّلِّ؛ مِن التِفافِ أَغْصانِها."},{"w":"مَنضُودٖ","m":"مُتَراصٍّ مُتَراكِبٍ بالأغْصانِ."}],"30":[{"w":"وَظِلّٖ مَّمۡدُودٖ","m":"لا يَتَقَلَّصُ كَظِلِّ الدُّنيا."}],"31":[{"w":"وَمَآءٖ مَّسۡكُوبٖ","m":"مَصبُوبٍ."}],"33":[{"w":"لَا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ","m":"دائِمَةٍ مَبْذُولَةٍ لَهُم."}],"34":[{"w":"وَفُرُشٖ","m":"جَمْعُ فِراشٍ، وهو ما يُفْرَشُ."},{"w":"مَرۡفُوعَةٍ","m":"عَلَى الأَسِرَّةِ."}],"42":[{"w":"سَمُومٖ","m":"هي الرِّيحُ الشَّدِيدَةُ الحَرارةِ."},{"w":"وَحَمِيمٖ","m":"هو الماءُ الشَّديدُ الحَرارةِ."}],"43":[{"w":"يَحۡمُومٖ","m":"الدُّخانِ الأَسْوَدِ."}],"45":[{"w":"مُتۡرَفِينَ","m":"ذوي نِعْمَةٍ واسِعةٍ."}],"46":[{"w":"يُصِرُّونَ","m":"يَثْبُتُونَ عَلَيهِ."},{"w":"ٱلۡحِنثِ","m":"الذَّنبِ والمَعْصِيَةِ."},{"w":"ٱلۡعَظِيمِ","m":"القَوِيِّ في نَوْعِهِ، وهو الشِّركُ."}],"50":[{"w":"لَمَجۡمُوعُونَ","m":"يُبْعَثُونَ وَيُحْشَرُونَ جَمِيعاً."}],"52":[{"w":"شَجَرٖ مِّن زَقُّومٖ","m":"شَجَرَةٍ كَرِيهَةِ الرَّائِحَةِ يُنبتُها اللهُ في جَهَنَّمَ."}],"54":[{"w":"ٱلۡحَمِيمِ","m":"هُوَ الماءُ الشَّدِيدُ الغَلَيانِ."}],"55":[{"w":"ٱلۡهِيمِ","m":"جَمْعُ أَهْيَمَ، وَهُوَ البَعِيرُ الَّذِي أصابَهُ الهُيَامُ، وهو دَاءٌ يُصِيبُ الإِبِلَ فلا تَزَالُ تَشْرَبُ وَلَا تَرْوَى."}],"56":[{"w":"نُزُلُهُمۡ","m":"النُّزُلُ هو ما يُقَدَّمُ للضَّيفِ مِن طَعَامٍ."}],"58":[{"w":"تُمۡنُونَ","m":"ما يَكُونُ مِنْكُم مِن المَنِيِّ."}],"60":[{"w":"قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ","m":"قَضَيْنا عَلَيكُم بِالمَوْتِ، أَوْ سَوَّينا بَينَكُم في الموتِ."},{"w":"بِمَسۡبُوقِينَ","m":"بِمَغْلُوبِينَ."}],"61":[{"w":"نُبَدِّلَ أَمۡثَٰلَكُمۡ","m":"نُغَيِّرَ خَلْقَكُم."},{"w":"فِي مَا لَا تَعۡلَمُونَ","m":"مِنَ الصِّفاتِ والأحْوَال."}],"62":[{"w":"ٱلنَّشۡأَةَ ٱلۡأُولَىٰ","m":"خَلْقَ اللهِ إياكُم وَلَمْ تكُونُوا شَيئاً مَذْكُوراً."}],"64":[{"w":"تَزۡرَعُونَهُۥٓ","m":"تُنْبِتُونَهُ."}],"65":[{"w":"حُطَٰمٗا","m":"يابِساً هَشِيماً لا يُنْتَفعُ بِهِ."},{"w":"فَظَلۡتُمۡ","m":"فصِرْتُمْ."},{"w":"تَفَكَّهُونَ","m":"تَعْجَبُونَ مِن يُبْسِهِ بَعْدَ خُضْرَتِهِ."}],"66":[{"w":"إِنَّا لَمُغۡرَمُونَ","m":"لَمُلْزَمُونَ غَرَامَةَ ما أنْفَقْنا."}],"67":[{"w":"مَحۡرُومُونَ","m":"من الرِّزقِ."}],"69":[{"w":"ٱلۡمُزۡنِ","m":"السَّحابِ."}],"70":[{"w":"أُجَاجٗا","m":"شَدِيدَ المُلُوحَةِ."}],"71":[{"w":"تُورُونَ","m":"تُوقِدُونَ."}],"72":[{"w":"شَجَرَتَهَآ","m":"الَّتِي تُقْدَحُ مِنْها النَّارُ."},{"w":"ٱلۡمُنشِـُٔونَ","m":"الخالِقُونَ."}],"73":[{"w":"تَذۡكِرَةٗ","m":"تَذْكِيراً لَكُم بِنارِ جَهَنَّمَ."},{"w":"وَمَتَٰعٗا","m":"وَمَنْفَعَةً."},{"w":"لِلۡمُقۡوِينَ","m":"لِلْمُسَافِرِينَ."}],"74":[{"w":"فَسَبِّحۡ","m":"فنَزِّهْ."}],"75":[{"w":"بِمَوَٰقِعِ ٱلنُّجُومِ","m":"بِمَساقِطِ النُّجُومِ في مَغارِبِها في السَّماءِ."}],"78":[{"w":"مَكۡنُونٖ","m":"مَصُونٍ مَسْتُورٍ، وهو الكِتابُ الَّذِي بأيدِي الملائِكةِ."}],"79":[{"w":"ٱلۡمُطَهَّرُونَ","m":"هُمُ المَلَائِكةُ الَّذِينَ طَهَّرَهُم اللهُ مِنَ الآفاتِ والذُّنُوبِ."}],"81":[{"w":"ٱلۡحَدِيثِ","m":"القرآنِ."},{"w":"مُدۡهِنُونَ","m":"مُكَذِّبُونَ."}],"82":[{"w":"رِزۡقَكُمۡ","m":"شُكْرَكُم لِنِعَمِ اللهِ عَلَيكُم."}],"83":[{"w":"فَلَوۡلَآ","m":"فَهَلَّا."},{"w":"بَلَغَتِ","m":"أي: النَّفْسُ."},{"w":"ٱلۡحُلۡقُومَ","m":"الحَلْقَ."}],"85":[{"w":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ","m":"بِمَلائِكَتِنا، وَلَكِنَّكُم لَا تَرَونَهُم."}],"86":[{"w":"فَلَوۡلَآ","m":"فَهَلَّا."},{"w":"غَيۡرَ مَدِينِينَ","m":"غَيرَ مُحاسَبِينَ ولا مَجْزِيِّينَ بِأَعْمالِكُم."}],"87":[{"w":"تَرۡجِعُونَهَآ","m":"تَرُدُّونَ النَّفْسَ."}],"89":[{"w":"فَرَوۡحٞ","m":"فَلَهُ رَحْمَةٌ وفَرَحٌ عِنْدَ مَوتِهِ."},{"w":"وَرَيۡحَانٞ","m":"مُسْتَراحٌ."}],"91":[{"w":"فَسَلَٰمٞ لَّكَ","m":"فسَلامةٌ لَكَ وأَمْنٌ."}],"93":[{"w":"فَنُزُلٞ","m":"فَضِيافَةٌ."},{"w":"حَمِيمٖ","m":"شَرابِ جَهَنَّمَ المَغْلِيِّ."}],"94":[{"w":"وَتَصۡلِيَةُ جَحِيمٍ","m":"وإِدْخَالُه النَّار؛ لِيُقاسِيَ الحرَّ."}],"95":[{"w":"حَقُّ ٱلۡيَقِينِ","m":"اليَقِينُ حقّاً."}],"96":[{"w":"فَسَبِّحۡ","m":"فَنَزِّهْ."}]}