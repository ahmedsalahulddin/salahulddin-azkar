{"1":[{"w":"صٓ","m":"سَبَقَ الكَلَامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."}],"2":[{"w":"عِزَّةٖ","m":"تكبُّرٍ عَنِ الحقِّ."},{"w":"وَشِقَاقٖ","m":"مُشَاقَّةٍ ومُخَالَفةٍ للهِ ولِرَسُولِهِ."}],"3":[{"w":"كَمۡ أَهۡلَكۡنَا","m":"كَثِيراً أَهْلَكْنا."},{"w":"مِن قَرۡنٖ","m":"مِن أُمَّةٍ."},{"w":"فَنَادَواْ","m":"فاسْتَغَاثُوا حِينَ عايَنُوا العَذَابَ."},{"w":"وَلَاتَ","m":"وَلَيسَ."},{"w":"حِينَ مَنَاصٖ","m":"وقتَ فِرارٍ."}],"4":[{"w":"مُنذِرٞ مِّنۡهُمۡ","m":"رَسُولٌ مِنْهُم."}],"5":[{"w":"عُجَابٞ","m":"عَجِيبٌ."}],"6":[{"w":"ٱلۡمَلَأُ","m":"أشْرافُ القوم ورُؤساؤُهُم."},{"w":"أَنِ ٱمۡشُواْ","m":"أَنِ امْضُوا علَى ما كُنتُم عَلَيهِ ولا تَدْخُلُوا في دِينِه."},{"w":"وَٱصۡبِرُواْ عَلَىٰٓ ءَالِهَتِكُمۡ","m":"أي: اثبُتُوا على عِبادَتِها."},{"w":"لَشَيۡءٞ يُرَادُ","m":"أي: شَيءٌ مُدَبَّرٌ يُريدُهُ محمدٌ بِنا وبآلِهَتِنَا؛ لِيَتَحَكَّمَ فِينا بِما يُرِيدُ."}],"7":[{"w":"ٱلۡمِلَّةِ ٱلۡأٓخِرَةِ","m":"هي النَّصْرانِيَّةُ، أو دِينُ آبائِهِمْ مِن قُرَيشٍ."},{"w":"إِلَّا ٱخۡتِلَٰقٌ","m":"إلا كَذِبٌ اختَلَقَهُ محمدٌ وافْتَراهُ."}],"10":[{"w":"فَلۡيَرۡتَقُواْ","m":"فَلْيَصْعَدُوا."},{"w":"ٱلۡأَسۡبَٰبِ","m":"المعارِجِ إلى السَّماءِ."}],"11":[{"w":"جُندٞ مَّا هُنَالِكَ","m":"أي: هَؤُلَاءِ الجُنْدُ المكذِّبُونَ الَّذينَ هُم في عِزَّةٍ وشِقاقٍ."},{"w":"مَهۡزُومٞ مِّنَ ٱلۡأَحۡزَابِ","m":"سَيُهْزَمُ هَذا الجُنْدُ ويُغلَبُ، كما هُزِمَ الَّذينَ مِن قَبْلِهِم مِنَ الأحْزَابِ المكَذِّبِينَ."}],"12":[{"w":"ذُو ٱلۡأَوۡتَادِ","m":"صاحِبُ القُوَّةِ العظِيمةِ مِنَ الجُنُودِ والمبانِي الشَّاهِقَةِ."}],"13":[{"w":"وَأَصۡحَٰبُ لۡـَٔيۡكَةِ","m":"أصْحابُ الأشْجَارِ والبَساتِينِ."}],"14":[{"w":"فَحَقَّ عِقَابِ","m":"فحَلَّ بهم عِقابِي وعَذَابي."}],"15":[{"w":"يَنظُرُ","m":"يَنْتَظِرُ."},{"w":"صَيۡحَةٗ وَٰحِدَةٗ","m":"نَفْخَةً واحِدةً في الصُّورِ."},{"w":"مَا لَهَا مِن فَوَاقٖ","m":"ما لها مِن تَوقُّفٍ مِقْدارَ فَواقِ ناقَةٍ: وهو ما بَيْن حَلْبَتَيها مِنَ المدَّةِ القلِيلَةِ."}],"16":[{"w":"قِطَّنَا","m":"نصيبَنَا مِنَ العذابِ."}],"17":[{"w":"ذَا ٱلۡأَيۡدِ","m":"صاحِبَ القُوَّةِ."},{"w":"أَوَّابٌ","m":"كَثِيرُ الرُّجُوعِ إلى اللهِ وطاعَتِهِ."}],"18":[{"w":"بِٱلۡعَشِيِّ","m":"بآخِرِ النَّهارِ."},{"w":"وَٱلۡإِشۡرَاقِ","m":"أوَّلِ النَّهارِ."}],"19":[{"w":"وَٱلطَّيۡرَ مَحۡشُورَةٗ","m":"أي: سَخَّرْنا الطَّيرَ مَجْمُوعَةً إليهِ تُسَبِّحُ اللهَ مَعَهُ."}],"20":[{"w":"وَشَدَدۡنَا مُلۡكَهُۥ","m":"أي: قَوَّيْناهُ بأسْبابِ القُوَّةِ كُلِّها."},{"w":"ٱلۡحِكۡمَةَ","m":"النُّبوَّةَ."},{"w":"وَفَصۡلَ ٱلۡخِطَابِ","m":"أي: الفَصْلَ في الكَلَامِ والحُكْم."}],"21":[{"w":"نَبَؤُاْ ٱلۡخَصۡمِ","m":"خبرُ المتخاصِمَينِ."},{"w":"تَسَوَّرُواْ ٱلۡمِحۡرَابَ","m":"تَسَلَّقُوا مَكَانَ عِبادَتِهِ وأتَوهُ مِنْ أعلى سُورِهِ."}],"22":[{"w":"فَفَزِعَ","m":"فَخَافَ."},{"w":"بَغَىٰ","m":"ظَلَمَ وَتَعدَّىٰ."},{"w":"بِٱلۡحَقِّ","m":"بالعَدْلِ."},{"w":"وَلَا تُشۡطِطۡ","m":"لا تَجُرْ في حُكْمِكَ."},{"w":"وَٱهۡدِنَآ","m":"أرْشِدْنا."},{"w":"سَوَآءِ ٱلصِّرَٰطِ","m":"وَسَطِ الطَّرِيقِ وهو الطَّرِيقُ الحقُّ."}],"23":[{"w":"أَكۡفِلۡنِيهَا","m":"أعْطِنيها حتَّى أَكْفَلَها."},{"w":"وَعَزَّنِي","m":"غَلَبَني."},{"w":"فِي ٱلۡخِطَابِ","m":"في المُحَاجَّةِ."}],"24":[{"w":"ٱلۡخُلَطَآءِ","m":"الشُّركاءِ."},{"w":"لَيَبۡغِي","m":"لَيَظْلِمُ ويَتَعَدَّىٰ."},{"w":"وَظَنَّ","m":"أَيْقَنَ."},{"w":"فَتَنَّٰهُ","m":"ابْتَلَيناهُ وامْتَحَنَّاه."},{"w":"وَخَرَّ رَاكِعٗا","m":"سَقَطَ ساجِداً للهِ."},{"w":"وَأَنَابَ","m":"رَجَعَ إلى اللهِ بالتَّوبَةِ."}],"25":[{"w":"لَزُلۡفَىٰ","m":"لقُرْبةً ومَكَانَةً."},{"w":"وَحُسۡنَ مَـَٔابٖ","m":"حُسْنَ مَرْجِعٍ في الآخِرَةِ، وهو الجنَّةُ."}],"26":[{"w":"بِٱلۡحَقِّ","m":"بالعَدْلِ والإنْصافِ."},{"w":"ٱلۡهَوَىٰ","m":"أي: هَوَى النَّفْسِ المُخَالِفَ لِلْحَقِّ."},{"w":"بِمَا نَسُواْ يَوۡمَ ٱلۡحِسَابِ","m":"أي: بِسَبَبِ تَرْكِهِم العَمَلَ لِيومِ الحِسابِ."}],"27":[{"w":"بَٰطِلٗا","m":"لَعِباً وعَبَثاً."},{"w":"فَوَيۡلٞ","m":"فَهَلَاكٌ."}],"29":[{"w":"لِيَدَّبَّرُوٓاْ","m":"لِيَتَفكَّرُوا."},{"w":"وَلِيَتَذَكَّرَ","m":"ليتَّعِظَ."},{"w":"أُوْلُواْ ٱلۡأَلۡبَٰبِ","m":"أصْحابُ العُقُولِ السَّلِيمَةِ."}],"30":[{"w":"أَوَّابٌ","m":"توَّابٌ كثيرُ الرُّجُوعِ إلى اللهِ."}],"31":[{"w":"بِٱلۡعَشِيِّ","m":"بآخِرِ النَّهارِ."},{"w":"ٱلصَّٰفِنَٰتُ","m":"الخُيُولُ الأصِيلةُ الواقِفَةُ على ثَلاثِ قَوائِمَ وطرفِ حافِرِ الرَّابِعَةِ."},{"w":"ٱلۡجِيَادُ","m":"السَّريعَةُ في الجَرْي."}],"32":[{"w":"أَحۡبَبۡتُ حُبَّ ٱلۡخَيۡرِ","m":"آثَرْتُ حُبَّ الخيلِ."},{"w":"تَوَارَتۡ بِٱلۡحِجَابِ","m":"غَرَبَتِ الشَّمسُ."}],"33":[{"w":"فَطَفِقَ مَسۡحَۢا بِٱلسُّوقِ وَٱلۡأَعۡنَاقِ","m":"فَشَرَعَ يَقْطَعُ سُوقَها وأعْناقَها بالسَّيفِ."}],"34":[{"w":"فَتَنَّا","m":"ابتَلَينا."},{"w":"جَسَدٗا","m":"شِقَّ وَلَدٍ وُلِد لَهُ."},{"w":"أَنَابَ","m":"رَجَعَ إلى اللهِ بالتَّوبَةِ."}],"36":[{"w":"فَسَخَّرۡنَا لَهُ","m":"فَذَلَّلْنا لَه."},{"w":"رُخَآءً","m":"لَيِّنةً طَيِّعةً."},{"w":"حَيۡثُ أَصَابَ","m":"حيثُ أَرادَ."}],"37":[{"w":"بَنَّآءٖ","m":"يَبْنِي لَهُ ما يشاءُ."},{"w":"وَغَوَّاصٖ","m":"يَغُوصُ في البحْرِ لاسْتِخْراجِ نَفَائِسِه."}],"38":[{"w":"مُقَرَّنِينَ فِي ٱلۡأَصۡفَادِ","m":"مُقَيَّدين في الأغْلالِ والسَّلاسِلِ."}],"39":[{"w":"فَٱمۡنُنۡ أَوۡ أَمۡسِكۡ","m":"فأعْطِ مَن شِئْتَ، وامنَعْ مَن شِئْتَ."}],"40":[{"w":"لَزُلۡفَىٰ","m":"لَقُرْبةً وكَرَامةً."},{"w":"وَحُسۡنَ مَـَٔابٖ","m":"حُسْنَ مَرْجِعٍ في الآخِرَةِ، وهو الجَنّةُ."}],"41":[{"w":"بِنُصۡبٖ","m":"بِتَعَبٍ ومَشَقَّةٍ."},{"w":"وَعَذَابٍ","m":"أَلَمٍ وضُرٍّ."}],"42":[{"w":"ٱرۡكُضۡ بِرِجۡلِكَ","m":"اضْرِبْ بِها الأرْضَ."}],"43":[{"w":"أَهۡلَهُۥ","m":"زَوْجَهُ ووَلَدَهُ."},{"w":"وَمِثۡلَهُم مَّعَهُمۡ","m":"وزِدْناهُ مِثْلَهُم بَنِينَ وَحَفَدَةً."},{"w":"لِأُوْلِي ٱلۡأَلۡبَٰبِ","m":"لأصْحابِ العُقُولِ السَّلِيمَةِ."}],"44":[{"w":"ضِغۡثٗا","m":"حُزْمَةً مِنَ الحَشِيشِ وَنَحْوِهِ."},{"w":"وَلَا تَحۡنَثۡ","m":"لا تَتْرُكِ الوفاءَ بِيَمِينِكَ."},{"w":"أَوَّابٞ","m":"رَجّاعٌ إلى طاعَةِ اللهِ."}],"45":[{"w":"أُوْلِي ٱلۡأَيۡدِي","m":"أصْحابَ القُوَى في طاعةِ اللهِ."},{"w":"وَٱلۡأَبۡصَٰرِ","m":"البصائرِ في الدِّينِ."}],"46":[{"w":"أَخۡلَصۡنَٰهُم بِخَالِصَةٖ","m":"خَصَصْناهُم واصْطَفَيناهُم بِخاصَّةٍ عَظِيمَةٍ."},{"w":"ذِكۡرَى ٱلدَّارِ","m":"ذِكْرِ الدَّارِ الآخرةِ في قُلُوبِهِم."}],"47":[{"w":"ٱلۡمُصۡطَفَيۡنَ","m":"الَّذينَ ا