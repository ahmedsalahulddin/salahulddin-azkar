{"1":[{"w":"ٱلۡمُبِينِ","m":"الواضِحِ في معانيه وأحكامِه."}],"3":[{"w":"ٱلۡغَٰفِلِينَ","m":"السَّاهِين، أي: لم يَكُنْ لك عِلْمٌ بهذا الإخبارِ."}],"4":[{"w":"سَٰجِدِينَ","m":"أي: سجودَ تَكريمٍ واحترامٍ."}],"5":[{"w":"فَيَكِيدُواْ لَكَ","m":"يَحْتالُوا من أجلِ إهلاكِك حَسَداً."},{"w":"مُبِينٞ","m":"ظاهرُ العداوةِ."}],"6":[{"w":"يَجۡتَبِيكَ","m":"يختارُك لأمورٍ عظيمة."},{"w":"تَأۡوِيلِ ٱلۡأَحَادِيثِ","m":"تفسيرِ الرُّؤىٰ المناميةِ."},{"w":"وَيُتِمُّ نِعۡمَتَهُۥ عَلَيۡكَ","m":"أي: بالنُّبوَّةِ والرِّسالةِ."}],"7":[{"w":"ءَايَٰتٞ","m":"عِبَرٌ، وعلاماتٌ دالَّةٌ على قدرةِ اللهِ."}],"8":[{"w":"عُصۡبَةٌ","m":"جماعةٌ من الرجالِ متناصِرُون."},{"w":"ضَلَٰلٖ مُّبِينٍ","m":"خطأٍ بيِّنٍ في تفضيلِهما علينا."}],"9":[{"w":"ٱطۡرَحُوهُ أَرۡضٗا","m":"أَلْقُوه في أرضٍ بعيدةٍ."},{"w":"يَخۡلُ لَكُمۡ وَجۡهُ أَبِيكُمۡ","m":"يَخْلُصْ لكم حُبُّ أبيكم وإقبالُه عليكم."},{"w":"مِنۢ بَعۡدِهِۦ","m":"من بعدِ قَتْلِ يوسفَ أو إبعادِه."},{"w":"صَٰلِحِينَ","m":"تائبين إلى اللهِ مِنْ فَعْلَتِكم."}],"10":[{"w":"غَيَٰبَتِ ٱلۡجُبِّ","m":"جوفِ البئرِ وأسفلِه حيثُ يَغيبُ خبرُه."},{"w":"ٱلسَّيَّارَةِ","m":"المسافرين المارِّينَ بالبئرِ."}],"12":[{"w":"يَرۡتَعۡ","m":"يَتَنعَّمْ في أكْلِ ما لَذَّ له وطابَ."},{"w":"وَيَلۡعَبۡ","m":"يتسابَقْ ويرمِ بالسِّهام معنا."}],"13":[{"w":"لَيَحۡزُنُنِيٓ","m":"لَيُؤْلمُ نفسي."},{"w":"غَٰفِلُونَ","m":"ساهُون."}],"14":[{"w":"لَخَٰسِرُونَ","m":"عاجِزُون لا خيرَ فينا."}],"15":[{"w":"وَأَجۡمَعُوٓاْ","m":"عَزَمُوا."},{"w":"وَأَوۡحَيۡنَآ إِلَيۡهِ","m":"أعلمَ اللهُ يوسُفَ؛ تَطْميناً لقَلْبِه."},{"w":"لَتُنَبِّئَنَّهُم","m":"لتُخْبِرَنَّ إخوتَك."}],"17":[{"w":"نَسۡتَبِقُ","m":"نتسابَقُ في الجَرْيِ والرَّمْيِ بالسِّهامِ."},{"w":"مَتَٰعِنَا","m":"ما ننتفِعُ به من الطَّعامِ والثيابِ ونحوِهما."},{"w":"بِمُؤۡمِنٖ لَّنَا","m":"بمُصَدِّقٍ لنا."}],"18":[{"w":"سَوَّلَتۡ","m":"زَيَّنَتْ."},{"w":"فَصَبۡرٞ جَمِيلٞ","m":"وهو ما لا جَزَعَ فيه، ولا شَكْوى معه لأحدٍ من الخَلْقِ."}],"19":[{"w":"سَيَّارَةٞ","m":"جماعةٌ من المسافرين."},{"w":"وَارِدَهُمۡ","m":"مَنْ يتقدَّمُهم ليطلُبَ لهم الماءَ."},{"w":"فَأَدۡلَىٰ دَلۡوَهُۥ","m":"فأَنْزَلَها الواردُ في البئرِ."},{"w":"وَأَسَرُّوهُ","m":"وأخفى الوارِدُ وأصحابُه يوسفَ عن بقيةِ المسافرين."},{"w":"بِضَٰعَةٗ","m":"متاعاً للتجارة."}],"20":[{"w":"وَشَرَوۡهُ","m":"باعه إخوتُه."},{"w":"بَخۡسٖ","m":"قليلٍ ناقصٍ عن مِثْلِه."},{"w":"ٱلزَّٰهِدِينَ","m":"المُعْرِضين عنه، غيرِ المبالِين به."}],"21":[{"w":"أَكۡرِمِي مَثۡوَىٰهُ","m":"اجعلي مَقامَه عندنا كريماً."},{"w":"فِي ٱلۡأَرۡضِ","m":"أرضِ مصرَ."},{"w":"وَٱللَّهُ غَالِبٌ عَلَىٰٓ أَمۡرِهِۦ","m":"لا يُعْجِزُه شيءٌ، ولا ينازعُه في حُكْمِه أحدٌ."}],"22":[{"w":"أَشُدَّهُۥٓ","m":"منتهى قوتِه الجسميةِ، وتكامُلَ عَقْلِه."},{"w":"حُكۡمٗا","m":"حِكْمةً وفَهْماً سديداً، أو النبوَّةَ."}],"23":[{"w":"وَرَٰوَدَتۡهُ","m":"ودَعَت امرأةُ العزيزِ يوسُفَ إلى نفسِها بلِينٍ ومُخادَعَةٍ."},{"w":"هَيۡتَ لَكَ","m":"هلمَّ إليَّ وأقْبِلْ."},{"w":"مَعَاذَ ٱللَّهِ","m":"أستجيرُ بالله وأعتصِمُ به ممَّا تُريدين مني."},{"w":"إِنَّهُۥ رَبِّيٓ","m":"إن زوجَكِ سيِّدي."},{"w":"مَثۡوَايَ","m":"مَقامي عنده."}],"24":[{"w":"هَمَّتۡ بِهِۦ","m":"مالَتْ إليه، وعَزَمَتْ على فِعْلِ الفاحشةِ به."},{"w":"وَهَمَّ بِهَا","m":"ما خَطَرَ بنفسِه من الميلِ بمقتضى الطبيعةِ البشريَّة."},{"w":"بُرۡهَٰنَ رَبِّهِۦ","m":"حُجَّةَ رَبِّه الواضحةَ التي مَنَعَتْه عن المَيْلِ لخَطَراتِ نفسِه."},{"w":"ٱلسُّوٓءَ","m":"كلَّ ما يَسُوءُه، ومنه خيانةُ سَيِّدِه."},{"w":"وَٱلۡفَحۡشَآءَ","m":"ما يَشْتَدُّ قُبْحُه من المعاصي، ومنه الزِّنى."},{"w":"ٱلۡمُخۡلَصِينَ","m":"المختارِين لطاعةِ اللهِ ورسالتِه."}],"25":[{"w":"وَٱسۡتَبَقَا ٱلۡبَابَ","m":"تسابَقا إليه، هو يريدُ الخروجَ وهي تمنعُه."},{"w":"وَقَدَّتۡ قَمِيصَهُۥ مِن دُبُرٖ","m":"شَقَّتْه طُولاً مِن خَلْفٍ."},{"w":"وَأَلۡفَيَا سَيِّدَهَا","m":"وجدا زوجَها."}],"26":[{"w":"وَشَهِدَ شَاهِدٞ","m":"صَبِيٌّ في المهد أنطقَه اللهُ ببراءته."}],"28":[{"w":"كَيۡدِكُنَّ","m":"احتيالِكنَّ ومَكْرِكنَّ."}],"30":[{"w":"شَغَفَهَا حُبًّا","m":"دَخَلَ حُبُّه إلى غِلاف قلبِها، حتى تَمَكَّنَ."}],"31":[{"w":"بِمَكۡرِهِنَّ","m":"باغتيابِهنَّ لها واحتيالِهنَّ في ذَمِّها."},{"w":"أَعۡتَدَتۡ","m":"هَيَّأت."},{"w":"مُتَّكَـ