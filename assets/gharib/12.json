الحَلِفِ باللهِ."},{"w":"يُحَاطَ بِكُمۡ","m":"تُغْلَبُوا، فلا تَسْتطيعوا الإتيانَ به، أو تَهْلِكُوا جميعاً."},{"w":"وَكِيلٞ","m":"رقيبٌ مُطَّلعٌ."}],"67":[{"w":"وَمَآ أُغۡنِي عَنكُم","m":"لا أَدْفَعُ عنكم."},{"w":"عَلَيۡهِ تَوَكَّلۡتُ","m":"اعتمَدْتُ على ربي وفَوَّضْتُ أمري إليه."}],"68":[{"w":"حَاجَةٗ فِي نَفۡسِ يَعۡقُوبَ","m":"وهي شَفَقَتُه على أولادِه أن تصيبَهم العَيْنُ."},{"w":"قَضَىٰهَا","m":"أدْرَكَها، ووَصَّى أولادَه باتِّقائِها."}],"69":[{"w":"ءَاوَىٰٓ إِلَيۡهِ أَخَاهُ","m":"ضَمَّ إليه شقيقَه بِنْيامينَ."},{"w":"فَلَا تَبۡتَئِسۡ","m":"فلا تَحْزَنْ."}],"70":[{"w":"ٱلسِّقَايَةَ","m":"إناءٌ للشُّرْبِ، وهو هنا المِكيالُ الذي يُكالُ به الطَّعامُ."},{"w":"أَذَّنَ مُؤَذِّنٌ","m":"نادىٰ مُنادٍ."},{"w":"ٱلۡعِيرُ","m":"القافلةُ المحمَّلةُ بالطَّعام."}],"72":[{"w":"صُوَاعَ ٱلۡمَلِكِ","m":"المكيالَ الذي يَكيلُ به."},{"w":"زَعِيمٞ","m":"ضامِنٌ وكفيلٌ."}],"75":[{"w":"جَزَٰٓؤُهُۥ مَن وُجِدَ فِي رَحۡلِهِۦ","m":"عقوبةُ سَرِقَتِه استرقاقُ مَنْ وُجِدَ المِكْيالُ في مَتاعِه."}],"76":[{"w":"كَذَٰلِكَ كِدۡنَا لِيُوسُفَ","m":"يَسَّرْنا له هذا التدبيرَ الخَفِيَّ للتَّوصُّلِ إلى غَرَضِه."},{"w":"دِينِ ٱلۡمَلِكِ","m":"شريعةِ مَلِكِ مصرَ."}],"77":[{"w":"فَأَسَرَّهَا","m":"فأخفَىٰ يوسفُ مقالَتَهم التي سَمِعَها مِنْ نِسْبَتِهم إيَّاه إلى السَّرِقَةِ."},{"w":"مَكَانٗا","m":"مَنْزِلَةً."}],"79":[{"w":"مَعَاذَ ٱللَّهِ","m":"نَسْتجيرُ بالله ونعتصِمُ به."},{"w":"مَتَٰعَنَا","m":"مِكْيالَنا الَّذي نَكِيلُ به الطَّعامَ."}],"80":[{"w":"ٱسۡتَيۡـَٔسُواْ مِنۡهُ","m":"يَئِسُوا من إجابةِ يوسفَ لمَطْلبِهم."},{"w":"خَلَصُواْ","m":"انفردُوا عن الناسِ."},{"w":"نَجِيّٗا","m":"مُتَسارِّين يتشاوَرُون بينهم."},{"w":"مَوۡثِقٗا مِّنَ ٱللَّهِ","m":"عَهْداً وأكَّدْتُموه بالحَلِفِ باللهِ."},{"w":"مَا فَرَّطتُمۡ","m":"قَصَّرْتُم."},{"w":"فَلَنۡ أَبۡرَحَ ٱلۡأَرۡضَ","m":"لن أُفارِقَ أرضَ مصرَ."}],"81":[{"w":"وَمَا كُنَّا لِلۡغَيۡبِ حَٰفِظِينَ","m":"ولم نَدْرِ حين عاهَدْناك على رَدِّه أنه سيَسْرِقُ."}],"82":[{"w":"وَٱلۡعِيرَ","m":"القافلةَ."},{"w":"أَقۡبَلۡنَا فِيهَا","m":"عُدْنا فيها."}],"83":[{"w":"سَوَّلَتۡ","m":"زَيَّنَتْ."},{"w":"فَصَبۡرٞ جَمِيلٌ","m":"وهو ما لا جَزَعَ فيه، ولا شَكْوى معه لأحدٍ من الخَلْقِ."}],"84":[{"w":"وَتَوَلَّىٰ عَنۡهُمۡ","m":"أعرضَ يعقوبُ عن خِطابِهم."},{"w":"يَٰٓأَسَفَىٰ","m":"ياحُزني الشديدَ."},{"w":"وَٱبۡيَضَّتۡ عَيۡنَاهُ","m":"بذَهابِ سوادِهما، مما أدَّى إلى ضَعْف بَصَرِه أو ذَهابِه."},{"w":"كَظِيمٞ","m":"ممتلئُ القلب حُزْناً، يَكْتُمُه ولا يُبْدِيه."}],"85":[{"w":"تَفۡتَؤُاْ","m":"لا تَزالُ."},{"w":"حَرَضًا","m":"مُشرِفاً على الهَلاكِ."}],"86":[{"w":"بَثِّي","m":"هَمِّي الشديدَ."}],"87":[{"w":"فَتَحَسَّسُواْ مِن يُوسُفَ","m":"تَعَرَّفُوا وتَطَلَّبُوا خبرَه."},{"w":"رَوۡحِ ٱللَّهِ","m":"رحمتِه وفَرَجِه."}],"88":[{"w":"ٱلضُّرُّ","m":"الشِّدَّةُ والجوعُ من الجَدْبِ."},{"w":"مُزۡجَىٰةٖ","m":"رديئةٍ قليلةٍ."}],"90":[{"w":"مَنَّ ٱللَّهُ عَلَيۡنَآ","m":"تَفضَّلَ علينا بالسَّلامةِ والاجتماعِ."}],"91":[{"w":"ءَاثَرَكَ ٱللَّهُ عَلَيۡنَا","m":"اختارك وفَضَّلَكَ علينا بما خَصَّكَ به من صفاتِ الكمالِ."}],"92":[{"w":"لَا تَثۡرِيبَ","m":"لا تأنيبَ ولا لَوْمَ."}],"93":[{"w":"يَأۡتِ بَصِيرٗا","m":"يَرْجِعْ إليه بَصَرُهُ."}],"94":[{"w":"فَصَلَتِ ٱلۡعِيرُ","m":"خرجَتِ القافلةُ من مصرَ قاصدةً الشَّامَ."},{"w":"لَأَجِدُ رِيحَ يُوسُفَ","m":"لَأَشُمُّ رائحتَه."},{"w":"تُفَنِّدُونِ","m":"تَسْخَرُوا مني وتنسِبُوني إلى العَجْزِ، وضَعْفِ الرأيِ، أو تُكَذِّبوني."}],"95":[{"w":"ضَلَٰلِكَ","m":"خَطَئِك وبُعْدِك عن الصوابِ في حُبِّ يوسفَ."}],"96":[{"w":"ٱلۡبَشِيرُ","m":"الذي بَشَّرَ يعقوبَ بأنَّ يوسفَ حيٌّ."}],"99":[{"w":"ءَاوَىٰٓ إِلَيۡهِ أَبَوَيۡهِ","m":"ضَمَّهما وأنزلَهما عنده."}],"100":[{"w":"وَرَفَعَ أَبَوَيۡهِ عَلَى ٱلۡعَرۡشِ","m":"أَجْلَسَهما بجانبِه على سريرِ مُلْكِه؛ إكراماً لهما."},{"w":"وَخَرُّواْ","m":"هَوَى أبوه وإخوتُه إلى الأرضِ."},{"w":"لَهُۥ سُجَّدٗا","m":"ساجدين تكريماً ليوسفَ، على عادتِهم في تحيةِ الملُوك وأشباهِهم."},{"w":"هَٰذَا تَأۡوِيلُ رُءۡيَٰيَ مِن قَبۡلُ","m":"أي: هذا السجودُ تفسيرٌ وتصديقٌ للرؤيا التي رأيتُها في صِغَري."},{"w":"حَقّٗا","m":"صِدْقاً، وليسَتْ من أكاذيبِ الأحلامِ."},{"w":"أَحۡسَنَ بِيٓ","m":"أفاض اللهُ عليَّ من نِعَمِه."},{"w":"ٱلۡبَدۡوِ","m":"باديةِ الشَّامِ."},{"w":"نَزَغَ ٱلشَّيۡطَٰنُ","m":"أفسَدَ وأغوى؛ لأنه هو سببُ الإفسادِ."},{"w":"لَطِيفٞ","m":"عليمٌ بخَفايا الأمورِ، مُدَبِّرٌ لها، ومُسَهِّلٌ لصعابِها."}],"101":[{"w":"مِنَ ٱلۡمُلۡكِ","m":"مُلْكِ مِصْرَ."},{"w":"تَأۡوِيلِ ٱلۡأَحَادِيثِ","m":"تفسير الرُّؤى، وغيرها من العِلْمِ."},{"w":"فَاطِرَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ","m":"يا خالقَهما ومُبْدِعَهما."},{"w":"وَلِيِّۦ","m":"مُتَوَلِّي حِفْظي وجميعِ شأني."}],"102":[{"w":"ذَٰلِكَ","m":"ما ذُكِرَ من قصةِ يوسفَ وإخوانِه."},{"w":"وَمَا كُنتَ لَدَيۡهِمۡ","m":"وما كنتَ حاضراً مع إخوةِ يوسفَ."},{"w":"إِذۡ أَجۡمَعُوٓاْ أَمۡرَهُمۡ","m":"حينَ دبَّرُوا إلقاءَه في جوفِ البئرِ وظُلْمَتِه."},{"w":"وَهُمۡ يَمۡكُرُونَ","m":"يَحْتالُون في خُفْيَةٍ؛ لإيقاعِ الأذىٰ والشَّرِّ به."}],"103":[{"w":"ٱلنَّاسِ","m":"مُشْركِي قومِك."}],"105":[{"w":"وَكَأَيِّن","m":"وكثيرٌ."},{"w":"مِنۡ ءَايَةٖ","m":"من الدلائلِ الدالَّةِ على وَحْدانيَّةِ اللهِ وقدرتِه."},{"w":"يَمُرُّونَ عَلَيۡهَا","m":"يشاهِدُونها."}],"106":[{"w":"وَهُم مُّشۡرِكُونَ","m":"فهم يَخْلِطُون مع إيمانِهم باللهِ ربّاً الإشراكَ في ألوهيَّتِه وعبادتِه."}],"107":[{"w":"غَٰشِيَةٞ","m":"عقوبةٌ في الدنيا تَعُمُّهم."},{"w":"بَغۡتَةٗ","m":"فَجْأةً."}],"108":[{"w":"بَصِيرَةٍ","m":"يقينٍ وحُجَّةٍ واضحةٍ."}],"109":[{"w":"أَهۡلِ ٱلۡقُرَىٰٓ","m":"المدنِ والحاضرةِ."}],"110":[{"w":"ٱسۡتَيۡـَٔسَ ٱلرُّسُلُ","m":"يَئِسوا من إيمانِ قومِهم."},{"w":"وَظَنُّوٓاْ أَنَّهُمۡ قَدۡ كُذِبُواْ","m":"وظَنَّ المُرْسَلُ إليهم أن الرُّسَلَ قد كَذَبُوهم فيما أخبرُوهم عن اللهِ."},{"w":"جَآءَهُمۡ نَصۡرُنَا","m":"جاء نَصْرُنا لرُسُلِنا عند شِدَّةِ الكَرْبِ."},{"w":"بَأۡسُنَا","m":"عذابُنا."}],"111":[{"w":"عِبۡرَةٞ","m":"عِظَةٌ."},{"w":"لِأُوْلِي ٱلۡأَلۡبَٰبِ","m":"أصحابِ العقولِ السليمةِ."},{"w":"مَا كَانَ","m":"أي: هذا القرآنُ."},{"w":"يُفۡتَرَىٰ","m":"يُخْتَلَقُ."},{"w":"تَصۡدِيقَ ٱلَّذِي بَيۡنَ يَدَيۡهِ","m":"أي: القرآنُ يَشْهَدُ على صِدْقِ ما تقدَّمه من الكتبِ المنزَّلةِ، وأنها من عندِ اللهِ."},{"w":"وَتَفۡصِيلَ كُلِّ شَيۡءٖ","m":"تبيينَ ما يَحْتاجُ إليه العبادُ من أمورِ الدينِ."}]}