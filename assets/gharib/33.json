{"1":[{"w":"ٱتَّقِ ٱللَّهَ","m":"أي: دَاوِمْ على تَقْواه عزَّ وجلّ."}],"3":[{"w":"وَكِيلٗا","m":"حافِظاً مُفَوَّضاً إليه كُلُّ أمْرٍ."}],"4":[{"w":"فِي جَوۡفِهِۦ","m":"أي: في صَدْرِه."},{"w":"تُظَٰهِرُونَ","m":"مِنَ الظِّهارِ، وهو أن يقُولَ الرَّجُلُ لامْرَأَتِه: أنتِ عليَّ كَظَهْرِ أُمِّي."},{"w":"أَدۡعِيَآءَكُمۡ","m":"أولادَكُم المتَبَنَّينَ."},{"w":"يَهۡدِي","m":"يُرْشِدُ."}],"5":[{"w":"ٱدۡعُوهُمۡ لِأٓبَآئِهِمۡ","m":"انْسُبُوهُم إليهِم."},{"w":"أَقۡسَطُ","m":"أَعْدَلُ وَأَقْوَمُ."},{"w":"وَمَوَٰلِيكُمۡ","m":"أي: هُم أولياؤُكُم في الدِّينِ."},{"w":"جُنَاحٞ","m":"إثمٌ."},{"w":"تَعَمَّدَتۡ","m":"قَصَدَتْ وعَزَمَتْ."}],"6":[{"w":"ٱلنَّبِيُّ أَوۡلَىٰ بِٱلۡمُؤۡمِنِينَ","m":"أي: أَحَقُّ، فَلَهُ أن يَحْكُمَ فِيهِم بِما يشاءُ."},{"w":"وَأُوْلُواْ ٱلۡأَرۡحَامِ","m":"ذَوُو القَرَاباتِ."},{"w":"أَوۡلَىٰ بِبَعۡضٖ","m":"أي: أَحَقُّ."},{"w":"مِنَ ٱلۡمُؤۡمِنِينَ وَٱلۡمُهَٰجِرِينَ","m":"أي: مِنْ أنْ يُورَثُوا بالإيمانِ والهجرةِ. (كان ذلك في أوَّلِ الإسلامِ، ثم نُسِخ بآيةِ المواريثِ)."},{"w":"إِلَّآ أَن تَفۡعَلُوٓاْ إِلَىٰٓ أَوۡلِيَآئِكُم مَّعۡرُوفٗا","m":"أي: مِن صَدَقَةٍ أو وَصِيَّةٍ للأقارِبِ غَيرِ الورثةِ."},{"w":"فِي ٱلۡكِتَٰبِ","m":"أي: في اللَّوحِ المحفوظِ."},{"w":"مَسۡطُورٗا","m":"مَكْتُوباً."}],"7":[{"w":"مِيثَٰقَهُمۡ","m":"عَهْدَهُم المُؤَكَّدَ."}],"9":[{"w":"جُنُودٞ","m":"وهم الأحْزابُ يومَ الخنْدَقِ سَنَةَ خَمْسٍ للهجرةِ."},{"w":"رِيحٗا","m":"أي: ريحاً شدِيدةً اقتلَعَتْ خيامَهُم وقَلَبَتْ قُدورَهم."},{"w":"وَجُنُودٗا لَّمۡ تَرَوۡهَا","m":"أي: جُنُوداً مِنَ الملائِكةِ."}],"10":[{"w":"مِن فَوۡقِكُمۡ","m":"مِنْ أعْلى الوادِي مِن جِهةِ المشْرقِ، وهم كانُوا مِن غَطَفانَ وهَوازِنَ وَأهْلِ نَجْدٍ."},{"w":"وَمِنۡ أَسۡفَلَ مِنكُمۡ","m":"مِن بَطْنِ الوادِي مِن جِهَةِ المغْرِبِ، وهم كانُوا مِن مُشْرِكي مَكَّةَ ومَنْ كان معهم."},{"w":"زَاغَتِ ٱلۡأَبۡصَٰرُ","m":"مالَتِ الأَبصْارُ وشَخَصَتْ مِن شِدَّةِ الفزَعِ والهَوْلِ."},{"w":"وَبَلَغَتِ ٱلۡقُلُوبُ ٱلۡحَنَاجِرَ","m":"أي: ارْتَفَعَتْ عَن مَكَانِها مِنَ الفَزَعِ والخَوْفِ وَوَصَلَتْ إلى الحنَاجِرِ؛ مُفْرَدُها حَنْجَرَةٌ وهيَ جَوْفُ الحُلْقُومِ."},{"w":"ٱلظُّنُونَا۠","m":"أي: الظُّنُونَ السَّيِّئةَ بِأنَّ اللهَ لا يَنْصُرُ دِينَه."}],"11":[{"w":"ٱبۡتُلِيَ","m":"اخْتُبِر."},{"w":"وَزُلۡزِلُواْ","m":"واضْطَرَبُوا."}],"12":[{"w":"فِي قُلُوبِهِم مَّرَضٞ","m":"شَكٌّ، وهم ضُعَفاءُ الإيمانِ."},{"w":"غُرُورٗا","m":"باطِلاً."}],"13":[{"w":"يَثۡرِبَ","m":"وهو الاسْمُ القديمُ للمدينةِ النَّبَوِيَّةِ."},{"w":"لَا مُقَامَ لَكُمۡ","m":"لا إِقامَةَ لَكُم هَاهُنا."},{"w":"عَوۡرَةٞ","m":"أي: غيرُ حَصِينةٍ يُخْشى عَلَيها مِنَ الأعْدَاءِ."},{"w":"فِرَارٗا","m":"أي: مِن مَيدانِ القِتالِ."}],"14":[{"w":"وَلَوۡ دُخِلَتۡ عَلَيۡهِم مِّنۡ أَقۡطَارِهَا","m":"ولو دَخَلَ جيشُ الأحزابِ «المدينةَ» مِن جَوَانِبِهَا."},{"w":"ٱلۡفِتۡنَةَ","m":"هي الشِّركُ باللهِ، والرُّجُوعُ عَنِ الإسْلَامِ."},{"w":"لَأٓتَوۡهَا","m":"لَأعْطَوها، ولأَجابُوا إلى ما طُلِبَ إليهم."},{"w":"وَمَا تَلَبَّثُواْ بِهَآ","m":"وما أبْطَؤُوا عَن فِتْنةِ الشِّركِ."}],"15":[{"w":"لَا يُوَلُّونَ ٱلۡأَدۡبَٰرَ","m":"لا يَفِرُّونَ مِن مَيدانِ القِتالِ."},{"w":"مَّسۡـُٔولٗا","m":"أي: يُسْأَلُ عنه ويُحاسَبُ عَلَيهِ."}],"17":[{"w":"يَعۡصِمُكُم","m":"يَمْنَعُكُم."}],"18":[{"w":"ٱلۡمُعَوِّقِينَ","m":"المُثَبِّطِينَ عَنِ الجِهادِ مَعَ الرَّسولِ ﷺ."},{"w":"هَلُمَّ إِلَيۡنَا","m":"تَعَالَوا وانْضَمُّوا إلينا."},{"w":"ٱلۡبَأۡسَ","m":"القتالَ."}],"19":[{"w":"أَشِحَّةً عَلَيۡكُمۡ","m":"بُخَلاءَ عَلَيكُم بكلِّ ما يَنْفَعُكُم."},{"w":"تَدُورُ أَعۡيُنُهُمۡ","m":"يمِيناً وشِمالاً مِن شِدَّةِ الخَوْفِ."},{"w":"يُغۡشَىٰ عَلَيۡهِ","m":"يُغمَى عَلَيهِ مِن سَكَراتِ الموتِ."},{"w":"سَلَقُوكُم","m":"آذَوْكُم وَرَمَوْكُم."},{"w":"حِدَادٍ","m":"حَادَّةٍ قاطِعةٍ كالحديدِ."},{"w":"أَشِحَّةً عَلَى ٱلۡخَيۡرِ","m":"بُخَلاءَ حَرِيصِينَ على المالِ والغَنِيمَةِ."},{"w":"فَأَحۡبَطَ","m":"فَأبْطَلَ."}],"20":[{"w":"يَوَدُّواْ","m":"يَتَمَنَّوا."},{"w":"بَادُونَ فِي ٱلۡأَعۡرَابِ","m":"كانُوا مَعَهُم في الباديةِ بعيدِينَ عَن مَيدانِ الحربِ."}],"21":[{"w":"أُسۡوَةٌ حَسَنَةٞ","m":"قُدْوَةٌ صالِحَةٌ في كُلِّ الأُمُورِ."},{"w":"يَرۡجُواْ","m":"يَخَافُ."}],"22":[{"w":"ٱلۡأَحۡزَابَ","m":"الجيوشَ التي تَحَزَّبَتْ حَوْلَ المدينةِ."}],"23":[{"w":"قَضَىٰ نَحۡبَهُۥ","m":"وَفَّى بِنَذْرِهِ ونالَ الشَّهادَةَ."},{"w":"وَمَا بَدَّلُواْ تَبۡدِيلٗا","m":"وما غَيَّرُوا عَهْدَ اللهِ، بل ثَبَتُوا عَلَيهِ."}],"25":[{"w":"بِغَيۡظِهِمۡ","m":"أي: مُتَلَبِّسين بِغَيظِهِم وَغَضَبِهِم."}],"26":[{"w":"ظَٰهَرُوهُم","m":"أَعانُوهُم."},{"w":"مِن صَيَاصِيهِمۡ","m":"مِنْ حُصُونِهِم ومَعَاقِلِهِم."},{"w":"وَقَذَفَ","m":"وألْقَى."},{"w":"ٱلرُّعۡبَ","m":"الخوفَ الشَّدِيدَ."},{"w":"فَرِيقٗا تَقۡتُلُونَ","m":"وهم الرِّجالُ."},{"w":"وَتَأۡسِرُونَ فَرِيقٗا","m":"وهم النِّساءُ والذُّرِّيَّةُ."}],"27":[{"w":"لَمۡ تَطَـُٔوهَا","m":"لم تَدْخُلُوها."}],"28":[{"w":"أُمَتِّعۡكُنَّ","m":"أُعْطِكُنَّ المُتْعَةَ بِشيءٍ مِنَ الدُّنيا."},{"w":"وَأُسَرِّحۡكُنَّ","m":"أفارِقْكُنَّ بالطَّلاقِ."}],"29":[{"w":"أَعَدَّ","m":"هَيَّأَ."},{"w":"أَجۡرًا","m":"ثواباً."}],"30":[{"w":"بِفَٰحِشَةٖ مُّبَيِّنَةٖ","m":"بمَعْصِيةٍ ظاهِرةِ القُبْحِ."},{"w":"يَسِيرٗا","m":"هَيِّناً."}],"31":[{"w":"يَقۡنُتۡ","m":"يَخْضَعْ ويُطِعْ."},{"w":"أَعۡتَدۡنَا","m":"أعْدَدْنا وهَيَّأنا."},{"w":"رِزۡقٗا كَرِيمٗا","m":"وهو الجنَّةُ."}],"32":[{"w":"فَلَا تَخۡضَعۡنَ بِٱلۡقَوۡلِ","m":"فلا تُلِنَّ القولَ والحديثَ للرِّجال."},{"w":"مَرَضٞ","m":"فُجُورٌ ومَيْلٌ إلى المعْصِيَةِ."},{"w":"قَوۡلٗا مَّعۡرُوفٗا","m":"مُعْتَدِلاً بعِيداً عَنِ الرِّيبةِ والشَّكِّ."}],"33":[{"w":"وَقَرۡنَ","m":"والْزَمْنَ."},{"w":"وَلَا تَبَرَّجۡنَ","m":"ولا تُظْهِرْنَ محاسِنَكُنَّ."},{"w":"ٱلۡجَٰهِلِيَّةِ ٱلۡأُولَىٰ","m":"أي: التي كانتْ قَبْلَ الإِسْلامِ."},{"w":"ٱلرِّجۡسَ","m":"الأَذَى والسُّوءَ والخُبْثَ."}],"34":[{"w":"وَٱلۡحِكۡمَةِ","m":"السُّنَّةِ النَّبَويَّةِ."}],"35":[{"w":"ٱلۡقَٰنِتِينَ","m":"المطِيعِينَ الخاضِعِينَ للهِ."},{"w":"وَٱلۡحَٰفِظِينَ فُرُوجَهُمۡ","m":"أي: عَنِ الزِّنى ومُقَدِّماتِه."},{"w":"أَعَدَّ","m":"هيَّأ."},{"w":"أَجۡرًا عَظِيمٗا","m":"ثواباً عَظِيماً، وهو الجَنَّةُ."}],"36":[{"w":"ٱلۡخِيَرَةُ","m":"الاخْتِيارُ."},{"w":"ضَلَّ","m":"بَعُدَ عَنِ الصِّراطِ المُسْتَقِيمِ."}],"37":[{"w":"لِلَّذِيٓ أَنۡعَمَ ٱللَّهُ عَلَيۡهِ","m":"أي: بالإسْلامِ، وهو زَيدُ بْنُ حارِثَة مَوْلَى النَّبيِّ ﷺ."},{"w":"وَأَنۡعَمۡتَ عَلَيۡهِ","m":"بأن أَعتَقْتَه مِنَ الرِّقِّ."},{"w":"وَتُخۡفِي فِي نَفۡسِكَ","m":"وهو ما أوْحَى اللهُ إلى نبِيِّه مِن طَلاقِ زَيدٍ لِزَوْجِهِ، ثُمَّ زَواجِه ﷺ مِنْهَا."},{"w":"وَطَرٗا","m":"حاجَةً مُهِمَّةً؛ وهي نِكَاحُها."},{"w":"حَرَجٞ","m":"إِثْمٌ."},{"w":"أَزۡوَٰجِ أَدۡعِيَآئِهِمۡ","m":"أي: في نِكاحِ زَوْجاتِ أولادِهِم المُتَبنَّينَ، الذي كان حَرَاماً على عَادَةِ أَهْلِ الجاهِليَّةِ، فأبْطَلَها الإِسْلامُ."}],"38":[{"w":"فَرَضَ ٱللَّهُ لَهُۥ","m":"أي: أَحَلَّ اللهُ له."},{"w":"سُنَّةَ ٱللَّهِ","m":"عادَةَ اللهِ وطَرِيقَتَهُ."},{"w":"خَلَوۡاْ","m":"مضَوا."},{"w":"قَدَرٗا مَّقۡدُورًا","m":"أي: قَضاءً مَقْضِيّاً لابُدَّ مِنْ وُقُوعِهِ."}],"39":[{"w":"حَسِيبٗا","m":"عَلِيماً بالأعْمالِ ومُحاسِباً عَلَيها."}],"40":[{"w":"وَخَاتَمَ ٱلنَّبِيِّـۧنَ","m":"أي: آخِرَهُم، فلا نُبُوَّةَ بَعْدَه إلى يومِ القيامةِ."}],"42":[{"w":"بُكۡرَةٗ وَأَصِيلًا","m":"أوَّلَ النهَارِ وآخِرَه."}],"43":[{"w":"يُصَلِّي عَلَيۡكُمۡ","m":"يُنَزِّلُ رَحْمَتَهُ عَلَيكُم."},{"w":"مِنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِ","m":"مِن ظُلُماتِ الضَّلالةِ إلى نُورِ الهِدايةِ."}],"45":[{"w":"شَٰهِدٗا","m":"أي: على أُمَّتِكَ."}],"46":[{"w":"وَسِرَاجٗا مُّنِيرٗا","m":"أي: يُسْتَضَاءُ بِهَدْيِهِ في ظُلُماتِ الضَّلالةِ."}],"48":[{"w":"وَكِيلٗا","m":"حافِظاً مُفَوَّضاً إليهِ كُلُّ أَمْرٍ."}],"49":[{"w":"أَن تَمَسُّوهُنَّ","m":"أن تُجامِعُوهُنَّ."},{"w":"تَعۡتَدُّونَهَا","m":"تُحْصُونَها عَلَيهِنّ."},{"w":"فَمَتِّعُوهُنَّ","m":"أَعْطُوهُنّ مُتْعَةً يَتَمَتَّعْنَ بِها."},{"w":"وَسَرِّحُوهُنَّ","m":"خَلُّوا سَبِيلَهُنَّ."}],"50":[{"w":"أُجُورَهُنَّ","m":"مُهُورَهُنَّ."},{"w":"مَلَكَتۡ يَمِينُكَ","m":"أي: مِنَ الإِماءِ."},{"w":"مِمَّآ أَفَآءَ ٱللَّهُ عَلَيۡكَ","m":"مِمَّا رَدَّهُ اللهُ عَلَيكَ بالغَنِيمَةِ."},{"w":"مَا فَرَضۡنَا عَلَيۡهِمۡ","m":"ما أَوْجَبْنا عَلَيهِم مِن شُرُوطِ العَقْدِ وحُقُوقِهِ."},{"w":"حَرَجٞ","m":"ضِيقٌ وإِثْمٌ."}],"51":[{"w":"تُرۡجِي","m":"تُؤَخِّرُ في المبيتِ."},{"w":"تُـٔۡوِيٓ","m":"تَضُمُّ إليكَ في المبيتِ."},{"w":"وَمَنِ ٱبۡتَغ