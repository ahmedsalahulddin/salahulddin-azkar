[{"w":"مَرَضٞ","m":"شَكٌّ ورِيبَةٌ."},{"w":"ٱلۡمُرۡجِفُونَ","m":"المُشِيعُونَ للأَخْبارِ الكاذِبَةِ."},{"w":"لَنُغۡرِيَنَّكَ بِهِمۡ","m":"لنُسَلِّطنَّكَ عَلَيهِم."}],"61":[{"w":"مَلۡعُونِينَ","m":"مَطْرُودِينَ مِنْ رَحْمَةِ اللهِ."},{"w":"ثُقِفُوٓاْ","m":"وُجِدُوا."}],"62":[{"w":"سُنَّةَ ٱللَّهِ","m":"طَرِيقةَ اللهِ وعادَتَهُ."},{"w":"خَلَوۡاْ","m":"مَضَوا."}],"63":[{"w":"عَنِ ٱلسَّاعَةِ","m":"أي: عَن وَقْتِ يومِ القِيامةِ."}],"64":[{"w":"لَعَنَ ٱلۡكَٰفِرِينَ","m":"طَرَدَهُم مِن رَحْمَتِهِ."},{"w":"وَأَعَدَّ","m":"جَهَّزَ."},{"w":"سَعِيرًا","m":"ناراً مُسْتَعِرةً شَدِيدَةَ الحرارةِ."}],"66":[{"w":"تُقَلَّبُ وُجُوهُهُمۡ","m":"تُحَوَّلُ مِن ناحيةٍ إلى أُخْرَى لِيزْدَادَ عَذابُهُم."}],"67":[{"w":"ٱلسَّبِيلَا۠","m":"الطَّريقَ المستقيمَ."}],"68":[{"w":"ضِعۡفَيۡنِ","m":"مِثلَينِ."},{"w":"وَٱلۡعَنۡهُمۡ","m":"اطرُدْهُم مِن رَحْمَتِكَ."},{"w":"كَبِيرٗا","m":"شَدِيداً ثَقِيلَ الموقِعِ."}],"69":[{"w":"وَجِيهٗا","m":"عظيمَ القَدْرِ والجاهِ."}],"70":[{"w":"سَدِيدٗا","m":"صَوَاباً."}],"72":[{"w":"ٱلۡأَمَانَةَ","m":"التَّكالِيفَ الشَّرْعِيةَ مِن الأوامِرِ والنَّواهِي."},{"w":"فَأَبَيۡنَ","m":"امْتَنَعْنَ."},{"w":"وَأَشۡفَقۡنَ مِنۡهَا","m":"خِفْنَ مِنَ الخِيانَة فِيها."},{"w":"ظَلُومٗا جَهُولٗا","m":"شَدِيدَ الظُّلمِ والجَهْلِ لِنَفْسِهِ."}]}