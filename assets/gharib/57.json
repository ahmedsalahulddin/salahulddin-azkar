{"1":[{"w":"سَبَّحَ لِلَّهِ","m":"نَزَّهَهُ عَنِ السُّوءِ وَمَجَّدَهُ."},{"w":"ٱلۡعَزِيزُ","m":"الَّذِي لا يُغْلَبُ."},{"w":"ٱلۡحَكِيمُ","m":"الَّذِي يَضَعُ الأَفْعالَ حَيثُ يَلِيقُ بِها."}],"3":[{"w":"ٱلۡأَوَّلُ","m":"الَّذِي ليسَ قَبْلَهُ شَيءٌ."},{"w":"ٱلۡأٓخِرُ","m":"الَّذِي لَيسَ بَعْدَه شَيءٌ."},{"w":"ٱلظَّٰهِرُ","m":"الَّذِي لَيسَ فَوْقَه شَيءٌ."},{"w":"ٱلۡبَاطِنُ","m":"الَّذِي لَيسَ دُونَهُ شَيءٌ."}],"4":[{"w":"ٱسۡتَوَىٰ","m":"عَلَا وارْتَفَعَ."},{"w":"ٱلۡعَرۡشِ","m":"سَرِيرِ المُلْكِ الَّذِي تَحْمِلُه الملائِكَةُ، واسْتَوَى عَليهِ الرَّحمنُ، وهو أَعْظَمُ المخلُوقاتِ، وهو سَقْفُ جَنَّةِ الفِرْدَوسِ."},{"w":"يَلِجُ فِي ٱلۡأَرۡضِ","m":"يَدْخُلُ مِنْ حَبٍّ، وَمَطَرٍ، وَغَيرِ ذَلِكَ."},{"w":"يَعۡرُجُ فِيهَا","m":"يَصْعَدُ مِنَ الملائِكةِ، والأرْوَاحِ، والأَدْعِيَةِ، والأَعْمالِ."},{"w":"مَعَكُمۡ","m":"بِعِلْمِهِ."}],"6":[{"w":"يُولِجُ ٱلَّيۡلَ فِي ٱلنَّهَارِ","m":"يُدْخِلُ ما نَقَصَ مِن سَاعاتِ الليل في النَّهارِ، فَيَزِيدُ النَّهارَ."},{"w":"وَيُولِجُ ٱلنَّهَارَ فِي ٱلَّيۡلِ","m":"ويُدْخِلُ ما نَقَصَ من ساعاتِ النَّهارِ في الليلِ، فَيَزيدُ الليلَ."},{"w":"بِذَاتِ ٱلصُّدُورِ","m":"بما فِي صُدُورِ خَلْقِهِ."}],"7":[{"w":"جَعَلَكُم مُّسۡتَخۡلَفِينَ","m":"جَعَلَها في أَيْدِيكُم، واسْتَخْلَفَكُم عَلَيها."}],"8":[{"w":"مِيثَٰقَكُمۡ","m":"عَهْدَكُم المؤَكَّدَ."}],"9":[{"w":"ٱلظُّلُمَٰتِ","m":"ظُلُماتِ الكُفْرِ."},{"w":"ٱلنُّورِ","m":"نُور الإيمانِ."},{"w":"لَرَءُوفٞ","m":"لَرَحِيمٌ بِهِم أَشَدَّ رَحْمةٍ."}],"10":[{"w":"وَمَا لَكُمۡ أَلَّا تُنفِقُواْ","m":"أَيُّ شَيءٍ يَمْنَعُكُم مِنَ الإنْفَاقِ؟"},{"w":"مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ","m":"مُلْكُ السَّمَواتِ وَالْأرْضِ، وَسَيَنْتَقِلُ إلى مالِكِه الحقِيقِي."},{"w":"ٱلۡفَتۡحِ","m":"فَتْحِ مَكَّةَ."},{"w":"ٱلۡحُسۡنَىٰ","m":"الجنَّةَ."}],"11":[{"w":"يُقۡرِضُ ٱللَّهَ","m":"يُنْفِقُ مُخْلِصاً عَمَلَهُ للهِ."}],"12":[{"w":"يَسۡعَىٰ نُورُهُم","m":"يُضِيءُ لَهُم نُورُ عَمَلِهِم عَلَى الصِّراطِ عَلَى قَدْرِ أَعْمالِهِم."}],"13":[{"w":"ٱنظُرُونَا","m":"انْتَظِرُونا، وَتَريَّثُوا في سَيرِكُم حتى نَلْحَقَ بِكُم."},{"w":"نَقۡتَبِسۡ","m":"نَأْخُذْ."},{"w":"قِيلَ","m":"القائِلُ: المؤمِنُونَ."},{"w":"ٱرۡجِعُواْ وَرَآءَكُمۡ","m":"ارْجِعُوا إلى المكانِ الَّذِي قَبَسْتُم فِيهِ النُّورَ."},{"w":"فَٱلۡتَمِسُواْ","m":"فاطْلُبُوا."},{"w":"فَضُرِبَ بَيۡنَهُم","m":"فَوُضِعَ بَيْنَ المؤمِنينَ والمنافِقِينَ."},{"w":"بِسُورٖ","m":"بِجِدارٍ مُحِيطٍ مُرْتَفِعٍ."},{"w":"بَاطِنُهُۥ","m":"داخِلُهُ."},{"w":"وَظَٰهِرُهُۥ","m":"خارِجُهُ."},{"w":"مِن قِبَلِهِ","m":"في جِهَتِهِ المقابِلَةِ الَّتِي فِيها المنافِقُونَ."}],"14":[{"w":"فَتَنتُمۡ أَنفُسَكُمۡ","m":"آثمْتُمُوها، وَأَهْلَكْتُمُوها بالنِّفاقِ."},{"w":"وَتَرَبَّصۡتُمۡ","m":"وانْتَظَرْتُم بالنَّبِي الموتَ، وبِالمؤمِنِينَ الدَّوائِرَ."},{"w":"وَٱرۡتَبۡتُمۡ","m":"شَكَكْتُم في التَّوحِيدِ وَنُبُوَّةِ محمَّدٍ ﷺ."},{"w":"وَغَرَّتۡكُمُ","m":"خَدَعَتْكُم."},{"w":"ٱلۡأَمَانِيُّ","m":"ما تُمَنُّونَ بِهِ أَنْفُسَكُم مِنَ الأباطِيلِ."},{"w":"أَمۡرُ ٱللَّهِ","m":"الموتُ."},{"w":"ٱلۡغَرُورُ","m":"الشَّيطانُ."}],"15":[{"w":"فِدۡيَةٞ","m":"عِوَضٌ تَتَخَلّصُونَ بِهِ مِنَ العذابِ."},{"w":"مَأۡوَىٰكُمُ","m":"مَصِيرُكُم الَّذِي تَخْلُدُونَ فِيهِ."},{"w":"وَبِئۡسَ ٱلۡمَصِيرُ","m":"وَساءَ مَرْجِعُ مَن صَارَ إلى النَّارِ."}],"16":[{"w":"أَلَمۡ يَأۡنِ","m":"أَلَمْ يَأْتِ الوَقْتُ؟"},{"w":"تَخۡشَعَ","m":"تَرِقَّ وَتَلِينَ."},{"w":"ٱلۡأَمَدُ","m":"الزَّمانُ أو الغايَةُ، وبُعْدُ عَهْدِهِم بالأنبياءِ والصَّالِحِينَ."}],"17":[{"w":"ٱلۡأَرۡضَ","m":"الميْتَةَ الَّتِي لا تُنْبِتُ شَيئاً."},{"w":"بَعۡدَ مَوۡتِهَا","m":"بَعْدَ يُبْسِها لاحْتِباسِ الماءِ عَنْها."},{"w":"ٱلۡأٓيَٰتِ","m":"الدَّلائِلَ والحُجَجَ."},{"w":"لَعَلَّكُمۡ تَعۡقِلُونَ","m":"رَجاءَ أَن تَعْقِلُوا."}],"18":[{"w":"ٱلۡمُصَّدِّقِينَ","m":"المتَصَدِّقِينَ مِنْ أَمْوالِهِم."},{"w":"وَأَقۡرَضُواْ ٱللَّهَ قَرۡضًا","m":"أَنْفَقُوا في سَبِيلِ اللهِ نَفَقاتٍ طَيِّبةً بِها نُفُوسُهُم."}],"19":[{"w":"ٱلصِّدِّيقُونَ","m":"الَّذِينَ كَمُلَ تَصْدِيقُهُم بِما جاءَتْ بِهِ الرُّسُلُ، اعتِقاداً وَقَوْلاً وَعَمَلاً."},{"w":"وَٱلشُّهَدَآءُ","m":"هُمُ القَتْلَى في سَبِيلِ اللهِ، أو الَّذِينَ يَشْهَدُونَ عَلَى الأُمَمِ السَّابِقَةِ."}],"20":[{"w":"كَمَثَلِ غَيۡثٍ","m":"كَحَالِ القَطْرِ."},{"w":"ٱلۡكُفَّارَ","m":"الزُّرَّاعَ، لِأنَّ الزَّارِعَ يَسْتُرُ ما يَزْرَعُهُ بِتُرابِ الأرْضِ."},{"w":"يَهِيجُ","m":"يَيْبَسُ."},{"w":"مُصۡفَرّٗا","m":"تَحَوَّلَ لونُه إلى الصُّفْرةِ."},{"w":"حُطَٰمٗا","m":"مُتَهَشِّماً مُتَكَسِّراً."},{"w":"مَتَٰعُ ٱلۡغُرُورِ","m":"تَمتُّعٌ يَنْخَدِعُ بِهِ أَهْلُهُ."}],"21":[{"w":"مَغۡفِرَةٖ","m":"أسبابِ المغفِرَةِ مِنَ التَّوبَةِ والابْتِعادِ عَنِ المعاصِي."}],"22":[{"w":"كِتَٰبٖ","m":"اللَّوحِ المحْفُوظِ."},{"w":"نَبۡرَأَهَآ","m":"نَخْلُقَ الخَلِيقَةَ."}],"23":[{"w":"تَأۡسَوۡاْ","m":"تَحْزَنُوا."},{"w":"تَفۡرَحُواْ","m":"فَرَحَ بَطَرٍ وَأَشَرٍ."},{"w":"مُخۡتَالٖ","m":"مُتَكَبِّرٍ."}],"24":[{"w":"يَبۡخَلُونَ","m":"بأمْوالِهِم."},{"w":"يَتَوَلَّ","m":"يُعْرِضْ عَن طاعَةِ اللهِ."},{"w":"ٱلۡغَنِيُّ","m":"عَنْ خَلْقِهِ."},{"w":"ٱلۡحَمِيدُ","m":"المحمُودُ على أَوصافِهِ الكامِلةِ."}],"25":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالحُجَجِ الواضِحاتِ."},{"w":"لِيَقُومَ ٱلنَّاسُ بِٱلۡقِسۡطِ","m":"لِيَتَعامَلَ النَّاسُ بَيْنَهُم بالعَدلِ."},{"w":"بَأۡسٞ","m":"قُوَّةٌ."},{"w":"عَزِيزٞ","m":"لا يُغْلَبُ."}],"27":[{"w":"قَفَّيۡنَا","m":"أَتْبَعْنا."},{"w":"رَأۡفَةٗ","m":"لِيناً."},{"w":"وَرَهۡبَانِيَّةً","m":"وابْتَدَعُوا رَهْبانِيَّةً بالغُلُوِّ في العِبادةِ."},{"w":"مَا كَتَبۡنَٰهَا","m":"ما فَرَضْناها."},{"w":"إِلَّا ٱبۡتِغَآءَ رِضۡوَٰنِ ٱللَّهِ","m":"التَزَمُوا بالرَّهْبانِيَّةِ المُبْتدَعَةِ يَطْلُبُونَ بِذَلِكَ رِضا اللهِ."},{"w":"فَمَا رَعَوۡهَا حَقَّ رِعَايَتِهَا","m":"فما قامُوا بِها حَقَّ القيامِ."}],"28":[{"w":"كِفۡلَيۡنِ","m":"ضِعْفَينِ."},{"w":"تَمۡشُونَ بِهِۦ","m":"تَهْتَدُونَ بِهِ."}],"29":[{"w":"لِئَلَّا يَعۡلَمَ","m":"لِيعلَمَ."},{"w":"ٱلۡفَضۡلِ ٱلۡعَظِيمِ","m":"الإحْسانِ والعَطَاءِ الكَثِيرِ الوَاسِعِ."}]}