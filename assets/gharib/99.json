{"1":[{"w":"زُلۡزِلَتِ","m":"رُجَّتْ."},{"w":"زِلۡزَالَهَا","m":"رَجّاً شَدِيداً."}],"2":[{"w":"أَثۡقَالَهَا","m":"ما في بَطْنِهَا مِن مَوتَى وَكُنُوزٍ."}],"3":[{"w":"مَا لَهَا","m":"ما الَّذِي حَدَثَ لَها؟"}],"4":[{"w":"يَوۡمَئِذٖ","m":"يَومَ القيامةِ."},{"w":"تُحَدِّثُ أَخۡبَارَهَا","m":"تُخْبِرُ الأَرْضُ بِما عُمِلَ عَلَيها مِنْ خَيرٍ أو شَرٍّ."}],"5":[{"w":"أَوۡحَىٰ لَهَا","m":"أَمَرَها بأن تُخْبِرَ بِما عُمِلَ عَلَيها."}],"6":[{"w":"يَصۡدُرُ ٱلنَّاسُ","m":"يَرْجِعُ النَّاسُ عَن مَوقِفِ الحِسابِ."},{"w":"أَشۡتَاتٗا","m":"أصنافاً مُتَفَرِّقِينَ."},{"w":"لِيُرَوۡاْ أَعۡمَٰلَهُمۡ","m":"لِيُرِيَهُم اللهُ ما عَمِلُوا."}],"7":[{"w":"مِثۡقَالَ ذَرَّةٍ","m":"وزنَ نَمْلَةٍ صَغِيرَةٍ."},{"w":"يَرَهُۥ","m":"يَرَ ثَوابَهُ في الآخِرَةِ."}]}