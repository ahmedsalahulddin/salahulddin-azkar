{"1":[{"w":"ٱلسَّاعَةُ","m":"القِيامَةُ."},{"w":"وَٱنشَقَّ","m":"انْفَلَقَ فِلْقَتَينِ."}],"2":[{"w":"ءَايَةٗ","m":"بُرْهاناً عَلَى صِدْقِ الرَّسُولِ مُحَمَّدٍ ﷺ."},{"w":"مُسۡتَمِرّٞ","m":"ذاهِبٌ مُضْمَحِلٌّ لَا دَوامَ لَهُ."}],"3":[{"w":"أَهۡوَآءَهُمۡ","m":"ما تُحِبُّهُ أَنفُسُهُم مِنَ الضَّلالِ والتَّكْذِيبِ."},{"w":"أَمۡرٖ","m":"مِنْ خَيرٍ أَوْ شَرٍّ."},{"w":"مُسۡتَقِرّٞ","m":"واقِعٌ بأَهْلِهِ يَوْمَ القِيامَةِ."}],"4":[{"w":"مُزۡدَجَرٌ","m":"كِفايَةٌ لِرَدْعِهم."}],"5":[{"w":"حِكۡمَةُۢ","m":"هَذا القُرْآنُ فِيهِ حِكْمَةٌ عَظِيمةٌ."},{"w":"بَٰلِغَةٞ","m":"بالِغَةٌ غايَتَها."},{"w":"فَمَا","m":"فأيُّ شَيءٍ."},{"w":"تُغۡنِ","m":"تَدْفَعُ أَوْ تَنْفَعُ."},{"w":"ٱلنُّذُرُ","m":"الإِنْذاراتُ."}],"6":[{"w":"فَتَوَلَّ","m":"فَأَعْرِضْ."},{"w":"ٱلدَّاعِ","m":"المَلَكُ بنَفْخِهِ في «القَرْنِ»."},{"w":"نُكُرٍ","m":"فَظِيعٍ مُنْكَرٍ، وهو موقِفُ الحِسابِ."}],"7":[{"w":"خُشَّعًا","m":"ذَلِيلَةً."},{"w":"ٱلۡأَجۡدَاثِ","m":"القُبُورِ."},{"w":"مُنتَشِرٞ","m":"مُنْبَثٌّ عَلَى وَجْهِ الأرْضِ."}],"8":[{"w":"مُهۡطِعِينَ","m":"مُسْرِعِينَ مادِّينَ أَعْناقَهُم."},{"w":"ٱلدَّاعِ","m":"صوتِ المَلَكِ."},{"w":"عَسِرٞ","m":"شَدِيدُ الْهَوْلِ."}],"9":[{"w":"وَٱزۡدُجِرَ","m":"وانْتَهَرُوا نوحاً -عليه السلام- مُتَوَعِّدِينَ إِيَّاهُ بأنْواعِ الأَذَى."}],"10":[{"w":"مَغۡلُوبٞ","m":"ضَعِيفٌ عَن مُقاوَمةِ هَؤُلَاءِ."},{"w":"فَٱنتَصِرۡ","m":"لِي بِعِقابٍ مِنْ عِنْدِكَ."}],"11":[{"w":"مُنۡهَمِرٖ","m":"كَثِيرٍ مُتَدَفِّقٍ."}],"12":[{"w":"وَفَجَّرۡنَا","m":"وَشَقَقْنا."},{"w":"عُيُونٗا","m":"مِنْ عُيُونٍ مُتَفَجِّرَةٍ بالماءِ."},{"w":"فَٱلۡتَقَى ٱلۡمَآءُ","m":"فَالْتَقَى ماءُ السَّماءِ وماءُ الأرْضِ."},{"w":"عَلَىٰٓ أَمۡرٖ قَدۡ قُدِرَ","m":"عَلَى إِهْلَاكِهِم الَّذِي قَدَّرَهُ اللهُ لَهُم."}],"13":[{"w":"ذَاتِ أَلۡوَٰحٖ","m":"سَفِينَةٍ ذاتِ ألْوَاحٍ."},{"w":"وَدُسُرٖ","m":"وَمَسامِيرَ شُدَّتْ بِها."}],"14":[{"w":"بِأَعۡيُنِنَا","m":"بِمَرْأىً مِنَّا وحِفْظٍ."}],"15":[{"w":"وَلَقَد تَّرَكۡنَٰهَآ","m":"وَلَقَدْ أَبْقَينا قِصَّةَ نُوحٍ."},{"w":"ءَايَةٗ","m":"عِبْرةً."},{"w":"مُدَّكِرٖ","m":"مُتَّعِظٍ."}],"17":[{"w":"يَسَّرۡنَا","m":"سَهَّلْنا."},{"w":"لِلذِّكۡرِ","m":"لِلتِّلاوَةِ، والحِفْظِ، والفَهْمِ، والتَّدَبُّرِ."}],"19":[{"w":"صَرۡصَرٗا","m":"شَدِيدَةَ البَرْدِ والصَّوتِ."},{"w":"نَحۡسٖ","m":"شُؤْمٍ."},{"w":"مُسۡتَمِرّٖ","m":"اسْتَمَرَّ بِهِمُ العَذابُ إلَى أَن وَافَى بِهِمْ جَهَنَّمَ."}],"20":[{"w":"تَنزِعُ ٱلنَّاسَ","m":"تَقْلَعُ النَّاسَ مِنَ الأرْضِ، فتَصْرَعُهم عَلَى رُؤوسِهِم، فَتَنْدَقُّ رِقابُهُم وَتَنْفَصِلُ عَنْ أَجْسامِهِم."},{"w":"أَعۡجَازُ","m":"أُصُولُ."},{"w":"مُنقَعِرٖ","m":"مُنْقَلِعٍ."}],"23":[{"w":"بِٱلنُّذُرِ","m":"بالآياتِ الَّتِي أُنْذِرُوا بِها."}],"24":[{"w":"ضَلَٰلٖ","m":"بُعْدٍ عَنِ الصَّوابِ."},{"w":"وَسُعُرٍ","m":"جُنُونٍ."}],"25":[{"w":"أَءُلۡقِيَ","m":"أَأُنْزِلَ."},{"w":"ٱلذِّكۡرُ","m":"الوَحْيُ والقُرآنُ."},{"w":"أَشِرٞ","m":"صاحِبُ بَطَرٍ وتَكَبُّرٍ."}],"27":[{"w":"مُرۡسِلُواْ","m":"مُخْرِجُو."},{"w":"فِتۡنَةٗ","m":"اخْتِباراً."},{"w":"فَٱرۡتَقِبۡهُمۡ","m":"فَانْتَظِرْ ما يَحُلُّ عَلَيهِم مِنَ العَذَابِ."},{"w":"وَٱصۡطَبِرۡ","m":"واصْبِرْ عَلَى الأَذَى الَّذِي يُصِيبُكَ مِنَ المدْعُوِّينَ."}],"28":[{"w":"وَنَبِّئۡهُمۡ","m":"وَأَخْبِرْهُم."},{"w":"قِسۡمَةُۢ","m":"مَقْسُومٌ."},{"w":"بَيۡنَهُمۡ","m":"بَيْنَ ثَمُودَ والنَّاقَةِ."},{"w":"كُلُّ شِرۡبٖ","m":"كُلُّ نَصِيبٍ مِن الشَّرابِ."},{"w":"مُحۡتَضَرٞ","m":"يَحْضُرُهُ صاحِبُهُ وَيَسْتَحِقُّهُ."}],"29":[{"w":"فَتَعَاطَىٰ","m":"فَتَناوَلَ النَّاقَةَ بِيَدِهِ لِيَعْقِرَها."},{"w":"فَعَقَرَ","m":"فَقَتَلَ."}],"31":[{"w":"كَهَشِيمِ","m":"كالشَّجَرِ اليابِسِ الَّذِي يَسْقُطُ وَيَتَناثَرُ."},{"w":"ٱلۡمُحۡتَظِرِ","m":"الَّذِي يُرِيدُ أَن يَعْمَلَ سِياجاً لِحِفْظِ المواشِي فَيَحْتَطِبُ لِذَلِكَ."}],"34":[{"w":"حَاصِبًا","m":"رِيحاً شَدِيدَةً تَرْمِيهِم بِحِجارَةٍ."},{"w":"بِسَحَرٖ","m":"في آخِرِ الليلِ."}],"35":[{"w":"نَجۡزِي","m":"نُثِيبُ."},{"w":"مَن شَكَرَ","m":"مَنْ آمَنَ بِاللهِ وَوَحّدَهُ."}],"36":[{"w":"وَلَقَدۡ أَنذَرَهُم","m":"خَوَّفَهُم."},{"w":"بَطۡشَتَنَا","m":"بَأْسَنَا وَعَذَابَنا."},{"w":"فَتَمَارَوۡاْ","m":"فَشَكُّوا."},{"w":"بِٱلنُّذُرِ","m":"بالإنْذارِ."}],"38":[{"w":"صَبَّحَهُم بُكۡرَةً","m":"جاءَهُم وَقْتَ الصَّباحِ."},{"w":"مُسۡتَقِرّٞ","m":"نازلٌ بِهم."}],"41":[{"w":"ءَالَ فِرۡعَوۡنَ","m":"أَتْباعَ فِرْعَونَ."},{"w":"ٱلنُّذُرُ","m":"الإِنْذارُ تِلْو الإنْذارِ مِن مُوسَى -عَلَيهِ السَّلامُ- بالعُقُوبةِ عَلَى كُفْرِهِم."}],"42":[{"w":"بِـَٔايَٰتِنَا","m":"بِأَدلَّتِنا الدَّالّةِ عَلَى وَحْدَانِيَّتِنا وَنُبُوَّةِ أَنْبِيائِنَا."},{"w":"فَأَخَذۡنَٰهُمۡ","m":"فَعاقَبْناهُم."},{"w":"عَزِيزٖ","m":"لا يُغالَبُ."},{"w":"مُقۡتَدِرٍ","m":"قادِرٍ عَلَى هَلَاكِكُم."}],"43":[{"w":"أَكُفَّارُكُمۡ","m":"يا مَعْشَرَ العَرَبِ."},{"w":"بَرَآءَةٞ","m":"مِنَ العذَابِ ألَّا يُصِيبَكُم ما أَصابَهُم."},{"w":"ٱلزُّبُرِ","m":"الكُتُبِ المنَزَّلةِ عَلَى الأنبياءِ المُتقَدِّمِينَ."}],"44":[{"w":"نَحۡنُ جَمِيعٞ","m":"نَحْنُ يَدٌ وَاحِدَةٌ عَلَى مَن خالَفَنا."},{"w":"مُنتَصِرٞ","m":"نَغْلِبُ غَيرَنا."}],"45":[{"w":"ٱلۡجَمۡعُ","m":"جَمْعُ كُفَّارِ مَكَّةَ أمامَ المُؤمِنِينَ."}],"46":[{"w":"أَدۡهَىٰ","m":"أَفْظَعُ وَأَعْظَمُ."},{"w":"وَأَمَرُّ","m":"أَشدُّ مَرارَةً مِنَ القَتْلِ والأَسْرِ."}],"47":[{"w":"ضَلَٰلٖ","m":"تِيهٍ عَنِ الحقِّ."},{"w":"وَسُعُرٖ","m":"جُنُونٍ أو نارٍ تَسْتَعِرُ عَلَيهِم."}],"48":[{"w":"يُسۡحَبُونَ","m":"يُجَرُّونَ."},{"w":"مَسَّ سَقَرَ","m":"شِدَّةَ عَذابِ جَهَنَّمَ."}],"49":[{"w":"بِقَدَرٖ","m":"بمِقْدارٍ قَدَّرْناهُ، وسَبَق عِلْمُنا بِهِ، وكِتابَتُنا لَهُ في اللَّوحِ المَحْفُوظِ."}],"50":[{"w":"وَٰحِدَةٞ","m":"قَوْلَةٌ وَاحِدَةٌ، وهي «كُنْ»."},{"w":"كَلَمۡحِۭ بِٱلۡبَصَرِ","m":"فَيُوجَدُ في أقْصَرِ وَقْتٍ."}],"51":[{"w":"أَشۡيَاعَكُمۡ","m":"أَشْباهَكُم في الكُفْرِ مِنَ الأُمَمِ السَّابِقَةِ."},{"w":"مُدَّكِرٖ","m":"مُتَّعِظٍ."}],"52":[{"w":"ٱلزُّبُرِ","m":"الكُتُبِ الَّتِي كَتَبَتْهَا الحَفَظَةُ."}],"53":[{"w":"مُسۡتَطَرٌ","m":"مُسَطَّرٌ في صَحائِفِهم."}],"55":[{"w":"مَقۡعَدِ صِدۡقٍ","m":"مَجْلِسِ حَقٍّ."},{"w":"مَلِيكٖ","m":"اللهِ الملِكِ العَظِيمِ."},{"w":"مُقۡتَدِرِۭ","m":"عَظِيمِ القُدْرَةِ."}]}