{"1":[{"w":"ذَاتِ ٱلۡبُرُوجِ","m":"ذاتِ المنازِل الَّتِي تَسِيرُ فِيها الشَّمْسُ والقَمَرُ."}],"2":[{"w":"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ","m":"أَقَسَم اللهُ تَعالَى بِاليَومِ الَّذِي وَعَدَ الخلْقَ أَن يَجْمَعَهُم فِيهِ."}],"3":[{"w":"وَشَاهِدٖ","m":"الرائِي، أو المُخْبِرِ بِحَقٍّ."},{"w":"وَمَشۡهُودٖ","m":"المَرئي، أو المشهود عليه بحق."}],"4":[{"w":"قُتِلَ","m":"لُعِنَ."},{"w":"أَصۡحَٰبُ ٱلۡأُخۡدُودِ","m":"الَّذِين شَقُّوا في الأرضِ شَقّاً عَظِيماً؛ لِتَعذِيبِ المؤمِنِينَ."}],"5":[{"w":"ٱلۡوَقُودِ","m":"ما تُوقَدُ بِهِ النَّارُ مِنْ حَطَبٍ وَنَحوِهِ."}],"6":[{"w":"إِذۡ هُمۡ","m":"حِيْنَ هَؤُلاءِ الكُفَّارُ مِنْ أصحابِ الأُخْدُودِ."},{"w":"عَلَيۡهَا","m":"عَلى حافَةِ النَّارِ الَّتِي في الأُخْدُودِ."}],"7":[{"w":"شُهُودٞ","m":"حُضُورٌ."}],"8":[{"w":"وَمَا نَقَمُواْ","m":"وما أَنْكَرُوا عَلَيهِم."},{"w":"ٱلۡعَزِيزِ","m":"الشَّدِيدِ في انْتِقامِهِ مِمَّن انْتَقَمَ مِنْهُ."},{"w":"ٱلۡحَمِيدِ","m":"المَحْمودِ في أَقْوالِهِ وَأَفْعالِهِ."}],"9":[{"w":"شَهِيدٌ","m":"مُطَّلِعٌ لا يَخْفَى عَلَيهِ شَيءٌ."}],"10":[{"w":"فَتَنُواْ","m":"حَرَّقُوا."}],"11":[{"w":"مِن تَحۡتِهَا","m":"مِن تَحْتِ قُصُورِها وأَشْجارِها."}],"13":[{"w":"يُبۡدِئُ","m":"يَبْدَأُ الخَلْقَ."},{"w":"وَيُعِيدُ","m":"الخَلْقَ لِلْحِسابِ."}],"14":[{"w":"ٱلۡغَفُورُ","m":"لمِن تابَ."},{"w":"ٱلۡوَدُودُ","m":"كَثِيرُ المحَبَّةِ لأوليائِهِ."}],"15":[{"w":"ذُو ٱلۡعَرۡشِ","m":"صاحِبُ العرْشِ."},{"w":"ٱلۡمَجِيدُ","m":"الَّذِي بَلَغَ المُنْتَهَى في الْفَضلِ."}],"16":[{"w":"فَعَّالٞ لِّمَا يُرِيدُ","m":"لا يَمْتَنِعُ عَلَيهِ شَيءٌ يُريدُهُ."}],"17":[{"w":"حَدِيثُ ٱلۡجُنُودِ","m":"خَبَرُ الجُمُوعِ الكافِرةِ المُكَذِّبةِ لأَنْبِيائِها."}],"21":[{"w":"مَجِيدٞ","m":"عَظِيمٌ كَرِيمٌ."}],"22":[{"w":"فِي لَوۡحٖ مَّحۡفُوظِۭ","m":"لا ينالُه تَبْدِيلٌ ولا تَحْرِيفٌ."}]}