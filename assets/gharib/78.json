{"1":[{"w":"عَمَّ","m":"عَنْ أيِّ شَيءٍ."},{"w":"يَتَسَآءَلُونَ","m":"يَسْأَلُ بعضُ كُفَّارِ قُريشٍ بَعْضاً."}],"2":[{"w":"ٱلنَّبَإِ ٱلۡعَظِيمِ","m":"الخبرِ العَظِيمِ الشَّأنِ، وهو القُرآنُ العَظِيمُ الَّذي يُنْبِئُ عَنِ البَعْثِ."}],"4":[{"w":"كَلَّا","m":"ليسَ الأمْرُ كَما يَزْعُمُ هَؤلاءِ المشْرِكُونَ."},{"w":"سَيَعۡلَمُونَ","m":"أي: عاقبةَ تَكْذِيبِهِم."}],"6":[{"w":"مِهَٰدٗا","m":"مُمَهَّدَةً لَكُم كالفِراشِ."}],"7":[{"w":"أَوۡتَادٗا","m":"رَواسِيَ."}],"8":[{"w":"أَزۡوَٰجٗا","m":"أَصْنافاً ذَكَراً وَأُنْثَى."}],"9":[{"w":"سُبَاتٗا","m":"راحةً لأبدانِكُم."}],"10":[{"w":"لِبَاسٗا","m":"تَلْبَسُكُم ظُلْمَتُهُ، كَما يَسْتُرُ الثَّوبُ لَابِسَهُ."}],"11":[{"w":"مَعَاشٗا","m":"تَنتَشِرُونَ فِيه لِمصَالِحِكُم."}],"12":[{"w":"سَبۡعٗا","m":"سَبْعَ سَمَواتٍ."},{"w":"شِدَادٗا","m":"مَتِينَةَ البِناءِ، مُحْكَمةَ الخَلْقِ والإنْشَاءِ."}],"13":[{"w":"سِرَاجٗا","m":"شَمْساً."},{"w":"وَهَّاجٗا","m":"وقَّاداً مُضِيئاً."}],"14":[{"w":"ٱلۡمُعۡصِرَٰتِ","m":"السُّحُبِ المُمْطِرَةِ."},{"w":"ثَجَّاجٗا","m":"منصَبّاً بِكَثْرَةٍ."}],"16":[{"w":"أَلۡفَافًا","m":"مُلْتَفَّةً بعْضُها بِبَعْضٍ."}],"17":[{"w":"يَوۡمَ ٱلۡفَصۡلِ","m":"أي: القضاءِ بينَ الخلْقِ، وهوَ يومُ القِيامَةِ."},{"w":"مِيقَٰتٗا","m":"وَقْتاً ومِيعاداً مُحَدَّداً للأوَّلِينَ والآخِرِينَ."}],"18":[{"w":"يُنفَخُ فِي ٱلصُّورِ","m":"يَنفُخُ المَلَكُ في «القَرْنِ» إيذانًا بالبَعْثِ."},{"w":"أَفۡوَاجٗا","m":"أُمَماً، كلُّ أُمَّةٍ مع إمامِهِم."}],"19":[{"w":"وَفُتِحَتِ","m":"شُقِّقَتْ وصُدِّعتْ."},{"w":"أَبۡوَٰبٗا","m":"ذاتَ أبوابٍ كَثِيرةٍ."}],"20":[{"w":"وَسُيِّرَتِ ٱلۡجِبَالُ","m":"وَنُسِفَتِ الجِبالُ."},{"w":"سَرَابًا","m":"يَظُنُّ مَن يَراهُ مِن بُعْدٍ ماءً، وهو في الحقِيقَةِ هَبَاءٌ."}],"21":[{"w":"مِرۡصَادٗا","m":"تَرْقُبُ مَنْ يجتازُها."}],"22":[{"w":"لِلطَّٰغِينَ","m":"للكافِرِينَ الَّذِينَ طَغَوا."},{"w":"مَـَٔابٗا","m":"مَرْجِعاً."}],"23":[{"w":"لَٰبِثِينَ","m":"ماكِثِينَ."},{"w":"أَحۡقَابٗا","m":"دُهُوراً مُتَعاقِبةً لا تَنْقَطِعُ."}],"24":[{"w":"لَا يَذُوقُونَ","m":"لا يُحِسُّونَ."},{"w":"بَرۡدٗا","m":"نَسِيماً بارداً."},{"w":"شَرَابًا","m":"ماءً يُرْوي."}],"25":[{"w":"حَمِيمٗا","m":"ماءً حارّاً."},{"w":"وَغَسَّاقٗا","m":"وَصَدِيدَ أَهْلِ النَّارِ."}],"26":[{"w":"وِفَاقًا","m":"مُوافِقاً لأَعْمالِهِم."}],"27":[{"w":"لَا يَرۡجُونَ حِسَابٗا","m":"لا يَتَوَقَّعُونَ وُقُوعَ الجَزَاءِ يَومَ القِيامَةِ."}],"28":[{"w":"بِـَٔايَٰتِنَا","m":"بِما جاءَتْهُم بِهِ الرُّسُلُ."}],"29":[{"w":"كِتَٰبٗا","m":"كَتَبْناهُ في اللَّوحِ المَحْفُوظِ."}],"31":[{"w":"مَفَازًا","m":"فَوْزاً بِدُخُولِهِم الجنَّةَ."}],"33":[{"w":"وَكَوَاعِبَ","m":"نَوَاهِدَ، أَثْدَاؤُهنَّ مُرْتَفِعَةٌ لم تَتَدَلَّ."},{"w":"أَتۡرَابٗا","m":"مُسْتَوِياتٍ في سِنٍّ واحِدةٍ."}],"34":[{"w":"دِهَاقٗا","m":"مَمْلُوءةً خَمْراً."}],"35":[{"w":"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا","m":"باطِلاً مِنَ القول."},{"w":"وَلَا كِذَّٰبٗا","m":"ولا تَكْذِيباً."}],"36":[{"w":"حِسَابٗا","m":"كَثِيراً كافياً لَهُم."}],"37":[{"w":"لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","m":"لا يَسْتَطِيعُونَ خِطاباً يُبَلِّغُونَهُ إلى اللهِ."}],"38":[{"w":"ٱلرُّوحُ","m":"جِبْريِلُ."},{"w":"صَفّٗا","m":"مُصْطَفِّينَ."},{"w":"صَوَابٗا","m":"حَقّاً وسَدَاداً."}],"39":[{"w":"ٱلۡيَوۡمُ ٱلۡحَقُّ","m":"الثابِتُ الَّذِي لا رَيْبَ في وُقُوعِهِ."},{"w":"مَـَٔابٗا","m":"مَرْجِعاً."}],"40":[{"w":"أَنذَرۡنَٰكُمۡ","m":"حَذَّرْناكُم."},{"w":"مَا قَدَّمَتۡ يَدَاهُ","m":"ما عَمِلَ من خِيرٍ أو شَرٍّ."},{"w":"يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","m":"فلم أُبْعَثْ."}]}