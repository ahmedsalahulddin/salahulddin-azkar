{"1":[{"w":"ٱلۡمُزَّمِّلُ","m":"المتَغَطِّي بِثِيابِهِ."}],"2":[{"w":"قُمِ ٱلَّيۡلَ","m":"قُمْ لِلصَّلاةِ في الليلِ."},{"w":"إِلَّا قَلِيلٗا","m":"إلا يسِيراً مِنْهُ."}],"3":[{"w":"نِصۡفَهُۥٓ","m":"قُمْ نِصْفَ الليلِ."},{"w":"أَوِ ٱنقُصۡ مِنۡهُ قَلِيلًا","m":"أوِ انْقُصْ مِنَ النِّصْفِ قَلِيلا حتَّى تَصِلَ إلى الثُلُثِ."}],"4":[{"w":"أَوۡ زِدۡ عَلَيۡهِ","m":"أوْ زِدْ عَلَى النِّصْفِ حتَّى تَصِلَ إِلَى الثُّلُثَينِ."},{"w":"وَرَتِّلِ ٱلۡقُرۡءَانَ تَرۡتِيلًا","m":"وَاقْرَأ القُرآنَ بتُؤَدَةٍ مُبَيِّناً الحُرُوفَ والوُقُوفَ."}],"5":[{"w":"سَنُلۡقِي عَلَيۡكَ","m":"سَنُنْزِلُ عَلَيكَ أيُّها النَّبِيُّ."},{"w":"قَوۡلٗا ثَقِيلًا","m":"قُرآناً عَظِيماً مُشْتَمِلاً عَلَى الأَوامِرِ والنَّواهِي والأَحْكامِ الشَّرعِيَّةِ."}],"6":[{"w":"نَاشِئَةَ ٱلَّيۡلِ","m":"العِبادةَ الَّتِي تَنْشَأُ في جَوْفِ الليلِ."},{"w":"أَشَدُّ وَطۡـٔٗا","m":"أَشَدُّ تأثِيراً في القَلْبِ."},{"w":"وَأَقۡوَمُ قِيلًا","m":"وَأَبْيَنُ قَوْلاً؛ لِفَراغِ القَلْبِ مِن مَّشاغِل الدُّنيا."}],"7":[{"w":"سَبۡحٗا طَوِيلٗا","m":"تَصَرُّفاً في مَصالِحِكَ، واشْتِغالاً بالرِّسالَةِ."}],"8":[{"w":"وَتَبَتَّلۡ إِلَيۡهِ تَبۡتِيلٗا","m":"وانْقَطِعْ إلَيهِ انْقِطاعاً تامّاً في عِبادَتِكَ."}],"9":[{"w":"فَٱتَّخِذۡهُ وَكِيلٗا","m":"فاعْتَمِدْ عَلَيهِ، وَفَوِّضْ أُمُورَكَ إِلَيه."}],"10":[{"w":"وَٱهۡجُرۡهُمۡ هَجۡرٗا جَمِيلٗا","m":"وأعْرِضْ عَنْهُم، واتْرُكِ الانْتِقامَ مِنْهُم."}],"11":[{"w":"وَذَرۡنِي وَٱلۡمُكَذِّبِينَ","m":"دَعْنِي -أَيُّها الرَّسُولُ- وهَؤُلاءِ المكَذِّبِينَ بآياتي."},{"w":"أُوْلِي ٱلنَّعۡمَةِ","m":"أَصْحابَ النَّعِيمِ والتَّرَفِ في الدُّنيا."},{"w":"وَمَهِّلۡهُمۡ قَلِيلًا","m":"وَأَخِّرْهُم زَمَناً قَلِيلاً حتَّى يَبْلُغَ الكِتابُ أَجَلَه بِعَذابِهِم."}],"12":[{"w":"إِنَّ لَدَيۡنَا","m":"أي: في الآخِرَةِ."},{"w":"أَنكَالٗا","m":"قُيُوداً ثَقِيلَةً."},{"w":"وَجَحِيمٗا","m":"وَنَاراً مُسْتَعِرَةً."}],"13":[{"w":"وَطَعَامٗا ذَا غُصَّةٖ","m":"وَطَعاماً كَرِيهاً ينشَبُ في الحُلُوقِ غَيرَ مُسْتَساغٍ."}],"14":[{"w":"تَرۡجُفُ","m":"تَضْطَرِبُ وَتَتَزَلْزَلُ."},{"w":"كَثِيبٗا","m":"تَلّاً مِنَ الرَّملِ."},{"w":"مَهِيلًا","m":"سائِلاً مُنْهالاً مُتَناثِراً."}],"15":[{"w":"شَٰهِدًا عَلَيۡكُمۡ","m":"بِما صَدَرَ مِنْكُم مِنَ الكُفْرِ والعِصْيانِ."}],"16":[{"w":"فَعَصَىٰ فِرۡعَوۡنُ ٱلرَّسُولَ","m":"فَكذَّبَ فِرْعَونُ بِمُوسَى، وَلَمْ يُؤْمِن بِرِسالَتِهِ."},{"w":"فَأَخَذۡنَٰهُ","m":"فَأَهْلكْناهُ."},{"w":"وَبِيلٗا","m":"شَدِيداً."}],"17":[{"w":"فَكَيۡفَ تَتَّقُونَ","m":"فَكَيفَ تَقُونَ أَنْفُسَكُم عذابَ يومِ القِيامَة؟"},{"w":"يَجۡعَلُ ٱلۡوِلۡدَٰنَ شِيبًا","m":"يَشِيبُ فِيهِ الوِلْدانُ الصِّغارُ؛ مِن شِدَّةِ هَوْلِه وَكَرْبِهِ؟"}],"18":[{"w":"ٱلسَّمَآءُ مُنفَطِرُۢ بِهِۦ","m":"السَّماءُ مُتَصَدِّعَةٌ في ذَلِكَ اليَوْمِ؛ لِشِدَّةِ هَوْلِهِ. وقيل:"},{"w":"بِهِۦ","m":"أي: باللهِ، وهو نَظِيرُ قَوْلِهِ تَعَالى:"},{"w":"وَيَوۡمَ تَشَقَّقُ ٱلسَّمَآءُ بِٱلۡغَمَٰمِ","m":"[الفرقان: 25]."},{"w":"مَفۡعُولًا","m":"واقِعاً لا مَحالَةَ."}],"19":[{"w":"تَذۡكِرَةٞ","m":"عِظَةٌ وعِبْرَةٌ للنَّاسِ."},{"w":"ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","m":"اتَّخَذَ الطَّاعةَ والتَّقْوى طَرِيقاً تُوصِلُه إلى رِضْوَانِ رَبِهِ."}],"20":[{"w":"تَقُومُ","m":"للتَّهجُّدِ مِنَ الليلِ."},{"w":"أَدۡنَىٰ مِن ثُلُثَيِ ٱلَّيۡلِ","m":"أَقَلَّ مِن ثُلُثَي الليلِ حِيناً."},{"w":"وَنِصۡفَهُۥ","m":"وَتَقُومُ نِصْفَ الليلِ حِيناً."},{"w":"وَثُلُثَهُۥ","m":"وَتَقُومُ ثُلُثَ الليلِ حِينًا آخرَ."},{"w":"وَطَآئِفَةٞ مِّنَ ٱلَّذِينَ مَعَكَ","m":"وَيَقُومُ مَعَكَ طائِفَةٌ مِنْ أَصْحَابِكَ."},{"w":"وَٱللَّهُ يُقَدِّرُ ٱلَّيۡلَ وَٱلنَّهَارَ","m":"يَعْلَمُ مَقادِيرَهُما."},{"w":"تُحۡصُوهُ","m":"تُطيقُوا قيامَه كُلَّه."},{"w":"فَتَابَ عَلَيۡكُمۡ","m":"فَخَفَّفَ عَلَيكُم."},{"w":"فَٱقۡرَءُواْ مَا تَيَسَّرَ مِنَ ٱلۡقُرۡءَانِ","m":"في الصَّلاةِ بالليلِ."},{"w":"وَءَاخَرُونَ يَضۡرِبُونَ فِي ٱلۡأَرۡضِ","m":"يَتَنَقَّلُونَ في الأرضِ للتِّجارَةِ والعَمَلِ."},{"w":"يَبۡتَغُونَ مِن فَضۡلِ ٱللَّهِ","m":"يَطْلُبُونَ مِن رزْقِ اللهِ الحلالِ."},{"w":"وَأَقۡرِضُواْ ٱللَّهَ قَرۡضًا حَسَنٗا","m":"وَتَصَدَّقُوا في وُجُوهِ البِرِّ والإِحْسانِ مِنْ أَمْوالِكُم."},{"w":"وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنۡ خَيۡرٖ","m":"وَما تَفْعَلُوا مِن وُجُوهِ البِرِّ."},{"w":"وَأَعۡظَمَ أَجۡرٗا","m":"وَأَعْظَمَ مِنْهُ ثَواباً."}]}