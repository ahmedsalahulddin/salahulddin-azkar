{"1":[{"w":"هَلۡ أَتَىٰ","m":"قَدْ مَضَى."},{"w":"حِينٞ مِّنَ ٱلدَّهۡرِ","m":"وَقْتٌ طويلٌ مِنَ الزَّمانِ قَبلَ أَن تُنفَخَ فيه الرُّوحُ."},{"w":"لَمۡ يَكُن شَيۡـٔٗا مَّذۡكُورًا","m":"لَم يكُنْ شَيئاً يُذكرُ."}],"2":[{"w":"نُطۡفَةٍ أَمۡشَاجٖ","m":"مِن نُّطْفَةٍ مُخْتَلِطَةٍ مِن مَّاءِ الرَّجُلِ وماءِ المرأةِ."},{"w":"نَبۡتَلِيهِ","m":"أي بتكاليفِ الشَّريعةِ."}],"3":[{"w":"هَدَيۡنَٰهُ","m":"بيَّنَّا له."},{"w":"ٱلسَّبِيلَ","m":"طَرِيقَ الهُدَى والضَّلالِ."},{"w":"كَفُورًا","m":"جاحِداً."}],"4":[{"w":"أَعۡتَدۡنَا","m":"أعْدَدْنا."},{"w":"سَلَٰسِلَاْ","m":"حَلَقاً غَلِيظَةً مِنْ حَدِيدٍ تُشَدُّ بِها أَرْجُلُهُم."},{"w":"وَأَغۡلَٰلٗا","m":"قُيُوداً تُغَلُّ بِها أَيْدِيهِم."},{"w":"وَسَعِيرًا","m":"وناراً يُحرَقُونَ بِها."}],"5":[{"w":"ٱلۡأَبۡرَارَ","m":"أَهْلَ الطَّاعةِ والإخلاصِ الَّذِينَ يُؤَدُّونَ حقَّ اللهِ."},{"w":"كَأۡسٖ","m":"إِناءٍ للخَمْرِ."},{"w":"مِزَاجُهَا","m":"ما خُلِطَ بالخمْرِ لِتَخْفِيفِ حِدَّتِهِ."},{"w":"كَافُورًا","m":"أَحْسَنَ أَنْواعِ الطِّيبِ."}],"6":[{"w":"يَشۡرَبُ بِهَا","m":"يَشْرَبُ مِنْها."},{"w":"عِبَادُ ٱللَّهِ","m":"هم الأبرارُ."},{"w":"يُفَجِّرُونَهَا","m":"يَسْتَقُونَ مِنها حيثُ شاؤُوا."},{"w":"تَفۡجِيرٗا","m":"إجراءً سَهْلا."}],"7":[{"w":"يُوفُونَ","m":"يُؤَدُّونَ وافياً دُونَ نَقْصٍ وَلَا تَقْصِيرٍ."},{"w":"بِٱلنَّذۡرِ","m":"ما أَوْجَبُوهُ على أَنْفُسِهِم مِن فِعْلِ الخيرِ المُتَقرَّبِ بِهِ إلى اللهِ."},{"w":"وَيَخَافُونَ يَوۡمٗا","m":"ويخافُونَ عِقابَ اللهِ يومَ القِيامةِ."},{"w":"مُسۡتَطِيرٗا","m":"مُنْتَشِراً."}],"8":[{"w":"عَلَىٰ حُبِّهِۦ","m":"مَعَ حُبِّهِم لَهُ وحاجَتِهِم إِلَيهِ."},{"w":"مِسۡكِينٗا","m":"مُحْتاجاً."},{"w":"وَيَتِيمٗا","m":"وَطِفْلاً ماتَ أبُوهُ وَلَا مالَ لَهُ."},{"w":"وَأَسِيرًا","m":"الَّذِي تَمَّ أَسْرُهُ في الحرْبِ."}],"9":[{"w":"لِوَجۡهِ ٱللَّهِ","m":"ابْتِغاءَ مَرْضاةِ اللهِ."},{"w":"جَزَآءٗ","m":"عِوَضاً."}],"10":[{"w":"عَبُوسٗا","m":"تَكْلَحُ فِيهِ الوُجُوهُ."},{"w":"قَمۡطَرِيرٗا","m":"تَتَقَطَّبُ الجِباهُ مِن فَظاعَةِ أَمْرِهِ."}],"11":[{"w":"وَلَقَّىٰهُمۡ","m":"جَعَلَهُم يَلْقَونَ."},{"w":"نَضۡرَةٗ","m":"نُوراً في وُجُوهِهِم."}],"13":[{"w":"مُّتَّكِـِٔينَ","m":"جالِسِينَ، على وَجْهِ التَّمَكُّنِ والرَّاحَةِ."},{"w":"ٱلۡأَرَآئِكِ","m":"الأَسِرَّةِ المزيَّنَةِ بفَاخرِ الثِّيابِ والسُّتُورِ."},{"w":"شَمۡسٗا","m":"حرَّ شَمْسٍ؛ لِعَدَمِ وُجُودِها."},{"w":"زَمۡهَرِيرٗا","m":"شِدّةَ بَرْدٍ."}],"14":[{"w":"وَدَانِيَةً عَلَيۡهِمۡ","m":"وقَريبةً مِنْهُم."},{"w":"ظِلَٰلُهَا","m":"أشْجَارُ الجنَّةِ مُظَلَّلَةٌ عَليهِم."},{"w":"وَذُلِّلَتۡ","m":"وسُهِّلَ لَهُم."},{"w":"قُطُوفُهَا","m":"أَخْذُ ثِمارِها."}],"15":[{"w":"وَيُطَافُ عَلَيۡهِم","m":"وَيَدُورُ عَلَيهِم الخَدَمُ."},{"w":"بِـَٔانِيَةٖ مِّن فِضَّةٖ","m":"بأواني الطَّعامِ وأَوْعِيَتِهِ الفِضِّيَّةِ."},{"w":"قَوَارِيرَا۠","m":"مِنَ الزُّجاجِ."}],"16":[{"w":"قَدَّرُوهَا تَقۡدِيرٗا","m":"قدَّرها السُّقاةُ على مِقْدارِ ما يَشْتَهِي الشارِبُونَ لا تَزِيدُ ولَا تَنْقُصُ."}],"17":[{"w":"كَأۡسٗا","m":"إناءً مَمْلُوءاً خَمراً."},{"w":"مِزَاجُهَا","m":"ما تُخْلَطُ بِهِ."}],"18":[{"w":"عَيۡنٗا","m":"تجري."},{"w":"سَلۡسَبِيلٗا","m":"الماءُ السَّهْلُ المَسَاغِ."}],"19":[{"w":"وِلۡدَٰنٞ مُّخَلَّدُونَ","m":"غِلْمانٌ دائِمُونَ."},{"w":"لُؤۡلُؤٗا","m":"دُرّاً مُضِيئاً."},{"w":"مَنثُورٗا","m":"مُفَرَّقاً."}],"20":[{"w":"رَأَيۡتَ ثَمَّ","m":"أَبْصَرْتَ أيَّ مَكانٍ في الجنَّةِ."}],"21":[{"w":"عَٰلِيَهُمۡ","m":"يَعْلُوهُم ويُجَمِّلُ أَبْدَانَهُم."},{"w":"ثِيَابُ سُندُسٍ خُضۡرٞ","m":"ثِيابٌ بطائِنُها مِنَ الحريرِ الرَّقِيقِ الأخْضَرِ."},{"w":"وَإِسۡتَبۡرَقٞ","m":"وَظاهِرُها مِنَ الحريرِ الغلِيظِ."},{"w":"وَحُلُّوٓاْ","m":"وأُلْبِسُوا للزِّينَةِ."},{"w":"أَسَاوِرَ","m":"جَمْعُ سِوارٍ، وهو ما يُلْبسُ في المِعْصَمِ مِنَ الحُليِّ."},{"w":"طَهُورًا","m":"لا رِجْسَ فِيهِ ولا دَنَسَ."}],"22":[{"w":"سَعۡيُكُم","m":"عَمَلُكُم في الدُّنيا."},{"w":"مَشۡكُورًا","m":"مَرْضِيّاً عِنْدَ اللهِ مَقْبُولاً."}],"24":[{"w":"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ","m":"فاصْبِرْ لحُكْمِ رَبِّكَ القَدَريِّ واقْبَلْهُ، وَلِحُكْمِهِ الدِّينِيِّ فامْضِ عَلَيهِ."},{"w":"ءَاثِمًا","m":"عاصِياً."},{"w":"أَوۡ كَفُورٗا","m":"أو مُبالِغاً في الكُفْرِ والضَّلالِ."}],"25":[{"w":"بُكۡرَةٗ","m":"أَوَّلَ النَّهارِ."},{"w":"وَأَصِيلٗا","m":"آخِرَ النَّهارِ."}],"26":[{"w":"فَٱسۡجُدۡ لَهُۥ","m":"فاخْضَعْ لِربِّكَ."},{"w":"وَسَبِّحۡهُ","m":"وصَلِّ لَهُ، وتهجَّدْ لَهُ."}],"27":[{"w":"ٱلۡعَاجِلَةَ","m":"الدُّنيا."},{"w":"ثَقِيلٗا","m":"عَظِيمَ الشَّدائِدِ."}],"28":[{"w":"وَشَدَدۡنَآ","m":"وأحكمنا."},{"w":"أَسۡرَهُمۡ","m":"خَلْقَهُم."},{"w":"بَدَّلۡنَآ أَمۡثَٰلَهُمۡ","m":"أَهْلَكْناهُم، وجِئْنا بِقَوْمٍ مُطِيعِينَ."}],"29":[{"w":"تَذۡكِرَةٞ","m":"عِظَةٌ للعالَمِينَ."},{"w":"سَبِيلٗا","m":"طَرِيقاً يُوصِلُهُ إلى مَغْفِرَةِ اللهِ ورِضْوانِهِ."}]}