{"1":[{"w":"تُجَٰدِلُكَ","m":"تُرَاجِعُكَ الكَلامَ في زَوْجِها، وهي خَوْلَةُ بِنْتُ ثَعْلَبةَ وزَوْجُها أوسُ بنُ الصَّامتِ."},{"w":"تَحَاوُرَكُمَآ","m":"تَخَاطُبَكُما وَمُرَاجَعَتَكُما الكَلامَ."}],"2":[{"w":"يُظَٰهِرُونَ","m":"يَقُولُ الرَّجُلُ مِنْهُم لِزوجَتِهِ: «أنْتِ عَليَّ كَظَهْرِ أُمِّي» أي: في حُرْمَةِ النِّكَاحِ."}],"3":[{"w":"ثُمَّ يَعُودُونَ لِمَا قَالُواْ","m":"ثُمَّ يَرْجِعُونَ عَن قَوْلِهِم وَيَعْزِمُونَ على وَطْءِ نِسائِهِم."},{"w":"يَتَمَآسَّا","m":"يَمَسَّ أَحَدُهُما الآخَرَ، وهي كِنايةٌ عَنِ الجِماعِ."}],"4":[{"w":"مِسۡكِينٗا","m":"هو الَّذِي لا يَمْلِكُ ما يَكْفِيهِ ويَسُدُّ حاجَتَهُ."}],"5":[{"w":"يُحَآدُّونَ","m":"يُشاقُّونَ ويُخالِفُونَ."},{"w":"كُبِتُواْ","m":"خُذِلُوا وَأُهِينُوا."},{"w":"مُهِينٞ","m":"مُذِلٌّ."}],"6":[{"w":"أَحۡصَىٰهُ ٱللَّهُ","m":"كَتَبهُ في اللَّوحِ المحْفُوظِ، وَحَفِظَهُ عَلَيهم في صحائفِ أَعْمالِهِم."},{"w":"شَهِيدٌ","m":"شاهِدٌ يَعْلَمُهُ وَيُحِيطُ بِهِ، فلا يعْزُبُ عنه شَيءٌ مِنْهُ."}],"7":[{"w":"نَجۡوَىٰ","m":"مُناجاةٍ ومُسارَّةٍ وما يَكْتُمُهُ النَّاسُ مِنْ أحادِيثِهِم."},{"w":"هُوَ رَابِعُهُمۡ","m":"مُشاهِدُهُم بِعِلْمِهِ، وهو عَلَى عَرْشِهِ."},{"w":"وَلَآ أَدۡنَىٰ مِن ذَٰلِكَ","m":"وَلَا أَقَلَّ مِن ذَلِكَ."},{"w":"هُوَ مَعَهُمۡ","m":"وهُوَ فَوْقَ العَرْشِ وعلمه معهم."}],"8":[{"w":"ٱلنَّجۡوَىٰ","m":"حَدِيثِ السِّرِّ الَّذِي يُثيرُ الشَّكَّ في نُفُوسِ المؤمِنينَ."},{"w":"وَيَتَنَٰجَوۡنَ","m":"يَتَحَدَّثُونَ سِرّاً."},{"w":"حَيَّوۡكَ","m":"سَلَّمُوا عَلَيكَ."},{"w":"حَسۡبُهُمۡ","m":"كافِيهِم مِنَ العَذابِ."},{"w":"يَصۡلَوۡنَهَا","m":"يَدْخُلُونَها وَيُقاسُونَ حَرَّها."},{"w":"فَبِئۡسَ ٱلۡمَصِيرُ","m":"فَسَاءَ المنْقَلَبُ والمرْجِعُ."}],"11":[{"w":"تَفَسَّحُواْ","m":"لِيُوسِّعْ بَعْضُكُم لِبَعْضٍ المَجَالِسَ."},{"w":"يَفۡسَحِ ٱللَّهُ لَكُمۡ","m":"يُوَسِّعِ اللهُ عَلَيكُم في الدُّنيا والآخِرةِ."},{"w":"ٱنشُزُواْ","m":"قُومُوا من مجالِسِكُم."},{"w":"يَرۡفَعِ","m":"يَرْفَعْ مَكَانَةَ."},{"w":"دَرَجَٰتٖ","m":"مَراتِبَ رَفِيَعةً في دِينِهِم."}],"12":[{"w":"نَٰجَيۡتُمُ ٱلرَّسُولَ","m":"أَرَدْتُم أَن تُكَلِّمُوا رَسُولَ اللهِ ﷺ سرّاً."},{"w":"وَأَطۡهَرُ","m":"وأَزْكَى لِقُلُوبِكُم مِنَ المأثَمِ."}],"13":[{"w":"ءَأَشۡفَقۡتُمۡ","m":"أخَشِيْتُم الفَقْرَ عَقِبَ تَقْدِيمِ الصَّدَقةِ؟"}],"14":[{"w":"تَوَلَّوۡاْ قَوۡمًا","m":"اتخذوهم أصدقاءَ يُحِبُّونهم وينصرونهم."}],"16":[{"w":"جُنَّةٗ","m":"وِقايَةً وسُتْرَةً."},{"w":"مُهِينٞ","m":"مُذِلٌّ في النَّارِ."}],"17":[{"w":"لَن تُغۡنِيَ","m":"لَن تَدْفَعَ."}],"19":[{"w":"ٱسۡتَحۡوَذَ","m":"غَلَبَ واسْتَولَى."},{"w":"فَأَنسَىٰهُمۡ","m":"جَعَلَهُم يَتْرُكُونَ."},{"w":"ذِكۡرَ ٱللَّهِ","m":"تَوْحِيدَ اللهِ، والعَمَلَ بِطاعَتِهِ."}],"20":[{"w":"يُحَآدُّونَ","m":"يُخالِفُونَ."},{"w":"فِي ٱلۡأَذَلِّينَ","m":"مِن جُمْلةِ الأذِلَّاءِ المغلوبِينَ المُهَانِينَ."}],"21":[{"w":"كَتَبَ","m":"قَضَى وَكَتَبَ في اللَّوحِ المحْفُوظِ."},{"w":"لَأَغۡلِبَنَّ","m":"لَتَكونَنَّ الغَلَبةُ بِالقُوَّةِ للهِ ولِرُسُلِهِ."},{"w":"عَزِيزٞ","m":"مانِعٌ حِزْبَهُ مِنْ أَن يُذَلَّ."}],"22":[{"w":"يُوَآدُّونَ","m":"يُحِبُّونَ ويُوالُونَ."},{"w":"حَآدَّ","m":"عَادَى."},{"w":"عَشِيرَتَهُمۡ","m":"أَقْرِباءَهُم."},{"w":"كَتَبَ","m":"ثَبَّتَ."},{"w":"وَأَيَّدَهُم","m":"قَوَّاهُم."},{"w":"بِرُوحٖ","m":"بِنَصْرٍ وتأْيِيدٍ."},{"w":"حِزۡبُ ٱللَّهِ","m":"أولياؤُهُ."},{"w":"ٱلۡمُفۡلِحُونَ","m":"الفائِزُونَ بِسَعادةِ الدُّنيا والآخِرَةِ."}]}