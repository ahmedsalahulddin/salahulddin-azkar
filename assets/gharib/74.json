{"1":[{"w":"ٱلۡمُدَّثِّرُ","m":"المتَغَطِّي بِثِيابِهِ."}],"2":[{"w":"قُمۡ","m":"أي: مِن مَضْجَعِكَ."},{"w":"فَأَنذِرۡ","m":"فَحَذِّر النَّاس مِنْ عَذابِ اللهِ."}],"3":[{"w":"وَرَبَّكَ فَكَبِّرۡ","m":"وخُصَّ رَبَّكَ وَحْدَهُ بالتَّعْظِيمِ والعِبادَةِ."}],"4":[{"w":"وَثِيَابَكَ فَطَهِّرۡ","m":"أي: مِنَ النَّجاساتِ."}],"5":[{"w":"وَٱلرُّجۡزَ فَٱهۡجُرۡ","m":"ودُمْ على هَجْر أَعْمالِ الشِّرْكِ كُلِّها."}],"6":[{"w":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ","m":"وَلَا تُعْطِ العَطِيَّةَ كَي تَلْتَمِسَ أَكْثَرَ مِنْها."}],"7":[{"w":"وَلِرَبِّكَ فَٱصۡبِرۡ","m":"وَلِمَرْضاةِ رَبِّكَ فاصْبِرْ عَلَى الأَوامِرِ والنَّواهِي."}],"8":[{"w":"نُقِرَ","m":"نُفِخَ نَفْخَةَ البعثِ والنُّشُورِ."},{"w":"ٱلنَّاقُورِ","m":"القَرْنِ الَّذِي يُنْفَخُ فِيهِ."}],"11":[{"w":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا","m":"دَعْنِي -أيُّها الرَّسُولُ- أَنا والَّذِي خَلَقْتُه في بَطْنِ أُمِّهِ وَحِيداً لا مالَ لَهُ ولا وَلدَ."}],"12":[{"w":"مَمۡدُودٗا","m":"مبسُوطاً واسِعاً."}],"13":[{"w":"شُهُودٗا","m":"حاضِرِينَ مَعَهُ في «مكَّةَ» لَا يغِيبُونَ عَنْهُ."}],"14":[{"w":"وَمَهَّدتُّ لَهُۥ","m":"وَيَسَّرتُ لَهُ سُبُلَ العيشِ."}],"15":[{"w":"أَنۡ أَزِيدَ","m":"أي: في مالِهِ وَوَلَدِهِ."}],"16":[{"w":"كَلَّآ","m":"ليس الأمرُ كما يَزْعُمُ."},{"w":"لِأٓيَٰتِنَا","m":"للقرآنِ."},{"w":"عَنِيدٗا","m":"معانِداً مُكَذِّباً."}],"17":[{"w":"سَأُرۡهِقُهُۥ","m":"سَأُكَلِّفُه."},{"w":"صَعُودًا","m":"مَشَقَّةً مِنَ العذَابِ."}],"18":[{"w":"فَكَّرَ","m":"في نَفْسِهِ."},{"w":"وَقَدَّرَ","m":"وَهَيَّأ ما يقُولُه مِنَ الطَّعنِ في مُحَمَّدٍ ﷺ والقرآنِ."}],"19":[{"w":"فَقُتِلَ","m":"فَلُعِنَ، واسْتَحَقَّ بِذَلِكَ الهَلاكَ."},{"w":"كَيۡفَ قَدَّرَ","m":"كَيفَ أَعَدَّ في نفسهِ هَذا الطَّعْنَ."}],"21":[{"w":"نَظَرَ","m":"تَأَمَّلَ فيما قَدَّرَ وَهَيَّأَ مِنَ الطَّعْنِ في القرآنِ."}],"22":[{"w":"عَبَسَ","m":"قَطَّبَ وَجْهَهُ."},{"w":"وَبَسَرَ","m":"واشْتَدَّ في العُبُوسِ."}],"23":[{"w":"أَدۡبَرَ","m":"رَجَعَ مُعْرِضاً عَنِ الحقِّ."},{"w":"وَٱسۡتَكۡبَرَ","m":"وَتَعَاظَمَ أَن يَعْتَرِفَ بِهِ."}],"24":[{"w":"إِنۡ هَٰذَآ","m":"ما الَّذِي يَقُولُه مُحَمَّدٌ."},{"w":"يُؤۡثَرُ","m":"يُنْقلُ عَنِ الأوّلِينَ."}],"25":[{"w":"قَوۡلُ ٱلۡبَشَرِ","m":"كلامُ المخلُوقِينَ، تَعَلَّمَهُ مُحَمَّدٌ مِنْهُم، ثُمَّ ادَّعى أَنَّهُ مِنْ عندِ اللهِ."}],"26":[{"w":"سَأُصۡلِيهِ","m":"سَأُدْخِلُهُ."},{"w":"سَقَرَ","m":"جَهَنَّمَ."}],"27":[{"w":"وَمَآ أَدۡرَىٰكَ","m":"وما أَعلَمَكَ."},{"w":"مَا سَقَرُ","m":"أيُّ شَيءٍ جَهَنَّمُ؟"}],"28":[{"w":"لَا تُبۡقِي","m":"لا تَتْرُكُ مِنْ أجْزَاءِ المُعَذَّبِينَ شَيئاً."},{"w":"وَلَا تَذَرُ","m":"وَلَا تَتْرُكُ مَنْ فيها مَيِّتاً، وَلَكِنَّها تُحْرِقُهُم كُلَّما جُدِّدَ خَلْقُهُم."}],"29":[{"w":"لَوَّاحَةٞ","m":"حَرَّاقَةٌ، مُغيِّرةٌ، مُسَوِّدةٌ."},{"w":"لِلۡبَشَرِ","m":"للجُلودِ، مُفْردُها: بَشَرةٌ."}],"30":[{"w":"عَلَيۡهَا","m":"يَلِي أَمْرَ جَهَنَّمَ وَيَتَسَلَّطُ على أَهْلِها بالعَذابِ."},{"w":"تِسۡعَةَ عَشَرَ","m":"مَلَكاً مِنَ الزَّبانِيَةِ الأَشِدَّاءِ."}],"31":[{"w":"أَصۡحَٰبَ ٱلنَّارِ","m":"خَزَنَةَ النَّارِ."},{"w":"عِدَّتَهُمۡ","m":"ذِكْرَ عَدَدِهِم."},{"w":"فِتۡنَةٗ","m":"اخْتِباراً."},{"w":"لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ","m":"ليَحْصُلَ اليقِينُ لِليهُودِ والنَّصَارى."},{"w":"وَلَا يَرۡتَابَ","m":"وَلَا يَشُكَّ."},{"w":"مَرَضٞ","m":"نِفاقٌ."},{"w":"مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗا","m":"ما الَّذِي أَرَادَهُ اللهُ بِهذا العَدَدِ؟"},{"w":"كَذَٰلِكَ","m":"بِمِثْلِ ذَلِكَ الَّذِي ذُكِرَ."},{"w":"جُنُودَ رَبِّكَ","m":"عَدَدَهُم."},{"w":"هِيَ","m":"النَّارُ."},{"w":"ذِكۡرَىٰ","m":"تَذْكِرَةٌ وَمَوْعِظَةٌ."}],"32":[{"w":"كَلَّا","m":"ليسَ الأمرُ كَما ذَكَرُوا."}],"33":[{"w":"إِذۡ أَدۡبَرَ","m":"حِينَ وَلَّى وَذَهَبَ."}],"34":[{"w":"أَسۡفَرَ","m":"أَضَاءَ."}],"35":[{"w":"إِنَّهَا","m":"إِنَّ النَّارَ."},{"w":"ٱلۡكُبَرِ","m":"العَظائِمِ."}],"36":[{"w":"نَذِيرٗا","m":"إِنْذاراً وَتَخْوِيفاً."}],"37":[{"w":"يَتَقَدَّمَ","m":"يَتَقَرَّبَ إلى رَبِّهِ بِفِعْلِ الطَّاعاتِ."},{"w":"أَوۡ يَتَأَخَّرَ","m":"بِفِعْلِ المعاصِي."}],"38":[{"w":"بِمَا كَسَبَتۡ","m":"مِنْ أَعْمالِ الخيرِ والشَّرِ."},{"w":"رَهِينَةٌ","m":"مَحْبُوسَةٌ مَرْهُونَةٌ بِكَسْبِها."}],"39":[{"w":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ","m":"وهم المسْلِمُونَ المخلِصُونَ."}],"40":[{"w":"يَتَسَآءَلُونَ","m":"يَسْأَلُ بَعْضُهُم بَعْضاً."}],"41":[{"w":"عَنِ ٱلۡمُجۡرِمِينَ","m":"عَنِ الكافِرِينَ الَّذينَ أَجْرمُوا في حَقِّ أَنْفُسِهِم."}],"42":[{"w":"مَا سَلَكَكُمۡ","m":"ما الَّذِي أَدْخَلَكُم."},{"w":"سَقَرَ","m":"جَهَنَّمَ."}],"45":[{"w":"نَخُوضُ","m":"نَتَحَدَّثُ بالباطِلِ."},{"w":"مَعَ ٱلۡخَآئِضِينَ","m":"مَعَ أَهْلِ الضَّلالةِ."}],"46":[{"w":"بِيَوۡمِ ٱلدِّينِ","m":"بِيومِ الحِسابِ والجزَاءِ."}],"47":[{"w":"ٱلۡيَقِينُ","m":"الموتُ."}],"48":[{"w":"شَفَٰعَةُ","m":"طَلَبُ قَضَاءِ حاجَةِ المشْفُوعِ لَهُ عِنْدَ المَشْفُوعِ عنْدَهُ."},{"w":"ٱلشَّٰفِعِينَ","m":"الملائِكَةِ والنَّبِيِّينَ وَغَيرِهِم."}],"49":[{"w":"فَمَا لَهُمۡ","m":"فما لِهؤُلَاءِ المشْرِكِينَ."},{"w":"عَنِ ٱلتَّذۡكِرَةِ","m":"عَنِ القُرآنِ وما فِيهِ مِنَ الموَاعِظِ."},{"w":"مُعۡرِضِينَ","m":"مُنْصَرِفِينَ."}],"50":[{"w":"حُمُرٞ","m":"حُمُرٌ وَحْشِيَّةٌ."},{"w":"مُسۡتَنفِرَةٞ","m":"شَدِيدَةُ النِّفارِ."}],"51":[{"w":"قَسۡوَرَةِۭ","m":"أَسَدٍ كَاسِرٍ."}],"52":[{"w":"صُحُفٗا","m":"كُتُباً."},{"w":"مُنَشَّرَةٗ","m":"مَفْتُوحَةً مَقْرُوءَةً."}],"53":[{"w":"كَلَّا","m":"ليسَ الأمرُ كَما زَعَمُوا."},{"w":"لَا يَخَافُونَ ٱلۡأٓخِرَةَ","m":"لا يُصَدِّقُونَ بالبَعْثِ والجزَاءِ."}],"54":[{"w":"كَلَّآ","m":"حَقّاً."},{"w":"إِنَّهُۥ","m":"إِنَّ القُرآنَ."},{"w":"تَذۡكِرَةٞ","m":"مَوْعِظَةٌ بَلِيغَةٌ كافِيَةٌ لِاتِّعاظِهِم."}],"55":[{"w":"ذَكَرَهُۥ","m":"اتَّعظَ بِما فِيهِ وانْتَفَعَ بِهُدَاهُ."}],"56":[{"w":"وَمَا يَذۡكُرُونَ","m":"وَما يَتَّعِظُونَ بِه."},{"w":"هُوَ أَهۡلُ ٱلتَّقۡوَىٰ","m":"المُسْتَحِقُّ لِأَن يُتَّقَى وَيُطاعَ."},{"w":"وَأَهۡلُ ٱلۡمَغۡفِرَةِ","m":"والجديرُ بأن يَغْفِرَ لِمَنْ آمنَ بِهِ وَأطاعَهُ."}]}