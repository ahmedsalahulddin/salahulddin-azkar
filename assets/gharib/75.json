{"1":[{"w":"لَآ أُقۡسِمُ","m":"أحْلِفُ."}],"2":[{"w":"وَلَآ أُقۡسِمُ","m":"وأحْلِفُ."},{"w":"بِٱلنَّفۡسِ ٱللَّوَّامَةِ","m":"بالأنْفُسِ الَّتِي تَلُومُ صاحِبَها على تَرْكِ الطَّاعاتِ وفِعْلِ السَّيئاتِ."}],"3":[{"w":"أَيَحۡسَبُ","m":"أَيَظُنُّ."},{"w":"أَلَّن نَّجۡمَعَ عِظَامَهُۥ","m":"أَن لَن نَقْدِرَ على جَمْعِ عِظامِهِ بَعْدَ تَفَرُّقِها."}],"4":[{"w":"بَلَىٰ","m":"بَلْ سَنَجْمَعُها."},{"w":"أَن نُّسَوِّيَ بَنَانَهُۥ","m":"نُعيدَ خَلْقَ أَصابِعِه أو أنامِلِه مُقَوَّمةً مُتْقَنةً."}],"5":[{"w":"لِيَفۡجُرَ","m":"لِيَبْقَى على فجُورِهِ."},{"w":"أَمَامَهُۥ","m":"فِيما يَسْتَقْبِلُ مِنْ أيامِ عُمُرِهِ."}],"6":[{"w":"أَيَّانَ","m":"مَتَى."}],"7":[{"w":"بَرِقَ ٱلۡبَصَرُ","m":"تَحَيَّر البَصَرُ ودُهِشَ فَزِعاً مما رَأى مِنْ أَهْوالِ يَومِ القِيامَةِ."}],"8":[{"w":"وَخَسَفَ ٱلۡقَمَرُ","m":"وَذَهبَ نُورُ القَمَرِ."}],"9":[{"w":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","m":"في ذَهابِ ضَوْئِهِما."}],"11":[{"w":"كَلَّا","m":"ليسَ الأمرُ كَما تَتَمَنَّاهُ."},{"w":"لَا وَزَرَ","m":"لا مَلْجأَ لَكَ وَلَا مَنْجَى."}],"12":[{"w":"ٱلۡمُسۡتَقَرُّ","m":"مَصِيرُ الخلائِقِ يومَ القِيَامةِ."}],"13":[{"w":"بِمَا قَدَّمَ وَأَخَّرَ","m":"بِجَمِيعِ أَعْمالِهِ: مِنْ خَيرٍ وَشَرٍّ، ما قدَّمَهُ مِنْها في حياتِهِ وما أخَّرَهُ."}],"14":[{"w":"عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","m":"بَصِيرٌ بِنَفْسِهِ، يعلَمُ اسْتِحْقاقَهُ لِلْعِقابِ."}],"15":[{"w":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","m":"حتَّى في حِينِ إِخْبارِه باعْتِذاراتِهِ الكاذِبةِ."}],"16":[{"w":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","m":"لا تُحَرِّكْ -–أيُّها النَّبِيُّ- بالقُرآنِ لِسانَكَ حتَّى نُزُولِ الوحْيِ؛ لِأَجْلِ أَن تَتَعَجَّلَ بِحِفْظِهِ، مخَافَةَ أَن يَتَفَلَّتَ مِنْكَ."}],"17":[{"w":"جَمۡعَهُۥ","m":"في صَدرِكَ."},{"w":"وَقُرۡءَانَهُۥ","m":"أَن تَقْرَأَهُ بِلِسانِكَ مَتَى شِئْتَ."}],"18":[{"w":"فَإِذَا قَرَأۡنَٰهُ","m":"فَإِذا قَرَأَهُ عَلَيكَ رَسُولُنا جِبْرِيلُ."},{"w":"فَٱتَّبِعۡ قُرۡءَانَهُۥ","m":"فاسْتمِعْ لِقِرَاءتِه وَأَنْصِتْ لَهُ، ثُمَّ اقْرَأْهُ كَمَا أَقْرَأَكَ إِيَّاهُ."}],"19":[{"w":"بَيَانَهُۥ","m":"تَوْضِيحَ ما أَشْكَلَ عَلَيكَ فَهْمُهُ مِن مَعانِيهِ وأَحْكامِهِ."}],"20":[{"w":"كَلَّا","m":"ليسَ الأمرُ كَما زَعَمْتُم أن لَا بَعْثَ وَلَا جَزاءَ."},{"w":"ٱلۡعَاجِلَةَ","m":"الدُّنيا وَزِينَتَها."}],"22":[{"w":"وُجُوهٞ","m":"وُجُوهُ أهْلِ السَّعادةِ."},{"w":"يَوۡمَئِذٖ","m":"يومَ القيامةِ."},{"w":"نَاضِرَةٌ","m":"مُشْرِقَةٌ مُتَأَلِّقَةٌ."}],"23":[{"w":"إِلَىٰ رَبِّهَا نَاظِرَةٞ","m":"تَنْظُرُ إلى خالِقِها فَتَتَمَتَّعُ بِذَلِكَ."}],"24":[{"w":"وَوُجُوهٞ","m":"وَوُجُوهُ الأشْقِياءِ."},{"w":"يَوۡمَئِذِۭ","m":"يَومَ القِيامَةِ."},{"w":"بَاسِرَةٞ","m":"عابِسَةٌ كالِحَةٌ."}],"25":[{"w":"تَظُنُّ","m":"تَتَوقَّعُ."},{"w":"فَاقِرَةٞ","m":"مُصِيبَةٌ عَظِيمَةٌ."}],"26":[{"w":"كَلَّآ","m":"حَقّاً."},{"w":"بَلَغَتِ ٱلتَّرَاقِيَ","m":"وَصَلَت الرُّوحُ إلى الحُلْقُومِ."}],"27":[{"w":"وَقِيلَ","m":"وَقالَ بَعْضُ الحاضِرِينَ لِبَعْضٍ."},{"w":"مَنۡۜ رَاقٖ","m":"هَل مِن رَاقٍ يَرْقِيهِ ويَشْفيهِ بِرُقْيَتِهِ؟"}],"28":[{"w":"وَظَنَّ","m":"وََأَيقَنَ المُحْتَضِرُ."},{"w":"أَنَّهُ","m":"أي: الأمرَ الَّذِي نَزَلَ بِهِ."},{"w":"ٱلۡفِرَاقُ","m":"فراقُ الدُّنيا؛ لِمُعايَنَتِهِ مَلائِكَةَ الموْتِ."}],"29":[{"w":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","m":"واتَّصَلَتْ شِدَّةُ آخِر الدُّنيا بِشِدَّةِ أوّلِ الآخِرَةِ."}],"30":[{"w":"ٱلۡمَسَاقُ","m":"المرْجِعُ."}],"31":[{"w":"فَلَا صَدَّقَ","m":"فلا آمنَ الكَافِرُ بالرَّسُولِ ﷺ والقرآنِ."}],"32":[{"w":"كَذَّبَ","m":"بالقرآنِ."},{"w":"وَتَوَلَّىٰ","m":"وأَعْرَضَ عَنِ الإيمانِ."}],"33":[{"w":"يَتَمَطَّىٰٓ","m":"يَتَبَخْتَرُ مُخْتالاً في مِشْيتِهِ."}],"34":[{"w":"أَوۡلَىٰ لَكَ","m":"هَلَاكٌ لَكَ."},{"w":"فَأَوۡلَىٰ","m":"فَهَلَاكٌ."}],"36":[{"w":"ٱلۡإِنسَٰنُ","m":"هو المُنْكِرُ لِلْبَعثِ."},{"w":"سُدًى","m":"هَمَلاً لا يُحاسَبُ؟"}],"37":[{"w":"نُطۡفَةٗ","m":"ماءً قَلِيلاً."},{"w":"مَنِيّٖ","m":"ماءِ الرَّجُلِ."},{"w":"يُمۡنَىٰ","m":"يُراقُ ويُصَبُّ في الأرحامِ."}],"38":[{"w":"عَلَقَةٗ","m":"قِطْعَةً مِن دمٍ جامِدٍ."},{"w":"فَسَوَّىٰ","m":"فعَدَّلَ صُورَتَهُ وقَوَّمَها في أَحْسَنِ تَقْوِيمٍ."}],"39":[{"w":"ٱلزَّوۡجَيۡنِ","m":"الصِّنْفَينِ."}],"40":[{"w":"يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","m":"يُعيدُ الخلْقَ بَعْدَ فَنائِهِم."}]}