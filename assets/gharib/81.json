{"1":[{"w":"كُوِّرَتۡ","m":"لُفَّتْ، وَذَهَبَ ضَوْءُها."}],"2":[{"w":"ٱنكَدَرَتۡ","m":"تَنَاثَرَتْ، فَذَهَبَ نُورُها."}],"3":[{"w":"سُيِّرَتۡ","m":"سُيِّرَتْ عن وَجْهِ الأرْضِ فَصَارَتْ هَباءً."}],"4":[{"w":"ٱلۡعِشَارُ","m":"النُوقُ الحوامِلُ."},{"w":"عُطِّلَتۡ","m":"تُرِكَتْ وَأُهْمِلَتْ."}],"5":[{"w":"ٱلۡوُحُوشُ","m":"الحيواناتُ الوَحْشِيَّةُ."},{"w":"حُشِرَتۡ","m":"جُمِعَتْ واخْتَلَطَتْ، لِيَقْتَصَّ اللهُ مِن بَعْضِها لِبَعْضٍ."}],"6":[{"w":"سُجِّرَتۡ","m":"أُوقِدَتْ."}],"7":[{"w":"زُوِّجَتۡ","m":"قُرِنَتْ بأَمثالِها."}],"8":[{"w":"ٱلۡمَوۡءُۥدَةُ","m":"الطِّفْلةُ المدفُونةُ حَيَّةً."},{"w":"سُئِلَتۡ","m":"سُؤالَ تَطْيِيبٍ لها وَلَومٍ لِوائِدِها."}],"10":[{"w":"ٱلصُّحُفُ","m":"صُحُفُ الأَعْمالِ."},{"w":"نُشِرَتۡ","m":"عُرِضَتْ."}],"11":[{"w":"كُشِطَتۡ","m":"أُزِيلَتْ مِن مَكانِها."}],"12":[{"w":"سُعِّرَتۡ","m":"أُوقِدَتْ."}],"13":[{"w":"أُزۡلِفَتۡ","m":"قُرِّبَتْ مِنْ أهْلِها."}],"14":[{"w":"أَحۡضَرَتۡ","m":"قَدَّمَتْ من خَيرٍ أو شَرٍّ."}],"15":[{"w":"بِٱلۡخُنَّسِ","m":"بِالنُّجُومِ المُخْتَفِيَةِ أَنْوَارُها نهاراً."}],"16":[{"w":"ٱلۡجَوَارِ","m":"الجارِيةِ."},{"w":"ٱلۡكُنَّسِ","m":"المسْتَتِرَةِ في أَبْراجِها."}],"17":[{"w":"عَسۡعَسَ","m":"أَقْبَلَ بِظَلامِهِ."}],"18":[{"w":"تَنَفَّسَ","m":"ظَهَرَ ضِياؤُه."}],"19":[{"w":"إِنَّهُۥ","m":"إِنَّ القُرآنَ."},{"w":"رَسُولٖ كَرِيمٖ","m":"هو جِبْرِيلُ، عَلَيه السَّلامُ."}],"20":[{"w":"ذِي ٱلۡعَرۡشِ","m":"صَاحِبِ العَرْشِ، وَهُوَ اللهُ."},{"w":"مَكِينٖ","m":"صاحبِ مَكانَةٍ رَفِيعَةٍ."}],"21":[{"w":"ثَمَّ","m":"هُنَاكَ."},{"w":"أَمِينٖ","m":"مُؤْتَمَنٍ على الوَحْيِ الَّذِي يَنْزِلُ بِه."}],"22":[{"w":"صَاحِبُكُم","m":"مُحَمَّدٌ ﷺ الَّذِي تَعْرِفُونَهُ."}],"23":[{"w":"وَلَقَدۡ رَءَاهُ","m":"وَلَقَدْ رَأَى مُحَمَّدٌ ﷺ جِبْرِيلَ."},{"w":"بِٱلۡأُفُقِ ٱلۡمُبِينِ","m":"بالأُفُقِ العَظِيمِ."}],"24":[{"w":"عَلَى ٱلۡغَيۡبِ","m":"بِتَبْلِيغ الوَحْيِ."},{"w":"بِضَنِينٖ","m":"ببَخِيلٍ."}],"25":[{"w":"رَجِيمٖ","m":"مَطْرُودٍ مِن رَحْمَةِ اللهِ."}],"26":[{"w":"فَأَيۡنَ تَذۡهَبُونَ","m":"فَأَينَ تَذْهَبُ بِكُم عُقُولُكُم في التَّكْذِيبِ بالقُرآنِ بَعْدَ هذِه الحُجَجِ القاطِعَةِ؟"}],"27":[{"w":"ذِكۡرٞ","m":"مَوعِظَةٌ."}],"28":[{"w":"يَسۡتَقِيمَ","m":"على الحقِّ والإيمانِ."}]}