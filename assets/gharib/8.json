{"1":[{"w":"ٱلۡأَنفَالِ","m":"جَمْعُ نَفَل، وهي: الغنائمُ في غزوةِ «بَدْر»."},{"w":"ذَاتَ بَيۡنِكُمۡ","m":"الصِّلَة التي تَرْبِطُ بعضَكم ببعض."}],"2":[{"w":"وَجِلَتۡ","m":"خافَتْ وفَزِعَتْ."},{"w":"وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ","m":"يعتمدون عليه ويُفَوِّضون أمرَهم إليه."}],"4":[{"w":"دَرَجَٰتٌ","m":"منازلُ عاليةٌ."}],"5":[{"w":"كَمَآ أَخۡرَجَكَ","m":"هذه الحالُ في كراهةِ فريقٍ من المؤمنين للقتالِ بعد تَبَيُّنِه، مثلُ إخراجِك في حالِ كراهتِهم."}],"6":[{"w":"فِي ٱلۡحَقِّ","m":"في القتالِ."}],"7":[{"w":"ٱلطَّآئِفَتَيۡنِ","m":"القافلةِ الآتيةِ من الشام وما تحمِلُه من أرزاقٍ، أو الأعداءِ الَّذين خَرَجُوا لقِتَالِكُمْ."},{"w":"غَيۡرَ ذَاتِ ٱلشَّوۡكَةِ","m":"غيرَ ذاتِ السِّلاحِ والقُوَّةِ، وهي: القافلةُ."},{"w":"وَيَقۡطَعَ دَابِرَ ٱلۡكَٰفِرِينَ","m":"الدابِرُ: الآخِرُ، أي: ويستأصِلَ الكافرين بالهَلاكِ."}],"8":[{"w":"لِيُحِقَّ ٱلۡحَقَّ","m":"ليُظْهِرَه للناسِ ويُبَيِّنَه."}],"9":[{"w":"تَسۡتَغِيثُونَ","m":"تَطْلُبون النَّصْرَ على عَدُوِّكم."},{"w":"مُرۡدِفِينَ","m":"يَتْبَعُ بعضُهم بعضاً."}],"10":[{"w":"وَمَا جَعَلَهُ ٱللَّهُ","m":"وما جَعَلَ الإمدادَ."},{"w":"وَلِتَطۡمَئِنَّ","m":"ولِتَسْكُنَ وتُوقِنَ بنَصْرِ اللهِ."}],"11":[{"w":"يُغَشِّيكُمُ","m":"يُلْقي اللهُ عليكم."},{"w":"أَمَنَةٗ مِّنۡهُ","m":"أماناً من الله لكم."},{"w":"وَيُذۡهِبَ","m":"ويُزيلَ."},{"w":"رِجۡزَ ٱلشَّيۡطَٰنِ","m":"وَساوِسَه بما خَطَرَ لهم من الخوفِ والفَشَلِ."},{"w":"وَلِيَرۡبِطَ عَلَىٰ قُلُوبِكُمۡ","m":"وليُقَوِّيَها بالصَّبرِ والشَّجاعةِ."}],"12":[{"w":"أَنِّي مَعَكُمۡ","m":"بإعانتي ونَصْري."},{"w":"فَثَبِّتُواْ ٱلَّذِينَ ءَامَنُواْ","m":"فَقَوُّوا عزائمَهم، وبَشِّرُوهم بالنَّصْرِ."},{"w":"ٱلرُّعۡبَ","m":"الخوفَ الشديدَ."},{"w":"فَوۡقَ ٱلۡأَعۡنَاقِ","m":"رؤوسَ الكفارِ."},{"w":"كُلَّ بَنَانٖ","m":"كلَّ طَرَفٍ ومِفْصَلٍ في الجسمِ."}],"13":[{"w":"ذَٰلِكَ","m":"ما وَقَعَ عليهم من القَتْل."},{"w":"شَآقُّواْ ٱللَّهَ","m":"خالَفُوا أَمْرَه."}],"15":[{"w":"زَحۡفٗا","m":"مُتقارِبين يَدْنُو كلُّ فريقٍ من الآخَرِ."},{"w":"فَلَا تُوَلُّوهُمُ ٱلۡأَدۡبَارَ","m":"فلا تُدِيروا لهم ظُهورَكم مُنْهَزِمين."}],"16":[{"w":"مُتَحَرِّفٗا لِّقِتَالٍ","m":"مائِلاً عن موقفِه إلى موضعٍ أصلَحَ للقتالِ فيه."},{"w":"مُتَحَيِّزًا","m":"مُنْحازاً ومنضَمّاً."},{"w":"فِئَةٖ","m":"جماعةٍ من المسلمين في ميدانِ القتالِ."},{"w":"بَآءَ بِغَضَبٖ مِّنَ ٱللَّهِ","m":"استحَقَّ غضَبه."}],"17":[{"w":"وَلِيُبۡلِيَ ٱلۡمُؤۡمِنِينَ","m":"وليختبرَ اللهُ المؤمنين بنِعَمِه وإحسانِه."}],"18":[{"w":"مُوهِنُ","m":"مُضْعِفُ ومُبْطِلُ."},{"w":"كَيۡدِ ٱلۡكَٰفِرِينَ","m":"مَكْرِهم واحتيالِهم."}],"19":[{"w":"تَسۡتَفۡتِحُواْ","m":"تطلُبوا النَّصْرَ أيها الكفارُ."},{"w":"جَآءَكُمُ ٱلۡفَتۡحُ","m":"تَهَكُّمٌ بالكفارِ، فقد نَصَرَ اللهُ المؤمنين بـ «بَدْرٍ»."},{"w":"وَإِن تَعُودُواْ","m":"إلى الكفرِ وقتالِ النبيِّ ﷺ."},{"w":"نَعُدۡ","m":"بهزيمَتِكم ونَصْرِه - ﷺ - عليكم."},{"w":"فِئَتُكُمۡ","m":"جماعتُكم."},{"w":"مَعَ ٱلۡمُؤۡمِنِينَ","m":"بتأييدِه ونَصْرِه."}],"20":[{"w":"وَلَا تَوَلَّوۡاْ","m":"ولا تُعْرِضُوا عن طاعةِ اللهِ ورسولهِ."},{"w":"تَسۡمَعُونَ","m":"ما يُتلى عليكم من الحُجَجِ والبرَاهينِ."}],"22":[{"w":"ٱلدَّوَآبِّ","m":"جَمْعُ دَابّة، وهي: ما دَبَّ على الأرضِ مِن خَلْقِ اللهِ."},{"w":"ٱلصُّمُّ","m":"مَنِ انسَدَّتْ آذانُهم عن سماعِ الحقِّ."},{"w":"ٱلۡبُكۡمُ","m":"مَن خَرِسَتْ ألسنتُهم عن النُّطقِ به."}],"23":[{"w":"لَأَسۡمَعَهُمۡ","m":"مواعِظَ القرآنِ وعِبَرَه."},{"w":"لَتَوَلَّواْ","m":"لَأَعْرَضُوا عن الإيمان عِناداً."},{"w":"مُعۡرِضُونَ","m":"صادُّون عنه."}],"24":[{"w":"لِمَا يُحۡيِيكُمۡ","m":"لما فيه الحياةُ الأبديةُ."},{"w":"بَيۡنَ ٱلۡمَرۡءِ وَقَلۡبِهِۦ","m":"بين الإنسانِ وخواطِرِ قلبِه، فاللهُ أملَكُ لقلوبِ عبادِه منهم."}],"25":[{"w":"فِتۡنَةٗ","m":"ابتلاءً ومِحْنَةً تنزِلُ بكم."}],"26":[{"w":"مُسۡتَضۡعَفُونَ","m":"قليلُو العَدَدِ، مَقْهُورون."},{"w":"يَتَخَطَّفَكُمُ","m":"يَأْخُذَكُم بسُرعةٍ."},{"w":"ٱلنَّاسُ","m":"كفارُ قريشٍ."},{"w":"فَـَٔاوَىٰكُمۡ","m":"جَعَلَ اللهُ لكم «المدينةَ» مَأْوىً تَأْوُون إليه."}],"27":[{"w":"لَا تَخُونُواْ ٱللَّهَ","m":"بتَرْكِ ما أَوْجَبَه عليكم، وارتكابِ ما نَهاكم عنه."},{"w":"أَمَٰنَٰتِكُمۡ","m":"ما ائتُمِنْتُم عليه من التكاليفِ الشرعيةِ."}],"28":[{"w":"فِتۡنَةٞ","m":"اختبارٌ لكم."}],"29":[{"w":"فُرۡقَانٗا","m":"فَصْلاً بين الحَقِّ والباطِلِ."}],"30":[{"w":"يَمۡكُرُ بِكَ","m":"يَكِيدُ لك."},{"w":"لِيُثۡبِتُوكَ","m":"ليَحْبِسُوك."},{"w":"يُخۡرِجُوكَ","m":"من بلدِك «مكةَ»."}],"31":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"جَمْعُ أُسْطُورة، وهي: ما سُطِّرَ في كُتُبِ السابقين من الأخبارِ المكذوبةِ."}],"32":[{"w":"إِن كَانَ هَٰذَا","m":"ما جاءَ به محمدٌ ﷺ."}],"33":[{"w":"وَأَنتَ فِيهِمۡ","m":"وأنت مقيمٌ بينَهم في «مكةَ»."}],"34":[{"w":"وَمَا لَهُمۡ أَلَّا يُعَذِّبَهُمُ ٱللَّهُ","m":"وأيُّ شيءٍ يَمْنَعُ من عذابه لهم؟"},{"w":"يَصُدُّونَ","m":"يَمْنَعُون."},{"w":"عَنِ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ","m":"عن الطَّوافِ بالكعبةِ، والصَّلاةِ فيه."},{"w":"وَمَا كَانُوٓاْ أَوۡلِيَآءَهُۥٓ","m":"وما كان الكفارُ أولياءَ اللهِ ولا المسجدِ الحرامِ."}],"35":[{"w":"مُكَآءٗ","m":"صَفيراً."},{"w":"وَتَصۡدِيَةٗ","m":"وتَصْفيقاً."},{"w":"فَذُوقُواْ ٱلۡعَذَابَ","m":"في الدنيا بالقَتْلِ والأَسْرِ في «بدرٍ»، وفي الآخرةِ بالنارِ."}],"36":[{"w":"حَسۡرَةٗ","m":"ندامةً وأَسَفاً."}],"37":[{"w":"لِيَمِيزَ","m":"ليَفْصِلَ."},{"w":"فَيَرۡكُمَهُۥ","m":"يَجْمَعَه ويَضُمَّ بعضَه إلى بعضٍ."}],"38":[{"w":"إِن يَنتَهُواْ","m":"عن الكفرِ، ويَرْجِعُوا إلى الإيمان."},{"w":"وَإِن يَعُودُواْ","m":"إلى قتالِ النبيِّ ﷺ."},{"w":"مَضَتۡ","m":"سَبَقَتْ."},{"w":"سُنَّتُ ٱلۡأَوَّلِينَ","m":"سنَّتُنا في عقوبةِ مَنْ كَذَّبَ واستمرَّ على كُفْرِه."}],"39":[{"w":"فِتۡنَةٞ","m":"شِرْكٌ وصَدٌّ عن سبيل الله."},{"w":"وَيَكُونَ ٱلدِّينُ كُلُّهُۥ لِلَّهِ","m":"وتكونَ الطاعةُ والعبادةُ كلُّهاخالصةً لله."},{"w":"فَإِنِ ٱنتَهَوۡاْ","m":"فإن انزجَرَ المشركون عن شِرْكِهم وفتنةِ المؤمنين."}],"40":[{"w":"مَوۡلَىٰكُمۡ","m":"مُعينُكم وناصِرُكم."}],"41":[{"w":"غَنِمۡتُم","m":"ظَفِرْتُمْ به من الأعداءِ بالجِهادِ."},{"w":"وَلِذِي ٱلۡقُرۡبَىٰ","m":"قَرابةِ الرسولِ ﷺ، وهم بنو هاشمٍ وبنو المطَّلِبِ."},{"w":"وَٱلۡيَتَٰمَىٰ","m":"الأطفالِ الذين مات آباؤُهم وهم دونَ سِنِّ البُلوغ."},{"w":"وَٱلۡمَسَٰكِينِ","m":"أهلِ الحاجةِ الذين لا يَمْلِكُون ما يَكْفيهم."},{"w":"وَٱبۡنِ ٱلسَّبِيلِ","m":"المسافرِ الذي انقطعَتْ به النفقةُ."},{"w":"وَمَآ أَنزَلۡنَا","m":"من الملائكةِ والآياتِ والنَّصْرِ."},{"w":"يَوۡمَ ٱلۡفُرۡقَانِ","m":"يومَ «بَدْرٍ» حينَ فَرَقَ اللهُ بينَ الحقِّ والباطلِ."}],"42":[{"w":"بِٱلۡعُدۡوَةِ ٱلدُّنۡيَا","m":"جانبِ الوادي الأقربِ إلى «المدينة»."},{"w":"ٱلۡقُصۡوَىٰ","m":"البعيدةِ عن «المدينةِ»."},{"w":"وَٱلرَّكۡبُ","m":"عِيرُ التجارةِ وأصحابُها."},{"w":"أَسۡفَلَ مِنكُمۡ","m":"في مكانٍ أسفلَ من مكانِكم جهةَ ساحلِ البحرِ الأحمرِ."},{"w":"لِيَقۡضِيَ ٱللَّهُ أَمۡرٗا كَانَ مَفۡعُولٗا","m":"بنَصْرِ أوليائِه وخِذْلانِ أعدائِه."},{"w":"لِيَهۡلِكَ مَنۡ هَلَكَ","m":"ليموتَ مَنْ يموتُ من الكفَّارِ."},{"w":"عَنۢ بَيِّنَةٖ","m":"عن حُجَّةٍ عايَنَها."},{"w":"وَيَحۡيَىٰ مَنۡ حَيَّ","m":"ويعيشَ مَنْ يعيشُ مِنهُم."}],"43":[{"w":"لَفَشِلۡتُمۡ","m":"لَجَبُنْتُم وضَعُفتم."},{"w":"وَلَتَنَٰزَعۡتُمۡ","m":"اختلَفْتُم."},{"w":"فِي ٱلۡأَمۡرِ","m":"في القتالِ."},{"w":"سَلَّمَ","m":"عَصَمَ من الضَّعْفِ والاختلافِ."}],"46":[{"w":"رِيحُكُمۡ","m":"قُوَّتُكم ونَصْرُكم."},{"w":"مَعَ ٱلصَّٰبِرِينَ","m":"بالعَوْنِ والنصرِ والتأييدِ."}],"47":[{"w":"بَطَرٗا","m":"كِبْراً."},{"w":"وَرِئَآءَ ٱلنَّاسِ","m":"مراءاةً لهم وطَلَباً للفَخْرِ."}],"48":[{"w":"زَيَّنَ","m":"حَسَّنَ."},{"w":"جَارٞ لَّكُمۡ","m":"مُعينٌ وناصرٌ لكم."},{"w":"تَرَآءَتِ ٱلۡفِئَتَانِ","m":"التقى المسلمون مع الكفارِ."},{"w":"نَكَصَ عَلَىٰ عَقِبَيۡهِ","m":"رَجَعَ إلى الوراء ووَلَّى هارباً."},{"w":"إِنِّيٓ أَرَىٰ مَا لَا تَرَوۡنَ","m":"مِن الملائكةِ الذين جاؤوا لنُصْرَةِ المؤمنين."}],"49":[{"w":"ٱلۡمُنَٰفِقُونَ","m":"جَمْعُ مُنافق، وهو: مَن يُظهِرُ الإسلامَ ويُبْطِنُ الكفرَ."},{"w":"وَٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٌ","m":"ضِعافُ الإيمانِ الشاكُّون من غيرِ نِفاقٍ."},{"w":"غَرَّ هَٰٓؤُلَآءِ دِينُهُمۡ","m":"أي: اغترَّ المسلمون بدينِهم حتى تَكَلَّفُوا قتالَ المشركين."},{"w":"يَتَوَكَّلۡ عَلَى ٱللَّهِ","m":"يُفَوِّضْ أمرَه إليه ويعتمدْ عليه."}],"50":[{"w":"يَتَوَفَّى","m":"يَقْبِضُ ويَنْتَزِعُ."},{"w":"وَأَدۡبَٰرَهُمۡ","m":"ظهورَهم."},{"w":"ٱلۡحَرِيقِ","m":"المُحْرِقِ، وهو جهنَّمُ."}],"51":[{"w":"بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ","m":"بسبب أعمالِكم ال