{"1":[{"w":"حمٓ","m":"سَبقَ الكلامُ على الحُرُوفِ المقطَّعةِ أَوَّلَ سُورةِ الْبَقَرَةِ."}],"4":[{"w":"وَمَا يَبُثُّ","m":"وما يَنْشُرُ ويُفَرِّقُ."},{"w":"دَآبَّةٍ","m":"ما يَدِبُّ عَلى الأرضِ غَيرَ الإِنْسانِ."},{"w":"يُوقِنُونَ","m":"يَعْلَمُونَ حَقَائِقَ الأَشْياءِ، فيُقِرُّونَ بِها."}],"5":[{"w":"وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","m":"تَعاقُبِهِما، أو تَفَاوُتِهِما بالطُّولِ والقِصَرِ والظُّلْمَةِ والضِّياءِ."},{"w":"رِزۡقٖ","m":"مَطَرٍ يَكُونُ مِنْهُ القُوتُ."},{"w":"وَتَصۡرِيفِ ٱلرِّيَٰحِ","m":"تَبْدِيلِ اللهِ سبحانه وتعالى للرِّياحِ صُعُوداً ونُزُولاً، واخْتلِافِ جِهاتِ هُبُوبِها."}],"7":[{"w":"وَيۡلٞ","m":"هَلَاكٌ شَدِيدٌ."},{"w":"أَفَّاكٍ","m":"كَذَّابٍ."},{"w":"أَثِيمٖ","m":"كَثِيرِ الآثامِ."}],"9":[{"w":"هُزُوًا","m":"مَوْضِعَ سُخْرِيةٍ واسْتِخْفافٍ."}],"10":[{"w":"مِن وَرَآئِهِمۡ","m":"من أمَامِهم."},{"w":"وَلَا يُغۡنِي عَنۡهُم","m":"ولا يَنْفَعُهُم."},{"w":"أَوۡلِيَآءَ","m":"نُصَراءَ."}],"11":[{"w":"رِجۡزٍ","m":"أسْوأِ العَذَابِ."}],"12":[{"w":"ٱلۡفُلۡكُ","m":"السُّفُنُ."}],"14":[{"w":"يَغۡفِرُواْ","m":"يَعْفُوا وَيَتجاوَزُوا."},{"w":"لَا يَرۡجُونَ","m":"لا يَخافُونَ."},{"w":"أَيَّامَ ٱللَّهِ","m":"بأسَهُ وَوَقَائِعَه ونِقَمَهُ."}],"15":[{"w":"فَعَلَيۡهَا","m":"فَعَلَى نَفْسِهِ جَنَى."}],"16":[{"w":"ٱلۡكِتَٰبَ","m":"التَّوْرَاةَ والإِنْجِيلَ."},{"w":"وَٱلۡحُكۡمَ","m":"الفَهْمَ للكِتابِ والعِلْمَ بِالسُّنَنِ الَّتي لم تَنْزِلْ في الكِتابِ."},{"w":"ٱلۡعَٰلَمِينَ","m":"عالَمِي أهلِ زَمانِهِم."}],"17":[{"w":"بَيِّنَٰتٖ","m":"دَلَالَاتٍ تُبَيِّنُ الحقَّ مِنَ الباطِلِ."},{"w":"ٱلۡعِلۡمُ","m":"الكتابُ والنُّبُوَّةُ والدَّلائِلُ الواضِحَةُ الَّتِي تُفَرِّقُ بين الحقِّ والباطِلِ."},{"w":"بَغۡيَۢا","m":"ظُلْماً وحَسَداً."}],"18":[{"w":"شَرِيعَةٖ","m":"مِنْهاجٍ واضِحٍ."},{"w":"مِنَ ٱلۡأَمۡرِ","m":"مِنْ أَمْرِ الدِّينِ."},{"w":"أَهۡوَآءَ","m":"ما تَمِيلُ نُفُوسُهُم إِلَيهِ مِمَّا يُخالِفُ شَرْعَ اللهِ."}],"19":[{"w":"يُغۡنُواْ","m":"يَدْفَعُوا."}],"20":[{"w":"بَصَٰٓئِرُ","m":"جَمْعُ بصِيرةٍ، وهي الحُجَّةُ فِيما يحتاجُونَ إِليهِ مِنَ الأحْكَامِ."}],"21":[{"w":"ٱجۡتَرَحُواْ","m":"اكْتَسَبُوا."},{"w":"سَوَآءٗ مَّحۡيَاهُمۡ وَمَمَاتُهُمۡ","m":"مُسْتَويةً حالةُ حياتِهِم وحالاتُ موتِهِم."}],"23":[{"w":"وَخَتَمَ عَلَىٰ سَمۡعِهِۦ","m":"وطَبَع عَلَى سَمْعِهِ، فَلَا يَسْمَعُ مَواعِظَ اللهِ."},{"w":"غِشَٰوَةٗ","m":"غِطاءً فَلَا يَنْتَفِعُ بِبَصَرِهِ."}],"24":[{"w":"ٱلدَّهۡرُ","m":"مُرورُ السِّنينَ والأَيَّامِ."},{"w":"عِلۡمٍ","m":"يَقِينٍ، بَلْ يَقُولُونَ ذَلكَ تَخَرُّصاً."}],"27":[{"w":"ٱلۡمُبۡطِلُونَ","m":"الَّذِينَ أَبْطَلُوا الحَقَّ بِسَبَب دَعْواهُم للهِ شَرِيكاً."}],"28":[{"w":"جَاثِيَةٗ","m":"بارِكَةً عَلَى الرُّكَبِ مُسْتَوفِزَةً."},{"w":"كِتَٰبِهَا","m":"كِتابِ أعْمَالِهَا."}],"29":[{"w":"كِتَٰبُنَا","m":"كِتابُ أَعْمالِكُم الَّذِي دوَّنَتْهُ ملائِكَتِي."},{"w":"نَسۡتَنسِخُ","m":"نَأمُرُ الحَفَظَةَ أَن تَكْتُبَ."}],"32":[{"w":"بِمُسۡتَيۡقِنِينَ","m":"بِمُتَحَقِّقِينَ."}],"33":[{"w":"وَبَدَا","m":"وَظَهَرَ."},{"w":"وَحَاقَ","m":"وَنَزَلَ وَأَحَاطَ."}],"34":[{"w":"نَنسَىٰكُمۡ","m":"نَتْرُكُكُم في عَذابِ جَهَنَّمَ."},{"w":"وَمَأۡوَىٰكُمُ","m":"ومَسْكَنُكُم."}],"35":[{"w":"هُزُوٗا","m":"مُسْتَهْزَأً بِها."},{"w":"وَغَرَّتۡكُمُ","m":"وخَدَعَتْكُم."},{"w":"لَا يُخۡرَجُونَ مِنۡهَا","m":"أي مِنَ النَّارِ."},{"w":"يُسۡتَعۡتَبُونَ","m":"يُرْضِيهِم أَحَدٌ بِتَمْكِينِهِم مِنَ التَّوبَةِ."}],"37":[{"w":"ٱلۡكِبۡرِيَآءُ","m":"السُّلطانُ والعَظَمَةُ."}]}