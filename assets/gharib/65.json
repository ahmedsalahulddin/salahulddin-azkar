{"1":[{"w":"إِذَا طَلَّقۡتُمُ","m":"إذا أَرَدْتُم أَن تُطَلِّقُوا."},{"w":"لِعِدَّتِهِنَّ","m":"مُسْتَقْبِلاتٍ لِعِدَّتِهِنَّ، أي: في طُهْرٍ لم يَقَعْ فِيه جِماعٌ، أو في حَمْلٍ ظاهِرٍ."},{"w":"وَأَحۡصُواْ","m":"واحْفَظُوا."},{"w":"بِفَٰحِشَةٖ","m":"بِفعْلَةٍ مُنْكَرَةٍ ظاهِرَةٍ كالزِّنَى."},{"w":"يَتَعَدَّ","m":"يَتجاوَزْ."},{"w":"يُحۡدِثُ بَعۡدَ ذَٰلِكَ أَمۡرٗا","m":"يُوقِعُ في قَلْبِ الزَّوجِ الْمَحَبَّةَ لِرَجْعَتِها بَعْدَ الطَّلْقةِ والطَّلْقَتَينِ."}],"2":[{"w":"بَلَغۡنَ أَجَلَهُنَّ","m":"قارَبْنَ نِهايةَ عِدَّتِهِنَّ."},{"w":"فَأَمۡسِكُوهُنَّ","m":"فَراجِعُوهُنَّ."},{"w":"بِمَعۡرُوفٍ","m":"بحُسْنِ مُعاشَرَةٍ وإنْفاقٍ عَلَيهِنَّ."},{"w":"فَارِقُوهُنَّ","m":"اتْرُكُوهُنَّ حتَّى تَنْقَضِيَ عِدَّتُهُنَّ."},{"w":"بِمَعۡرُوفٖ","m":"مَعَ إِعْطائِهنَّ حُقُوقَهُنَّ مِنْ غَيرِ مُضارَّةٍ بِهِنَّ."},{"w":"وَأَقِيمُواْ ٱلشَّهَٰدَةَ لِلَّهِ","m":"أدُّوا الشَّهادةَ خالصةً للهِ."},{"w":"مَخۡرَجٗا","m":"مِن كُلِّ ضِيقٍ."}],"3":[{"w":"لَا يَحۡتَسِبُ","m":"لا يَخْطُرُ على بالِهِ وَلَا يَكُونُ في حِسابِهِ."},{"w":"حَسۡبُهُۥٓ","m":"كافِيهِ في جَمِيعِ أُمُورِهِ."},{"w":"بَٰلِغُ أَمۡرِهِۦ","m":"يَقْضِي ما يُرِيدُ."},{"w":"قَدۡرٗا","m":"أَجَلاً يَنْتَهِي إِلَيهِ."}],"4":[{"w":"إِنِ ٱرۡتَبۡتُمۡ","m":"شَكَكْتُم فَلَمْ تَدْرُوا ما عِدّتُهُنَّ؟"},{"w":"وَأُوْلَٰتُ ٱلۡأَحۡمَالِ","m":"ذواتُ الحمْلِ مِنَ النِّساءِ."},{"w":"أَجَلُهُنَّ","m":"عِدَّتُهُنَّ."}],"5":[{"w":"يُكَفِّرۡ عَنۡهُ سَيِّـَٔاتِهِۦ","m":"يَمْحُ عَنْهُ ذُنُوبَهُ."},{"w":"وَيُعۡظِمۡ لَهُۥٓ أَجۡرًا","m":"ويُجْزِلْ لَهُ الثَّوابَ."}],"6":[{"w":"مِن وُجۡدِكُمۡ","m":"على قَدْرِ سَعَتِكُم وطاقَتِكُم."},{"w":"وَلَا تُضَآرُّوهُنَّ","m":"ولا تُلْحِقُوا بِهِنَّ ضَرَراً."},{"w":"أُوْلَٰتِ حَمۡلٖ","m":"ذَواتِ حَمْلٍ."},{"w":"وَأۡتَمِرُواْ بَيۡنَكُم","m":"ولْتتَشاوَرُوا."},{"w":"بِمَعۡرُوفٖ","m":"ما عُرِف مِن سَماحَةٍ وطِيبِ نَفْسٍ."},{"w":"وَإِن تَعَاسَرۡتُمۡ","m":"وَإِن لَم تَتَّفِقُوا على إرضاعِ الأُمِّ."}],"7":[{"w":"ذُو سَعَةٖ","m":"ذُو غِنىً."},{"w":"وَمَن قُدِرَ عَلَيۡهِ","m":"ضُيِّقَ عَلَيهِ."},{"w":"إِلَّا مَآ ءَاتَىٰهَا","m":"إلَّا عَلَى قَدْرِ ما أَعْطاها مِنَ المالِ."}],"8":[{"w":"وَكَأَيِّن","m":"وَكَثيرٍ."},{"w":"عَتَتۡ","m":"عَصَى أَهْلُها وتَجاوَزُوا الحدَّ في مَعْصِيَةِ اللهِ."},{"w":"نُكۡرٗا","m":"عَظِيماً مُنْكَراً."}],"9":[{"w":"فَذَاقَتۡ وَبَالَ أَمۡرِهَا","m":"فَتَجَرَّعُوا سُوءَ عاقِبَةِ عِصْيانِهِم."},{"w":"عَٰقِبَةُ أَمۡرِهَا","m":"آخِرُ أَمْرِها."}],"10":[{"w":"يَٰٓأُوْلِي ٱلۡأَلۡبَٰبِ","m":"أَصْحابَ العُقُولِ."},{"w":"ذِكۡرٗا","m":"قُرآناً."}],"11":[{"w":"مُبَيِّنَٰتٖ","m":"مُوَضِّحاتٍ لَكُم الحقَّ."},{"w":"ٱلظُّلُمَٰتِ","m":"ظُلُماتِ الكُفْرِ."},{"w":"ٱلنُّورِ","m":"نُورِ الإيمانِ."},{"w":"رِزۡقًا","m":"في الجنَّةِ."}],"12":[{"w":"وَمِنَ ٱلۡأَرۡضِ مِثۡلَهُنَّ","m":"وَخَلَقَ سَبْعاً مِنَ الأَرَضِينَ."},{"w":"ٱلۡأَمۡرُ","m":"مِمَّا أوْحاهُ اللهُ إِلى رُسُلِهِ وما يُدَبِّرُ بِهِ خَلْقَهُ."},{"w":"بَيۡنَهُنَّ","m":"بَينَ السَّمواتِ والأَرْضِ."}]}