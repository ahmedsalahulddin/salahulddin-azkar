{"1":[{"w":"يُسَبِّحُ","m":"يُنَزِّهُ."},{"w":"ٱلۡحَمۡدُ","m":"الثَّناءُ الحسنُ الجميلُ."}],"3":[{"w":"وَصَوَّرَكُمۡ","m":"خَلَقَكُم."},{"w":"ٱلۡمَصِيرُ","m":"المَرْجِعُ يَومَ القِيامَةِ."}],"4":[{"w":"تُسِرُّونَ","m":"تُخْفُونَهُ."},{"w":"تُعۡلِنُونَ","m":"تُظْهِرُونَهُ."},{"w":"بِذَاتِ ٱلصُّدُورِ","m":"بما تُخْفِيهِ النُّفُوسُ."}],"5":[{"w":"فَذَاقُواْ","m":"حَلَّ بِهِم."},{"w":"وَبَالَ","m":"سُوءَ عاقِبَةِ."}],"6":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"الآياتِ الواضِحاتِ، والمُعْجِزاتِ الظَّاهراتِ."},{"w":"وَتَوَلَّواْ","m":"أَعْرَضُوا عَنِ الحَقِّ."},{"w":"وَٱسۡتَغۡنَى ٱللَّهُ","m":"عَنْ عِبادَتِهِم وإيمانِهِم."},{"w":"حَمِيدٞ","m":"مَحْمُودٌ في أقوالِهِ وأفعالِهِ وصِفاتِهِ."}],"7":[{"w":"يُبۡعَثُواْ","m":"يُخْرَجُوا مِن قُبُورِهِم."},{"w":"يَسِيرٞ","m":"هَيِّنٌ."}],"8":[{"w":"وَٱلنُّورِ","m":"أَيْ: واهْتَدُوا بالقرآنِ."}],"9":[{"w":"لِيَوۡمِ ٱلۡجَمۡعِ","m":"لِيومِ الحَشْرِ."},{"w":"ٱلتَّغَابُنِ","m":"الغَبْنُ والتَّفاوُتُ بَينَ الخَلْقِ."},{"w":"يُكَفِّرۡ","m":"يَمْحُ."},{"w":"تَحۡتِهَا","m":"تَحْتِ قُصُورِها وأَشْجارِها."}],"10":[{"w":"وَبِئۡسَ ٱلۡمَصِيرُ","m":"وَساءَ المَرْجِعُ الَّذِي صَارُوا إِلَيهِ، وهو جَهَنَّمُ."}],"11":[{"w":"مُصِيبَةٍ","m":"مَكْرُوهٍ."},{"w":"بِإِذۡنِ ٱللَّهِ","m":"بمشيئته."},{"w":"يَهۡدِ قَلۡبَهُۥ","m":"يُوَفِقْهُ اللهُ إِلَى مَرْضاتِهِ."}],"12":[{"w":"تَوَلَّيۡتُمۡ","m":"أَعْرَضْتُم عَن طاعَةِ اللهِ."}],"13":[{"w":"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ","m":"لا مَعْبُودَ بِحَقٍّ سِواهُ."},{"w":"فَلۡيَتَوَكَّلِ ٱلۡمُؤۡمِنُونَ","m":"فَلْيَعْتَمِدوا في كُلِّ الأُمُورِ."}],"14":[{"w":"عَدُوّٗا لَّكُمۡ","m":"أي: يَمْنَعُونَكُم مِنَ الإسْلامِ أو الهِجْرَةِ أو يكُونونَ سَبَباً لِلْمَعاصِي."},{"w":"وَإِن تَعۡفُواْ","m":"تَتَجاوَزُوا عَن سَيِّئاتِهِم."},{"w":"وَتَغۡفِرُواْ","m":"وتَسْتُرُوها عَلَيهِم."}],"15":[{"w":"فِتۡنَةٞ","m":"اخْتِبارٌ لَكُم وشُغْلٌ عَنِ الآخِرَةِ."},{"w":"أَجۡرٌ","m":"ثَوابٌ."}],"16":[{"w":"مَا ٱسۡتَطَعۡتُمۡ","m":"ما أطَقْتُم."},{"w":"خَيۡرٗا","m":"يَكُنْ خَيراً."},{"w":"وَمَن يُوقَ شُحَّ نَفۡسِهِۦ","m":"ومَن سَلِمَ مِنَ البُخْلِ والحِرْصِ."},{"w":"ٱلۡمُفۡلِحُونَ","m":"الظّافِرُونَ بِكُلِّ خَيرٍ."}],"17":[{"w":"تُقۡرِضُواْ ٱللَّهَ","m":"تُنْفِقُوا أَمْوَالَكُم في سَبِيلِ اللهِ بِإخْلاصٍ وَطِيبِ نَفْسٍ."},{"w":"شَكُورٌ","m":"مُجازٍ على الطَّاعةِ."},{"w":"حَلِيمٌ","m":"لا يَعْجَلُ بالعُقُوبَةِ عَلى مَنْ عَصاهُ."}],"18":[{"w":"ٱلۡغَيۡبِ","m":"ما غَابَ عنكم وعن أَبْصَارِكم."},{"w":"ٱلشَّهَٰدَةِ","m":"ما لم يَغِبْ عَنِ الأَبْصارِ."}]}