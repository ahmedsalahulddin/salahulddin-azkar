{"1":[{"w":"إِنَّ زَلۡزَلَةَ ٱلسَّاعَةِ","m":"هي حَرَكَةُ الأرضِ مِنْ أسْفَلِها، واضْطِرَابُها الذي يَحدُثُ عِنْدَ قِيامِ السَّاعةِ."}],"2":[{"w":"تَذۡهَلُ","m":"تَغْفُلُ وتَنْسَى."},{"w":"تَضَعُ","m":"تُسْقِطُ، وتُلْقِي جَنِينَها."},{"w":"سُكَٰرَىٰ","m":"أي: كَالسُّكارَى؛ مِن شِدَّةِ الخوفِ."}],"3":[{"w":"يُجَٰدِلُ","m":"يُخَاصِمُ."},{"w":"مَرِيدٖ","m":"مُتَمَرِّدٍ على اللهِ."}],"4":[{"w":"كُتِبَ عَلَيۡهِ","m":"قُدِّرَ على الشَّيطانِ."},{"w":"مَن تَوَلَّاهُ","m":"مَنِ اتَّخَذَه وَلِيّاً وتَبِعَه."},{"w":"وَيَهۡدِيهِ","m":"ويُوصِلُه وَيَسُوقُه."},{"w":"عَذَابِ ٱلسَّعِيرِ","m":"عذابِ جَهَنَّمَ الْمُوقَدَةِ."}],"5":[{"w":"رَيۡبٖ","m":"شَكٍّ."},{"w":"مِن نُّطۡفَةٖ","m":"هي مَنِيُّ الرَّجُلِ يَقْذِفُه في رَحِم امْرَأتِه."},{"w":"عَلَقَةٖ","m":"الدَّم الأحْمَرِ الغَلِيظِ."},{"w":"مُضۡغَةٖ","m":"قِطْعَةِ لَحْمٍ صَغِيرةٍ قَدْرَ ما يُمْضَغُ."},{"w":"مُخَلَّقَةٖ","m":"ما وُلِد تامَّ الخَلْقِ."},{"w":"وَغَيۡرِ مُخَلَّقَةٖ","m":"ما تُسْقِطُه الرَّحِمُ قَبْلَ أن يَتِمَّ خَلْقُه."},{"w":"وَنُقِرُّ","m":"نُثَبِّتُ ونُبْقِي."},{"w":"إِلَىٰٓ أَرۡذَلِ ٱلۡعُمُرِ","m":"أخَسِّه، وهو الهَرمُ والخَرَفُ؛ حتى لا يَعْقِلَ."},{"w":"هَامِدَةٗ","m":"يابِسةً لا نَباتَ فيها."},{"w":"ٱهۡتَزَّتۡ","m":"تَحرَّكَتْ بالنَّباتِ تَتَفَتَّحُ عَنْه."},{"w":"وَرَبَتۡ","m":"زادَتْ وضَاعفَتْ النَّباتَ بِنُزُولِ المطرِ."},{"w":"مِن كُلِّ زَوۡجِۭ بَهِيجٖ","m":"مِن كُلِّ صِنْفٍ حَسَنٍ ولونٍ مُسْتَحْسَنٍ."}],"7":[{"w":"يَبۡعَثُ مَن فِي ٱلۡقُبُورِ","m":"أي: يَبْعَثُهم أحْيَاءً."}],"8":[{"w":"يُجَٰدِلُ","m":"يُخاصِمُ."}],"9":[{"w":"ثَانِيَ عِطۡفِهِۦ","m":"لاوِياً عُنُقَه في استكبارٍ عَنِ الْحَقِّ."},{"w":"خِزۡيٞ","m":"ذُلٌّ وهَوَانٌ."}],"11":[{"w":"عَلَىٰ حَرۡفٖ","m":"على ضَعْفٍ وشَكٍّ."},{"w":"فِتۡنَةٌ","m":"ابْتِلاءٌ وشِدَّةٌ."},{"w":"ٱنقَلَبَ عَلَىٰ وَجۡهِهِۦ","m":"رَجَعَ عمَّا كان عليه مِنَ الاسْتِقامَةِ."},{"w":"ٱلۡخُسۡرَانُ ٱلۡمُبِينُ","m":"الخَسارةُ العَظِيمَةُ والصَّفْقَةُ الخاسِرةُ."}],"13":[{"w":"ٱلۡمَوۡلَىٰ","m":"النَّصِيرُ."},{"w":"ٱلۡعَشِيرُ","m":"الصَّاحِبُ المُعاشِرُ."}],"14":[{"w":"مِن تَحۡتِهَا","m":"أي: مِنْ تَحْتِ قُصُورِها."}],"15":[{"w":"فَلۡيَمۡدُدۡ","m":"فليَشْدُدْ."},{"w":"بِسَبَبٍ","m":"بحَبْلٍ."},{"w":"إِلَى ٱلسَّمَآءِ","m":"أي: سَماءِ بيتِه، وهو سَقْفُه."},{"w":"ثُمَّ لۡيَقۡطَعۡ","m":"أي: ذلك الحبلَ لِيَخْنُقَ بِه نَفْسَه."},{"w":"كَيۡدُهُۥ","m":"مَكْرُه وحِيلَتُه."},{"w":"مَا يَغِيظُ","m":"ما يَجِدُ في نَفْسِه مِنَ الغَيظِ والغَضَبِ."}],"16":[{"w":"بَيِّنَٰتٖ","m":"واضحاتٍ."}],"17":[{"w":"وَٱلَّذِينَ هَادُواْ","m":"اليهُودَ."},{"w":"وَٱلصَّـٰبِـِٔينَ","m":"هم قَوْمٌ كانُوا عَلى فِطْرتهم وحَنِيفِيَّتِهِمْ، ثم طَرَأ على أكْثَرِهم الشِّركُ وعبادةُ الكواكِب."},{"w":"وَٱلۡمَجُوسَ","m":"هم عَبَدَةُ النَّارِ."},{"w":"يَفۡصِلُ بَيۡنَهُمۡ","m":"يَقْضِي بَيْنَهم."},{"w":"شَهِيدٌ","m":"رَقِيبٌ يُحصِي أعمالَ خَلْقِه كلَّها."}],"18":[{"w":"أَلَمۡ تَرَ","m":"ألم تَعلَمْ."},{"w":"يَسۡجُدُ لَهُۥ","m":"يَنْقادُ له ويَخْضَعُ."},{"w":"حَقَّ عَلَيۡهِ","m":"وَجَبَ عليه."}],"19":[{"w":"خَصۡمَانِ","m":"فريقانِ: وهم المؤمِنُونَ والكُفَّارُ."},{"w":"ٱخۡتَصَمُواْ","m":"اخْتَلَفُوا."},{"w":"فِي رَبِّهِمۡ","m":"في دِينِ ربِّهم."},{"w":"قُطِّعَتۡ لَهُمۡ","m":"جُعِلَتْ لَهم."},{"w":"ٱلۡحَمِيمُ","m":"الماءُ البالغُ نِهايةَ الحرارةِ."}],"20":[{"w":"يُصۡهَرُ بِهِۦ","m":"يُذابُ به."}],"21":[{"w":"مَقَٰمِعُ","m":"مَطارِقُ."}],"22":[{"w":"مِنۡ غَمٍّ","m":"مِنْ أَجْلِ ما نالَهُم مِنَ الغَمِّ والكَرْبِ."}],"23":[{"w":"يُحَلَّوۡنَ فِيهَا","m":"يُلْبَسُونَ في الجنَّةِ الحُليَّ."},{"w":"أَسَاوِرَ","m":"مفردُه سِوَارٌ: وهو ما يُلبَسُ في اليد للتزيُّنِ، ويُحِيطُ بالمِعْصَمِ."}],"24":[{"w":"وَهُدُوٓاْ","m":"هَداهُمُ اللهُ ووَفَّقَهم."},{"w":"إِلَى ٱلطَّيِّبِ مِنَ ٱلۡقَوۡلِ","m":"إلى كَلِمةِ التَّوحِيدِ أنْ لا إلَهَ إلا اللهُ."},{"w":"إِلَىٰ صِرَٰطِ ٱلۡحَمِيدِ","m":"الصِّرَاطِ المحمُودِ وهو الإسْلام."}],"25":[{"w":"سَوَآءً","m":"مُسْتَوِياً."},{"w":"ٱلۡعَٰكِفُ فِيهِ","m":"المقيمُ فيه المُلازمُ له."},{"w":"وَٱلۡبَادِ","m":"القادمُ إليه مِنْ غَيْرِ أهْلِه."},{"w":"بِإِلۡحَادِۭ","m":"بِعُدُولٍ عَنِ القَصْدِ."}],"26":[{"w":"بَوَّأۡنَا لِإِبۡرَٰهِيمَ","m":"أي: بَيَّنَّا له."},{"w":"وَطَهِّرۡ بَيۡتِيَ","m":"أي: مِنَ الشِّركِ والكُفْرِ وسائِرِ النَّجاساتِ."}],"27":[{"w":"وَأَذِّن فِي ٱلنَّاسِ","m":"أي: أعْلِمْهم بإعْلانٍ."},{"w":"رِجَالٗا","m":"جَمْعُ رَاجِلٍ، وهو مَن جاء يَمْشِي على رِجْلَيه."},{"w":"وَعَلَىٰ كُلِّ ضَامِرٖ","m":"أي: ورُكباناً على كلِّ بعيرٍ مَهزولٍ أَتْعَبَه طولُ السَّفَرِ."},{"w":"فَجٍّ عَمِيقٖ","m":"طَرِيقٍ بَعِيدٍ."}],"28":[{"w":"أَيَّامٖ مَّعۡلُومَٰتٍ","m":"أيَّامٍ مُعَيَّنةٍ هي: عاشرُ ذِي الحِجَّةِ وثلاثةُ أيَّامٍ بَعْدَه."},{"w":"عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَٰمِ","m":"أي: على ذَبْحِ ما رَزَقَهُم مِن بهِيَمَةِ الأنعامِ، وهي: الإبِلُ، والَبَقرُ، والغَنَمُ."},{"w":"ٱلۡبَآئِسَ ٱلۡفَقِيرَ","m":"هو الفقيرُ الذي اشْتَدَّ فَقْرُه."}],"29":[{"w":"ثُمَّ لۡيَقۡضُواْ تَفَثَهُمۡ","m":"ثم لِيُزِيلُوا وَسَخَهم بعد خُرُوجِهِم مِنْ إِحْرَامِهِم."},{"w":"وَلۡيُوفُواْ نُذُورَهُمۡ","m":"وَلْيُوَفُّوا بما أوجَبُوه على أنْفُسِهم مِنْ أَعْمالِ البِرِّ في الحجِّ وغيرِه."},{"w":"بِٱلۡبَيۡتِ ٱلۡعَتِيقِ","m":"وهو الكَعْبةُ، وقد أعْتَقَها اللهُ مِن تَسَلُّطِ الجبَّارينَ عَلَيها."}],"30":[{"w":"حُرُمَٰتِ ٱللَّهِ","m":"جَمْعُ حُرْمَةٍ، وهي ما وَجَبَ القيامُ به، وحَرُمَ التَّفْرِيطُ فيه."},{"w":"ٱلرِّجۡسَ مِنَ ٱلۡأَوۡثَٰنِ","m":"أي: مِنْ عِبادَةِ الأوثانِ، فإنها رِجْسٌ."},{"w":"ٱلزُّورِ","m":"الكذِبِ والافْتِرَاءِ على اللهِ."}],"31":[{"w":"حُنَفَآءَ لِلَّهِ","m":"مُسْتَقِيمِينَ على الحقِّ."},{"w":"خَرَّ","m":"سَقَطَ."},{"w":"فَتَخۡطَفُهُ","m":"فَتَسْلُبُه وتَذْهبُ بِه."},{"w":"تَهۡوِي بِهِ","m":"تَقْذِفُه وتَرْمِي بِه."},{"w":"سَحِيقٖ","m":"بَعِيدٍ."}],"32":[{"w":"شَعَٰٓئِرَ ٱللَّهِ","m":"هي معالمُ دِينِه، ومِنْها شَعِيرةُ الحَجِّ."}],"33":[{"w":"إِلَىٰٓ أَجَلٖ مُّسَمّٗى","m":"وهو وقتُ ذَبْحِها."},{"w":"ثُمَّ مَحِلُّهَآ","m":"أي: حيثُ يَحِلُّ ذَبْحُها."}],"34":[{"w":"مَنسَكٗا","m":"ذَبْحاً يَذْبَحُونَه، أو عِيداً، أو حَجّاً يَحُجُّونَه."},{"w":"عَلَىٰ مَا رَزَقَهُم","m":"على ذَبْحِ ما رَزَقَهُم."},{"w":"ٱلۡمُخۡبِتِينَ","m":"الخاشِعِينَ المخْلِصِينَ."}],"35":[{"w":"وَجِلَتۡ","m":"خافتْ."}],"36":[{"w":"وَٱلۡبُدۡنَ","m":"وهي الإبِلُ، والبَقَرُ مما يُجْزِئُ ذَبْحُه عَنْ سَبْعةٍ."},{"w":"صَوَآفَّ","m":"أي: قائِماتٍ، بأن تُقامَ على قَوَائِمِها الأرْبَعِ، ثم تُعْقَلَ إحْدى يَدَيها."},{"w":"وَجَبَتۡ جُنُوبُهَا","m":"سقَطَتْ جُنوبُها على الأرضِ."},{"w":"ٱلۡقَانِعَ","m":"الفقيرَ المُتَعَفِّفَ عَنِ السُّؤالِ."},{"w":"وَٱلۡمُعۡتَرَّ","m":"المُحتاجَ الَّذي يَسْأَلُ."}],"37":[{"w":"ٱلتَّقۡوَىٰ مِنكُمۡ","m":"إخْلاصُكم لله وخَشْيَتُكُم مِنْه."}],"38":[{"w":"يُدَٰفِعُ","m":"يَدْفَعُ ويَرُدُّ."},{"w":"خَوَّانٖ","m":"كثيرِ الخِيانَةِ."},{"w":"كَفُورٍ","m":"جَحُودٍ لِنِعَمِ اللهِ."}],"39":[{"w":"أُذِنَ لِلَّذِينَ","m":"أي: شُرِعَ لهم القِتالُ."}],"40":[{"w":"صَوَٰمِعُ","m":"مَعابدُ رُهْبَانِ النَّصارَى."},{"w":"بِيَعٞ","m":"كَنائِسُ النَّصَارَى."},{"w":"صَلَوَٰتٞ","m":"كنائِسُ اليهُودِ."}],"44":[{"w":"وَأَصۡحَٰبُ مَدۡيَنَ","m":"قومُ شُعَيبٍ عليه الصَّلاة والسَّلامُ."},{"w":"فَأَمۡلَيۡتُ","m":"فأَمهَلْتُ."},{"w":"ثُمَّ أَخَذۡتُهُمۡ","m":"أي: بالعقاب فَأَهْلَكْتُهم."},{"w":"نَكِيرِ","m":"أي: إنْكارِي عَلَيهم."}],"45":[{"w":"فَكَأَيِّن","m":"فَكَثِيراً."},{"w":"ظَالِمَةٞ","m":"أي: أهلُها بالكُفْرِ والشِّركِ."},{"w":"خَاوِيَةٌ عَلَىٰ عُرُوشِهَا","m":"ساقِطةٌ على سُقُوفِها."},{"w":"وَبِئۡرٖ مُّعَطَّلَةٖ","m":"وَبِئْرٍ مَهْجُورَةٍ بِمَوْتِ أَهْلِها."},{"w":"وَقَصۡرٖ مَّشِيدٍ","m":"وَقَصْرٍ مُجَصَّصٍ مَرْفُوعِ البُنْيانِ، خَرِبَ بِمَوتِ أَهْلِه."}],"47":[{"w":"مِمَّا تَعُدُّونَ","m":"أي: مما تَحْسُبُونَ من سِنِي الدُّنيا."}],"48":[{"w":"أَمۡلَيۡتُ لَهَا","m":"أَمْهَلْتُها."},{"w":"ظَالِمَةٞ","m":"أي: أهلُها بالكفرِ والشِّركِ."},{"w":"ثُمَّ أَخَذۡتُهَا","m":"أي: أَهْلَكْتُها."},{"w":"ٱلۡمَصِيرُ","m":"المَرْجِعُ."}],"50":[{"w":"وَرِزۡقٞ كَرِيمٞ","m":"ورِزْقٌ حَسَنٌ لا يَنْقَطِعُ، وهو الجنَّةُ."}],"51":[{"w":"وَٱلَّذِينَ سَعَوۡاْ فِيٓ ءَايَٰتِنَا","m":"والذين اجْتَهَدُوا في مُحارَبةِ القرآنِ وإبْطالِ آياتِه وحُجَجِه."},{"w":"مُعَٰجِزِينَ","m":"ظانِّينَ أنَّهم يُعْجِزُونَنا ويَغْلِبُوننا."},{"w":"أَصۡحَٰبُ ٱلۡجَحِيمِ","m":"أهلُ النارِ الموقَدَةِ."}],"52":[{"w":"تَمَنَّىٰٓ","m":"قَرَأَ ما نَزَلَ عَلَيهِ."},{"w":"أَلۡقَى ٱلشَّيۡطَٰنُ فِيٓ أُمۡنِيَّتِهِۦ","m":"أي: ألْقَى في قِراءتِه الوَسَاوِسَ والشُّبُهَاتِ."},{"w":"فَيَنسَخُ ٱللَّهُ","m":"أي: فَيُزِيلُه."},{"w":"مَا يُلۡقِي ٱلشَّيۡطَٰنُ","m":"أي: ما يُلْقِيهِ مِنْ وَساوِسَ وشُبُهاتٍ."},{"w":"ثُمَّ يُحۡكِمُ ٱللَّهُ ءَايَٰتِهِۦ","m":"ثُمَّ يُثَبِّتُ اللهُ آياتِه كما نَزَلَتْ ويَحْفظُها مِنَ التَّبْدِيل."}],"53":[{"w":"فِتۡنَةٗ","m":"ابْتِلاءً واخْتِباراً."},{"w":"مَرَضٞ","m":"شكٌّ ونِفاقٌ."},{"w":"وَٱلۡقَاسِيَةِ قُلُوبُهُمۡ","m":"أي: غَلُظَتْ قُلُوبُهم عَن قَبُولِ الحَقِّ."},{"w":"شِقَاقِۭ بَعِيدٖ","m":"خِلاَفٍ بَعِيدٍ عَنِ الصَّوابِ."}],"54":[{"w":"أَنَّهُ ٱلۡحَقُّ مِن رَّبِّكَ","m":"أنَّ القرآنَ هو الحقُّ النازِلُ مِنْ عِنْدِ اللهِ عَلَيكَ."},{"w":"فَتُخۡبِتَ لَهُۥ","m":"فَتَخْشَعَ لَهُ وتَخْضَعَ."}],"55":[{"w":"فِي مِرۡيَةٖ مِّنۡهُ","m":"في شَكٍّ مِنْ هَذَا القُرآنِ."},{"w":"بَغۡتَةً","m":"فَجْأةً."},{"w":"يَوۡمٍ عَقِيمٍ","m":"هو يومُ القيامةِ الَّذي لا خيرَ فيه للكفارِ، ولا يومَ بَعْدَه."}],"56":[{"w":"ٱلۡمُلۡكُ","m":"السُّلْطانُ القاهِرُ."},{"w":"يَوۡمَئِذٖ","m":"أي: يومَ القيامةِ."}],"57":[{"w":"مُهِينٞ","m":"مُخْزٍ ومُذِلٌّ."}],"58":[{"w":"رِزۡقًا حَسَنٗا","m":"وهو الجنَّةُ."}],"59":[{"w":"مُدۡخَلٗا","m":"مكانَ دخولٍ، وهو الجنَّةُ."}],"60":[{"w":"ثُمَّ بُغِيَ عَلَيۡهِ","m":"ثُمَّ اعْتُدِيَ عليه بالظُّلْمِ."}],"61":[{"w":"يُولِجُ","m":"يُدخِلُ."}],"62":[{"w":"مَا يَدۡعُونَ مِن دُونِهِۦ","m":"ما يَعْبُدُه الْمُشْرِكُون مِن دُونِ اللهِ مِنَ الأصْنامِ وغَيرِها."},{"w":"ٱلۡعَلِيُّ","m":"أي: على خَلْقِه ذاتاً وقدْراً وقَهْراً."}],"63":[{"w":"مَآءٗ","m":"مَطَراً."}],"64":[{"w":"ٱلۡحَمِيدُ","m":"المحمودُ المُسْتَحِقُّ لِلْحمْدِ في كُلِّ حالٍ."}],"65":[{"w":"سَخَّرَ","m":"ذَلَّلَ."},{"w":"ٱلۡفُلۡكَ","m":"السُّفُنَ."},{"w":"يُمۡسِكُ ٱلسَّمَآءَ","m":"يَحْفظُ السَّماءَ."}],"66":[{"w":"لَكَفُورٞ","m":"لَجَحُودٌ."}],"67":[{"w":"مَنسَكًا","m":"شَرِيعةً خاصَّةً."},{"w":"هُمۡ نَاسِكُوهُ","m":"هم عامِلُونَ به."},{"w":"فَلَا يُنَٰزِعُنَّكَ فِي ٱلۡأَمۡرِ","m":"فلا يَحِقُّ لَهُم أنْ يخاصِمُوكَ في شَرِيعَتِكَ."},{"w":"هُدٗى مُّسۡتَقِيمٖ","m":"دِينٍ قَوِيمٍ لا اعْوِجاجَ فِيه."}],"70":[{"w":"فِي كِتَٰبٍ","m":"أي: في اللَّوحِ المحْفُوظِ."}],"71":[{"w":"سُلۡطَٰنٗا","m":"حُجَّةً وبُرْهاناً."},{"w":"لِلظَّٰلِمِينَ","m":"للمُشْرِكِينَ."}],"72":[{"w":"ٱلۡمُنكَرَ","m":"الأمرَ الذي يُنْكَرُ مِنَ العُبُوسِ والغَضَبِ والكَراهَةِ."},{"w":"يَسۡطُونَ","m":"يَبْطِشُونَ."},{"w":"بِشَرّٖ مِّن ذَٰلِكُمُ","m":"بِشَرٍّ مِنْ غَيظِكُم على مَن يَتْلُو عليكُم آياتِ اللهِ."},{"w":"وَبِئۡسَ ٱلۡمَصِيرُ","m":"ساءَ وقَبُحَ المكانُ الذي يَرجِعُونَ إليه."}],"73":[{"w":"فَٱسۡتَمِعُواْ لَهُۥٓ","m":"أي: سَماعَ تَدَبُّرٍ."},{"w":"تَدۡعُونَ","m":"تَعْبُدُونَ."},{"w":"ذُبَابٗا","m":"ذُبابةً واحِدةً مَعَ صِغَرِها."},{"w":"وَإِن يَسۡلُبۡهُمُ","m":"أي: وإن يَأْخُذِ الذُّبابُ شيئاً مِنْ هَذهِ المعْبُودَاتِ."},{"w":"لَا يَسۡتَنقِذُوهُ مِنۡهُ","m":"أي: لا يَقْدِرُوا -لِعَجْزِهِم- على اسْتِرْدادِ ما أُخِذَ مِنْهم."},{"w":"ٱلطَّالِبُ","m":"هو المَعبُودُ مِن دُونِ اللهِ."},{"w":"ٱلۡمَطۡلُوبُ","m":"هو الذُّبَابُ."}],"74":[{"w":"مَا قَدَرُواْ ٱللَّهَ حَقَّ قَدۡرِهِۦٓ","m":"ما عَظَّمَ المشْرِكُونَ اللهَ تَعالى حقَّ تَعْظِيمِهِ."}],"75":[{"w":"يَصۡطَفِي","m":"يَخْتَارُ."}],"76":[{"w":"مَا بَيۡنَ أَيۡدِيهِمۡ","m":"أي: أَعْمالَهم التي عَمِلُوها."},{"w":"وَمَا خَلۡفَهُمۡ","m":"أي: أَعْمالَهم التي سَيَعْمَلُونَها."}],"78":[{"w":"وَجَٰهِدُواْ فِي ٱللَّهِ","m":"أي: في سَبِيلِهِ لإعْلاءِ كَلِمَتِهِ."},{"w":"هُوَ ٱجۡتَبَىٰكُمۡ","m":"اصْطَفاكُم اللهُ لِحَمْلِ دِينِه."},{"w":"مِنۡ حَرَجٖ","m":"مِن ضِيقٍ ومَشَقَّةٍ بتكْلِيفٍ يَشُقُّ عَلَيكُم."},{"w":"مِن قَبۡلُ","m":"أي: في الكُتُبِ المُنَزَّلةِ السَّابِقَةِ."},{"w":"فِي هَٰذَا","m":"أي: في هَذا القرآنِ."},{"w":"شُهَدَآءَ عَلَى ٱلنَّاسِ","m":"أي: على الأممِ السَّابِقَةِ أنَّ رُسُلَهم قد بَلَّغَتْهم رِسالاتِ ربِّهم."},{"w":"وَٱعۡتَصِمُواْ بِٱللَّهِ","m":"أي: اجْعَلُوه عِصْمةً لكم مما تَحْذَرُونَ، والتَجِئُوا إليه في جميعِ أُمُورِكُم."},{"w":"هُوَ مَوۡلَىٰكُمۡ","m":"هو ناصِرُكُم، ومُتَوَلِّي أمورِكُم."}]}