{"1":[{"w":"سَبِّحِ ٱسۡمَ رَبِّكَ","m":"نَزِّه اسمَ رَبِّكَ عَن كُلِّ ما لا يَليقُ بِهِ."}],"2":[{"w":"فَسَوَّىٰ","m":"فَأَتْقَنَ خَلْقَ الإنسانِ."}],"3":[{"w":"فَهَدَىٰ","m":"الإنسانَ لِسبيلِ الخَيْرِ والشَّرِّ، وهَدَى الأَنْعَامَ لِمَراتِعِهَا."}],"4":[{"w":"ٱلۡمَرۡعَىٰ","m":"الكَلَأَ الأَخْضَرَ."}],"5":[{"w":"غُثَآءً","m":"هَشِيماً جافّاً."},{"w":"أَحۡوَىٰ","m":"مُتَغَيِّراً إلى السَّوادِ بَعْدَ الخُضْرَةِ."}],"6":[{"w":"سَنُقۡرِئُكَ","m":"سنُعْلِمُكَ بِقراءةِ جِبريلَ عَلَيكَ."}],"7":[{"w":"إِلَّا مَا شَآءَ ٱللَّهُ","m":"أَن تَنْساهُ وما نَسَخَ اللهُ تِلاوتَهُ."}],"8":[{"w":"وَنُيَسِّرُكَ","m":"وُنَهوِّنُ عَلَيكَ."},{"w":"لِلۡيُسۡرَىٰ","m":"عَمَلِ أَهْلِ الجنَّةِ."}],"9":[{"w":"فَذَكِّرۡ","m":"فَعِظْ بالقرآنِ."},{"w":"إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","m":"إن رُجِيَ مِنهُ التَّذَكُّرُ."}],"10":[{"w":"سَيَذَّكَّرُ","m":"سيَتَّعِظُ."}],"11":[{"w":"ٱلۡأَشۡقَى","m":"الَّذِي لا يَخْشَى رَبَّهُ، وَشَقِيَ فِي عِلْمِ اللهِ."}],"12":[{"w":"يَصۡلَى","m":"يُقاسِي حرَّها."},{"w":"ٱلنَّارَ ٱلۡكُبۡرَىٰ","m":"نارَ جَهَنَّمَ العُظْمَى."}],"13":[{"w":"لَا يَمُوتُ فِيهَا","m":"فَيَسْتَرِيحَ."},{"w":"وَلَا يَحۡيَىٰ","m":"حياةً تَنفَعُهُ."}],"14":[{"w":"أَفۡلَحَ","m":"فَازَ."},{"w":"تَزَكَّىٰ","m":"طَهَّرَ نَفسَهُ مِنَ الأخْلَاقِ السَّيِّئةِ."}],"16":[{"w":"تُؤۡثِرُونَ","m":"تُفَضِّلُونَ."}],"18":[{"w":"هَٰذَا","m":"ما ذُكِرَ مِن قولِه تعالى:"},{"w":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","m":"إِلى تَمامِ أَرْبَعِ آياتٍ."},{"w":"ٱلصُّحُفِ ٱلۡأُولَىٰ","m":"الكُتُبِ الأُولى الَّتِي أُنزِلَت قَبْلَ القُرآنِ."}]}