{"2":[{"w":"مَا لَا تَفۡعَلُونَ","m":"ما لا تَقُومُونَ بالوفاءِ بهِ."}],"3":[{"w":"مَقۡتًا","m":"بُغْضاً."}],"4":[{"w":"صَفّٗا","m":"أي مَصْفُوفِينَ."},{"w":"مَرۡصُوصٞ","m":"مُتَراصٌّ مُحْكَمٌ."}],"5":[{"w":"زَاغُوٓاْ","m":"مالُوا عَنِ الحقِّ مع عِلْمِهِم به."},{"w":"أَزَاغَ ٱللَّهُ قُلُوبَهُمۡ","m":"صَرَفَها عَن قَبُولِ الهِدايَةِ."},{"w":"ٱلۡفَٰسِقِينَ","m":"الخارِجِينَ عَن طاعة الله ورسوله."}],"6":[{"w":"لِمَا بَيۡنَ يَدَيَّ","m":"لِمَا جَاءَ قَبْلي."},{"w":"وَمُبَشِّرَۢا","m":"ومُخْبِراً بِمَجِيءِ الرَّسُولِ ﷺ."},{"w":"بِٱلۡبَيِّنَٰتِ","m":"بالدَّلائِلِ الواضِحاتِ الدَّالّةِ عَلى نُبُوَّتِهِ."}],"7":[{"w":"وَمَنۡ أَظۡلَمُ","m":"لا أَحَدَ أَظْلَمُ."},{"w":"ٱفۡتَرَىٰ","m":"اختَلَقَ."}],"8":[{"w":"لِيُطۡفِـُٔواْ نُورَ ٱللَّهِ","m":"لِيَقْضُوا عَلَى دِينِ اللهِ."},{"w":"مُتِمُّ نُورِهِۦ","m":"سيُتِمُّ هَذا الإسلامَ حَتَّى يَنْتَشِرَ."}],"9":[{"w":"بِٱلۡهُدَىٰ","m":"بالقُرآنِ."},{"w":"وَدِينِ ٱلۡحَقِّ","m":"ودِينِ الإسْلامِ."},{"w":"لِيُظۡهِرَهُۥ","m":"ليُعْلِيَهُ."}],"12":[{"w":"مِن تَحۡتِهَا","m":"مِن تَحْتِ قُصُورِها وأَشْجارِها."},{"w":"عَدۡنٖ","m":"إقامَةٍ دائِمَةٍ."}],"13":[{"w":"وَأُخۡرَىٰ","m":"وَنِعْمَةٌ أُخْرَى."},{"w":"قَرِيبٞ","m":"عاجِلٌ."}],"14":[{"w":"لِلۡحَوَارِيِّـۧنَ","m":"هُمْ أَصْفِياءُ عِيسَى -عَلَيهِ السَّلامُ- وخُلَّصُ أصحابِهِ."},{"w":"ظَٰهِرِينَ","m":"غالِبِينَ: إما بالحُجَّةِ، أو بِبِعْثَةِ مُحَمَّدٍ ﷺ."}]}