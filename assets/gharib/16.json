{"1":[{"w":"أَتَىٰٓ","m":"قَرُبَ ودَنا."},{"w":"أَمۡرُ ٱللَّهِ","m":"عقابُه للمُشْركين، أو القيامةُ."},{"w":"سُبۡحَٰنَهُۥ","m":"تنزيهاً لله."}],"2":[{"w":"بِٱلرُّوحِ","m":"بالوَحْي؛ الذي فيه الحياةُ التامَّةُ."},{"w":"مِنۡ عِبَادِهِۦٓ","m":"الذين اختصَّهم بالرسالة."},{"w":"أَنذِرُوٓاْ","m":"خَوِّفُوا."}],"4":[{"w":"نُطۡفَةٖ","m":"ماءِ الحياةِ، وهو المَنِيُّ."},{"w":"خَصِيمٞ","m":"شديدُ الخصومةِ والمجادَلةِ."},{"w":"مُبِينٞ","m":"بَيِّنُ الخُصومةِ واضحُها."}],"5":[{"w":"وَٱلۡأَنۡعَٰمَ","m":"هي الإبِلُ، والبَقَرُ، والغنم."},{"w":"دِفۡءٞ","m":"ما تَسْتَدْفِئُون به، مِنْ صوفِها ووَبَرِها وشَعْرِها."}],"6":[{"w":"جَمَالٌ","m":"زينةٌ تَسُرُّكم."},{"w":"تُرِيحُونَ","m":"تَرُدُّونها في المساء إلى حَظائرِها."},{"w":"تَسۡرَحُونَ","m":"تُخْرِجُونها في الصَّباح إلى مَراعِيها."}],"7":[{"w":"أَثۡقَالَكُمۡ","m":"أمتعتَكم الثقيلةَ."},{"w":"بِشِقِّ ٱلۡأَنفُسِ","m":"بجُهْدٍ شديدٍ ومشَقَّةٍ زائدةٍ عليها."}],"8":[{"w":"وَزِينَةٗ","m":"لتتزيَّنُوا بها حالَ ركوبِها، وحالَ جَمالِ منظرها."}],"9":[{"w":"قَصۡدُ ٱلسَّبِيلِ","m":"بيانُ الطَّريقِ المستقيمِ، وهو الإسلامُ."},{"w":"جَآئِرٞ","m":"مائلٌ عن الاستقامةِ، وهو ما خالَفَ الإسلامَ."}],"10":[{"w":"تُسِيمُونَ","m":"تَرعَوْن دَوابَّكم."}],"11":[{"w":"لَأٓيَةٗ","m":"دلالةً واضحةً."}],"12":[{"w":"وَسَخَّرَ لَكُمُ","m":"ذلَّلَ لمنافعِكم."}],"13":[{"w":"ذَرَأَ","m":"خَلَقَ."}],"14":[{"w":"لَحۡمٗا طَرِيّٗا","m":"هو السَّمَكُ."},{"w":"حِلۡيَةٗ","m":"ما تتحَلَّى به النِّساءُ وتَتَزَيَّنُ، كاللؤلؤِ والمَرْجانِ."},{"w":"ٱلۡفُلۡكَ","m":"السُّفُنَ."},{"w":"مَوَاخِرَ فِيهِ","m":"تَشُقُّ الماءَ بجَرْيِها فيه ذَهاباً ورُجوعاً."}],"15":[{"w":"رَوَٰسِيَ","m":"جبالاً ثوابِتَ."},{"w":"أَن تَمِيدَ بِكُمۡ","m":"حتى لا تَمِيلَ بكم وتضطربَ."},{"w":"وَسُبُلٗا","m":"طُرُقاً."},{"w":"تَهۡتَدُونَ","m":"إلى مقاصِدِكم."}],"16":[{"w":"وَعَلَٰمَٰتٖ","m":"معالمَ تَسْتَدِلُّون بها على الطُّرُقِ نهاراً."}],"17":[{"w":"أَفَمَن يَخۡلُقُ","m":"وهو اللهُ تعالى."},{"w":"كَمَن لَّا يَخۡلُقُ","m":"أتَجْعَلُونه في استحقاقِ العبادةِ كالآلهةِ المزعومةِ التي لا تملِك شيئاً؟"}],"18":[{"w":"نِعۡمَةَ ٱللَّهِ","m":"نِعَمَه عليكم."},{"w":"لَا تُحۡصُوهَآ","m":"لا تُطيقوا حَصْرَها ولا القيامَ بشُكْرها؛ لكثرتِها وتَنَوُّعِها."}],"19":[{"w":"مَا تُسِرُّونَ","m":"ما تُخْفُونَه من أقوالِكم وأعمالِكم."}],"21":[{"w":"أَيَّانَ","m":"وقتَ."},{"w":"يُبۡعَثُونَ","m":"يُحْيَوْن مِنْ قُبورِهم."}],"22":[{"w":"قُلُوبُهُم مُّنكِرَةٞ","m":"جاحدةٌ وحدانيةَ اللهِ."}],"23":[{"w":"لَا جَرَمَ","m":"حَقّاً، أو لا مَحالةَ."}],"24":[{"w":"أَسَٰطِيرُ ٱلۡأَوَّلِينَ","m":"جَمْعُ أُسْطورة، وهي: ما سُطِّرَ في كتب السابقينَ من الأخبارِ المكذوبةِ."}],"25":[{"w":"أَوۡزَارَهُمۡ","m":"آثامَ ضلالِهم."},{"w":"مَا يَزِرُونَ","m":"ما يَحْمِلُونه من آثامٍ."}],"26":[{"w":"مَكَرَ","m":"دَبَّرَ في حِيلةٍ وخَفاءٍ."},{"w":"فَأَتَى ٱللَّهُ بُنۡيَٰنَهُم","m":"أهْلكَه وأفْناه."},{"w":"مِنَ ٱلۡقَوَاعِدِ","m":"من أساسِه."},{"w":"فَخَرَّ","m":"سَقَطَ."},{"w":"حَيۡثُ لَا يَشۡعُرُونَ","m":"من مَأْمَنِهم، ومن جهةٍ لا تَخْطُرُ ببالِهم."}],"27":[{"w":"يُخۡزِيهِمۡ","m":"يُذِلُّهم اللهُ ويُهينُهم بالعذابِ."},{"w":"شُرَكَآءِيَ","m":"الآلهةُ التي عَبَدتُّموها من دوني."},{"w":"تُشَٰٓقُّونَ فِيهِمۡ","m":"تُخاصِمُون وتُعادُون الأنبياءَ وأتباعَهم في شأنهم."},{"w":"ٱلۡخِزۡيَ","m":"الذُّلَّ والهَوانَ."},{"w":"وَٱلسُّوٓءَ","m":"العذابَ."}],"28":[{"w":"تَتَوَفَّىٰهُمُ ٱلۡمَلَٰٓئِكَةُ","m":"تَقْبِضُ أرواحَهم."},{"w":"فَأَلۡقَوُاْ ٱلسَّلَمَ","m":"استَسْلَمُوا لأمرِ اللهِ حين رَأَوا الموتَ."}],"29":[{"w":"مَثۡوَى ٱلۡمُتَكَبِّرِينَ","m":"مَأْواهم ومَقَرُّهم."}],"30":[{"w":"حَسَنَةٞ","m":"مَكْرُمَةٌ من اللهِ بالعيشِ الهنيءِ والرِّزقِ الواسعِ."}],"31":[{"w":"جَنَّٰتُ عَدۡنٖ","m":"جناتُ إقامةٍ."},{"w":"مِن تَحۡتِهَا","m":"من تحتِ قُصورِها وأشجارِها."}],"32":[{"w":"طَيِّبِينَ","m":"طاهِرين زاكِيَةً أفعالُهم وأقوالُهم."},{"w":"سَلَٰمٌ عَلَيۡكُمُ","m":"تحيةٌ خاصةٌ بكم، وسَلِمْتُم من كلِّ آفةٍ."}],"33":[{"w":"هَلۡ يَنظُرُونَ","m":"ما ينتظِرُ الكفارُ."},{"w":"تَأۡتِيَهُمُ ٱلۡمَلَٰٓئِكَةُ","m":"لقَبْضِ أرواحِهم."},{"w":"أَمۡرُ رَبِّكَ","m":"عذابُ الاستئصالِ في الدنيا، أو القيامةُ التي فيها عذابُهم."}],"34":[{"w":"وَحَاقَ","m":"نَزَلَ وأحاطَ."}],"35":[{"w":"كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبۡلِهِمۡ","m":"بمِثْلِ هذا الاحتجاجِ الباطلِ احتجَّ الكفارُ السابقون."}],"36":[{"w":"ٱلطَّٰغُوتَ","m":"كلَّ معبودٍ باطلٍ، كالشيطانِ والأوثانِ والأمواتِ، وكلَّ داعٍ إلى ضَلالٍ."},{"w":"حَقَّتۡ","m":"وَجَبَتْ."}],"38":[{"w":"جَهۡدَ أَيۡمَٰنِهِمۡ","m":"غايةَ اجتهادِهم بالأيمانِ المؤكَّدةِ."}],"39":[{"w":"لِيُبَيِّنَ لَهُمُ","m":"أي: يَبْعَثُ اللهُ جميعَ العبادِ؛ ليُظْهِرَ لهم حقيقةَ البعثِ."}],"41":[{"w":"لَنُبَوِّئَنَّهُمۡ","m":"لَنُنْزِلَنَّهم."},{"w":"حَسَنَةٗ","m":"داراً حسنةً، أو رزقاً واسعاً وعَيْشاً هنيئاً."}],"42":[{"w":"يَتَوَكَّلُونَ","m":"يعتمدون عليه ويُفَوِّضُون أمرَهم إليه."}],"43":[{"w":"أَهۡلَ ٱلذِّكۡرِ","m":"العلماءَ من أهلِ الكتبِ السابقةِ."}],"44":[{"w":"بِٱلۡبَيِّنَٰتِ","m":"وأرسَلْنا الرسلَ بالمعجزاتِ الواضحةِ الدالَّةِ على صِدْقِهم."},{"w":"وَٱلزُّبُرِ","m":"وبالكتبِ المنزَّلةِ، المتضمِّنةِ للشرائعِ."},{"w":"ٱلذِّكۡرَ","m":"القرآنَ؛ لما فيه من الموعظةِ والتنبيهِ."}],"45":[{"w":"مَكَرُواْ ٱلسَّيِّـَٔاتِ","m":"دبَّروا المكايدَ بخَفاءٍ، وأشركوا مع اللهِ."},{"w":"يَخۡسِفَ","m":"يُغيِّبَ."}],"46":[{"w":"تَقَلُّبِهِمۡ","m":"أسفارِهم وتصرُّفِهم في أمورِهم."},{"w":"بِمُعۡجِزِينَ","m":"بفائتين اللهَ بالفِرارِ من عَذابِه."}],"47":[{"w":"عَلَىٰ تَخَوُّفٖ","m":"على تَنَقُّصٍ شيئاً فشيئاً في الأموالِ والأنفسِ والثمراتِ حتى يَهْلِكُوا، أو على مخافَةٍ من العَذابِ."}],"48":[{"w":"مِن شَيۡءٖ","m":"أي: له ظِلٌّ، كالجبالِ والشجَرِ."},{"w":"يَتَفَيَّؤُاْ ظِلَٰلُهُ","m":"يَميلُ ظِلُّ الأشياءِ وينتقلُ من جانبٍ إلى آخَر."},{"w":"سُجَّدٗا لِّلَّهِ","m":"مُنْقادةً خاضعةً لعَظَمَةِ ربِّها، وتسخيرِه."},{"w":"دَٰخِرُونَ","m":"أذلَّاءُ مُنقادُون لحُكم الله تعالى."}],"49":[{"w":"يَسۡجُدُ","m":"سجودَ طاعةٍ وعبادةٍ، أو سُجودَ تسخيرٍ وخضوعٍ."},{"w":"دَآبَّةٖ","m":"كلِّ حَيَوانٍ يمشي -على هيئته- على الأرضِ."}],"51":[{"w":"لَا تَتَّخِذُوٓاْ","m":"لا تَعْبُدوا."},{"w":"فَٱرۡهَبُونِ","m":"خافونِ دونَ غيري."}],"52":[{"w":"وَلَهُ ٱلدِّينُ","m":"وللهِ وحدَه العبادةُ والإخلاصُ."},{"w":"وَاصِبًا","m":"دائماً، أو واجباً لازماً."}],"53":[{"w":"مَسَّكُمُ","m":"أصابكم."},{"w":"ٱلضُّرُّ","m":"سوءُ الحالِ بنَقْصٍ في الأموالِ أو الأنفسِ أو الثمراتِ."},{"w":"تَجۡـَٔرُونَ","m":"ترفعونَ أصواتَكم بالدُّعاءِ والاستغاثةِ."}],"55":[{"w":"بِمَآ ءَاتَيۡنَٰهُمۡ","m":"من النِّعَمِ."},{"w":"فَتَمَتَّعُواْ","m":"عِيشُوا في أمْنٍ وسلامةٍ، والتَذُّوا بالدنيا، والمرادُ التهديدُ."}],"56":[{"w":"وَيَجۡعَلُونَ","m":"ويجعلُ المشركون على وَجْهِ التقرُّبِ."},{"w":"لِمَا لَا يَعۡلَمُونَ","m":"لآلهتِهم التي لا عِلْمَ لها، ولا تنفعُ ولا تَضُرُّ."},{"w":"تَفۡتَرُونَ","m":"تَكْذِبُون على الله من الباطِلِ."}],"57":[{"w":"مَا يَشۡتَهُونَ","m":"ما يُحِبُّون من البنين."}],"58":[{"w":"كَظِيمٞ","m":"ممتلِئٌ غَمّاً وحُزْناً وغَضَباً."}],"59":[{"w":"يَتَوَٰرَىٰ مِنَ ٱلۡقَوۡمِ","m":"يَسْتَخْفي من قومِه؟"},{"w":"أَيُمۡسِكُهُۥ","m":"أيُبقي مَوْلُودَه الأنثى حيّاً؟"},{"w":"هُونٍ","m":"ذُلٍّ وهَوانٍ."},{"w":"يَدُسُّهُۥ","m":"يُخْفِيه، فَيدْفِنُه حيّاً حتى يموتَ."}],"60":[{"w":"مَثَلُ ٱلسَّوۡءِ","m":"الصِّفةُ القبيحةُ من كراهةِ البناتِ، والجهلِ، والكفرِ باللهِ."},{"w":"وَلِلَّهِ ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ","m":"الصفةُ العُليا من استحقاقِ العبوديةِ، والكمالِ، والجلالِ، والغِنَى، والجُودِ."}],"61":[{"w":"أَجَلٖ مُّسَمّٗى","m":"وقتٍ محدَّدٍ هو نهايةُ آجالِهم."},{"w":"وَلَا يَسۡتَقۡدِمُونَ","m":"لا يَتَقَدَّمون عليه."}],"62":[{"w":"مَا يَكۡرَهُونَ","m":"ما لا يُحبون نِسْبتَه إلى أنفسِهم من البناتِ."},{"w":"وَتَصِفُ","m":"تقولُ."},{"w":"ٱلۡحُسۡنَىٰ","m":"حُسْنَ العاقبةِ."},{"w":"لَا جَرَمَ","m":"حقّاً، أو لا مَحالةَ."},{"w":"مُفۡرَطُونَ","m":"مَتْرُوكون مَنْسِيُّون فيها أبداً."}],"63":[{"w":"فَزَيَّنَ","m":"حَسَّنَ."},{"w":"وَلِيُّهُمُ ٱلۡيَوۡمَ","m":"مُتَوَلٍّ إغواءَهم في الدنيا."}],"64":[{"w":"ٱلۡكِتَٰبَ","m":"القرآنَ العظيمَ."},{"w":"لِتُبَيِّنَ لَهُمُ","m":"لتُوَضِّحَ للناسِ."}],"65":[{"w":"لَأٓيَةٗ","m":"دليلاً وحُجَّةً على قُدرةِ الله."}],"66":[{"w":"ٱلۡأَنۡعَٰمِ","m":"وهي: الإبِلُ، والبَقَرُ، والغَنَمُ."},{"w":"لَعِبۡرَةٗ","m":"لعِظَةً."},{"w":"فَرۡثٖ","m":"خُلاصةِ المأكول في الكَرِشِ والأمعاءِ."},{"w":"خَالِصٗا","m":"مُصَفَّى من جميعِ الشوائبِ."},{"w":"سَآئِغٗا","m":"سهلَ المُرورِ في الحَلْقِ، هنيئاً."}],"67":[{"w":"سَكَرٗا","m":"خَمْراً (وهذا امتنانٌ قبلَ التحريمِ)."}],"68":[{"w":"وَأَوۡحَىٰ","m":"وألْهَمَ."},{"w":"وَمِمَّا يَعۡرِشُونَ","m":"وفيما يَبْنيه الناسُ من البيوتِ والخَلايا."}],"69":[{"w":"سُبُلَ رَبِّكِ","m":"طُرُقَه التي ألْهَمكِ؛ لامتصاصِ ما في أزهارِ الثمار."},{"w":"ذُلُلٗا","m":"مُذَلَّلةً لكِ لا عُسْرَ فيها."},{"w":"شَرَابٞ","m":"هو العَسَلُ."}],"70":[{"w":"يَتَوَفَّىٰكُمۡ","m":"يُميتكُم عندَ نهايةِ أعمارِكم."},{"w":"أَرۡذَلِ ٱلۡعُمُرِ","m":"أردَئهِ وأحقَرِه، وهو وقتُ الهَرَمِ."}],"71":[{"w":"فَهُمۡ فِيهِ سَوَآءٌ","m":"فهم لا يَرْضَوْن بالتساوي في الرزقِ، فكيف رَضُوا أن يَجْعلوا للهِ شركاءَ من عبيدِه؟"}],"72":[{"w":"وَحَفَدَةٗ","m":"جَمْعَ حَفِيدٍ، أي: أولادَ الأولادِ، أو أعواناً وخَدَماً."}],"74":[{"w":"فَلَا تَضۡرِبُواْ لِلَّهِ ٱلۡأَمۡثَالَ","m":"لا تَجْعَلُوا للهِ أشباهاً مماثِلين له مِنْ خَلْقِه، تُشْرِكُونهم معه في العبادةِ."}],"75":[{"w":"هَلۡ يَسۡتَوُۥنَ","m":"لا، فكذلك اللهُ المالكُ مع عبيدِه، فكيف تُسَوُّون بينَهما؟"}],"76":[{"w":"أَبۡكَمُ","m":"أَخْرَسُ منذُ ولادَتِه."},{"w":"كَلٌّ","m":"عِبْءٌ يعتَمِدُ على غيرِه في معيشَتِه."},{"w":"مَوۡلَىٰهُ","m":"مَنْ يلي أمرَه ويَعُولُه."},{"w":"بِٱلۡعَدۡلِ","m":"بالحقِّ وعبادةِ اللهِ."},{"w":"صِرَٰطٖ","m":"طريقٍ."}],"77":[{"w":"غَيۡبُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ","m":"عِلْمُ ما غابَ فيهما."},{"w":"كَلَمۡحِ ٱلۡبَصَرِ","m":"كنَظْرَةٍ سريعةٍ بالبَصَرِ."}],"79":[{"w":"مُسَخَّرَٰتٖ","m":"مُذَلَّلاتٍ للطَّيَرانِ."}],"80":[{"w":"سَكَنٗا","m":"مَسْكَناً واستقراراً لكم."},{"w":"بُيُوتٗا","m":"كالخِيام."},{"w":"تَسۡتَخِفُّونَهَا","m":"تَجِدُونها خفيفةَ الحَمْلِ والنَّقْلِ."},{"w":"يَوۡمَ ظَعۡنِكُمۡ","m":"وقتَ سَفَرِكم."},{"w":"وَمِنۡ أَصۡوَافِهَا","m":"أي: أصوافِ الضَّأنِ."},{"w":"وَأَوۡبَارِهَا","m":"أي: أوبارِ الإبِل، وهو ما يَعْلُو أجسادَها."},{"w":"وَأَشۡعَارِهَآ","m":"أي: أشعارِ المَعْزِ."},{"w":"أَثَٰثٗا","m":"مَتاعاً لبيوتِكم؛ كالأغطيةِ والفُرُشِ."},{"w":"وَمَتَٰعًا","m":"ما تتمتَّعُون وتنتفِعُون به."},{"w":"إِلَىٰ حِينٖ","m":"إلى وقتٍ محدَّدٍ في الدنيا."}],"81":[{"w":"ظِلَٰلٗا","m":"ما تَسْتظِلُّون به من شدَّةِ الحرِّ."},{"w":"أَكۡنَٰنٗا","m":"أماكنَ وِقايةٍ وسِتْرٍ، كالكهوفِ."},{"w":"سَرَٰبِيلَ","m":"كلَّ ما يُلْبَس من ثيابٍ أو دُروعٍ."},{"w":"بَأۡسَكُمۡ","m":"الشدَّةَ في حروبِكم؛ كالطَّعْنِ والضَّرْبِ والشَّظايا."},{"w":"تُسۡلِمُونَ","m":"تَنقادُون وتَخْضَعُون لأمرِ اللهِ وحُكْمِه."}],"82":[{"w":"تَوَلَّوۡاْ","m":"أعْرَضُوا."},{"w":"ٱلۡمُبِينُ","m":"الواضحُ."}],"84":[{"w":"شَهِيدٗا","m":"هو رسولُهم يَشْهَدُ على مَن آمَنَ منهم، وعلى مَن كَفَرَ."},{"w":"لَا يُؤۡذَنُ لِلَّذِينَ كَفَرُواْ","m":"بالاعتذار عَمَّا وَقَعَ منهم."},{"w":"وَلَا هُمۡ يُسۡتَعۡتَبُونَ","m":"لا يُطْلَبُ منهم العُتْبىٰ؛ أي: الرجوعُ إلى ما يُرْضي اللهَ من التوبةِ والعملِ الصَّالحِ."}],"85":[{"w":"يُنظَرُونَ","m":"يُمْهَلُون ويُؤَخَّرون عنه."}],"86":[{"w":"شُرَكَآءَهُمۡ","m":"آلهتَهم المزعومةَ."},{"w":"نَدۡعُواْ","m":"نعبدُ."},{"w":"فَأَلۡقَوۡاْ إِلَيۡهِمُ ٱلۡقَوۡلَ","m":"رَدَّتِ الآلهةُ على عابدِيها قائلين."}],"87":[{"w":"وَأَلۡقَوۡاْ إِلَى ٱللَّهِ يَوۡمَئِذٍ ٱلسَّلَمَ","m":"أظهرَ المشركونَ خُضوعَهم وانقيادَهم للهِ يومَ القيامةِ."},{"w":"وَضَلَّ","m":"غابَ وضاعَ."},{"w":"يَفۡتَرُونَ","m":"يختلِقُونَه مِن الأكاذيبِ."}],"89":[{"w":"شَهِيدًا عَلَىٰ هَٰٓؤُلَآءِ","m":"تَشْهَدُ على أمَّتِك أنكَ بَلَّغْتَهم رسالةَ ربِّك."},{"w":"ٱلۡكِتَٰبَ","m":"القرآنَ."},{"w":"تِبۡيَٰنٗا","m":"بَياناً وتوضيحاً."},{"w":"لِكُلِّ شَيۡءٖ","m":"مما يَحْتاجُ إليه الناسُ من أمورِ الشريعةِ."}],"90":[{"w":"بِٱلۡعَدۡلِ","m":"بالتوسُّطِ والإنصافِ في الأمور."},{"w":"وَٱلۡإِحۡسَٰنِ","m":"كمالِ العملِ وإتقانِه، وإيصالِ النفعِ إلى الخَلْقِ."},{"w":"وَإِيتَآيِٕ ذِي ٱلۡقُرۡبَىٰ","m":"إعطاءِ القَرابةِ حَقَّهم من الصِّلةِ والبِرِّ."},{"w":"ٱلۡفَحۡشَآءِ","m":"ما عَظُمَ قُبْحُه من الذنوبِ قولاً أو فعلاً."},{"w":"وَٱلۡبَغۡيِ","m":"ظُلْمِ الناسِ وتجاوُزِ الحَدِّ في الاستعلاءِ والتعدِّي عليهم."}],"91":[{"w":"بِعَهۡدِ ٱللَّهِ","m":"ما يَلْتَزِمُه المسلمُ باختيارِه بينَه وبينَ اللهِ، أو بينَ الناسِ."},{"w":"وَلَا تَنقُضُواْ ٱلۡأَيۡمَٰنَ","m":"لا تُبْطِلُوها وتَتْرُكُوا العَمَلَ بمُقْتضاها."},{"w":"كَفِيلًا","m":"رَقيباً أو ضامِناً."}],"92":[{"w":"غَزۡلَهَا","m":"ما فَتَلَتْه من صُوفٍ ونحوِه."},{"w":"أَنكَٰثٗا","m":"جَمْعُ نِكْثٍ، وهو: ما حُلَّ فَتْلُه؛ ليُغْزَلَ ثانيةً."},{"w":"دَخَلَۢا بَيۡنَكُمۡ","m":"خديعةً ومُنْكَراً بينَكم."},{"w":"أَرۡبَىٰ مِنۡ أُمَّةٍ","m":"أكثرَ عَدَداً وأوفرَ مالاً من الجماعة التي عاهَدْتموها."},{"w":"يَبۡلُوكُمُ ٱللَّهُ","m":"يختبرُكم بالوفاءِ بِالعهودِ وعَدَمِ نَقْضِها."}],"93":[{"w":"أُمَّةٗ وَٰحِدَةٗ","m":"أهلَ دينٍ واحدٍ، وهو الإسلامُ."},{"w":"وَيَهۡدِي","m":"يُوَفِّقُ إلى الهدايةِ."}],"94":[{"w":"فَتَزِلَّ قَدَمُۢ","m":"فتنحَرِفَ أقدامُكم عن محَجَّةِ الحقِّ."},{"w":"ثُبُوتِهَا","m":"استقامتِها عليه."},{"w":"ٱلسُّوٓءَ","m":"ما يَسُوءُكم من العذابِ في الدنيا."}],"95":[{"w":"وَلَا تَشۡتَرُواْ","m":"لا تَسْتبدلوا."}],"96":[{"w":"يَنفَدُ","m":"يزولُ ويَفْنى."},{"w":"بَاقٖ","m":"لا يزولُ ولا يَفْنى."}],"97":[{"w":"طَيِّبَةٗ","m":"سعيدةً في الدنيا، يصاحِبُها القناعة بما قَسَمهُ اللهُ وقَدَّره."}],"98":[{"w":"فَإِذَا قَرَأۡتَ","m":"أي: فإذا أرَدتَّ أن تَقْرَأَ."},{"w":"فَٱسۡتَعِذۡ بِٱللَّهِ","m":"فالتجِئْ واستَجِرْ به."},{"w":"ٱلرَّجِيمِ","m":"المَرْجُومِ، أي: المَطْرودِ من رحمةِ اللهِ."}],"99":[{"w":"سُلۡطَٰنٌ","m":"تَسَلُّطٌ واستيلاءٌ."},{"w":"يَتَوَكَّلُونَ","m":"يَعْتمدون عليه ويُفَوِّضُون أمرَهم إليه."}],"100":[{"w":"يَتَوَلَّوۡنَهُۥ","m":"يَتِّخِذُونه مُعِيناً لهم ويُطيعونه."},{"w":"هُم بِهِۦ","m":"بسببِ الشيطانِ وإغوائِه إيَّاهم."}],"101":[{"w":"بَدَّلۡنَآ ءَايَةٗ","m":"أزَلْناها، أو أَنْزَلْنا غيرَها."},{"w":"مُفۡتَرِۭ","m":"كَذَّابٌ تَختَلِقُ الباطِلَ على اللهِ مِنْ عندِك."}],"102":[{"w":"رُوحُ ٱلۡقُدُسِ","m":"جبريلُ عليه السلامُ."}],"103":[{"w":"لِسَانُ","m":"لُغةُ وكلامُ."},{"w":"يُلۡحِدُونَ إِلَيۡهِ","m":"يَنْسُبُون إليه التعليمَ."},{"w":"أَعۡجَمِيّٞ","m":"لا يُفْصِحُ عن مُرادِه."},{"w":"مُبِينٌ","m":"في غايةِ الوضوحِ والبيانِ."}],"104":[{"w":"لَا يَهۡدِيهِمُ ٱللَّهُ","m":"لا يُوَفِّقُهم للإيمانِ؛ لعِلْمِه بعدَمِ قَبولِهم له."}],"105":[{"w":"يَفۡتَرِي","m":"يَخْتِلقُ."}],"106":[{"w":"مَن كَفَرَ بِٱللَّهِ","m":"فهم الكاذبون حقّاً، وعليهم غَضَبٌ من الله."},{"w":"أُكۡرِهَ","m":"أُرْغِمَ على النُّطْقِ بالكفرِ فَتَلفَّظَ به؛ خَوْفاً من هَلاكِه."},{"w":"شَرَحَ بِٱلۡكُفۡرِ صَدۡرٗا","m":"اعتَقَدَه وطابَتْ نفسُه به."}],"107":[{"w":"ٱسۡتَحَبُّواْ ٱلۡحَيَوٰةَ","m":"اختارُوها وفَضَّلُوها."}],"108":[{"w":"طَبَعَ","m":"خَتَم."}],"109":[{"w":"لَا جَرَمَ","m":"حقّاً، أو لا مَحالةَ."}],"110":[{"w":"فُتِنُواْ","m":"اختُبِرُوا بتعذيبِهم، وَتَلَفَّظُوا بالكُفرِ."}],"111":[{"w":"تُجَٰدِلُ عَن نَّفۡسِهَا","m":"تُخاصِمُ عن ذاتِها، وتسعىٰ في خَلاصِها."},{"w":"وَتُوَفَّىٰ","m":"تُعْطى وافياً كامِلاً."}],"112":[{"w":"قَرۡيَةٗ","m":"أي: مكةَ."},{"w":"رَغَدٗا","m":"واسعاً كثيراً، أو هنيئاًً سهلاً."},{"w":"لِبَاسَ ٱلۡجُوعِ وَٱلۡخَوۡفِ","m":"ما غَشِيَها من صُنوفِ البَلاءِ وَإحاطَتِه بها كاللِّباس."}],"113":[{"w":"مِنۡهُمۡ","m":"من جنسِهم، يَعْرِفُون نَسَبَه وأمانتَه."}],"114":[{"w":"وَٱشۡكُرُواْ نِعۡمَتَ ٱللَّهِ","m":"با لاعترافِ بها، واستعمالِها في طاعَتِه."}],"115":[{"w":"ٱلۡمَيۡتَةَ","m":"ما لم يُذْبَحْ بطريقةٍ شَرْعِيَّةٍ من الحَيَوانِ."},{"w":"وَٱلدَّمَ","m":"أي: المُراقَ من الذَّبِيحةِ."},{"w":"وَمَآ أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦ","m":"ما ذُكِرَ عليه غيرُ اسمِ اللهِ عندَ ذَبْحِه."},{"w":"فَمَنِ ٱضۡطُرَّ","m":"فمَنْ ألجأَتْه الضَّرورةُ إلى أَكْلِ شيءٍ من هذه المُحَرَّماتِ."},{"w":"غَيۡرَ بَاغٖ","m":"غيرَ طالبٍ للمُحَرَّمِ وهو يَجِدُ غيرَه، أو غيرَ طالبٍ بأَكْلِه التلذُّذَ، أو غيرَ ظالمٍ لمضطرٍّ آخرَ يُؤدِّي إلى هَلاكِه."},{"w":"وَلَا عَادٖ","m":"ولا متجاوزٍ ما يَسُدُّ جَوْعتَه."}],"116":[{"w":"لِمَا تَصِفُ أَلۡسِنَتُكُمُ","m":"لمجرَّدِ وَصْفِ ألسنتِكُم للشيء دونَ دليلٍ."},{"w":"لِتَفۡتَرُواْ","m":"تختَلِقُوا."}],"118":[{"w":"ٱلَّذِينَ هَادُواْ","m":"اليهودِ."}],"119":[{"w":"ٱلسُّوٓءَ","m":"الذُّنوبَ والمعاصِيَ."},{"w":"بِجَهَٰلَةٖ","m":"بِجَهْلٍ منهم لعاقبتِها وإيجابِها سَخَطَ اللهِ."},{"w":"وَأَصۡلَحُوٓاْ","m":"استقامُوا بعد تَوْبَتِهم."}],"120":[{"w":"أُمَّةٗ","m":"إماماً قُدْوةً جامعاً لخِصالِ الخيرِ."},{"w":"قَانِتٗا لِّلَّهِ","m":"مُطيعاً خاضِعاً له."},{"w":"حَنِيفٗا","m":"مائلاً عن الأديانِ الباطلةِ إلى الدِّينِ الحقِ."}],"121":[{"w":"ٱجۡتَبَىٰهُ","m":"اختاره اللهُ لرسالتِه."},{"w":"وَهَدَىٰهُ","m":"أرْشَدَه ووَفَّقه."}],"122":[{"w":"حَسَنَةٗ","m":"نِعْمةً حسنةً؛ كالثَّناءِ الجميلِ عليه إلى يومِ القيامة، والاقتداءِ به."}],"123":[{"w":"مِلَّةَ إِبۡرَٰهِيمَ","m":"شريعتَه، وهي الإسلامُ."}],"124":[{"w":"جُعِلَ ٱلسَّبۡتُ","m":"فُرِضَ تَعْظِيمُه والتفرُّغُ للعبادةِ فيه."},{"w":"ٱلَّذِينَ ٱخۡتَلَفُواْ فِيهِ","m":"هم اليهودُ، حيث أَمَرَهم نبيُّهم بتعظيمِ يومِ الجُمُعَةِ، فاختاروا السَّبْتَ."}],"125":[{"w":"بِٱلۡحِكۡمَةِ","m":"بالطريقةِ الحَكِيمةِ وَفْقَ شَرْعِ اللهِ."},{"w":"وَٱلۡمَوۡعِظَةِ ٱلۡحَسَنَةِ","m":"بالتذكيرِ المناسِبِ للأشخاصِ والأحوالِ."}],"127":[{"w":"ضَيۡقٖ","m":"حَرَجٍ وغَمٍّ."}]}